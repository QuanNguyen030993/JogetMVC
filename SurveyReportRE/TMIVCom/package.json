{
  "name": "tmivcom-react-core",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "./dist-grid/tmiv-grid.cjs",
  "module": "./dist-grid/tmiv-grid.js",
  "types": "./dist-grid/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-grid/types/index.d.ts",
      "import": "./dist-grid/tmiv-grid.js",
      "require": "./dist-grid/tmiv-grid.cjs"
    },
    "./style.css": "./dist-grid/tmiv-grid.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --config vite.config.lib.js",
    "build:grid": "vite build --config vite.config.grid.js && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/DataGrid --ext .ts,.tsx",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@cyntler/react-doc-viewer": "^1.17.1",
    "cropjs": "^1.1.0",
    "cropperjs": "^2.1.1",
    "docx-preview": "^0.4.0",
    "driver.js": "^1.8.0",
    "jquery": "^4.0.0",
    "leaflet": "^1.9.4",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "react-leaflet": "^5.0.0",
    "react-scripts": "^5.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.16",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  },
  "resolutions": {
    "react-error-overlay": "6.0.9"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}

@page "{Dept}"
@model SLA_FormModel
@{

}
<script>

    function generateItems(attributes){

    var items = [];

    Object.keys(attributes).forEach(function(key){

        items.push({

            dataField: key,

            editorType: "dxNumberBox",

            label: {
                text: getLabel(key)
            },

            editorOptions: {
                min: 0
            }
        });
    });

    return items;
}
        var _dept = "@(ViewData["Dept"].ToString())";

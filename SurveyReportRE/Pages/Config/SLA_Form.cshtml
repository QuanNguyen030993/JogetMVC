@page "{Dept}"
@model SLA_FormModel
@{

}
<script>
    
        var _deptInput = "@(ViewData["Dept"].ToString())";
             var _formConfig = new Object();
                _formConfig.tabName = '@HttpContext.Request.Query["Caption"].ToString()';
                _formConfig.originModelName = "@SLA_FormModel.ModelName";
                _formConfig.formElementName = "@SLA_FormModel.ModelName";
                _formConfig.colCount = 1;
                _formConfig.refKey = _deptInput ;
                _formConfig.refField = "dept"; 
                _formConfig.sameRefKeyAsId = true;
                var mFormOption = new MFormOption(_formConfig, null);
    //         ajaxGet(`api/SLA/SLALookup/@(ViewData["Dept"].ToString())`, null).done(response => {
         $(`#form_@(SLA_FormModel.ModelName)`).attr("id", `form_@(SLA_FormModel.ModelName)_@(ViewData["Dept"].ToString())`)
            if (_deptInput == "TS")
            new TSSLAForm(_deptInput, null, _formConfig, mFormOption);
            if (_deptInput == "UW")
            new UWSLAForm(_deptInput, null, _formConfig, mFormOption);
            if (_deptInput == "PM")
            new PMSLAForm(_deptInput, null, _formConfig, mFormOption);
    // });
</script>
<div id="form_@(SLA_FormModel.ModelName)" class="dExForm"></div>


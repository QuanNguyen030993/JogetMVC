@page
@model ConstantModel
@{

}
<script>
    $(function () {
        new MGrid(null, $(`#dataGrid_@ConstantModel.ModelName`), new MGridOption('@ConstantModel.ModelName', "System"), null);
    });
</script>
<div class="alert alert-info" style="margin-bottom:12px">
    System write controls: <code>HttpAuditRequest</code>, <code>ErrorClientLog</code>,
    and <code>SignalR</code>. Set <code>true</code>/<code>false</code>; changes are
    applied within approximately 10 seconds. The SignalR flag controls diagnostics
    only and does not stop realtime business events.
</div>
<div id="dataGrid_@ConstantModel.ModelName"></div>

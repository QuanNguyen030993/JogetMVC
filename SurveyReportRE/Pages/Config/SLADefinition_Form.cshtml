 @page "{pageNum:int?}/{guid}"
@model SLADefinition_FormModel
@{


}

<style>
    .sla-designer {
        width: min(100%, 1100px);
        margin: 0 auto;
        padding: 22px;
        box-sizing: border-box;
    }

    .sla-designer.dx-form {
        padding: 18px;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        background: #fff;
        box-shadow: 0 6px 22px rgba(15, 23, 42, .065);
    }

    .sla-definition-intro {
        display: flex;
        align-items: center;
        gap: 13px;
        margin-bottom: 5px;
        padding: 16px 18px;
        border: 1px solid #dfe6ee;
        border-radius: 10px;
        background: #f8fafc;
    }

    .sla-definition-intro-icon {
        display: grid;
        width: 42px;
        height: 42px;
        flex: 0 0 42px;
        place-items: center;
        border-radius: 10px;
        background: #334155;
        color: #fff;
    }

    .sla-definition-intro h2 {
        margin: 0 0 3px;
        color: #172235;
        font-size: 19px;
        font-weight: 750;
    }

    .sla-definition-intro p {
        margin: 0;
        color: #64748b;
        font-size: 13px;
    }

    .sla-designer .dx-form-group-with-caption {
        margin-top: 14px;
        padding: 15px;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        background: #fcfdff;
    }

    .sla-designer .dx-form-group-caption {
        color: #263548;
        font-size: 14px;
        font-weight: 750;
    }

    @@media (max-width: 640px) {
        .sla-designer { padding: 12px; }
        .sla-designer.dx-form { padding: 12px; }
    }
</style>


<script>

    var params = new URLSearchParams();
    params.set("refKey", @ViewData["Id"]);
    params.set("refField", "Id");
    params.set("refOperator", "=");

    ajaxGet(
        `api/SLA/GetAll/?${params.toString()}`,null
    ).done(result => {

        var res = result[0];




    var slaDesigner = {

        dept: "",
        code: "",

        fields: [
            {
                name: "",
                label: "",
                control: "number",
                required: false,
                min: 0,
                max: 0,
                value: 0
            }
        ],

        calculation: {
            type: "manual",
            unit: "day"
        }

    };
    $("#slaDesigner_@ViewData["Id"]").dxForm({

        formData: res,
            dataSource: res,
        colCount: 1,


        items: [

            {
                itemType: "simple",
                template: function () {
                    return $(`
                        <div class="sla-definition-intro">
                            <div class="sla-definition-intro-icon"><i class="fas fa-stopwatch"></i></div>
                            <div>
                                <h2>SLA setup</h2>
                                <p>Define the target values users can maintain for this department.</p>
                            </div>
                        </div>
                    `);
                }
            },

            {
                itemType: "group",
                caption: "Basic information",
                colCount: 2,
                items: [

                    {
                        dataField: "dept",
                        label: { text: "Department" },
                        editorType: "dxSelectBox",
                        editorOptions: {
                                value: res.dept,
                            items: [
                                "TS",
                                "UW",
                                "PM",
                                "FO",
                                "LMKT"
                            ]
                        }
                    },


                    {
                        dataField: "code",
                        label: { text: "SLA code" },
                        helpText: "Use a short, recognizable code such as RESPONSE_TIME."
                    }

                ]
            },


            {
                itemType: "group",
                caption: "Values users can configure",

                template: function (data, itemElement) {

                    $("<div id='slaGrid_@ViewData["Id"]'>")
                        .dxDataGrid({

                            dataSource:
                                    tryParseJSON(res.attributes, "Parse Attributes Problem").fields || slaDesigner.fields,


                            editing: {
                                mode: "form",
                                allowUpdating: true,
                                allowAdding: true,
                                allowDeleting: true
                            },


                            columns: [

                                {
                                    dataField: "name",
                                    caption: "Field key"
                                },

                                {
                                    dataField: "label",
                                    caption: "Label shown to users"
                                },
                                    {
                                        dataField: "min",
                                        caption: "Minimum"
                                    },
                                    {
                                        dataField: "max",
                                        caption: "Maximum"
                                    },
                                {
                                    dataField: "control",
                                    caption: "Input type",
                                    lookup: {
                                        dataSource: [
                                            "number",
                                            "text",
                                            "date"
                                        ]
                                    }
                                },

                                {
                                    dataField: "required",
                                    caption: "Required",
                                    dataType: "boolean"
                                }

                            ]

                        })
                        .appendTo(itemElement);

                }

            },


            {
                itemType: "group",
                caption: "Result calculation",
                colCount: 2,

                items: [

                    {
                        dataField: "attributes.calculation.type",
                        label: { text: "Calculation method" },
                        editorType: "dxSelectBox",
                        editorOptions: {
                            items: [
                                "manual",
                                "dateDiff"
                            ],
                            displayExpr: function (value) {
                                return value === "dateDiff" ? "Difference between two dates" : "Use entered value";
                            }
                        }
                    },


                    {
                            dataField: "attributes.calculation.unit",
                        label: { text: "Time unit" },
                        editorType: "dxSelectBox",
                        editorOptions: {
                            items: [
                                "day",
                                "hour"
                            ]
                        }
                    }

                ]

            },


            {
                itemType: "button",
                buttonOptions: {
                    text: "Save",
                    icon: "save",
                    type: "success",
                    onClick: function () {

                        saveSLA();

                    }
                }
            }

        ]

    });
    function saveSLA() {


        let formData =
                $("#slaDesigner_@ViewData["Id"]")
                .dxForm("instance")
                .option("formData");


            // lấy dữ liệu từ grid designer
            let gridData =
                $("#slaGrid_@ViewData["Id"]")
                    .dxDataGrid("instance")
                    .getDataSource()
                    .items();

            let fields = $.map(
                gridData,
                function (row) {

                    return {

                        name:
                            row.name,


                        label:
                            row.label,


                        control:
                            row.control,


                        required:
                            row.required || false,


                        min:
                            row.min ?? 0,


                        max:
                            row.max ?? 0,


                        value:
                            row.value ?? null
                    };

                }
            );

            // lấy calculation từ form
            let calculation = {

                type:
                    formData.calculation?.type
                    ||
                    "manual",


                unit:
                    formData.calculation?.unit
                    ||
                    "day"

            };

            let attributes = {
                fields: fields,
                calculation: calculation
            };



        let dbModel = {

            dept:
                formData.dept,


            code:
                formData.code,


            value:
                formData.value,


            decimalValue:
                Number(
                    formData.value
                ),
            unit: attributes.calculation.unit || "",

            attributes:
                    JSON.stringify(attributes)


        };
        var that = new Object();
        that.ModelName = "SLA";
        var TmpDataSource = makeBasicDataSource(that, true);

        var store = TmpDataSource;
        store.insert(dbModel)
                .done(function () {
                })
                .fail(function (error) {
                });

    }
    });
</script>
<div id="slaDesigner_@ViewData["Id"]" class="sla-designer">

    <!-- Header -->
    <div class="sla-header">
        <div class="sla-title">
            SLA Configuration
        </div>

        <div class="sla-actions">
            <button id="btnSaveSLA"></button>
        </div>
    </div>


    <!-- Basic -->
    <div class="sla-card">

        <div class="sla-card-title">
            General Information
        </div>


        <div id="basicForm"></div>

    </div>



    <!-- Fields -->
    <div class="sla-card">

        <div class="sla-card-header">

            <div class="sla-card-title">
                SLA Fields
            </div>


            <button id="btnAddField"></button>

        </div>


        <div id="fieldGrid"></div>

    </div>



    <!-- Calculation -->
    <div class="sla-card">


        <div class="sla-card-title">
            Calculation
        </div>


        <div id="calculationForm"></div>


    </div>




    <!-- Preview -->
    <div class="sla-card">


        <div class="sla-card-title">
            JSON Preview
        </div>


        <pre id="jsonPreview"
             class="json-preview">
        </pre>


    </div>


</div>

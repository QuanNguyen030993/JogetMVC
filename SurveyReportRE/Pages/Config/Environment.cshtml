<div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
    <strong>Connection environment</strong>
    <div id="tabPanel">
        @* <div id="dataGrid_@UsersModel.ModelName"></div> *@
    </div>
    <span style="color: var(--c-64748b); font-size: 12px;">
        Switches Application, Joget and Log connections together.
    </span>
</div>
    <div id="generateEncryptPassword"></div>
<div id="DecryptPassword"></div>
<div id="inputPassword"></div>
    <div id="passwordResult"></div>
<div id="birthDate"></div>
<div id="remarkEditor"></div>
<div id="surveyGrid"></div>
<div id="commentBox"></div>
<div id="flow"> </div>
<section style="margin-top: 30px; padding: 20px; border-top: 2px dashed var(--c-0284c7); background: var(--c-f8fafc);">
    <h3 style="font-family: sans-serif; color: var(--c-0f172a); margin-bottom: 6px;">Document upload examples</h3>
    <p style="margin: 0 0 18px; color: var(--c-475569);">
        All three controls create Document records; only the physical storage destination is different.
    </p>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px;">
        <div style="padding: 16px; border: 1px solid var(--c-cbd5e1); border-radius: 8px; background: white;">
            <h4 style="margin: 0 0 4px; color: var(--c-0f172a);">Local storage</h4>
            <code style="display: block; margin-bottom: 12px; color: var(--c-475569);">/api/Document/AsyncUploadFileLocal</code>
            <div id="localFileUploader"></div>
        </div>
        <div style="padding: 16px; border: 1px solid var(--c-cbd5e1); border-radius: 8px; background: white;">
            <h4 style="margin: 0 0 4px; color: var(--c-0f172a);">NAS server</h4>
            <code style="display: block; margin-bottom: 12px; color: var(--c-475569);">/api/Document/AsyncUploadFileNAS</code>
            <div id="nasFileUploader"></div>
        </div>
        <div style="padding: 16px; border: 1px solid var(--c-cbd5e1); border-radius: 8px; background: white;">
            <h4 style="margin: 0 0 4px; color: var(--c-0f172a);">SharePoint</h4>
            <code style="display: block; margin-bottom: 12px; color: var(--c-475569);">/api/Document/AsyncUploadFileSharePoint</code>
            <div id="sharePointFileUploader"></div>
        </div>
    </div>
</section>

<section style="margin-top: 30px; padding: 20px; border-top: 2px dashed var(--c-0284c7); background: var(--c-f8fafc);">
    <h3 style="font-family: sans-serif; color: var(--c-0f172a); margin-bottom: 6px;">HandsomGrid example</h3>
    <p style="margin: 0 0 18px; color: var(--c-475569);">
        Edit cells directly, then use the button to read the current rows with
        <code>$("#handsomGrid").tmivhandsomgrid("value")</code>.
    </p>
    <div id="handsomGrid"></div>
    <div id="getHandsomGridValue" style="margin-top: 14px;"></div>
    <pre id="handsomGridResult" style="min-height: 64px; margin: 14px 0 0; padding: 12px; overflow: auto; border: 1px solid var(--c-cbd5e1); border-radius: 6px; background: white; color: var(--c-0f172a);">[]</pre>
</section>

<div style="margin-top: 30px; padding: 20px; border-top: 2px dashed var(--c-0284c7); background: var(--c-f8fafc);">
    <h3 style="font-family: sans-serif; color: var(--c-0f172a); margin-bottom: 12px;">TMIV Map Demo</h3>
    <div id="demoMap" style="max-width: 900px; border-radius: 8px;"></div>
</div>

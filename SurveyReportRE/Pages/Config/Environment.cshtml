<script>
    $(function () {
          let currentConnectionEnvironment = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CurrentConnectionEnvironment));
          let syncingConnectionEnvironment = false;

          $("#tabPanel").dxSelectBox({
             dataSource: ["Default", "UAT"],
             value: currentConnectionEnvironment,
             searchEnabled: false,
             showClearButton: false,
             stylingMode: "outlined",
             width: 180,
             onValueChanged: function (e) { // handle after select
                  if (syncingConnectionEnvironment || !e.value || e.value === currentConnectionEnvironment) return;
                  const selectBox = e.component;
                  selectBox.option("disabled", true);
                  $.ajax({
                      url: `/api/Menu/DbContextEnvironmentChange/${e.value}`,
                      method: "GET",
                      success: function (response) {
                          currentConnectionEnvironment = response.environment;
                          DevExpress.ui.notify(response.message, "success", 1800);
                      },
                      error: function (err) {
                          syncingConnectionEnvironment = true;
                          selectBox.option("value", currentConnectionEnvironment);
                          syncingConnectionEnvironment = false;
                          DevExpress.ui.notify(
                              err.responseJSON?.message || "Unable to switch connection environment.",
                              "error",
                              3500
                          );
                      },
                      complete: function () {
                          selectBox.option("disabled", false);
                      }
                  });
             },
        });





         $("#passwordResult").dxTextBox({
        text: "Encryption Result"});
         $("#inputPassword").dxTextBox({
        text: "Input Password", mode: "password"});
          $("#generateEncryptPassword").dxButton({
        text: "Generate Encrypt Password"
        ,onClick: () => {
             var inputPassword = $("#inputPassword").dxTextBox().dxTextBox("instance");

                
               $.ajax({
                      url: `/api/Environment/MakeEncryption?password=${inputPassword.option("value")}`,
                      success: function (response) {
                          var passwordResult = $("#passwordResult").dxTextBox().dxTextBox("instance");
                         passwordResult.option("value", response);
                      },
                      error: function (err) {
                      }
                  });
        }})
         $("#DecryptPassword").dxButton({
        text: "Decrypt Password"
        ,onClick: () => {
             var inputPassword = $("#inputPassword").dxTextBox().dxTextBox("instance");


               $.ajax({
                      url: `/api/Environment/MakeDecryption?variableName=${inputPassword.option("value")}`,
                      success: function (response) {
                          var passwordResult = $("#passwordResult").dxTextBox().dxTextBox("instance");
                         passwordResult.option("value", response);
                      },
                      error: function (err) {
                      }
                  });
        }})
    });


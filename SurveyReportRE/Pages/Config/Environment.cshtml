@page
@model EnvironmentModel
@{

}
<script>
    $(function () {

          $("#tabPanel").dxSelectBox({
            dataSource:["Default","UAT"],
             searchEnabled: true,
             width: 300,
             onValueChanged: function (e) { // handle after select
                  $.ajax({
                      url: `/api/Menu/DbContextEnvironmentChange/${e.value}`,
                      success: function (response) {
                      },
                      error: function (err) {
                      }
                  });
             },
        });





         $("#passwordResult").dxTextBox({
        text: "Encryption Result"});
         $("#inputPassword").dxTextBox({
        text: "Input Password", mode: "password"});
          $("#generateEncryptPassword").dxButton({
        text: "Generate Encrypt Password"
        ,onClick: () => {
             var inputPassword = $("#inputPassword").dxTextBox().dxTextBox("instance");

                
               $.ajax({
                      url: `/api/Environment/MakeEncryption?password=${inputPassword.option("value")}`,
                      success: function (response) {
                          var passwordResult = $("#passwordResult").dxTextBox().dxTextBox("instance");
                         passwordResult.option("value", response);
                      },
                      error: function (err) {
                      }
                  });
        }})
         $("#DecryptPassword").dxButton({
        text: "Decrypt Password"
        ,onClick: () => {
             var inputPassword = $("#inputPassword").dxTextBox().dxTextBox("instance");


               $.ajax({
                      url: `/api/Environment/MakeDecryption?variableName=${inputPassword.option("value")}`,
                      success: function (response) {
                          var passwordResult = $("#passwordResult").dxTextBox().dxTextBox("instance");
                         passwordResult.option("value", response);
                      },
                      error: function (err) {
                      }
                  });
        }})
    });

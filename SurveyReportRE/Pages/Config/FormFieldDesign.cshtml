        border-radius:10px;
        font-size:12px;
        overflow:auto;
        max-height:300px;
    }

.dual-layout{
    display:flex;
    gap:20px;
    margin-top:20px;
}

.drag-column{
    flex:1;
    background:white;
    border-radius:12px;
    padding:12px;
    min-height:500px;
    border:1px solid var(--c-dddddd);
}

.drag-title{
    font-size:18px;
    font-weight:bold;
    margin-bottom:16px;
}

.drag-zone{
    min-height:400px;
}

.drag-item{
    padding:12px;
    background:var(--c-f4f7ff);
    border:1px solid var(--c-cdd8ff);
    border-radius:8px;

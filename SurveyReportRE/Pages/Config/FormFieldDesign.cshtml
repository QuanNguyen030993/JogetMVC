<script>

    // =====================================================
    // STATE
    // =====================================================

    var formSchema = [];

    var selectedField = null;

            var visibleGroups = [];
            var hiddenGroups = [];

    // =====================================================
    // VIEW SELECTOR
    // =====================================================


    $("#moduleSelector").dxSelectBox({
        items: [
            "Quotation",
            "PolicyIssuance",
            "Popup"
        ],
            value: "Quotation"
    });


    $("#viewSelector").dxSelectBox({

        items:[
            "Quotation_Request_Form",
            "_Quotation_FO_Form",
            "_Quotation_TS_Form",
            "_Quotation_UW_Form",
            "_Quotation_LMKT_Form",
            "_Quotation_PM_Form",
            "_PolicyIssuance_FO_Form",
            "_PolicyIssuance_TS_Form",
            "_PolicyIssuance_PM_Form"
        ],

        value:"Quotation_FO_Form"

    });

    // =====================================================
    // LOAD BUTTON
    // =====================================================

    $("#btnLoad").dxButton({

        text:"Load View",

        type:"default",

        onClick:function(){

            loadView();

        }

    });

    // =====================================================
    // LOAD VIEW
    // =====================================================

    function loadView(){

     var moduleName = $("#moduleSelector")
            .dxSelectBox("instance")
            .option("value");

            var moduleQuotation = `${moduleName}Detail`;



            var viewName = $("#viewSelector")
            .dxSelectBox("instance")
            .option("value");

        ajaxGet(`/api/Utility/GetViewContent/${moduleQuotation}/${viewName}`, null
        ).then(res => {console.log(res.content) ; parseSchema(res.content);});

    }

    // =====================================================
    // PARSE SCHEMA
    // EXPECT:
    // window.formSchema = [...]
    // =====================================================

    function parseSchema(content){

    try{
        var match = content.match(
            /items\s*:\s*\[([\s\S]*?)\]\s*\}\s*\);/
        );

        if(!match){

            DevExpress.ui.notify(
                "items not found",
                "error",
                3000
            );

            return;
        }

        var itemsText = "[" + match[1] + "]";
        // FIX JS OBJECT
        // itemsText = normalizeJsObject(itemsText);

        formSchema = eval("(" + itemsText + ")");
            normalizeSchema();


        renderExplorer();

        // renderPreview();
        renderJson();
        renderDragColumns();


        formSchema = eval("(" + itemsText + ")");
                normalizeSchema();
        // ✅ add groupId
        formSchema.forEach((g, i) => {
                const randomId = crypto.randomUUID();
            if (g.itemType === "group") {
                    g.groupId = randomId || ("group_" + i);
            }
        });
        renderGroupDrag();
            renderReOrderFieldColumns();
    }
    catch(ex){

        console.error(ex);
        console.log(ex);
        DevExpress.ui.notify(
            "Parse failed",
            "error",
            3000
        );
    }
}

    // =====================================================
    // EXPLORER
    // =====================================================

    function renderExplorer(){

        var html = "";

        formSchema.forEach(group=>{
            if (group.items){
            html += `
                <div class='group-card'>

                    <div class='group-title'>
                        ${group.caption}
                    </div>
            `;
            
            group.items.forEach(field=>{

                html += `
                    <div 
                        class='field-item ${selectedField == field.dataField ? 'active' : ''}'
                        onclick='selectField("${field.dataField}")'
                    >

                        <div>
                            ${field.dataField}
                        </div>

                        <div class='editor-badge'>
                            ${field.editorType ? field.editorType : "dxTextBox"}
                        </div>

                    </div>
                `;
            });

            html += `</div>`;
            }
        });

        $("#schemaExplorer").html(html);

    }

    // =====================================================
    // FORM PREVIEW
    // =====================================================
    function normalizeJsObject(text){

    text = text.replace(/\/\/.*$/gm, "");

    // remove template function
    text = text.replace(
        /template\s*:\s*function\s*\([\s\S]*?\}\s*(?=,|\})/g,
        'template:null'
    );

    // remove makeSelectBoxEditorOptions
    text = text.replace(
        /makeSelectBoxEditorOptions\([^\)]*\)/g,
        '{}'
    );

    // remove labelTpl
    text = text.replace(
        /labelTpl\([^\)]*\)/g,
        '"LABEL"'
    );

    return text;
}
    function renderPreview(){

        $("#formPreview").dxForm({

            formData:{},

            colCount:2,

            items: formSchema.map(g=>{
                if (g.items)
                return {

                    itemType:"group",

                    caption:g.caption,

                    colCount:2,

                    items:g.items
                        .filter(x=>x.visible !== false)

                };
                else {
                    return "{}";
                }
            })

        });


    }

    // =====================================================
    // PROPERTY PANEL
    // =====================================================

    function selectField(fieldName){

        selectedField = fieldName;

        renderExplorer();

        var field = findField(fieldName);
        $("#propertyPanel").html(`

            <div class='property-item'>

                <label>DataField</label>

                <input type='text'
                       value='${field.dataField}'
                       disabled/>

            </div>

            <div class='property-item'>

                <label>Editor Type</label>

                <div id='editorType'></div>

            </div>

            <div class='property-item'>

                <label>Visible</label>

                <div id='visibleSwitch'></div>

            </div>

        `);

        $("#editorType").dxSelectBox({

            items:[
                "dxTextBox",
                "dxTextArea",
                "dxNumberBox",
                "dxDateBox",
                "dxSelectBox",
                "dxTagBox",
                "dxDataGrid"
            ],

                value:field?.editorType ? field.editorType : "dxTextBox",

            onValueChanged:function(e){

                updateField(
                    fieldName,
                    "editorType",
                    e.value
                );

            }

        });

        $("#visibleSwitch").dxSwitch({

            value:field.visible !== false,

            onValueChanged:function(e){

                updateField(
                    fieldName,
                    "visible",
                    e.value
                );

            }

        });

    }

    // =====================================================
    // UPDATE FIELD
    // =====================================================

    function updateField(fieldName,key,value){

        var field = findField(fieldName);

        field[key] = value;

        // renderPreview();

        renderExplorer();

    }

    // =====================================================
    // FIND FIELD
    // =====================================================

    function findField(fieldName){

        for(var g of formSchema){
            if (g.items)
            for(var f of g.items){

                if(f.dataField == fieldName){

                    return f;
                }
            }
        }

        return null;
    }

    // =====================================================
    // JSON
    // =====================================================

    function renderJson(){
        $("#jsonPreview").html(
           JSON.stringify(
                formSchema,
                null,
                2
            )
        );

    }
    function renderDragColumns(){

    var visibleFields = [];
    var hiddenFields = [];

    formSchema.forEach(g=>{

        if(!g.items) return;

        g.items.forEach(f=>{

            if(f.visible === false){
                hiddenFields.push(f);

            }else{

                visibleFields.push(f);
            }

        });

    });
    function renderDragItems(container,data){

    var html = "";

    data.forEach(f=>{

        html += `
                <div class='drag-item' onclick='selectField("${f.dataField}")'>

                <div>
                    <b>${f.dataField}</b>
                </div>

                <div>
                    ${f.editorType || 'dxTextBox'}
                </div>

            </div>
        `;
    });

    $(container).html(html);

}
    $("#visibleFields").dxSortable({

        group:"shared",

        data:visibleFields,

        filter:".drag-item",

        allowDropInsideItem:false,

        itemOrientation:"vertical",

         moveItemOnDrop:true,
         onAdd: function(e) {
                 const draggedItem = e.fromData[e.fromIndex];
                       hiddenFields.splice(e.fromIndex, 1);
                               draggedItem.visible =  true;
                               visibleFields.push(draggedItem);// var field =  e.fromData[e.fromIndex];
                                            var field = findField(draggedItem.dataField);


                    var module = $("#moduleSelector")
                    .dxSelectBox("instance")
                    .option("value");
                    
                    var viewName = $("#viewSelector")
                    .dxSelectBox("instance")
                    .option("value");
                ajaxPost("/api/Utility/SaveViewSchema",{
                        module: module,
                    view: viewName,
                        fieldName: draggedItem.dataField,
                            fieldJson: JSON.stringify(field)
                    }).then(res=>{

                    DevExpress.ui.notify(
                        "Saved",
                        "success",
                        3000
                    );

                });


         }
    });

    $("#hiddenFields").dxSortable({

        group:"shared",

        data:hiddenFields,

        filter:".drag-item",

        allowDropInsideItem:false,

        itemOrientation:"vertical",

        moveItemOnDrop:true,
                 onAdd: function(e) {
                            const draggedItem = e.fromData[e.fromIndex];
                              visibleFields.splice(e.fromIndex, 1);
                                   draggedItem.visible =  false;
                                      hiddenFields.push(draggedItem);
                                              var field = findField(draggedItem.dataField);

                                                  var module = $("#moduleSelector")
                        .dxSelectBox("instance")
                        .option("value");
        var viewName = $("#viewSelector")
                .dxSelectBox("instance")
                .option("value");
            ajaxPost("/api/Utility/SaveViewSchema",{
                view: viewName,
                    module: module,
                    fieldName: draggedItem.dataField,
                        fieldJson: JSON.stringify(field)
                }).then(res=>{

                DevExpress.ui.notify(
                    "Saved",
                    "success",
                    3000
                );

            });

             }
    });

    renderDragItems(
        "#visibleFields",
        visibleFields
    );

    renderDragItems(
        "#hiddenFields",
        hiddenFields
    );
    $("#txtNewField").dxTextBox({

    placeholder:"Field name"

});

}
    $("#btnAddNewField").dxButton({

        text:"Add Field",
        type:"default",

        onClick:function(){

            var fieldName = $("#txtNewField")
                .dxTextBox("instance")
                .option("value");

            if(!fieldName) return;

            var targetGroup = formSchema.find(x => x.items);

            var newField = {
                dataField: fieldName,
                editorType: "dxTextBox",
                visible: true
            };

            targetGroup.items.push(newField);

            // ✅ CALL API SAVE
                    var module = $("#moduleSelector")
                .dxSelectBox("instance")
                .option("value");  var viewName = 
                
                $("#viewSelector")
                .dxSelectBox("instance")
                .option("value");

            ajaxPost("/api/Utility/AddField", {
                    module: module,
                view: viewName,
                groupCaption: targetGroup.caption,
                fieldJson: JSON.stringify(newField)
            }).then(() => {
                DevExpress.ui.notify("Field added", "success", 2000);
            });

            renderExplorer();
            renderDragColumns();
            renderReOrderFieldColumns();
            renderJson();
        }

    });
        function normalizeSchema(){

        var defaultGroup = {
            itemType: "group",
            caption: "General",
            groupId: "general_group",
            items: []
        };

        var newSchema = [];

        formSchema.forEach(item => {

            if(item.items){
                newSchema.push(item);
            }else{
                defaultGroup.items.push(item);
            }

        });

        if(defaultGroup.items.length > 0){
            newSchema.unshift(defaultGroup);
        }

        formSchema = newSchema;
    }
    ``
$("#btnSaveView").dxButton({

    text:"Save field on view",

    type:"success",

    onClick:function(){

        saveView();

    }

});

    $("#btnSaveGroupView").dxButton({

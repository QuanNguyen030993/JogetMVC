    function saveGroupView(group){

                var module = $("#moduleSelector")
            .dxSelectBox("instance")
            .option("value");var viewName = $("#viewSelector")
            .dxSelectBox("instance")
            .option("value");
                        var oldName = $(`#groupOldName`).val();

        }
    });

    $("#hiddenGroups").dxSortable({
        group: "groupShared",
        data: hiddenGroups,
              filter:".drag-item",

            allowDropInsideItem:false,

            itemOrientation:"vertical",

            moveItemOnDrop:true,
       onAdd: function(e) {
           const draggedItem = e.fromData[e.fromIndex];
                  visibleGroups.splice(e.fromIndex, 1);
                   draggedItem.visible =  false;
                          hiddenGroups.push(draggedItem);
                var viewName = $("#viewSelector")
                            .dxSelectBox("instance")
                            .option("value");
                        ajaxPost("/api/Utility/SaveGroupViewSchema",{
                            view: viewName,
                                        groupCaption: draggedItem.caption,
                                            groupJson: JSON.stringify(draggedItem)
                            }).then(res=>{

                            DevExpress.ui.notify(
                                "Saved",
                                "success",
                                3000
                            );

                        });
    }
    });
        function selectGroup(groupId){

        var group = formSchema.find(g => g.groupId === groupId);


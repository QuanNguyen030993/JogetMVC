            // groupJson: JSON.stringify(group)
        }).then(() => {
            DevExpress.ui.notify("Group Saved", "success", 2000);
        });
    }
        function renderReOrderFieldColumns(){

        var html = "";

        formSchema.forEach(group => {
            
            if(!group.items) return;

            html += `
                <div class='drag-column group-zone'>

                    <div class='drag-title'>
                        ${group.caption}
                    </div>

                    <div class='group-fields'
                         id='group_${group.groupId}'
                             data-group='${group.caption}'>
                    </div>

                </div>
            `;
        });

            $("#reorderFieldContainer").html(html);

        formSchema.forEach(group => {
            
            if(!group.items) return;

            renderReOrderGroupFields(group);
        });

        initReOrderFieldSortable();
    }

    // =====================================================
    // RENDER GROUP FIELD
    // =====================================================

    function renderReOrderGroupFields(group){

        var html = "";

        group.items.forEach(field => {

            html += `
                <div class='drag-item'
                     data-field='${field.dataField}'
                     onclick='selectField("${field.dataField}")'>

                    <div>
                        <b>${field.dataField}</b>
                    </div>

                    <div>
                        ${field.editorType || 'dxTextBox'}
                    </div>

                </div>
            `;
        });

        $(`#group_${group.groupId}`).html(html);
    }

    // =====================================================
    // INIT FIELD SORTABLE
    // =====================================================

    function initReOrderFieldSortable(){

        $(".group-fields").each(function(){

            $(this).dxSortable({

                group: "fieldShared",

                filter: ".drag-item",

                allowDropInsideItem: false,

                itemOrientation: "vertical",

                moveItemOnDrop: true,

                onAdd: onReOrderFieldDrop

            });

        });
    }

    // =====================================================
    // FIELD DROP
    // =====================================================
        function onReOrderFieldDrop(e){
        // ✅ Lấy fieldName từ DOM (CHUẨN NHẤT)
        var fieldName = $(e.itemElement).data("field");

        // ✅ Xác định group source / target
                var module = $("#moduleSelector")
                    .dxSelectBox("instance")
                    .option("value");
            var viewName = $("#viewSelector")
                .dxSelectBox("instance")
                .option("value");
        var sourceGroupId = $(e.fromComponent.element()).data("group");
        var targetGroupId = $(e.toComponent.element()).data("group");

                ajaxPost("/api/Utility/SwapGroup",{

                view:viewName,
                    module:module,

                    fieldName:fieldName,

                            sourceGroup:sourceGroupId,
                  targetGroup:targetGroupId



            }).then(res => {

                DevExpress.ui.notify(
                    "Field reordered",
                    "success",
                    2000
                );

            });
        // ✅ Find group
        var sourceGroup = formSchema.find(g => g.groupId == sourceGroupId);
        var targetGroup = formSchema.find(g => g.groupId == targetGroupId);

        if(!sourceGroup || !targetGroup){
            console.error("Group not found");
            return;
        }

        // ✅ Find field object thật
        var draggedItem = sourceGroup.items.find(f => f.dataField === fieldName);

        if(!draggedItem){
            console.error("Field not found:", fieldName);
            return;
        }

        // ✅ Remove khỏi group cũ
        sourceGroup.items = sourceGroup.items.filter(f => f.dataField !== fieldName);

        // ✅ Insert vào group mới theo index
        targetGroup.items.splice(e.toIndex, 0, draggedItem);

        // ✅ DEBUG
        console.log("Move field", fieldName);
        console.log("From:", sourceGroup.caption);
        console.log("To:", targetGroup.caption);
        console.log("Index:", e.toIndex);

        // ✅ Save API (nếu cần)
        saveReOrderField(
            draggedItem,
            sourceGroup,
            targetGroup,
            e.toIndex
        );

        // ✅ Re-render UI
        renderExplorer();
        renderJson();
        renderReOrderFieldColumns();
    }

        type:"success",

        onClick:function(){

            saveGroupView();

        }

    });

        $("#propertyNewGroupPanel").dxTextBox({
            width:100,
            height:50,
            onClick:function(){
                saveGroup();
            }

        });
function generateItemsText(){

    return JSON.stringify(
        formSchema,
        null,
        4
    )
    .replace(/"([^"]+)":/g, '$1:')
    .replace(/"/g,"'");
}
function saveView(){
    var field = findField(selectedField);



         var viewName = $("#viewSelector")
            .dxSelectBox("instance")
            .option("value");

                    var module = $("#moduleSelector")
            .dxSelectBox("instance")
            .option("value");

                        var  editorType = $("#editorType")
                .dxSelectBox("instance")
                .option("value");
                    field.editorType = editorType;
        ajaxPost("/api/Utility/SaveViewSchema",{
            view: viewName,
                    module: module,
            fieldName: selectedField,
            fieldJson: JSON.stringify(field)
            }).then(res=>{

            DevExpress.ui.notify(
                "Saved",
                "success",
                3000
            );

        });

            renderExplorer();
                renderDragColumns();
                renderReOrderFieldColumns();
                renderJson();

}
function renderGroupDrag(){

        formSchema.forEach(g => {

            if (g.itemType !== "group") return;

            if (g.visible === false) {
                hiddenGroups.push(g);
            } else {
                visibleGroups.push(g);
            }

        });

        function render(container, data){
            var html = "";

            data.forEach(g => {
                html += `
                    <div class='drag-item'
                         onclick='selectGroup("${g.groupId}")'>

                        <b>${g.caption}</b>

                    </div>
                `;
            });

            $(container).html(html);
        }

        render("#visibleGroups", visibleGroups);
        render("#hiddenGroups", hiddenGroups);
}

    $("#visibleGroups").dxSortable({
        group: "groupShared",

@page
@model FormFieldDesignModel
@*
=========================================================
LOW CODE VIEW DESIGNER MOCKUP
- Read .cshtml content via API
- Extract window.formSchema
- Visualize groups + fields
- Runtime preview
=========================================================
*@

@{
    ViewData["Title"] = "Low Code Designer";
}



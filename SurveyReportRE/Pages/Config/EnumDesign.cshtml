         // ✅ PREVIEW CONTROL
        gridFields.forEach(f => {

            var parsed = null;
            try{
                parsed = parseParamsByteArrAsObject(f.formItem);
            }catch(e){}

            if(!parsed?.enum) return;

            var enumObj = dictionaryData.find(x => x.group === parsed.enum);
            if(!enumObj) return;

            var isMulti = parsed.multi;

            if(isMulti){
                $("#preview_"+f.id).dxTagBox({
                    dataSource: enumObj.items,
                    searchEnabled: true
                });
            }
            else{
                $("#preview_"+f.id).dxSelectBox({
                    dataSource: enumObj.items,
                    searchEnabled: true
                });
            }

        });

    }

        function reload()
        {


        ajaxGet(`/api/EnumData/GetAll`,null).done(res => {
         resResponse = [] ;
            resResponse = res;
                
         function mapToDictionary(rawData){

            const map = {};

            rawData.forEach(row => {
                // ✅ Group
                const group = row.name;

                // ✅ Field
                const field = row.name || "Default";

                const key = group + "|" + field;

                if(!map[key]){
                    map[key] = {
                        group: group,
                        field: field,
                        items: []
                    };
                }

                map[key].items.push({
                    text: row.value,
                    id: row.id,
                    order: row.enumOrder ?? 999
                });

            });

            // ✅ Convert to array + sort
            return Object.values(map).map(g => ({
                group: g.group,
                field: g.field,
                items: g.items
                    .sort((a,b) => a.order - b.order)
                    .map(x => { text = x.text;x.id = x.id ; return x;} )
            }));
        }
        dictionaryData= [];
            dictionaryData = mapToDictionary(res);

        renderDictionary();
        // renderForm();
        // renderJson();
        });
         const params = new URLSearchParams();
        params.set("refKey", "dxSelectBox");
         params.set("refField", 'FormDataType'); 
        ajaxGet(`/api/DataGridConfig/GetAll?${params.toString()}`,null).done(res => {
            gridFields = res;
            renderGrid();
        });
        }
        reload();

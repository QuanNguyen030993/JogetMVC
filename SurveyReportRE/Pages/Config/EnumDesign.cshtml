    <div class="layout">


        <!-- LEFT -->
    <div style="padding:10px;border-bottom:1px solid #ddd">

        <input id="txtGroupName" placeholder="Group name"
               style="width:100%;margin-bottom:5px" />

        <button onclick="addGroup()" style="width:100%">+ Add Group</button>
        <button onclick="deleteGroup()" style="width:100%">- Delete Group</button>

        <hr />

        <input id="txtFieldName" placeholder="Key name"
               style="width:100%;margin-bottom:5px" />

        <button onclick="addFieldManual()" style="width:100%">+ Add Key</button>
        <button onclick="deleteField()" style="width:100%">- Delete Key</button>
    </div>

        <div class="panel left" id="dictionaryPanel"></div>



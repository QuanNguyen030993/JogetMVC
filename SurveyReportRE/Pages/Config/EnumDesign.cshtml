    <title>Low Code Dictionary Builder</title>

    <style>
        body {
            margin: 0;
            font-family: Arial;
            background: #f5f7fb;
        }

        .layout {
            display: flex;
            height: 100vh;
        }

        .panel {
            background: white;
            overflow: auto;
        }

        .left {
            width: 320px;
            border-right: 1px solid #ddd;
        }

        .center {
            flex: 1;
            padding: 20px;
        }

        .right {
            width: 320px;
            border-left: 1px solid #ddd;
            padding: 10px;
        }

        .card {
            border: 1px solid #ddd;
            border-radius: 10px;
            margin: 10px;
        }

        .card-title {
            padding: 10px;
            font-weight: bold;
            background: #eef4ff;
        }

        .item {
            padding: 8px;

        function renderGrid(){

        var html="";
        var groupMap = {};

    gridFields.forEach(f => {
        if(!groupMap[f.sysTableId]){
            groupMap[f.sysTableId] = [];
        }
        groupMap[f.sysTableId].push(f);
    });

    // ✅ render theo group
    Object.keys(groupMap).forEach(groupId => {

        html += `
            <div style='margin-bottom:20px'>
                <div style='font-weight:bold;
                            background:#eef4ff;
                            padding:10px;
                            border-radius:8px'>
                    Group: ${groupId}
                </div>
        `;

        groupMap[groupId].forEach((f,i) => {

                var parsed = null;
                try{
                    parsed = parseParamsByteArrAsObject(f.formItem);
                }catch(e){}

                html += `
                <div class='field'
                    ondrop='dropEnum("${f.dataField}")'
                    ondragover='allowDrop(event)'>

                    <b>${f.dataField}</b>

                    <div style='color:gray'>
                        ${parsed?.enum || "none"}
                    </div>

                    <div id='ddl_${f.id}'></div>
                    <div id='preview_${f.id}' class='preview-box'></div>

                </div>`;
            });

            html += `</div>`;
        });

    $("#gridFields").html(html);


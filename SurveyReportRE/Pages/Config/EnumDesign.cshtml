        function addFieldManual(){

        var fieldName = $("#txtFieldName").val();
        var group = $("#txtGroupName").val();
        if(!fieldName) return;

        // lấy group đang chọn (bạn có thể improve sau)

        var payload = {
                sysTableName: "",
                mappingField: "",
                name: group,
                value: fieldName,
                enumOrder: 0
            };
            store.insert(payload);
            reload();
        }



        function deleteGroup(){
             var groupName = $(`#txtGroupName`).val();
             var groupByName = resResponse.filter(f => f.name === groupName);
             var groupByMappingField = resResponse.filter(f => f.mappingField === groupName);

             if (groupByName)
             $.each(groupByName, function(i, item) {
                store.remove(item.id);
             })


             if (groupByMappingField)
              $.each(groupByMappingField, function(i, item) {
                   store.remove(item.id);
             })
             reload();
        }

@page
@{
    ViewData["Title"] = "Workload Dashboard";
}

@await Html.PartialAsync("_LayoutReference")

<style>
    :root {
        --dashboard-ink: #172033;
        --dashboard-muted: #667085;
        --dashboard-line: #e7eaf0;
        --dashboard-surface: #ffffff;
    }

    body {
        margin: 0;
        color: var(--dashboard-ink);
        background: #f3f6fb;
        font-family: Inter, "Segoe UI", Arial, sans-serif;
    }

    .workload-dashboard-page {
        min-height: 100vh;
        padding: 28px;
        background:
            radial-gradient(circle at 8% 0%, rgba(74, 112, 255, .13), transparent 25rem),
            radial-gradient(circle at 92% 8%, rgba(36, 193, 153, .09), transparent 24rem),
            #f3f6fb;
    }

    .workload-dashboard-shell {
        width: min(1500px, 100%);
        margin: 0 auto;
    }

    .workload-dashboard-hero {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 22px;
        padding: 28px 30px;
        overflow: hidden;
        color: #fff;
        border-radius: 20px;
        background: linear-gradient(120deg, #172b66 0%, #315ed8 58%, #2f8fbe 100%);
        box-shadow: 0 18px 42px rgba(31, 65, 145, .2);
    }

    .workload-dashboard-hero::after {
        content: "";
        position: absolute;
        right: -65px;
        bottom: -110px;
        width: 300px;
        height: 300px;
        border: 45px solid rgba(255, 255, 255, .08);
        border-radius: 50%;
    }

    .workload-dashboard-eyebrow {
        margin-bottom: 9px;
        color: #bcd1ff;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .16em;
        text-transform: uppercase;
    }

    .workload-dashboard-title {
        margin: 0;
        font-size: clamp(26px, 3vw, 38px);
        font-weight: 750;
        letter-spacing: -.035em;
    }

    .workload-dashboard-subtitle {
        max-width: 650px;
        margin: 9px 0 0;
        color: rgba(255, 255, 255, .76);
        font-size: 14px;
        line-height: 1.55;
    }

    .workload-dashboard-badge {
        position: relative;
        z-index: 1;
        display: inline-flex;
        flex: 0 0 auto;
        align-items: center;
        gap: 9px;
        padding: 10px 14px;
        border: 1px solid rgba(255, 255, 255, .22);
        border-radius: 999px;
        background: rgba(255, 255, 255, .12);
        font-size: 13px;
        font-weight: 600;
        backdrop-filter: blur(8px);
    }

    .workload-dashboard-badge-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #65e6b4;
        box-shadow: 0 0 0 5px rgba(101, 230, 180, .16);
    }

    .workload-dashboard-card {
        padding: 24px;
        border: 1px solid rgba(221, 226, 235, .82);
        border-radius: 20px;
        background: rgba(255, 255, 255, .92);
        box-shadow: 0 10px 32px rgba(28, 45, 78, .08);
    }

    #workloadDashboard {
        width: 100%;
        min-height: 720px;
    }

    #workloadDashboard > div > div:first-child select {
        color: #344054;
        border-color: #d9deea !important;
        box-shadow: 0 1px 2px rgba(16, 24, 40, .04);
        outline: none;
    }

    #workloadDashboard > div > div:first-child select:focus {
        border-color: #6687ed !important;
        box-shadow: 0 0 0 3px rgba(49, 94, 216, .12);
    }

    @@media (max-width: 767px) {
        .workload-dashboard-page {
            padding: 14px;
        }

        .workload-dashboard-hero {
            align-items: flex-start;
            flex-direction: column;
            padding: 22px;
            border-radius: 16px;
        }

        .workload-dashboard-card {
            padding: 14px;
            overflow-x: auto;
            border-radius: 16px;
        }

        #workloadDashboard {
            min-width: 0;
        }
    }
</style>

<main class="workload-dashboard-page">
    <div class="workload-dashboard-shell">
        <header class="workload-dashboard-hero">
            <div>
                <div class="workload-dashboard-eyebrow">Operations overview</div>
                <h1 class="workload-dashboard-title">Workload Dashboard</h1>
                <p class="workload-dashboard-subtitle">
                    Theo dõi khối lượng Quotation và Policy Issuance theo phòng ban, nhân sự và trạng thái xử lý.
                </p>
            </div>
            <div class="workload-dashboard-badge">
                <span class="workload-dashboard-badge-dot"></span>
                Dữ liệu đang hoạt động
            </div>
        </header>

        <section class="workload-dashboard-card" aria-label="Biểu đồ workload">
            <div id="workloadDashboard"></div>
        </section>
    </div>
</main>

<script>
    (function () {
        const workloadData = [
            { department: "FO", member: "An", type: "Quotation", status: "Pending", count: 5 },
            { department: "FO", member: "An", type: "Quotation", status: "Completed", count: 18 },
            { department: "FO", member: "An", type: "Policy Issuance", status: "Completed", count: 8 },
            { department: "FO", member: "Binh", type: "Quotation", status: "Completed", count: 15 },
            { department: "FO", member: "Binh", type: "Policy Issuance", status: "Pending", count: 6 },
            { department: "FO", member: "Cuong", type: "Quotation", status: "Rejected", count: 3 },
            { department: "FO", member: "Cuong", type: "Policy Issuance", status: "Completed", count: 7 },

            { department: "TS", member: "Hieu", type: "Quotation", status: "Pending", count: 10 },
            { department: "TS", member: "Hieu", type: "Quotation", status: "Completed", count: 20 },
            { department: "TS", member: "Hieu", type: "Policy Issuance", status: "Completed", count: 11 },
            { department: "TS", member: "Khanh", type: "Quotation", status: "Completed", count: 17 },
            { department: "TS", member: "Khanh", type: "Policy Issuance", status: "Pending", count: 5 },
            { department: "TS", member: "Linh", type: "Quotation", status: "Rejected", count: 2 },
            { department: "TS", member: "Linh", type: "Policy Issuance", status: "Completed", count: 12 },

            { department: "UW", member: "Nam", type: "Quotation", status: "Pending", count: 15 },
            { department: "UW", member: "Nam", type: "Quotation", status: "Completed", count: 42 },
            { department: "UW", member: "Nam", type: "Policy Issuance", status: "Completed", count: 19 },
            { department: "UW", member: "Phuong", type: "Quotation", status: "Completed", count: 35 },
            { department: "UW", member: "Phuong", type: "Policy Issuance", status: "Completed", count: 17 },
            { department: "UW", member: "Quang", type: "Quotation", status: "Pending", count: 12 },
            { department: "UW", member: "Quang", type: "Policy Issuance", status: "Pending", count: 8 },
            { department: "UW", member: "Trang", type: "Policy Issuance", status: "Rejected", count: 4 },

            { department: "PM", member: "Van", type: "Quotation", status: "Completed", count: 14 },
            { department: "PM", member: "Van", type: "Policy Issuance", status: "Completed", count: 8 },
            { department: "PM", member: "Yen", type: "Quotation", status: "Pending", count: 6 },
            { department: "PM", member: "Yen", type: "Policy Issuance", status: "Completed", count: 5 },
            { department: "PM", member: "Giang", type: "Quotation", status: "Rejected", count: 2 },
            { department: "PM", member: "Long", type: "Policy Issuance", status: "Pending", count: 4 }
        ];

        $(function () {
            const $dashboard = $("#workloadDashboard");

            if (typeof $dashboard.workloadchart !== "function") {
                $dashboard.html(
                    '<div class="alert alert-warning mb-0">Không thể tải control workloadchart từ bizform.js.</div>'
                );
                return;
            }

            $dashboard.workloadchart({ data: workloadData });
        });
    })();
</script>

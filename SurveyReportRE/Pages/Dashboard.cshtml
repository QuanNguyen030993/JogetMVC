@page
@{
}


<style>
    :root {
        --dashboard-ink: var(--c-172033);
        --dashboard-muted: var(--c-667085);
        --dashboard-line: var(--c-e7eaf0);
        --dashboard-surface: var(--c-ffffff);
    }

    body {
        margin: 0;
        color: var(--dashboard-ink);
        background: var(--c-f3f6fb);
        font-family: Inter, "Segoe UI", Arial, sans-serif;
    }

    /* Dashboard is loaded inside an absolute SPA tab, so it owns the vertical
       viewport scroll instead of relying on the document body. */
    #DashBoard {
        box-sizing: border-box;
        width: 100%;
        height: calc(100vh - 72px);
        height: calc(100dvh - 72px);
        overflow-x: hidden;
        overflow-y: auto;
        overscroll-behavior: contain;
        scrollbar-gutter: stable;
    }

    .workload-dashboard-page {
        box-sizing: border-box;
        min-height: 100%;
        padding: 16px;
        background:
            radial-gradient(circle at 8% 0%, var(--c-rgba-74-112-255-13), transparent 25rem),
            radial-gradient(circle at 92% 8%, var(--c-rgba-36-193-153-09), transparent 24rem),
            var(--c-f3f6fb);
    }

    .workload-dashboard-shell {
        width: min(1500px, 100%);
        margin: 0 auto;
    }

    .workload-dashboard-hero {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 14px;
        padding: 20px 22px;
        overflow: hidden;
        color: var(--c-ffffff);
        border-radius: 20px;
        background: linear-gradient(120deg, var(--c-172b66) 0%, var(--c-315ed8) 58%, var(--c-2f8fbe) 100%);
        box-shadow: 0 18px 42px var(--c-rgba-31-65-145-2);
    }

    .workload-dashboard-hero::after {
        content: "";
        position: absolute;
        right: -65px;
        bottom: -110px;
        width: 300px;
        height: 300px;
        border: 45px solid var(--c-rgba-255-255-255-08);
        border-radius: 50%;
    }

    .workload-dashboard-eyebrow {
        margin-bottom: 9px;
        color: var(--c-bcd1ff);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .16em;
        text-transform: uppercase;
    }

    .workload-dashboard-title {
        margin: 0;
        font-size: clamp(26px, 3vw, 38px);
        font-weight: 750;
        letter-spacing: -.035em;
    }

    .workload-dashboard-subtitle {
        max-width: 650px;
        margin: 9px 0 0;
        color: var(--c-rgba-255-255-255-76);
        font-size: 14px;
        line-height: 1.55;
    }

    .workload-dashboard-badge {
        position: relative;
        z-index: 1;
        display: inline-flex;
        flex: 0 0 auto;
        align-items: center;
        gap: 9px;
        padding: 6px 12px;
        border: 1px solid var(--c-d9deea, #d9deea);
        border-radius: 999px;
        background: var(--c-f3f6fb, #f3f6fb);
        font-size: 13px;
        font-weight: 600;
        color: var(--dashboard-ink, #1f2937);
    }

    .workload-dashboard-badge-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--c-65e6b4);
        box-shadow: 0 0 0 5px var(--c-rgba-101-230-180-16);
    }

    .workload-dashboard-badge.is-mock .workload-dashboard-badge-dot {
        background: var(--c-ffc857, #ffc857);
        box-shadow: 0 0 0 5px rgba(255, 200, 87, .16);
    }

    .workload-dashboard-source-label {
        min-width: 66px;
    }

    #workloadDataSourceSwitch {
        margin-left: 2px;
    }

    .workload-dashboard-card {
        padding: 16px;
        border: 1px solid var(--c-rgba-221-226-235-82);
        border-radius: 20px;
        background: var(--c-rgba-255-255-255-92);
        box-shadow: 0 10px 32px var(--c-rgba-28-45-78-08);
    }

    #workloadDashboard {
        width: 100%;
        min-height: 720px;
    }

    #workloadDashboard > div > div:first-child select {
        color: var(--c-344054);
        border-color: var(--c-d9deea) !important;
        box-shadow: 0 1px 2px var(--c-rgba-16-24-40-04);
        outline: none;
    }

    #workloadDashboard > div > div:first-child select:focus {
        border-color: var(--c-6687ed) !important;
        box-shadow: 0 0 0 3px var(--c-rgba-49-94-216-12);
    }

    @@media (max-width: 767px) {
        .workload-dashboard-page {
            padding: 8px;
        }

        .workload-dashboard-hero {
            align-items: flex-start;
            flex-direction: column;
            padding: 16px;
            border-radius: 16px;
        }

        .workload-dashboard-card {
            padding: 10px;
            overflow-x: auto;
            border-radius: 16px;
        }

        #workloadDashboard {
            min-width: 0;
        }
    }
</style>
<div id="DashBoard" class="dExForm">
<main class="workload-dashboard-page">
    <div class="workload-dashboard-shell">
        <section class="workload-dashboard-card" aria-label="Biểu đồ workload">
            <div class="workload-card-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; flex-wrap: wrap; gap: 10px;">
                <h1 style="margin: 0; font-size: 22px; font-weight: 750; letter-spacing: -.02em;">Workload Dashboard</h1>
                <div id="workloadDataSourceBadge" class="workload-dashboard-badge is-mock">
                    <span class="workload-dashboard-badge-dot"></span>
                    <span id="workloadDataSourceLabel" class="workload-dashboard-source-label">Mock data</span>
                    <div id="workloadDataSourceSwitch" aria-label="Switch dashboard data source"></div>
                </div>
            </div>
            <div id="workloadDashboard"></div>
        </section>
    </div>
</main>
</div>

<script>
    (function () {
        const mockWorkloadData = [
            { department: "FO", member: "An", type: "Quotation", status: "Pending", count: 5 },
            { department: "FO", member: "An", type: "Quotation", status: "Completed", count: 18 },
            { department: "FO", member: "An", type: "Policy Issuance", status: "Completed", count: 8 },
            { department: "FO", member: "Binh", type: "Quotation", status: "Completed", count: 15 },
            { department: "FO", member: "Binh", type: "Policy Issuance", status: "Pending", count: 6 },
            { department: "FO", member: "Cuong", type: "Quotation", status: "Rejected", count: 3 },
            { department: "FO", member: "Cuong", type: "Policy Issuance", status: "Completed", count: 7 },

            { department: "TS", member: "Hieu", type: "Quotation", status: "Pending", count: 10 },
            { department: "TS", member: "Hieu", type: "Quotation", status: "Completed", count: 20 },
            { department: "TS", member: "Hieu", type: "Policy Issuance", status: "Completed", count: 11 },
            { department: "TS", member: "Khanh", type: "Quotation", status: "Completed", count: 17 },
            { department: "TS", member: "Khanh", type: "Policy Issuance", status: "Pending", count: 5 },
            { department: "TS", member: "Linh", type: "Quotation", status: "Rejected", count: 2 },
            { department: "TS", member: "Linh", type: "Policy Issuance", status: "Completed", count: 12 },

            { department: "UW", member: "Nam", type: "Quotation", status: "Pending", count: 15 },
            { department: "UW", member: "Nam", type: "Quotation", status: "Completed", count: 42 },
            { department: "UW", member: "Nam", type: "Policy Issuance", status: "Completed", count: 19 },
            { department: "UW", member: "Phuong", type: "Quotation", status: "Completed", count: 35 },
            { department: "UW", member: "Phuong", type: "Policy Issuance", status: "Completed", count: 17 },
            { department: "UW", member: "Quang", type: "Quotation", status: "Pending", count: 12 },
            { department: "UW", member: "Quang", type: "Policy Issuance", status: "Pending", count: 8 },
            { department: "UW", member: "Trang", type: "Policy Issuance", status: "Rejected", count: 4 },

            { department: "PM", member: "Van", type: "Quotation", status: "Completed", count: 14 },
            { department: "PM", member: "Van", type: "Policy Issuance", status: "Completed", count: 8 },
            { department: "PM", member: "Yen", type: "Quotation", status: "Pending", count: 6 },
            { department: "PM", member: "Yen", type: "Policy Issuance", status: "Completed", count: 5 },
            { department: "PM", member: "Giang", type: "Quotation", status: "Rejected", count: 2 },
            { department: "PM", member: "Long", type: "Policy Issuance", status: "Pending", count: 4 }
        ];

        $(function () {
            const $dashboard = $("#workloadDashboard");
            const $sourceBadge = $("#workloadDataSourceBadge");
            const $sourceLabel = $("#workloadDataSourceLabel");

            if (typeof $dashboard.workloadchart !== "function") {
                $dashboard.html(
                    '<div class="alert alert-warning mb-0">Không thể tải control workloadchart từ bizform.js.</div>'
                );
                return;
            }

            const chart = $dashboard.workloadchart({ data: mockWorkloadData });
            let suppressSwitchChange = false;

            function setSourceState(source, label) {
                $sourceBadge.toggleClass("is-mock", source !== "live");
                $sourceLabel.text(label);
            }

            $("#workloadDataSourceSwitch").dxSwitch({
                value: false,
                switchedOffText: "Mock",
                switchedOnText: "Live",
                width: 82,
                onValueChanged: function (event) {
                    if (suppressSwitchChange)
                        return;

                    if (!event.value) {
                        chart.option("data", mockWorkloadData);
                        setSourceState("mock", "Mock data");
                        return;
                    }

                    const switchInstance = event.component;
                    switchInstance.option("disabled", true);
                    setSourceState("live", "Loading...");

                    $.ajax({
                        url: "/api/Dashboard/Workload",
                        method: "GET",
                        dataType: "json"
                    }).done(function (data) {
                        chart.option("data", Array.isArray(data) ? data : []);
                        setSourceState("live", "Live data");
                    }).fail(function (xhr) {
                        chart.option("data", mockWorkloadData);
                        setSourceState("mock", "Mock data");
                        suppressSwitchChange = true;
                        switchInstance.option("value", false);
                        suppressSwitchChange = false;
                        appErrorHandling("Không thể tải dữ liệu Dashboard từ database.", xhr);
                    }).always(function () {
                        switchInstance.option("disabled", false);
                    });
                }
            });
        });
    })();
</script>

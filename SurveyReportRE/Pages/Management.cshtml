                    //    .fail(function (jqXHR, textStatus, errorThrown) {
                    //        appNotify({ message: `${errorThrown}. ${jqXHR.responseText}`, type: 'warning' });
                    //    });
                }
                else {
                    appNotify({ message: `${errorThrown}. ${jqXHR.responseText}`, type: 'warning' });
                }
            }).always(function () {
                //console.log("Go to " + url);
            });
        }
        catch (err) {
            appErrorHandling('Library error: call callElementView was failed.', err);
            return;
        }
    }


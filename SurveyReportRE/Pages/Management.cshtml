<body class="sidebar-mini skin-re" style="height: auto; min-height: 100%; width: 100%;">
    <header>
        <div class="main-header wrapper management-topbar">
            <!-- LOGO -->
            <div class="management-logo-slot">
                <div class="pull-left management-logo-inner">
                    <a href="#" class="logo management-logo-link" data-toggle="push-menu" role="button">
                        <div class="logo-lg"><b>Workflow Management</b></div>
                        <div class="logo-mini" style=""><b></b></div>
                    </a>
                </div>
            </div>
            <!--Tab list-->
            <div id="tablist" class="ui-tabs-nav">
                <ul></ul>
            </div>

            <div id="tabOverflow" class="tab-overflow" hidden>
                <button id="tabOverflowButton"
                        class="tab-overflow-button"
                        type="button"
                        title="Show open tabs"
                        aria-label="Show open tabs"
                        aria-haspopup="menu"
                        aria-expanded="false">
                    <i class="fa fa-angle-down" aria-hidden="true"></i>
                </button>
                <div id="tabOverflowMenu" class="tab-overflow-menu" role="menu" hidden></div>
            </div>

            <!-- Global maintenance status. Per-form debug controls live in each
                 form's Maintenance Info panel so multiple tabs never share IDs. -->
            <div id="managementMaintenance" class="management-maintenance" aria-label="Maintenance status">
                @if (string.Equals(ViewData["NotifyEnv"]?.ToString(), "true", StringComparison.OrdinalIgnoreCase))
                {
                    <div id="environmentLabel"
                         class="management-environment-badge"
                         tabindex="0"
                         role="button"
                         aria-haspopup="dialog"
                         aria-expanded="false"
                         aria-controls="environmentPanel">

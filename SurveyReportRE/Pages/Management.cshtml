    function formatTime(dt) {
           try {
               const d = (dt instanceof Date) ? dt : new Date(dt);
               return d.toLocaleString();
           } catch { return ""; }
       }



    // ====== open item ======
    async function openNotification(item) {
        // 1) mark read
        if (!item.isRead) {
            await apiMarkRead(item.id);
            item.isRead = true;
            refreshNotifUI();
        }

        // 2) hành động mở: tùy hệ bạn
        // Nếu bạn có obj.url/caption/name kiểu loadParams -> callElementView(...)
        if (item.url) {
            // invokePageTab(item.url,true);
            callElementView(item.url.url, item.url.caption, item.url.name);
        } else {
            DevExpress.ui.notify("No target action for this notification", "warning", 1500);
        }
    }
    function refreshNotifUI() {
        _notif.unreadCount = (_notif.items || []).filter(x => !x.isRead).length;
        setNotifCount(_notif.unreadCount);

        if (_notif.list) {
            let filteredItems = _notif.items || [];
            const filter = _notif.currentFilter || "all";
            if (filter === "unread") {
                filteredItems = filteredItems.filter(x => !x.isRead);
            } else if (notificationTypeKeys.includes(filter)) {
                const filterTypeId = getNotificationTypeEnumId(filter);
                filteredItems = filteredItems.filter(x => {
                    const itemTypeId = getNotificationItemTypeId(x);
                    if (filterTypeId !== null && itemTypeId !== null) {
                        return String(itemTypeId) === String(filterTypeId);
                    }
                    return getNotificationType(x) === filter;
                });
            }
            _notif.list.option("dataSource", filteredItems);
            $("#notifHint").text(_notif.unreadCount ? `${_notif.unreadCount} unread` : "");
        }
    }


                                    <div style="opacity:.6; font-size:12px; white-space:nowrap;">${timeText}</div>
                                  </div>
                                  <div style="opacity:.85; margin-top:4px; font-size:13px;">
                                    ${escapeHtml(itemData.message || "")}
                                  </div>
                                  <div style="margin-top:8px; display:flex; gap:8px;">
                                    <a href="javascript:void(0)" class="notif-open">Open</a>
                                    <a href="javascript:void(0)" class="notif-mark">${isUnread ? "Mark read" : "Read"}</a>
                                    <a href="javascript:void(0)" class="notif-view">View message</a>
                                  </div>
                                </div>
                              </div>
                            </div>
                        `)
                        .data("item", itemData)
                        .on("click", ".notif-open", async function (e) {
                            e.stopPropagation();
                            await openNotification(itemData);
                        })
                        .on("click", ".notif-mark", async function (e) {
                            e.stopPropagation();
                            if (!itemData.isRead) {
                                await apiMarkRead(itemData.id);
                                itemData.isRead = true;
                                refreshNotifUI();
                            }
                        }).on("click", ".notif-view", async function (e) {
                            openMessageDialog(itemData);
                            
                               e.stopPropagation();
                            // mở popup đọc nội dung, không ảnh hưởng open/mark read
                        });
                    }
                }).dxList("instance");
            }
        }).dxPopover("instance");
    }

    function formatTime(dt) {
           try {
               const d = (dt instanceof Date) ? dt : new Date(dt);
               return d.toLocaleString();
           } catch { return ""; }
       }



    // ====== open item ======
    async function openNotification(item) {
        // 1) mark read
        if (!item.isRead) {
            await apiMarkRead(item.id);
            item.isRead = true;
            refreshNotifUI();
        }

        // 2) hành động mở: tùy hệ bạn
        // Nếu bạn có obj.url/caption/name kiểu loadParams -> callElementView(...)
        if (item.url) {
            // invokePageTab(item.url,true);
            callElementView(item.url.url, item.url.caption, item.url.name);
        } else {
            DevExpress.ui.notify("No target action for this notification", "warning", 1500);
        }
    }
    function refreshNotifUI() {
        _notif.unreadCount = (_notif.items || []).filter(x => !x.isRead).length;
        setNotifCount(_notif.unreadCount);

        if (_notif.list) {
            _notif.list.option("dataSource", _notif.items);
            $("#notifHint").text(_notif.unreadCount ? `${_notif.unreadCount} unread` : "");
        }
    }


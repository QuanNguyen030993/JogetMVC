    var nativeRemoveTab = function($tabDivId){
        $tabDivId.animate({
            width: '0px',
            opacity: '0'
        }, 220);
        setTimeout(function () {
            var $li = $tabDivId.closest("li");
            var panelId = $li.attr("aria-controls");
            $li.remove();

            if (panelId) {
                $("#" + panelId).remove();
                $(`#${panelId}_content_wrapper`).remove();
                document.body.classList.remove("hasRightPanel");
                $("#btnCloseRightComment").click();
                //document.documentElement.style.setProperty("--collapsed-form-mr", "-26%");
            }
            $("#tablist").tabs("refresh");
        }, 150); // === duration animate
    }

    var setTabName = function (name, code) {
        try {
            var li = $("#tablist > ul").find("[tabindex = '0']");
            if (li.length > 0) {
                var a = li.find("a");
                //set tab name
                if (name == null)
                    a.text("undefined");
                else
                    a.text(name);

                //set href
                a[0].setAttribute("href", `#${code}`);
                //set aria-controls
                li[0].setAttribute("aria-controls", code);
                //set div id
                var div = $("#tablist").find(`[aria-hidden = 'false']`);
                div[0].setAttribute("id", code);
            }
        } catch (err) {
            appErrorHandling('Library error: call setTabName was failed.', err);
            return;
        }
    };

    var tabOverflowUpdateFrame = 0;

    function renderTabOverflowMenu() {
        var $tabs = $("#tablist");
        var $menu = $("#tabOverflowMenu");
        if (!$tabs.length || !$menu.length) return;

        $menu.empty();
        $tabs.children("ul").children("li").each(function (index) {
            var $tab = $(this);
            var title = $tab.find("a").first().text().trim() || `Tab ${index + 1}`;
            var $item = $("<button>", {
                type: "button",
                class: "tab-overflow-item",
                title: title,
                role: "menuitem",
                "data-tab-index": index
            });

            $("<i>", {
                class: "fa fa-file-o tab-overflow-item-icon",
                "aria-hidden": "true"
            }).appendTo($item);
            $("<span>", {
                class: "tab-overflow-item-title",
                text: title
            }).appendTo($item);
            $("<i>", {
                class: "fa fa-check tab-overflow-item-check",
                "aria-hidden": "true"
            }).appendTo($item);

            if ($tab.hasClass("ui-tabs-active")) {
                $item.addClass("is-active").attr("aria-current", "page");
            }
            $item.appendTo($menu);
        });
    }

    function updateTabOverflow() {
        tabOverflowUpdateFrame = 0;
        var $tabList = $("#tablist");
        var $nav = $tabList.children("ul");
        var $overflow = $("#tabOverflow");
        if (!$tabList.length || !$nav.length || !$overflow.length) return;

        var isVisible = !$overflow.prop("hidden");
        var recoveredWidth = isVisible ? ($overflow.outerWidth(true) || 0) + 4 : 0;
        var availableWithoutButton = $nav[0].clientWidth + recoveredWidth;
        var needsOverflow = $nav[0].scrollWidth > availableWithoutButton + 1;

        $overflow.prop("hidden", !needsOverflow);
        if (!needsOverflow) {
            $("#tabOverflowMenu").prop("hidden", true);
            $("#tabOverflowButton").attr("aria-expanded", "false");
        } else if (!$("#tabOverflowMenu").prop("hidden")) {
            renderTabOverflowMenu();
        }
    }

    function scheduleTabOverflowUpdate() {
        if (tabOverflowUpdateFrame) cancelAnimationFrame(tabOverflowUpdateFrame);
        tabOverflowUpdateFrame = requestAnimationFrame(updateTabOverflow);
    }

    function initTabOverflow() {
        var $nav = $("#tablist").children("ul");
        var $button = $("#tabOverflowButton");
        var $menu = $("#tabOverflowMenu");
        if (!$nav.length || !$button.length || !$menu.length) return;

        $button.off("click.tabOverflow").on("click.tabOverflow", function (event) {
            event.stopPropagation();
            var willOpen = $menu.prop("hidden");
            if (willOpen) renderTabOverflowMenu();
            $menu.prop("hidden", !willOpen);
            $button.attr("aria-expanded", willOpen ? "true" : "false");
        });

        $menu.off("click.tabOverflow").on("click.tabOverflow", ".tab-overflow-item", function () {
            var tabIndex = Number($(this).attr("data-tab-index"));
            if (!Number.isInteger(tabIndex)) return;

            $("#tablist").tabs("option", "active", tabIndex);
            var tabElement = $nav.children("li").get(tabIndex);
            tabElement?.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "nearest" });
            $menu.prop("hidden", true);
            $button.attr("aria-expanded", "false");
        });

        $(document)
            .off("click.tabOverflow keydown.tabOverflow")
            .on("click.tabOverflow", function () {
                $menu.prop("hidden", true);
                $button.attr("aria-expanded", "false");
            })
            .on("keydown.tabOverflow", function (event) {
                if (event.key !== "Escape") return;
                $menu.prop("hidden", true);
                $button.attr("aria-expanded", "false");
                $button.trigger("focus");
            });

        new MutationObserver(scheduleTabOverflowUpdate).observe($nav[0], {
            childList: true,
            subtree: true,
            characterData: true,
            attributes: true,
            attributeFilter: ["class"]
        });

        if (window.ResizeObserver) {
            new ResizeObserver(scheduleTabOverflowUpdate).observe($(".management-topbar")[0]);
        } else {
            $(window).off("resize.tabOverflow").on("resize.tabOverflow", scheduleTabOverflowUpdate);
        }

        scheduleTabOverflowUpdate();
    }
</script>

    async function apiMarkAllRead() {
        const unreadItems = (_notif.items || []).filter(item => !item.isRead);
        const results = await Promise.allSettled(unreadItems.map(item => apiMarkRead(item.id)));
        let failed = 0;
        results.forEach((result, index) => {
            if (result.status === "fulfilled") {
                unreadItems[index].isRead = true;
            } else {
                failed += 1;
            }
        });
        return { updated: unreadItems.length - failed, failed };
    }


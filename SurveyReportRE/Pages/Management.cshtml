    function formatTime(dt) {
           try {
               const d = (dt instanceof Date) ? dt : new Date(dt);
               if (Number.isNaN(d.getTime())) return "";
               return d.toLocaleTimeString("en-US", {
                   hour: "numeric",
                   minute: "2-digit"
               });
           } catch { return ""; }
       }



    // ====== open item ======
    function getNotificationTarget(item) {
        let target = item?.url ?? item?.Url ?? "";
        for (let i = 0; i < 3 && typeof target === "string"; i++) {
            const value = target.trim();
            if (!value) return null;
            if (!(value.startsWith("{") || value.startsWith('"'))) {
                target = { url: value };
                break;
            }
            try { target = JSON.parse(value); } catch { return null; }
        }

        if (target?.url && typeof target.url === "object") target = target.url;
        if (!target || typeof target !== "object") return null;

        const url = target.url ?? target.Url;
        if (!url || typeof url !== "string") return null;
        return {
            url: url,
            caption: target.caption ?? target.Caption ?? target.code ?? target.Code
                ?? `notification_${item?.recordGuid ?? item?.RecordGuid ?? item?.id ?? item?.Id}`,
            name: target.name ?? target.Name ?? item?.title ?? item?.Title ?? "Notification",
            data: target.data ?? target.Data ?? null
        };
    }

    async function openNotification(item) {
        const itemId = String(item?.id ?? item?.Id ?? "");
        if (_notif.openingIds.has(itemId)) return;
        _notif.openingIds.add(itemId);
        setTimeout(() => _notif.openingIds.delete(itemId), 800);

        // 1) mark read
        if (!item.isRead) {
            item.isRead = true;
            refreshNotifUI();
            apiMarkRead(item.id).catch(function (err) {
                item.isRead = false;
                refreshNotifUI();
                console.warn("Unable to mark notification as read", err);
            });
        }

        // 2) hành động mở: tùy hệ bạn
        // Nếu bạn có obj.url/caption/name kiểu loadParams -> callElementView(...)
        const target = getNotificationTarget(item);
        if (!target) {
            DevExpress.ui.notify("No target action for this notification", "warning", 1500);
            return;
        }

        _notif.popover?.hide();
        callElementView(target.url, target.caption, target.name, target.data);
    }
    function refreshNotifUI() {
        _notif.unreadCount = (_notif.items || []).filter(x => x.receivedBy == _loginUser && !x.isRead).length;
        setNotifCount(_notif.unreadCount);

        if (_notif.list) {
            let filteredItems = _notif.items || [];
            const filter = _notif.currentFilter || "all";
            if (filter === "unread") {
                filteredItems = filteredItems.filter(x => !x.isRead);
            } else if (filter.startsWith("type:")) {
                const filterTypeId = filter.substring("type:".length);
                filteredItems = filteredItems.filter(x =>
                    String(getNotificationItemTypeId(x)) === String(filterTypeId)
                );
            } else if (notificationTypeKeys.includes(filter)) {
                const filterTypeId = getNotificationTypeEnumId(filter);
                filteredItems = filteredItems.filter(x => {
                    const itemTypeId = getNotificationItemTypeId(x);
                    if (filterTypeId !== null && itemTypeId !== null) {
                        return String(itemTypeId) === String(filterTypeId);
                    }
                    return getNotificationType(x) === filter;
                });
            }
            _notif.list.option("dataSource", filteredItems);
            $("#notifHint").text(_notif.unreadCount ? `${_notif.unreadCount} unread` : "");
        }
    }


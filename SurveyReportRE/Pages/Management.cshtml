    const notificationTypeKeys = [
        "default", "assign", "system", "policyissuance", "quotation", "accept",
        "success", "fail", "initial", "reminder", "alert", "comment"
    ];

    function normalizeNotificationType(value) {
        return String(value || "").trim().toLowerCase().replace(/[\s_-]+/g, "");
    }

    function getNotificationTypeEnumItem(typeKey) {
        const aliases = {
            default: ["default"],
            assign: ["assign", "assignment"],
            system: ["system", "sys"],
            quotation: ["quotation", viewIdModulePrefix.quotation],
            policyissuance: ["policyissuance", "policy", viewIdModulePrefix.policyIssuance],
            accept: ["accept", "accepted"],
            success: ["success", "successful"],
            fail: ["fail", "failed", "failure"],
            initial: ["initial", "initialize", "initialized", "initiate", "initiated", "initiation", "inititial"],
            reminder: ["reminder", "remind"],
            alert: ["alert"],
            comment: ["comment"]
        };
        const acceptedValues = aliases[typeKey] || [typeKey];

        return (_enums.NotificationType || []).find(enumItem => {
            const values = [enumItem?.code, enumItem?.key, enumItem?.value, enumItem?.name, enumItem?.text]
                .map(normalizeNotificationType);
            return values.some(value => acceptedValues.includes(value));
        }) || null;
    }

    function getNotificationTypeEnumId(typeKey) {
        const enumItem = getNotificationTypeEnumItem(typeKey);
        return enumItem?.id ?? enumItem?.Id ?? null;
    }

    function getNotificationTypeEnumText(enumItem) {
        return enumItem?.text ?? enumItem?.Text
            ?? enumItem?.value ?? enumItem?.Value
            ?? enumItem?.code ?? enumItem?.Code
            ?? enumItem?.key ?? enumItem?.Key
            ?? enumItem?.name ?? enumItem?.Name
            ?? "";
    }

    function buildNotificationTypeFilterDataSource() {
        const result = [
            { value: "all", text: "All categories", typeId: null },
            { value: "unread", text: "Unread", typeId: null }
        ];
        const seenIds = new Set();

        [...(_enums.NotificationType || [])]
            .sort((left, right) =>
                Number(left?.enumOrder ?? left?.EnumOrder ?? 0)
                - Number(right?.enumOrder ?? right?.EnumOrder ?? 0)
            )
            .forEach(enumItem => {
                const typeId = enumItem?.id ?? enumItem?.Id;
                if (typeId === null || typeId === undefined || seenIds.has(String(typeId))) return;

                seenIds.add(String(typeId));
                result.push({
                    value: `type:${typeId}`,
                    text: getNotificationTypeEnumText(enumItem) || `Type ${typeId}`,
                    typeId: typeId
                });
            });

        return result;
    }

    function refreshNotificationTypeFilterData() {
        if (!_notif.typeFilter) return;

        const dataSource = buildNotificationTypeFilterDataSource();
        const currentValue = _notif.currentFilter || "all";
        const nextValue = dataSource.some(item => item.value === currentValue) ? currentValue : "all";

        _notif.currentFilter = nextValue;
        _notif.typeFilter.option({
            dataSource: dataSource,
            value: nextValue
        });
    }

    function getNotificationItemTypeId(item) {
        let enumType = item?.type ?? item?.Type;
        if (typeof enumType === "string" && enumType.trim().startsWith("{")) {
            try { enumType = JSON.parse(enumType); } catch { }
        }

        if (enumType && typeof enumType === "object") {
            return enumType.id ?? enumType.Id ?? item?.typeId ?? item?.TypeId ?? null;
        }

        if (typeof enumType === "number" || /^\d+$/.test(String(enumType || ""))) {
            return enumType;
        }
        return item?.typeId ?? item?.TypeId ?? null;
    }

    function getNotificationType(item) {
        const notificationTypeId = getNotificationItemTypeId(item);
        if (notificationTypeId !== null && notificationTypeId !== undefined) {
            for (const typeKey of notificationTypeKeys) {
                const enumId = getNotificationTypeEnumId(typeKey);
                if (enumId !== null && String(enumId) === String(notificationTypeId)) {
                    // Old notifications can have the Default type even though their
                    // title clearly identifies a more specific event. Keep evaluating
                    // those items so the title fallback below can classify them.
                    if (typeKey !== "default") return typeKey;
                    break;
                }
            }
        }

        let enumType = item?.type ?? item?.Type;
        if (typeof enumType === "string" && enumType.trim().startsWith("{")) {
            try { enumType = JSON.parse(enumType); } catch { }
        }

        const candidates = typeof enumType === "object" && enumType
            ? [enumType.code, enumType.key, enumType.value, enumType.name, enumType.text, enumType.displayName]
            : [enumType, item?.typeCode, item?.typeName];

        for (const candidate of candidates) {
            const type = normalizeNotificationType(candidate);
            if (type === "default") continue;
            if (type.includes("assign")) return "assign";
            if (type === "system" || type === "sys") return "system";
            if (type === viewIdModulePrefix.quotation || type.includes("quotation")) return "quotation";
            if (type === viewIdModulePrefix.policyIssuance || type.includes("policyissuance") || type.includes("policy")) return "policyissuance";
            if (type.includes("accept")) return "accept";
            if (type.includes("success")) return "success";
            if (type.includes("fail")) return "fail";
            if (type.includes("initial")) return "initial";
            if (type.includes("remind")) return "reminder";
            if (type.includes("alert")) return "alert";
            if (type.includes("comment")) return "comment";
        }

        // Backward compatibility for notifications created before Type was populated.
        const title = String(item?.title ?? item?.Title ?? "").toUpperCase();
        const normalizedTitle = normalizeNotificationType(title);
        if (
            normalizedTitle.includes("initial")
            || normalizedTitle.includes("inititial")
            || normalizedTitle.includes("initiat")
            || /\b(?:CREATE|CREATED|START|STARTED)\b/.test(title)
        ) return "initial";
        if (title.includes("[QT]")) return "quotation";
        if (title.includes("[PI]")) return "policyissuance";
        return "default";
    }


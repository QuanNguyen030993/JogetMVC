<script type="text/javascript">
    // function monitorConnection(url, buttonId, interval = 5000) {
        // checkConnection(url, interval).then(className => {
        //         updateButtonStatus(buttonId, className);
        //     });
        // }

        // removed this as not need any more => var appLoadingPanel = $("<div>").appendTo($(constNotifyContainer)).dxLoadPanel({ visible: false }).dxLoadPanel("instance");
        initTabs();
        initTabOverflow();

        //Close tab button function
        $("#tablist").on("click", "span.fa.fa-times", function () {
            var $tabDivId = $(this).closest("[id$='_li_tab']");
            nativeRemoveTab($tabDivId);
        });

        // Chrome controls the wording of this dialog. It is intentionally
        // registered for the whole main screen so closing/reloading the actual
        // browser tab always requests confirmation after user interaction.
        window.addEventListener("beforeunload", function (event) {
            event.preventDefault();
            event.returnValue = true;
            return true;
        });

        window.addEventListener("unload", () => {
            navigator.sendBeacon(
                "/api/log-hours",
                    JSON.stringify({
                totalHours: calculateTotalHours()
                })
            );
        });

        _isSuperUser = @Html.Raw(ViewData["IsSuperUser"]);
        _isDebugMode = `@Html.Raw(ViewData["IsDebugMode"])`;

        (function initializeHomeRoleSwitcher() {
            const canSwitchRole = String(_isDebugMode).toLowerCase() === "true"
                || String(_isSuperUser).toLowerCase() === "true";
            const $switcher = $("#homeRoleSwitcher").toggleClass("is-visible", canSwitchRole);
            const $select = $("#homeRoleSelect");
            const roles = qtDeptModuleCode.slice();
            let syncingRole = false;

            function notifyOpenWorkflowViews(role) {
                $(`[id^='${viewIdModulePrefix.quotation}-overviewRoot_'], ` +
                    `[id^='${viewIdModulePrefix.policyIssuance}-overviewRoot_']`).each(function () {
                    const match = String(this.id || "").match(/^(qt|pi)-overviewRoot_(.+)$/);
                    if (!match) return;
                    $(document).trigger("overviewMaintenanceRoleChanged", [{
                        moduleCode: match[1],
                        recordId: match[2],
                        role: role,
                        source: "home"
                    }]);
                });
            }

            window.syncHomeRoleSwitcher = function (role) {
                const normalizedRole = String(role || "").trim().toUpperCase();
                const instance = $select.hasClass("dx-selectbox")
                    ? $select.dxSelectBox("instance")
                    : null;
                if (!instance || !roles.includes(normalizedRole)) return;
                syncingRole = true;
                instance.option("value", normalizedRole);
                syncingRole = false;
            };

            if (!canSwitchRole || !$select.length) return;

            $select.dxSelectBox({
                dataSource: roles,
                value: roles.includes(String(_role || "").trim().toUpperCase())
                    ? String(_role).trim().toUpperCase()
                    : null,
                placeholder: "Role",
                stylingMode: "outlined",
                width: 76,
                searchEnabled: false,
                showClearButton: false,
                onValueChanged: function (e) {
                    if (syncingRole || !e.value) return;
                    _role = e.value;
                    window._role = e.value;
                    notifyOpenWorkflowViews(e.value);
                    window.refreshRouteCommentPermissions?.();
                    DevExpress.ui.notify("Role switched: " + e.value, "info", 1200);
                }
            });

            window.syncHomeRoleSwitcher(_role);
            $switcher.attr("aria-hidden", "false");
        })();

        var _notifyEnv = `@Html.Raw(ViewData["NotifyEnv"])`;
        if (_notifyEnv == "true") {
            $("#environmentLabel").addClass("is-visible");
        }
        window.syncLoginUserSiteOffice = function (branch) {
            const office = String(branch || "").trim();
            $("#userSiteOffice").text(office || "-");
        };
        window.syncLoginUserSiteOffice(_branch);

        (function initializeEnvironmentPanel() {
            const $trigger = $("#environmentLabel");
            const $panel = $("#environmentPanel");
            if (!$trigger.length || !$panel.length) return;

            function setEnvironmentPanelOpen(isOpen) {
                $trigger.toggleClass("is-open", isOpen).attr("aria-expanded", String(isOpen));
            }

            $trigger.on("click", function (event) {
                if ($(event.target).closest("#environmentPanel").length) return;
                setEnvironmentPanelOpen(!$trigger.hasClass("is-open"));
            });
            $trigger.on("keydown", function (event) {
                if (event.target !== this || !["Enter", " "].includes(event.key)) return;
                event.preventDefault();
                setEnvironmentPanelOpen(!$trigger.hasClass("is-open"));
            });
            $panel.on("click", function (event) {
                event.stopPropagation();
            });
            $(document).on("click.environmentPanel", function (event) {
                if ($(event.target).closest("#environmentLabel, .dx-overlay-wrapper").length) return;
                setEnvironmentPanelOpen(false);
            });
            $(document).on("keydown.environmentPanel", function (event) {
                if (event.key === "Escape") setEnvironmentPanelOpen(false);
            });
        })();
        // if (_notifyEnv  == "true")
        //     $("#environmentJogetLabel").text(`(Joget Environment: @ViewData["JogetEnvironment"])`);
        if (_isDebugMode == "true"){


            $("#returnToSuperUser").dxButton({
                 text: "Back To Admin",
                 stylingMode: "contained",
                 type: "normal",
                 onClick: function () {
                     $.ajax({
                         url: `/api/Users/ReturnToAccount`,
                         method: "POST",
                         success: function (response) {
                             appNotify({ message: response.message, type: "success" });
                             setTimeout(function () {
                                 window.location.replace(`${response.redirectUrl || "/Management"}?returned=${Date.now()}`);
                             }, 400);
                         },
                         error: function (err) {
                             appNotify({
                                 message: err.responseJSON?.message || "Unable to return to the original account.",
                                 type: "error"
                             });
                         }
                     });
                 },
            });
        }


            var loadParams = `@Html.Raw(@ViewData["LoadParams"])`;
            var validJsonString = loadParams.slice(1, -1);
            if (loadParams != "{}" && loadParams != "" && loadParams != undefined && loadParams != null) {
                invokePageTab(validJsonString);
                // var obj = JSON.parse(validJsonString);
                //   setTimeout(() => {
                //     callElementView(obj.url, obj.caption, obj.name, null)
                //     window.history.replaceState(null, '', '/Management#');
                //    }, 1000);
            }

    const fallbackRoleDescriptions = {
        FO: "Front Office - tiếp nhận yêu cầu và phối hợp với khách hàng.",
        TS: "Technical Services - chuẩn bị và rà soát nội dung kỹ thuật.",
        PM: "Product Management - quản lý sản phẩm và điều khoản.",
        UW: "Underwriting - đánh giá rủi ro và quyết định nhận bảo hiểm.",
        LMKT: "Local Marketing - điều phối kinh doanh và phát hành đơn."
    };
    const fallbackRoleOptions = [...new Set([...qtDeptModuleCode, ...piDeptModuleCode])]
        .map(code => ({ code, description: fallbackRoleDescriptions[code] || code }));
    let selectedUserRole = "";
    let userRoleOptions = fallbackRoleOptions;
    const chromeNotificationStoragePrefix = "tmiv.chromeNotifications.enabled:";
    let currentSettingsAccount = "";
    let chromeNotificationsEnabled = true;
    const allowedUserThemes = ["reactify", "classic"];
    const themeStoragePrefix = "tmiv.theme:";
    let savedUserTheme = window.tmivTheme || "reactify";
    let selectedUserTheme = savedUserTheme;
    window.tmivChromeNotificationsEnabled = true;

    function getThemeStorageKey() {
        const account = String(currentSettingsAccount || _loginUser || "anonymous")
            .trim()
            .toLowerCase();
        return `${themeStoragePrefix}${account}`;
    }

    function readThemePreference() {
        try {
            const accountTheme = localStorage.getItem(getThemeStorageKey());
            const globalTheme = localStorage.getItem("tmiv.theme");
            const theme = accountTheme || globalTheme || "reactify";
            return allowedUserThemes.includes(theme) ? theme : "reactify";
        } catch {
            return "reactify";
        }
    }

    function renderThemePreference() {
        $("input[name='accountTheme']").each(function () {
            const isSelected = this.value === selectedUserTheme;
            $(this).prop("checked", isSelected);
            $(this).closest(".account-theme-card").toggleClass("is-selected", isSelected);
        });
    }

    function applyThemePreference(theme, persist) {
        const nextTheme = allowedUserThemes.includes(theme) ? theme : "reactify";
        selectedUserTheme = nextTheme;
        document.documentElement.dataset.appTheme = nextTheme;
        window.tmivTheme = nextTheme;
        renderThemePreference();
        if (persist) {
            savedUserTheme = nextTheme;
            try {
                localStorage.setItem("tmiv.theme", nextTheme);
                localStorage.setItem(getThemeStorageKey(), nextTheme);
            } catch (error) {
                console.warn("Unable to save interface theme preference.", error);
            }
        }
    }

    function getChromeNotificationStorageKey() {
        const account = String(currentSettingsAccount || _loginUser || "anonymous")
            .trim()
            .toLowerCase();
        return `${chromeNotificationStoragePrefix}${account}`;
    }

    function readChromeNotificationPreference() {
        try {
            const storedValue = localStorage.getItem(getChromeNotificationStorageKey());
            return storedValue === null ? true : storedValue === "true";
        } catch {
            return true;
        }
    }

    function updateChromeNotificationPermissionStatus() {
        const $status = $("#chromeNotificationPermissionStatus");
        if (!("Notification" in window)) {
            $status.text("Chrome notifications are unavailable; TMIVCom Notification will be used.");
            return;
        }

        if (!chromeNotificationsEnabled) {
            $status.text("Disabled — using TMIVCom Notification.");
            return;
        }

        const permissionText = Notification.permission === "granted"
            ? "Enabled and allowed by the browser."
            : Notification.permission === "denied"
                ? "Enabled, but browser permission is blocked — using TMIVCom Notification."
                : "Enable and save to request browser permission.";
        $status.text(permissionText);
    }

    function applyChromeNotificationPreference(enabled, persist) {
        chromeNotificationsEnabled = enabled === true;
        window.tmivChromeNotificationsEnabled = chromeNotificationsEnabled;
        $("#enableChromeNotifications").prop("checked", chromeNotificationsEnabled);
        if (persist) {
            try {
                localStorage.setItem(
                    getChromeNotificationStorageKey(),
                    String(chromeNotificationsEnabled));
            } catch (error) {
                console.warn("Unable to save Chrome notification preference.", error);
            }
        }
        updateChromeNotificationPermissionStatus();
    }

    function requestChromeNotificationPermissionIfNeeded() {
        if (!chromeNotificationsEnabled
            || !("Notification" in window)
            || Notification.permission !== "default") {
            updateChromeNotificationPermissionStatus();
            return Promise.resolve(window.Notification?.permission ?? "unavailable");
        }

        return Notification.requestPermission()
            .then(function (permission) {
                updateChromeNotificationPermissionStatus();
                return permission;
            })
            .catch(function (error) {
                console.warn("Chrome notification permission request failed.", error);
                updateChromeNotificationPermissionStatus();
                return "denied";
            });
    }

    function setUserSettingsModalVisible(visible) {
        $("#userSettingsModal")
            .prop("hidden", !visible)
            .toggleClass("is-open", visible)
            .attr("aria-hidden", visible ? "false" : "true");
    }

    function renderUserRoleOptions() {
        $("#userRoleOptions").html(userRoleOptions.map(role => `
            <label class="user-role-card ${selectedUserRole === role.code ? "is-selected" : ""}">
                <input type="radio" name="userWorkflowRole" value="${role.code}" ${selectedUserRole === role.code ? "checked" : ""} />
                <span class="user-role-code">${role.code}</span>
                <span class="user-role-description">${role.description}</span>
                <span class="user-role-check"><i class="fa fa-check"></i></span>
            </label>
        `).join(""));
    }

    function refreshUserRoleSettings(openModal = false) {
        return $.get("/api/Employee/GetMyRoleSettings")
            .done(function (response) {
                if (!response?.success) return;
                const profile = response.data;
                currentSettingsAccount = profile.accountName || _loginUser || "";
                savedUserTheme = readThemePreference();
                applyThemePreference(savedUserTheme, false);
                applyChromeNotificationPreference(readChromeNotificationPreference(), false);
                selectedUserRole = (profile.role || "").toUpperCase();
                userRoleOptions = profile.roles?.length ? profile.roles : fallbackRoleOptions;
                $("#accountRoleBadge").text(selectedUserRole || "Role not selected");
                $("#roleLabel").text(selectedUserRole ? `Phòng ban ${selectedUserRole}` : "Phòng ban chưa chọn");
                $("#displayLabel").text(profile.fullName || _displayName || profile.accountName);
                const initial = (profile.fullName || profile.accountName || "U").charAt(0).toUpperCase();
                $("#accountAvatarInitial").text(initial);
                renderUserRoleOptions();
                // Only reveal after the role cards have been fully rendered.
                if (openModal) setUserSettingsModalVisible(true);
            })
            .fail(function (xhr) {
                appNotify({ message: xhr.responseJSON?.message || "Unable to load account settings.", type: "warning" });
            });
    }

    $("#userAccountTrigger").on("click", function (e) {
        e.stopPropagation();
        $("#dropdown-menu").toggle();
        $(this).attr("aria-expanded", $("#dropdown-menu").is(":visible"));
    });

    $(document).on("click", function () {
        $("#dropdown-menu").hide();
        $("#userAccountTrigger").attr("aria-expanded", "false");
    });

    $("#dropdown-menu").on("click", function (e) { e.stopPropagation(); });
    $("#openUserSettings").on("click", function () {
        $("#dropdown-menu").hide();
        refreshUserRoleSettings(true);
    });
    $("#closeUserSettings, #cancelUserSettings, .user-settings-backdrop").on("click", function () {
        applyThemePreference(savedUserTheme, false);
        setUserSettingsModalVisible(false);
    });
    $("#userRoleOptions").on("change", "input[name='userWorkflowRole']", function () {
        selectedUserRole = this.value;
        renderUserRoleOptions();
    });
    $("#enableChromeNotifications").on("change", function () {
        chromeNotificationsEnabled = this.checked === true;
        window.tmivChromeNotificationsEnabled = chromeNotificationsEnabled;
        updateChromeNotificationPermissionStatus();
    });
    $("#accountThemeOptions").on("change", "input[name='accountTheme']", function () {
        applyThemePreference(this.value, false);
    });
    $("#saveUserSettings").on("click", function () {
        if (!selectedUserRole) {
            appNotify({ message: "Please select a role.", type: "warning" });
            return;

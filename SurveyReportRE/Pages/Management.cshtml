                        <span>Environment</span>
                        <strong id="environmentValue">@ViewData["Environment"]</strong>
                        <i class="fa fa-chevron-down management-environment-info-icon" aria-hidden="true"></i>
                        <div id="environmentPanel" class="management-environment-hover" role="dialog" aria-label="Development diagnostics">
                            <strong>Development diagnostics</strong>
                            <div class="management-environment-summary">
                                <div class="management-environment-summary-row">
                                    <span>Environment</span>
                                    <b>@ViewData["Environment"]</b>
                                </div>
                            </div>

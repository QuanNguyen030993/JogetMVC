    function formatTime(dt) {
        try {
            const d = (dt instanceof Date) ? dt : new Date(dt);
            return d.toLocaleString();
        } catch { return ""; }
    }

    function escapeHtml(str) {
        return (str || "").replace(/[&<>"']/g, s => ({
            "&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"
        }[s]));
    }

    // ====== open item ======
    async function openNotification(item) {
        // 1) mark read
        if (!item.isRead) {
            await apiMarkRead(item.id);
            item.isRead = true;
            refreshNotifUI();
        }

        // 2) hành động mở: tùy hệ bạn
        // Nếu bạn có obj.url/caption/name kiểu loadParams -> callElementView(...)
        if (item.url) {
            invokePageTab(item.url,true);
        } else {
            DevExpress.ui.notify("No target action for this notification", "warning", 1500);
        }
    }

    // ====== reload + refresh UI ======
    async function reloadNotifications(take = 30) {
        try {
            const res = await apiGetNotifications(take);
            _notif.items = res.items || [];
            refreshNotifUI();
        } catch (e) {
            console.error(e);
        }
    }

    function refreshNotifUI() {
        _notif.unreadCount = (_notif.items || []).filter(x => !x.isRead).length;
        setNotifCount(_notif.unreadCount);

        if (_notif.list) {
            _notif.list.option("dataSource", _notif.items);
            $("#notifHint").text(_notif.unreadCount ? `${_notif.unreadCount} unread` : "");
        }
    }

    // ====== public function you already call ======
    function updateNotification(intervalMs = 10000) {
        reloadNotifications();

        // polling
        setInterval(() => {
            reloadNotifications();
        }, intervalMs);
    }

    function invokePageTab(objString, isNotify = false){
        var  obj = JSON.parse(objString);
                  setTimeout(() => {
                    callElementView(obj.url, obj.caption, obj.name, null)
                    if (!isNotify)
                    window.history.replaceState(null, '', '/Management#');
                   }, 1000);
    }


    async function importExcel(file) {
        var form = new FormData();
        form.append("file", file);

        var res = await fetch("/api/Utility/import", { method: "POST", body: form });
        var json = await res.json(); // { planId: 123 }

        // reload gantt bằng planId mới
        loadGantt(json.planId);
    }
    function toDate(v) {
        if (!v) return null;
        if (v instanceof Date) return v;

        // nếu v là string: "2019-02-21T05:00:00.000Z" hoặc "2019-02-21"
        const d = new Date(v);
        return isNaN(d.getTime()) ? null : d;
    }

    async function exportPlanXlsxFromGantt(chartG) {
        var chartInstance = chartG.dxGantt("instance");
        var tasks = chartInstance.option("tasks.dataSource");
        var deps = chartInstance.option("dependencies.dataSource");
        var rs = chartInstance.option("resources.dataSource");
        var ras = chartInstance.option("resourceAssignments.dataSource");


        var wb = new ExcelJS.Workbook();

        // Sheet 1: Tasks
        var wsTasks = wb.addWorksheet("Tasks");
        wsTasks.addRow(["id", "parentId", "title", "start", "end", "progress"]);
        var i = 2;
        var colorMap = buildColorMapByParentId(tasks);

        tasks.forEach(t => {


            wsTasks.addRow([
                t.id,
                t.parentId ?? 0,
                t.title,
                toDate(t.start),
                toDate(t.end),
                t.progress
            ]);
            var excelRow = i;
            var argb = colorMap.get(t.id) || "FFFFFFFF";
            fillRow(wsTasks, excelRow, 1, 6, argb); // ví dụ tô 2 cột id,parentId
            i++
        });

        // Sheet 2: Dependencies
        var wsDeps = wb.addWorksheet("Dependencies");
        wsDeps.addRow(["id", "predecessorId", "successorId", "type"]);
        deps.forEach(d => {
            wsDeps.addRow([d.id, d.predecessorId, d.successorId, d.type]);

        });

        var wsrss = wb.addWorksheet("Resources");
        wsrss.addRow(["id", "text"]);
        rs.forEach(d => {
            wsrss.addRow([d.id, d.text]);
        });

        var wsrass = wb.addWorksheet("ResourceAssignments");
        wsrass.addRow(["id", "taskId", "resourceId"]);
        ras.forEach(d => {
            wsrass.addRow([d.id, d.taskId, d.resourceId]);
        });

        var buffer = await wb.xlsx.writeBuffer();
        saveAs(new Blob([buffer]), "plan.xlsx");
    }
    function fillRow(ws, rowIndex, fromCol, toCol, argb) {
        // for (let c = fromCol; c <= toCol; c++) {
        //     var cell = ws.getRow(rowIndex).getCell(c);
        //     cell.fill = { type: "pattern", pattern: "solid", fgColor: { argb } };
        // }
        for (let c = fromCol; c <= toCol; c++) {
            ws.getRow(rowIndex).getCell(c).fill = {
                type: "pattern",
                pattern: "solid",
                fgColor: { argb }
            };
            if (argb === COLOR_PARENT_GREEN)
             ws.getRow(rowIndex).getCell(c).font = {color: {argb: "ffffffff"}};

           if (argb === COLOR_TASK_BLUE)
             ws.getRow(rowIndex).getCell(c).font = {color: {argb: "ffffffff"}};
        }
    }

    var COLOR_PARENT_GREEN = "FF7DC67D"; // xanh lá (parent)
    var COLOR_TASK_BLUE = "FF2E77BB"; // xanh dương (child) - anh có thể đổi đúng shade
    // var COLOR_TASK_BLUE = "FFFFFFFF"; // xanh dương (child) - anh có thể đổi đúng shade

    function buildColorMapByParentId(rows) {
        // rows: [{id:1,parentId:0}, ...]
        var hasChild = new Set();

        for (var r of rows) {
            if (r.parentId != null && r.parentId !== 0) {
                hasChild.add(r.parentId);
            }
        }

        var colorMap = new Map(); // id -> ARGB
        for (var r of rows) {
            var isLeaf = !hasChild.has(r.id);
            colorMap.set(r.id, isLeaf ? COLOR_TASK_BLUE : COLOR_PARENT_GREEN);
        }
        return colorMap;
    }
     // tasks có id,parentId
    $("#scaleTypeGroup").dxRadioGroup({
        items: [
            { text: "Days", value: "days" },
            { text: "Weeks", value: "weeks" },
            { text: "Months", value: "months" },
            { text: "Quarters", value: "quarters" },

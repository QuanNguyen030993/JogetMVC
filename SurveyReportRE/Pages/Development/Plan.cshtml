    var $file = $("#excelFileHidden");

    // Nút nhìn như dxButton
    $("#btnImportExcel").dxButton({
        text: "Import",
        icon: "upload",
        type: "default",
        stylingMode: "contained",
        onClick: function () {
            // mở hộp thoại chọn file
            $file.trigger("click");
        }
    });

    // Khi user chọn file xong -> auto gọi API
    $file.on("change", async function () {
        var file = this.files?.[0];
        if (!file) return;

        // reset để lần sau chọn lại đúng file vẫn trigger change
        this.value = "";

        // chỉ nhận .xlsx
        if (!file.name.toLowerCase().endsWith(".xlsx")) {
            DevExpress.ui.notify("Only support .xlsx", "warning", 2500);
            return;
        }

        var btn = $("#btnImportExcel").dxButton("instance");

        var formData = new FormData();
        formData.append("file", file); // name phải khớp API [FromForm] IFormFile file

        try {
            btn.option({ disabled: true, text: "Importing..." });

            var resp = await fetch("/api/Utility/ImportExcel", {
                method: "POST",
                body: formData
            });

            var data = await resp.json().catch(() => null);

            if (!resp.ok) {
                DevExpress.ui.notify(data?.message || `Import failed (${resp.status})`, "error", 4000);
                return;
            }

            DevExpress.ui.notify(data?.message || "Import done", "success", 2500);
            callElementView(`/Development/Plan`, `Plan`, `Plan`);
            // Nếu muốn reload gantt sau import:

        } catch (e) {
            DevExpress.ui.notify(e?.message || "Error API", "error", 4000);
        } finally {
            btn.option({ disabled: false, text: "Import Excel" });
        }
    });
    async function uploadExcelBlob(excelBlob) {
        const formData = new FormData();

        // quan trọng: field name = "file" phải khớp API
        formData.append(
            "file",
            excelBlob,
            "gantt-plan.xlsx"   // fake filename
        );

        const resp = await fetch("/api/Utility/ImportExcel", {
            method: "POST",
            body: formData
        });

        const data = await resp.json().catch(() => null);

        if (!resp.ok) {
            throw new Error(data?.message || `ImportExcel failed (${resp.status})`);
        }

        return data;
    }
    async function exportGanttToExcelBlob(chartG) {
        var chartInstance = chartG.dxGantt("instance");
        var tasks = chartInstance.option("tasks.dataSource");
        var deps = chartInstance.option("dependencies.dataSource");
        var rs = chartInstance.option("resources.dataSource");
        var ras = chartInstance.option("resourceAssignments.dataSource");


        var wb = new ExcelJS.Workbook();

        // Sheet 1: Tasks
        var wsTasks = wb.addWorksheet("Tasks");
        wsTasks.addRow(["id", "parentId", "title", "start", "end", "progress"]);
        var i = 2;
        var colorMap = buildColorMapByParentId(tasks);

        tasks.forEach(t => {


            wsTasks.addRow([
                t.id,
                t.parentId ?? 0,
                t.title,
                toDate(t.start),
                toDate(t.end),
                t.progress
            ]);
            var excelRow = i;
            var argb = colorMap.get(t.id) || "FFFFFFFF";
            fillRow(wsTasks, excelRow, 1, 6, argb); // ví dụ tô 2 cột id,parentId
            i++
        });

        // Sheet 2: Dependencies
        var wsDeps = wb.addWorksheet("Dependencies");
        wsDeps.addRow(["id", "predecessorId", "successorId", "type"]);
        deps.forEach(d => {
            wsDeps.addRow([d.id, d.predecessorId, d.successorId, d.type]);

        });

        var wsrss = wb.addWorksheet("Resources");
        wsrss.addRow(["id", "text"]);
        rs.forEach(d => {
            wsrss.addRow([d.id, d.text]);
        });

        var wsrass = wb.addWorksheet("ResourceAssignments");
        wsrass.addRow(["id", "taskId", "resourceId"]);
        ras.forEach(d => {
            wsrass.addRow([d.id, d.taskId, d.resourceId]);
        });

        var buffer = await wb.xlsx.writeBuffer();


        // 👉 tạo Blob giả lập file excel
        return new Blob(
            [buffer],
            { type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" }
        );
    }

    $("#ganttExport").dxButton({
        text:"Export",
        type: "default",
        icon: "export",
        onClick: function(e){
            exportPlanXlsxFromGantt(chartG);
        }
    })
    $("#saveGantt").dxButton({
        text: "Save",
        type: "default",
        icon: "save",
        onClick: async function (e) {
            try {
                DevExpress.ui.notify("Saving gantt...", "info", 1500);

                // 1) export gantt data -> Excel Blob (in-memory)
                const excelBlob = await exportGanttToExcelBlob(chartG);

                // 2) gọi API ImportExcel với Blob như file upload
                await uploadExcelBlob(excelBlob);

                DevExpress.ui.notify("Save gantt thành công", "success", 2500);
            }
            catch (e) {
                DevExpress.ui.notify(e?.message || "Save gantt lỗi", "error", 4000);
            }
        }
    })

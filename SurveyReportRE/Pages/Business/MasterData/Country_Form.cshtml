@page "{pageNum:int?}"
@model Country_FormModel
@{

}
<script>
    $(function () {
        var _id = @Convert.ToInt32(ViewData["Id"]);
        var _formConfig = new Object();
        _formConfig.tabName = '@HttpContext.Request.Query["Caption"].ToString()';
        _formConfig.originModelName = "@Country_FormModel.ModelName";
        _formConfig.formElementName = "@Country_FormModel.ModelName";
        _formConfig.colCount = 1;
        _formConfig.schemeBasedOn = `@(Country_FormModel.SchemeModelName)`;
        _formConfig.allowFormActionButton = true;
        _formConfig.colCount = 1;
       
        var mFormOption = new MFormOption(_formConfig, null);
        new CountryForm(_id, null, _formConfig, mFormOption);
    });
</script>
<div id="form_@(Country_FormModel.ModelName)_@(Convert.ToInt32(ViewData["Id"]))"></div>

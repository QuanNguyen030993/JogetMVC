@page

<link rel="stylesheet" href="~/lib/tmivcom/style.css" asp-append-version="true" />

<style>
    /* Keep the TAT page shell isolated from Dashboard.cshtml. Component styles
       come from the dedicated tatChart.css build output above. */
    #tatReport {
        box-sizing: border-box;
        width: 100%;
        height: calc(100vh - 72px);
        height: calc(100dvh - 72px);
        overflow-x: hidden;
        overflow-y: auto;
        overscroll-behavior: contain;
        scrollbar-gutter: stable;
        color: var(--c-172033, #172033);
        background: var(--c-f3f6fb, #f3f6fb);
        font-family: Inter, "Segoe UI", Arial, sans-serif;
    }

    #tatReport .tat-report-page {
        box-sizing: border-box;
        min-height: 100%;
        padding: 0;
        background:
            radial-gradient(circle at 8% 0%, var(--c-rgba-74-112-255-13, rgba(74, 112, 255, .13)), transparent 25rem),
            radial-gradient(circle at 92% 8%, var(--c-rgba-36-193-153-09, rgba(36, 193, 153, .09)), transparent 24rem),
            var(--c-f3f6fb, #f3f6fb);
    }

    #tatReport .tat-report-shell {
        width: min(1500px, 100%);
        margin: 0 auto;
    }

    #tatReport .tat-report-card {
        padding: 12px;
        border: 1px solid var(--c-rgba-221-226-235-82, rgba(221, 226, 235, .82));
        border-radius: 16px;
        background: var(--c-rgba-255-255-255-92, rgba(255, 255, 255, .92));
        box-shadow: 0 10px 32px var(--c-rgba-28-45-78-08, rgba(28, 45, 78, .08));
    }

    #tatReport .tat-report-title {
        margin: 0 0 8px;
        font-size: 13px;
        font-weight: 750;
        letter-spacing: -.02em;
    }

    #tatReportChart {
        width: 100%;
        min-width: 0;
        min-height: 520px;
    }
</style>

<div id="tatReport" class="dExForm">
    <main class="tat-report-page">
        <div class="tat-report-shell">
            <section class="tat-report-card" aria-label="Báo cáo TAT Instance">
                <h1 class="tat-report-title">TAT Instance Report</h1>
                <div id="tatReportChart"></div>
            </section>
        </div>
    </main>
</div>

<script>
    (function () {
        $(function () {
            const $tatReportChart = $("#tatReportChart");

            if (typeof $tatReportChart.tatchart !== "function") {
                $tatReportChart.html(
                    '<div class="alert alert-warning mb-0">Không thể tải control tatchart từ bizform.js.</div>'
                );
                return;
            }

            $tatReportChart.tatchart({});
        });
    })();
</script>

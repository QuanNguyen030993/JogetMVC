@page
@model EmployeeWorkloadModel
@{

}
<script>
    _role = "TS";
    var dataSource = new Object();
     function loadQuotationStacked() {
         const payload = JSON.stringify({
           mode: "quotation_by_stageaccount_status"
         });
         
         return  $.ajax({
               url: `/api/EmployeeWorkload/ExecuteCustomQuery`,
               method: "POST",
               async: false,
               contentType: "application/json",
               data: JSON.stringify(_role),
               // data: JSON.stringify("TS"),
               success: function(data) {
                    dataSource = data;
               }
           });
     }

    
       

           // dataSource lấy từ API/DB sẽ là dạng:
    // [{ stageAccount:'yen.tth', New:4, InProgress:2, Done:1 }, ...]

    $("#stackedEW").dxChart({
      dataSource,

      commonSeriesSettings: {
          argumentField: "stageAccount",
          type: "stackedBar"
        },
      series: [
        { valueField: "new",        name: "New",        color: "#9e9e9e" }, // xám (đỉnh)
        { valueField: "inProgress", name: "In Progress", color: "#fbc02d" }, // vàng
        { valueField: "done",       name: "Done",       color: "#43a047" }  // xanh lá
      ],

      legend: {
        verticalAlignment: "top",
        horizontalAlignment: "center",
        itemTextPosition: "right"
      },

      valueAxis: {
        title: { text: "Quotation count" },
        tickInterval: 5
      },

      title: {
        text: `Quotation by Member ${_role}`,
        subtitle: { text: "Stacked by status" }
      },
      onPointClick(e) {
          // console.log("CLICK point:", e.target?.data);
        },
        onPointHoverChanged(e) {
          // if (e.target?.isHovered()) console.log("HOVER point:", e.target?.data);
        },
      tooltip: {
        enabled: true,
        location: 'edge',
        customizeTooltip(arg) {
            const account = arg.argument;
            const status  = arg.seriesName;
            const value   = arg.value ?? 0;
            const total   = arg.total ?? null;
            const pct = (total && total > 0) ? ((value / total) * 100) : null;
            const pctText = (pct === null) ? "" : ` (${pct.toFixed(1)}%)`;

            return {
              html: `
                <div style="min-width:180px">
                  <div><b>${account}</b></div>
                  <div>${status}: <b>${value}</b>${pctText}</div>
                  ${total !== null ? `<div>Total: <b>${total}</b></div>` : ""}
                </div>
              `
            };
        }
      }
    });
     loadQuotationStacked().then(res => {
       $("#stackedEW").dxChart("instance").option("dataSource", res);
       $("#stackedEW").dxChart("instance").render();
     });
</script>

<div id="stackedEW"></div>

        $("#quoteKpiByYear").dxChart({
      argumentAxis: { argumentType: "numeric", tickInterval: 1, title: "Year" },

      valueAxis: [
        { name: "premiumAxis", title: { text: "Total Premium" } },
        { name: "tsiAxis", position: "right", title: { text: "Total Sum Insured" } }//,
        // { name: "dueAxis", position: "right", offset: 60, title: { text: "Total Due" } } // offset để không đè nhau
      ],

      commonSeriesSettings: {
        argumentField: "year"
      },

      series: [
        { valueField: "sumInsuredTotal", name: "Total Sum Insured", axis: "tsiAxis", type: "bar" },
        { valueField: "premiumTotal", name: "Total Premium", axis: "premiumAxis", type: "line" }//,
        // { valueField: "totalDue", name: "Total Due", axis: "dueAxis", type: "spline" }
      ],

      legend: { verticalAlignment: "top", horizontalAlignment: "center" },

      tooltip: {
        enabled: true,
        customizeTooltip(arg) {
          const v = Number(arg.value);
          return {
            text: `${arg.seriesName}: ${Intl.NumberFormat("vi-VN", {
              style: "currency",
              currency: "VND",
              maximumFractionDigits: 0
            }).format(v)}`
          };
        }
      }
    });


    var query = "EXEC [usp_Revenue_GetData]";
    $.ajax({
      url: "/api/Report/ExecuteCustomQuery",
      method: "POST",
      contentType: "application/json",
      data: JSON.stringify(query)
    }).then(res => {
          const cleanData = res
    .filter(x => Number.isInteger(x.year))
    .sort((a, b) => a.year - b.year);
      $("#quoteKpiByYear").dxChart("instance").option("dataSource", cleanData);
      $("#quoteKpiByYearGrid").dxDataGrid("instance").option("dataSource", cleanData);
      var containerWidth = $("#quoteKpiByYear").parent().width();
      $("#quoteKpiByYear").dxChart("instance").option("size.width", containerWidth);
    });

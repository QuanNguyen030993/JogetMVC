        // 2) Init grid trước (chưa có data)
    $("#quoteKpiByYearGrid").dxDataGrid({
      dataSource: [],
      keyExpr: "year",
      showBorders: true,
      columnAutoWidth: true,
      rowAlternationEnabled: true,
      hoverStateEnabled: true,

      columns: [
        {
          dataField: "year",
          caption: "Year",
          dataType: "number",
          sortOrder: "asc",
          alignment: "center",
          width: 90
        },
        {
          dataField: "premiumTotal",
          caption: "Total Premium",
          dataType: "number",
          format: "#,##0",
          alignment: "right"
        },
        {
          dataField: "sumInsuredTotal",
          caption: "Total Sum Insured",
          dataType: "number",
          format: "#,##0",
          alignment: "right"
        },
        {
          dataField: "totalDue",
          caption: "Total Due",
          dataType: "number",
          format: "#,##0",
          alignment: "right"
        }
      ],

      summary: {
        totalItems: [
          { column: "year", summaryType: "count", displayFormat: "Rows: {0}" },
          { column: "premiumTotal", summaryType: "sum", valueFormat: "#,##0", displayFormat: "Sum: {0}" },
          { column: "sumInsuredTotal", summaryType: "sum", valueFormat: "#,##0", displayFormat: "Sum: {0}" },
          { column: "totalDue", summaryType: "sum", valueFormat: "#,##0", displayFormat: "Sum: {0}" }
        ]
      },

      paging: { enabled: false }, // dữ liệu theo năm ít -> khỏi phân trang
      filterRow: { visible: false },
      searchPanel: { visible: false }
    });
</script>

<div id="quoteKpiByYear" class="chart-wrapper"> </div>
<div id="quoteKpiByYearGrid"></div>
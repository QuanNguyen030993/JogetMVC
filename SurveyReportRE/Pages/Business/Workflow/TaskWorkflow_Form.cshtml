@page "{pageNum:int?}"
@model TaskWorkflow_FormModel
@{


}
<script>
    $(function () {
        var _id = @Convert.ToInt32(ViewData["Id"]);

        var _formConfig = new MFormOption();
        _formConfig.cloneUrl = '/Business/MasterData/TaskWorkflow_Form/' + _id;
        _formConfig.tabCode = `form_TaskWorkflow_Form_${_id}`;
        _formConfig.tabName = '@HttpContext.Request.Query["Caption"].ToString()';
        _formConfig.originModelName = "@TaskWorkflow_FormModel.ModelName";
        _formConfig.formElementName = "@TaskWorkflow_FormModel.ModelName";
        _formConfig.schemeBasedOn = `@(TaskWorkflow_FormModel.SchemeModelName)`;
        _formConfig.allowFormActionButton = true;
        _formConfig.colCount = 4;
        _formConfig.isCustomQuery = true;
        new TaskWorkflowForm(_id, null, _formConfig);
    });
</script>
<div id="form_@(TaskWorkflow_FormModel.ModelName)_@Convert.ToInt32(ViewData["Id"])" class="dExForm"></div>

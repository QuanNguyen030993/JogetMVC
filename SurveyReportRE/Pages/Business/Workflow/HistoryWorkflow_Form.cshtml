@page "{pageNum:int?}"
@model HistoryWorkflow_FormModel
@{


}
<script>
    $(function () {
        var _id = @Convert.ToInt32(ViewData["Id"]);

        var _formConfig = new MFormOption();
        _formConfig.cloneUrl = '/Business/MasterData/HistoryWorkflow_Form/' + _id;
        _formConfig.tabCode = `form_HistoryWorkflow_Form_${_id}`;
        _formConfig.tabName = '@HttpContext.Request.Query["Caption"].ToString()';
        _formConfig.originModelName = "@HistoryWorkflow_FormModel.ModelName";
        _formConfig.formElementName = "@HistoryWorkflow_FormModel.ModelName";
        _formConfig.schemeBasedOn = `@(HistoryWorkflow_FormModel.SchemeModelName)`;
        _formConfig.allowFormActionButton = true;
        _formConfig.colCount = 4;
        _formConfig.isCustomQuery = true;
        new HistoryWorkflowForm(_id, null, _formConfig);
    });
</script>
<div id="form_@(HistoryWorkflow_FormModel.ModelName)_@Convert.ToInt32(ViewData["Id"])" class="dExForm"></div>
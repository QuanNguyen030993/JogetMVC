 @page "{pageNum:int?}"
@model WorkflowDefinitionDraw_FormModel
@{


}


<style>

    * {
        box-sizing: border-box
    }

</style>

<body>
    <div class="draw-container dExForm">
        <aside class="sidebar">
            <div class="title">Design Workflow</div>
            <div class="palette">
                <div class="paletteItem" draggable="true" data-template='{"nodeName":"FO","flowType":"Both","allowLoop":false,"loopGroup":"","nodeType":"","nodeCode":"","stepRole":"","departmentName":"","levelNo":1}'>
                    <div class="paletteTitle">FO</div>
                    <div class="paletteMeta">
                        <span class="tag">Both</span>
                    </div>
                </div>

                <div class="paletteItem" draggable="true" data-template='{"nodeName":"TS","flowType":"Quotation","allowLoop":false,"loopGroup":"","nodeType":"","nodeCode":"","stepRole":"","departmentName":"","levelNo":1}'>
                    <div class="paletteTitle">TS</div>
                    <div class="paletteMeta">
                        <span class="tag">Quotation</span>
                    </div>
                </div>

                <div class="paletteItem" draggable="true" data-template='{"nodeName":"UW","flowType":"Both","allowLoop":false,"loopGroup":"","nodeType":"","nodeCode":"","stepRole":"","departmentName":"","levelNo":1}'>
                    <div class="paletteTitle">UW</div>
                    <div class="paletteMeta">
                        <span class="tag">Both</span>
                    </div>
                </div>

                <div class="paletteItem" draggable="true" data-template='{"nodeName":"Client","flowType":"Both","allowLoop":true,"loopGroup":"CLIENT_REVIEW","nodeType":"","nodeCode":"","stepRole":"","departmentName":"","levelNo":1}'>
                    <div class="paletteTitle">Client</div>
                    <div class="paletteMeta">
                        <span class="tag">Both</span>
                        <span class="tag loop">Loop</span>
                    </div>
                </div>

                <div class="paletteItem" draggable="true" data-template='{"nodeName":"PM","flowType":"Both","allowLoop":false,"loopGroup":"","nodeType":"","nodeCode":"","stepRole":"","departmentName":"","levelNo":1}'>
                    <div class="paletteTitle">PM</div>
                    <div class="paletteMeta">
                        <span class="tag">Both</span>
                    </div>
                </div>
            </div>


            <div class="card-in-frame">
                <div class="header-in-frame">Legend</div>
                <div class="legend-row"><span class="dot quotation"></span> Quotation</div>
                <div class="legend-row"><span class="dot policy"></span> Policy Issuance</div>
                <div class="legend-row"><span class="dot both"></span> Both</div>
                <div class="legend-row"><span class="dot active"></span> Current node</div>
                <div class="legend-row"><span class="dot done"></span> Done</div>
                <div class="legend-row"><span class="dot pending"></span> Pending</div>
                <div class="legend-row"><span class="line"></span> Normal transition</div>
                <div class="legend-row"><span class="line return"></span> Return transition</div>
                <div class="legend-row"><span class="line loop"></span> Loop transition</div>
            </div>

            <div class="card-in-frame">
                <div class="header-in-frame">Workflow JSON</div>
                <textarea id="jsonInput_@Convert.ToInt32(ViewData["Id"])"></textarea>
                <div class="btn-row">
                    <button id="btnRender_@Convert.ToInt32(ViewData["Id"])">Draw on diagram</button>
                    <button class="secondary" id="btnUpdate_@Convert.ToInt32(ViewData["Id"])">Save Data</button>
                    @* <button class="warning" id="btnAutoLayout_@Convert.ToInt32(ViewData["Id"])">Force Auto Layout</button> *@
                    <button class="success" id="btnExport_@Convert.ToInt32(ViewData["Id"])">Export JSON</button>
                    
                </div>
                <div id="errorBox_@Convert.ToInt32(ViewData["Id"])" class="error"></div>
            </div>


        </aside>

        <main class="main">
            <div class="toolbar">
                <div class="toolbar-left">
                    <span class="badge">Workflow coordinate</span>
                </div>
                <div class="toolbar-right">
                </div>
            </div>

            <div class="canvas-wrap">
                <div id="canvas_@(ViewData["Id"])" class="canvas"></div>
            </div>
              <div class="mermaid-wrap">
                    <div class="mermaid-header">Live Mermaid Diagram</div>
                    <div id="mermaid_output_@Convert.ToInt32(ViewData["Id"])" class="mermaid">
                        graph TD
                        Start --> End
                    </div>
                </div>
        </main>
    </div>

    <script>
         var _id = @Convert.ToInt32(ViewData["Id"]);

        ajaxGet(`/api/WorkflowDefinition/GetSingle/${_id}`)
            .then(data => {
        var jsonInput = document.getElementById("jsonInput_@Convert.ToInt32(ViewData["Id"])");
        var canvas = document.getElementById("canvas_@(ViewData["Id"])");
                $(canvas).empty();
        var errorBox = document.getElementById("errorBox_@Convert.ToInt32(ViewData["Id"])");;

        var saveHint = document.getElementById("saveHint_@Convert.ToInt32(ViewData["Id"])");

        var instance = null;
        var currentJson = null;

        function parseWorkflowNodes(value) {
          if (value == null) return null;
          if (typeof value === "string") {
            try {
              return JSON.parse(value);
            } catch (err) {
              try {
                return JSON.parse(value.replace(/\r?\n/g, "\\n"));
              } catch (err2) {
                console.warn("Failed to parse workflowNodes", err, err2);
                return null;
              }
            }
          }
          return value;
        }

        var workflowNodesJson = parseWorkflowNodes(data.workflowNodes);
        if (workflowNodesJson) {
          jsonInput.value = JSON.stringify(workflowNodesJson, null, 2);
        } else {
          errorBox.style.display = "block";
          errorBox.textContent = "Unable to parse workflowNodes from server response.";
          jsonInput.value = "{}";
        }

        function snap(n, grid = 24) {
          return Math.round(n / grid) * grid;
        }


        function getNodeFlowClass(flowType) {
          if (flowType === "Quotation") return "flow-quotation";
          if (flowType === "PolicyIssuance") return "flow-policy";
          return "flow-both";
        }

        function getNodeStateClass(nodeId, runtimeState) {
          var active = runtimeState?.activeNodeId;
          var done = runtimeState?.compvaredNodeIds || [];
          var pending = runtimeState?.pendingNodeIds || [];
          if (nodeId === active) return "active";
          if (done.includes(nodeId)) return "done";
          if (pending.includes(nodeId)) return "pending";
          return "pending";
        }

        function getNodesWithSavedPosition(nodes) {
          return (nodes || []).filter(n => hasNumber(n.x) && hasNumber(n.y));
        }

        function syncJsonToTextarea() {
          if (!currentJson) return;
          jsonInput.value = JSON.stringify(currentJson, null, 2);
        }

        function updateNodeCoordinateUi(nodeId, x, y) {
          var xEl = document.querySelector(`[data-x="${nodeId}"]`);
          var yEl = document.querySelector(`[data-y="${nodeId}"]`);
          if (xEl) xEl.textContent = x;
          if (yEl) yEl.textContent = y;
        }

        function updateNodePosition(nodeId, x, y) {
            debugger
          if (!currentJson || !currentJson.workflowNodes) return;
          var node = currentJson.workflowNodes.find(n => n.id === nodeId);
          if (!node) return;

          node.x = x;
          node.y = y;

          updateNodeCoordinateUi(nodeId, x, y);
          syncJsonToTextarea();
        }
      

        function buildSavedLayout(json) {
          var nodes = json.workflowNodes || [];
          var positions = {};
          var maxX = 0;
          var maxY = 0;

          nodes.forEach(n => {
            var x = snap(Number(n.x || 0));
            var y = snap(Number(n.y || 0));
            positions[n.id] = { x, y, layer: null };
            maxX = Math.max(maxX, x);
            maxY = Math.max(maxY, y);
          });

          return {
            positions,
            grouped: {},
            canvasWidth: Math.max(window.innerWidth - (window.innerWidth * 0.1), maxX + 420),
            canvasHeight: Math.max(window.innerHeight - (window.innerHeight * -0.1), maxY + 260)
          };
        }

        function createNodeEl(node, pos, runtimeState) {
          var el = document.createElement("div");
          el.id = node.id;
          el.className = "node " + getNodeFlowClass(node.flowType) + " " + getNodeStateClass(node.id, runtimeState);
          el.style.left = pos.x + "px";
          el.style.top = pos.y + "px";
          el.innerHTML = `
            <div class="node-title">${safe(node.nodeName || node.id)}</div>
            <div class="node-meta">
              <div>Order: ${safe(node.orderNo)}</div>
              <div>Level: ${safe(node.levelNo)}</div>
              <div>Flow: ${safe(node.flowType || "Both")}</div>
              <div>X: <span data-x="${node.id}">${safe(node.x)}</span> | Y: <span data-y="${node.id}">${safe(node.y)}</span></div>
            </div>
          `;
          return el;
        }

        function createLayerLabel(layer, x) {
          var el = document.createElement("div");
          el.className = "layer-label";
          el.style.left = x + "px";
          el.textContent = "Layer " + layer;
          return el;
        }

        function colorForEdge(t) {
          if (t.isReturn) return "var(--return)";
          if (t.isLoop) return "var(--loop)";
          if (t.flowType === "Quotation") return "var(--quotation)";
          if (t.flowType === "PolicyIssuance") return "var(--policy)";
          return "var(--both)";
        }

        function chooseAnchors(t) {
          if (t.isReturn) return ["Top", "Top"];
          return ["Right", "Left"];
        }

        function connectEdge(t) {
          var color = colorForEdge(t);
          var label = safe(t.actionName || t.userDecisionLabel || t.actionCode || "");
          var statusName = _enums.OverallStatus.find(f => f.id == t.statusId);
                                  label = `${label} - <div class="statusTag ${normalizeStatus(statusName?.value || "").css}">${statusName?.value || ""}</div>`;
          var isSelfLoop = t.fromNodeId === t.toNodeId;

          var overlays = [
            ["Arrow", { location: 1, width: 10, length: 10 }]
          ];

          if (label) {
            overlays.unshift(["Label", {
              label,
              location: 0.5,
              cssClass: "edge-label"
            }]);
          }

          if (isSelfLoop) {
            instance.connect({
              source: t.fromNodeId,
              target: t.toNodeId,
              anchors: ["Top", "Right"],
              connector: ["StateMachine", { margin: 12, curviness: 45, loopbackRadius: 32 }],
              endpoint: "Blank",
              paintStyle: {
                stroke: color,
                strokeWidth: 3,
                dashstyle: t.isReturn ? "4 4" : ""
              },
              overlays
            });
            return;
          }

          instance.connect({
            source: t.fromNodeId,
            target: t.toNodeId,
            anchors: chooseAnchors(t),
            connector: ["Bezier", { curviness: t.isReturn ? 95 : 60 }],
            endpoint: "Blank",
            paintStyle: {
              stroke: color,
              strokeWidth: (t.isReturn || t.isLoop) ? 3 : 2.5,
              dashstyle: t.isReturn ? "4 4" : ""
            },
            overlays
          });
        }

        function attachDrag() {
          (currentJson.workflowNodes || []).forEach(node => {
            instance.draggable(node.id, {
              grid: [24, 24],
              containment: true,
              stop: function() {
                var el = document.getElementById(node.id);
                if (!el) return;

                var left = snap(parseInt(el.style.left || "0", 10));
                var top = snap(parseInt(el.style.top || "0", 10));
                         var pos = instance.getOffset(node.id);
                                    console.log(pos);
                el.style.left = left + "px";
                el.style.top = top + "px";
                updateNodePosition(node.id, left, top);
                instance.revalidate(node.id);

                saveHint.innerHTML = `Position: <span class="status-ok">updated ${node.id} (${left}, ${top})</span>`;
              }
            });
          });
        }


        function renderWorkflow(options = {}) {
          try {
            errorBox.style.display = "none";
            errorBox.textContent = "";

            currentJson = JSON.parse(jsonInput.value);

            if (instance) {
              instance.deleteEveryConnection();
              instance.reset();
            }

            canvas.innerHTML = "";
            var useSavedLayout =
              getNodesWithSavedPosition(currentJson.workflowNodes).length > 0;

            var layout = useSavedLayout
              ? buildSavedLayout(currentJson)
              : {};

            var { positions, grouped, canvasWidth, canvasHeight } = layout;

            canvas.style.width = canvasWidth + "px";
            canvas.style.height = canvasHeight + "px";

            if (!useSavedLayout) {
              Object.keys(grouped).map(Number).sort((a, b) => a - b).forEach(layer => {
                var arr = grouped[layer];
                if (arr.length) {
                  canvas.appendChild(createLayerLabel(layer, positions[arr[0].id].x));
                }
              });
            }

            (currentJson.workflowNodes || []).forEach(node => {
              var pos = positions[node.id];
              if (!pos) return;

              if (!useSavedLayout || !hasNumber(node.x) || !hasNumber(node.y)) {
               
                node.x = pos.x;
                node.y = pos.y;
              }

              canvas.appendChild(createNodeEl(node, pos, currentJson.runtimeState || {}));
            });

            instance = jsPlumb.getInstance({
              Container: canvas
            });

            instance.importDefaults({
              ConnectionsDetachable: false,
              ReattachConnections: false,
              Endpoint: "Blank",
              PaintStyle: { stroke: "#64748b", strokeWidth: 2 },
              HoverPaintStyle: { stroke: "#334155", strokeWidth: 3 }
            });

            (currentJson.workflowTransitions || []).forEach(connectEdge);
            attachDrag();

          

            syncJsonToTextarea();
          } catch (err) {
            errorBox.style.display = "block";
            errorBox.textContent = err && err.stack ? err.stack : String(err);
          }
        }

        function exportJson() {
          try {
            syncJsonToTextarea();
            navigator.clipboard?.writeText(jsonInput.value).catch(() => {});
            saveHint.innerHTML = `Position: <span class="status-ok">JSON exported</span>`;
          } catch (err) {
            errorBox.style.display = "block";
            errorBox.textContent = err && err.stack ? err.stack : String(err);
          }
        }


        function updateData(){
              ajaxPut('/api/WorkflowDefinition/UpdateData',
             {
                 key: _id,
                 values: JSON.stringify(
                     { workflowNodes : jsonInput.value }
                 )
             },
             {
                 onSuccess: function (response) {
                      appNotifySuccess("Updated!", false);
                 },
                 onError: function (err) { }
             }
             );
        }

        document.getElementById("btnRender_@Convert.ToInt32(ViewData["Id"])").addEventListener("click", () => renderWorkflow());
        document.getElementById("btnUpdate_@Convert.ToInt32(ViewData["Id"])").addEventListener("click", updateData);
        document.getElementById("btnExport_@Convert.ToInt32(ViewData["Id"])").addEventListener("click", exportJson);
     
 

        renderWorkflow();
       

        function ensureSeed() {
            if (!jsonInput.value.trim()) {
                jsonInput.value = JSON.stringify(sampleData, null, 2);
            }
        }

        function getData() {
            return JSON.parse(jsonInput.value || "{}");
        }

        function setData(data) {
            jsonInput.value = JSON.stringify(data, null, 2);
        }

     

        
        function clearNodeSelection() {
            document.querySelectorAll(".node.selected").forEach(x => x.classList.remove("selected"));
        }

        function clearSelections() {
            clearNodeSelection();
            selectedNodeId = null;
            selectedTransitionKey = null;
        }





        function generateUniqueNodeId(data, baseName) {
            const rawBase = (baseName || "NODE").toUpperCase().replace(/[^A-Z0-9]+/g, "_");
            let candidate = rawBase;
            const existing = new Set((data.workflowNodes || []).map(x => x.id));

            if (!existing.has(candidate)) return candidate;

            candidate = rawBase + "_" + Date.now();
            while (existing.has(candidate)) {
                candidate = rawBase + "_" + Date.now() + "_" + Math.floor(Math.random() * 1000);
            }
            return candidate;
        }

        function addNodeFromPalette(template, x, y) {
            const data = getData();

            const id = generateUniqueNodeId(data, template.nodeName);
            const nextOrder = ((data.workflowNodes || []).reduce((m, n) => Math.max(m, n.orderNo || 0), 0)) + 1;

           var node = workflowNodesHandle(template);
           node.id = id;
           node.orderNo = nextOrder;
        
           node.x = x;
           node.y = y;

            data.workflowNodes.push(node);

            if (!data.runtimeState) {
                data.runtimeState = {
                    activeNodeId: "",
                    completedNodeIds: [],
                    pendingNodeIds: []
                };
            }

            if (!Array.isArray(data.runtimeState.pendingNodeIds)) {
                data.runtimeState.pendingNodeIds = [];
            }

            if (!data.runtimeState.pendingNodeIds.includes(node.id)) {
                data.runtimeState.pendingNodeIds.push(node.id);
            }

            setData(data);
            // renderWorkflow();
            renderWorkflow();
            setStatus("Added node: " + node.id);
        }

        
       

        document.querySelectorAll(".paletteItem").forEach(item => {
            item.addEventListener("dragstart", function (e) {
                e.dataTransfer.setData("text/plain", item.getAttribute("data-template"));
            });
        });

        canvas.addEventListener("dragover", function (e) {
            e.preventDefault();
            canvas.classList.add("dragOver");
        });

        canvas.addEventListener("dragleave", function () {
            canvas.classList.remove("dragOver");
        });

        canvas.addEventListener("drop", function (e) {
            e.preventDefault();
            canvas.classList.remove("dragOver");

            const raw = e.dataTransfer.getData("text/plain");
            if (!raw) return;

            let template = null;
            try {
                template = JSON.parse(raw);
            } catch {
                setStatus("Invalid palette template.");
                return;
            }

            const rect = canvas.getBoundingClientRect();
            const x = Math.max(20, Math.round((e.clientX - rect.left - 100) / 12) * 12);
            const y = Math.max(20, Math.round((e.clientY - rect.top - 35) / 12) * 12);

            addNodeFromPalette(template, x, y);
        });

        canvas.addEventListener("click", function () {
            clearSelections();
            // infoBox.textContent = "Click node hoặc line để xem chi tiết.";
        });

        ensureSeed();
        renderWorkflow();

        // 1. Kiểm tra an toàn xem thư viện mermaid đã sẵn sàng chưa
        var mermaidLib = window.mermaid || (typeof mermaid !== 'undefined' ? mermaid : null);
        if (!mermaidLib) {
            console.error("Thư viện Mermaid chưa được nạp vào trang. Hãy chắc chắn đã chèn thẻ script của Mermaid CDN.");
            return;
        }

        // 2. Khởi tạo cấu hình (chỉ cần gọi 1 lần, tốt nhất nên an toàn bằng block try-catch)
        try {
            mermaidLib.initialize({ startOnLoad: false, theme: 'default' });
        } catch(e) {
            console.warn("Mermaid initialize warning:", e);
        }

        // // 3. Hàm convert nội bộ: Chuyển đổi trực tiếp object data nhận từ API thành mã Mermaid dạng String
        function convertJsonToMermaidSyntax(wfData) {
            let code = "graph TD\n";
            
            // Định nghĩa bảng màu sắc map theo styleColor
            code += "    classDef orange fill:#ffe0b2,stroke:#fb8c00,stroke-width:2px;\n";
            code += "    classDef lightOrange fill:#fff3e0,stroke:#ffb74d,stroke-width:1px;\n";
            code += "    classDef blue fill:#e3f2fd,stroke:#2196f3,stroke-width:2px;\n";
            code += "    classDef green fill:#e8f5e9,stroke:#4caf50,stroke-width:2px;\n";
            code += "    classDef red fill:#ffebee,stroke:#f44336,stroke-width:2px;\n\n";

            // Tạo Phân làn (subgraph) và gộp các Node vào làn tương ứng
            if (wfData.lanes && wfData.workflowNodes) {
                wfData.lanes.forEach(lane => {
                    code += `    subgraph ${lane.id} [${lane.label}]\n`;
                    
                    var laneNodes = wfData.workflowNodes.filter(n => n.laneId === lane.id);
                    laneNodes.forEach(node => {
                        let label = node.nodeName;
                        if (node.assignLabel) label += `<br><small><i>${node.assignLabel}</i></small>`;
                        if (node.orderLabel) label += `<br><small><b>${node.orderLabel}</b></small>`;
                        
                        // Xác định hình dáng
                        let openSign = "[", closeSign = "]";
                        if (node.nodeType === 'decision' || node.shape === 'diamond') {
                            openSign = "{"; closeSign = "}";
                        } else if (['start', 'end', 'complete'].includes(node.nodeType) || node.shape === 'circle') {
                            openSign = "(("; closeSign = "))";
                        }
                        
                        var colorClass = node.styleColor ? `:::${node.styleColor}` : '';
                        code += `        ${node.id}${openSign}${label}${closeSign}${colorClass}\n`;
                    });
                    code += "    end\n\n";
                });
            }

            // Tạo các Đường kết nối (Transitions)
            if (wfData.workflowTransitions) {
                wfData.workflowTransitions.forEach(trans => {
                    var isSpecial = trans.isReturn || trans.isReferral || trans.lineType === 'dashed';
                    let label = trans.actionName || trans.conditionLabel || "";
                    if (trans.conditionJson && trans.conditionJson.message) {
                        label += ` (${trans.conditionJson.message})`;
                    }

                    if (label) {
                        code += isSpecial 
                            ? `    ${trans.fromNodeId} -. ${label} .-> ${trans.toNodeId}\n`
                            : `    ${trans.fromNodeId} -->|${label}| ${trans.toNodeId}\n`;
                    } else {
                        code += isSpecial 
                            ? `    ${trans.fromNodeId} -.-> ${trans.toNodeId}\n`
                            : `    ${trans.fromNodeId} --> ${trans.toNodeId}\n`;
                    }
                });
            }
            return code;
        }
        function convertWorkflowToMermaidV1(jsonStr) {
  const data = typeof jsonStr === 'string' ? JSON.parse(jsonStr) : jsonStr;
  let mermaid = "graph TD\n";

  // 1. Định nghĩa màu sắc hệ thống dựa trên flowType hoặc nodeName
  mermaid += "    classDef orange fill:#ffe0b2,stroke:#fb8c00,stroke-width:2px;\n";
  mermaid += "    classDef lightOrange fill:#fff3e0,stroke:#ffb74d,stroke-width:1px;\n";
  mermaid += "    classDef blue fill:#e3f2fd,stroke:#2196f3,stroke-width:2px;\n";
  mermaid += "    classDef green fill:#e8f5e9,stroke:#4caf50,stroke-width:2px;\n";
  mermaid += "    classDef red fill:#ffebee,stroke:#f44336,stroke-width:2px;\n\n";

  // Hàm tạo hình dáng Node (Tất cả label bọc nháy kép để an toàn tuyệt đối)
  function getNodeShape(node) {
    let label = node.nodeName;
    
    // Thêm thông tin loại Flow hỗ trợ nếu có để biểu đồ chi tiết hơn
    if (node.flowType) {
      label += `<br><small><i>(${node.flowType})</i></small>`;
    }

    // Nếu cấu trúc mới chưa chỉ định rõ hình dáng shape, mặc định quy định theo loại node
    if (node.nodeType === 'decision') {
      return `{"${label}"}`;
    } else if (['start', 'end', 'complete'].includes(node.nodeType)) {
      return `(("${label}"))`;
    } else {
      return `["${label}"]`;
    }
  }

  // 2. TỰ ĐỘNG PHÂN LÀN (Gom nhóm các Node có cùng nodeName vào subgraph)
  if (data.workflowNodes && data.workflowNodes.length > 0) {
    // Trích xuất danh sách các phòng ban duy nhất xuất hiện trong danh sách nodes
    const uniqueDepartments = [...new Set(data.workflowNodes.map(node => node.nodeName))];

    uniqueDepartments.forEach(dept => {
      // Khởi tạo một làn (subgraph) đại diện cho phòng ban này
      mermaid += `    subgraph LANE_${dept} [${dept}]\n`;
      
      // Lấy toàn bộ danh sách node thuộc phòng ban đang duyệt
      const deptNodes = data.workflowNodes.filter(node => node.nodeName === dept);
      deptNodes.forEach(node => {
        const shapeStr = getNodeShape(node);
        
        // Thiết lập màu sắc trực quan dựa theo phòng ban
        let colorClass = ':::blue'; // Màu mặc định
        if (dept === 'Client') colorClass = ':::orange';
        if (dept === 'UW') colorClass = ':::lightOrange';
        
        mermaid += `        ${node.id}${shapeStr}${colorClass}\n`;
      });
      
      mermaid += "    end\n\n";
    });
  }

  mermaid += "    %% ==========================================\n";
  mermaid += "    %% CÁC ĐƯỜNG NỐI (TRANSITIONS)\n";
  mermaid += "    %% ==========================================\n";

  // 3. Tạo các đường liên kết (Transitions)
  if (data.workflowTransitions) {
    data.workflowTransitions.forEach(trans => {
      // Xác định kiểu mũi tên (Nét liền cho thông thường, nét đứt cho đường quay lại - isReturn)
      const isSpecialLink = trans.isReturn || trans.isLoop || trans.lineType === 'dashed';
      const arrow = isSpecialLink ? "-.->" : "-->";
      
      // Khởi tạo nhãn cho mũi tên
      let label = trans.actionName || "";
      
      // Xử lý conditionJson (Dữ liệu mới trả về chuỗi String chứa JSON nên cần parse an toàn)
      if (trans.conditionJson && typeof trans.conditionJson === 'string') {
        try {
          const condObj = JSON.parse(trans.conditionJson);
          if (condObj && condObj.message) {
            label += label ? ` <br> (${condObj.message})` : `(${condObj.message})`;
          }
        } catch (e) {
          // Bỏ qua nếu chuỗi conditionJson rỗng hoặc lỗi cấu trúc format chuỗi thuần
        }
      }

      // Khớp nối cú pháp chuỗi Mermaid
      if (label) {
        if (isSpecialLink) {
          mermaid += `    ${trans.fromNodeId} -. "${label}" .-> ${trans.toNodeId}\n`;
        } else {
          mermaid += `    ${trans.fromNodeId} -->|"${label}"| ${trans.toNodeId}\n`;
        }
      } else {
        mermaid += `    ${trans.fromNodeId} ${arrow} ${trans.toNodeId}\n`;
      }
    });
  }

  return mermaid;
}

       function convertWorkflowToMermaidV2(jsonStr) {
  const data = typeof jsonStr === 'string' ? JSON.parse(jsonStr) : jsonStr;
  let mermaid = "graph TD\n";

  // 1. Định nghĩa màu sắc (classDef) dựa trên styleColor trong JSON
  mermaid += "    classDef orange fill:#ffe0b2,stroke:#fb8c00,stroke-width:2px;\n";
  mermaid += "    classDef lightOrange fill:#fff3e0,stroke:#ffb74d,stroke-width:1px;\n";
  mermaid += "    classDef blue fill:#e3f2fd,stroke:#2196f3,stroke-width:2px;\n";
  mermaid += "    classDef green fill:#e8f5e9,stroke:#4caf50,stroke-width:2px;\n";
  mermaid += "    classDef red fill:#ffebee,stroke:#f44336,stroke-width:2px;\n\n";

  // Bản đồ map shape/nodeType sang ký hiệu Mermaid
  function getNodeShape(node) {
    const name = node.nodeName;
    let label = name;
    
    // Bổ sung label phụ nếu có
    if (node.assignLabel) label += `<br><small><i>${node.assignLabel}</i></small>`;
    if (node.orderLabel) label += `<br><small><b>${node.orderLabel}</b></small>`;

    // BỌC DẤU NHÁY KÉP "" QUANH LABEL ĐỂ TRÁNH LỖI KÝ TỰ ĐẶC BIỆT NHƯ ( )
    if (node.nodeType === 'decision' || node.shape === 'diamond') {
      return `{"${label}"}`;
    } else if (['start', 'end', 'complete'].includes(node.nodeType) || node.shape === 'circle') {
      return `(("${label}"))`;
    } else {
      return `["${label}"]`;
    }
  }

  // 2. Tạo các phân làn (Subgraphs) và gom nhóm Nodes vào đúng làn
  data.lanes.forEach(lane => {
    mermaid += `    subgraph ${lane.id} [${lane.label}]\n`;
    
    // Lọc các node thuộc lane này
    const laneNodes = data.workflowNodes.filter(node => node.laneId === lane.id);
    laneNodes.forEach(node => {
      const shapeStr = getNodeShape(node);
      const colorClass = node.styleColor ? `:::${node.styleColor}` : '';
      mermaid += `        ${node.id}${shapeStr}${colorClass}\n`;
    });
    
    mermaid += "    end\n\n";
  });

  // mermaid += "    %% ==========================================\n";
  // mermaid += "    %% CÁC ĐƯỜNG NỐI (TRANSITIONS)\n";
  // mermaid += "    %% ==========================================\n";

  // 3. Tạo các đường liên kết (Transitions)
  data.workflowTransitions.forEach(trans => {
    // Xác định kiểu mũi tên (Nét liền cho thông thường, nét đứt cho referral/return)
    const isSpecialLink = trans.isReturn || trans.isReferral || trans.lineType === 'dashed';
    const arrow = isSpecialLink ? "-.->" : "-->";
    
    // Lấy label của hành động/điều kiện nếu có
    let label = trans.actionName || trans.conditionLabel || "";
    if (trans.conditionJson && trans.conditionJson.message) {
      label += label ? ` <br> (${trans.conditionJson.message})` : `(${trans.conditionJson.message})`;
    }

    // Ghép thành dòng mã Mermaid
    if (label) {
      // BỌC DẤU NHÁY KÉP QUANH LABEL TRÊN ĐƯỜNG NỐI ĐỂ AN TOÀN TUYỆT ĐỐI
      if (isSpecialLink) {
        mermaid += `    ${trans.fromNodeId} -. "${label}" .-> ${trans.toNodeId}\n`;
      } else {
        mermaid += `    ${trans.fromNodeId} -->|"${label}"| ${trans.toNodeId}\n`;
      }
    } else {
      // Đường nối không có chữ
      mermaid += `    ${trans.fromNodeId} ${arrow} ${trans.toNodeId}\n`;
    }
  });

  return mermaid;
}

        // // 4. Tiến hành sinh mã cú pháp và render trực quan lên giao diện
        try {
            // var mermaidSyntax = convertJsonToMermaidSyntax(data.workflowNodes);
            if (data.versionNo == 1)
            var mermaidSyntax = convertWorkflowToMermaidV1(data.workflowNodes); 
             if (data.versionNo == 2)
            var mermaidSyntax = convertWorkflowToMermaidV2(data.workflowNodes); 
            var viewId = "@Convert.ToInt32(ViewData["Id"])"; // Định danh ID của view từ Razor
            var container = document.getElementById(`mermaid_output_${viewId}`);
            
            if (container) {
                // Xóa trạng thái đã xử lý trước đó của thẻ chứa để làm sạch bộ nhớ Mermaid
                container.removeAttribute('data-processed');
                
                // Kích hoạt render bất đồng bộ của thư viện Mermaid v10+
                var uniqueChartId = `mermaid_chart_svg_${viewId}_${Date.now()}`;
                mermaidLib.render(uniqueChartId, mermaidSyntax).then(render  => {
                // Trúng kết quả thành công, render lúc này là chuỗi SVG
                container.innerHTML = render.svg;
                })
                .catch((error) => {
                    // Xử lý nếu mã vẽ lỗi
                    console.error("Lỗi cú pháp Mermaid:", error);
                });
                // console.log(render);
                // // Gán mã SVG trực tiếp vào thẻ HTML để hiển thị sơ đồ bản vẽ
                // container.innerHTML = render;
            } else {
                console.error("Không tìm thấy thẻ div chứa mã Mermaid trên giao diện HTML.");
            }
        } catch (renderError) {
            console.error("Lỗi trong quá trình biên dịch cú pháp hoặc render Mermaid:", renderError);
        }


        });



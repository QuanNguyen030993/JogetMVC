        // // 3. Hàm convert nội bộ: Chuyển đổi trực tiếp object data nhận từ API thành mã Mermaid dạng String
        function convertJsonToMermaidSyntax(wfData) {
            let code = "graph TD\n";
            
            // Định nghĩa bảng màu sắc map theo styleColor
            code += "    classDef orange fill:#ffe0b2,stroke:#fb8c00,stroke-width:2px;\n";
            code += "    classDef lightOrange fill:#fff3e0,stroke:#ffb74d,stroke-width:1px;\n";
            code += "    classDef blue fill:#e3f2fd,stroke:#2196f3,stroke-width:2px;\n";
            code += "    classDef green fill:#e8f5e9,stroke:#4caf50,stroke-width:2px;\n";
            code += "    classDef red fill:#ffebee,stroke:#f44336,stroke-width:2px;\n\n";

            // Tạo Phân làn (subgraph) và gộp các Node vào làn tương ứng
            if (wfData.lanes && wfData.workflowNodes) {
                wfData.lanes.forEach(lane => {
                    code += `    subgraph ${lane.id} [${lane.label}]\n`;
                    
                    var laneNodes = wfData.workflowNodes.filter(n => n.laneId === lane.id);
                    laneNodes.forEach(node => {
                        let label = node.nodeName;
                        if (node.assignLabel) label += `<br><small><i>${node.assignLabel}</i></small>`;
                        if (node.orderLabel) label += `<br><small><b>${node.orderLabel}</b></small>`;
                        
                        // Xác định hình dáng
                        let openSign = "[", closeSign = "]";
                        if (node.nodeType === 'decision' || node.shape === 'diamond') {
                            openSign = "{"; closeSign = "}";
                        } else if (['start', 'end', 'complete'].includes(node.nodeType) || node.shape === 'circle') {
                            openSign = "(("; closeSign = "))";
                        }
                        
                        var colorClass = node.styleColor ? `:::${node.styleColor}` : '';
                        code += `        ${node.id}${openSign}${label}${closeSign}${colorClass}\n`;
                    });
                    code += "    end\n\n";
                });
            }

            // Tạo các Đường kết nối (Transitions)
            if (wfData.workflowTransitions) {
                wfData.workflowTransitions.forEach(trans => {
                    var isSpecial = trans.isReturn || trans.isReferral || trans.lineType === 'dashed';
                    let label = trans.actionName || trans.conditionLabel || "";
                    if (trans.conditionJson && trans.conditionJson.message) {
                        label += ` (${trans.conditionJson.message})`;
                    }

                    if (label) {
                        code += isSpecial 
                            ? `    ${trans.fromNodeId} -. ${label} .-> ${trans.toNodeId}\n`
                            : `    ${trans.fromNodeId} -->|${label}| ${trans.toNodeId}\n`;
                    } else {
                        code += isSpecial 
                            ? `    ${trans.fromNodeId} -.-> ${trans.toNodeId}\n`
                            : `    ${trans.fromNodeId} --> ${trans.toNodeId}\n`;
                    }
                });
            }
            return code;
        }
        function convertWorkflowToMermaidV1(jsonStr) {
  const data = typeof jsonStr === 'string' ? JSON.parse(jsonStr) : jsonStr;
  let mermaid = "graph TD\n";

  // 1. Định nghĩa màu sắc hệ thống dựa trên flowType hoặc nodeName
  mermaid += "    classDef orange fill:#ffe0b2,stroke:#fb8c00,stroke-width:2px;\n";
  mermaid += "    classDef lightOrange fill:#fff3e0,stroke:#ffb74d,stroke-width:1px;\n";
  mermaid += "    classDef blue fill:#e3f2fd,stroke:#2196f3,stroke-width:2px;\n";
  mermaid += "    classDef green fill:#e8f5e9,stroke:#4caf50,stroke-width:2px;\n";
  mermaid += "    classDef red fill:#ffebee,stroke:#f44336,stroke-width:2px;\n\n";

  // Hàm tạo hình dáng Node (Tất cả label bọc nháy kép để an toàn tuyệt đối)
  function getNodeShape(node) {
    let label = node.nodeName;
    
    // Thêm thông tin loại Flow hỗ trợ nếu có để biểu đồ chi tiết hơn
    if (node.flowType) {
      label += `<br><small><i>(${node.flowType})</i></small>`;
    }

    // Nếu cấu trúc mới chưa chỉ định rõ hình dáng shape, mặc định quy định theo loại node
    if (node.nodeType === 'decision') {
      return `{"${label}"}`;
    } else if (['start', 'end', 'complete'].includes(node.nodeType)) {
      return `(("${label}"))`;
    } else {
      return `["${label}"]`;
    }
  }

  // 2. TỰ ĐỘNG PHÂN LÀN (Gom nhóm các Node có cùng nodeName vào subgraph)
  if (data.workflowNodes && data.workflowNodes.length > 0) {
    // Trích xuất danh sách các phòng ban duy nhất xuất hiện trong danh sách nodes
    const uniqueDepartments = [...new Set(data.workflowNodes.map(node => node.nodeName))];

    uniqueDepartments.forEach(dept => {
      // Khởi tạo một làn (subgraph) đại diện cho phòng ban này
      mermaid += `    subgraph LANE_${dept} [${dept}]\n`;
      
      // Lấy toàn bộ danh sách node thuộc phòng ban đang duyệt
      const deptNodes = data.workflowNodes.filter(node => node.nodeName === dept);
      deptNodes.forEach(node => {
        const shapeStr = getNodeShape(node);
        
        // Thiết lập màu sắc trực quan dựa theo phòng ban
        let colorClass = ':::blue'; // Màu mặc định
        if (dept === 'Client') colorClass = ':::orange';
        if (dept === 'UW') colorClass = ':::lightOrange';
        
        mermaid += `        ${node.id}${shapeStr}${colorClass}\n`;
      });
      
      mermaid += "    end\n\n";
    });
  }

  mermaid += "    %% ==========================================\n";
  mermaid += "    %% CÁC ĐƯỜNG NỐI (TRANSITIONS)\n";
  mermaid += "    %% ==========================================\n";

  // 3. Tạo các đường liên kết (Transitions)
  if (data.workflowTransitions) {
    data.workflowTransitions.forEach(trans => {
      // Xác định kiểu mũi tên (Nét liền cho thông thường, nét đứt cho đường quay lại - isReturn)
      const isSpecialLink = trans.isReturn || trans.isLoop || trans.lineType === 'dashed';
      const arrow = isSpecialLink ? "-.->" : "-->";
      
      // Khởi tạo nhãn cho mũi tên
      let label = trans.actionName || "";
      
      // Xử lý conditionJson (Dữ liệu mới trả về chuỗi String chứa JSON nên cần parse an toàn)
      if (trans.conditionJson && typeof trans.conditionJson === 'string') {
        try {
          const condObj = JSON.parse(trans.conditionJson);
          if (condObj && condObj.message) {
            label += label ? ` <br> (${condObj.message})` : `(${condObj.message})`;
          }
        } catch (e) {
          // Bỏ qua nếu chuỗi conditionJson rỗng hoặc lỗi cấu trúc format chuỗi thuần
        }
      }

      // Khớp nối cú pháp chuỗi Mermaid
      if (label) {
        if (isSpecialLink) {
          mermaid += `    ${trans.fromNodeId} -. "${label}" .-> ${trans.toNodeId}\n`;
        } else {
          mermaid += `    ${trans.fromNodeId} -->|"${label}"| ${trans.toNodeId}\n`;
        }
      } else {
        mermaid += `    ${trans.fromNodeId} ${arrow} ${trans.toNodeId}\n`;
      }
    });
  }

  return mermaid;
}

       function convertWorkflowToMermaidV2(jsonStr) {

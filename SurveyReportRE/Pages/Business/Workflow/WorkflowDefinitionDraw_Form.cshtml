        function buildConnectionsFromNodes(nodes) {
            const edges = [];

            nodes.forEach(n => {
                if (n.parentId) {
                    edges.push({
                        source: n.parentId,
                        target: n.id
                    });
                }
            });

            return edges;
        }
        function buildAutoLayout(json) {
          var nodes = json.workflowNodes || [];
          var transitions = json.workflowTransitions || [];

          var nodeMap = new Map(nodes.map(n => [n.id, n]));
          var indegree = new Map();
          var graph = new Map();

          nodes.forEach(n => {
            indegree.set(n.id, 0);
            graph.set(n.id, []);
          });

          transitions.forEach(t => {
            if (!nodeMap.has(t.fromNodeId) || !nodeMap.has(t.toNodeId)) return;
            if (t.fromNodeId === t.toNodeId) return;
            graph.get(t.fromNodeId).push(t.toNodeId);
            indegree.set(t.toNodeId, (indegree.get(t.toNodeId) || 0) + 1);
          });

          var roots = nodes
            .filter(n => (indegree.get(n.id) || 0) === 0)
            .sort((a, b) => (a.orderNo || 9999) - (b.orderNo || 9999));

          if (roots.length === 0 && nodes.length) {
            roots = [nodes.slice().sort((a, b) => (a.orderNo || 9999) - (b.orderNo || 9999))[0]];
          }

          var layerMap = new Map();
          var queue = [];

          roots.forEach(r => {
            layerMap.set(r.id, 0);
            queue.push(r.id);
          });

          while (queue.length) {
            var current = queue.shift();
            var currentLayer = layerMap.get(current) || 0;
            var nexts = graph.get(current) || [];

            nexts.forEach(to => {
              var candidate = currentLayer + 1;
              if (!layerMap.has(to) || candidate > layerMap.get(to)) {
                layerMap.set(to, candidate);
                queue.push(to);
              }
            });
          }

          nodes.forEach(n => {
            if (!layerMap.has(n.id)) {
              var maxLayer = Math.max(0, ...Array.from(layerMap.values(), v => v || 0));
              layerMap.set(n.id, maxLayer + 1);
            }
          });

          var grouped = {};
          nodes.forEach(n => {
            var layer = layerMap.get(n.id) || 0;
            if (!grouped[layer]) grouped[layer] = [];
            grouped[layer].push(n);
          });

          Object.keys(grouped).forEach(layer => {
            grouped[layer].sort((a, b) => {
              var ao = a.orderNo || 9999;
              var bo = b.orderNo || 9999;
              if (ao !== bo) return ao - bo;
              return safe(a.nodeName).localeCompare(safe(b.nodeName));
            });
          });

          var startX = 96;
          var startY = 110;
          var colGap = 280;
          var rowGap = 150;
          var positions = {};

          Object.keys(grouped)
            .map(Number)
            .sort((a, b) => a - b)
            .forEach(layer => {
              var arr = grouped[layer];
              var totalHeight = (arr.length - 1) * rowGap;
              var baseY = Math.max(startY, 200 - totalHeight / 2);

              arr.forEach((n, index) => {
                positions[n.id] = {
                  x: snap(startX + layer * colGap),
                  y: snap(baseY + index * rowGap),
                  layer
                };
              });
            });

          var maxLayer = Math.max(...Object.keys(grouped).map(Number));
          var maxCount = Math.max(...Object.values(grouped).map(a => a.length));
          var canvasWidth = startX + (maxLayer + 1) * colGap + 300;
          var canvasHeight = Math.max(760, startY + maxCount * rowGap + 260);

          return { positions, grouped, canvasWidth, canvasHeight };
        }

        function buildSavedLayout(json) {
          var nodes = json.workflowNodes || [];
          var positions = {};
          var maxX = 0;
          var maxY = 0;

          nodes.forEach(n => {
            var x = snap(Number(n.x || 0));
            var y = snap(Number(n.y || 0));
            positions[n.id] = { x, y, layer: null };
            maxX = Math.max(maxX, x);
            maxY = Math.max(maxY, y);
          });

          return {
            positions,
            grouped: {},
            canvasWidth: Math.max(1400, maxX + 420),
            canvasHeight: Math.max(760, maxY + 260)
          };
        }


        position: relative;
        min-width: 1400px;
        min-height: 760px;
        background: linear-gradient(to right, rgba(203,213,225,.35) 1px, transparent 1px), linear-gradient(to bottom, rgba(203,213,225,.35) 1px, transparent 1px);
        background-size: 24px 24px;
        background-color: #fff;
        border: 1px solid var(--border);
        border-radius: 18px;
        box-shadow: 0 10px 28px rgba(15,23,42,0.06);
        overflow:  auto;
        }*/

    .node {
        position: absolute;
        width: 180px;
        min-height: 88px;
        border-radius: 14px;
        border: 2px solid #cfd8e3;
        background: #fff;
        padding: 10px 12px;
        box-shadow: 0 8px 18px rgba(0,0,0,0.08);
        text-align: center;
        z-index: 2;
        transition: .15s ease;
        cursor: move;
        user-select: none;
    }

        .node .node-title {
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .node .node-meta {
            font-size: 12px;
            line-height: 1.45;
            color: #64748b;
        }

        .node.flow-quotation {
            border-color: var(--quotation)
        }

        .node.flow-policy {
            border-color: var(--policy)
        }

        .node.flow-both {
            border-color: var(--both)
        }

        .node.active {
            border-color: var(--active);
            background: #fffaf0;
            box-shadow: 0 0 0 4px rgba(245,158,11,0.15), 0 12px 22px rgba(245,158,11,0.18);
        }

        .node.done {
            background: #f0fdf4;
        }

        .node.pending {
            opacity: .94;
        }

    .layer-label {
        position: absolute;
        top: 14px;
        font-size: 12px;
        color: #64748b;
        background: #f8fafc;
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 4px 10px;
        z-index: 1;
    }

    .jtk-overlay {
        font-size: 11px !important;
        color: #334155 !important;
        background: rgba(255,255,255,0.96);
        border: 1px solid #dbe2ea;
        padding: 4px 8px;
        border-radius: 999px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.06);
    }

    .note {
        font-size: 12px;
        color: var(--muted);
        line-height: 1.5;
    }

    .status-ok {
        color: #15803d;
    }

    code {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        padding: 2px 6px;
        border-radius: 6px;
    }

    .page {
        display: grid;
        grid-template-columns: 240px 1fr 430px;
        height: 100vh;
    }

    .sidebar {
        border-right: 1px solid #dbe2ea;
        background: #fff;
        padding: 14px;
        overflow: auto;
    }

        .sidebar h3 {
            margin: 0 0 12px;
            font-size: 16px;
        }

    .sidebarHint {
        font-size: 12px;
        color: #64748b;
        line-height: 1.5;
        margin-bottom: 12px;
    }

    .palette {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .paletteItem {
        border: 1px solid #dbe2ea;
        border-radius: 12px;
        background: #fff;
        padding: 12px;
        cursor: grab;
        user-select: none;
        box-shadow: 0 4px 12px rgba(0,0,0,.05);
        transition: all .15s ease;
    }

        .paletteItem:hover {
            background: #f8fafc;
            transform: translateY(-1px);
        }

    .paletteTitle {
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .paletteMeta {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    .mainPane {
        padding: 14px;
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .toolbar {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 10px;
    }

    .btn {
        border: 1px solid #cfd6df;
        background: #fff;
        border-radius: 10px;
        padding: 8px 12px;
        cursor: pointer;
        font-size: 13px;
    }

        .btn:hover {
            background: #f8fafc;
        }

    .legend {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 10px;
    }

    .tag {
        display: inline-flex;
        align-items: center;
        height: 24px;
        padding: 0 9px;
        border-radius: 999px;
        border: 1px solid #dbe2ea;
        background: #fff;
        font-size: 11px;
        color: #334155;
    }

        .tag.active {
            background: #dbeafe;
            border-color: #93c5fd;
            color: #1d4ed8;
        }

        .tag.done {
            background: #dcfce7;
            border-color: #86efac;
            color: #166534;
        }

        .tag.pending {
            background: #fef3c7;
            border-color: #fcd34d;
            color: #92400e;
        }

        .tag.loop {
            background: #ffedd5;
            border-color: #fdba74;
            color: #9a3412;
        }

        .tag.return {
            background: #fee2e2;
            border-color: #fca5a5;
            color: #991b1b;
        }

        .tag.exit {
            background: #ede9fe;
            border-color: #c4b5fd;
            color: #6d28d9;
        }

    .canvas {
        position: relative;
        flex: 1;
        border: 1px solid #dbe2ea;
        border-radius: 16px;
        background: linear-gradient(to right, rgba(0,0,0,.04) 1px, transparent 1px), linear-gradient(to bottom, rgba(0,0,0,.04) 1px, transparent 1px), #fff;
        background-size: 24px 24px;
        overflow: hidden;
        min-height: 420px;
    }

        .canvas.dragOver {
            background: linear-gradient(to right, rgba(59,130,246,.08) 1px, transparent 1px), linear-gradient(to bottom, rgba(59,130,246,.08) 1px, transparent 1px), #eff6ff;
            background-size: 24px 24px;
        }

    .rightPane {
        border-left: 1px solid #dbe2ea;
        background: #fff;
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .panelHeader {
        padding: 14px 16px;
        border-bottom: 1px solid #eef2f7;
        font-weight: 700;
    }

    .panelBody {
        padding: 12px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        min-height: 0;
        flex: 1;
    }

    .statusBar {
        font-size: 12px;
        color: #475569;
    }

    .sectionTitle {
        font-size: 12px;
        font-weight: 700;
        color: #475569;
        margin-top: 4px;
    }

    .infoBox {
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 12px;
        background: #fafafa;
        font-size: 12px;
        line-height: 1.5;
        max-height: 220px;
        overflow: auto;
        white-space: pre-wrap;
    }

    textarea {
        width: 100%;
        flex: 1;
        resize: none;
        border: 1px solid #dbe2ea;
        border-radius: 12px;
        padding: 12px;
        font-family: Consolas, monospace;
        font-size: 12px;
        line-height: 1.45;
        outline: none;
    }

    .node {
        position: absolute;
        width: 200px;
        min-height: 80px;
        padding: 10px 12px;
        border-radius: 14px;
        background: #fff;
        border: 2px solid #cbd5e1;
        box-shadow: 0 8px 18px rgba(0,0,0,.08);
        cursor: move;
        user-select: none;
        transition: all .15s ease;
    }

        .node:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 22px rgba(0,0,0,.12);
        }

        .node.selected {
            box-shadow: 0 0 0 4px rgba(37,99,235,.12), 0 10px 24px rgba(0,0,0,.12);
            border-color: #2563eb;
        }

        .node.activeNode {
            border-color: #2563eb;
            background: #eff6ff;
        }

        .node.completedNode {
            border-color: #16a34a;
            background: #f0fdf4;
        }

        .node.pendingNode {
            border-color: #d97706;
            background: #fff7ed;
        }

        .node.allowLoopNode::after {
            content: "↻";
            position: absolute;
            top: -8px;
            right: -8px;
            width: 24px;
            height: 24px;
            border-radius: 999px;
            background: #fb923c;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            box-shadow: 0 4px 10px rgba(0,0,0,.15);
        }

    .nodeTitle {
        font-size: 15px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .nodeMeta {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    .meta {
        display: inline-flex;
        align-items: center;
        height: 22px;
        padding: 0 8px;
        border-radius: 999px;
        font-size: 11px;
        border: 1px solid #dbe2ea;
        background: #f8fafc;
        color: #334155;
    }

    .flow-both {
        background: #f8fafc;
    }

    .flow-quotation {
        background: #ecfeff;
        border-color: #a5f3fc;
        color: #155e75;
    }

    .flow-policy {
        background: #f5f3ff;
        border-color: #c4b5fd;
        color: #5b21b6;
    }

    .jtk-connector {
        z-index: 4;
    }

    .jtk-endpoint {
        z-index: 5;
    }

    .jtk-overlay {
        z-index: 6;
    }

    .aLabel {
        background: rgba(255,255,255,.94);
        border: 1px solid #e5e7eb;
        border-radius: 999px;
        padding: 2px 8px;
        font-size: 11px;
        color: #334155;
    }
</style>
<body>
    <div class="app">
        <aside class="sidebar">
            <div class="title">Design Workflow</div>
            <div class="palette">
                <div class="paletteItem" draggable="true" data-template='{"nodeName":"FO","flowType":"Both","allowLoop":false,"loopGroup":"","nodeType":"","nodeCode":"","stepRole":"","departmentName":"","levelNo":1}'>
                    <div class="paletteTitle">FO</div>
                    <div class="paletteMeta">
                        <span class="tag">Both</span>
                    </div>
                </div>

                <div class="paletteItem" draggable="true" data-template='{"nodeName":"TS","flowType":"Quotation","allowLoop":false,"loopGroup":"","nodeType":"","nodeCode":"","stepRole":"","departmentName":"","levelNo":1}'>
                    <div class="paletteTitle">TS</div>
                    <div class="paletteMeta">
                        <span class="tag">Quotation</span>
                    </div>
                </div>

                <div class="paletteItem" draggable="true" data-template='{"nodeName":"UW","flowType":"Both","allowLoop":false,"loopGroup":"","nodeType":"","nodeCode":"","stepRole":"","departmentName":"","levelNo":1}'>
                    <div class="paletteTitle">UW</div>
                    <div class="paletteMeta">
                        <span class="tag">Both</span>
                    </div>
                </div>

                <div class="paletteItem" draggable="true" data-template='{"nodeName":"Client","flowType":"Both","allowLoop":true,"loopGroup":"CLIENT_REVIEW","nodeType":"","nodeCode":"","stepRole":"","departmentName":"","levelNo":1}'>
                    <div class="paletteTitle">Client</div>
                    <div class="paletteMeta">
                        <span class="tag">Both</span>
                        <span class="tag loop">Loop</span>
                    </div>
                </div>

                <div class="paletteItem" draggable="true" data-template='{"nodeName":"PM","flowType":"Both","allowLoop":false,"loopGroup":"","nodeType":"","nodeCode":"","stepRole":"","departmentName":"","levelNo":1}'>
                    <div class="paletteTitle">PM</div>
                    <div class="paletteMeta">
                        <span class="tag">Both</span>
                    </div>
                </div>
            </div>
            <div class="sub">
                jsPlumb
            </div>

            <div class="card-in-frame">
                <div class="header-in-frame">Legend</div>
                <div class="legend-row"><span class="dot quotation"></span> Quotation</div>
                <div class="legend-row"><span class="dot policy"></span> Policy Issuance</div>
                <div class="legend-row"><span class="dot both"></span> Both</div>
                <div class="legend-row"><span class="dot active"></span> Current node</div>
                <div class="legend-row"><span class="dot done"></span> Done</div>
                <div class="legend-row"><span class="dot pending"></span> Pending</div>
                <div class="legend-row"><span class="line"></span> Normal transition</div>
                <div class="legend-row"><span class="line return"></span> Return transition</div>
                <div class="legend-row"><span class="line loop"></span> Loop transition</div>
            </div>

            <div class="card-in-frame">
                <div class="header-in-frame">Workflow JSON</div>
                <textarea id="jsonInput_@Convert.ToInt32(ViewData["Id"])"></textarea>
                <div class="btn-row">
                    <button id="btnRender_@Convert.ToInt32(ViewData["Id"])">Render</button>
                    <button class="secondary" id="btnUpdate_@Convert.ToInt32(ViewData["Id"])">Update</button>
                    @* <button class="warning" id="btnAutoLayout_@Convert.ToInt32(ViewData["Id"])">Force Auto Layout</button> *@
                    <button class="success" id="btnExport_@Convert.ToInt32(ViewData["Id"])">Export JSON</button>
                </div>
                <div id="errorBox_@Convert.ToInt32(ViewData["Id"])" class="error"></div>
            </div>


        </aside>

        <main class="main">
            <div class="toolbar">
                <div class="toolbar-left">
                    <span class="badge">Workflow coordinate</span>
                </div>
                <div class="toolbar-right">
                </div>
            </div>

            <div class="canvas-wrap">
                <div id="canvas_@Convert.ToInt32(ViewData["Id"])" class="canvas"></div>
            </div>
        </main>
    </div>



                    <span class="badge" id="layoutMode">Layout: -</span>
                    <span class="badge" id="saveHint">Position: draggable</span>
                </div>
            </div>

            <div class="canvas-wrap">
                <div id="canvas"></div>
            </div>
        </main>
    </div>


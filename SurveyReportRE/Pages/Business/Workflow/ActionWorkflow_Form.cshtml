@page "{pageNum:int?}"
@model ActionWorkflow_FormModel
@{


}
<script>
    $(function () {
        var _id = @Convert.ToInt32(ViewData["Id"]);

        var _formConfig = new MFormOption();
        _formConfig.cloneUrl = '/Business/MasterData/ActionWorkflow_Form/' + _id;
        _formConfig.tabCode = `form_ActionWorkflow_Form_${_id}`;
        _formConfig.tabName = '@HttpContext.Request.Query["Caption"].ToString()';
        _formConfig.originModelName = "@ActionWorkflow_FormModel.ModelName";
        _formConfig.formElementName = "@ActionWorkflow_FormModel.ModelName";
        _formConfig.schemeBasedOn = `@(ActionWorkflow_FormModel.SchemeModelName)`;
        _formConfig.allowFormActionButton = true;
        _formConfig.colCount = 4;
        _formConfig.isCustomQuery = true;
        new ActionWorkflowForm(_id, null, _formConfig);
    });
</script>
<div id="form_@(ActionWorkflow_FormModel.ModelName)_@Convert.ToInt32(ViewData["Id"])" class="dExForm"></div>

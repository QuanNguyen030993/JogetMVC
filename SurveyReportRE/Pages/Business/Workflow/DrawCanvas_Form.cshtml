<body>
    <div>
@*         <aside >

        </aside> *@

        <main class="main">
            <div class="canvas-view-wrap">
                <div id="canvas-view"></div>
            </div>
        </main>
    </div>

    <script>
         var _id = @Convert.ToInt32(ViewData["Id"]);

                ajaxGet(`/api/WorkflowDefinition/GetSingle/${_id}`)
                      .then(data => {
        var sampleJson = {
          
        };

         
           sampleJson = JSON.parse(data.workflowNodes);
         var jsonInput = {};
        var canvas = document.getElementById("canvas-view");
        var wfCode = document.getElementById("wfCode");
        var flowType = document.getElementById("flowType");
        var currentStep = document.getElementById("currentStep");
        var layoutMode = document.getElementById("layoutMode");
        var saveHint = document.getElementById("saveHint");

        var instance = null;
        var currentJson = null;

         jsonInput.value = JSON.stringify(sampleJson, null, 2);

        function safe(v) {
          return String(v == null ? "" : v);
        }

        function hasNumber(v) {
          return typeof v === "number" && !Number.isNaN(v);
        }

        function snap(n, grid = 24) {
          return Math.round(n / grid) * grid;
        }

        function cloneJson(obj) {
          return JSON.parse(JSON.stringify(obj));
        }

        function getNodeFlowClass(flowType) {
          if (flowType === "Quotation") return "flow-quotation";
          if (flowType === "PolicyIssuance") return "flow-policy";
          return "flow-both";
        }

        function getNodeStateClass(nodeId, runtimeState) {
          var active = runtimeState?.activeNodeId;
          var done = runtimeState?.compvaredNodeIds || [];
          var pending = runtimeState?.pendingNodeIds || [];
          if (nodeId === active) return "active";
          if (done.includes(nodeId)) return "done";
          if (pending.includes(nodeId)) return "pending";
          return "pending";
        }

        function getNodesWithSavedPosition(nodes) {
          return (nodes || []).filter(n => hasNumber(n.x) && hasNumber(n.y));
        }

        // function syncJsonToTextarea() {
        //   if (!currentJson) return;
        //   jsonInput.value = JSON.stringify(currentJson, null, 2);
        // }

        function updateNodeCoordinateUi(nodeId, x, y) {
          var xEl = document.querySelector(`[data-x="${nodeId}"]`);
          var yEl = document.querySelector(`[data-y="${nodeId}"]`);
          if (xEl) xEl.textContent = x;
          if (yEl) yEl.textContent = y;
        }

        function updateNodePosition(nodeId, x, y) {
          if (!currentJson || !currentJson.workflowNodes) return;
          var node = currentJson.workflowNodes.find(n => n.id === nodeId);
          if (!node) return;

          node.x = x;
          node.y = y;

          updateNodeCoordinateUi(nodeId, x, y);
          // syncJsonToTextarea();
        }
        function buildConnectionsFromNodes(nodes) {
            const edges = [];

            nodes.forEach(n => {
                if (n.parentId) {
                    edges.push({
                        source: n.parentId,
                        target: n.id
                    });
                }
            });

            return edges;
        }
        function buildAutoLayout(json) {
          var nodes = json.workflowNodes || [];
          var transitions = json.workflowTransitions || [];

          var nodeMap = new Map(nodes.map(n => [n.id, n]));
          var indegree = new Map();
          var graph = new Map();

          nodes.forEach(n => {
            indegree.set(n.id, 0);
            graph.set(n.id, []);
          });

          transitions.forEach(t => {
            if (!nodeMap.has(t.fromNodeId) || !nodeMap.has(t.toNodeId)) return;
            if (t.fromNodeId === t.toNodeId) return;
            graph.get(t.fromNodeId).push(t.toNodeId);
            indegree.set(t.toNodeId, (indegree.get(t.toNodeId) || 0) + 1);
          });

          var roots = nodes
            .filter(n => (indegree.get(n.id) || 0) === 0)
            .sort((a, b) => (a.orderNo || 9999) - (b.orderNo || 9999));

          if (roots.length === 0 && nodes.length) {
            roots = [nodes.slice().sort((a, b) => (a.orderNo || 9999) - (b.orderNo || 9999))[0]];
          }

          var layerMap = new Map();
          var queue = [];

          roots.forEach(r => {
            layerMap.set(r.id, 0);
            queue.push(r.id);
          });

          while (queue.length) {
            var current = queue.shift();
            var currentLayer = layerMap.get(current) || 0;
            var nexts = graph.get(current) || [];

            nexts.forEach(to => {
              var candidate = currentLayer + 1;
              if (!layerMap.has(to) || candidate > layerMap.get(to)) {
                layerMap.set(to, candidate);
                queue.push(to);
              }
            });
          }

          nodes.forEach(n => {
            if (!layerMap.has(n.id)) {
              var maxLayer = Math.max(0, ...Array.from(layerMap.values(), v => v || 0));
              layerMap.set(n.id, maxLayer + 1);
            }
          });

          var grouped = {};
          nodes.forEach(n => {
            var layer = layerMap.get(n.id) || 0;
            if (!grouped[layer]) grouped[layer] = [];
            grouped[layer].push(n);
          });

          Object.keys(grouped).forEach(layer => {
            grouped[layer].sort((a, b) => {
              var ao = a.orderNo || 9999;
              var bo = b.orderNo || 9999;
              if (ao !== bo) return ao - bo;
              return safe(a.nodeName).localeCompare(safe(b.nodeName));
            });
          });

          var startX = 96;
          var startY = 110;
          var colGap = 280;
          var rowGap = 150;
          var positions = {};

          Object.keys(grouped)
            .map(Number)
            .sort((a, b) => a - b)
            .forEach(layer => {
              var arr = grouped[layer];
              var totalHeight = (arr.length - 1) * rowGap;
              var baseY = Math.max(startY, 200 - totalHeight / 2);

              arr.forEach((n, index) => {
                positions[n.id] = {
                  x: snap(startX + layer * colGap),
                  y: snap(baseY + index * rowGap),
                  layer
                };
              });
            });

          var maxLayer = Math.max(...Object.keys(grouped).map(Number));
          var maxCount = Math.max(...Object.values(grouped).map(a => a.length));
          var canvasWidth = startX + (maxLayer + 1) * colGap + 300;
          var canvasHeight = Math.max(760, startY + maxCount * rowGap + 260);

          return { positions, grouped, canvasWidth, canvasHeight };
        }

        function buildSavedLayout(json) {
          var nodes = json.workflowNodes || [];
          var positions = {};
          var maxX = 0;
          var maxY = 0;

          nodes.forEach(n => {
            var x = snap(Number(n.x || 0));
            var y = snap(Number(n.y || 0));
            positions[n.id] = { x, y, layer: null };
            maxX = Math.max(maxX, x);
            maxY = Math.max(maxY, y);
          });

          return {
            positions,
            grouped: {},
            canvasWidth: Math.max(1400, maxX + 420),
            canvasHeight: Math.max(760, maxY + 260)
          };
        }

        function createNodeEl(node, pos, runtimeState) {
          var el = document.createElement("div");
          el.id = node.id;
          el.className = "node " + getNodeFlowClass(node.flowType) + " " + getNodeStateClass(node.id, runtimeState);
          el.style.left = pos.x + "px";
          el.style.top = pos.y + "px";
          el.innerHTML = `
            <div class="node-title">${safe(node.nodeName || node.id)}</div>
            <div class="node-meta">
              <div>Order: ${safe(node.orderNo)}</div>
              <div>Level: ${safe(node.levelNo)}</div>
              <div>Flow: ${safe(node.flowType || "Both")}</div>
              <div>X: <span data-x="${node.id}">${safe(node.x)}</span> | Y: <span data-y="${node.id}">${safe(node.y)}</span></div>
            </div>
          `;
          return el;
        }

        function createLayerLabel(layer, x) {
          var el = document.createElement("div");
          el.className = "layer-label";
          el.style.left = x + "px";
          el.textContent = "Layer " + layer;
          return el;
        }

        function colorForEdge(t) {
          if (t.isReturn) return "var(--return)";
          if (t.isLoop) return "var(--loop)";
          if (t.flowType === "Quotation") return "var(--quotation)";
          if (t.flowType === "PolicyIssuance") return "var(--policy)";
          return "var(--both)";
        }

        function chooseAnchors(t) {
          if (t.isReturn) return ["Top", "Top"];
          return ["Right", "Left"];
        }

        function connectEdge(t) {
          var color = colorForEdge(t);
          var label = safe(t.actionName || t.userDecisionLabel || t.actionCode || "");
          var isSelfLoop = t.fromNodeId === t.toNodeId;

          var overlays = [
            ["Arrow", { location: 1, width: 10, length: 10 }]
          ];

          if (label) {
            overlays.unshift(["Label", {
              label,
              location: 0.5,
              cssClass: "edge-label"
            }]);
          }

          if (isSelfLoop) {
            instance.connect({
              source: t.fromNodeId,
              target: t.toNodeId,
              anchors: ["Top", "Right"],
              connector: ["StateMachine", { margin: 12, curviness: 45, loopbackRadius: 32 }],
              endpoint: "Blank",
              paintStyle: {
                stroke: color,
                strokeWidth: 3,
                dashstyle: t.isReturn ? "4 4" : ""
              },
              overlays
            });
            return;
          }

          instance.connect({
            source: t.fromNodeId,
            target: t.toNodeId,
            anchors: chooseAnchors(t),
            connector: ["Bezier", { curviness: t.isReturn ? 95 : 60 }],
            endpoint: "Blank",
            paintStyle: {
              stroke: color,
              strokeWidth: (t.isReturn || t.isLoop) ? 3 : 2.5,
              dashstyle: t.isReturn ? "4 4" : ""
            },
            overlays
          });
        }

        function attachDrag() {
          (currentJson.workflowNodes || []).forEach(node => {
            instance.draggable(node.id, {
              grid: [24, 24],
              containment: true,
              stop: function() {
                var el = document.getElementById(node.id);
                if (!el) return;

                var left = snap(parseInt(el.style.left || "0", 10));
                var top = snap(parseInt(el.style.top || "0", 10));

                el.style.left = left + "px";
                el.style.top = top + "px";

                updateNodePosition(node.id, left, top);
                instance.revalidate(node.id);

                saveHint.innerHTML = `Position: <span class="status-ok">updated ${node.id} (${left}, ${top})</span>`;
              }
            });
          });
        }


        function renderWorkflow(options = {}) {
          try {

            currentJson = JSON.parse(jsonInput.value);

            if (instance) {
              instance.reset();
            }

            canvas.innerHTML = "";

            var useSavedLayout =
              !options.forceAuto &&
              getNodesWithSavedPosition(currentJson.workflowNodes).length > 0;

            var layout = useSavedLayout
              ? buildSavedLayout(currentJson)
              : buildAutoLayout(currentJson);

            var { positions, grouped, canvasWidth, canvasHeight } = layout;

            canvas.style.width = canvasWidth + "px";
            canvas.style.height = canvasHeight + "px";

            if (!useSavedLayout) {
              Object.keys(grouped).map(Number).sort((a, b) => a - b).forEach(layer => {
                var arr = grouped[layer];
                if (arr.length) {
                  canvas.appendChild(createLayerLabel(layer, positions[arr[0].id].x));
                }
              });
            }

            (currentJson.workflowNodes || []).forEach(node => {
              var pos = positions[node.id];
              if (!pos) return;

              if (!useSavedLayout || !hasNumber(node.x) || !hasNumber(node.y)) {
                node.x = pos.x;
                node.y = pos.y;
              }

              canvas.appendChild(createNodeEl(node, pos, currentJson.runtimeState || {}));
            });

            instance = jsPlumb.getInstance({
              Container: canvas
            });

            instance.importDefaults({
              ConnectionsDetachable: false,
              ReattachConnections: false,
              Endpoint: "Blank",
              PaintStyle: { stroke: "#64748b", strokeWidth: 2 },
              HoverPaintStyle: { stroke: "#334155", strokeWidth: 3 }
            });

            (currentJson.workflowTransitions || []).forEach(connectEdge);
            attachDrag();

            var def = currentJson.workflowDefinition || {};
            wfCode.textContent = "Workflow: " + safe(def.workflowCode || "-");
            flowType.textContent = "Flow: " + safe(def.flowType || "-");
            currentStep.textContent = "Current: " + safe(currentJson.runtimeState?.activeNodeId || "-");
            layoutMode.textContent = "Layout: " + (useSavedLayout ? "saved x,y" : "auto layout");

            // syncJsonToTextarea();
          } catch (err) {
          }
        }

    

        renderWorkflow();
                      });

    </script>
</body>

@page "{pageNum:int?}"
@model WorkflowInstanceNode_FormModel
@{


}
<script>
    $(function () {
        var _id = @Convert.ToInt32(ViewData["Id"]);

        var _formConfig = new MFormOption();
        _formConfig.cloneUrl = '/Business/MasterData/WorkflowInstanceNode_Form/' + _id;
        _formConfig.tabCode = `form_WorkflowInstanceNode_Form_${_id}`;
        _formConfig.tabName = '@HttpContext.Request.Query["Caption"].ToString()';
        _formConfig.originModelName = "@WorkflowInstanceNode_FormModel.ModelName";
        _formConfig.formElementName = "@WorkflowInstanceNode_FormModel.ModelName";
        _formConfig.schemeBasedOn = `@(WorkflowInstanceNode_FormModel.SchemeModelName)`;
        _formConfig.allowFormActionButton = true;
        _formConfig.colCount = 4;
        _formConfig.isCustomQuery = true;
        new WorkflowInstanceNodeForm(_id, null, _formConfig);
    });
</script>
<div id="form_@(WorkflowInstanceNode_FormModel.ModelName)_@Convert.ToInt32(ViewData["Id"])" class="dExForm"></div>
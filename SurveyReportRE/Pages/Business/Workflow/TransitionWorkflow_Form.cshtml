@page "{pageNum:int?}"
@model TransitionWorkflow_FormModel
@{


}
<script>
    $(function () {
        var _id = @Convert.ToInt32(ViewData["Id"]);

        var _formConfig = new MFormOption();
        _formConfig.cloneUrl = '/Business/MasterData/TransitionWorkflow_Form/' + _id;
        _formConfig.tabCode = `form_TransitionWorkflow_Form_${_id}`;
        _formConfig.tabName = '@HttpContext.Request.Query["Caption"].ToString()';
        _formConfig.originModelName = "@TransitionWorkflow_FormModel.ModelName";
        _formConfig.formElementName = "@TransitionWorkflow_FormModel.ModelName";
        _formConfig.schemeBasedOn = `@(TransitionWorkflow_FormModel.SchemeModelName)`;
        _formConfig.allowFormActionButton = true;
        _formConfig.colCount = 4;
        _formConfig.isCustomQuery = true;
        new TransitionWorkflowForm(_id, null, _formConfig);
    });
</script>
<div id="form_@(TransitionWorkflow_FormModel.ModelName)_@Convert.ToInt32(ViewData["Id"])" class="dExForm"></div>
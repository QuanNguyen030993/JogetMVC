        function saveFlow() {
            var payload = getPayloadBoxObject();

            if (!payload) {
                return notify("Payload JSON is invalid", "error");
            }

            var workflowData = {
                id: _id || payload.workflowDefinition?.id || 0,
                // workflowCode: payload.workflowDefinition?.workflowCode || "",

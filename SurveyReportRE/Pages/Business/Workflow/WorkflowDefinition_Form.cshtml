                function initTransitionGrid() {

            $("#transitionGrid_@Convert.ToInt32(ViewData["Id"])").dxDataGrid({
                dataSource: transitions,
                keyExpr: function (row, index) {
                    return `${row.fromNodeId}_${row.toNodeId}_${row.actionCode}_${index}`;
                },
                showBorders: true,
                height: 420,
                paging: { enabled: false },
                filterRow: { visible: true },
                searchPanel: { visible: true, width: 260, placeholder: "Search transition..." },
                headerFilter: { visible: true },
                columnAutoWidth: true,
                allowColumnResizing: true,
                rowAlternationEnabled: true,
                editing: {
                    mode: "row",
                    allowUpdating: false,
                    allowAdding: false,
                    allowDeleting: true,
                    useIcons: true
                },
                columns: [
                    {
                        caption: "#",
                        width: 60,
                        cellTemplate: function (container, options) {
                            container.text(options.rowIndex + 1);
                        }
                    },
                    { dataField: "fromNodeId", caption: "From Node" },
                    { dataField: "toNodeId", caption: "To Node" },
                    { dataField: "actionCode", caption: "Action Code" },
                    { dataField: "actionName", caption: "Action Name" },
                    {
                        dataField: "flowType",
                        caption: "Flow Type",
                        lookup: {
                            dataSource: ["Quotation", "PolicyIssuance", "Both"]
                        }
                    },
                    { dataField: "isReturn", caption: "Is Return", dataType: "boolean", width: 90 },
                    { dataField: "isLoop", caption: "Is Loop", dataType: "boolean", width: 80 },
                    { dataField: "loopGroup", caption: "Loop Group" },
                    { dataField: "loopExitMode", caption: "Loop Exit Mode" },
                    { dataField: "maxLoopCount", caption: "Max Loop Count", dataType: "number" },
                    { dataField: "isExitTransition", caption: "Is Exit", dataType: "boolean", width: 80 },
                    { dataField: "userDecisionLabel", caption: "User Decision Label" },
                    {
                        dataField: "conditionJson",
                        caption: "Condition JSON",
                        minWidth: 220,
                        cellTemplate: function (container, options) {
                            const text = options.value || "";
                            $("<div>")
                                .css({
                                    whiteSpace: "pre-wrap",
                                    wordBreak: "break-word",
                                    maxHeight: "90px",
                                    overflow: "auto"
                                })
                                .text(text)
                                .appendTo(container);
                        }
                    }
                ],
                onRowRemoving: function (e) {
                    const rowIndex = transitions.findIndex(x =>
                        x.fromNodeId === e.data.fromNodeId &&
                        x.toNodeId === e.data.toNodeId &&
                        x.actionCode === e.data.actionCode &&
                        x.actionName === e.data.actionName &&
                        x.flowType === e.data.flowType &&
                        x.isReturn === e.data.isReturn &&
                        x.isLoop === e.data.isLoop &&
                        x.loopGroup === e.data.loopGroup &&
                        x.loopExitMode === e.data.loopExitMode &&
                        x.maxLoopCount === e.data.maxLoopCount &&
                        x.isExitTransition === e.data.isExitTransition &&
                        x.userDecisionLabel === e.data.userDecisionLabel &&
                        x.conditionJson === e.data.conditionJson
                    );

                    if (rowIndex >= 0) {
                        transitions.splice(rowIndex, 1);
                        refreshTransitionGrid();
                        buildPayloadPreview();
                        notify("Transition deleted", "success");
                    }

                    e.cancel = true;
                },
                onRowDblClick: function (e) {
                    if (!transitionFormInstance || !e.data) return;
                    transitionFormInstance.option("formData", { ...e.data });
                    notify("Transition loaded to editor", "success");
                },
                onInitialized: function (e) {
                    transitionGridInstance = e.component;
                }
            });
        }

                function refreshTransitionGrid() {


                    hydrateStateFromPayload($("#payloadBox_@Convert.ToInt32(ViewData["Id"])").text());
            if (transitionGridInstance) {
                transitionGridInstance.option("dataSource", [...transitions]);
                transitionGridInstance.refresh();
            }
        }

                var payloadInitialized = false;

        function safeParseJson(text, fallback = null) {
            try {
                return JSON.parse(text);
            } catch (e) {
                return fallback;
            }
        }

        function getPayloadBoxObject() {
            var raw = ($("#payloadBox_@Convert.ToInt32(ViewData["Id"])").text() || "").trim();
            return safeParseJson(raw, null);
        }

        function setPayloadBoxObject(obj) {
            $("#payloadBox_@Convert.ToInt32(ViewData["Id"])").text(JSON.stringify(obj, null, 2));
        }

        function buildPayloadObjectFromState() {
            syncWorkflowHeader();
            syncRuntimeState();

            return {
                workflowDefinition: {
                    id: _id || 0,
                    workflowCode: workflowHeader.workflowCode || "",
                    workflowName: workflowHeader.workflowName || "",
                    flowType: workflowHeader.flowType || "Both",
                    versionNo: workflowHeader.versionNo ?? 1,
                    isActive: workflowHeader.isActive ?? true
                },
                workflowNodes: workflowTreeData.map((x, index) => ({
                    id: x.id,
                    parentId: x.parent === "#" ? null : x.parent,
                    nodeName: x.text,
                    nodeType: x.type || "",
                    nodeCode: x.code || "",
                    orderNo: x.orderNo ?? (index + 1),
                    stepRole: x.stepRole || "",
                    departmentName: x.departmentName || "",
                    levelNo: x.levelNo ?? 1,
                    flowType: x.flowType || "Both",
                    allowLoop: !!x.allowLoop,
                    loopGroup: x.loopGroup || "",
                    x: x.x ?? null,
                    y: x.y ?? null
                })),
                workflowTransitions: transitions.map(x => ({
                    fromNodeId: x.fromNodeId,
                    toNodeId: x.toNodeId,
                    actionCode: x.actionCode || "",
                    actionName: x.actionName || "",
                    flowType: x.flowType || "Both",
                    isReturn: !!x.isReturn,
                    isLoop: !!x.isLoop,
                    loopGroup: x.loopGroup || "",
                    loopExitMode: x.loopExitMode || "None",
                    maxLoopCount: x.maxLoopCount ?? null,
                    isExitTransition: !!x.isExitTransition,
                    userDecisionLabel: x.userDecisionLabel || "",
                    conditionJson: x.conditionJson || ""
                })),
                runtimeState: {
                    activeNodeId: runtimeState.activeNodeId || null,
                    completedNodeIds: runtimeState.completedNodeIds || [],
                    pendingNodeIds: runtimeState.pendingNodeIds || []
                }
            };
        }

            function hydrateStateFromPayload(payload) {
            if (!payload) return;

            workflowHeader = payload.workflowDefinition || workflowHeader;
            runtimeState = payload.runtimeState || runtimeState;

            workflowTreeData = (payload.workflowNodes || []).map(x => ({
                id: x.id,
                parent: x.parentId || "#",
                text: x.nodeName || "",
                type: x.nodeType || "",
                code: x.nodeCode || "",
                orderNo: x.orderNo ?? 0,
                stepRole: x.stepRole || "",
                departmentName: x.departmentName || "",
                levelNo: x.levelNo ?? 1,
                flowType: x.flowType || "Both",
                allowLoop: !!x.allowLoop,
                loopGroup: x.loopGroup || "",
                x: x.x ?? null,
                y: x.y ?? null
            }));

            transitions = (payload.workflowTransitions || []).map(x => ({
                fromNodeId: x.fromNodeId,
                toNodeId: x.toNodeId,
                actionCode: x.actionCode || "",
                actionName: x.actionName || "",
                flowType: x.flowType || "Both",
                isReturn: !!x.isReturn,
                isLoop: !!x.isLoop,
                loopGroup: x.loopGroup || "",
                loopExitMode: x.loopExitMode || "None",
                maxLoopCount: x.maxLoopCount ?? null,
                isExitTransition: !!x.isExitTransition,
                userDecisionLabel: x.userDecisionLabel || "",
                conditionJson: x.conditionJson || ""
            }));

            if (workflowFormInstance) workflowFormInstance.option("formData", workflowHeader);
            if (transitionFormInstance) transitionFormInstance.option("formData", getEmptyTransition(""));
            if (nodeFormInstance) nodeFormInstance.option("formData", {});

            initTree();
            refreshTransitionNodeLookup();
            renderTransitionPreview();
            refreshGrid();
        }

                function initPayloadBoxOnce() {
            if (payloadInitialized) return $.Deferred().resolve().promise();

            var d = $.Deferred();

            if (_id && _id != 0) {
                ajaxGet(`/api/WorkflowDefinition/GetSingle/${_id}`)
                    .then(function (data) {
                        var dbPayload = safeParseJson(data.workflowNodes, null);

                        if (dbPayload) {
                            setPayloadBoxObject(dbPayload);

                            // nếu muốn, đồng bộ ngược từ payload về state để UI phản ánh đúng DB
                            hydrateStateFromPayload(dbPayload);
                        } else {
                            var fallbackPayload = buildPayloadObjectFromState();
                            setPayloadBoxObject(fallbackPayload);
                        }

                        payloadInitialized = true;
                        refreshGrid();
                        d.resolve();
                    })
                    .fail(function () {
                        var fallbackPayload = buildPayloadObjectFromState();
                        setPayloadBoxObject(fallbackPayload);
                        payloadInitialized = true;
                        refreshGrid();
                        d.resolve();
                    });
            } else {
                var initPayload = buildPayloadObjectFromState();
                setPayloadBoxObject(initPayload);
                payloadInitialized = true;
                refreshGrid();
                d.resolve();
            }

            return d.promise();
        }

        function syncPayloadBoxFromCurrentState() {
            if (!payloadInitialized) return;

            var current = getPayloadBoxObject() || {};
            var latest = buildPayloadObjectFromState();

            current.workflowDefinition = latest.workflowDefinition;
            current.workflowNodes = latest.workflowNodes;
            current.workflowTransitions = latest.workflowTransitions;
            current.runtimeState = latest.runtimeState;

            setPayloadBoxObject(current);
            refreshGrid();
        }
                $(function () {
            initWorkflowForm();
            initNodeForm();
            initTransitionForm();


            initButtons();
            initTree();
            initToolboxDrag();
            initGrid();
            renderTransitionPreview();

            initPayloadBoxOnce().then(function () {
                initTransitionGrid();
            });
        });
    </script>

 @page "{pageNum:int?}/{guid}"
@model WorkflowDefinition_FormModel
@{


}




<style>


    * {
        box-sizing: border-box
    }

    body {
        font-family: Segoe UI, sans-serif;
        background: var(--c-f5f7fb);
        margin: 0
    }

    .title {
        font-size: 24px;
        font-weight: 700;
        margin: 12px
    }
    /* ✅ NEW: horizontal scroll layout */
    .layout {
        display: flex;
        flex-direction: column; /* đổi từ row -> column */

        gap: 16px;
        padding: 12px;
        overflow-y: auto;
        overflow-x: hidden;
        width: 100%;
    }

    .card-h-last {
        min-width: 600px; /* transition bigger */
    }




    .card-h-title {
        font-size: 15px;
        font-weight: 700;
        color: var(--c-1e293b)
    }

    .card-h-sub {
        font-size: 12px;
        color: var(--c-64748b)
    }

    .card-h {
        min-width: 600px;
        background: var(--c-ffffff);
        border: 1px solid var(--c-e6ebf3);
        border-radius: 16px;
        box-shadow: 0 6px 18px var(--c-rgba-0-0-0-05);
        display: flex;
        flex-direction: row; /* đổi từ column -> row */

        overflow: hidden;
    }


    .card-h-header {
        width: 160px; /* vùng title */
        min-width: 160px;
        padding: 14px 18px;
        border-bottom: none;
        border-right: 1px solid var(--c-edf2f7);
        background: linear-gradient(var(--c-ffffff),var(--c-f9fbff));
        display: flex;
        flex-direction: column;
        justify-content: center;
    }


    .card-h-body {
        flex: 1;
        padding: 14px;
        overflow: auto;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .toolbox {
        display: grid;
        gap: 10px
    }


    .tool-item {
        border: 1px solid var(--c-dbe7ff);
        background: var(--c-f6faff);
        border-radius: 14px;
        padding: 12px;
        cursor: grab;
    }

        .tool-item:hover {
            background: var(--c-eef4ff);
            border-color: var(--c-3b82f6);
        }


    #treeWorkflow {
        border: 1px solid var(--c-e2e8f0);
        border-radius: 12px;
        min-height: 450px;
        background: var(--c-ffffff);
        padding: 8px;
    }

    .json-box {
        background: var(--c-020617);
        color: var(--c-38bdf8);
        border-radius: 12px;
        padding: 12px;
        font-size: 12px;
        max-height: 250px;
        overflow: auto;
    }

    .node-json-editor {
        border: 1px solid var(--c-dbe0ea);
        background: var(--c-f8fafc);
        border-radius: 12px;
        padding: 10px;
    }

    .toolbar, .mini-row {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    /* scrollbar đẹp */
    .layout::-webkit-scrollbar {
        height: 8px
    }

    .layout::-webkit-scrollbar-thumb {
        background: var(--c-cbd5f5);
        border-radius: 6px
    }


    .jstree-clicked {
        background: var(--c-e0f2fe) !important
    }



    * {
        box-sizing: border-box
    }


    .draw-container {
        display: grid;
        grid-template-columns: 380px 1fr;
        height: 80%;
        overflow: hidden;
    }


    .toolbar {
        min-height: 60px;
        border-bottom: 1px solid var(--border);
        background: var(--c-ffffff);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 16px;
        gap: 12px;
        flex-wrap: wrap;
    }

    .toolbar-left, .toolbar-right {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .title {
        font-size: 20px;
        font-weight: 700;
        margin: 0 0 6px 0;
    }

    .sub {
        font-size: 13px;
        color: var(--muted);
        line-height: 1.5;
        margin-bottom: 14px;
    }
    /*
                .card-h {
                    background: var(--panel);
                    border: 1px solid var(--border);
                    border-radius: 14px;
                    padding: 12px;
                    margin-bottom: 12px;
                }

                    .card-h h3 {
                        margin: 0 0 10px 0;
                        font-size: 14px;
                    } */


    .card-h-in-frame {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 12px;
        margin-bottom: 12px;
    }


        .card-h-in-frame .header-in-frame {
            margin: 0 0 10px 0;
            font-size: 12px;
        }


    .badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 10px;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: var(--c-ffffff);
        font-size: 12px;
        color: var(--c-334155);
    }

    .legend-row {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
        font-size: 13px;
    }

   

  

    .btn-row {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 10px;
    }

     #canvas_@ViewData["RandomNumber"].ToString() { 
            position: relative;
            min-width: 1400px;
            min-height: 760px;
            background: linear-gradient(to right, var(--c-rgba-203-213-225-35) 1px, transparent 1px), linear-gradient(to bottom, var(--c-rgba-203-213-225-35) 1px, transparent 1px);
            background-size: 24px 24px;
            background-color: var(--c-ffffff);
            border: 1px solid var(--border);
            border-radius: 18px;
            box-shadow: 0 10px 28px var(--c-rgba-15-23-42-0-06);
            overflow:  auto;
            }

    
    .layer-label {
        position: absolute;
        top: 14px;
        font-size: 12px;
        color: var(--c-64748b);
        background: var(--c-f8fafc);
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 4px 10px;
        z-index: var(--z-index-low);
    }


    .note {
        font-size: 12px;
        color: var(--muted);
        line-height: 1.5;
    }

    .status-ok {
        color: var(--c-15803d);
    }

    code {
        background: var(--c-f8fafc);
        border: 1px solid var(--c-e2e8f0);
        padding: 2px 6px;
        border-radius: 6px;
    }

    .page {
        display: grid;
        grid-template-columns: 240px 1fr 430px;
        height: 100vh;
    }

  
    .sidebarHint {
        font-size: 12px;
        color: var(--c-64748b);
        line-height: 1.5;
        margin-bottom: 12px;
    }

    

    .mainPane {
        padding: 14px;
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .toolbar {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 10px;
    }

    .btn {
        border: 1px solid var(--c-cfd6df);
        background: var(--c-ffffff);
        border-radius: 10px;
        padding: 8px 12px;
        cursor: pointer;
        font-size: 13px;
    }

        .btn:hover {
            background: var(--c-f8fafc);
        }

    .legend {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 10px;
    }

    
    .canvas {
        position: relative;
        flex: 1;
        border: 1px solid var(--c-dbe2ea);
        border-radius: 16px;
        background: linear-gradient(to right, var(--c-rgba-0-0-0-04) 1px, transparent 1px), linear-gradient(to bottom, var(--c-rgba-0-0-0-04) 1px, transparent 1px), var(--c-ffffff);
        background-size: 24px 24px;
        overflow: hidden;
        min-height: 420px;
    }

        .canvas.dragOver {
            background: linear-gradient(to right, var(--c-rgba-59-130-246-08) 1px, transparent 1px), linear-gradient(to bottom, var(--c-rgba-59-130-246-08) 1px, transparent 1px), var(--c-eff6ff);
            background-size: 24px 24px;
        }

    .rightPane {
        border-left: 1px solid var(--c-dbe2ea);
        background: var(--c-ffffff);
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .panelHeader {
        padding: 14px 16px;
        border-bottom: 1px solid var(--c-eef2f7);
        font-weight: 700;
    }

    .panelBody {
        padding: 12px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        min-height: 0;
        flex: 1;
    }

    .statusBar {
        font-size: 12px;
        color: var(--c-475569);
    }

    .sectionTitle {
        font-size: 12px;
        font-weight: 700;
        color: var(--c-475569);
        margin-top: 4px;
    }

    .infoBox {
        border: 1px solid var(--c-e5e7eb);
        border-radius: 12px;
        padding: 12px;
        background: var(--c-fafafa);
        font-size: 12px;
        line-height: 1.5;
        max-height: 220px;
        overflow: auto;
        white-space: pre-wrap;
    }

    .node {
        position: absolute;
        width: 200px;
        min-height: 80px;
        padding: 10px 12px;
        border-radius: 14px;
        background: var(--c-ffffff);
        border: 2px solid var(--c-cbd5e1);
        box-shadow: 0 8px 18px var(--c-rgba-0-0-0-08);
        cursor: move;
        user-select: none;
        transition: all .15s ease;
    }

        .node:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 22px var(--c-rgba-0-0-0-12);
        }

        .node.selected {
            box-shadow: 0 0 0 4px var(--c-rgba-37-99-235-12), 0 10px 24px var(--c-rgba-0-0-0-12);
            border-color: var(--c-2563eb);
        }

        .node.activeNode {
            border-color: var(--c-2563eb);
            background: var(--c-eff6ff);
        }

        .node.completedNode {
            border-color: var(--c-16a34a);
            background: var(--c-f0fdf4);
        }

        .node.pendingNode {
            border-color: var(--c-d97706);
            background: var(--c-fff7ed);
        }

        .node.allowLoopNode::after {
            content: "↻";
            position: absolute;
            top: -8px;
            right: -8px;
            width: 24px;
            height: 24px;
            border-radius: 999px;
            background: var(--c-fb923c);
            color: var(--c-ffffff);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            box-shadow: 0 4px 10px var(--c-rgba-0-0-0-15);
        }
    /* base node vẫn giữ */
    .node {
        position: absolute;
        min-width: 140px;
        padding: 10px;
        border-radius: 8px;
        background: var(--c-ffffff);
        border: 1px solid var(--c-cccccc);
        text-align: center;
        transition: all 0.2s ease;
    }


        .node.flow-start {
            background-color: var(--c-rgba-34-197-94-0-1);
            border: 2px solid var(--c-22c55e);
            color: var(--c-166534);
        }

        .node.flow-end {
            background-color: var(--c-rgba-239-68-68-0-1);
            border: 2px solid var(--c-ef4444);
            color: var(--c-7f1d1d);
        }


        .node.flow-start,
        .node.flow-end {
            width: 130px;
            height: 130px;
            border-radius: 50%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 12px;
            box-sizing: border-box;
        }



    .nodeTitle {
        font-size: 15px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .nodeMeta {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    .meta {
        display: inline-flex;
        align-items: center;
        height: 22px;
        padding: 0 8px;
        border-radius: 999px;
        font-size: 11px;
        border: 1px solid var(--c-dbe2ea);
        background: var(--c-f8fafc);
        color: var(--c-334155);
    }

    .flow-both {
        background: var(--c-f8fafc);
    }

    .flow-quotation {
        background: var(--c-ecfeff);
        border-color: var(--c-a5f3fc);
        color: var(--c-155e75);
    }

    .flow-policy {
        background: var(--c-f5f3ff);
        border-color: var(--c-c4b5fd);
        color: var(--c-5b21b6);
    }

   

    .aLabel {
        background: var(--c-rgba-255-255-255-94);
        border: 1px solid var(--c-e5e7eb);
        border-radius: 999px;
        padding: 2px 8px;
        font-size: 11px;
        color: var(--c-334155);
    }
</style>
<body>
    <div class="title">Workflow Designer</div>
    <div class="dExForm">
        <div class="sub">
        </div>

        <div class="layout">
            <!-- TOOLBOX -->
            <div class="card-h">
                <div class="card-h-header">
                    <div class="card-h-title">Toolbox</div>
                    <div class="card-h-sub">Drag item</div>
                </div>
                <div class="card-h-body">
                    <div class="toolbox">
                        <div class="tool-item" draggable="true" data-type="department" data-text="New Department">
                            <div class="name">Department</div>
                            <div class="desc">Ví dụ FO / TS / UW / LMKT / PM</div>
                        </div>
                    </div>

                    
                    <div>
                        <div class="section-title">Payload Preview</div>
                        <div id="payloadBox_@Convert.ToInt32(ViewData["Id"])" class="json-box"></div>
                    </div>
                </div>
            </div>

            <!-- TREE -->
            <div class="card-h">
                <div class="card-h-header">
                    <div class="card-h-title">Tree Designer</div>
                    <div class="card-h-sub">jsTree</div>
                </div>
                <div class="card-h-body">
                    <div class="section-title">Workflow Header</div>
                    <div class="toolbar" style="margin-top:12px;">
                        <div id="btnAddRoot_@Convert.ToInt32(ViewData["Id"])"></div>
                        <div id="btnAddChild_@Convert.ToInt32(ViewData["Id"])"></div>
                        <div id="btnDelete_@Convert.ToInt32(ViewData["Id"])"></div>
                        <div id="btnExpand_@Convert.ToInt32(ViewData["Id"])"></div>
                        <div id="btnCollapse_@Convert.ToInt32(ViewData["Id"])"></div>
                    </div>
                    <div style="background-color: antiquewhite; min-height:500px;">
                        <div id="treeWorkflow_@Convert.ToInt32(ViewData["Id"])"></div>

                    </div>
                </div>
            </div>

            <!-- NODE EDITOR -->
            <div class="card-h">
                <div class="card-h-header">
                    <div class="card-h-title">Node Review</div>
                    <div class="card-h-sub">Change node properties</div>
                </div>
                <div class="card-h-body">
                    <div id="nodeForm_@Convert.ToInt32(ViewData["Id"])"></div>

                    <div class="section-title">Node JSON Raw</div>
                    <textarea id="nodeJsonEditor_@Convert.ToInt32(ViewData["Id"])" class="node-json-editor" placeholder="Select node to edit raw JSON..."></textarea>

                    <div class="mini-row">
                        <div id="btnRefreshNodeJson_@Convert.ToInt32(ViewData["Id"])"></div>
                        <div id="btnApplyNodeJson_@Convert.ToInt32(ViewData["Id"])"></div>
                        <div id="btnApplyNodeForm_@Convert.ToInt32(ViewData["Id"])"></div>
                        <div id="btnCreateflow_@Convert.ToInt32(ViewData["Id"])"></div>
                        <div id="btnBuild_@Convert.ToInt32(ViewData["Id"])"></div>
                    </div>
                </div>
            </div>
      @*   </div>
        <div class="dExForm"> *@
            <!-- TRANSITION + PAYLOAD -->
            <div class="card-h card-h-last" style="">
                <div class="card-h-header">
                    <div class="card-h-title">Transition / Loop / Payload Review</div>
                    <div class="card-h-sub">Preview</div>
                </div>
                <div class="card-h-body">
                    <div style="">
                        <div>
                            <div class="section-title">Transition Editor</div>

                            <div class="condition-builder-card-h">
                                <div class="section-title">Mini Condition Builder</div>
                                <div id="conditionBuilderForm_@Convert.ToInt32(ViewData["Id"])"></div>

                                <div class="mini-row" style="margin-top:10px;">
                                    <div id="btnAddConditionRule_@Convert.ToInt32(ViewData["Id"])"></div>
                                    <div id="btnGenerateConditionJson_@Convert.ToInt32(ViewData["Id"])"></div>
                                    <div id="btnWrapNotCondition_@Convert.ToInt32(ViewData["Id"])"></div>
                                    <div id="btnClearConditionBuilder_@Convert.ToInt32(ViewData["Id"])"></div>
                                </div>

                                <div class="section-title" style="margin-top:10px;">Condition Preview</div>
                                <div id="conditionPreviewBox_@Convert.ToInt32(ViewData["Id"])" class="condition-builder-preview json-box">{}</div>
                                <div class="condition-builder-note">
                                    Chọn field/operator/value ở form mini, bấm Add Rule hoặc Generate JSON rồi review lại tại ô Condition JSON bên dưới trước khi Add Transition.
                                </div>
                            </div>

                            <div id="transitionForm_@Convert.ToInt32(ViewData["Id"])"></div>
                            <div class="mini-row" style="margin-top:10px;">
                                <div id="btnAddTransition_@Convert.ToInt32(ViewData["Id"])"></div>
                                <div id="btnResetTransitionForm_@Convert.ToInt32(ViewData["Id"])"></div>
                            </div>
                        </div>

                        <!--  <div>
                             <div class="section-title">Transition Preview</div>
                             <div id="transitionPreview" class="transition-list_@Convert.ToInt32(ViewData["Id"])"></div>
                         </div> -->


                    </div>

                </div>
            </div>

            <!-- TRANSITION GRID card-h -->
            <div class="card-h card-h-last" style="">
                <div class="card-h-header">
                    <div class="card-h-title">Transition List</div>
                    <div class="card-h-sub">Preview & Manage</div>
                </div>
                <div class="card-h-body">
                    <div class="section-title">Flat Node Preview</div>
                    <div id="nodeGrid_@Convert.ToInt32(ViewData["Id"])"></div>

                    <div class="section-title" style="margin-top:12px;">Transition Grid</div>
                    <div id="transitionGrid_@Convert.ToInt32(ViewData["Id"])"></div>
                </div>
            </div>


            
            <div class="card-h card-h-last" style="min-height:600px;">
                <div class="card-h-header">
                    <div class="card-h-title">Workflow Pallete</div>
                    <div class="card-h-sub">Drag & Connect nodes</div>
                </div>
                <div class="card-h-body">
                <div class="canvas-wrap">
                        <div class="title">Design Workflow</div>
                        <div class="palette">
                            <div class="paletteItem" data-template='...'>...</div>
                        </div>

                </div>

                </div>
            </div>

            <div class="card-h card-h-last" style="min-height:600px;">
                <div class="card-h-header">
                    <div class="card-h-title">Workflow Diagram</div>
                    <div class="card-h-sub">Drag & Connect nodes</div>
                </div>
                <div class="card-h-body">
                    <div class="canvas-wrap">
                        <div id="canvas_@(ViewData["RandomNumber"].ToString())" class="canvas"></div>
                    </div>

                </div>
            </div>
            <div class="card-h card-h-last" style="min-height:600px;">
                <div class="card-h-header">
                    <div class="card-h-title">Json diagram</div>
                </div>
                <div class="card-h-body">
                    <button id="btnRender_@Convert.ToInt32(ViewData["Id"])">Draw on diagram</button>
                    <button class="secondary" id="btnUpdate_@Convert.ToInt32(ViewData["Id"])">Save Data</button>
                    <button class="success" id="btnExport_@Convert.ToInt32(ViewData["Id"])">Export JSON</button>
                    <textarea id="jsonInput_@Convert.ToInt32(ViewData["Id"])"></textarea>
                </div>
            </div>
            @* @await Component.InvokeAsync("WorkflowDefinitionDraw_Form", new { pageNum = Convert.ToInt32(ViewData["Id"]) }) *@
        </div>
    </div>

    <script>
        

        // //old Code
        var _id = @Convert.ToInt32(ViewData["Id"]);
        _enums.WorkflowCommand = @Html.Raw(Json.Serialize(ViewData["WorkflowCommand"]))
        var selectedNodeId = null;
        var nodeFormInstance = null;
        // var workflowFormInstance = null;
        var transitionFormInstance = null;
        var transitionGridInstance = null;
        var nodeGridInstance = null;
        var workflowMailTemplateStore = new DevExpress.data.CustomStore({
            key: "id",
            loadMode: "raw",
            load: function () {
                return ajaxGet("/api/MailTemplate/GetAll", null)
                    .then(items => (Array.isArray(items) ? items : []).filter(item =>
                        item.isActive !== false && item.IsActive !== false));
            }
        });
        var workflowNotificationTemplateStore = new DevExpress.data.CustomStore({
            key: "id",
            loadMode: "raw",
            load: function () {
                return ajaxGet("/api/NotificationTemplate/GetAll", null)
                    .then(items => (Array.isArray(items) ? items : []).filter(item =>
                        item.isActive !== false && item.IsActive !== false));
            }
        });
        var dragToolData = null;
        var conditionBuilderInstance = null;
        var conditionRuleState = {
            rootOperator: "AND",
            rules: []
        };
        var runtimeState = {}
        ;
        // var workflowHeader = mainForm.formInstance.option("formData");
        var workflowHeader = null;
        var workflowTreeData = [];
        var transitions = [];
     




        function initNodeForm() {
            $("#nodeForm_@Convert.ToInt32(ViewData["Id"])").dxForm({
                formData: {},
                labelLocation: "top",
                colCount: 2,
                items: [
                    { dataField: "id", label: { text: "Id" }, editorOptions: { readOnly: true } },
                    { dataField: "parent", label: { text: "Parent" }, editorOptions: { readOnly: true } },
                    { dataField: "text", label: { text: "Display Text" } },
                    { dataField: "code", label: { text: "Code" } },
                    {
                        dataField: "type",
                        label: { text: "Type" },
                        editorType: "dxSelectBox",
                        editorOptions: {
                            dataSource: ["department", "actor", "condition", "system"]
                        }
                    },
                    {
                        dataField: "flowType",
                        label: { text: "Node Flow Type" },
                        editorType: "dxSelectBox",
                        editorOptions: {
                            dataSource: _enums.WorkflowType
                        }
                    },
                    {
                        dataField: "orderNo",
                        label: { text: "Order No" },
                        editorType: "dxNumberBox",
                        editorOptions: { min: 0 }
                    },
                    { dataField: "stepRole", label: { text: "Step Role" } },
                    { dataField: "departmentName", label: { text: "Department Name" } },
                    {
                        dataField: "levelNo",
                        label: { text: "Level No" },
                        editorType: "dxNumberBox",
                        editorOptions: { min: 1 }
                    },
                    {
                        dataField: "allowLoop",
                        label: { text: "Allow Loop" },
                        editorType: "dxSwitch"
                    },
                    {
                        dataField: "loopGroup",
                        label: { text: "Loop Group" }
                    },
                    {
                        dataField: "mailTemplateName",

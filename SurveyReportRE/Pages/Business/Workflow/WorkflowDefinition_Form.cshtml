<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: "Segoe UI", Arial, sans-serif;
        background: #f4f6fb;
        color: #1f2937;
    }

    .page {
        padding: 14px;
    }

    .title {
        font-size: 24px;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .sub {
        color: #6b7280;
        margin-bottom: 14px;
    }

    .layout {
        display: grid;
        grid-template-columns: 270px 380px 430px 1fr;
        gap: 14px;
        min-height: calc(100vh - 90px);
    }

    /*    .card {
                    background: #fff;
                    border: 1px solid #e5e7eb;
                    border-radius: 14px;
                    box-shadow: 0 8px 24px rgba(0,0,0,.06);
                    overflow: hidden;
                    display: flex;
                    flex-direction: column;
                    min-height: 0;
                }

                .card-header {
                    padding: 14px 16px;
                    border-bottom: 1px solid #edf0f5;
                } */

    .card-title {
        font-size: 16px;
        font-weight: 700;
    }

    .card-sub {
        font-size: 12px;
        color: #6b7280;
        margin-top: 4px;
    }

    .card-body {
        padding: 14px;
        flex: 1;
        overflow: auto;
        min-height: 0;
    }

    .toolbox {
        display: grid;
        gap: 10px;
    }

    .tool-item {
        border: 1px dashed #9db7ff;
        background: #f4f8ff;
        color: #264b96;
        border-radius: 12px;
        padding: 12px;
        cursor: grab;
        user-select: none;
        transition: .2s ease;
    }

        .tool-item:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(59,130,246,.12);
        }

        .tool-item .name {
            font-weight: 700;
            margin-bottom: 4px;
        }

        .tool-item .desc {
            font-size: 12px;
            color: #52627d;
        }

    .toolbar, .mini-row {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 10px;
    }

    #treeWorkflow {
        border: 1px solid #dbe1ea;
        border-radius: 12px;
        background: #fcfdff;
        min-height: 600px;
        padding: 8px;
    }

    .drop-hint {
        margin-top: 10px;
        font-size: 12px;
        color: #6b7280;
        background: #f9fafb;
        border: 1px solid #eceff5;
        padding: 10px;
        border-radius: 10px;
        line-height: 1.5;
    }

    .section-tit
    le {
        margin: 14px 0 8px 0;
        font-size: 13px;
        font-weight: 700;
        color: #334155;
    }

    .json-box {
        height: 1000px;
        min-height: 200px;
        max-height: 800px;
        overflow: auto;
        border-radius: 12px;
        background: #0f172a;
        color: #dbeafe;
        padding: 12px;
        font-family: Consolas, monospace;
        font-size: 12px;
        white-space: pre-wrap;
        word-break: break-word;
    }

    .node-json-editor {
        width: 100%;
        min-height: 160px;
        resize: vertical;
        border: 1px solid #d8dfeb;
        border-radius: 12px;
        padding: 10px;
        font-family: Consolas, monospace;
        font-size: 12px;
        outline: none;
    }

    .transition-list {
        display: grid;
        gap: 8px;
    }

    .transition-item {
        border: 1px solid #e5e7eb;
        background: #fafbff;
        border-radius: 12px;
        padding: 10px 12px;
    }

    .transition-route {
        font-weight: 700;
        color: #1d4ed8;
        margin-bottom: 6px;
    }

    .transition-meta {
        font-size: 12px;
        color: #475569;
        line-height: 1.5;
    }

    .badge-row {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 6px;
    }

    .badge {
        display: inline-flex;
        align-items: center;
        padding: 3px 8px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        border: 1px solid transparent;
    }

        .badge.q {
            background: #eef4ff;
            color: #1d4ed8;
            border-color: #bfdbfe;
        }

        .badge.pi {
            background: #fff7ed;
            color: #c2410c;
            border-color: #fdba74;
        }

        .badge.both {
            background: #f3f4f6;
            color: #374151;
            border-color: #d1d5db;
        }

        .badge.return {
            background: #fee2e2;
            color: #b91c1c;
            border-color: #fecaca;
        }

        .badge.loop {
            background: #ede9fe;
            color: #6d28d9;
            border-color: #c4b5fd;
        }

        .badge.exit {
            background: #dcfce7;
            color: #15803d;
            border-color: #86efac;
        }

        .badge.user {
            background: #ecfeff;
            color: #0f766e;
            border-color: #99f6e4;
        }

    .legend-box {
        display: grid;
        gap: 6px;
    }

    .legend-item {
        font-size: 12px;
        color: #475569;
    }

    .loop-box {
        border: 1px dashed #c4b5fd;
        background: #faf5ff;
        border-radius: 12px;
        padding: 10px;
        margin-top: 10px;
        font-size: 12px;
        color: #5b21b6;
    }

    .jstree-anchor {
        border-radius: 6px;
        display: inline-flex !important;
        align-items: center;
        gap: 6px;
        max-width: 100%;
    }

    .jstree-clicked {
        background: #dbeafe !important;
        color: #111827 !important;
    }

    .tree-node-wrap {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    .tree-node-text {
        font-weight: 600;
    }

    .tree-node-mini {
        font-size: 10px;
        border-radius: 999px;
        padding: 2px 6px;
        border: 1px solid #ddd;
        background: #fff;
        line-height: 1;
    }

        .tree-node-mini.q {
            color: #1d4ed8;
            border-color: #bfdbfe;
            background: #eff6ff;
        }

        .tree-node-mini.pi {
            color: #c2410c;
            border-color: #fdba74;
            background: #fff7ed;
        }

        .tree-node-mini.both {
            color: #374151;
            border-color: #d1d5db;
            background: #f9fafb;
        }

        .tree-node-mini.loop {
            color: #6d28d9;
            border-color: #c4b5fd;
            background: #f5f3ff;
        }

    .drag-over-zone {
        outline: 2px dashed #60a5fa;
        outline-offset: 2px;
    }

    @@media (max-width: 1680px) {
        .layout {
            grid-template-columns: 270px 380px 1fr;
        }

        .card-last {
            grid-column: 2;
        }
    }

    @@media (max-width: 1280px) {
        .layout {
            grid-template-columns: 1fr;
        }
    }
</style>
<body>
    <div class="title">Workflow Designer</div>
    <div id="form_@(WorkflowDefinitionDraw_FormModel.ModelName)_@Convert.ToInt32(ViewData["Id"])" class="dExForm"></div>
    <div class="page">
        <div class="sub">
        </div>

        <div class="layout">
            <!-- TOOLBOX -->
            <div class="card">
                <div class="card-header">
                    <div class="card-title">Toolbox</div>
                    <div class="card-sub">Drag item</div>
                </div>
                <div class="card-body">
                    <div class="toolbox">
                        <div class="tool-item" draggable="true" data-type="department" data-text="New Department">
                            <div class="name">Department</div>
                            <div class="desc">Ví dụ FO / TS / UW / LMKT / PM</div>
                        </div>
                        @*  <div class="tool-item" draggable="true" data-type="actor" data-text="New Actor">
                            <div class="name">Actor</div>
                            <div class="desc">Ví dụ Client / External / Approver</div>
                        </div>
                        <div class="tool-item" draggable="true" data-type="condition" data-text="New Condition">
                            <div class="name">Condition</div>
                            <div class="desc">Rule node / branching / decision</div>
                        </div>
                        <div class="tool-item" draggable="true" data-type="system" data-text="New System">
                            <div class="name">System</div>
                            <div class="desc">Auto process / service / scheduler</div>
                        </div> *@
                    </div>

                    <div class="section-title">Load Sample</div>
                    <div class="mini-row">
                        <div id="btnSampleQuotation_@Convert.ToInt32(ViewData["Id"])"></div>
                        <div id="btnSamplePolicy_@Convert.ToInt32(ViewData["Id"])"></div>
                        @* <div id="btnSampleLoop_@Convert.ToInt32(ViewData["Id"])"></div> *@
                    </div>
                    <div>
                        <div class="section-title">Payload Preview</div>
                        <div id="payloadBox_@Convert.ToInt32(ViewData["Id"])" class="json-box"></div>
                    </div>
                    @* <div class="section-title">Legend</div> 
                    <div class="legend-box">
                        <div class="legend-item"><span class="badge q">Quotation</span> node/flow dùng cho quotation</div>
                        <div class="legend-item"><span class="badge pi">PolicyIssuance</span> node/flow dùng cho policy issuance</div>
                        <div class="legend-item"><span class="badge both">Both</span> dùng chung</div>
                        <div class="legend-item"><span class="badge return">RETURN</span> flow trả về</div>
                        <div class="legend-item"><span class="badge loop">LOOP</span> flow lặp</div>
                        <div class="legend-item"><span class="badge exit">EXIT</span> flow thoát loop</div>
                        <div class="legend-item"><span class="badge user">UserDecision</span> user tự quyết định thoát loop</div>
                    </div> *@

                    @* <div class="loop-box">
                        Mockup này chưa vẽ line graph thật.
                        <br>Phần “vòng tròn” đang thể hiện qua:
                        <br>- transition `From -> To`
                        <br>- badge `LOOP`
                        <br>- self-loop hoặc loop-group
                        <br>- nút thoát `EXIT`
                    </div>

                    <div class="drop-hint">
                        Cách test nhanh:
                        <br>1. Chọn Workflow Flow Type ở panel giữa
                        <br>2. Kéo object từ toolbox sang tree
                        <br>3. Click node để sửa data / flow type
                        <br>4. Tạo transition ở panel bên phải
                        <br>5. Thử case loop với UserDecision
                        <br>6. Xem payload JSON cuối màn hình
                    </div> *@
                </div>
            </div>

            <!-- TREE -->
            <div class="card">
                <div class="card-header">
                    <div class="card-title">Tree Designer</div>
                    <div class="card-sub">jsTree</div>
                </div>
                <div class="card-body">
                    <div class="section-title">Workflow Header</div>
                    <div id="workflowForm_@Convert.ToInt32(ViewData["Id"])"></div>

                    <div class="toolbar" style="margin-top:12px;">
                        <div id="btnAddRoot_@Convert.ToInt32(ViewData["Id"])"></div>
                        <div id="btnAddChild_@Convert.ToInt32(ViewData["Id"])"></div>
                        @* <div id="btnRename_@Convert.ToInt32(ViewData["Id"])"></div> *@
                        <div id="btnDelete_@Convert.ToInt32(ViewData["Id"])"></div>
                        <div id="btnExpand_@Convert.ToInt32(ViewData["Id"])"></div>
                        <div id="btnCollapse_@Convert.ToInt32(ViewData["Id"])"></div>
                    </div>

                    <div id="treeWorkflow_@Convert.ToInt32(ViewData["Id"])"></div>
                </div>
            </div>

            <!-- NODE EDITOR -->
            <div class="card">
                <div class="card-header">
                    <div class="card-title">Node Review</div>
                    <div class="card-sub">Change node properties</div>
                </div>
                <div class="card-body">
                    <div id="nodeForm_@Convert.ToInt32(ViewData["Id"])"></div>

                    <div class="section-title">Node JSON Raw</div>
                    <textarea id="nodeJsonEditor_@Convert.ToInt32(ViewData["Id"])" class="node-json-editor" placeholder="Select node to edit raw JSON..."></textarea>

                    <div class="mini-row">
                        <div id="btnRefreshNodeJson_@Convert.ToInt32(ViewData["Id"])"></div>
                        <div id="btnApplyNodeJson_@Convert.ToInt32(ViewData["Id"])"></div>
                        <div id="btnApplyNodeForm_@Convert.ToInt32(ViewData["Id"])"></div>
                        <div id="btnCreateflow_@Convert.ToInt32(ViewData["Id"])"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="page">
            <!-- TRANSITION + PAYLOAD -->
            <div class="card card-last" style="width: 1200px;">
                <div class="card-header">
                    <div class="card-title">Transition / Loop / Payload Review</div>
                    <div class="card-sub">Preview</div>
                </div>
                <div class="card-body">
                    <div style="display:grid;grid-template-columns:420px 1fr;gap:14px;">
                        <div>
                            <div class="section-title">Transition Editor</div>
                            <div id="transitionForm_@Convert.ToInt32(ViewData["Id"])"></div>
                            <div class="mini-row" style="margin-top:10px;">
                                <div id="btnAddTransition_@Convert.ToInt32(ViewData["Id"])"></div>
                                <div id="btnResetTransitionForm_@Convert.ToInt32(ViewData["Id"])"></div>
                            </div>
                        </div>

                        <!--  <div>
                             <div class="section-title">Transition Preview</div>
                             <div id="transitionPreview" class="transition-list_@Convert.ToInt32(ViewData["Id"])"></div>
                         </div> -->


                    </div>

                    <div class="section-title">Flat Node Preview</div>
                    <div id="nodeGrid_@Convert.ToInt32(ViewData["Id"])"></div>
                    <div id="transitionGrid_@Convert.ToInt32(ViewData["Id"])"></div>
                </div>
            </div>
        </div>
    </div>


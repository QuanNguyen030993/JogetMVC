        function initTree() {
            if ($("#treeWorkflow_@Convert.ToInt32(ViewData["Id"])").jstree(true)) {
                $("#treeWorkflow_@Convert.ToInt32(ViewData["Id"])").jstree(true).destroy();
            }

            $("#treeWorkflow_@Convert.ToInt32(ViewData["Id"])")
                .off("changed.jstree")
                .off("dblclick.jstree")
                .on("changed.jstree", function (e, data) {
                    if (!data || !data.selected || !data.selected.length) return;
                    selectedNodeId = data.selected[0];
                    var node = data.instance.get_node(selectedNodeId);
                    bindNodeToEditors(node);
                })
                .on("dblclick.jstree", ".jstree-anchor", function () {
                    var tree = $("#treeWorkflow_@Convert.ToInt32(ViewData["Id"])").jstree(true);
                    var nodeId = $(this).closest("li").attr("id");
                    if (nodeId) tree.edit(nodeId);
                })
                .jstree({
                    core: {
                        check_callback: true,
                        data: workflowTreeData.map(x => ({
                            ...x,
                            text: buildTreeNodeHtml(x)
                        })),
                        themes: { stripes: true }
                    },
                    plugins: ["dnd", "contextmenu", "wholerow"]
                });

            setTimeout(function () {
                var tree = $("#treeWorkflow_@Convert.ToInt32(ViewData["Id"])").jstree(true);
                tree.open_all();
                if (workflowTreeData.length) tree.select_node(workflowTreeData[0].id);
                initDropZoneForTree();
            }, 200);
        }

        function buildTreeNodeHtml(x) {
            var flowClass = x.flowType === "Quotation" ? "q" :
                              x.flowType === "PolicyIssuance" ? "pi" : "both";

            var loopBadge = x.allowLoop ? `<span class="tree-node-mini loop">LOOP</span>` : "";

            return `
                <span class="tree-node-wrap">
                    <span class="tree-node-text">${escapeHtml(x.text)}</span>
                    <span class="tree-node-mini ${flowClass}">${escapeHtml(x.flowType || "Both")}</span>
                    ${loopBadge}
                </span>
            `;
        }

        function initToolboxDrag() {
            $(".tool-item").on("dragstart", function (e) {
                dragToolData = {
                    type: $(this).data("type"),
                    text: $(this).data("text")
                };
                e.originalEvent.dataTransfer.setData("text/plain", JSON.stringify(dragToolData));
            });
        }

        function initDropZoneForTree() {
            var treeContainer = document.getElementById("treeWorkflow_@(Convert.ToInt32(ViewData["Id"]))");

            treeContainer.addEventListener("dragover", function (e) {
                e.preventDefault();
                treeContainer.classList.add("drag-over-zone");
            });

            treeContainer.addEventListener("dragleave", function () {
                treeContainer.classList.remove("drag-over-zone");
            });

            treeContainer.addEventListener("drop", function (e) {
                e.preventDefault();
                treeContainer.classList.remove("drag-over-zone");

                var data = dragToolData;
                try {
                    var raw = e.dataTransfer.getData("text/plain");
                    if (raw) data = JSON.parse(raw);
                } catch (ex) { }

                if (!data) return;

                var targetLi = $(e.target).closest("li");
                var parentId = targetLi.length ? targetLi.attr("id") : "#";

                createNodeFromTool(data, parentId);
            });
        }

        function createNodeFromTool(tool, parentId) {
            var tree = $("#treeWorkflow_@Convert.ToInt32(ViewData["Id"])").jstree(true);
            var newId = generateNodeId();
            var parentNode = parentId === "#" ? null : tree.get_node(parentId);

            var currentWorkflowFlow = workflowFormInstance.option("formData").flowType || "Both";

            var nodeData = {
                id: newId,
                text: tool.text || "New Node",
                type: tool.type || "department",
                code: "",
                orderNo: getNextOrderNo(parentId),
                stepRole: "",
                departmentName: "",
                levelNo: parentNode ? ((parentNode.original.levelNo || 1) + 1) : 1,
                flowType: currentWorkflowFlow === "Both" ? "Both" : currentWorkflowFlow,
                allowLoop: false,
                loopGroup: "",
                        x: 0,
        y: 0
            };

            tree.create_node(parentId, {
                ...nodeData,
                text: buildTreeNodeHtml(nodeData)
            }, "last", function (node) {
                tree.open_node(parentId);
                tree.deselect_all();
                tree.select_node(node);
                syncTreeDataFromJsTree();
            });
        }

        function bindNodeToEditors(node) {
            var original = node.original || {};
            var formData = {
                id: node.id,
                parent: node.parent === "#" ? null : node.parent,
                text: extractPlainTextFromNode(node.id),
                type: original.type || "",
                code: original.code || "",
                orderNo: original.orderNo || 0,
                stepRole: original.stepRole || "",
                departmentName: original.departmentName || "",
                levelNo: original.levelNo || 1,
                flowType: original.flowType || "Both",
                allowLoop: !!original.allowLoop,
                loopGroup: original.loopGroup || "",
                x: original.x ?? null,
                y: original.y ?? null
            };

            nodeFormInstance.option("formData", formData);
            $("#nodeJsonEditor_@Convert.ToInt32(ViewData["Id"])").val(JSON.stringify(formData, null, 2));

            var tf = transitionFormInstance.option("formData") || {};
            if (!tf.fromNodeId) {
                transitionFormInstance.option("formData", {
                    ...getEmptyTransition(node.id),
                    flowType: formData.flowType || "Both"
                });
            }
        }

        function saveFlow() {
            var payload = getPayloadBoxObject();

            if (!payload) {
                return notify("Payload JSON is invalid", "error");
            }

            var workflowData = {
                id: _id || payload.workflowDefinition?.id || 0,
                workflowCode: payload.workflowDefinition?.workflowCode || "",
                workflowName: payload.workflowDefinition?.workflowName || "",
                flowType: payload.workflowDefinition?.flowType || "Both",
                versionNo: payload.workflowDefinition?.versionNo ?? 1,
                isActive: payload.workflowDefinition?.isActive ?? true,
                workflowNodes: JSON.stringify(payload)
            };

            var dataGrid = $(`#dataGrid_WorkflowDefinition`).dxDataGrid("instance");
            var ds = dataGrid.getDataSource();
            var store = ds.store();

            if (!_id || _id == 0) {
                store.insert(workflowData)
                    .done(function () {
                        ds.reload();
                        DevExpress.ui.notify("Saved successfully", "success", 2000);
                    })
                    .fail(function (error) {
                        console.error(error);
                        DevExpress.ui.notify("Save failed", "error", 2000);
                    });
            } else {
                store.update(_id, workflowData)
                    .done(function () {
                        ds.reload();
                        DevExpress.ui.notify("Saved successfully", "success", 2000);
                    })
                    .fail(function (error) {
                        console.error(error);
                        DevExpress.ui.notify("Save failed", "error", 2000);
                    });
            }
        }



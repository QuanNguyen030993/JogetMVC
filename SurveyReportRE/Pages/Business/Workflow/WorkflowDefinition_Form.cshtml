            if (!transitionFormInstance) return;
            var ds = workflowTreeData.map(x => ({ id: x.id, text:`${x.text} (${x.id})` }));

            transitionFormInstance.itemOption("fromNodeId", "editorOptions", {
                dataSource: ds,
                valueExpr: "id",

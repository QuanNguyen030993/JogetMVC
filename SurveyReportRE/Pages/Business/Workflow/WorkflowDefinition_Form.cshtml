        function initTree() {
            if ($("#treeWorkflow").jstree(true)) {
                $("#treeWorkflow").jstree(true).destroy();
            }

            $("#treeWorkflow")
                .off("changed.jstree")
                .off("dblclick.jstree")
                .on("changed.jstree", function (e, data) {
                    if (!data || !data.selected || !data.selected.length) return;
                    selectedNodeId = data.selected[0];
                    var node = data.instance.get_node(selectedNodeId);
                    bindNodeToEditors(node);
                })
                .on("dblclick.jstree", ".jstree-anchor", function () {
                    var tree = $("#treeWorkflow").jstree(true);
                    var nodeId = $(this).closest("li").attr("id");
                    if (nodeId) tree.edit(nodeId);
                })
                .jstree({
                    core: {
                        check_callback: true,
                        data: workflowTreeData.map(x => ({
                            ...x,
                            text: buildTreeNodeHtml(x)
                        })),
                        themes: { stripes: true }
                    },
                    plugins: ["dnd", "contextmenu", "wholerow"]
                });

            setTimeout(function () {
                var tree = $("#treeWorkflow").jstree(true);
                tree.open_all();
                if (workflowTreeData.length) tree.select_node(workflowTreeData[0].id);
                initDropZoneForTree();
            }, 200);
        }

        function buildTreeNodeHtml(x) {
            var flowClass = x.flowType === "Quotation" ? "q" :
                              x.flowType === "PolicyIssuance" ? "pi" : "both";

            var loopBadge = x.allowLoop ? `<span class="tree-node-mini loop">LOOP</span>` : "";

            return `
                <span class="tree-node-wrap">
                    <span class="tree-node-text">${escapeHtml(x.text)}</span>
                    <span class="tree-node-mini ${flowClass}">${escapeHtml(x.flowType || "Both")}</span>
                    ${loopBadge}
                </span>
            `;
        }

        function initToolboxDrag() {
            $(".tool-item").on("dragstart", function (e) {
                dragToolData = {
                    type: $(this).data("type"),
                    text: $(this).data("text")
                };
                e.originalEvent.dataTransfer.setData("text/plain", JSON.stringify(dragToolData));
            });
        }

        function initDropZoneForTree() {
            var treeContainer = document.getElementById("treeWorkflow");

            treeContainer.addEventListener("dragover", function (e) {
                e.preventDefault();
                treeContainer.classList.add("drag-over-zone");
            });

            treeContainer.addEventListener("dragleave", function () {
                treeContainer.classList.remove("drag-over-zone");
            });

            treeContainer.addEventListener("drop", function (e) {
                e.preventDefault();
                treeContainer.classList.remove("drag-over-zone");

                var data = dragToolData;
                try {
                    var raw = e.dataTransfer.getData("text/plain");
                    if (raw) data = JSON.parse(raw);
                } catch (ex) { }

                if (!data) return;

                var targetLi = $(e.target).closest("li");
                var parentId = targetLi.length ? targetLi.attr("id") : "#";

                createNodeFromTool(data, parentId);
            });
        }

        function createNodeFromTool(tool, parentId) {
            var tree = $("#treeWorkflow").jstree(true);
            var newId = generateNodeId();
            var parentNode = parentId === "#" ? null : tree.get_node(parentId);

            var currentWorkflowFlow = workflowFormInstance.option("formData").flowType || "Both";

            var nodeData = {
                id: newId,
                text: tool.text || "New Node",
                type: tool.type || "department",
                code: "",
                orderNo: getNextOrderNo(parentId),
                stepRole: "",
                departmentName: "",
                levelNo: parentNode ? ((parentNode.original.levelNo || 1) + 1) : 1,
                flowType: currentWorkflowFlow === "Both" ? "Both" : currentWorkflowFlow,
                allowLoop: false,
                loopGroup: ""
            };

            tree.create_node(parentId, {
                ...nodeData,
                text: buildTreeNodeHtml(nodeData)
            }, "last", function (node) {
                tree.open_node(parentId);
                tree.deselect_all();
                tree.select_node(node);
                syncTreeDataFromJsTree();
            });
        }

        function bindNodeToEditors(node) {
            var original = node.original || {};
            var formData = {
                id: node.id,
                parent: node.parent === "#" ? null : node.parent,
                text: extractPlainTextFromNode(node.id),
                type: original.type || "",
                code: original.code || "",
                orderNo: original.orderNo || 0,
                stepRole: original.stepRole || "",
                departmentName: original.departmentName || "",
                levelNo: original.levelNo || 1,
                flowType: original.flowType || "Both",
                allowLoop: !!original.allowLoop,
                loopGroup: original.loopGroup || ""
            };

            nodeFormInstance.option("formData", formData);
            $("#nodeJsonEditor").val(JSON.stringify(formData, null, 2));

            var tf = transitionFormInstance.option("formData") || {};
            if (!tf.fromNodeId) {
                transitionFormInstance.option("formData", {
                    ...getEmptyTransition(node.id),
                    flowType: formData.flowType || "Both"
                });
            }
        }

        function saveFlow(){
            var json = JSON.parse($("#payloadBox").text() || "{}");
            var workflowData = new Object();
            workflowData = json.workflowDefinition;
            workflowData.workflowNodes = JSON.stringify(json.workflowNodes);
            var dataGrid = $(`#dataGrid_WorkflowDefinition`).dxDataGrid().dxDataGrid("instance");
            var ds  = dataGrid.option("dataSource");
            var store = ds.store();

            store.insert(workflowData)
                .done(function (result) {
                    ds.reload();
                    DevExpress.ui.notify("Saved successfully", "success", 2000);
                })
                .fail(function (error) {
                    console.error(error);
                    DevExpress.ui.notify("Save failed", "error", 2000);
                });

        }


        function applyFormToSelectedNode() {
            var tree = $("#treeWorkflow").jstree(true);
            if (!selectedNodeId) return notify("Please select node first", "warning");

            var fd = nodeFormInstance.option("formData");
            var node = tree.get_node(selectedNodeId);
            if (!node) return;

            node.original.type = fd.type || "";
            node.original.code = fd.code || "";
            node.original.orderNo = fd.orderNo || 0;
            node.original.stepRole = fd.stepRole || "";
            node.original.departmentName = fd.departmentName || "";
            node.original.levelNo = fd.levelNo || 1;
            node.original.flowType = fd.flowType || "Both";
            node.original.allowLoop = !!fd.allowLoop;
            node.original.loopGroup = fd.loopGroup || "";

            var newHtml = buildTreeNodeHtml({
                text: fd.text || extractPlainTextFromNode(selectedNodeId),
                flowType: fd.flowType || "Both",
                allowLoop: !!fd.allowLoop
            });

            tree.rename_node(node, newHtml);
            syncTreeDataFromJsTree(fd.text || extractPlainTextFromNode(selectedNodeId));
            notify("Node updated", "success");
        }

        function applyJsonToSelectedNode() {
            var tree = $("#treeWorkflow").jstree(true);
            if (!selectedNodeId) return notify("Please select node first", "warning");

            try {
                var json = JSON.parse($("#nodeJsonEditor").val() || "{}");
                var node = tree.get_node(selectedNodeId);
                if (!node) return;

                node.original.type = json.type || "";
                node.original.code = json.code || "";
                node.original.orderNo = json.orderNo || 0;
                node.original.stepRole = json.stepRole || "";
                node.original.departmentName = json.departmentName || "";
                node.original.levelNo = json.levelNo || 1;
                node.original.flowType = json.flowType || "Both";
                node.original.allowLoop = !!json.allowLoop;
                node.original.loopGroup = json.loopGroup || "";

                var plainText = json.text || extractPlainTextFromNode(selectedNodeId);
                tree.rename_node(node, buildTreeNodeHtml({
                    text: plainText,
                    flowType: json.flowType || "Both",
                    allowLoop: !!json.allowLoop
                }));

                syncTreeDataFromJsTree(plainText);
                notify("Node JSON applied", "success");
            } catch (err) {
                notify("Invalid JSON", "error");
            }
        }

        function refreshNodeJson() {
            var tree = $("#treeWorkflow").jstree(true);
            if (!selectedNodeId) return notify("Please select node first", "warning");
            var node = tree.get_node(selectedNodeId);
            bindNodeToEditors(node);
            notify("Node JSON refreshed", "success");
        }

        function addTransition() {
            var fd = transitionFormInstance.option("formData");

            if (!fd.fromNodeId || !fd.toNodeId) {
                return notify("Please choose From Node and To Node", "warning");
            }
            if (!fd.actionCode) {
                return notify("Action Code is required", "warning");
            }

            transitions.push({
                fromNodeId: fd.fromNodeId,
                toNodeId: fd.toNodeId,
                actionCode: fd.actionCode,
                actionName: fd.actionName || fd.actionCode,
                flowType: fd.flowType || "Both",
                isReturn: !!fd.isReturn,
                isLoop: !!fd.isLoop,
                loopGroup: fd.loopGroup || "",
                loopExitMode: fd.loopExitMode || "None",
                maxLoopCount: fd.maxLoopCount || null,
                isExitTransition: !!fd.isExitTransition,
                userDecisionLabel: fd.userDecisionLabel || "",
                conditionJson: fd.conditionJson || ""
            });

            renderTransitionPreview();
            buildPayloadPreview();
            transitionFormInstance.option("formData", getEmptyTransition(selectedNodeId || ""));
            notify("Transition added", "success");
        }

        function renderTransitionPreview() {
            var $box = $("#transitionPreview");
            $box.empty();

            if (!transitions.length) {
                $box.html(`<div class="transition-item"><div class="transition-meta">No transitions</div></div>`);
                return;
            }

            transitions.forEach((x, index) => {
                var flowClass = x.flowType === "Quotation" ? "q" :
                                  x.flowType === "PolicyIssuance" ? "pi" : "both";

                var badges = `<span class="badge ${flowClass === 'q' ? 'q' : flowClass === 'pi' ? 'pi' : 'both'}">${escapeHtml(x.flowType || "Both")}</span>`;
                if (x.isReturn) badges += `<span class="badge return">RETURN</span>`;
                if (x.isLoop) badges += `<span class="badge loop">LOOP</span>`;
                if (x.isExitTransition) badges += `<span class="badge exit">EXIT</span>`;
                if ((x.loopExitMode || "") === "UserDecision") badges += `<span class="badge user">UserDecision</span>`;

                var selfLoopNote = x.fromNodeId === x.toNodeId ? "Self loop / vòng lặp tại chính node này" : "";

                $box.append(`
                    <div class="transition-item">
                        <div class="transition-route">${escapeHtml(x.fromNodeId)} → ${escapeHtml(x.toNodeId)}</div>
                        <div class="badge-row">${badges}</div>
                        <div class="transition-meta">
                            ActionCode: <b>${escapeHtml(x.actionCode || "")}</b><br>
                            ActionName: ${escapeHtml(x.actionName || "")}<br>
                            LoopGroup: ${escapeHtml(x.loopGroup || "-")}<br>
                            LoopExitMode: ${escapeHtml(x.loopExitMode || "-")}<br>
                            UserDecisionLabel: ${escapeHtml(x.userDecisionLabel || "-")}<br>
                            MaxLoopCount: ${x.maxLoopCount == null ? "-" : x.maxLoopCount}<br>
                            ConditionJson: ${escapeHtml(x.conditionJson || "-")}
                        </div>
                        ${selfLoopNote ? `<div class="transition-meta" style="margin-top:6px;color:#6d28d9;font-weight:700;">${escapeHtml(selfLoopNote)}</div>` : ""}
                        <div style="margin-top:8px;">
                            <button onclick="removeTransition(${index})"
                                style="border:1px solid #fecaca;background:#fff1f2;color:#b91c1c;border-radius:8px;padding:6px 10px;cursor:pointer;">
                                Devare
                            </button>
                        </div>
                    </div>
                `);
            });
        }

        window.removeTransition = function(index) {
            transitions.splice(index, 1);
            renderTransitionPreview();
            buildPayloadPreview();
            notify("Transition devared", "success");
        };


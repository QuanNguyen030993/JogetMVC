        function addTransition() {
            var fd = transitionFormInstance.option("formData");

            if (!fd.fromNodeId || !fd.toNodeId) {
                return notify("Please choose From Node and To Node", "warning");
            }
            if (!fd.actionCode) {
                return notify("Action Code is required", "warning");
            }

            transitions.push({
                fromNodeId: fd.fromNodeId,
                toNodeId: fd.toNodeId,
                actionCode: fd.actionCode,
                actionName: fd.actionName || fd.actionCode,
                flowType: fd.flowType || "Both",
                isReturn: !!fd.isReturn,
                isLoop: !!fd.isLoop,
                loopGroup: fd.loopGroup || "",
                loopExitMode: fd.loopExitMode || "None",
                maxLoopCount: fd.maxLoopCount || null,
                isExitTransition: !!fd.isExitTransition,
                userDecisionLabel: fd.userDecisionLabel || "",
                conditionJson: fd.conditionJson || ""
            });

            renderTransitionPreview();
            console.log("addTransition");
            buildPayloadPreview();
            transitionFormInstance.option("formData", getEmptyTransition(selectedNodeId || ""));
            notify("Transition added", "success");
        }

        function renderTransitionPreview() {
            var $box = $("#transitionPreview_@Convert.ToInt32(ViewData["Id"])");
            $box.empty();

            if (!transitions.length) {
                $box.html(`<div class="transition-item"><div class="transition-meta">No transitions</div></div>`);
                return;
            }

            transitions.forEach((x, index) => {
                var flowClass = x.flowType === "Quotation" ? "q" :
                                  x.flowType === "PolicyIssuance" ? "pi" : "both";

                var badges = `<span class="badge ${flowClass === 'q' ? 'q' : flowClass === 'pi' ? 'pi' : 'both'}">${escapeHtml(x.flowType || "Both")}</span>`;
                if (x.isReturn) badges += `<span class="badge return">RETURN</span>`;
                if (x.isLoop) badges += `<span class="badge loop">LOOP</span>`;
                if (x.isExitTransition) badges += `<span class="badge exit">EXIT</span>`;
                if ((x.loopExitMode || "") === "UserDecision") badges += `<span class="badge user">UserDecision</span>`;

                var selfLoopNote = x.fromNodeId === x.toNodeId ? "Self loop / vòng lặp tại chính node này" : "";

                $box.append(`
                    <div class="transition-item">
                        <div class="transition-route">${escapeHtml(x.fromNodeId)} → ${escapeHtml(x.toNodeId)}</div>
                        <div class="badge-row">${badges}</div>
                        <div class="transition-meta">
                            ActionCode: <b>${escapeHtml(x.actionCode || "")}</b><br>
                            ActionName: ${escapeHtml(x.actionName || "")}<br>
                            LoopGroup: ${escapeHtml(x.loopGroup || "-")}<br>
                            LoopExitMode: ${escapeHtml(x.loopExitMode || "-")}<br>
                            UserDecisionLabel: ${escapeHtml(x.userDecisionLabel || "-")}<br>
                            MaxLoopCount: ${x.maxLoopCount == null ? "-" : x.maxLoopCount}<br>
                            ConditionJson: ${escapeHtml(x.conditionJson || "-")}
                        </div>
                        ${selfLoopNote ? `<div class="transition-meta" style="margin-top:6px;color:#6d28d9;font-weight:700;">${escapeHtml(selfLoopNote)}</div>` : ""}
                        <div style="margin-top:8px;">
                            <button onclick="removeTransition(${index})"
                                style="border:1px solid #fecaca;background:#fff1f2;color:#b91c1c;border-radius:8px;padding:6px 10px;cursor:pointer;">
                                Delete
                            </button>
                        </div>
                    </div>
                `);
            });
        }

        window.removeTransition = function(index) {

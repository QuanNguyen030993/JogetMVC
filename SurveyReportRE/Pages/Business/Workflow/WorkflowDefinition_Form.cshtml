        function syncRuntimeState() {
            var ids = workflowTreeData.map(x => x.id);

            if (!runtimeState.activeNodeId || !ids.includes(runtimeState.activeNodeId)) {
                runtimeState.activeNodeId = ids.length ? ids[0] : null;
            }

            runtimeState.completedNodeIds = (runtimeState.completedNodeIds || []).filter(x => ids.includes(x));
            runtimeState.pendingNodeIds = (runtimeState.pendingNodeIds || []).filter(x => ids.includes(x));

            var used = new Set([
                runtimeState.activeNodeId,
                ...runtimeState.completedNodeIds
            ]);

            runtimeState.pendingNodeIds = ids.filter(x => !used.has(x));
        }
        function syncWorkflowHeader() {
            workflowHeader = workflowFormInstance.option("formData") || workflowHeader;
        }


                function syncTreeDataFromJsTree(overrideTextForSelected, newObject) {
            var tree = $("#treeWorkflow_@Convert.ToInt32(ViewData["Id"])").jstree(true);
            var oldData = workflowTreeData || [];
            var flat = tree.get_json("#", { flat: true });

            workflowTreeData = flat.map((x, index) => {
                var oldNode = oldData.find(n => n.id === x.id) || {};
                var plainText = extractTextFromHtml(x.text);

                if (overrideTextForSelected && x.id === selectedNodeId) {
                    plainText = overrideTextForSelected;
                }
                if (newObject.id == oldNode?.id && newObject && oldNode)
                 return {
                           id: x.id,
                            parent: x.parent,
                            text: plainText,
                            type: newObject.type || oldNode.type || "",
                            code: newObject.code || "",
                            orderNo: newObject.orderNo ?? oldNode.orderNo ?? (index + 1),
                            stepRole: newObject.stepRole || oldNode.stepRole || "",
                            departmentName: newObject.departmentName || oldNode.departmentName || "",
                            levelNo: newObject.levelNo ?? oldNode.levelNo ?? 1,
                            flowType: newObject.flowType || oldNode.flowType || "Both",
                            allowLoop: !!(newObject.allowLoop ?? oldNode.allowLoop),
                            loopGroup: newObject.loopGroup || oldNode.loopGroup || "",
                            x: newObject.x ?? oldNode.x ?? null,
                            y: newObject.y ?? oldNode.y ?? null
                };
                else
                return {
                    id: x.id,
                    parent: x.parent,
                    text: plainText,
                    type: x.original?.type || oldNode.type || "",
                    code: x.original?.code || oldNode.code || "",
                    orderNo: x.original?.orderNo ?? oldNode.orderNo ?? (index + 1),
                    stepRole: x.original?.stepRole || oldNode.stepRole || "",
                    departmentName: x.original?.departmentName || oldNode.departmentName || "",
                    levelNo: x.original?.levelNo ?? oldNode.levelNo ?? 1,
                    flowType: x.original?.flowType || oldNode.flowType || "Both",
                    allowLoop: !!(x.original?.allowLoop ?? oldNode.allowLoop),
                    loopGroup: x.original?.loopGroup || oldNode.loopGroup || "",
                    x: x.original?.x ?? oldNode.x ?? null,
                    y: x.original?.y ?? oldNode.y ?? null
                };
            });

            refreshTransitionNodeLookup();
            refreshGrid();
            buildPayloadPreview();

            if (selectedNodeId) {
                var cur = workflowTreeData.find(x => x.id === selectedNodeId);
                if (cur) {
                    $("#nodeJsonEditor_@Convert.ToInt32(ViewData["Id"])").val(JSON.stringify({
                        id: cur.id,
                        parent: cur.parent === "#" ? null : cur.parent,
                        text: cur.text,
                        type: cur.type,
                        code: cur.code,
                        orderNo: cur.orderNo,
                        stepRole: cur.stepRole,
                        departmentName: cur.departmentName,
                        levelNo: cur.levelNo,
                        flowType: cur.flowType,
                        allowLoop: cur.allowLoop,
                        loopGroup: cur.loopGroup,
                        x: cur.x,
                        y: cur.y
                    }, null, 2));
                }
            }
        }


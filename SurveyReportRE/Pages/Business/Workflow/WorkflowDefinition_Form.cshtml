        function initDropZoneForTree() {
            var treeContainer = document.getElementById("treeWorkflow_@(Convert.ToInt32(ViewData["Id"]))");

            treeContainer.addEventListener("dragover", function (e) {
                e.preventDefault();
                treeContainer.classList.add("drag-over-zone");
            });

            treeContainer.addEventListener("dragleave", function () {
                treeContainer.classList.remove("drag-over-zone");
            });

            treeContainer.addEventListener("drop", function (e) {
                e.preventDefault();
                treeContainer.classList.remove("drag-over-zone");

                var data = dragToolData;
                try {
                    var raw = e.dataTransfer.getData("text/plain");
                    if (raw) data = JSON.parse(raw);
                } catch (ex) { }

                if (!data) return;

                var targetLi = $(e.target).closest("li");
                var parentId = targetLi.length ? targetLi.attr("id") : "#";

                createNodeFromTool(data, parentId);
            });
        }
        

        function buildStepsWorkflowForSave(workflowDefinitionId) {
            const nodeMap = {};
            workflowTreeData.forEach(function (n) {
                nodeMap[n.id] = n;
            });

            return transitions.map(function (t, index) {
                const fromNode = nodeMap[t.fromNodeId] || {};
                const toNode = t.toNodeId ? (nodeMap[t.toNodeId] || {}) : null;

                const isStart = fromNode.parent === "#" || fromNode.parent == null;
                const isEnd = !t.toNodeId || !!t.isExitTransition;

                let uiMode = "Start";
                if ((t.actionCode || "").startsWith("SUBMIT")) uiMode = "Forward";
                else if ((t.actionCode || "").startsWith("RETURN")) uiMode = "Withdraw";
                else if ((t.actionCode || "").startsWith("COMPLETE")) uiMode = "Finish";
                
                return {
                    sortOrder: index + 1,
                    stepNo: t.stepNo?.toString(),// || (index + 1),
                    jumpStepNo: t.jumpStepNo?.toString(),// || (index + 1),
                    workflowDefinitionId: workflowDefinitionId,

                    stepType: isEnd ? 9 : (t.isLoop ? 3 : 2),
                    allowLoop: t.isLoop,
                    canComment: true,
                    canEdit: !isEnd,
                    canUpload: !isEnd,

                    departmentCode: fromNode.departmentName || null,
                    displayStatus: t.actionName || null,
                    flowType: t.flowType || "Both",
                    isActive: true,
                    isEnd: isEnd,
                    isStart: isStart,

                    levelNo: fromNode.levelNo || null,
                    loopGroup: t.loopGroup || null,
                    parentStepId: null,
                    posX: fromNode.x || null,
                    posY: fromNode.y || null,

                    roleCode: fromNode.code || fromNode.text || fromNode.id,
                    stepCode: `${t.fromNodeId}_${t.actionCode}`,
                    stepName: `${fromNode.text || t.fromNodeId} ${t.actionName || t.actionCode}`,
                    uiMode: uiMode,

                    actionCode: t.actionCode || null,
                    data: JSON.stringify(
                        t.conditionJson || "{}"
                    ),

                    fromNodeId: t.fromNodeId || null,
                    fnodeId: t.fromNodeId || null,
                    tnodeId: t.toNodeId || null,
                    toNodeId: t.toNodeId || null,
                    statusId: t.statusId

                };
            });
        }
        function createNodeFromTool(tool, parentId) {
            var tree = $("#treeWorkflow_@Convert.ToInt32(ViewData["Id"])").jstree(true);
            var newId = generateNodeId();
            var parentNode = parentId === "#" ? null : tree.get_node(parentId);

            var currentWorkflowFlow = mainForm.formInstance.option("formData").flowType || "Both";

            var nodeData = {
                id: newId,
                text: tool.text || "New Node",
                type: tool.type || "department",
                code: "",
                orderNo: getNextOrderNo(parentId),
                stepRole: "",
                departmentName: "",
                levelNo: parentNode ? ((parentNode.original.levelNo || 1) + 1) : 1,
                flowType: currentWorkflowFlow === "Both" ? "Both" : currentWorkflowFlow,
                allowLoop: false,
                loopGroup: "",
                x: 0,
                y: 0
            };

            tree.create_node(parentId, {
                ...nodeData,
                text: buildTreeNodeHtml(nodeData)
            }, "last", function (node) {
                tree.open_node(parentId);
                tree.deselect_all();
                tree.select_node(node);
                syncTreeDataFromJsTree();
            });
        }


        function buildWorkflowNodesForSave(workflowDefinitionId) {
            return workflowTreeData.map(function (x, index) {
                return {
                    workflowDefinitionId: workflowDefinitionId,
                    nodeId: x.id,
                    parentNodeId: x.parent === "#" ? null : x.parent,
                    nodeName: x.text || "",
                    nodeType: x.type || "",
                    nodeStatus: x.flowType || "Both",
                    allowLoop: !!x.allowLoop,
                    loopGroup: x.loopGroup || null,
                    nodeCode: x.code || null,
                    stepRole: x.stepRole || null,
                    departmentCode: x.departmentName || null,
                    levelNo: x.levelNo || null,
                    posX: x.x || null,
                    posY: x.y || null,

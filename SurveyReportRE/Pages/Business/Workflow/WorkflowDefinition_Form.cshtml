                        editorType: "dxNumberBox"
                    }
                ],
                onInitialized: function (e) {
                    nodeFormInstance = e.component;
                }
            });
        }

        function initTransitionForm() {
            $("#transitionForm_@Convert.ToInt32(ViewData["Id"])").dxForm({
                formData: getEmptyTransition(),
                labelLocation: "top",
                colCount: 2,
                items: [
                    {
                        dataField: "fromNodeId",
                        label: { text: "From Node" },
                        editorType: "dxSelectBox",
                        editorOptions: {
                            dataSource: [],
                            valueExpr: "id",
                            displayExpr: "text",
                            searchEnabled: true
                        }
                    },
                    {
                        dataField: "toNodeId",
                        label: { text: "To Node" },
                        editorType: "dxSelectBox",
                        editorOptions: {
                            dataSource: [],

        function syncRuntimeState() {
            var ids = workflowTreeData.map(x => x.id);

            if (!runtimeState.activeNodeId || !ids.includes(runtimeState.activeNodeId)) {
                runtimeState.activeNodeId = ids.length ? ids[0] : null;
            }

            runtimeState.completedNodeIds = (runtimeState.completedNodeIds || []).filter(x => ids.includes(x));
            runtimeState.pendingNodeIds = (runtimeState.pendingNodeIds || []).filter(x => ids.includes(x));

            var used = new Set([
                runtimeState.activeNodeId,
                ...runtimeState.completedNodeIds
            ]);

            runtimeState.pendingNodeIds = ids.filter(x => !used.has(x));
        }
        // function syncWorkflowHeader() {
        //      workflowHeader = mainForm.formInstance.option("formData") || workflowHeader|| "",
        // }


        function syncTreeDataFromJsTree(overrideTextForSelected, newObject) {
            var tree = $("#treeWorkflow_@Convert.ToInt32(ViewData["Id"])").jstree(true);
            var oldData = workflowTreeData || [];
            var flat = tree.get_json("#", { flat: true });

            workflowTreeData = flat.map((x, index) => {
                var oldNode = oldData.find(n => n.id === x.id) || {};
                var plainText = extractTextFromHtml(x.text);

                if (overrideTextForSelected && x.id === selectedNodeId) {
                    plainText = overrideTextForSelected;
                }
                if (newObject.id == oldNode?.id && newObject && oldNode)
                    return {
                        id: x.id,
                        parent: x.parent,
                        text: plainText,
                        type: newObject.type || oldNode.type || "",
                        code: newObject.code || "",
                        orderNo: newObject.orderNo ?? oldNode.orderNo ?? (index + 1),
                        stepRole: newObject.stepRole || oldNode.stepRole || "",
                        departmentName: newObject.departmentName || oldNode.departmentName || "",
                        levelNo: newObject.levelNo ?? oldNode.levelNo ?? 1,
                        flowType: newObject.flowType || oldNode.flowType || "Both",
                        allowLoop: !!(newObject.allowLoop ?? oldNode.allowLoop),
                        loopGroup: newObject.loopGroup || oldNode.loopGroup || "",
                        x: newObject.x ?? oldNode.x ?? null,
                        y: newObject.y ?? oldNode.y ?? null
                    };
                else
                    return {
                        id: x.id,
                        parent: x.parent,
                        text: plainText,
                        type: x.original?.type || oldNode.type || "",
                        code: x.original?.code || oldNode.code || "",
                        orderNo: x.original?.orderNo ?? oldNode.orderNo ?? (index + 1),
                        stepRole: x.original?.stepRole || oldNode.stepRole || "",
                        departmentName: x.original?.departmentName || oldNode.departmentName || "",
                        levelNo: x.original?.levelNo ?? oldNode.levelNo ?? 1,
                        flowType: x.original?.flowType || oldNode.flowType || "Both",
                        allowLoop: !!(x.original?.allowLoop ?? oldNode.allowLoop),
                        loopGroup: x.original?.loopGroup || oldNode.loopGroup || "",
                        x: x.original?.x ?? oldNode.x ?? null,
                        y: x.original?.y ?? oldNode.y ?? null
                    };
            });

            refreshTransitionNodeLookup();
            refreshGrid();
            buildPayloadPreview();

            if (selectedNodeId) {
                var cur = workflowTreeData.find(x => x.id === selectedNodeId);
                if (cur) {
                    $("#nodeJsonEditor_@Convert.ToInt32(ViewData["Id"])").val(JSON.stringify({
                        id: cur.id,
                        parent: cur.parent === "#" ? null : cur.parent,
                        text: cur.text,
                        type: cur.type,
                        code: cur.code,
                        orderNo: cur.orderNo,
                        stepRole: cur.stepRole,
                        departmentName: cur.departmentName,
                        levelNo: cur.levelNo,
                        flowType: cur.flowType,
                        allowLoop: cur.allowLoop,
                        loopGroup: cur.loopGroup,
                        x: cur.x,
                        y: cur.y
                    }, null, 2));
                }
            }
        }

        

        

        function reloadAll() {
            selectedNodeId = null;
            // if (workflowFormInstance) workflowFormInstance.option("formData", workflowHeader);
            if (nodeFormInstance) nodeFormInstance.option("formData", {});
            if (transitionFormInstance) transitionFormInstance.option("formData", getEmptyTransition(""));
            $("#nodeJsonEditor_@Convert.ToInt32(ViewData["Id"])").val("");
            initTree();
            refreshTransitionNodeLookup();
            buildPayloadPreview();

            refreshGrid();
        }


        function getNextOrderNo(parentId) {
            var tree = $("#treeWorkflow_@Convert.ToInt32(ViewData["Id"])").jstree(true);
            if (!tree) return 1;

            if (parentId === "#") {
                var roots = tree.get_json("#");
                return roots.length + 1;
            }

            var parent = tree.get_node(parentId);
            return (parent && parent.children) ? (parent.children.length + 1) : 1;
        }

        function collectDescendantIds(tree, nodeId) {
            var node = tree.get_node(nodeId);
            return node && node.children_d ? node.children_d.slice() : [];
        }

        function extractPlainTextFromNode(nodeId) {
            var found = workflowTreeData.find(x => x.id === nodeId);
            return found ? found.text : nodeId;
        }

        function extractTextFromHtml(html) {
            var div = document.createElement("div");
            div.innerHTML = html || "";
            var nodeText = div.querySelector(".tree-node-text");
            if (nodeText) return nodeText.textContent.trim();
            return div.textContent.trim();
        }

        function generateNodeId() {
            return "NODE_" + Date.now();
        }

        function notify(message, type) {
            DevExpress.ui.notify(message, type || "info", 1800);
        }

        var transitionItem = [
                    {
                        dataField: "fromNodeId",
                        label: { text: "From Node" },
                        editorType: "dxSelectBox",
                        editorOptions: {
                            dataSource: [],
                            valueExpr: "id",
                            displayExpr: "text",
                            searchEnabled: true
                        }
                    },
                    {
                        dataField: "toNodeId",
                        label: { text: "To Node" },
                        editorType: "dxSelectBox",
                        editorOptions: {
                            dataSource: [],
                            valueExpr: "id",
                            displayExpr: "text",
                            searchEnabled: true
                        }
                    },
                    { dataField: "statusId", caption: "Status" , editorType: "dxSelectBox",editorOptions: makeSelectBoxEditorOptions(_enums.OverallStatus) },
                    {
                        dataField: "actionCode",
                        label: { text: "Action Code" }
                    },
                    {
                        dataField: "actionName",
                        label: { text: "Action Name" }
                    },
                    {
                        dataField: "stepNo",
                        label: { text: "Step No" },
                        editorType: "dxTextBox",
                    },
                    {
                        dataField: "jumpStepNo",
                        label: { text: "Jump Point" },
                        editorType: "dxTextBox",
                    },
                    {
                        dataField: "flowType",
                        label: { text: "Transition Flow Type" },
                        editorType: "dxSelectBox",
                        editorOptions: {
                            dataSource: ["Quotation", "PolicyIssuance", "Both"]
                        }
                    },
                    {
                        dataField: "isReturn",
                        label: { text: "Return Flow" },
                        editorType: "dxSwitch"
                    },
                    {
                        dataField: "isLoop",
                        label: { text: "Loop Flow" },
                        editorType: "dxSwitch"
                    },
                    {
                        dataField: "loopGroup",
                        label: { text: "Loop Group" }
                    },
                    {
                        dataField: "loopExitMode",
                        label: { text: "Loop Exit Mode" },
                        editorType: "dxSelectBox",
                        editorOptions: {
                            dataSource: ["None", "UserDecision", "Condition", "MaxIteration"]
                        }
                    },
                    {
                        dataField: "maxLoopCount",
                        label: { text: "Max Loop Count" },
                        editorType: "dxNumberBox",
                        editorOptions: { min: 1 }
                    },
                    {
                        dataField: "isExitTransition",
                        label: { text: "Exit Transition" },
                        editorType: "dxSwitch"
                    },
                    {
                        dataField: "userDecisionLabel",
                        label: { text: "User Decision Label" }
                    },
                    {
                        dataField: "conditionJson",
                        label: { text: "Condition JSON" },
                        editorType: "dxTextArea",
                        colSpan: 2
                    }
           ]     ;

          function initTransitionForm() {
            $("#transitionForm_@Convert.ToInt32(ViewData["Id"])").dxForm({
                // formData: getEmptyTransition(),
                labelLocation: "top",
                colCount: 2,
                 items: transitionItem,
                
                onInitialized: function (e) {
                    transitionFormInstance = e.component;
                    refreshTransitionNodeLookup();
                }
            });
        }
         function initTransitionGrid() {
            ensureTransitionKeys();
           
            $("#transitionGrid_@Convert.ToInt32(ViewData["Id"])").dxDataGrid({
                dataSource: transitions,
                keyExpr: "__rowKey",
                showBorders: true,
                height: 420,
                paging: { enabled: false },
                filterRow: { visible: true },
                searchPanel: { visible: true, width: 260, placeholder: "Search transition..." },
                headerFilter: { visible: true },
                columnAutoWidth: true,
                allowColumnResizing: true,
                rowAlternationEnabled: true,
                editing: {
                    mode: "row",
                    allowUpdating: false,
                    allowAdding: false,
                    allowDeleting: true,
                    useIcons: true
                },
                columns: transitionItem,
                
                onRowRemoving: function (e) {
                    const rowIndex = transitions.findIndex(x => x.__rowKey === e.data.__rowKey);

                    if (rowIndex >= 0) {
                        transitions.splice(rowIndex, 1);

                        e.component.option("dataSource", [...transitions]);
                        buildPayloadPreview();
                        notify("Transition deleted", "success");
                    }

                    e.cancel = true;
                },
                onRowDblClick: function (e) {
                    if (!transitionFormInstance || !e.data) return;
                    transitionFormInstance.option("formData", { ...e.data });
                    notify("Transition loaded to editor", "success");
                },
                onInitialized: function (e) {
                    transitionGridInstance = e.component;
                }
            });
        }

        function refreshTransitionGrid() {


            hydrateStateFromPayload($("#payloadBox_@Convert.ToInt32(ViewData["Id"])").text());
            if (transitionGridInstance) {
                transitionGridInstance.option("dataSource", [...transitions]);
                transitionGridInstance.refresh();
            }
        }

        var payloadInitialized = false;

        function safeParseJson(text, fallback = null) {
            try {
                return JSON.parse(text);
            } catch (e) {
                return fallback;
            }
        }

        function getPayloadBoxObject() {
            var raw = ($("#payloadBox_@Convert.ToInt32(ViewData["Id"])").text() || "").trim();
            return safeParseJson(raw, null);
        }

        function setPayloadBoxObject(obj) {
            $("#payloadBox_@Convert.ToInt32(ViewData["Id"])").text(JSON.stringify(obj, null, 2));
        }

        function buildPayloadObjectFromState() {
            // syncWorkflowHeader();
            syncRuntimeState();
            return {
                workflowDefinition: {
                    id: _id || 0,
                    // workflowCode: workflowHeader?.workflowCode || "",
                    // workflowName: workflowHeader?.workflowName || "",
                    // flowType: workflowHeader?.flowType || "Both",
                    // versionNo: workflowHeader?.versionNo ?? 1,
                    // isActive: workflowHeader?.isActive ?? true
                },
                workflowNodes: workflowTreeData.map((x, index) => ({
                    id: x.id,
                    parentId: x.parent === "#" ? null : x.parent,
                    nodeName: x.text,
                    nodeType: x.type || "",
                    nodeCode: x.code || "",
                    orderNo: x.orderNo ?? (index + 1),
                    stepRole: x.stepRole || "",
                    departmentName: x.departmentName || "",
                    levelNo: x.levelNo ?? 1,
                    flowType: x.flowType || "Both",
                    allowLoop: !!x.allowLoop,
                    loopGroup: x.loopGroup || "",
                    x: x.x ?? null,
                    y: x.y ?? null
                })),
                workflowTransitions: transitions.map(x => (transitionMapeHandle(x))),
                runtimeState: {
                    activeNodeId: runtimeState.activeNodeId || null,
                    completedNodeIds: runtimeState.completedNodeIds || [],
                    pendingNodeIds: runtimeState.pendingNodeIds || []
                }
            };
        }

        function hydrateStateFromPayload(payload) {
            if (!payload) return;

            // workflowHeader = payload.workflowDefinition || workflowHeader;
            runtimeState = payload.runtimeState || runtimeState;

            workflowTreeData = (payload.workflowNodes || []).map(x => ({
                id: x.id,
                parent: x.parentId || "#",
                text: x.nodeName || "",
                type: x.nodeType || "",
                code: x.nodeCode || "",
                orderNo: x.orderNo ?? 0,
                stepRole: x.stepRole || "",
                departmentName: x.departmentName || "",
                levelNo: x.levelNo ?? 1,
                flowType: x.flowType || "Both",
                allowLoop: !!x.allowLoop,
                loopGroup: x.loopGroup || "",
                x: x.x ?? null,
                y: x.y ?? null
            }));

            transitions = (payload.workflowTransitions || []).map(x => (transitionMapeHandle(x)));

            // if (transitionFormInstance) transitionFormInstance.option("formData", getEmptyTransition(""));
            if (nodeFormInstance) nodeFormInstance.option("formData", {});

            initTree();
            refreshTransitionNodeLookup();
            refreshGrid();
        }

       


        function initPayloadBoxOnce() {
            if (payloadInitialized) return $.Deferred().resolve().promise();

            var d = $.Deferred();

            if (_id && _id != 0) {
                ajaxGet(`/api/WorkflowDefinition/GetSingle/${_id}`)
                    .then(function (data) {
                        var dbPayload = safeParseJson(data.workflowNodes, null);
                        var overWriteHeader = new Object ();

                        // overWriteHeader.workflowCode= workflowHeader?.workflowCode || "";
                        // overWriteHeader.workflowName= workflowHeader?.workflowName || "";
                        // overWriteHeader.flowType= workflowHeader?.flowType || "";
                        // overWriteHeader.versionNo= workflowHeader?.versionNo|| "";
                        // overWriteHeader.isActive= workflowHeader?.isActive|| "";

                        dbPayload.workflowDefinition = overWriteHeader;
                        if (dbPayload) {
                            setPayloadBoxObject(dbPayload);

                            // nếu muốn, đồng bộ ngược từ payload về state để UI phản ánh đúng DB
                            hydrateStateFromPayload(dbPayload);
                        } else {
                            var fallbackPayload = buildPayloadObjectFromState();
                            setPayloadBoxObject(fallbackPayload);
                        }

                        payloadInitialized = true;
                        refreshGrid();
                        d.resolve();
                    })
                    .fail(function () {
                        var fallbackPayload = buildPayloadObjectFromState();
                        setPayloadBoxObject(fallbackPayload);
                        payloadInitialized = true;
                        refreshGrid();
                        d.resolve();
                    });
            } else {
                var initPayload = buildPayloadObjectFromState();
                setPayloadBoxObject(initPayload);
                payloadInitialized = true;
                refreshGrid();
                d.resolve();
            }

            return d.promise();
        }

        function syncPayloadBoxFromCurrentState() {
            if (!payloadInitialized) return;

            var current = getPayloadBoxObject() || {};
            var latest = buildPayloadObjectFromState();

            current.workflowDefinition = workflowHeader || ""; 
            current.workflowNodes = latest.workflowNodes;
            current.workflowTransitions = latest.workflowTransitions;
            current.runtimeState = latest.runtimeState;

            setPayloadBoxObject(current) ;
            refreshGrid();
        }
            initNodeForm();                         
            initConditionBuilderForm();         
            initTransitionForm();                   
            initButtons();                          
            initTree();                             
            initToolboxDrag();                      
            initGrid();                             
            initPayloadBoxOnce().then(function () { 
                initTransitionGrid();               
            });
    </script>

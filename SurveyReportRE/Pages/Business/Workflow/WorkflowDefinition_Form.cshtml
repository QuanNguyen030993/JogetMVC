        function getNextOrderNo(parentId) {
            var tree = $("#treeWorkflow_@Convert.ToInt32(ViewData["Id"])").jstree(true);
            if (!tree) return 1;

            if (parentId === "#") {
                var roots = tree.get_json("#");
                return roots.length + 1;
            }

            var parent = tree.get_node(parentId);
            return (parent && parent.children) ? (parent.children.length + 1) : 1;
        }

        function collectDescendantIds(tree, nodeId) {
            var node = tree.get_node(nodeId);
            return node && node.children_d ? node.children_d.slice() : [];

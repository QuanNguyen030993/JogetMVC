        function buildPayloadPreview() {
            syncWorkflowHeader();

            var payload = {
                workflowDefinition: {
                    workflowCode: workflowHeader.workflowCode,
                    workflowName: workflowHeader.workflowName,
                    flowType: workflowHeader.flowType,
                    versionNo: workflowHeader.versionNo,
                    isActive: workflowHeader.isActive
                },
                workflowNodes: workflowTreeData.map((x, index) => ({
                    id: x.id,
                    parentId: x.parent === "#" ? null : x.parent,
                    nodeName: x.text,
                    nodeType: x.type,
                    nodeCode: x.code,
                    orderNo: x.orderNo ?? (index + 1),
                    stepRole: x.stepRole,
                    departmentName: x.departmentName,
                    levelNo: x.levelNo,
                    flowType: x.flowType || "Both",
                    allowLoop: !!x.allowLoop,
                    loopGroup: x.loopGroup || ""
                })),
                workflowTransitions: transitions.map(x => ({
                    fromNodeId: x.fromNodeId,
                    toNodeId: x.toNodeId,
                    actionCode: x.actionCode,
                    actionName: x.actionName,
                    flowType: x.flowType || "Both",
                    isReturn: !!x.isReturn,
                    isLoop: !!x.isLoop,
                    loopGroup: x.loopGroup || "",
                    loopExitMode: x.loopExitMode || "None",
                    maxLoopCount: x.maxLoopCount,
                    isExitTransition: !!x.isExitTransition,
                    userDecisionLabel: x.userDecisionLabel || "",
                    conditionJson: x.conditionJson || ""
                }))
            };

            $("#payloadBox").text(JSON.stringify(payload, null, 2));
            refreshGrid();
        }

        function refreshTransitionNodeLookup() {
            if (!transitionFormInstance) return;
            var ds = workflowTreeData.map(x => ({ id: x.id, text: x.text }));

            transitionFormInstance.itemOption("fromNodeId", "editorOptions", {
                dataSource: ds,
                valueExpr: "id",
                displayExpr: "text",
                searchEnabled: true
            });

            transitionFormInstance.itemOption("toNodeId", "editorOptions", {
                dataSource: ds,
                valueExpr: "id",
                displayExpr: "text",
                searchEnabled: true
            });
        }

        function syncWorkflowHeader() {
            workflowHeader = workflowFormInstance.option("formData") || workflowHeader;
        }

        function syncTreeDataFromJsTree(overrideTextForSelected) {
            var tree = $("#treeWorkflow").jstree(true);
            var flat = tree.get_json("#", { flat: true });

            workflowTreeData = flat.map((x, index) => {
                var plainText = extractTextFromHtml(x.text);
                if (overrideTextForSelected && x.id === selectedNodeId) {
                    plainText = overrideTextForSelected;
                }

                return {
                    id: x.id,
                    parent: x.parent,
                    text: plainText,
                    type: x.original?.type || "",
                    code: x.original?.code || "",
                    orderNo: x.original?.orderNo ?? (index + 1),
                    stepRole: x.original?.stepRole || "",
                    departmentName: x.original?.departmentName || "",
                    levelNo: x.original?.levelNo || 1,
                    flowType: x.original?.flowType || "Both",
                    allowLoop: !!x.original?.allowLoop,
                    loopGroup: x.original?.loopGroup || ""
                };
            });

            refreshTransitionNodeLookup();
            refreshGrid();
            buildPayloadPreview();

            if (selectedNodeId) {
                var cur = workflowTreeData.find(x => x.id === selectedNodeId);
                if (cur) {
                    $("#nodeJsonEditor").val(JSON.stringify({
                        id: cur.id,
                        parent: cur.parent === "#" ? null : cur.parent,
                        text: cur.text,
                        type: cur.type,
                        code: cur.code,
                        orderNo: cur.orderNo,
                        stepRole: cur.stepRole,
                        departmentName: cur.departmentName,
                        levelNo: cur.levelNo,
                        flowType: cur.flowType,
                        allowLoop: cur.allowLoop,
                        loopGroup: cur.loopGroup
                    }, null, 2));
                }
            }
        }


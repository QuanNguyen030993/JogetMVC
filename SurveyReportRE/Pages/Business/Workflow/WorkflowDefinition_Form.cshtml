                    parentNodeId: x.parent === "#" ? null : x.parent,
                    nodeName: x.text || "",
                    nodeType: x.type || "",
                    flowType: x.flowType || "Both",
                    allowLoop: !!x.allowLoop,
                    loopGroup: x.loopGroup || null,
                    nodeCode: x.code || null,
                    stepRole: x.stepRole || null,
                    departmentCode: x.departmentName || null,
                    levelNo: x.levelNo || null,
                    posX: x.x || null,
                    posY: x.y || null,
                    sortOrder: x.orderNo || (index + 1),
                    isActive: true,
                    data: JSON.stringify({
                        rawNode: x || "{}"
                    })
                };
            });
        }
       

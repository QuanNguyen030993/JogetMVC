    <style>
        * { box-sizing: border-box; }

        body {
            margin: 0;
            font-family: "Segoe UI", Arial, sans-serif;
            background: #f4f6fb;
            color: #1f2937;
        }

        .page {
            padding: 14px;
        }

        .title {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .sub {
            color: #6b7280;
            margin-bottom: 14px;
        }

        .layout {
            display: grid;
            grid-template-columns: 270px 380px 430px 1fr;
            gap: 14px;
            min-height: calc(100vh - 90px);
        }

        .card {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 14px;
            box-shadow: 0 8px 24px rgba(0,0,0,.06);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            min-height: 0;
        }

        .card-header {
            padding: 14px 16px;
            border-bottom: 1px solid #edf0f5;
        }

        .card-title {
            font-size: 16px;
            font-weight: 700;
        }

        .card-sub {
            font-size: 12px;
            color: #6b7280;
            margin-top: 4px;
        }

        .card-body {
            padding: 14px;
            flex: 1;
            overflow: auto;
            min-height: 0;
        }

        .toolbox {
            display: grid;
            gap: 10px;
        }

        .tool-item {
            border: 1px dashed #9db7ff;
            background: #f4f8ff;
            color: #264b96;
            border-radius: 12px;
            padding: 12px;
            cursor: grab;
            user-select: none;
            transition: .2s ease;
        }

        .tool-item:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(59,130,246,.12);
        }

        .tool-item .name {
            font-weight: 700;
            margin-bottom: 4px;
        }

        .tool-item .desc {
            font-size: 12px;
            color: #52627d;
        }

        .toolbar, .mini-row {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 10px;
        }

        #treeWorkflow {
            border: 1px solid #dbe1ea;
            border-radius: 12px;
            background: #fcfdff;
            min-height: 600px;
            padding: 8px;
        }

        .drop-hint {
            margin-top: 10px;
            font-size: 12px;
            color: #6b7280;
            background: #f9fafb;
            border: 1px solid #eceff5;
            padding: 10px;
            border-radius: 10px;
            line-height: 1.5;
        }

        .section-title {
            margin: 14px 0 8px 0;
            font-size: 13px;
            font-weight: 700;
            color: #334155;
        }

        .json-box {
            min-height: 200px;
            max-height: 300px;
            overflow: auto;
            border-radius: 12px;
            background: #0f172a;
            color: #dbeafe;
            padding: 12px;
            font-family: Consolas, monospace;
            font-size: 12px;
            white-space: pre-wrap;
            word-break: break-word;
        }

        .node-json-editor {
            width: 100%;
            min-height: 160px;
            resize: vertical;
            border: 1px solid #d8dfeb;
            border-radius: 12px;
            padding: 10px;
            font-family: Consolas, monospace;
            font-size: 12px;
            outline: none;
        }

        .transition-list {
            display: grid;
            gap: 8px;
        }

        .transition-item {
            border: 1px solid #e5e7eb;
            background: #fafbff;
            border-radius: 12px;
            padding: 10px 12px;
        }

        .transition-route {
            font-weight: 700;
            color: #1d4ed8;
            margin-bottom: 6px;
        }

        .transition-meta {
            font-size: 12px;
            color: #475569;
            line-height: 1.5;
        }

        .badge-row {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-bottom: 6px;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            padding: 3px 8px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 700;
            border: 1px solid transparent;
        }

        .badge.q {
            background: #eef4ff;
            color: #1d4ed8;
            border-color: #bfdbfe;
        }

        .badge.pi {
            background: #fff7ed;
            color: #c2410c;
            border-color: #fdba74;
        }

        .badge.both {
            background: #f3f4f6;
            color: #374151;
            border-color: #d1d5db;
        }

        .badge.return {
            background: #fee2e2;
            color: #b91c1c;
            border-color: #fecaca;
        }

        .badge.loop {
            background: #ede9fe;
            color: #6d28d9;
            border-color: #c4b5fd;
        }

        .badge.exit {
            background: #dcfce7;
            color: #15803d;
            border-color: #86efac;
        }

        .badge.user {
            background: #ecfeff;
            color: #0f766e;
            border-color: #99f6e4;
        }

        .legend-box {
            display: grid;
            gap: 6px;
        }

        .legend-item {
            font-size: 12px;
            color: #475569;
        }

        .loop-box {
            border: 1px dashed #c4b5fd;
            background: #faf5ff;
            border-radius: 12px;
            padding: 10px;
            margin-top: 10px;
            font-size: 12px;
            color: #5b21b6;
        }

        .jstree-anchor {
            border-radius: 6px;
            display: inline-flex !important;
            align-items: center;
            gap: 6px;
            max-width: 100%;
        }

        .jstree-clicked {
            background: #dbeafe !important;
            color: #111827 !important;
        }

        .tree-node-wrap {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
        }

        .tree-node-text {
            font-weight: 600;
        }

        .tree-node-mini {
            font-size: 10px;
            border-radius: 999px;
            padding: 2px 6px;
            border: 1px solid #ddd;
            background: #fff;
            line-height: 1;
        }

        .tree-node-mini.q {
            color: #1d4ed8;
            border-color: #bfdbfe;
            background: #eff6ff;
        }

        .tree-node-mini.pi {
            color: #c2410c;
            border-color: #fdba74;
            background: #fff7ed;
        }

        .tree-node-mini.both {
            color: #374151;
            border-color: #d1d5db;
            background: #f9fafb;
        }

        .tree-node-mini.loop {
            color: #6d28d9;
            border-color: #c4b5fd;
            background: #f5f3ff;
        }

        .drag-over-zone {
            outline: 2px dashed #60a5fa;
            outline-offset: 2px;
        }

        @@media (max-width: 1680px) {
            .layout {
                grid-template-columns: 270px 380px 1fr;
            }
            .card-last {
                grid-column: 2;
            }
        }

        @@media (max-width: 1280px) {
            .layout {
                grid-template-columns: 1fr;
            }
        }
    </style>
<body>
    <div class="page">
        <div class="title">Workflow Designer</div>
        <div class="sub">
            Toolbox + jsTree + Flow Type + Transition + Loop/Exit/User Decision để bạn review trước khi chốt thiết kế bảng lưu data.
        </div>

        <div class="layout">
            <!-- TOOLBOX -->
            <div class="card">
                <div class="card-header">
                    <div class="card-title">Toolbox</div>
                    <div class="card-sub">Kéo object vào tree để tạo node</div>
                </div>
                <div class="card-body">
                    <div class="toolbox">
                        <div class="tool-item" draggable="true" data-type="department" data-text="New Department">
                            <div class="name">Department</div>
                            <div class="desc">Ví dụ FO / TS / UW / LMKT / PM</div>
                        </div>
                        <div class="tool-item" draggable="true" data-type="actor" data-text="New Actor">
                            <div class="name">Actor</div>
                            <div class="desc">Ví dụ Client / External / Approver</div>
                        </div>
                        <div class="tool-item" draggable="true" data-type="condition" data-text="New Condition">
                            <div class="name">Condition</div>
                            <div class="desc">Rule node / branching / decision</div>
                        </div>
                        <div class="tool-item" draggable="true" data-type="system" data-text="New System">
                            <div class="name">System</div>
                            <div class="desc">Auto process / service / scheduler</div>
                        </div>
                    </div>

                    <div class="section-title">Load Sample</div>
                    <div class="mini-row">
                        <div id="btnSampleQuotation"></div>
                        <div id="btnSamplePolicy"></div>
                        <div id="btnSampleLoop"></div>
                    </div>

                    <div class="section-title">Legend</div>
                    <div class="legend-box">
                        <div class="legend-item"><span class="badge q">Quotation</span> node/flow dùng cho quotation</div>
                        <div class="legend-item"><span class="badge pi">PolicyIssuance</span> node/flow dùng cho policy issuance</div>
                        <div class="legend-item"><span class="badge both">Both</span> dùng chung</div>
                        <div class="legend-item"><span class="badge return">RETURN</span> flow trả về</div>
                        <div class="legend-item"><span class="badge loop">LOOP</span> flow lặp</div>
                        <div class="legend-item"><span class="badge exit">EXIT</span> flow thoát loop</div>
                        <div class="legend-item"><span class="badge user">UserDecision</span> user tự quyết định thoát loop</div>
                    </div>

                    <div class="loop-box">
                        Mockup này chưa vẽ line graph thật.
                        <br>Phần “vòng tròn” đang thể hiện qua:
                        <br>- transition `From -> To`
                        <br>- badge `LOOP`
                        <br>- self-loop hoặc loop-group
                        <br>- nút thoát `EXIT`
                    </div>

                    <div class="drop-hint">
                        Cách test nhanh:
                        <br>1. Chọn Workflow Flow Type ở panel giữa
                        <br>2. Kéo object từ toolbox sang tree
                        <br>3. Click node để sửa data / flow type
                        <br>4. Tạo transition ở panel bên phải
                        <br>5. Thử case loop với UserDecision
                        <br>6. Xem payload JSON cuối màn hình
                    </div>
                </div>
            </div>

            <!-- TREE -->
            <div class="card">
                <div class="card-header">
                    <div class="card-title">Tree Designer</div>
                    <div class="card-sub">jsTree để dựng node hierarchy</div>
                </div>
                <div class="card-body">
                    <div class="section-title">Workflow Header</div>
                    <div id="workflowForm"></div>

                    <div class="toolbar" style="margin-top:12px;">
                        <div id="btnAddRoot"></div>
                        <div id="btnAddChild"></div>
                        <div id="btnRename"></div>
                        <div id="btnDevare"></div>
                        <div id="btnExpand"></div>
                        <div id="btnCollapse"></div>
                    </div>

                    <div id="treeWorkflow"></div>
                </div>
            </div>

            <!-- NODE EDITOR -->
            <div class="card">
                <div class="card-header">
                    <div class="card-title">Node Review</div>
                    <div class="card-sub">Sửa node bằng form hoặc JSON raw</div>
                </div>
                <div class="card-body">
                    <div id="nodeForm"></div>

                    <div class="section-title">Node JSON Raw</div>
                    <textarea id="nodeJsonEditor" class="node-json-editor" placeholder="Select node to edit raw JSON..."></textarea>

                    <div class="mini-row">
                        <div id="btnApplyNodeForm"></div>
                        <div id="btnApplyNodeJson"></div>
                        <div id="btnRefreshNodeJson"></div>
                        <div id="btnCreateflow"></div>
                    </div>
                </div>
            </div>

            <!-- TRANSITION + PAYLOAD -->
            <div class="card card-last" style="width: 1200px;">
                <div class="card-header">
                    <div class="card-title">Transition / Loop / Payload Review</div>
                    <div class="card-sub">Mockup để review trước khi trích xuất DB tables</div>
                </div>
                <div class="card-body">
                    <div style="display:grid;grid-template-columns:420px 1fr;gap:14px;">
                        <div>
                            <div class="section-title">Transition Editor</div>
                            <div id="transitionForm"></div>
                            <div class="mini-row" style="margin-top:10px;">
                                <div id="btnAddTransition"></div>
                                <div id="btnResetTransitionForm"></div>
                            </div>
                        </div>

                        <!--  <div>
                             <div class="section-title">Transition Preview</div>
                             <div id="transitionPreview" class="transition-list"></div>
                         </div> -->

                        <div>
                            <div class="section-title">Payload Preview</div>
                            <div id="payloadBox" class="json-box"></div>
                        </div>
                    </div>

                    <div class="section-title">Flat Node Preview</div>
                    <div id="nodeGrid"></div>
                </div>
            </div>
        </div>
    </div>

    <script>
        var selectedNodeId = null;
        var nodeFormInstance = null;
        var workflowFormInstance = null;
        var transitionFormInstance = null;
        var nodeGridInstance = null;
        var dragToolData = null;

        var workflowHeader = {
            workflowCode: "WF_TMIV_MAIN",
            workflowName: "TMIV Main Workflow",
            flowType: "Quotation",
            versionNo: 1,
            isActive: true
        };

        var workflowTreeData = [
            { id: "FO", parent: "#", text: "FO", type: "department", code: "FO", orderNo: 1, stepRole: "Front Office", departmentName: "FO", levelNo: 1, flowType: "Both", allowLoop: false, loopGroup: "" },
            { id: "TS", parent: "FO", text: "TS", type: "department", code: "TS", orderNo: 1, stepRole: "Technical Support", departmentName: "TS", levelNo: 2, flowType: "Quotation", allowLoop: false, loopGroup: "" },
            { id: "UW", parent: "TS", text: "UW", type: "department", code: "UW", orderNo: 1, stepRole: "Underwriting", departmentName: "UW", levelNo: 3, flowType: "Quotation", allowLoop: false, loopGroup: "" },
            { id: "CLIENT", parent: "FO", text: "Client", type: "actor", code: "CLIENT", orderNo: 2, stepRole: "Client", departmentName: "External", levelNo: 2, flowType: "Both", allowLoop: true, loopGroup: "CLIENT_REVIEW" },
            { id: "PM", parent: "CLIENT", text: "PM", type: "department", code: "PM", orderNo: 1, stepRole: "Policy Management", departmentName: "PM", levelNo: 3, flowType: "PolicyIssuance", allowLoop: false, loopGroup: "" }
        ];

        var transitions = [
            {
                fromNodeId: "FO",
                toNodeId: "TS",
                actionCode: "SUBMIT_TS",
                actionName: "Submit To TS",
                flowType: "Quotation",
                isReturn: false,
                isLoop: false,
                loopGroup: "",
                loopExitMode: "None",
                maxLoopCount: null,
                isExitTransition: false,
                userDecisionLabel: "",
                conditionJson: ""
            },
            {
                fromNodeId: "CLIENT",
                toNodeId: "CLIENT",
                actionCode: "REVISE_AGAIN",
                actionName: "Revise Again",
                flowType: "Both",
                isReturn: false,
                isLoop: true,
                loopGroup: "CLIENT_REVIEW",
                loopExitMode: "UserDecision",
                maxLoopCount: null,
                isExitTransition: false,
                userDecisionLabel: "Continue Revision",
                conditionJson: ""
            },
            {
                fromNodeId: "CLIENT",
                toNodeId: "PM",
                actionCode: "EXIT_LOOP_AND_SUBMIT_PM",
                actionName: "Approve And Exit",
                flowType: "PolicyIssuance",
                isReturn: false,
                isLoop: true,
                loopGroup: "CLIENT_REVIEW",
                loopExitMode: "UserDecision",
                maxLoopCount: null,
                isExitTransition: true,
                userDecisionLabel: "Approve And Exit",
                conditionJson: ""
            }
        ];

        $(function () {
            initWorkflowForm();
            initNodeForm();
            initTransitionForm();
            initButtons();
            initTree();
            initToolboxDrag();
            initGrid();
            renderTransitionPreview();
            buildPayloadPreview();
        });

        function initWorkflowForm() {
            $("#workflowForm").dxForm({
                formData: workflowHeader,
                labelLocation: "top",
                colCount: 2,
                items: [
                    { dataField: "workflowCode", label: { text: "Workflow Code" } },
                    { dataField: "workflowName", label: { text: "Workflow Name" } },
                    {
                        dataField: "flowType",
                        label: { text: "Workflow Flow Type" },
                        editorType: "dxSelectBox",
                        editorOptions: {
                            dataSource: ["Quotation", "PolicyIssuance", "Both"],
                            onValueChanged: function () {
                                syncWorkflowHeader();
                            }
                        }
                    },
                    {
                        dataField: "versionNo",
                        label: { text: "Version No" },
                        editorType: "dxNumberBox",
                        editorOptions: {
                            min: 1,
                            onValueChanged: function () {
                                syncWorkflowHeader();
                            }
                        }
                    },
                    {
                        dataField: "isActive",
                        label: { text: "Active" },
                        editorType: "dxSwitch",
                        editorOptions: {
                            onValueChanged: function () {
                                syncWorkflowHeader();
                            }
                        }
                    }
                ],
                onInitialized: function (e) {
                    workflowFormInstance = e.component;
                }
            });
        }

        function initNodeForm() {
            $("#nodeForm").dxForm({
                formData: {},
                labelLocation: "top",
                colCount: 2,
                items: [
                    { dataField: "id", label: { text: "Id" }, editorOptions: { readOnly: true } },
                    { dataField: "parent", label: { text: "Parent" }, editorOptions: { readOnly: true } },
                    { dataField: "text", label: { text: "Display Text" } },
                    { dataField: "code", label: { text: "Code" } },
                    {
                        dataField: "type",
                        label: { text: "Type" },
                        editorType: "dxSelectBox",
                        editorOptions: {
                            dataSource: ["department", "actor", "condition", "system"]
                        }
                    },
                    {
                        dataField: "flowType",
                        label: { text: "Node Flow Type" },
                        editorType: "dxSelectBox",
                        editorOptions: {
                            dataSource: ["Quotation", "PolicyIssuance", "Both"]
                        }
                    },
                    {
                        dataField: "orderNo",
                        label: { text: "Order No" },
                        editorType: "dxNumberBox",
                        editorOptions: { min: 0 }
                    },
                    { dataField: "stepRole", label: { text: "Step Role" } },
                    { dataField: "departmentName", label: { text: "Department Name" } },
                    {
                        dataField: "levelNo",
                        label: { text: "Level No" },
                        editorType: "dxNumberBox",
                        editorOptions: { min: 1 }
                    },
                    {
                        dataField: "allowLoop",
                        label: { text: "Allow Loop" },
                        editorType: "dxSwitch"
                    },
                    {
                        dataField: "loopGroup",
                        label: { text: "Loop Group" }
                    }
                ],
                onInitialized: function (e) {
                    nodeFormInstance = e.component;
                }
            });
        }

        function initTransitionForm() {
            $("#transitionForm").dxForm({
                formData: getEmptyTransition(),
                labelLocation: "top",
                colCount: 2,
                items: [
                    {
                        dataField: "fromNodeId",
                        label: { text: "From Node" },
                        editorType: "dxSelectBox",
                        editorOptions: {
                            dataSource: [],
                            valueExpr: "id",
                            displayExpr: "text",
                            searchEnabled: true
                        }
                    },
                    {
                        dataField: "toNodeId",
                        label: { text: "To Node" },
                        editorType: "dxSelectBox",
                        editorOptions: {
                            dataSource: [],
                            valueExpr: "id",
                            displayExpr: "text",
                            searchEnabled: true
                        }
                    },
                    {
                        dataField: "actionCode",
                        label: { text: "Action Code" }
                    },
                    {
                        dataField: "actionName",
                        label: { text: "Action Name" }
                    },
                    {
                        dataField: "flowType",
                        label: { text: "Transition Flow Type" },
                        editorType: "dxSelectBox",
                        editorOptions: {
                            dataSource: ["Quotation", "PolicyIssuance", "Both"]
                        }
                    },
                    {
                        dataField: "isReturn",
                        label: { text: "Return Flow" },
                        editorType: "dxSwitch"
                    },
                    {
                        dataField: "isLoop",
                        label: { text: "Loop Flow" },
                        editorType: "dxSwitch"
                    },
                    {
                        dataField: "loopGroup",
                        label: { text: "Loop Group" }
                    },
                    {
                        dataField: "loopExitMode",
                        label: { text: "Loop Exit Mode" },
                        editorType: "dxSelectBox",
                        editorOptions: {
                            dataSource: ["None", "UserDecision", "Condition", "MaxIteration"]
                        }
                    },
                    {
                        dataField: "maxLoopCount",
                        label: { text: "Max Loop Count" },
                        editorType: "dxNumberBox",
                        editorOptions: { min: 1 }
                    },
                    {
                        dataField: "isExitTransition",
                        label: { text: "Exit Transition" },
                        editorType: "dxSwitch"
                    },
                    {
                        dataField: "userDecisionLabel",
                        label: { text: "User Decision Label" }
                    },
                    {
                        dataField: "conditionJson",
                        label: { text: "Condition JSON" },
                        editorType: "dxTextArea",
                        editorOptions: { minHeight: 100 },
                        colSpan: 2
                    }
                ],
                onInitialized: function (e) {
                    transitionFormInstance = e.component;
                    refreshTransitionNodeLookup();
                }
            });
        }

        function initButtons() {
            $("#btnAddRoot").dxButton({
                text: "Add Root",
                icon: "add",
                onClick: function () {
                    createNodeFromTool({ type: "department", text: "New Root" }, "#");
                }
            });

            $("#btnAddChild").dxButton({
                text: "Add Child",
                icon: "plus",
                onClick: function () {
                    if (!selectedNodeId) return notify("Please select parent node first", "warning");
                    createNodeFromTool({ type: "department", text: "New Child" }, selectedNodeId);
                }
            });

            $("#btnRename").dxButton({
                text: "Rename",
                icon: "edit",
                onClick: function () {
                    var tree = $("#treeWorkflow").jstree(true);
                    if (!selectedNodeId) return notify("Please select node first", "warning");
                    tree.edit(selectedNodeId);
                }
            });

            $("#btnDevare").dxButton({
                text: "Devare",
                icon: "trash",
                type: "danger",
                onClick: function () {
                    var tree = $("#treeWorkflow").jstree(true);
                    if (!selectedNodeId) return notify("Please select node first", "warning");

                    DevExpress.ui.dialog.confirm("Devare selected node and all children?", "Confirm")
                        .done(function(ok) {
                            if (!ok) return;

                            var devaringIds = collectDescendantIds(tree, selectedNodeId);
                            devaringIds.push(selectedNodeId);

                            tree.devare_node(selectedNodeId);
                            transitions = transitions.filter(x =>
                                !devaringIds.includes(x.fromNodeId) &&
                                !devaringIds.includes(x.toNodeId)
                            );


        function safeParseJson(json, fallbackValue) {
            try {
                if (json == null || json === "") return fallbackValue;
                return JSON.parse(json);
            } catch (err) {
                return fallbackValue;
            }
        }

        function parseConditionValueByType(dataType, value) {
            if (dataType === "number") {
                var n = Number(value);
                return isNaN(n) ? 0 : n;
            }

            if (dataType === "boolean") {
                if (value === true || value === "true" || value === "1" || value === 1) return true;
                return false;
            }

            if (dataType === "array") {
                if (!value) return [];
                try {
                    var parsed = JSON.parse(value);
                    return Array.isArray(parsed) ? parsed : [parsed];
                } catch (err) {
                    return String(value)
                        .split(",")
                        .map(x => x.trim())
                        .filter(Boolean);
                }
            }

            return value ?? "";
        }

        function mapBuilderRuleToJson(rule) {
            if ((rule.source || "") === "custom") {
                return {
                    type: "rule",
                    validateStyle: rule.validateStyle,
                    staticValue:  rule.staticValue,
                    message: rule.message,
                    source: rule.source,
                    handler: rule.customHandler || "",
                    args: safeParseJson(rule.customArgs, {}) || {},
                    operator: rule.operator || "=",
                    value: parseConditionValueByType(rule.dataType, rule.value)
                };
            }

            return {
                type: rule.type,
                validateStyle: rule.validateStyle,
                staticValue:  rule.staticValue,
                message: rule.message,
                source: rule.source || "payload",
                field: rule.field || "",
                dataType: rule.dataType || "string",
                operator: rule.operator || "=",
                value: parseConditionValueByType(rule.dataType, rule.value)
            };
        }

        function buildConditionJsonFromState() {
            if (!conditionRuleState.rules.length) return "";

            if (conditionRuleState.rules.length === 1) {
                return JSON.stringify(mapBuilderRuleToJson(conditionRuleState.rules[0]), null, 2);
            }

            return JSON.stringify({
                type: "group",
                operator: conditionRuleState.rootOperator || "AND",
                children: conditionRuleState.rules.map(mapBuilderRuleToJson)
            }, null, 2);
        }

        function refreshConditionPreviewBox() {
            var preview = buildConditionJsonFromState();
            $("#conditionPreviewBox_@Convert.ToInt32(ViewData["Id"])").text(preview || "{}");
        }

        function syncConditionJsonToTransitionForm() {
            if (!transitionFormInstance) return;
            var fd = transitionFormInstance.option("formData") || {};
            fd.conditionJson = buildConditionJsonFromState() || "";
            transitionFormInstance.option("formData", fd);
        }

        function toggleConditionBuilderFields(source) {
            if (!conditionBuilderInstance) return;
            var isCustom = source === "custom";

            conditionBuilderInstance.itemOption("field", "visible", !isCustom);
            conditionBuilderInstance.itemOption("customHandler", "visible", isCustom);
            conditionBuilderInstance.itemOption("customArgs", "visible", isCustom);
        }

        function clearConditionBuilder() {
            conditionRuleState = {
                rootOperator: "AND",
                rules: []
            };

            if (conditionBuilderInstance) {
                conditionBuilderInstance.option("formData", getDefaultConditionBuilderData());
                toggleConditionBuilderFields("payload");
            }

            $("#conditionPreviewBox_@Convert.ToInt32(ViewData["Id"])").text("{}");

            if (transitionFormInstance) {
                var tf = transitionFormInstance.option("formData") || {};
                tf.conditionJson = "";
                transitionFormInstance.option("formData", tf);
            }
        }

        function pushCurrentBuilderRule() {
            if (!conditionBuilderInstance) return;

            var fd = conditionBuilderInstance.option("formData") || {};
            conditionRuleState.rootOperator = fd.rootOperator || "AND";
            conditionRuleState.rules.push({
                type: fd.type,
                validateStyle: fd.validateStyle,
                staticValue:  fd.staticValue,
                message: fd.message,
                source: fd.source || "payload",
                field: fd.field || "",
                dataType: fd.dataType || "string",
                operator: fd.operator || "=",
                value: fd.value ?? "",
                customHandler: fd.customHandler || "",
                customArgs: fd.customArgs || ""
            });

            refreshConditionPreviewBox();
        }

        function wrapLastRuleAsNotGroup() {
            if (!conditionBuilderInstance) return;

            var fd = conditionBuilderInstance.option("formData") || {};
            var wrapped = {
                type: "group",
                operator: "NOT",
                children: [mapBuilderRuleToJson(fd)]
            };

            $("#conditionPreviewBox_@Convert.ToInt32(ViewData["Id"])").text(JSON.stringify(wrapped, null, 2));

            if (transitionFormInstance) {
                var tf = transitionFormInstance.option("formData") || {};
                tf.conditionJson = JSON.stringify(wrapped, null, 2);
                transitionFormInstance.option("formData", tf);
            }
        }


 @page "{pageNum:int?}/{guid}"
@model WorkflowDefinition_FormModel
@{


}




<style>


    * {
        box-sizing: border-box
    }

    body {
        font-family: Segoe UI, sans-serif;
        background: #f5f7fb;
        margin: 0
    }

    .title {
        font-size: 24px;
        font-weight: 700;
        margin: 12px
    }
    /* ✅ NEW: horizontal scroll layout */
    .layout {
        display: flex;
        flex-direction: column; /* đổi từ row -> column */

        gap: 16px;
        padding: 12px;
        overflow-y: auto;
        overflow-x: hidden;
        width: 100%;
    }

    .card-h-last {
        min-width: 600px; /* transition bigger */
    }




    .card-h-title {
        font-size: 15px;
        font-weight: 700;
        color: #1e293b
    }

    .card-h-sub {
        font-size: 12px;
        color: #64748b
    }

    .card-h {
        min-width: 600px;
        background: #fff;
        border: 1px solid #e6ebf3;
        border-radius: 16px;
        box-shadow: 0 6px 18px rgba(0,0,0,.05);
        display: flex;
        flex-direction: row; /* đổi từ column -> row */

        overflow: hidden;
    }


    .card-h-header {
        width: 160px; /* vùng title */
        min-width: 160px;
        padding: 14px 18px;
        border-bottom: none;
        border-right: 1px solid #edf2f7;
        background: linear-gradient(#fff,#f9fbff);
        display: flex;
        flex-direction: column;
        justify-content: center;
    }


    .card-h-body {
        flex: 1;
        padding: 14px;
        overflow: auto;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .toolbox {
        display: grid;
        gap: 10px
    }


    .tool-item {
        border: 1px solid #dbe7ff;
        background: #f6faff;
        border-radius: 14px;
        padding: 12px;
        cursor: grab;
    }

        .tool-item:hover {
            background: #eef4ff;
            border-color: #3b82f6;
        }


    #treeWorkflow {
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        min-height: 450px;
        background: #fff;
        padding: 8px;
    }

    .json-box {
        background: #020617;
        color: #38bdf8;
        border-radius: 12px;
        padding: 12px;
        font-size: 12px;
        max-height: 250px;
        overflow: auto;
    }

    .node-json-editor {
        border: 1px solid #dbe0ea;
        background: #f8fafc;
        border-radius: 12px;
        padding: 10px;
    }

    .toolbar, .mini-row {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    /* scrollbar đẹp */
    .layout::-webkit-scrollbar {
        height: 8px
    }

    .layout::-webkit-scrollbar-thumb {
        background: #cbd5f5;
        border-radius: 6px
    }


    .jstree-clicked {
        background: #e0f2fe !important
    }

    :root {
        --bg: #f4f7fb;
        --panel: #ffffff;
        --border: #dbe2ea;
        --text: #243447;
        --muted: #6b7c93;
        --quotation: #2563eb;
        --policy: #16a34a;
        --both: #7c3aed;
        --return: #ef4444;
        --loop: #f59e0b;
        --active: #f59e0b;
        --done: #10b981;
        --pending: #94a3b8;
    }

    * {
        box-sizing: border-box
    }


    .draw-container {
        display: grid;
        grid-template-columns: 380px 1fr;
        height: 80%;
        overflow: hidden;
    }

    .sidebar {
        background: #fff;
        border-right: 1px solid var(--border);
        padding: 16px;
        overflow: auto;
    }

    .main {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .toolbar {
        min-height: 60px;
        border-bottom: 1px solid var(--border);
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 16px;
        gap: 12px;
        flex-wrap: wrap;
    }

    .toolbar-left, .toolbar-right {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .title {
        font-size: 20px;
        font-weight: 700;
        margin: 0 0 6px 0;
    }

    .sub {
        font-size: 13px;
        color: var(--muted);
        line-height: 1.5;
        margin-bottom: 14px;
    }
    /*
                .card-h {
                    background: var(--panel);
                    border: 1px solid var(--border);
                    border-radius: 14px;
                    padding: 12px;
                    margin-bottom: 12px;
                }

                    .card-h h3 {
                        margin: 0 0 10px 0;
                        font-size: 14px;
                    } */


    .card-h-in-frame {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 12px;
        margin-bottom: 12px;
    }


        .card-h-in-frame .header-in-frame {
            margin: 0 0 10px 0;
            font-size: 14px;
        }


    .badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 10px;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: #fff;
        font-size: 12px;
        color: #334155;
    }

    .legend-row {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
        font-size: 13px;
    }

    .dot {
        width: 14px;
        height: 14px;
        border-radius: 999px;
        flex: 0 0 14px;
    }

        .dot.quotation {
            background: var(--quotation)
        }

        .dot.policy {
            background: var(--policy)
        }

        .dot.both {
            background: var(--both)
        }

        .dot.active {
            background: var(--active)
        }

        .dot.done {
            background: var(--done)
        }

        .dot.pending {
            background: var(--pending)
        }

    .line {
        width: 28px;
        border-top: 3px solid #64748b;
        flex: 0 0 28px;
    }

        .line.return {
            border-top-color: var(--return);
            border-top-style: dashed;
        }

        .line.loop {
            border-top-color: var(--loop);
        }

    textarea {
        width: 100%;
        min-height: 390px;
        resize: vertical;
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 12px;
        font-family: Consolas, monospace;
        font-size: 12px;
        line-height: 1.5;
        outline: none;
    }

    .btn-row {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 10px;
    }

    button {
        border: none;
        background: #2563eb;
        color: #fff;
        padding: 9px 12px;
        border-radius: 10px;
        cursor: pointer;
        font-weight: 600;
    }

        button.secondary {
            background: #475569;
        }

        button.success {
            background: #16a34a;
        }

        button.warning {
            background: #f59e0b;
            color: #1f2937;
        }

    .error {
        margin-top: 10px;
        display: none;
        white-space: pre-wrap;
        background: #fef2f2;
        color: #b91c1c;
        border: 1px solid #fecaca;
        border-radius: 10px;
        padding: 10px 12px;
        font-size: 12px;
    }

    .canvas-wrap {
        flex: 1;
        min-height: 0;
        padding: 16px;
        overflow: auto;
    }

    /* #canvas_@ViewData["RandomNumber"] { */
     #canvas_@ViewData["RandomNumber"].ToString() { 
            position: relative;
            min-width: 1400px;
            min-height: 760px;
            background: linear-gradient(to right, rgba(203,213,225,.35) 1px, transparent 1px), linear-gradient(to bottom, rgba(203,213,225,.35) 1px, transparent 1px);
            background-size: 24px 24px;
            background-color: #fff;
            border: 1px solid var(--border);
            border-radius: 18px;
            box-shadow: 0 10px 28px rgba(15,23,42,0.06);
            overflow:  auto;
            }

    .node {
        position: absolute;
        width: 180px;
        min-height: 88px;
        border-radius: 14px;
        border: 2px solid #cfd8e3;
        background: #fff;
        padding: 10px 12px;
        box-shadow: 0 8px 18px rgba(0,0,0,0.08);
        text-align: center;
        z-index: 2;
        transition: .15s ease;
        cursor: move;
        user-select: none;
    }

        .node .node-title {
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .node .node-meta {
            font-size: 12px;
            line-height: 1.45;
            color: #64748b;
        }

        .node.flow-quotation {
            border-color: var(--quotation)
        }

        .node.flow-policy {
            border-color: var(--policy)
        }

        .node.flow-both {
            border-color: var(--both)
        }

        .node.active {
            border-color: var(--active);
            background: #fffaf0;
            box-shadow: 0 0 0 4px rgba(245,158,11,0.15), 0 12px 22px rgba(245,158,11,0.18);
        }

        .node.done {
            background: #f0fdf4;
        }

        .node.pending {
            opacity: .94;
        }

    .layer-label {
        position: absolute;
        top: 14px;
        font-size: 12px;
        color: #64748b;
        background: #f8fafc;
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 4px 10px;
        z-index: 1;
    }

    .jtk-overlay {
        font-size: 11px !important;
        color: #334155 !important;
        background: rgba(255,255,255,0.96);
        border: 1px solid #dbe2ea;
        padding: 4px 8px;
        border-radius: 999px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.06);
    }

    .note {
        font-size: 12px;
        color: var(--muted);
        line-height: 1.5;
    }

    .status-ok {
        color: #15803d;
    }

    code {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        padding: 2px 6px;
        border-radius: 6px;
    }

    .page {
        display: grid;
        grid-template-columns: 240px 1fr 430px;
        height: 100vh;
    }

    .sidebar {
        border-right: 1px solid #dbe2ea;
        background: #fff;
        padding: 14px;
        overflow: auto;
    }

        .sidebar h3 {
            margin: 0 0 12px;
            font-size: 16px;
        }

    .sidebarHint {
        font-size: 12px;
        color: #64748b;
        line-height: 1.5;
        margin-bottom: 12px;
    }

    .palette {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .paletteItem {
        border: 1px solid #dbe2ea;
        border-radius: 12px;
        background: #fff;
        padding: 12px;
        cursor: grab;
        user-select: none;
        box-shadow: 0 4px 12px rgba(0,0,0,.05);
        transition: all .15s ease;
    }

        .paletteItem:hover {
            background: #f8fafc;
            transform: translateY(-1px);
        }

    .paletteTitle {
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .paletteMeta {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    .mainPane {
        padding: 14px;
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .toolbar {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 10px;
    }

    .btn {
        border: 1px solid #cfd6df;
        background: #fff;
        border-radius: 10px;
        padding: 8px 12px;
        cursor: pointer;
        font-size: 13px;
    }

        .btn:hover {
            background: #f8fafc;
        }

    .legend {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 10px;
    }

    .tag {
        display: inline-flex;
        align-items: center;
        height: 24px;
        padding: 0 9px;
        border-radius: 999px;
        border: 1px solid #dbe2ea;
        background: #fff;
        font-size: 11px;
        color: #334155;
    }

        .tag.active {
            background: #dbeafe;
            border-color: #93c5fd;
            color: #1d4ed8;
        }

        .tag.done {
            background: #dcfce7;
            border-color: #86efac;
            color: #166534;
        }

        .tag.pending {
            background: #fef3c7;
            border-color: #fcd34d;
            color: #92400e;
        }

        .tag.loop {
            background: #ffedd5;
            border-color: #fdba74;
            color: #9a3412;
        }

        .tag.return {
            background: #fee2e2;
            border-color: #fca5a5;
            color: #991b1b;
        }

        .tag.exit {
            background: #ede9fe;
            border-color: #c4b5fd;
            color: #6d28d9;
        }

    .canvas {
        position: relative;
        flex: 1;
        border: 1px solid #dbe2ea;
        border-radius: 16px;
        background: linear-gradient(to right, rgba(0,0,0,.04) 1px, transparent 1px), linear-gradient(to bottom, rgba(0,0,0,.04) 1px, transparent 1px), #fff;
        background-size: 24px 24px;
        overflow: hidden;
        min-height: 420px;
    }

        .canvas.dragOver {
            background: linear-gradient(to right, rgba(59,130,246,.08) 1px, transparent 1px), linear-gradient(to bottom, rgba(59,130,246,.08) 1px, transparent 1px), #eff6ff;
            background-size: 24px 24px;
        }

    .rightPane {
        border-left: 1px solid #dbe2ea;
        background: #fff;
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .panelHeader {
        padding: 14px 16px;
        border-bottom: 1px solid #eef2f7;
        font-weight: 700;
    }

    .panelBody {
        padding: 12px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        min-height: 0;
        flex: 1;
    }

    .// statusBar {
        font-size: 12px;
        color: #475569;
    }

    .sectionTitle {
        font-size: 12px;
        font-weight: 700;
        color: #475569;
        margin-top: 4px;
    }

    .infoBox {
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 12px;
        background: #fafafa;
        font-size: 12px;
        line-height: 1.5;
        max-height: 220px;
        overflow: auto;
        white-space: pre-wrap;
    }

    textarea {
        width: 100%;
        flex: 1;
        resize: none;
        border: 1px solid #dbe2ea;
        border-radius: 12px;
        padding: 12px;
        font-family: Consolas, monospace;
        font-size: 12px;
        line-height: 1.45;
        outline: none;
    }

    .node {
        position: absolute;
        width: 200px;
        min-height: 80px;
        padding: 10px 12px;
        border-radius: 14px;
        background: #fff;
        border: 2px solid #cbd5e1;
        box-shadow: 0 8px 18px rgba(0,0,0,.08);
        cursor: move;
        user-select: none;
        transition: all .15s ease;
    }

        .node:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 22px rgba(0,0,0,.12);
        }

        .node.selected {
            box-shadow: 0 0 0 4px rgba(37,99,235,.12), 0 10px 24px rgba(0,0,0,.12);
            border-color: #2563eb;
        }

        .node.activeNode {
            border-color: #2563eb;
            background: #eff6ff;
        }

        .node.completedNode {
            border-color: #16a34a;
            background: #f0fdf4;
        }

        .node.pendingNode {
            border-color: #d97706;
            background: #fff7ed;
        }

        .node.allowLoopNode::after {
            content: "↻";
            position: absolute;
            top: -8px;
            right: -8px;
            width: 24px;
            height: 24px;
            border-radius: 999px;
            background: #fb923c;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            box-shadow: 0 4px 10px rgba(0,0,0,.15);
        }
    /* base node vẫn giữ */
    .node {
        position: absolute;
        min-width: 140px;
        padding: 10px;
        border-radius: 8px;
        background: #fff;
        border: 1px solid #ccc;
        text-align: center;
        transition: all 0.2s ease;
    }


        .node.flow-start {
            background-color: rgba(34, 197, 94, 0.1);
            border: 2px solid #22c55e;
            color: #166534;
        }

        .node.flow-end {
            background-color: rgba(239, 68, 68, 0.1);
            border: 2px solid #ef4444;
            color: #7f1d1d;
        }


        .node.flow-start,
        .node.flow-end {
            width: 130px;
            height: 130px;
            border-radius: 50%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 12px;
            box-sizing: border-box;
        }



    .nodeTitle {
        font-size: 15px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .nodeMeta {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    .meta {
        display: inline-flex;
        align-items: center;
        height: 22px;
        padding: 0 8px;
        border-radius: 999px;
        font-size: 11px;
        border: 1px solid #dbe2ea;
        background: #f8fafc;
        color: #334155;
    }

    .flow-both {
        background: #f8fafc;
    }

    .flow-quotation {
        background: #ecfeff;
        border-color: #a5f3fc;
        color: #155e75;
    }

    .flow-policy {
        background: #f5f3ff;
        border-color: #c4b5fd;
        color: #5b21b6;
    }

    .jtk-connector {
        z-index: 4;
    }

    .jtk-endpoint {
        z-index: 5;
    }

    .jtk-overlay {
        z-index: 6;
    }

    .aLabel {
        background: rgba(255,255,255,.94);
        border: 1px solid #e5e7eb;
        border-radius: 999px;
        padding: 2px 8px;
        font-size: 11px;
        color: #334155;
    }
</style>
<body>
    <div class="title">Workflow Designer</div>
    <div class="dExForm">
        <div class="sub">
        </div>

        <div class="layout">
            <!-- TOOLBOX -->
            <div class="card-h">
                <div class="card-h-header">
                    <div class="card-h-title">Toolbox</div>
                    <div class="card-h-sub">Drag item</div>
                </div>
                <div class="card-h-body">
                    <div class="toolbox">
                        <div class="tool-item" draggable="true" data-type="department" data-text="New Department">
                            <div class="name">Department</div>
                            <div class="desc">Ví dụ FO / TS / UW / LMKT / PM</div>
                        </div>
                    </div>

                    
                    <div>
                        <div class="section-title">Payload Preview</div>
                        <div id="payloadBox_@Convert.ToInt32(ViewData["Id"])" class="json-box"></div>
                    </div>
                </div>
            </div>

            <!-- TREE -->
            <div class="card-h">
                <div class="card-h-header">
                    <div class="card-h-title">Tree Designer</div>
                    <div class="card-h-sub">jsTree</div>
                </div>
                <div class="card-h-body">
                    <div class="section-title">Workflow Header</div>
                    <div class="toolbar" style="margin-top:12px;">
                        <div id="btnAddRoot_@Convert.ToInt32(ViewData["Id"])"></div>
                        <div id="btnAddChild_@Convert.ToInt32(ViewData["Id"])"></div>
                        <div id="btnDelete_@Convert.ToInt32(ViewData["Id"])"></div>
                        <div id="btnExpand_@Convert.ToInt32(ViewData["Id"])"></div>
                        <div id="btnCollapse_@Convert.ToInt32(ViewData["Id"])"></div>
                    </div>
                    <div style="background-color: antiquewhite; min-height:500px;">
                        <div id="treeWorkflow_@Convert.ToInt32(ViewData["Id"])"></div>

                    </div>
                </div>
            </div>

            <!-- NODE EDITOR -->
            <div class="card-h">
                <div class="card-h-header">
                    <div class="card-h-title">Node Review</div>
                    <div class="card-h-sub">Change node properties</div>
                </div>
                <div class="card-h-body">
                    <div id="nodeForm_@Convert.ToInt32(ViewData["Id"])"></div>

                    <div class="section-title">Node JSON Raw</div>
                    <textarea id="nodeJsonEditor_@Convert.ToInt32(ViewData["Id"])" class="node-json-editor" placeholder="Select node to edit raw JSON..."></textarea>

                    <div class="mini-row">
                        <div id="btnRefreshNodeJson_@Convert.ToInt32(ViewData["Id"])"></div>
                        <div id="btnApplyNodeJson_@Convert.ToInt32(ViewData["Id"])"></div>
                        <div id="btnApplyNodeForm_@Convert.ToInt32(ViewData["Id"])"></div>
                        <div id="btnCreateflow_@Convert.ToInt32(ViewData["Id"])"></div>
                        <div id="btnBuild_@Convert.ToInt32(ViewData["Id"])"></div>
                    </div>
                </div>
            </div>
      @*   </div>
        <div class="dExForm"> *@
            <!-- TRANSITION + PAYLOAD -->
            <div class="card-h card-h-last" style="">
                <div class="card-h-header">
                    <div class="card-h-title">Transition / Loop / Payload Review</div>
                    <div class="card-h-sub">Preview</div>
                </div>
                <div class="card-h-body">
                    <div style="">
                        <div>
                            <div class="section-title">Transition Editor</div>

                            <div class="condition-builder-card-h">
                                <div class="section-title">Mini Condition Builder</div>
                                <div id="conditionBuilderForm_@Convert.ToInt32(ViewData["Id"])"></div>

                                <div class="mini-row" style="margin-top:10px;">
                                    <div id="btnAddConditionRule_@Convert.ToInt32(ViewData["Id"])"></div>
                                    <div id="btnGenerateConditionJson_@Convert.ToInt32(ViewData["Id"])"></div>
                                    <div id="btnWrapNotCondition_@Convert.ToInt32(ViewData["Id"])"></div>
                                    <div id="btnClearConditionBuilder_@Convert.ToInt32(ViewData["Id"])"></div>
                                </div>

                                <div class="section-title" style="margin-top:10px;">Condition Preview</div>
                                <div id="conditionPreviewBox_@Convert.ToInt32(ViewData["Id"])" class="condition-builder-preview json-box">{}</div>
                                <div class="condition-builder-note">
                                    Chọn field/operator/value ở form mini, bấm Add Rule hoặc Generate JSON rồi review lại tại ô Condition JSON bên dưới trước khi Add Transition.
                                </div>
                            </div>

                            <div id="transitionForm_@Convert.ToInt32(ViewData["Id"])"></div>

        function getEmptyTransition(fromNodeId) {
            return {
                fromNodeId: fromNodeId || "",
                toNodeId: "",
                actionCode: "",
                actionName: "",
                flowType: "Both",
                isReturn: false,
                isLoop: false,
                loopGroup: "",
                loopExitMode: "None",
                maxLoopCount: null,
                isExitTransition: false,
                userDecisionLabel: "",
                conditionJson: ""
            };
        }

        function getNextOrderNo(parentId) {
            var tree = $("#treeWorkflow_@Convert.ToInt32(ViewData["Id"])").jstree(true);
            if (!tree) return 1;

            if (parentId === "#") {
                var roots = tree.get_json("#");
                return roots.length + 1;
            }

            var parent = tree.get_node(parentId);
            return (parent && parent.children) ? (parent.children.length + 1) : 1;
        }

        function collectDescendantIds(tree, nodeId) {
            var node = tree.get_node(nodeId);
            return node && node.children_d ? node.children_d.slice() : [];
        }

        function extractPlainTextFromNode(nodeId) {
            var found = workflowTreeData.find(x => x.id === nodeId);
            return found ? found.text : nodeId;
        }

        function extractTextFromHtml(html) {
            var div = document.createElement("div");
            div.innerHTML = html || "";
            var nodeText = div.querySelector(".tree-node-text");
            if (nodeText) return nodeText.textContent.trim();
            return div.textContent.trim();
        }

        function generateNodeId() {
            return "NODE_" + Date.now();
        }

        function notify(message, type) {
            DevExpress.ui.notify(message, type || "info", 1800);

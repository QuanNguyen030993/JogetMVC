            var loopBadge = x.allowLoop ? `<span class="tree-node-mini loop">LOOP</span>` : "";

            return `
                        <span class="tree-node-wrap">
                            <span class="tree-node-text">${escapeHtml(x.text)}</span>
                            <span class="tree-node-mini ${flowClass}">${escapeHtml(x.flowType || "Both")}</span>
                            ${loopBadge}
                        </span>
                    `;
        }


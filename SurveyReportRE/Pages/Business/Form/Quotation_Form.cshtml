@page "{pageNum:int?}"
@using Newtonsoft.Json
@model Quotation_FormModel
@{
   
    ViewBag.Title = "Quotation";
    ViewData["Id"] = 0;
}
<style>
    .dx-tabpanel .dx-tabpanel-tabs .dx-tab {
        width: auto;
        padding-left: 18px;
        padding-right: 18px;
    }
</style>
<script type="text/javascript">
    // $(function () {

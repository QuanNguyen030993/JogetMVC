        var remarkBoxs = { FO: {}, TS: {}, UW: {}, LMKT: {}, PM: {} };

        state.quoteDetails = {};

        const quotationRenderGate = (function () {
            var sequence = 0;
            var startedAt = 0;
            var $root = $(`#${formModuleKeyQt}-overviewRoot`);
            var $overlay = $root.children(".qt-render-overlay");

            if (!$overlay.length) {
                $overlay = $(`
                    <div class="qt-render-overlay" aria-live="polite" aria-busy="true">
                        <div class="qt-render-status">
                            <span class="qt-render-message">Preparing quotation interface…</span>
                            <span class="qt-render-percent">0%</span>
                        </div>
                        <div class="qt-render-progress"><span></span></div>
                        <div class="qt-skeleton-row"></div>
                        <div class="qt-skeleton-grid">
                            <div class="qt-skeleton-card"></div>
                            <div class="qt-skeleton-card"></div>
                            <div class="qt-skeleton-card"></div>
                            <div class="qt-skeleton-card"></div>
                        </div>
                    </div>
                `).appendTo($root);
            }

            function setPhase(message, progress) {
                progress = Math.max(0, Math.min(100, Number(progress) || 0));
                $overlay.find(".qt-render-message").text(message || "Loading…");
                $overlay.find(".qt-render-percent").text(`${progress}%`);
                $overlay.find(".qt-render-progress > span").css("width", `${Math.max(progress, 8)}%`);
            }

            function resetProgressiveContent() {
                const $sections = $(`#${window.QuotationIdManager.overviewScroll(@ViewData["Id"])} section.dept-section`);
                $sections.removeClass("visible");
                $sections.find(".animate-step").removeClass("visible");
            }

            function begin(message) {
                sequence += 1;
                startedAt = performance.now();
                $overlay.removeClass("is-leaving").attr("aria-busy", "true");
                $root.addClass("qt-render-loading");
                resetProgressiveContent();
                setPhase(message || "Loading quotation data…", 12);
                return sequence;
            }

            async function complete(token) {
                if (token !== sequence) return;
                setPhase("Finalizing controls…", 92);
                await new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)));

                var minimumVisibleTime = 320;
                var remaining = minimumVisibleTime - (performance.now() - startedAt);
                if (remaining > 0) {
                    await new Promise(resolve => setTimeout(resolve, remaining));
                }
                if (token !== sequence) return;

                animateOverviewSections(formModuleKeyQt);
                setPhase("Ready", 100);
                $overlay.addClass("is-leaving").attr("aria-busy", "false");
                setTimeout(function () {
                    if (token !== sequence) return;
                    $root.removeClass("qt-render-loading");
                    $overlay.removeClass("is-leaving");
                }, 300);
            }

            function fail(token, message) {
                if (token !== sequence) return;
                setPhase(message || "Unable to load quotation", 100);
                $overlay.attr("aria-busy", "false");
                setTimeout(function () {
                    if (token === sequence) $root.removeClass("qt-render-loading");
                }, 900);
            }

            return { begin, setPhase, complete, fail };
        })();

        window.QuotationRenderGate = quotationRenderGate;


        function layoutTreeLine() {
            //             const $stack = $(`#${formModuleKeyQt}-treeStack`);
            // const $nodes = $stack.find(".dept-node");
            // const $line = $(`#${formModuleKeyQt}-treeVLine`);
            const $stack = $(`#${QuotationIdManager.treeStack(@ViewData["Id"])}`);
            const $nodes = $stack.find(".dept-node");
            const $line = $(`#${QuotationIdManager.treeVLine(@ViewData["Id"])}`);
            if (!$nodes.length) return;

            const stackRect = $stack[0].getBoundingClientRect();
            const first = $nodes[0].getBoundingClientRect();
            const last = $nodes[$nodes.length - 1].getBoundingClientRect();

            const topInside = (first.top - stackRect.top) + (first.height / 2);
            const bottomInside = (last.top - stackRect.top) + (last.height / 2);

            $line.css({ top: `${topInside}px`, height: `${bottomInside - topInside}px` });
        }

        function setSectionCollapsed(dept, collapsed) {
            var $sec = $(`#${formModuleKeyQt}-sec_${dept}_@ViewData["Id"]`);
            if (!$sec.length) return;
            var body = $sec.find(".dept-body")[0];
            var bodyUpper = $sec.find(".dept-upperbody")[0];
            var bodyLower = $sec.find(".dept-lowerbody")[0];
            if (collapsed) {
                $sec.addClass("collapsed");
                if (body) {
                    // body.style.maxHeight = body.scrollHeight + "px";
                    setTimeout(() => { body.style.maxHeight = "0px";body.style.minHeight = "0px";  }, 220);
                }
                if (bodyUpper) {
                    // bodyUpper.style.maxHeight = bodyUpper.scrollHeight + "px";
                    setTimeout(() => { bodyUpper.style.maxHeight = "0px";bodyUpper.style.minHeight = "0px"; }, 220);
                }
                if (bodyLower) {
                    // bodyLower.style.maxHeight = bodyLower.scrollHeight + "px";
                    setTimeout(() => { bodyLower.style.maxHeight = "0px";bodyLower.style.minHeight = "0px";}, 220);
                }
            } else {
                $sec.removeClass("collapsed");
                if (body) {
                    // body.style.maxHeight = body.scrollHeight + "px";
                    setTimeout(() => { body.style.maxHeight = "2000px"; body.style.minHeight = "200px";}, 220);
                }
                if (bodyUpper) {
                    // bodyUpper.style.maxHeight = bodyUpper.scrollHeight + "px";
                    setTimeout(() => { bodyUpper.style.maxHeight = "2000px"; bodyUpper.style.minHeight = "50px";}, 220);
                }
                if (bodyLower) {
                    // bodyLower.style.maxHeight = bodyLower.scrollHeight + "px";
                    setTimeout(() => { bodyLower.style.maxHeight = "2000px"; bodyLower.style.minHeight = "200px";}, 220);
                }
            }
        }


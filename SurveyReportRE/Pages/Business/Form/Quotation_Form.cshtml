@page "{pageNum:int?}/{guid}"
@using JogetMVC.Model
@using Newtonsoft.Json
@model Quotation_FormModel
@{
    var moduleCode = "qt";
    var prefix = moduleCode;
    var title = moduleCode == "qt" ? "Quotation Overview" : "Policy Issuance Overview";
}
@*
Note:
-Change style to site.css
-Comment out menu topbar + sidebar
-Call ajax to main table
-Replace Quotation visible data fields, should replace by VS
-Remove app div for scroll

*@

<style>
    #qt-overviewRoot {
        position: relative;
    }

    #qt-overviewRoot.qt-render-loading .cardBody,
    #qt-overviewRoot.qt-render-loading [class="qt-cardHeader"] {
        pointer-events: none;
        user-select: none;
    }

    .qt-render-overlay {
        position: absolute;
        inset: 0;
        z-index: 120;
        display: flex;
        flex-direction: column;
        gap: 14px;
        padding: 18px;
        overflow: hidden;
        border-radius: inherit;
        background: rgba(248, 250, 252, .78);
        backdrop-filter: blur(2px);
        opacity: 0;
        visibility: hidden;
        transition: opacity .28s ease, visibility .28s ease;
    }

    #qt-overviewRoot.qt-render-loading .qt-render-overlay {
        opacity: 1;
        visibility: visible;
    }

    .qt-render-overlay.is-leaving {
        opacity: 0 !important;
    }

    .qt-render-progress {
        height: 3px;
        overflow: hidden;
        border-radius: 999px;
        background: rgba(148, 163, 184, .22);
    }

    .qt-render-progress > span {
        display: block;
        width: 12%;
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, #2563eb, #38bdf8);
        transition: width .3s ease;
    }

    .qt-render-status {
        display: flex;
        align-items: center;
        justify-content: space-between;
        color: #475569;
        font-size: 12px;
        font-weight: 650;
    }

    .qt-skeleton-row,
    .qt-skeleton-card {
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(203, 213, 225, .55);
        background: rgba(255, 255, 255, .72);
    }

    .qt-skeleton-row {
        height: 54px;
        border-radius: 12px;
    }

    .qt-skeleton-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .qt-skeleton-card {
        min-height: 150px;
        border-radius: 14px;
    }

    .qt-skeleton-row::after,
    .qt-skeleton-card::after {
        content: "";
        position: absolute;
        inset: 0;
        transform: translateX(-100%);
        background: linear-gradient(90deg, transparent, rgba(255,255,255,.72), transparent);
        animation: qtSkeletonShimmer 1.2s infinite;
    }

    @@keyframes qtSkeletonShimmer {
        100% { transform: translateX(100%); }
    }

    @@media (max-width: 900px) {
        .qt-skeleton-grid { grid-template-columns: 1fr; }
    }
</style>

<script type="text/javascript">
    var PIC_JSON = `{}`;
    var formModuleKeyQt = "qt";
    var pICs = [];
    var workflowStatus = "";
    // if ($('[data-toggle="push-menu"]').hasClass("sidebar-collapse")) {
    //     $('[data-toggle="push-menu"]').click();
    //     isToggleMenu = true;
    // }


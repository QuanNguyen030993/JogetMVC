        // Coalesce SignalR/action reloads so section templates are not rendered twice
        // while their nested controls are still being initialized.
        var quotationReloadPromise = null;
        function reloadQuotationInstance() {
            if (quotationReloadPromise) return quotationReloadPromise;

            quotationReloadPromise = (async function () {
                var renderToken = quotationRenderGate.begin("Refreshing quotation…");
                while (state.quotePaging.loading) {
                    await new Promise(resolve => setTimeout(resolve, 50));
                }

                // loadQuotePage chi bind state, dxForm va PIC. Workflow/buttons duoc
                // nap sau khi loading tong da dong o cuoi pipeline nay.
                var loaded = await loadQuotePage(true);
                if (!loaded) {
                    quotationRenderGate.fail(renderToken, "Quotation refresh failed");
                    return;
                }

                // Let DevExtreme finish all nested templates before the final repaint.
                await new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)));
                $.each(qtDeptModuleCode, function (itemIndex, item) {
                    var form = $(`#${window.QuotationIdManager.form(item,@ViewData["Id"])}`).dxForm("instance");
                    form?.repaint();
                });
                applyEditLock();
                updateHints();
                await quotationRenderGate.complete(renderToken);
                await loadSelectedWorkflow();
            })().finally(function () {
                quotationReloadPromise = null;
            });

            return quotationReloadPromise;
        }

        window.OverviewViewRegistry[quotationViewInstanceKey].reload = reloadQuotationInstance;
        window.reloadQuotationComponents = function(instanceId) {
            var registry = window.OverviewViewRegistry || {};
            if (instanceId !== undefined && instanceId !== null) {
                return registry[`qt:${instanceId}`]?.reload?.();
            }

            var reloads = Object.keys(registry)
                .filter(key => key.startsWith("qt:"))
                .map(key => registry[key])
                .filter(entry => entry && document.getElementById(entry.rootId) && typeof entry.reload === "function")
                .map(entry => entry.reload());
            return Promise.all(reloads);
        };



                ajaxPost('api/PolicyIssuance/CreatePolicyIssuance', policyIssuance, {
                    onSuccess: function () {
                        DevExpress.ui.notify("Quotation submitted!", "info", 1200);
                    },
                    onError: function () { }
                });
            }
        });

        $("#branchOverlay .backdrop").on("click", function () {
            $("#branchOverlay").hide();
            $("#branchOverlay .bnode.choice").removeClass("active");
        });

        HoverAjax.bind();
        bindSectionHeaderToggle();
        // bindQuoteCardClick();
        // bindInfiniteScroll();
        setupDeptTree();
        // initMainPaneSplitter();

        setTimeout(layoutTreeLine, 0);
        window.addEventListener("resize", () => setTimeout(layoutTreeLine, 0));

        loadQuotePage(true).then(() => {
            loadQuoteDetail(state.selectedId);
            applyNodeHighlights();
            applySectionFocusHighlight();
            updateHints();
            renderDeptCallouts(PIC_JSON);
            firstRender = false;
            
        });
    }, _delayQuotationsLoadForm);
</script>

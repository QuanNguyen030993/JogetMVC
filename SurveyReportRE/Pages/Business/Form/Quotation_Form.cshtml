@page "{pageNum:int?}/{guid}"
@using JogetMVC.Model
@using Newtonsoft.Json
@model Quotation_FormModel
@{
    var moduleCode = "qt";
    var prefix = moduleCode;
    var title = moduleCode == "qt" ? "Quotation Overview" : "Policy Issuance Overview";
}
@*
Note:
-Change style to site.css
-Comment out menu topbar + sidebar
-Call ajax to main table
-Replace Quotation visible data fields, should replace by VS
-Remove app div for scroll

*@

<style>
    #qt-overviewRoot_@(ViewData["Id"]) {
        position: relative;
    }

    #qt-overviewRoot_@(ViewData["Id"]).qt-render-loading .cardBody,
    #qt-overviewRoot_@(ViewData["Id"]).qt-render-loading .qt-cardHeader {
        pointer-events: none;
        user-select: none;
    }

    .qt-render-overlay {
        position: absolute;
        inset: 0;
        z-index: 120;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        overflow: hidden;
        border-radius: inherit;
        background: rgba(248, 250, 252, .82);
        backdrop-filter: blur(3px);
        opacity: 0;
        visibility: hidden;
        transition: opacity .28s ease, visibility .28s ease;
    }

    #qt-overviewRoot_@(ViewData["Id"]).qt-render-loading .qt-render-overlay {
        opacity: 1;
        visibility: visible;
    }

    .qt-render-overlay.is-leaving {
        opacity: 0 !important;
    }

    .qt-loader-panel {
        width: min(320px, calc(100% - 32px));
        padding: 26px 28px 24px;
        text-align: center;
        border: 1px solid rgba(203, 213, 225, .62);
        border-radius: 20px;
        background: rgba(255, 255, 255, .88);
        box-shadow: 0 18px 55px rgba(15, 23, 42, .14);
    }

    .qt-loader-icon-host {
        display: grid;
        width: 64px;
        height: 64px;
        margin: 0 auto 15px;
        place-items: center;
    }

    .qt-loader-icon-host > img,
    .qt-loader-icon-host > svg {
        display: block;
        max-width: 64px;
        max-height: 64px;
        object-fit: contain;
    }

    .qt-loader-default-icon {
        position: relative;
        width: 52px;
        height: 52px;
        border: 4px solid rgba(37, 99, 235, .14);
        border-top-color: #2563eb;
        border-radius: 50%;
        animation: qtLoaderSpin .85s linear infinite;
    }

    .qt-loader-default-icon::after {
        content: "";
        position: absolute;
        inset: 7px;
        border: 3px solid rgba(14, 165, 233, .14);
        border-bottom-color: #0ea5e9;
        border-radius: 50%;
        animation: qtLoaderSpin .65s linear infinite reverse;
    }

    .qt-loader-message {
        margin-bottom: 15px;
        color: #334155;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: .01em;
    }

    .qt-render-progress {
        height: 3px;
        overflow: hidden;
        border-radius: 999px;
        background: rgba(148, 163, 184, .22);
    }

    .qt-render-progress > span {
        display: block;
        width: 12%;
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, #2563eb, #38bdf8, #2563eb);
        background-size: 200% 100%;
        animation: qtProgressFlow 1.1s linear infinite;
        transition: width .3s ease;
    }

    @@keyframes qtLoaderSpin {
        to { transform: rotate(360deg); }
    }

    @@keyframes qtProgressFlow {
        to { background-position: -200% 0; }
    }

    @@media (prefers-reduced-motion: reduce) {
        .qt-loader-default-icon,
        .qt-loader-default-icon::after,
        .qt-render-progress > span {
            animation-duration: 1.8s;
        }
    }

    .workflow-custom-route-host {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        margin-top: 8px;
    }
</style>

<script type="text/javascript">
    var PIC_JSON = `{}`;
    var formModuleKeyQt = "qt";
    var pICs = [];
    var workflowStatus = "";
    // if ($('[data-toggle="push-menu"]').hasClass("sidebar-collapse")) {
    //     $('[data-toggle="push-menu"]').click();
    //     isToggleMenu = true;
    // }

    var page = window.QuotationPage;
    var state = page.state;

    state.nextStep = new Object();
    state.nextStep.flowSteps = [];
    state.nextStep.currentStep = 1;
    state.nextStep.instanceWorkflow = new Object();

    state.currentUserRole = _role;
    var focusDept = _role == "IT" ? "FO" : _role    

    state.quotes = [];
    state.selectedId = null;
    state.selectedGuid = null;
    state.selectedCodeNo = null;
    var selectedAttachmentId = null;
    var stageDept = null;
    
    state.quotePaging = {
        skip: 0,
        take: 20,
        loading: false,
        done: false,
        firstLoadDone: false
    };
    var firstRender = true;
    setTimeout(() => {
        const quotationViewInstanceId = "@ViewData["Id"]";
        const quotationViewInstanceKey = `${formModuleKeyQt}:${quotationViewInstanceId}`;
        const quotationOverviewRootId = `${formModuleKeyQt}-overviewRoot_${quotationViewInstanceId}`;
        enableDxFormGroupToggle(`#${quotationOverviewRootId}`);
        const QtRoles = qtDeptModuleCode;
        $(`#${formModuleKeyQt}-loginRoleLabel`).text(state.currentUserRole);

        var filter = "all";
        var searchText = "";

        var commentPanelOpened = false;
        // let stageDept = null;
        var stageAccount = "";

        var deptData = { FO: {}, TS: {}, UW: {}, LMKT: {}, PM: {} };
        var remarkBoxs = { FO: {}, TS: {}, UW: {}, LMKT: {}, PM: {} };

        state.quoteDetails = {};

        const quotationRenderGate = (function () {
            var sequence = 0;
            var startedAt = 0;
            var $root = $(`#${quotationOverviewRootId}`);
            var $overlay = $root.children(".qt-render-overlay");

            if (!$overlay.length) {
                $overlay = $(`
                    <div id="${formModuleKeyQt}-renderOverlay_${quotationViewInstanceId}" class="qt-render-overlay" role="status" aria-live="polite" aria-busy="true">
                        <div class="qt-loader-panel">
                            <div class="qt-loader-icon-host" aria-hidden="true">
                                <div class="qt-loader-default-icon"></div>
                            </div>
                            <div class="qt-loader-message">Please wait…</div>
                            <div class="qt-render-progress"><span></span></div>
                        </div>
                    </div>
                `).appendTo($root);
            }

            function setLoadingIcon(source, options) {
                var $host = $overlay.find(".qt-loader-icon-host").empty();
                options = options || {};

                function appendVisual(visual) {
                    if (!visual) return;
                    var $visual = visual.jquery ? visual : $(visual);
                    if ($visual.length && !$visual.parent().is($host)) {
                        $host.append($visual);
                    }
                }

                if (!source) {
                    $host.append('<div class="qt-loader-default-icon"></div>');
                    return;
                }

                if (typeof source === "function") {
                    appendVisual(source($host));
                    return;
                }

                if (typeof source === "string") {
                    $("<img>", {
                        src: source,
                        alt: options.alt || "",
                        class: options.className || ""
                    }).appendTo($host);
                    return;
                }

                appendVisual(source);
            }

            function setPhase(_message, progress) {
                progress = Math.max(0, Math.min(100, Number(progress) || 0));
                $overlay.find(".qt-render-progress > span").css("width", `${Math.max(progress, 8)}%`);
            }

            function resetProgressiveContent() {
                const $sections = $(`#${window.QuotationIdManager.overviewScroll(@ViewData["Id"])} section.dept-section`);
                $sections.removeClass("visible");
                $sections.find(".animate-step").removeClass("visible");
            }

            function begin(message) {
                sequence += 1;
                startedAt = performance.now();
                $overlay.removeClass("is-leaving").attr("aria-busy", "true");
                $root.addClass("qt-render-loading");
                resetProgressiveContent();
                setPhase(message || "Loading quotation data…", 12);
                return sequence;
            }

            async function complete(token) {
                if (token !== sequence) return;
                setPhase("Finalizing controls…", 92);
                await new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)));

                var minimumVisibleTime = 320;
                var remaining = minimumVisibleTime - (performance.now() - startedAt);
                if (remaining > 0) {
                    await new Promise(resolve => setTimeout(resolve, remaining));
                }
                if (token !== sequence) return;

                animateOverviewSections(formModuleKeyQt);
                setPhase("Ready", 100);
                $overlay.addClass("is-leaving").attr("aria-busy", "false");
                await new Promise(resolve => setTimeout(resolve, FormStageDelay.overlayDone));
                if (token !== sequence) return;
                $root.removeClass("qt-render-loading");
                $overlay.removeClass("is-leaving");
            }

            function fail(token, message) {
                if (token !== sequence) return;
                setPhase(message || "Unable to load quotation", 100);
                $overlay.attr("aria-busy", "false");
                setTimeout(function () {
                    if (token === sequence) $root.removeClass("qt-render-loading");
                }, 900);
            }

            if (window.QuotationLoadingIcon) {
                setLoadingIcon(window.QuotationLoadingIcon);
            }

            return { begin, setPhase, complete, fail, setLoadingIcon };
        })();

        // Coordinator chi ton tai trong instance form nay, khong dung window lam
        // noi chua state trung gian giua dxForm, assignment va route buttons.
        const quotationFormStages = createFormStageCoordinator(function (stageName) {
            $(`#${quotationOverviewRootId}`).attr("data-render-stage", stageName);
        });
        const quotationDepartmentOrder = FormStageDelay.departmentOrder.quotation;
        const assignmentLifecycle = { isAssigneeBoxRender: false };

        window.OverviewViewRegistry = window.OverviewViewRegistry || {};
        window.OverviewViewRegistry[quotationViewInstanceKey] = {
            moduleCode: formModuleKeyQt,
            recordId: quotationViewInstanceId,
            rootId: quotationOverviewRootId,
            renderGate: quotationRenderGate
        };
        window.QuotationRenderGates = window.QuotationRenderGates || {};
        window.QuotationRenderGates[quotationViewInstanceId] = quotationRenderGate;
        window.QuotationRenderGate = quotationRenderGate;

        function money(n) {
            return new Intl.NumberFormat("vi-VN", {
                style: "currency",
                currency: "VND"
            }).format(n || 0);
        }


        function statusClass(raw) { return normalizeStatus(raw).css; }
        function statusText(raw) { return normalizeStatus(raw).text; }

       



    function getSelectedModel() {
             const q = state.quotes.find(x => x.id === state.selectedId) || state.quotes[0];
             return q || null;
         }



        function buildListUrl() {
            const params = new URLSearchParams();
            params.set("skip", state.quotePaging.skip);
            params.set("take", state.quotePaging.take);

            if (searchText) params.set("searchText", searchText);
            if (filter && filter !== "all") params.set("workflowStatus", filter);
            params.set("key", @Convert.ToInt32(ViewData["Id"]));
            return `/api/Quotation/GetAll?${params.toString()}`;
        }



        async function syncSelectedState(q) {
            if (!q) return;

        


            state.selectedId =  q.id ?? null;
            state.selectedGuid = q.guid ?? null;
            selectedAttachmentId = q.documentId ?? null;
            state.selectedCodeNo = q.quotationCode ?? null;
            stageDept = q.stageDept ?? null;
            const params = new URLSearchParams();
            params.set("refKey", state.selectedGuid);
            params.set("refField", 'RecordGuid');
            var commentsPromise = ajaxGet(`/api/SectionCommentNote/GetAll?${params.toString()}`, null)
                .then(res => {
                    var pinnedNotes = (res || []).map(x => ({
                        id: x.id,
                        section: x.currentDepartment,//target main
                        fromSection: x.fromDepartment,//target pin
                        toSection: x.toDepartment,
                        type: x.type,
                        unread: !x.isRead,
                        isRead: !x.isRead,
                        linkedPin: x.isPinned,
                        isPinned: x.isPinned,
                        body: x.content,
                        text: x.content,
                        replies: 0,
                        fullText: x.content,
                        author: x.author,
                        urgent: false,
                        time: parseToGMT7(x.createdDate, 0)
                    }));
                    state.comments = pinnedNotes;
                    state.pinNotes = pinnedNotes.filter(f => f.isPinned);
                })
                .catch(error => {
                    state.comments = [];
                    state.pinNotes = [];
                    console.warn("Section comments could not be preloaded.", error);
                });

            PIC_JSON = pICs.find(f => f.quotationCode == state.selectedCodeNo)?.pIC ?? q.pIC ?? "{}";
            renderDeptCallouts(PIC_JSON);
            var map = parsePicMap(PIC_JSON);
            stageAccount = map[stageDept] ? map[stageDept] : "(Unassigned)";

            await commentsPromise;
        }

        function loadSelectedWorkflow() {
            if (!state.selectedGuid) return $.Deferred().resolve().promise();

            return ajaxGet(`/api/Quotation/GetQuotationWorkflow/${state.selectedGuid}`, null)
                .then(instance => {
                    loadAndApplyQuotationScreenConditions(instance?.currentStep, state.selectedId);
                    return ajaxGet(`/api/StepsWorkflow/GetNextStep/${instance?.workflowDefinitionId ?? "00000000-0000-0000-0000-000000000000"}/${instance?.currentStep ?? 0}`, null)
                        .then(data => {
                            data = Array.isArray(data) ? data : [];
                            state.nextStep.instanceWorkflow = instance;
                            state.nextStep.flowSteps = data;
                            state.nextStep.currentStep = instance?.currentStep ?? 0;
                            // setNextStep(state.nextStep);
                            // Route state chi duoc bind sau khi loading tong da dong va
                            // tat ca dxForm/dxTagBox da co data.
                            return quotationFormStages.enter("routeState").then(async function () {
                                       
                                        // var findRoute = data.find(f => !f.isReturn && f.fromNodeId == stageDept && f.fNodeId == state.nextStep.currentStep);
                                         const customRoutes = data.filter(function (route) {
                                             return String(route?.flowType || "").trim().toLowerCase() === "custom";
                                         });
                                         var findRoutes = data.filter(f => !f.isReturn
                                             && String(f?.flowType || "").trim().toLowerCase() !== "custom"
                                             && f.fromNodeId == stageDept
                                             && f.fNodeId == state.nextStep.currentStep);
                                        // var findRouteReturn = data.find(f => f.isReturn && f.fromNodeId == stageDept && f.fNodeId == state.nextStep.currentStep);
                                        var findRouteReturns = data.filter(f => f.isReturn
                                            && String(f?.flowType || "").trim().toLowerCase() !== "custom"
                                            && f.fromNodeId == stageDept
                                            && f.fNodeId == state.nextStep.currentStep);
                                        var returnButtonId = window.QuotationIdManager.btnReturnBranch(stageDept,@ViewData["Id"]);
                                        var submitButtonId = window.QuotationIdManager.btnSubmitBranch(stageDept,@ViewData["Id"]);
                                        // var remarkBoxId = window.QuotationIdManager.remarkBox(stageDept,@ViewData["Id"]);
                                        var formId = window.QuotationIdManager.form(stageDept,@ViewData["Id"]);
                                        var formItems = $(`#${formId}`).dxForm("instance")?.option("formData") || {};
                                         var tatObject = new Object();

                                            tatObject = tryParseJSON(formItems.turnAroundTimeAttributes, "Submit Button Problem") || {};
                                         var actionStatusObject = tryParseJSON(formItems.actionStatus, "Submit Button ActionStatus Problem") || {};
                                         var hasAcceptedRouteStatus = stageDept === "LMKT" && (actionStatusObject[`${stageDept}Button`] || actionStatusObject[stageDept]);
                                         if (hasAcceptedRouteStatus) {
                                             findRoutes = [];
                                         }
                                        const recordId = @ViewData["Id"];
                                        const normalizeRouteDept = function (value) {
                                            return String(value || "").trim().toUpperCase();
                                        };
                                        const normalizeRouteGroupKey = function (value) {
                                            return normalizeRouteDept(value).replace(/[^A-Z0-9]/g, "");
                                        };
                                        const getRouteGroupKeys = function (routeData) {
                                            const route = typeof routeData === "object" && routeData
                                                ? routeData
                                                : { fromNodeId: routeData };
                                            return [
                                                route.fromNodeId,
                                                route.fromDeptCode,
                                                route.departmentCode,
                                                route.deptCode,
                                                route.roleCode,
                                                route.nodeName
                                            ]
                                                .map(normalizeRouteGroupKey)
                                                .filter(function (value, index, values) {
                                                    return value.length >= 2 && values.indexOf(value) === index;
                                                });
                                        };
                                        const isSimilarRouteGroup = function (routeKeys, groupDept) {
                                            const groupKey = normalizeRouteGroupKey(groupDept);
                                            return routeKeys.some(function (routeKey) {
                                                return routeKey === groupKey
                                                    || routeKey.indexOf(groupKey) >= 0
                                                    || groupKey.indexOf(routeKey) >= 0;
                                            });
                                        };
                                        const ensureCustomRouteHost = function (routeData) {
                                            const routeKeys = getRouteGroupKeys(routeData);
                                            if (!routeKeys.length) return $();

                                            let $host = $(`[data-route-custom-host][data-record-id="${recordId}"]`)
                                                .filter(function () {
                                                    return isSimilarRouteGroup(
                                                        routeKeys,
                                                        $(this).attr("data-route-dept"));
                                                })
                                                .first();
                                            if ($host.length) return $host;

                                            const groupIdPrefix = "qt-decision-group-";
                                            const groupIdSuffix = `-${recordId}`;
                                            let $decisionGroup = $(`[id^="${groupIdPrefix}"][id$="${groupIdSuffix}"]`)
                                                .filter(function () {
                                                    const groupId = this.id || "";
                                                    const groupDept = groupId.substring(
                                                        groupIdPrefix.length,
                                                        groupId.length - groupIdSuffix.length);
                                                    return isSimilarRouteGroup(routeKeys, groupDept);
                                                })
                                                .first();
                                            if (!$decisionGroup.length) {
                                                const fallbackDept = ["FO", "TS", "UW", "LMKT", "PM"]
                                                    .find(function (dept) {
                                                        return isSimilarRouteGroup(routeKeys, dept);
                                                    });
                                                if (fallbackDept) {
                                                    const fallbackFormId = window.QuotationIdManager.form(
                                                        fallbackDept,
                                                        recordId);
                                                    $decisionGroup = $(`#${fallbackFormId} .qt-decision-group-${fallbackDept}`)
                                                        .first()
                                                        .attr({
                                                            id: `${groupIdPrefix}${fallbackDept}${groupIdSuffix}`,
                                                            "data-form-group-name": `decision${fallbackDept}Group`,
                                                            "data-route-dept": fallbackDept
                                                        });
                                                }
                                            }
                                            if (!$decisionGroup.length) {
                                                console.warn("No decision group id matched the custom route.", routeData);
                                                return $();
                                            }

                                            const groupId = $decisionGroup.attr("id");
                                            const groupDept = groupId.substring(
                                                groupIdPrefix.length,
                                                groupId.length - groupIdSuffix.length);
                                            const $decisionArea = $decisionGroup
                                                .find(".dx-form-group-content")
                                                .first();
                                            if (!$decisionArea.length) {
                                                console.warn(`Decision content for group '${groupId}' was not found.`);
                                                return $();
                                            }

                                            $host = $(`<div class="workflow-custom-route-host" data-route-custom-host="true" data-record-id="${recordId}" data-route-dept="${groupDept}"></div>`);
                                            const $actionArea = $decisionArea
                                                .find(".decision-action-row")
                                                .first();
                                            $host
                                                .attr("data-route-group-id", groupId)
                                                .appendTo($actionArea.length ? $actionArea : $decisionArea);
                                            return $host;
                                        };

                                        $(`[data-route-custom-host][data-record-id="${recordId}"] [data-custom-route-button]`).each(function () {
                                            $(this).dxButton("instance")?.dispose();
                                            $(this).remove();
                                        });

                                        const $uwRouteSlot = ensureCustomRouteHost({ fromNodeId: "UW" });
                                        const hasUwCustomRoute = customRoutes.some(function (route) {
                                            return isSimilarRouteGroup(getRouteGroupKeys(route), "UW");
                                        });
                                        if ($uwRouteSlot.length) {
                                            $uwRouteSlot
                                                .removeClass("is-route-pending")
                                                .toggleClass("has-flow-route", hasUwCustomRoute)
                                                .toggleClass("is-fallback-ready", !hasUwCustomRoute)
                                                .attr("data-has-flow-route", hasUwCustomRoute ? "true" : "false");
                                            const fallbackInstance = $uwRouteSlot.find("[data-uw-route-fallback]").dxButton("instance");
                                            if (fallbackInstance && !hasUwCustomRoute) {
                                                fallbackInstance.option("disabled", stageDept !== "UW" || !!tatObject?.UW?.AcceptDate);
                                            }
                                        }
                                        for (const [routeIndex, route] of customRoutes.entries()) {
                                            await quotationFormStages.pace(routeIndex);
                                            const $routeHost = ensureCustomRouteHost(route);
                                            if (!$routeHost.length) continue;
                                            const routeDept = normalizeRouteDept($routeHost.attr("data-route-dept"));
                                            if (!routeDept) continue;

                                            const rawRouteKey = route?.routeId || route?.id || route?.actionCode || routeIndex;
                                            const safeRouteKey = String(rawRouteKey).replace(/[^a-zA-Z0-9_-]/g, "_");
                                            const customButtonId = `qt-custom-route-${recordId}-${routeDept}-${safeRouteKey}-${routeIndex}`;
                                            const isCurrentRoute = routeDept === normalizeRouteDept(stageDept)
                                                && route?.fNodeId == state.nextStep.currentStep;
                                            const $customButton = $(`<div id="${customButtonId}" data-custom-route-button="true"></div>`)
                                                .appendTo($routeHost);

                                            $customButton.dxButton({
                                                disabled: !isCurrentRoute,
                                                text: route.displayStatus || route.actionName || route.actionCode || "Custom action",
                                                icon: getTransitionButtonIcon(route, route.isReturn ? "undo" : "chevronright"),
                                                type: route.isReturn ? "danger" : "info",
                                                onClick: function () {
                                                    const routeFormId = window.QuotationIdManager.form(routeDept, recordId);
                                                    const routeFormItems = $(`#${routeFormId}`).dxForm("instance")?.option("formData") || {};
                                                    const content = remarkBoxs?.[routeDept]?.controlRemark?.value?.() || "";
                                                    if (route.isReturn && !content) {
                                                        appNotifyWarning("Please put your reason to remarks!", false);
                                                        return;
                                                    }
                                                    routeFormItems.comment = content;
                                                    if (route.isReturn) {
                                                        returnToStep(formModuleKeyQt, state.nextStep, route, routeFormItems);
                                                    } else {
                                                        submitNextStep(formModuleKeyQt, state.nextStep, route, routeFormItems);
                                                    }
                                                }
                                            });
                                            applyTransitionButtonClass(`#${customButtonId}`, route);
                                        }
                                           try {
                                            if (findRouteReturns?.length && tatObject) {

                                                for (const [routeIndex, route] of findRouteReturns.entries()) {
                                                    await quotationFormStages.pace(customRoutes.length + routeIndex);

                                                    const buttonId =
                                                        `${returnButtonId}_${route.routeId || route.actionCode}`;

                                                    const routeButtonHost = `#${returnButtonId}`;

                                                    if (!$(`#${buttonId}`).length) {
                                                        $(`<div id="${buttonId}"></div>`)
                                                            .appendTo(routeButtonHost);
                                                    } else if (!$(`#${buttonId}`).parent().is(routeButtonHost)) {
                                                        $(`#${buttonId}`).appendTo(routeButtonHost);
                                                    }

                                                    $(`#${buttonId}`).dxButton({
                                                        disabled: false,
                                                        text: route.displayStatus || "",
                                                        icon: getTransitionButtonIcon(route, "undo"),
                                                        type: "danger",
                                                        onClick: function () {
                                                            var content = remarkBoxs[stageDept].controlRemark.value();
                                                            if (content)
                                                                {
                                                                formItems =
                                                                    $(`#${formId}`)
                                                                        .dxForm("instance")
                                                                        ?.option("formData") || {};

                                                                formItems.comment = content || "";

                                                                returnToStep(
                                                                    `${formModuleKeyQt}`,
                                                                    state.nextStep,
                                                                    route,
                                                                    formItems
                                                                );
                                                                }
                                                            else {
                                                                appNotifyWarning("Please put your reason to remarks!",false);
                                                            }
                                                        }
                                                    });
                                                    applyTransitionButtonClass(`#${buttonId}`, route);
                                                }
                                            }
                                        }
                                        catch (exception) {
                                            console.log("Return problem", exception);
                                        }
                                        try {

                                            if (findRoutes?.length) {

                                                for (const [routeIndex, route] of findRoutes.entries()) {
                                                    await quotationFormStages.pace(
                                                        customRoutes.length + findRouteReturns.length + routeIndex
                                                    );

                                                    const buttonId =
                                                        `${submitButtonId}_${route.routeId || route.actionCode}`;

                                                    const routeButtonHost = `#${submitButtonId}`;

                                                    if (!$(`#${buttonId}`).length) {
                                                        $(`<div id="${buttonId}"></div>`)
                                                            .appendTo(routeButtonHost);
                                                    } else if (!$(`#${buttonId}`).parent().is(routeButtonHost)) {
                                                        $(`#${buttonId}`).appendTo(routeButtonHost);
                                                    }

                                                    $(`#${buttonId}`).dxButton({
                                                        disabled: stageDept === "LMKT"

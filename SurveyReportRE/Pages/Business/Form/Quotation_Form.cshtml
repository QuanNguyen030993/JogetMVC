                                            }
                                        }
                                        catch (exception) {
                                            console.log("Submit problem", exception);
                                        }
                                   }, _delayRenderSubmitButton);
                            // });
                        });
                });
        }
        window.loadSelectedQuotationWorkflow = loadSelectedWorkflow;

        async function loadQuotePage(reset = false) {
            if (state.quotePaging.loading) return;
            if (!reset && state.quotePaging.done) return;

            if (reset) {
                state.quotePaging.skip = 0;
                state.quotePaging.done = false;
                state.quotePaging.firstLoadDone = false;
                state.quotes = [];
                pICs = [];
            }

            state.quotePaging.loading = true;

            try {
                var data = await $.ajax({
                    url: buildListUrl(),
                    method: "GET",
                    contentType: "application/json"
                });
                quotationRenderGate.setPhase("Quotation data received…", 38);

                const rows = Array.isArray(data)
                    ? data.map(item => ({ ...item, pIC: item.pic }))
                    : [];

                if (reset && rows.length === 0) {
                    state.quotePaging.done = true;
                    return false;
                }

                state.quotes = state.quotes.concat(rows);

                state.quotePaging.skip += rows.length;
                if (rows.length < state.quotePaging.take) {
                    state.quotePaging.done = true;
                }

                if (!state.quotePaging.firstLoadDone && state.quotes.length > 0) {
                    state.quotePaging.firstLoadDone = true;
                    quotationRenderGate.setPhase("Binding quotation state…", 52);
                    await syncSelectedState(state.quotes[0]);
                    quotationRenderGate.setPhase("Loading workflow and permissions…", 68);
                    await loadSelectedWorkflow();
                    quotationRenderGate.setPhase("Initializing department controls…", 80);
                    renderDetail();
                }
                return true;
            } catch (err) {
                console.error("loadQuotePage error:", err);
                DevExpress.ui.notify("Load quotation list failed", "error", 1500);
                return false;
            } finally {
                state.quotePaging.loading = false;
            }
        }




        function reloadState() {
            $.each(qtDeptModuleCode, function (itemIndex, item) {
                commentPinModule(formModuleKeyQt, item,  "@ViewData["Guid"]", state.pinNotes,@ViewData["Id"]);
                // loadCommentModule(formModuleKeyQt, item,  "@ViewData["Guid"]", state.comments,@ViewData["Id"]);
            });
        }

        // Coalesce SignalR/action reloads so section templates are not rendered twice
        // while their nested controls are still being initialized.
        var quotationReloadPromise = null;
        window.reloadQuotationComponents = function() {
            if (quotationReloadPromise) return quotationReloadPromise;

            quotationReloadPromise = (async function () {
                var renderToken = quotationRenderGate.begin("Refreshing quotation…");
                while (state.quotePaging.loading) {
                    await new Promise(resolve => setTimeout(resolve, 50));
                }

                // loadQuotePage already synchronizes state, loads workflow and calls renderDetail.
                var loaded = await loadQuotePage(true);
                if (!loaded) {
                    quotationRenderGate.fail(renderToken, "Quotation refresh failed");
                    return;
                }

                // Let DevExtreme finish all nested templates before the final repaint.
                await new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)));
                $.each(qtDeptModuleCode, function (itemIndex, item) {
                    var form = $(`#${window.QuotationIdManager.form(item,@ViewData["Id"])}`).dxForm("instance");
                    form?.repaint();
                });
                applyEditLock();
                updateHints();
                await quotationRenderGate.complete(renderToken);
            })().finally(function () {
                quotationReloadPromise = null;
            });

            return quotationReloadPromise;
        };


        function renderDeptForms() {

            $.each(qtDeptModuleCode, function (itemIndex, item) {
                var formId = window.QuotationIdManager.form(item,@ViewData["Id"]);
                 $(`#${formId}`).dxForm({ formData: deptData[item], readOnly: true, colCount: 1 });

            });

            reloadState();
            applyEditLock();
            updateHints();

        }


     


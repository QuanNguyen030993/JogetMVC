 @{
    string dept = "FO";  

}


<div class="actionBarDept" id="actionBarDept_@dept">
    <div class="actionLeft">
        <span class="dept-title">Remarks</span> <div id="qt-remarkBox_@dept" class="htmleditor"></div>
    </div>
    <div class="actionRight">
        <div id="qt-btnSave_@dept"></div>
        <div id="qt-btnReturnBranch_@dept"></div>
        <div id="qt-btnSubmitBranch_@dept"></div>
    </div>
</div>

<script>
        // if (tinymce.get(`qt-remarkBox_@dept`))
        // tinymce.get(`qt-remarkBox_@dept`).remove();
        // TinyMCEElementMaker(`qt-remarkBox_@dept`);
    setTimeout( () => {

    setTimeout( () => {

    var formItems = $("#qt-formFO").dxForm("instance")?.option("formData") || {};
    var encodedFolder = encodeURIComponent(`RES\\${ formItems.quotationCode }`);
    if (window.QuotationPage.resFK) // check tiep cho nay
       $.get(`/api/Document/AttachmentSummary/${formItems.resFK.guid}/${encodedFolder}`, null
       ).done(function (res) {
            window.QuotationPage.state.formFO.dxForm("instance").updateData("resAttachmentCount", res.attachmentCount);
            window.QuotationPage.state.formFO.dxForm("instance").updateData("hasResAttachment", res.hasAttachment);
            window.QuotationPage.state.hasResAttachment = res.hasAttachment;
            if (res.hasAttachment)
            $("#btnToggleResForm").addClass("hasResAttachment");
            else
            $("#btnToggleResForm").removeClass("hasResAttachment");
       });
    }, 200);
    var dept = "@dept";
         var pageLayout = window.QuotationPage;
        var stateLayout = pageLayout.state;
        $("#qt-btnSave_@dept").dxButton({ text: "Save", icon: "save", type: "default", onClick:
        function (e) {
              var formItems = $(`#qt-form${dept}`).dxForm("instance")?.option("formData") || {};
              
              var globalLoadPanel = $("#loadingPopup").dxLoadPanel({
                  shadingColor: "rgba(0,0,0,0.4)",
                  visible: false,
                  showIndicator: true,
                  showPane: false,
                  shading: true,
                  closeOnOutsideClick: false,
                   position: { of: `#qt-form${dept}`}
                  // onShown: function () {
                  //     setTimeout(function () {
                  //         appLoadPanel.hide();
                  //     }, 3000);
                  // }
              });
             globalLoadPanel.dxLoadPanel("instance").show();

            ajaxPut('/api/Quotation/UpdateData',
            {
                key: formItems.id,
                values: JSON.stringify(
                    formItems
                )
            },
            {
                onSuccess: function (response) { 
                },
                onError: function (err) { }
            }
        );
        }
    });
    }, _delayRenderSubmitButton);
</script> 


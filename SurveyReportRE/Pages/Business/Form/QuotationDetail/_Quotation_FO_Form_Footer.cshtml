 @{
    string dept = "FO";  

}


<div class="actionBarDept" id="actionBarDept@dept">
    <div class="actionLeft">
        <span class="dept-title">Remarks</span> <div id="qt-submitBox_@dept"></div>
    </div>
    <div class="actionRight">
        <div id="qt-btnSave_@dept"></div>
        <div id="qt-btnSubmitBranch_@dept"></div>
    </div>
</div>

<script>
    setTimeout( () => {

    setTimeout( () => {
    var formItems = $("#qt-formFO").dxForm("instance")?.option("formData") || {};
    var encodedFolder = encodeURIComponent(`RES\\${ formItems.quotationCode }`);
       $.get(`/api/Document/AttachmentSummary/${formItems.resFK.guid}/${encodedFolder}`, null
       ).done(function (res) {
           $("#qt-formFO").dxForm("instance").updateData("resAttachmentCount", res.attachmentCount);
           $("#qt-formFO").dxForm("instance").updateData("hasResAttachment", res.hasAttachment);
           $("#btnToggleResForm").dxButton("instance").option("type", res.hasAttachment ? "info" : "normal");
       });
    }, 200);
    var dept = "@dept";
         var pageLayout = window.QuotationPage;
        var stateLayout = pageLayout.state;
             $("#qt-submitBox_@dept").dxTextArea({width: _defaultFormFieldWidth,height: _defaultFormFieldHeight}); var findRoute = stateLayout.nextStep.flowSteps.find(f => f.fromNodeId == dept && f.stepNo == stateLayout.nextStep.currentStep); $("#qt-btnSubmitBranch_@dept").dxButton({ text: findRoute ? findRoute.displayStatus : "", icon: "check", type: "info", onClick: function (e) { var formItems = $(`#qt-form${dept}`).dxForm("instance")?.option("formData") || {}; submitNextStep("@dept", stateLayout.nextStep, findRoute, formItems); } });  
        $("#qt-btnSave_@dept").dxButton({ text: "Save", icon: "save", type: "default", onClick:
        function (e) {
              var formItems = $(`#qt-form${dept}`).dxForm("instance")?.option("formData") || {};
              var globalLoadPanel = $("#loadingPopup").dxLoadPanel({
                  shadingColor: "rgba(0,0,0,0.4)",
                  visible: false,
                  showIndicator: true,
                  showPane: false,
                  shading: true,
                  closeOnOutsideClick: false,
                   position: { of: `#qt-form${dept}`}
                  // onShown: function () {
                  //     setTimeout(function () {
                  //         appLoadPanel.hide();
                  //     }, 3000);
                  // }
              });
             globalLoadPanel.dxLoadPanel("instance").show();

            ajaxPut('/api/Quotation/UpdateData',
            {
                key: formItems.id,
                values: JSON.stringify(
                    formItems
                )
            },
            {
                onSuccess: function (response) { 
                },
                onError: function (err) { }
            }
        );
        }
    });
    }, _delayRenderSubmitButton);
</script> 


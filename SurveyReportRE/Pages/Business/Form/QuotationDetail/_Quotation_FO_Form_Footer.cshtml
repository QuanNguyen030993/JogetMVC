@using JogetMVC.Model
@{
    string dept = "FO";
    long quotationId = Convert.ToInt64(ViewData["Id"]);
}


<div class="actionBarDept" id="actionBarDept_@dept">
    <div class="actionLeft">
        <span class="dept-title">Remarks</span> <div id="@QTViewIdHelper.RemarkBox(dept,quotationId)" class="htmleditor"></div>
    </div>
    <div class="actionRight">
        <div id="@QTViewIdHelper.BtnSave(dept,quotationId)"></div>
        <div id="@QTViewIdHelper.BtnReturnBranch(dept,quotationId)"></div>
        <div id="@QTViewIdHelper.BtnSubmitBranch(dept,quotationId)"></div>
    </div>
</div>

<script>
        // if (tinymce.get(`qt-remarkBox_@dept`))
        // tinymce.get(`qt-remarkBox_@dept`).remove();
        // TinyMCEElementMaker(`qt-remarkBox_@dept`);
    setTimeout( () => {

    setTimeout( () => {

    // var formItems = $(`#${window.QuotationIdManager.form('@dept',@quotationId)}`).dxForm("instance")?.option("formData") || {};
    var encodedFolder = encodeURIComponent(`qt_FO_RES`);
    if (window.QuotationPage.state.quotes[0].resFK) // check tiep cho nay
       $.get(`/api/Document/AttachmentSummary/${window.QuotationPage.state.quotes[0].guid}/${encodedFolder}`, null
       ).done(function (res) {
            window.QuotationPage.state.formFO.dxForm("instance").updateData("resAttachmentCount", res.attachmentCount);
            window.QuotationPage.state.formFO.dxForm("instance").updateData("hasResAttachment", res.hasAttachment);
            window.QuotationPage.state.hasResAttachment = res.hasAttachment;
            if (res.hasAttachment)
            $("#@QTViewIdHelper.BtnToggleResForm(dept, quotationId)").addClass("hasResAttachment");
            else
            $("#@QTViewIdHelper.BtnToggleResForm(dept, quotationId)").removeClass("hasResAttachment");
       });
    }, 200);
    var dept = "@dept";
         var pageLayout = window.QuotationPage;
        $("#@QTViewIdHelper.BtnSave(dept, quotationId)").dxButton({ text: "Save", icon: "save", type: "default", onClick:
        function (e) {
              var formItems = $(`#@QTViewIdHelper.Form(dept, quotationId)`).dxForm("instance")?.option("formData") || {};

              var globalLoadPanel = $("#loadingPopup").dxLoadPanel({
                  shadingColor: "rgba(0,0,0,0.4)",
                  visible: false,
                  showIndicator: true,
                  showPane: false,
                  shading: true,
                  closeOnOutsideClick: false,
                   position: { of: `#@QTViewIdHelper.Form(dept, quotationId)`}
                  // onShown: function () {
                  //     setTimeout(function () {
                  //         appLoadPanel.hide();
                  //     }, 3000);
                  // }
              });
             globalLoadPanel.dxLoadPanel("instance").show();

            ajaxPut('/api/Quotation/UpdateData',
            {
                key: formItems.id,
                values: JSON.stringify(
                    formItems
                )
            },
            {
                onSuccess: function (response) {
                },
                onError: function (err) { }
            }
        );
        }
    });
    }, _delayRenderSubmitButton);
</script>


<style>
    .dx-tabpanel .dx-tabpanel-tabs .dx-tab {
        width: auto;
        padding-left: 18px;
        padding-right: 18px;
    }

    .uw-decision-primary-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
    }

    .uw-decision-primary-actions .accept-status-indicator {
        /* flex: 0 0 100%; */
    }

    .uw-route-custom-host {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        min-height: 36px;
    }

    .uw-route-custom-host.is-route-pending .uw-route-fallback-button {
        visibility: hidden;
        pointer-events: none;
        opacity: 0;
    }

    .uw-route-custom-host.is-fallback-ready .uw-route-fallback-button {
        visibility: visible;
        pointer-events: auto;
        opacity: 1;
        transition: opacity .15s ease;
    }

    .uw-route-custom-host.has-flow-route .uw-route-fallback-button {
        display: none;
    }
</style>

@using JogetMVC.Model
@* @page "{pageNum:int?}"
@using Newtonsoft.Json *@
@* @model Quotation_UW_FormModel *@
@* @{
   
    ViewBag.Title = "Quotation";
    ViewData["Id"] = 0;
} *@
@{
    string dept = "UW";
    long quotationId = Convert.ToInt64(ViewData["Id"]); string quotationGuid = ViewData["Guid"].ToString();
}
<style>
    .dx-tabpanel .dx-tabpanel-tabs .dx-tab {
        width: auto;
        padding-left: 18px;
        padding-right: 18px;
    }
</style>

<div id="@QTViewIdHelper.Form(dept, quotationId)">
</div>

<script type="text/javascript">
        var that = new Object();
    that.ModelName = "Quotation";
     $(`#@QTViewIdHelper.Form(dept, quotationId)`).dxForm({
         dataSource: makeBasicDataSource(that, true),
        items: [
            { itemType: "group", caption: "Attachment", colCount: 1, items: attachmentDefault("qt", "@(dept)", @(quotationId), "@(quotationGuid)") },
            ,
             {
        dataField: "decision",
        label: { text: "Decision" },
        editorType: "dxRadioGroup",
        editorOptions: {
            items: [
                { id: "AC_@QTViewIdHelper.Decision(dept, quotationId)" , text: "Accept", value: true },
                { id: "AS_@QTViewIdHelper.Decision(dept, quotationId)" , text: "Assign", value: false },
                { id: "RJ_@QTViewIdHelper.Decision(dept, quotationId)" , text: "Reject", value: false }
            ],
             displayExpr: "text",
             valueExpr: "id",
             layout: "horizontal",
             itemTemplate: function(itemData, _, itemElement) {
             setTimeout(() => {
              var formItems = $(`#@QTViewIdHelper.Form(dept, quotationId)`).dxForm("instance")?.option("formData") || {};
              var tatObject = JSON.parse(formItems.turnAroundTimeAttributes);
              if (tatObject[`@dept`].AcceptDate)
              {
                $(`#AC_@QTViewIdHelper.Decision(dept, quotationId)`).addClass("btn-success");
                $(`#${itemData.id}`).dxButton("instance").option("disabled", true);
                if (itemData.id === "RJ_@QTViewIdHelper.Decision(dept, quotationId)" ) $(`#RJ_@QTViewIdHelper.Decision(dept, quotationId)`).dxButton("instance").option("disabled", false);
              }
             },4000);

             $(`<div id='${itemData.id}'>`).dxButton({
             text: itemData.text,
             width: "100%",
             height: "100%",
             onClick: function (e){
                 if (_ == 0)
                 {
                      var formItems = $(`#@QTViewIdHelper.Form(dept, quotationId)`).dxForm("instance")?.option("formData") || {};
                       var tatObject = JSON.parse(formItems.turnAroundTimeAttributes);
                          tatObject[`@dept`].AcceptDate = new Date();
                          formItems.turnAroundTimeAttributes = JSON.stringify(tatObject);
                       ajaxPut('/api/Quotation/UpdateData',
                        {
                            key: formItems.id,
                            values: JSON.stringify(
                                formItems
                            )
                        },
                        {
                            onSuccess: function (response) {
                                Devexpress.ui.notify("Task accepted", "success");
                            },
                            onError: function (err) { }
                        });
                 }
                  if (_ == 2)
                 {
                  var formItems = $(`#@QTViewIdHelper.Form(dept, quotationId)`).dxForm("instance")?.option("formData") || {};
                          var tatObject = JSON.parse(formItems.turnAroundTimeAttributes);
                                      tatObject[`@dept`].AcceptDate = "";
                                      formItems.turnAroundTimeAttributes = JSON.stringify(tatObject);
                                   ajaxPut('/api/Quotation/UpdateData',
                                    {
                                        key: formItems.id,
                                        values: JSON.stringify(
                                            formItems
                                        )
                                    },
                                    {
                                        onSuccess: function (response) {
                                            Devexpress.ui.notify("Task accepted", "success");
                                        },
                                        onError: function (err) { }
                                    });
                             }
                         }

                         }).appendTo(itemElement);
                      itemElement
                    },
                    isRequired: true
                    }
                },

              { dataField:"premium", label:{text:"Premium"}, editorType:"dxNumberBox", editorOptions:{ min:0 } },
              { dataField:"terms", label:{text:"Terms"}, editorType:"dxTextArea", colSpan:2, editorOptions:{ height: 90 } },
              { dataField:"exclusions", label:{text:"Exclusions"}, editorType:"dxTextArea", colSpan:2, editorOptions:{ height: 70 } },
              {
                itemType: "button",
                    alignment: "left",
                    buttonOptions: {
                        text: "Survey refer",
                        onClick: function () {
                             $.ajax({
                                url: `https://svrappit-sgn01.tokiomarine.com.vn:7254/api/SurveyWorkflow/UnderwritingRefer?id=62&surveyPremises=Location1`,
                                method: "GET",
                                xhrFields: {
                                     withCredentials: true,
                                    responseType: "blob"
                                },
                                success: function (blob) {
                                    const url = window.URL.createObjectURL(blob);
                                    const tabName = `pdfPreviewTab_13`;
                                    const existingTab = window.open('', tabName);

                                    if (existingTab) {
                                        existingTab.location.href = url;
                                    } else {
                                        window.open(url, tabName);
                                    }

                                    window.URL.revokeObjectURL(url);
                                },
                                error: function (xhr, status, error) {
                                    appNotifyWarning("File is not exists.");
                                }
                            });
                        }
                    }
                }
              // { dataField:"surveyRefer", label:{text:"Survey Refer"}, editorType:"dxLink", editorOptions:{ items:[{text:"Refer",value:true, onClick:function(e){alert("Refer")}}] }}
            ]
    });
</script>
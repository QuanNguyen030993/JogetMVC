@* @page "{pageNum:int?}"
@using Newtonsoft.Json *@
@* @model Quotation_UW_FormModel *@
@* @{
   
    ViewBag.Title = "Quotation";
    ViewData["Id"] = 0;
} *@
<style>
    .dx-tabpanel .dx-tabpanel-tabs .dx-tab {
        width: auto;
        padding-left: 18px;
        padding-right: 18px;
    }
</style>

<div id="formUW">
</div>

<script type="text/javascript">
     $(`#formUW`).dxForm({
        items: [ 
              {itemType: "group", caption: "Attachment",colCount: 1, items: [{ dataField: "attachment", editorType:"dxFileUploader"
            ,
            editorOptions: {
            name: "files"
        }
        ,template: function (data, itemElement) {
            setTimeout(function () {
                var item = new Object();
                item.editorType = "dxFileUploader";
               item.sectionName = "UW";
                createEditor(item, itemElement, $("<div>"), null);
                loadAttachmentList("UW");
                }, 1000);
            }

        }
        ]}
            ,
              { dataField:"decision", label:{text:"Decision"}, editorType:"dxRadioGroup", editorOptions:{ items:[{text:"Accept",value:true},{text:"Assign",value:false},{text:"Need More Info",value:false}], layout:"horizontal" }, isRequired:true },
              { dataField:"premium", label:{text:"Premium"}, editorType:"dxNumberBox", editorOptions:{ min:0 } },
              { dataField:"terms", label:{text:"Terms"}, editorType:"dxTextArea", colSpan:2, editorOptions:{ height: 90 } },
              { dataField:"exclusions", label:{text:"Exclusions"}, editorType:"dxTextArea", colSpan:2, editorOptions:{ height: 70 } },
              {
                itemType: "button",
                    alignment: "left",
                    buttonOptions: {
                        text: "Survey refer",
                        onClick: function () {
                             $.ajax({
                                url: `https://appuat-sgn01.tokiomarine.com.vn:7254/api/SurveyWorkflow/UnderwritingRefer?id=62&surveyPremises=Location1`,
                                method: "GET",
                                xhrFields: {
                                     withCredentials: true,
                                    responseType: "blob"
                                },
                                success: function (blob) {
                                    const url = window.URL.createObjectURL(blob);
                                    const tabName = `pdfPreviewTab_13`;
                                    const existingTab = window.open('', tabName);

                                    if (existingTab) {
                                        existingTab.location.href = url;
                                    } else {
                                        window.open(url, tabName);
                                    }

                                    window.URL.revokeObjectURL(url);
                                },
                                error: function (xhr, status, error) {
                                    appNotifyWarning("File is not exists.");
                                }
                            });
                        }
                    }
                }
              // { dataField:"surveyRefer", label:{text:"Survey Refer"}, editorType:"dxLink", editorOptions:{ items:[{text:"Refer",value:true, onClick:function(e){alert("Refer")}}] }}
            ]
    });
</script>
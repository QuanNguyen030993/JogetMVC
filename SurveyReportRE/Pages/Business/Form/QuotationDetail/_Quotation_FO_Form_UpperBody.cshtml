 @{
    string dept = "FO";  

}
<div class="actionBarDept" id="actionBarDept@dept">
    <!-- COMPOSER -->
    <div class="composer">
        <div class="pinned-zone">
            <div class="pinned-zone-header">
                <div class="pinned-zone-title">Pinned notes for this section</div>
                <div class="pinned-toolbar">
                    <div id="btnExpandAllPins"></div>
                    <div id="btnCollapseAllPins"></div>
                    <div id="btnUrgentPins"></div>
                </div>
            </div>
            <div class="pin-list" id="pinList"></div>
        </div>

    </div>
    
</div>
<script>
        var currentSection = "@dept";
    var filterType = "All";
    var unreadOnly = false;
    var urgentPinsOnly = false;
     var sections = [
      { code: "@dept", name: "Section A · FO", pic: "thao.bp", commentCount: 12, pinCount: 2, blockerCount: 1, status: "Waiting" },
      // { code: "TS", name: "Section B · TS", pic: "hien.ttt", commentCount: 8, pinCount: 2, blockerCount: 1, status: "In Progress" },
      // { code: "UW", name: "Section C · UW", pic: "thanh.nt", commentCount: 17, pinCount: 4, blockerCount: 2, status: "Reviewing" },
      // { code: "PM", name: "Section D · PM", pic: "phuong.tt", commentCount: 4, pinCount: 0, blockerCount: 0, status: "Done" }
    ];


            var pinnedNotes = [
          {
            id: 1,
            toSection: "FO", // main target
            fromSection: "FO",
            type: "Request",
            unread: true,
            urgent: true,
            time: "09 Apr 2026 · 15:20",
            text: "Nhờ TS kiểm tra lại wording phần deductible và endorsement số 03 trước khi submit UW. Client đang hỏi khá sát nên cần confirm rõ trong ngày.",
            fullText: `Nhờ TS kiểm tra lại wording phần deductible và endorsement số 03. Nếu có thay đổi thì update lại quotation note trước khi chuyển qua UW.

    Client đang hỏi khá sát phần này nên nhờ ưu tiên giúp trong ngày. Nếu wording hiện tại chưa ổn thì note ngược về FO để team cập nhật mail phản hồi.`
          },
          {
            id: 2,
            toSection: "FO", // main target
            fromSection: "UW",
            type: "Reminder",
            unread: false,
            urgent: false,
            time: "09 Apr 2026 · 14:05",
            text: "Sau khi TS review xong wording thì ping lại UW để review impact tới referral note.",
            fullText: `Sau khi TS review xong wording thì ping lại UW giúp để team xem tiếp impact tới referral note.

    Chưa cần formal submit, chỉ cần summary nhanh các thay đổi chính là được.`
          },
          {
            id: 3,
            toSection: "UW", // main target
            fromSection: "FO",
            type: "Request",
            unread: true,
            urgent: false,
            time: "09 Apr 2026 · 11:00",
            text: "Nhờ UW xem lại phần referral note trước khi chốt premium với client.",
            fullText: `Nhờ UW xem lại phần referral note trước khi chốt premium với client.

    Nếu có điểm cần làm rõ thêm từ TS thì vui lòng để lại blocker để FO theo dõi trong cùng màn hình comment.`
          }
        ];





    function renderPins() {
      const wrap = $("#pinList");
      wrap.empty();

      const items = getCurrentPins();
      if (!items.length) {
        wrap.append(`<div class="empty-state">Không có pinned note cho section này.</div>`);
        return;
      }

      items.forEach(pin => {
        const urgentBadge = pin.urgent ? `<span class="mini-badge badge-soft-yellow">Urgent</span>` : "";
        const unreadBadge = pin.unread ? `<span class="mini-badge badge-soft-red">Unread</span>` : "";
        wrap.append(`
          <div class="pin-card" data-pin-id="${pin.id}">
            <div class="pin-mini">
              <div class="pin-mini-left">
                <span class="mini-badge badge-soft-yellow">From ${pin.fromSection}</span>
                <span class="mini-badge badge-soft-blue">To ${pin.toSection}</span>
                ${urgentBadge}
                ${unreadBadge}
              </div>
              <div class="pin-mini-text">${escapeHtml(pin.text)}</div>
              <div class="pin-mini-time">${pin.time}</div>
            </div>
            <div class="pin-full">
              <div class="pin-full-body">${escapeHtml(pin.fullText)}</div>
              <div class="pin-full-actions">
                <div class="btn-collapse-pin-${pin.id}"></div>
                <div class="btn-reply-pin-${pin.id}"></div>
                <div class="btn-done-pin-${pin.id}"></div>
                <div class="btn-unpin-pin-${pin.id}"></div>
              </div>
            </div>
          </div>
        `);
      });

      wrap.find(".pin-mini").on("click", function () {
        $(this).closest(".pin-card").toggleClass("expanded");
      });

      // items.forEach(pin => {
      //   $(`.btn-collapse-pin-${pin.id}`).dxButton({
      //     text: "Collapse",
      //     stylingMode: "text",
      //     onClick: function() {
      //       $(`[data-pin-id="${pin.id}"]`).removeClass("expanded");
      //     }
      //   });
      //   $(`.btn-reply-pin-${pin.id}`).dxButton({
      //     text: "Reply",
      //     stylingMode: "text",
      //     onClick: function() {
      //       popupInstance.show();
      //     }
      //   });
      //   $(`.btn-done-pin-${pin.id}`).dxButton({
      //     text: "Mark done",
      //     stylingMode: "text",
      //     type: "success"
      //   });
      //   $(`.btn-unpin-pin-${pin.id}`).dxButton({
      //     text: "Unpin",
      //     stylingMode: "text",
      //     type: "danger"
      //   });
      // });
    }
     function buildTopButtons() {


      $("#btnExpandAllPins").dxButton({
        text: "Expand Pins",
        icon: "chevrondown",
        stylingMode: "outlined",
        onClick: function() {
          $(".pin-card").addClass("expanded");
        }
      });

      $("#btnCollapseAllPins").dxButton({
        text: "Collapse Pins",
        icon: "chevronup",
        stylingMode: "outlined",
        onClick: function() {
          $(".pin-card").removeClass("expanded");
        }
      });

      $("#btnUrgentPins").dxButton({
        text: "Urgent only",
        stylingMode: "outlined",
        onClick: function(e) {
          urgentPinsOnly = !urgentPinsOnly;
          e.component.option("type", urgentPinsOnly ? "default" : "normal");
          renderPins();
        }
      });
    }
   
       function getCurrentPins() {
      let res = pinnedNotes.filter(x => x.toSection === currentSection);
      if (urgentPinsOnly) res = res.filter(x => x.urgent);
      return res;
    }

    

    buildTopButtons();
    renderPins();
</script> 


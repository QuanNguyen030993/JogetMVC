@using JogetMVC.Model
@{
    string dept = "LMKT";
    long quotationId = Convert.ToInt64(ViewData["Id"]);
}
    <!-- COMPOSER -->
    <div class="composer">

        <div class="dept-title">Comments</div>

        <div id="@QTViewIdHelper.CommentPanelControl(dept)"></div>
        <div class="composer-actions">
            
        </div>
        <div class="filter-bar">
            <div class="filter-left">
                <div id="@QTViewIdHelper.FilterTypeSelect(dept)"></div>
                
                <div id="@QTViewIdHelper.BtnFilterAll(dept)"></div>
                <div id="@QTViewIdHelper.BtnFilterRequest(dept)"></div>
                <div id="@QTViewIdHelper.BtnFilterBlocker(dept)"></div>
                <div id="@QTViewIdHelper.BtnFilterDiscussion(dept)"></div>
                <div id="@QTViewIdHelper.BtnFilterInternal(dept)"></div>
            </div>
            <div class="filter-note">
            </div>
            <div class="comment-wrap" id="@QTViewIdHelper.CommentWrap(dept)" style="width:100%"></div>
        </div>
    </div>

<script>
    setTimeout(() => {
        renderFormComment(`qt-commentPanelControl_@dept`,`@dept`,`qt`);
        // commentModule ('qt' , '@dept', null);
    },1);
</script>



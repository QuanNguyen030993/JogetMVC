@{
    string dept = "UW";

}


<div class="actionBarDept" id="actionBarDept@dept">
    <div class="actionLeft">
        <span class="dept-title">Actions</span>
    </div>
    <div class="actionRight">
        <div id="qt-btnSave_@dept"></div>
        <div id="qt-btnSubmitBranch_@dept"></div>
    </div>
</div>

<script>
     var dept = "@dept";
     setTimeout( () => {
    var findRoute = _nextStep.flowSteps.find(f => f.fromNodeId == dept && f.stepNo == _nextStep.currentStep); 
    $("#qt-btnSubmitBranch_@dept").dxButton({ text: findRoute ? findRoute.displayStatus : "", icon: "check", type: "info", 
    onClick: function (e) {
        var formItems = $(`#qt-form${dept}`).dxForm("instance")?.option("formData") || {};
        submitNextStep("@dept", _nextStep, findRoute, formItems);
        //  var sendData = new Object();
        // sendData.InstanceWorkflow = convertKeysToUpperFirstChar(_nextStep.instanceWorkflow);
        // sendData.StepsWorkflow = convertKeysToUpperFirstChar(findRoute);
        // sendData.QuotationId = formItems.id;
        // ajaxPost('/api/InstanceWorkflow/SubmitNextStep', sendData, {
        //     onSuccess: function (response) {
        //     },
        //     onError: function (err) {
        //     }
        // });
    }

    });
    $("#qt-btnSave_@dept").dxButton({ text: "Save", icon: "save", type: "default", onClick:
         function (e) {
               var formItems = $(`#qt-form${dept}`).dxForm("instance")?.option("formData") || {};
               var globalLoadPanel = $("#loadingPopup").dxLoadPanel({
                   shadingColor: "rgba(0,0,0,0.4)",
                   visible: false,
                   showIndicator: true,
                   showPane: false,
                   shading: true,
                   closeOnOutsideClick: false,
                    position: { of: `#qt-form${dept}`}
                   // onShown: function () {
                   //     setTimeout(function () {
                   //         appLoadPanel.hide();
                   //     }, 3000);
                   // }
               });
              globalLoadPanel.dxLoadPanel("instance").show();

             ajaxPut('/api/Quotation/UpdateData',
             {
                 key: formItems.id,
                 values: JSON.stringify(
                     formItems
                 )
             },
             {
                 onSuccess: function (response) {
                 },
                 onError: function (err) { }
             }
         );
         }
     });
     }, _delayRenderSubmitButton);
</script>
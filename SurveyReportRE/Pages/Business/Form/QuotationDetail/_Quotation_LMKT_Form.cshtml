@using JogetMVC.Model
@* @page "{pageNum:int?}"
@using Newtonsoft.Json *@
@* @model Quotation_LMKT_FormModel *@
@* @{
   
    ViewBag.Title = "Quotation";
    ViewData["Id"] = 0;
} *@
@{
    string dept = "LMKT";
    long quotationId = Convert.ToInt64(ViewData["Id"]); string quotationGuid = ViewData["Guid"].ToString();
}
<style>
    .dx-tabpanel .dx-tabpanel-tabs .dx-tab {
        width: auto;
        padding-left: 18px;
        padding-right: 18px;
    }
</style>
<script type="text/javascript">
    var sectionId = "@(ViewData["Cd"])";
    that.ModelName = "Quotation";
    that.moduleName = "default";
    that.editorType = "dxFileUploader"
    that.id = @(quotationId);
    that.guid = "@(quotationGuid)";
    that.sectionName = "@(dept)";
    that.titleName = "Upload Quotation";
    that.uploaderAllow = _role == "@dept";
    that.data = { SectionName: `${sectionId}_${that.moduleName}_@(quotationId)`, Department: "@(dept)", FieldName: that.moduleName, FormId: "@(QTViewIdHelper.Form(dept,quotationId))" };; //{"SectionName":"default_FO_410"}


    var that2 = new Object();
    that2.ModelName = "Quotation";
    that2.moduleName = "supportingDoc";
    that2.editorType = "dxFileUploader"
    that2.id = @(quotationId);
    that2.guid = "@(quotationGuid)";
    that2.sectionName = "@(dept)";
    that2.titleName = "Upload Supporting Document";
    that2.uploaderAllow = _role == "@dept";
    that2.data = { SectionName: `${sectionId}_${that2.moduleName}_@(quotationId)`, Department: "@(dept)", FieldName: that2.moduleName, FormId: "@(QTViewIdHelper.Form(dept,quotationId))" }; //{"SectionName":"default_FO_410"}

    $(`#@QTViewIdHelper.Form(dept, quotationId)`).dxForm({
        dataSource: makeBasicDataSource(that, true),
               items: [
                    {itemType: "group",caption: "Decision",colCount:2,items: [
        {
    dataField: "decision",
    label: { text: "Decision" },
    editorType: "dxRadioGroup",
    editorOptions: {
        items: [
            { id: "AC_@QTViewIdHelper.Decision(dept, quotationId)" , text: "Approve", value: true },
            { id: "RJ_@QTViewIdHelper.Decision(dept, quotationId)" , text: "Decline", value: false },
            // { id: "AS_@QTViewIdHelper.Decision(dept, quotationId)" , text: "Return", value: false }
        ],
         displayExpr: "text",
         valueExpr: "id",
         layout: "horizontal",
         itemTemplate: function(itemData, _, itemElement) {
         setTimeout(() => {
          var formItems = $(`#@QTViewIdHelper.Form(dept, quotationId)`).dxForm("instance")?.option("formData") || {};
          var tatObject = tryParseJSON(formItems.turnAroundTimeAttributes, "TAT Load Button Problem");
          if (tatObject) if (tatObject[`@dept`]?.AcceptDate)
          {
            $(`#AC_@QTViewIdHelper.Decision(dept, quotationId)`).addClass("btn-success");
            $(`#${itemData.id}`).dxButton("instance").option("disabled", true);
            if (itemData.id === "RJ_@QTViewIdHelper.Decision(dept, quotationId)" ) $(`#RJ_@QTViewIdHelper.Decision(dept, quotationId)`).dxButton("instance").option("disabled", false);
          }
         },_delayRenderDecisionButton);

         $(`<div id='${itemData.id}'>`).dxButton({
         text: itemData.text,
         width: "100%",
         height: "100%",
         onClick: function (e){
             if (_ == 0)
                 {
                      var formItems = $(`#@QTViewIdHelper.Form(dept, quotationId)`).dxForm("instance")?.option("formData") || {};
                       var tatObject = tryParseJSON(formItems.turnAroundTimeAttributes, "TAT Button Problem");
                      tatObject[`@dept`].AcceptDate = formatDateToString(new Date()).gmt7;
                      formItems.turnAroundTimeAttributes = JSON.stringify(tatObject);
                      var passingObject = new Object();
                      passingObject.statusName = "Signing Process"; // base on Dept
                      passingObject.Comment = `Quotation ${formItems.quotationCode} approved by ${_displayName}!`;  // base on Dept
                      passingObject.formItems = formItems;
                      passingObject.dept = `@dept`;
                      passingObject.url = '/api/Quotation/UpdateData';
                      passingObject.urlLog = `/api/Quotation/LogAction`;
                      passingObject.schemeName = `Quotation`;
                      acceptDecision(passingObject);

                      ajaxGet(`api/Document/DigiSign/${formItems.id}`, null).then(data => {
                      });;


                 }
                 if (_ == 1)
                 {
                      var formItems = $(`#@QTViewIdHelper.Form(dept, quotationId)`).dxForm("instance")?.option("formData") || {};
                      var tatObject = tryParseJSON(formItems.turnAroundTimeAttributes, "TAT Button Problem");
                      tatObject[`@dept`].AcceptDate = "";
                      formItems.turnAroundTimeAttributes = JSON.stringify(tatObject);
                      var passingObject = new Object();
                      passingObject.statusName = "@dept Pending"; // base on Dept
                      passingObject.Comment = `Quotation ${formItems.quotationCode} rejected by ${_displayName}!`;  // base on Dept
                      passingObject.formItems = formItems;
                      passingObject.dept = `@dept`;
                      passingObject.url = '/api/Quotation/UpdateData';
                      passingObject.urlLog = `/api/Quotation/LogAction`;
                      passingObject.schemeName = `Quotation`;
                      rejectDecision(passingObject);
                 }
                 }
                     }).appendTo(itemElement);
                  itemElement
                },
                isRequired: true
                }
            }]}, 
            { itemType: "group", caption: "Attachment", colCount: 1, items:  attachmentByCase(that , that2) },
            { dataField:"leaderComment", label:{text:"Comment"}, editorType:"dxTextArea", colSpan:2 }
           ]
    });
    viewFieldAdjust("@QTViewIdHelper.Form(dept, quotationId)");
</script>
<div id="@QTViewIdHelper.Form(dept, quotationId)">
</div>
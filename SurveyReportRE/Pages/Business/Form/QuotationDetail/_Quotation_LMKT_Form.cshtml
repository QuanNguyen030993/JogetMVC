@using JogetMVC.Model
@{
    string dept = "LMKT";
    long quotationId = Convert.ToInt64(ViewData["Id"]); string quotationGuid = ViewData["Guid"].ToString();
}
<style>
    .dx-tabpanel .dx-tabpanel-tabs .dx-tab {
        width: auto;
        padding-left: 18px;
        padding-right: 18px;
    }
</style>
<script type="text/javascript">
    $(function() {
    var sectionId = "@(ViewData["Cd"])";
    var that = new Object();
    that.ModelName = "Quotation";
    that.moduleName = "default";
    that.editorType = "dxFileUploader"
    that.id = @(quotationId);
    that.guid = "@(quotationGuid)";
    that.sectionName = "@(dept)";
    that.titleName = "Upload Quotation";
    that.uploaderAllow = _role == "@dept";
    that.data = { SectionName: `${sectionId}_${that.moduleName}_@(quotationId)`, Department: "@(dept)", FieldName: that.moduleName, FormId: "@(QTViewIdHelper.Form(dept,quotationId))" };; //{"SectionName":"default_FO_410"}


    var that2 = new Object();
    that2.ModelName = "Quotation";
    that2.moduleName = "supportingDoc";
    that2.editorType = "dxFileUploader"
    that2.id = @(quotationId);
    that2.guid = "@(quotationGuid)";
    that2.sectionName = "@(dept)";
    that2.titleName = "Upload Supporting Document";
    that2.uploaderAllow = _role == "@dept";
    that2.data = { SectionName: `${sectionId}_${that2.moduleName}_@(quotationId)`, Department: "@(dept)", FieldName: that2.moduleName, FormId: "@(QTViewIdHelper.Form(dept,quotationId))" }; //{"SectionName":"default_FO_410"}

     var mainFields =  [
                {itemType: "group",caption: "MGR Review",colCount:1,items: [
                    { itemType: "group", caption: "Attachment", colCount: 1, items:  attachmentByCase(that , that2) },
                     { dataField:"leaderComment", label:{text:"Comment"}, editorType:"dxTextArea", colSpan:2 }
                ]}
        ];

        var submitBranchId = `@QTViewIdHelper.BtnSubmitBranch(dept, quotationId)`;
        var submitBranchDecisionHostId = `SB_DecisionHost_@QTViewIdHelper.Decision(dept, quotationId)`;

        function moveSubmitBranchToDecision() {
            var $host = $(`#${submitBranchDecisionHostId}`);
            var $submitBranch = $(`#${submitBranchId}`);

            if (!$host.length || !$submitBranch.length) return false;

            $submitBranch
                .addClass("lmkt-submitbranch-decision")
                .appendTo($host);

            var formItems = $(`#@QTViewIdHelper.Form(dept, quotationId)`).dxForm("instance")?.option("formData") || {};
            var tatObject = tryParseJSON(formItems.turnAroundTimeAttributes, "TAT SubmitBranch Decision Problem");

            if (tatObject?.["@dept"]?.AcceptDate) {
                $submitBranch.find(".dx-button").css("background-color", "#17a2b8");
                $submitBranch.find(".dx-button").each(function () {
                    var instance = DevExpress.ui.dxButton.getInstance(this);
                    instance?.option("disabled", false);
                });
            }

            return true;
        }

        function moveSubmitBranchToDecisionDeferred() {
            var attempts = 0;
            var timer = setInterval(function () {
                attempts++;
                if (moveSubmitBranchToDecision() || attempts >= 30) {
                    clearInterval(timer);
                }
            }, 200);
        }

    $(`#@QTViewIdHelper.Form(dept, quotationId)`).dxForm({
        dataSource: makeBasicDataSource(that, true),
               items: [
                    {itemType: "group",caption: "Decision",colCount:2,items: [
                {
                     dataField: "decision",

                     label: {
                         text: "Decision"
                     },
                     itemType: "simple",

                     template: function (data, itemElement) {
                         $(`<div id="${submitBranchId}" class="lmkt-submitbranch-decision-host"></div>`)
                             .appendTo(itemElement);
                         // moveSubmitBranchToDecisionDeferred();
                         }

                 }
    ]}, 
            ...mainFields
           
           ]
    });
    viewFieldAdjust("@QTViewIdHelper.Form(dept, quotationId)");

    setTimeout(() => {
        var picJson = PIC_JSON || "{}";
        var picMap = parsePicMap(picJson);
        var picVal = picMap["@dept"] || "";
        var sectionId = `#qt-sec_@(dept)_@(quotationId)`;
        if (!picVal) {
            $(sectionId).find(".dept-upperbody, .dept-body, .dept-lowerbody, .dept-footer").hide();
        } else {
            $(sectionId).find(".dept-upperbody, .dept-body, .dept-lowerbody, .dept-footer").show();
        }
    }, 100);

    setTimeout(
        moveSubmitBranchToDecisionDeferred,
        typeof _delayRenderDecisionButton !== "undefined" ? _delayRenderDecisionButton : 2000
    );

    })  
</script>
<div id="@QTViewIdHelper.Form(dept, quotationId)">
</div>

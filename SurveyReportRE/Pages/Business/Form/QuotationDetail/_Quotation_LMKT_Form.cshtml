@using JogetMVC.Model
@{
    string dept = "LMKT";
    string prefix = "qt";
    long quotationId = Convert.ToInt64(ViewData["Id"]); string quotationGuid = ViewData["Guid"].ToString();
}
<style>
    .dx-tabpanel .dx-tabpanel-tabs .dx-tab {
        width: auto;
        padding-left: 18px;
        padding-right: 18px;
    }
</style>
<script type="text/javascript">
    $(function () {

        var sectionId = "@(ViewData["Cd"])";

        var thisObject = {
            ModelName: "Quotation",
            formId: `@QTViewIdHelper.Form(dept, quotationId)`,
            dept: "@dept",
            prefix: "@prefix"
        };

        var that = {
            ModelName: "Quotation",
            moduleName: "default",
            editorType: "dxFileUploader",
            id: @(quotationId),
            guid: "@(quotationGuid)",
            sectionName: "@dept",
            titleName: "Upload Quotation",
            uploaderAllow: _role == "@dept"
        };

        that.data = {
            SectionName: window.IdManager.attachmentSectionKey(
                sectionId,
                that.moduleName,
    @(quotationId)
            ),
            Department: "@dept",
            FieldName: that.moduleName,
            FormId: "@QTViewIdHelper.Form(dept, quotationId)"
        };


        var that2 = {
            ModelName: "Quotation",
            moduleName: "supportingDoc",
            editorType: "dxFileUploader",
            id: @(quotationId),
            guid: "@(quotationGuid)",
            sectionName: "@dept",
            titleName: "Upload Supporting Document",
            uploaderAllow: _role == "@dept"
        };

        that2.data = {
            SectionName: window.IdManager.attachmentSectionKey(
                sectionId,
                that2.moduleName,
    @(quotationId)
            ),
            Department: "@dept",
            FieldName: that2.moduleName,
            FormId: "@QTViewIdHelper.Form(dept, quotationId)"
        };


        var mainFields = [
            {
                itemType: "group",
                caption: "MGR Review",
                colCount: 1,
                items: [
                    {
                        itemType: "group",
                        caption: "Attachment",
                        colCount: 1,
                        items: attachmentByCase(that, that2)
                    }
                ]
            }
        ];


        var acceptButtonId =
            `AC_@QTViewIdHelper.Decision(dept, quotationId)`;

        var panelStatusId =
            `Status_@QTViewIdHelper.Decision(dept, quotationId)`;


        var acceptDecisionV2 = {
            buttonId: null,

            statusId: panelStatusId,

            text: "Accept",
            icon: "check",
            type: "success",
            buttonClass: "dx-button-success",

            disabled: true,

            useDefaultDecisionClick: true,

            acceptStatusField: "actionStatus",

            useTatAcceptStatus: true,

            tatStatusText: "Accepted",

            skipAcceptedMainFields: false,

            statusButtonDisabled: true
        };


        var itemsDelay = [
            acceptDecisionV2
        ];


        var formId =
            "@QTViewIdHelper.Form(dept, quotationId)";


        $(`#${formId}`).dxForm({

            dataSource: makeBasicDataSource(
                that,
                true
            ),

            items: [
                {
                    itemType: "group",

                    name: "decision@(dept)Group",

                    cssClass:
                        "workflow-decision-group qt-decision-group-@(dept)",

                    elementAttr: {
                        id:
                            "qt-decision-group-@(dept)-@(quotationId)",

                        "data-form-group-name":
                            "decision@(dept)Group",

                        "data-route-dept":
                            "@dept"
                    },

                    caption:
                        "MKT MGR Review",

                    colCount: 2,

                    items: [
                        workflowDecisionField(
                            thisObject,
                            ...itemsDelay
                        )
                    ]
                },

                ...mainFields
            ]
        });


        viewFieldAdjust(formId);


        // ============================================================
        // DECISION CONTEXT
        // ============================================================
        // delayAcceptStatusV2(mainFields,thisObject, ...itemsDelay);
        delayAcceptStatusV2Promise(
            null,
            thisObject,
            ...itemsDelay
        )
            .then(async function (decisionContext) {

                /*
                 * decisionContext hiện có:
                 *
                 * decisionContext.status
                 * decisionContext.buttons
                 * decisionContext.primaryButton
                 * decisionContext.actionHost
                 *
                 * decisionContext.enable()
                 * decisionContext.disable()
                 * decisionContext.setDisabled(...)
                 */
                var picJson =
                    PIC_JSON || "{}";

                var picMap =
                    parsePicMap(picJson);

                var picVal =
                    picMap["@dept"] || "";

                var $section =
                    $(`#qt-sec_@(dept)_@(quotationId)`);


                if (!picVal) {

                    $section
                        .find(
                            ".dept-upperbody, " +
                            ".dept-body, " +
                            ".dept-lowerbody, " +
                            ".dept-footer"
                        )
                        .hide();

                }
                else {

                    $section
                        .find(
                            ".dept-upperbody, " +
                            ".dept-body, " +
                            ".dept-lowerbody, " +
                            ".dept-footer"
                        )
                        .show();
                }


                /*
                 * =========================================================
                 * DECISION
                 * =========================================================
                 */

                console.log(
                    "LMKT decision context:",
                    decisionContext
                );


                /*
                 * Nếu muốn enable tất cả decision button
                 */
                decisionContext.enable();


                /*
                 * Nếu chỉ muốn primary button:
                 *
                 * decisionContext.primaryButton?.enable();
                 *
                 * decisionContext.primaryButton?.disable();
                 */


                /*
                 * Status object
                 */
                console.log(
                    "Status:",
                    decisionContext.status
                );


                /*
                 * =========================================================
                 * CUSTOM ROUTE
                 * =========================================================
                 */

                var workflowResult =
                    await loadSelectedWorkflow({

                        moduleCode: "qt",

                        id: @(quotationId),

                        guid: "@quotationGuid",

                        reload: false
                    });


                console.log(
                    "Workflow result:",
                    workflowResult
                );


                var customRouteObjects =
                    workflowResult?.customRouteObjects || [];


                console.log(
                    "LMKT custom routes:",
                    customRouteObjects
                );


                /*
                 * Chỉ lấy route của LMKT
                 */
                var lmktRoutes =
                    customRouteObjects.filter(
                        function (item) {
                            return item.dept === "@dept";
                        }
                    );


                /*
                 * Enable toàn bộ custom route LMKT
                 */
                lmktRoutes.forEach(
                    function (item) {
                        item.enable();
                    }
                );


                /*
                 * Nếu cần disable:
                 *
                 * lmktRoutes.forEach(function (item) {
                 *     item.disable();
                 * });
                 */


                /*
                 * Ví dụ tìm route cụ thể
                 */
                var approveRoute =
                    lmktRoutes.find(
                        function (item) {

                            return (
                                item.route?.actionCode === "Approve" ||
                                item.route?.displayStatus === "Approve"
                            );
                        }
                    );
                // $(approveRoute).dxButton("instance").option("disabled", false);
                // if (approveRoute) {

                //     console.log(
                //         "Approve route:",
                //         approveRoute
                //     );

                //      approveRoute.enable();

                //     // approveRoute.disable();

                //     // approveRoute.button.instance
                //     //     ?.option("disabled", false);
                // }

            })
            .catch(function (error) {

                console.error(
                    "LMKT decision initialization failed:",
                    error
                );

            });

            setTimeout(() => {
            
            });
    });
</script>
<div id="@QTViewIdHelper.Form(dept, quotationId)">
</div>

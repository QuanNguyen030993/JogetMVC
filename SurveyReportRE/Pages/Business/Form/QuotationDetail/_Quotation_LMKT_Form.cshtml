@using JogetMVC.Model
@* @page "{pageNum:int?}"
@using Newtonsoft.Json *@
@* @model Quotation_LMKT_FormModel *@
@* @{
   
    ViewBag.Title = "Quotation";
    ViewData["Id"] = 0;
} *@
@{
    string dept = "LMKT";
    long quotationId = Convert.ToInt64(ViewData["Id"]);
}
<style>
    .dx-tabpanel .dx-tabpanel-tabs .dx-tab {
        width: auto;
        padding-left: 18px;
        padding-right: 18px;
    }
</style>
<script type="text/javascript">
        var that = new Object();
    that.ModelName = "Quotation";

    $(`#@QTViewIdHelper.Form(dept, quotationId)`).dxForm({
        dataSource: makeBasicDataSource(that, true),
               items: [ 
                        {itemType: "group", caption: "Attachment",colCount: 1, items: attachmentDefault("qt","@(dept)",@(quotationId))}
        ,
             { dataField:"approve", label:{text:"Approval"}, editorType:"dxRadioGroup", editorOptions:{ items:[{text:"Approve",value:true},{text:"Reject",value:false}], layout:"horizontal" }, isRequired:true },
             { dataField:"comment", label:{text:"Comment"}, editorType:"dxTextArea", colSpan:2, editorOptions:{ height: 80 } }
           ]
    });
</script>
<div id="@QTViewIdHelper.Form(dept, quotationId)">
</div>
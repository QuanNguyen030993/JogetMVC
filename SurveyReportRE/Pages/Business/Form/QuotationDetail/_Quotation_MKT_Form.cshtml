        function getIconByExt(ext) {
      ext = (ext || "").toLowerCase();
      if (ext === "pdf") return "📕";
      if (ext === "xls" || ext === "xlsx" || ext === "csv") return "📗";
      if (ext === "doc" || ext === "docx") return "📘";
      if (ext === "ppt" || ext === "pptx") return "📙";
      if (ext === "msg" || ext === "eml") return "✉️";
      if (ext === "xml" || ext === "json") return "🧾";
      if (ext === "zip" || ext === "rar" || ext === "7z") return "🗜️";
      if (["png","jpg","jpeg","gif","bmp","webp"].includes(ext)) return "🖼️";
      return "📎";
    }

    function getExt(fileName) {
      const s = (fileName || "");
      const i = s.lastIndexOf(".");
      return i >= 0 ? s.substring(i + 1) : "";
    }

    function formatBytes(bytes) {
      const n = Number(bytes || 0);
      if (n < 1024) return n + " B";
      const kb = n / 1024;
      if (kb < 1024) return kb.toFixed(1) + " KB";
      const mb = kb / 1024;
      if (mb < 1024) return mb.toFixed(1) + " MB";
      const gb = mb / 1024;
      return gb.toFixed(1) + " GB";
    }

    // ✅ Load list attachments theo id trong formData
    async function loadAttachmentList_MKT() {
      const form = $("#formMKT").dxForm("instance");
      const formData = form?.option("formData") || {};
      const key = formData.guid; // đúng ý bạn: lấy id từ formData

      const $host = $("#attListMKT");
      if ($host.length === 0) return;

      if (!key) {
        $host.html("<div style='opacity:.7;padding:6px 2px;'>No record id yet</div>");
        return;
      }

      try {
        // TODO: đổi API list cho đúng hệ thống của bạn
        const url = `/api/Attachment/GetByKey?key=${encodeURIComponent(key)}&folder=MKT`;
        const res = await fetch(url, { method: "GET" });
        const data = res.ok ? (await res.json().catch(() => [])) : [];

        renderAttachmentList_MKT(data || []);
      } catch (e) {
        $host.html("<div style='color:#b91c1c;padding:6px 2px;'>Cannot load attachments</div>");
      }
    }

    function renderAttachmentList_MKT(list) {
      const $host = $("#attListMKT");
      $host.empty();

      if (!list || list.length === 0) {
        $host.html("<div style='opacity:.7;padding:6px 2px;'>No attachments</div>");
        return;
      }

      list.forEach(x => {
        const fileName = x.fileName || x.FileName || x.name || "Unnamed";
        const ext = (x.extension || x.Extension || getExt(fileName)).toLowerCase();
        const size = x.size || x.fileSize || x.FileSize || 0;
        const downloadUrl = x.downloadUrl || x.DownloadUrl || x.url; // cần BE trả

        const $item = $("<div class='att-item'></div>");

        $("<div class='att-ico'></div>").text(getIconByExt(ext)).appendTo($item);

        const $meta = $("<div class='att-meta'></div>").appendTo($item);
        $("<div class='att-name'></div>").text(fileName).appendTo($meta);
        $("<div class='att-sub'></div>").text((ext ? ext.toUpperCase() : "FILE") + " • " + formatBytes(size)).appendTo($meta);

        const $actions = $("<div class='att-actions'></div>").appendTo($item);

        // Open/Download
        $("<div>").dxButton({
          icon: "download",
          hint: "Download",
          stylingMode: "contained",
          onClick: function () {
            if (downloadUrl) window.open(downloadUrl, "_blank");
            else DevExpress.ui.notify("No downloadUrl from API", "warning", 2000);
          }
        }).appendTo($actions);

        // Delete (nếu có API)
        $("<div>").dxButton({
          icon: "trash",
          hint: "Delete",
          stylingMode: "outlined",
          onClick: async function () {
            const id = x.id || x.Id || x.attachmentId;
            if (!id) return DevExpress.ui.notify("Missing attachment id", "warning", 2000);

            try {
              // TODO: đổi delete API cho đúng của bạn
              const delUrl = `/api/Attachment/Delete?id=${encodeURIComponent(id)}`;
              const delRes = await fetch(delUrl, { method: "DELETE" });
              if (!delRes.ok) throw new Error("Delete failed");

              DevExpress.ui.notify("Deleted", "success", 1200);
              loadAttachmentList_MKT();
            } catch (err) {
              DevExpress.ui.notify(err.message || "Delete error", "error", 2500);
            }
          }
        }).appendTo($actions);

        // click vào item cũng mở file
        $item.css("cursor", downloadUrl ? "pointer" : "default");
        $item.on("click", function (ev) {
          // tránh click vào button bị trigger open 2 lần
          if ($(ev.target).closest(".dx-button").length) return;
          if (downloadUrl) window.open(downloadUrl, "_blank");
        });

        $host.append($item);
      });
    }


@* @page "{pageNum:int?}"
@using Newtonsoft.Json *@
@* @model Quotation_MKT_FormModel *@
@* @{
   
    ViewBag.Title = "Quotation";
    ViewData["Id"] = 0;
} *@
<style>
    .dx-tabpanel .dx-tabpanel-tabs .dx-tab {
        width: auto;
        padding-left: 18px;
        padding-right: 18px;
    }
    .att-list {
        margin-top: 10px;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 10px;
    }

    .att-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        background: #fff;
    }

    .att-ico {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        font-size: 18px;
        background: #f3f4f6;
        flex: 0 0 auto;
    }

    .att-meta {
        flex: 1;
        min-width: 0;
    }

    .att-name {
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .att-sub {
        opacity: .75;
        font-size: 12px;
        margin-top: 2px;
    }

    .att-actions {
        display: flex;
        gap: 6px;
        flex: 0 0 auto;
    }

</style>
<div id="formMKT">
</div>
<script type="text/javascript">
        function getIconByExt(ext) {
      ext = (ext || "").toLowerCase();
      if (ext === "pdf") return "📕";
      if (ext === "xls" || ext === "xlsx" || ext === "csv") return "📗";
      if (ext === "doc" || ext === "docx") return "📘";
      if (ext === "ppt" || ext === "pptx") return "📙";
      if (ext === "msg" || ext === "eml") return "✉️";
      if (ext === "xml" || ext === "json") return "🧾";
      if (ext === "zip" || ext === "rar" || ext === "7z") return "🗜️";
      if (["png","jpg","jpeg","gif","bmp","webp"].includes(ext)) return "🖼️";
      return "📎";
    }

    function getExt(fileName) {
      const s = (fileName || "");
      const i = s.lastIndexOf(".");
      return i >= 0 ? s.substring(i + 1) : "";
    }

    function formatBytes(bytes) {
      const n = Number(bytes || 0);
      if (n < 1024) return n + " B";
      const kb = n / 1024;
      if (kb < 1024) return kb.toFixed(1) + " KB";
      const mb = kb / 1024;
      if (mb < 1024) return mb.toFixed(1) + " MB";
      const gb = mb / 1024;
      return gb.toFixed(1) + " GB";
    }

    // ✅ Load list attachments theo id trong formData
    async function loadAttachmentList_MKT() {
      const form = $("#formMKT").dxForm("instance");
      const formData = form?.option("formData") || {};
      const key = formData.guid; // đúng ý bạn: lấy id từ formData

      const $host = $(`#attListMKT_${formData.id}_undefined`);
      if ($host.length === 0) return;

      if (!key) {
        $host.html("<div style='opacity:.7;padding:6px 2px;'>No record id yet</div>");
        return;
      }

      try {
        // TODO: đổi API list cho đúng hệ thống của bạn
        const url = `/api/Document/GetByKey?recordGuid=${encodeURIComponent(key)}&folder=MKT`;
        const res = await fetch(url, { method: "GET" });
        const data = res.ok ? (await res.json().catch(() => [])) : [];

        renderAttachmentList_MKT(data || [],$host);
      } catch (e) {
        $host.html("<div style='color:#b91c1c;padding:6px 2px;'>Cannot load attachments</div>");
      }
    }

    
        function renderAttachmentList_MKT(list, attListMKT_Host) {
        if (!attListMKT_Host || attListMKT_Host.length === 0) return;

        attListMKT_Host.empty();

        if (!list || list.length === 0) {
            attListMKT_Host.html("<div style='opacity:.7;padding:6px 2px;'>No attachments</div>");
            return;
        }

        list.forEach(function (x) {
            const fileName = x.fileName || x.FileName || x.name || "Unnamed";
            const ext = (x.extension || x.Extension || getExt(fileName)).toLowerCase();
            const size = x.size || x.fileSize || x.FileSize || 0;
            const downloadUrl = x.downloadUrl || x.DownloadUrl || x.url;
            const id = x.id || x.Id || x.attachmentId;
            
            const $item = $("<div>").addClass("att-item");

            $("<div>")
                .addClass("att-ico")
                .text(getIconByExt(ext))
                .appendTo($item);

            const $meta = $("<div>").addClass("att-meta").appendTo($item);

            $("<div>")
                .addClass("att-name")
                .attr("title", fileName)
                .text(fileName)
                .appendTo($meta);

            $("<div>")
                .addClass("att-sub")
                .text((ext ? ext.toUpperCase() : "FILE") + " • " + formatBytes(size))
                .appendTo($meta);

            const $actions = $("<div>").addClass("att-actions").appendTo($item);

            $("<div>").dxButton({
                icon: "download",
                hint: "Download",
                stylingMode: "contained",
                onClick: function (ev) {
                    ev.event?.stopPropagation?.();
                    if (downloadUrl) {
                        window.open(downloadUrl, "_blank");
                    } else {
                        DevExpress.ui.notify("No download url", "warning", 2000);
                    }
                }
            }).appendTo($actions);

            $("<div>").dxButton({
                icon: "trash",
                hint: "Delete",
                stylingMode: "outlined",
                onClick: async function (ev) {
                    ev.event?.stopPropagation?.();
                    if (!id) {
                        DevExpress.ui.notify("Missing id", "warning", 2000);
                        return;
                    }

                    try {
                        const res = await fetch(`/api/Document/DeleteDocumentData?id=${encodeURIComponent(id)}`, {
                            method: "GET"
                        });

                        if (!res.ok) throw new Error("Delete failed");

                        DevExpress.ui.notify("Deleted", "success", 1200);
                        loadAttachmentList_MKT();
                    } catch (err) {
                        DevExpress.ui.notify(err.message || "Delete error", "error", 2500);
                    }
                }
            }).appendTo($actions);

            $item.css("cursor", downloadUrl ? "pointer" : "default");
            $item.on("click", function (ev) {
                if ($(ev.target).closest(".dx-button").length) return;
                if (downloadUrl) window.open(downloadUrl, "_blank");
            });

            attListMKT_Host.append($item);
        });
    }

    $("#formMKT").dxForm({
    items: [

         {itemType: "group", caption: "Attachment",colCount: 1, items: [{ dataField: "attachment", editorType:"dxFileUploader"
            ,
            editorOptions: {
            name: "files"
        }
        ,template: function (data, itemElement) {
            setTimeout(function () {
                var item = new Object();
                item.editorType = "dxFileUploader";
                 var form = $("#formMKT").dxForm("instance");
                var formData = form?.option("formData") || {};
                var key = formData.id; // đúng ý bạn: lấy id từ formData
               this.refFieldId = key;
               this.guid = formData.guid;
               this.folder = "MKT";
               this.SectionName = "MKT";
                createEditor(item, itemElement, $("<div>"), this);
                loadAttachmentList_MKT();
                }, 1000);
            }
            
        }
        ]},
                 { dataField:"clientName", label:{text:"Client Name"}, isRequired:true },
                 { dataField:"requestType", editorType:"dxSelectBox", label:{text:"Request Type"}, editorOptions:{ items:["New","Renewal","Endorsement"] } },
                 { dataField:"notes", label:{text:"Notes"}, editorType:"dxTextArea", colSpan:2, editorOptions:{ height: 80 } }, 
                 { dataField:"surveyNeeded", label:{text:"Survey Needed"}, editorType:"dxSwitch" ,editorOptions:{ switchedOnText: "Yes", switchedOffText: "No"} },
                 {itemType: "group",
                caption: "Header  Request",
                colCount: 3,
                items: [
                    { dataField: "requestNo", label: { template: labelTpl("RequestNo - Mã Quotation Request") } },
                    { dataField: "requestRefNo", label: { template: labelTpl("RequestRefNo - Refversion của request") } },
                    { dataField: "quotationCode", label: { template: labelTpl("QuotationCode - Mã quotation khi request vào xử lý (Joget)") } },
                    // ✅ DATE: requestedDate
                    {
                      dataField: "requestedDate",
                      editorType: "dxDateBox",
                      editorOptions: { displayFormat: "dd/MM/yyyy" },
                      label: { template: labelTpl("RequestedDate - Ngày yêu cầu") }
                    },

                    // ✅ DATE: dueDate
                    {
                      dataField: "dueDate",
                      editorType: "dxDateBox",
                      editorOptions: { displayFormat: "dd/MM/yyyy" },
                      label: { template: labelTpl("DueDate - Due date") }
                    },
                    { dataField: "requestType", label: { template: labelTpl("RequestType - Loại request (ví dụ: New Quotation)") } },
                    { dataField: "quotationType", label: { template: labelTpl("QuotationType - Loại đơn quotation type (ví dụ: New)") } },
                    { dataField: "businessChannelName", label: { template: labelTpl("BusinessChannelName - Kênh kinh doanh (name)") } },
                    { dataField: "sourceOfBusinessName", label: { template: labelTpl("SourceOfBusinessName - Nguồn business (name)") } },
                    { dataField: "businessChannelDisplayName", label: { template: labelTpl("BusinessChannelDisplayName - Tên hiển thị kênh (name of biz)") } }
                    ]},{
        itemType: "group",
        caption: "Products",
        colCount: 2,
        cssClass: "group-readonly",
        items: [
            { dataField: "lineName", label: { template: labelTpl("Line") }, editorOptions: { readOnly: true } },
            { dataField: "productName", label: { template: labelTpl("Product") }, editorOptions: { readOnly: true } },
        ]
        },// =========================================================
    // Client / Policy Holder / Insured (From Quotation - Read only)
    // =========================================================
    {
        itemType: "group",
        caption: "Client / Policy Holder / Insured",
        colCount: 3,
        cssClass: "group-readonly",
        items: [
            { dataField: "policyHolder", label: { template: labelTpl("Policy Holder ID") }, editorOptions: { readOnly: true } },
            { dataField: "insuredId", label: { template: labelTpl("Insured ID") }, editorOptions: { readOnly: true } },

            { dataField: "clientCodePA", label: { template: labelTpl("Client Code (PA)") }, editorOptions: { readOnly: true } },
            { dataField: "clientCodeJG", label: { template: labelTpl("Client Code (JG)") }, editorOptions: { readOnly: true } },

            { dataField: "clientNameViet", label: { template: labelTpl("Client Name (VI)") }, editorOptions: { readOnly: true } },
            { dataField: "clientNameEng", label: { template: labelTpl("Client Name (EN)") }, editorOptions: { readOnly: true } },

            { dataField: "businessAddressViet", label: { template: labelTpl("Business Address (VI)") }, editorOptions: { readOnly: true } },
            { dataField: "businessAddressEng", label: { template: labelTpl("Business Address (EN)") }, editorOptions: { readOnly: true } }
        ]
    }

               ]
    
    });
</script>

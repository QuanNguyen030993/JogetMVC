@using JogetMVC.Model
@* @page "{pageNum:int?}"
@using Newtonsoft.Json *@
@* @model Quotation_PM_FormModel *@
@* @{
   
    ViewBag.Title = "Quotation";
    ViewData["Id"] = 0;
} *@
@{
    string dept = "PM";
    long quotationId = Convert.ToInt64(ViewData["Id"]); string quotationGuid = ViewData["Guid"].ToString();
}
<style>
    .dx-tabpanel .dx-tabpanel-tabs .dx-tab {
        width: auto;
        padding-left: 18px;
        padding-right: 18px;
    }
</style>
<div id="@QTViewIdHelper.Form(dept, quotationId)">
</div>
<script type="text/javascript">
        var that = new Object();
    that.ModelName = "Quotation";
    $(`#@QTViewIdHelper.Form(dept, quotationId)`).dxForm({
        dataSource: makeBasicDataSource(that, true),
                 items: [
            { itemType: "group", caption: "Attachment", colCount: 1, items: attachmentDefault("qt", "@(dept)", @(quotationId), "@(quotationGuid)") },
         {
    dataField: "decision",
    label: { text: "Decision" },
    editorType: "dxRadioGroup",
    editorOptions: {
        items: [
            { id: "AC_@QTViewIdHelper.Decision(dept, quotationId)" , text: "Accept", value: true },
            { id: "AS_@QTViewIdHelper.Decision(dept, quotationId)" , text: "Assign", value: false },
            { id: "RJ_@QTViewIdHelper.Decision(dept, quotationId)" , text: "Reject", value: false }
        ],
         displayExpr: "text",
         valueExpr: "id",
         layout: "horizontal",
         itemTemplate: function(itemData, _, itemElement) {
         setTimeout(() => {
          var formItems = $(`#@QTViewIdHelper.Form(dept, quotationId)`).dxForm("instance")?.option("formData") || {};
          var tatObject = JSON.parse(formItems.turnAroundTimeAttributes);
          if (tatObject[`@dept`].AcceptDate)
          {
            $(`#AC_@QTViewIdHelper.Decision(dept, quotationId)`).addClass("btn-success");
            $(`#${itemData.id}`).dxButton("instance").option("disabled", true);
            if (itemData.id === "RJ_@QTViewIdHelper.Decision(dept, quotationId)" ) $(`#RJ_@QTViewIdHelper.Decision(dept, quotationId)`).dxButton("instance").option("disabled", false);
          }
         },_delayRenderDecisionButton);

         $(`<div id='${itemData.id}'>`).dxButton({
         text: itemData.text,
         width: "100%",
         height: "100%",
         onClick: function (e){
             if (_ == 0)
                 {
                      var formItems = $(`#@QTViewIdHelper.Form(dept, quotationId)`).dxForm("instance")?.option("formData") || {};
                       var tatObject = JSON.parse(formItems.turnAroundTimeAttributes);
                      tatObject[`@dept`].AcceptDate = formatDateToString(new Date()).gmt7;
                      formItems.turnAroundTimeAttributes = JSON.stringify(tatObject);
                      var passingObject = new Object();
                      passingObject.statusName = "@dept Process"; // base on Dept
                      passingObject.Comment = `Quotation ${formItems.quotationCode} accepted by ${_displayName}!`;  // base on Dept
                      passingObject.formItems = formItems;
                      passingObject.dept = `@dept`;
                      passingObject.url = '/api/Quotation/UpdateData';
                      passingObject.urlLog = `/api/Quotation/LogAction`;
                      passingObject.schemeName = `Quotation`;
                      acceptDecision(passingObject);
                 }
                 if (_ == 2)
                 {
                      var formItems = $(`#@QTViewIdHelper.Form(dept, quotationId)`).dxForm("instance")?.option("formData") || {};
                      var tatObject = JSON.parse(formItems.turnAroundTimeAttributes);
                      tatObject[`@dept`].AcceptDate = "";
                      formItems.turnAroundTimeAttributes = JSON.stringify(tatObject);
                      var passingObject = new Object();
                      passingObject.statusName = "@dept Pending"; // base on Dept
                      passingObject.Comment = `Quotation ${formItems.quotationCode} rejected by ${_displayName}!`;  // base on Dept
                      passingObject.formItems = formItems;
                      passingObject.dept = `@dept`;
                      passingObject.url = '/api/Quotation/UpdateData';
                      passingObject.urlLog = `/api/Quotation/LogAction`;
                      passingObject.schemeName = `Quotation`;
                      rejectDecision(passingObject);
                 }
                 }
                     }).appendTo(itemElement);
                  itemElement
                },
                isRequired: true
                }
            }, {itemType: "group",caption: "Checklist",colCount:1,items: [
    {dataField: "policyNoCL",editorType: "dxCheckBox",visible:true},
    {dataField: "theInsured",editorType: "dxCheckBox",visible:true},
    {dataField: "occupation",editorType: "dxCheckBox",visible:true},
    {dataField: "occupationFCICode",editorType: "dxCheckBox",visible:true},
    {dataField: "riskGrading",editorType: "dxCheckBox",visible:true},
    {dataField: "pOI",editorType: "dxCheckBox",visible:true},
    {dataField: "tSI",editorType: "dxCheckBox",visible:true},
    {dataField: "premium",editorType: "dxCheckBox",visible:true},
    {dataField: "deductible",editorType: "dxCheckBox",visible:true},
    {dataField: "tnCs",editorType: "dxCheckBox",visible:true},
    {dataField: "occupationCode",editorType: "dxCheckBox",visible:true},
    {dataField: "premiumRate",editorType: "dxCheckBox",visible:true}
    ]} ]
       });
       viewFieldAdjust("@QTViewIdHelper.Form(dept, quotationId)");
</script>

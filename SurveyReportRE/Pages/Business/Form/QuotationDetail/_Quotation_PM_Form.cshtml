@using JogetMVC.Model

@{
    string dept = "PM";
    long quotationId = Convert.ToInt64(ViewData["Id"]);
}
<style>
    .dx-tabpanel .dx-tabpanel-tabs .dx-tab {
        width: auto;
        padding-left: 18px;
        padding-right: 18px;
    }
</style>
<div id="@QTViewIdHelper.Form(dept, quotationId)">
</div>
<script type="text/javascript">
    $(async function() {
    const initialFormData = await window.OverviewDataBootstrap.getFormData({
        moduleCode: viewIdModulePrefix.quotation,
        id: @quotationId,
        department: "@dept"
    }).catch(function (error) {
        console.warn("Quotation PM initial data is unavailable; form binding will continue from the overview.", error);
        return null;
    });

        console.log(initialFormData);
    $(`#@QTViewIdHelper.Form(dept, quotationId)`).dxForm({
        formData: initialFormData || {},
        readOnly: true,
        disabled: false,
        items: [
            {
                itemType: "group",
                name: "pmReferenceInformation",
                caption: "Reference Information",
                colCount: 1,
                items: [{
                    dataField: "inceptionDate",
                    label: { text: "Inception Date" },
                    editorType: "dxDateBox",
                    editorOptions: {
                        width: 200,
                        displayFormat: "dd/MM/yyyy",
                        readOnly: true
                    }
                }]
            },
            {
                itemType: "group",
                name: "paProcess",
                caption: "PA Process",
                colCount: 1,
                items: [{
                    itemType: "simple",
                    template: function (_, itemElement) {
                        return $("<div class='pa-process-launcher'>").dxButton({
                            text: "Open PA Process",
                            icon: "detailslayout",
                            stylingMode: "outlined",
                            onClick: function () {
                                openPaProcessPopup({
                                    key: "quotation-@quotationId",
                                    title: "PA Process · Quotation @quotationId",
                                    createContent: function (gridHost) {
                                        const paGridParams = {
                                            height: "100%",
                                            isAllowRowMenu: false,
                                            overrideGetUrl: "/api/PolicyIssuanceSubDetails/GetPaProcess/Quotation/@quotationId",
                                            gridEditorOptions: {
                                                editing: {
                                                    mode: "row",
                                                    allowUpdating: false,
                                                    allowAdding: false,
                                                    allowDeleting: false
                                                }
                                            }
                                        };
                                        const gridOptions = new PolicyIssuanceSubDetailsGridOption(
                                            "PolicyIssuanceSubDetails",
                                            "User",
                                            paGridParams
                                        );
                                        new MGrid(null, gridHost, gridOptions, null);
                                    }
                                });
                            }
                        });
                    }
                }]
            }
        ]
    });
    viewFieldAdjust("@QTViewIdHelper.Form(dept, quotationId)", ["PA Process"]);

    $(`#qt-sec_@(dept)_@(quotationId)`)
        .addClass("dept-section--reference")
        .attr("data-section-mode", "reference");
    });

</script>

@using JogetMVC.Model
@{
    string dept = "TS";
    long quotationId = Convert.ToInt64(ViewData["Id"]); string quotationGuid = ViewData["Guid"].ToString();
}
<style>
    .dx-tabpanel .dx-tabpanel-tabs .dx-tab {
        width: auto;
        padding-left: 18px;
        padding-right: 18px;
    }
</style>
<script type="text/javascript">
    var sectionId = "@(ViewData["Cd"])";
    that.ModelName = "Quotation";
    that.moduleName = "default";
    that.editorType = "dxFileUploader"
    that.id = @(quotationId);
    that.guid = "@(quotationGuid)";
    that.sectionName = "@(dept)";
    that.titleName = "Upload Quotation";
    that.data = { SectionName: `${sectionId}_${that.moduleName}_@(quotationId)`, Dept: "@(dept)", FieldName: that.moduleName, FormId: "@(QTViewIdHelper.Form(dept,quotationId))" };; //{"SectionName":"default_FO_410"}


    var that2 = new Object();
    that2.ModelName = "Quotation";
    that2.moduleName = "supportingDoc";
    that2.editorType = "dxFileUploader"
    that2.id = @(quotationId);
    that2.guid = "@(quotationGuid)";
    that2.sectionName = "@(dept)";
    that2.titleName = "Upload Supporting Document";
    that2.data = { SectionName: `${sectionId}_${that2.moduleName}_@(quotationId)`, Dept: "@(dept)", FieldName: that2.moduleName, FormId: "@(QTViewIdHelper.Form(dept,quotationId))" }; //{"SectionName":"default_FO_410"}
    $(`#@QTViewIdHelper.Form(dept, quotationId)`).dxForm({
    dataSource: makeBasicDataSource(that, true),
     items: [
         {itemType: "group",caption: "Decision",colCount:2,items: [
        {
        dataField: "decision",
        label: { text: "Decision" },
        editorType: "dxRadioGroup",
        editorOptions: {
            items: [
                { id: "AC_@QTViewIdHelper.Decision(dept, quotationId)" , text: "Accept", value: true },
                // { id: "AS_@QTViewIdHelper.Decision(dept, quotationId)" , text: "Assign", value: false },
                { id: "RJ_@QTViewIdHelper.Decision(dept, quotationId)" , text: "Reject", value: false }
            ],
             displayExpr: "text",
             valueExpr: "id",
             layout: "horizontal",
             itemTemplate: function(itemData, _, itemElement) {
             setTimeout(() => {
              var formItems = $(`#@QTViewIdHelper.Form(dept, quotationId)`).dxForm("instance")?.option("formData") || {};
              var tatObject = tryParseJSON(formItems.turnAroundTimeAttributes, "TAT Load Button Problem");
              if (tatObject) if (tatObject[`@dept`]?.AcceptDate)
              {
                $(`#AC_@QTViewIdHelper.Decision(dept, quotationId)`).addClass("btn-info");
                $(`#${itemData.id}`).dxButton("instance").option("disabled", true);
                if (itemData.id === "RJ_@QTViewIdHelper.Decision(dept, quotationId)" ) $(`#RJ_@QTViewIdHelper.Decision(dept, quotationId)`).dxButton("instance").option("disabled", false);
              }
             },_delayRenderDecisionButton);

             $(`<div id='${itemData.id}'>`).dxButton({
             text: itemData.text,
             width: "100%",
             height: "100%",
             onClick: function (e){
                 if (_ == 0)
                 {
                      var formItems = $(`#@QTViewIdHelper.Form(dept, quotationId)`).dxForm("instance")?.option("formData") || {};
                       var tatObject = tryParseJSON(formItems.turnAroundTimeAttributes, "TAT Button Problem");
                      tatObject[`@dept`].AcceptDate = formatDateToString(new Date()).gmt7;
                      formItems.turnAroundTimeAttributes = JSON.stringify(tatObject);
                      var passingObject = new Object(); 
                      passingObject.statusName = "@dept Process"; // base on Dept
                      passingObject.Comment = `Quotation ${formItems.quotationCode} accepted by ${_displayName}!`;  // base on Dept
                      passingObject.formItems = formItems; 
                      passingObject.dept = `@dept`;
                      passingObject.url = '/api/Quotation/UpdateData';
                      passingObject.urlLog = `/api/Quotation/LogAction`;
                      passingObject.schemeName = `Quotation`;
                      acceptDecision(passingObject);
                 }
                 if (_ == 1)
                 {
                      var formItems = $(`#@QTViewIdHelper.Form(dept, quotationId)`).dxForm("instance")?.option("formData") || {};
                      var tatObject = tryParseJSON(formItems.turnAroundTimeAttributes, "TAT Button Problem");
                      tatObject[`@dept`].AcceptDate = "";
                      formItems.turnAroundTimeAttributes = JSON.stringify(tatObject);
                      var passingObject = new Object();
                      passingObject.statusName = "@dept Pending"; // base on Dept
                      passingObject.Comment = `Quotation ${formItems.quotationCode} rejected by ${_displayName}!`;  // base on Dept
                      passingObject.formItems = formItems;
                      passingObject.dept = `@dept`;
                      passingObject.url = '/api/Quotation/UpdateData';
                      passingObject.urlLog = `/api/Quotation/LogAction`;
                      passingObject.schemeName = `Quotation`;
                      rejectDecision(passingObject);
                 }
             }

             }).appendTo(itemElement);
          itemElement
        },
        isRequired: true
        }
    }]},

    { itemType: "group", caption: "Attachment", colCount: 1, items: attachmentByCase(that , that2) },

    {dataField: "biQtNum",editorType: "dxSelectBox",visible:false},
    {dataField: "incBIQuoId",editorType: "dxTextBox",visible:false},
    {dataField: "iarQuotationNo",editorType: "dxTextBox",visible:false},
    {dataField: "IncIARQuoId",editorType: "dxSelectBox",visible:false},
    
    {itemType: "group",caption: "Quotation Detail",colCount:2,items: [
     {itemType: "group",caption: "",colCount:3, colSpan: 2,items: [
    {dataField: "tmiCode",editorType: "dxSelectBox",visible: true, editorOptions: makeSelectBoxEditorOptions(_enums.TMICode)},
    {dataField: "tmivShare",editorType: "dxNumberBox", visible:true},
    {dataField: "currencyId",editorType: "dxSelectBox", label: { text: "Currency" } , editorOptions: makeSelectBoxEditorOptions(_enums.Currency) }]},
    {itemType: "group",caption: "Insurance Period",colCount:4, colSpan: 2,items: [
    {dataField: "insPeriodId", label: { text: "Insurance Period" },editorType: "dxSelectBox",visible: true , editorOptions: makeSelectBoxEditorOptions(_enums.InsPeriod) },
    {dataField: "periodInsuranceStartDate",editorType: "dxDateBox", editorOptions: { displayFormat: "dd/MM/yyyy" } ,visible:true},
    {dataField: "periodInsuranceEndDate",editorType: "dxDateBox", editorOptions: { displayFormat: "dd/MM/yyyy" },visible:true},
    {dataField: "actualDays",editorType: "dxNumberBox",visible:true}
    ]},
    
    {itemType: "group",caption: "Sum Insured",colCount:4, colSpan: 2,items: [
    { dataField: "sumInsuredTotalUsd", editorType:"dxNumberBox", label: { template: labelTpl("SumInsuredTotalUsd - Total Sum Insured (USD)") } },
    { dataField: "exchangeRate", editorType:"dxNumberBox", label: { template: labelTpl("ExchangeRate - Exchange rate") } },
    { dataField: "sumInsuredTotal", editorType:"dxNumberBox", editorOptions: {format: '#,##0'} },
    ]},
    {itemType: "group",caption: "Premium",colCount:5, colSpan: 2,items: [
    // { dataField: "deductibleId", label: { template: labelTpl("Deductible - Deductible") } },// "dxDataGrid"
    { dataField: "premiumCfe", editorType:"dxNumberBox", label: { template: labelTpl("PremiumCfe - CFE premium") } },
    { dataField: "premiumVoluntary", editorType:"dxNumberBox", label: { template: labelTpl("PremiumVoluntary - Voluntary premium") } },
    { dataField: "premiumRate", editorType:"dxNumberBox", label: { template: labelTpl("PremiumRate - Premium rate") } },
    { dataField: "premiumTotalBeforeVat", editorType:"dxNumberBox", label: { template: labelTpl("PremiumTotalBeforeVat - Tổng premium trước VAT") } },
    { dataField: "premiumTotal", editorType:"dxNumberBox", editorType:"dxNumberBox", editorOptions: {format: '#,##0'
         } }
    ]},
    {itemType: "group",caption: "VAT",colCount:4, colSpan: 2,items: [
    {dataField: "vat", editorType:"dxNumberBox",visible:true},
    {dataField: "vatValue", editorType:"dxNumberBox",visible:true}
    ]},

     {
         itemType: "group",
         caption: "Due",
         colCount: 4,
         colSpan: 2,
         items: [
             { dataField: "totalDue", editorType:"dxNumberBox", editorOptions: {format: '#,##0'


         } },
             ]
     },
    {itemType: "group",caption: "Terms & Conditions",colCount:1, colSpan: 2,items: [
    {dataField: "termsConditionsText",editorType: "dxTextArea",visible:true}
    ]},

    {
     itemType: "group",
     caption: "Risk",
     colCount: 3,
     colSpan: 2,
     items: [
         { dataField: "riskGrade", label: { template: labelTpl("RiskGrade - Risk grade") } },
             { dataField: "topRiskPd", label: {text: "Top Risk (After Co)", template: labelTpl("TopRiskPd - Top risk PD") } },
             { dataField: "topRiskPdQuotation", label: { template: labelTpl("TopRiskPdQuotation - Top risk PD quotation") } }

     ]
    },
    {itemType: "group",caption: "Installment",colCount:2, colSpan: 2,items: [
    // {dataField: "installmentId",editorType: "dxTextBox",visible:true} //dxDatagrid
    ]},
    {itemType: "group",caption: "Coverage",colCount:4, colSpan: 2,items: [
        // {dataField: "coverageId",editorType:  "dxTextBox",visible:true} // "dxDataGrid"
    ]},
    {itemType: "group",caption: "Clause",colCount:2, colSpan: 2,items: [
    // {dataField: "clauseId",editorType: "dxTextBox",visible:true} //dxDatagrid
    ]}
    ]}
    
     ]
    });
    viewFieldAdjust("@QTViewIdHelper.Form(dept, quotationId)");
</script>
<div id="@QTViewIdHelper.Form(dept, quotationId)"></div>
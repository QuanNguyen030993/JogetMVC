<script type="text/javascript">
        var that = new Object();
    that.ModelName = "Quotation";
    $(`#@QTViewIdHelper.Form(dept, quotationId)`).dxForm({
        dataSource: makeBasicDataSource(that, true),
         items: [
                { itemType: "group", caption: "Attachment", colCount: 1, items: attachmentDefault("qt","@(dept)",@(quotationId))},


    {
            dataField: "decision",
            label: { text: "Decision" },
            editorType: "dxRadioGroup",
            editorOptions: {
                items: [
                    { id: "AC_@QTViewIdHelper.Decision(dept, quotationId)" , text: "Accept", value: true },
                    { id: "AS_@QTViewIdHelper.Decision(dept, quotationId)" , text: "Assign", value: false },
                    { id: "RJ_@QTViewIdHelper.Decision(dept, quotationId)" , text: "Reject", value: false }
                ],
                 displayExpr: "text",
                 valueExpr: "id",
                 layout: "horizontal",
                 itemTemplate: function(itemData, _, itemElement) {
                 setTimeout(() => {
                  var formItems = $(`#@QTViewIdHelper.Form(dept, quotationId)`).dxForm("instance")?.option("formData") || {};
                  var tatObject = JSON.parse(formItems.turnAroundTimeAttributes);
                  if (tatObject[`@dept`].AcceptDate)
                  {
                    $(`#AC_@QTViewIdHelper.Decision(dept, quotationId)`).addClass("btn-info");
                    $(`#${itemData.id}`).dxButton("instance").option("disabled", true);
                    if (itemData.id === "RJ_@QTViewIdHelper.Decision(dept, quotationId)" ) $(`#RJ_@QTViewIdHelper.Decision(dept, quotationId)`).dxButton("instance").option("disabled", false);
                  }
                 },4000);

                 $(`<div id='${itemData.id}'>`).dxButton({
                 text: itemData.text,
                 width: "100%",
                 height: "100%",
                 onClick: function (e){
                     if (_ == 0)
                     {
                          var formItems = $(`#@QTViewIdHelper.Form(dept, quotationId)`).dxForm("instance")?.option("formData") || {};
                           var tatObject = JSON.parse(formItems.turnAroundTimeAttributes);
                              tatObject[`@dept`].AcceptDate = new Date();
                              formItems.turnAroundTimeAttributes = JSON.stringify(tatObject);
                           ajaxPut('/api/Quotation/UpdateData',
                            {
                                key: formItems.id,
                                values: JSON.stringify(
                                    formItems
                                )
                            },
                            {
                                onSuccess: function (response) {
                                    Devexpress.ui.notify("Task accepted", "success");
                                },
                                onError: function (err) { }
                            });
                     }
                      if (_ == 2)
                     {
                            var formItems = $(`#@QTViewIdHelper.Form(dept, quotationId)`).dxForm("instance")?.option("formData") || {};
                  var tatObject = JSON.parse(formItems.turnAroundTimeAttributes);
                              tatObject[`@dept`].AcceptDate = "";
                              formItems.turnAroundTimeAttributes = JSON.stringify(tatObject);
                           ajaxPut('/api/Quotation/UpdateData',
                            {
                                key: formItems.id,
                                values: JSON.stringify(
                                    formItems
                                )
                            },
                            {
                                onSuccess: function (response) {
                                    Devexpress.ui.notify("Task accepted", "success");
                                },
                                onError: function (err) { }
                            });
                     }
                 }

                 }).appendTo(itemElement);

@using JogetMVC.Model
@{
    string dept = "FO";
    long quotationId = Convert.ToInt64(ViewData["Id"]); string quotationGuid = ViewData["Guid"].ToString();
    string prefix = "qt";
}

<style>
    .dx-tabpanel .dx-tabpanel-tabs .dx-tab {
        width: auto;
        padding-left: 18px;
        padding-right: 18px;
    }


</style>
<div id="@QTViewIdHelper.Form(dept, quotationId)">
</div>
<script type="text/javascript">
    $( function (){
                var thisObject = new Object();
        thisObject.ModelName =  "Quotation";
        thisObject.formId = `@QTViewIdHelper.Form(dept, quotationId)`;
            thisObject.dept = `@dept`;
        thisObject.prefix = `@prefix`;


        var acceptButtonId = `AC_@QTViewIdHelper.Decision(dept, quotationId)`;
        var acceptStatusId = `Status_@QTViewIdHelper.Decision(dept, quotationId)`;
        var declinedButtonId = `DC_@QTViewIdHelper.Decision(dept, quotationId)`;
        var declinedStatusId = `DC_Status_@QTViewIdHelper.Decision(dept, quotationId)`;
        

    var that = new Object();
    var sectionId = "@(ViewData["Cd"])";
    that.ModelName = "Quotation";
    that.moduleName = "default";
    that.editorType = "dxFileUploader";
    that.id = @(quotationId);
    that.guid ="@(quotationGuid)";
    that.sectionName = "@(dept)";
    that.titleName = "Upload Quotation";
    that.uploaderAllow = _role == "@dept";
    that.data = { SectionName: `${sectionId}_${that.moduleName}_@(quotationId)`, Department: "@(dept)", FieldName: that.moduleName, FormId: "@(QTViewIdHelper.Form(dept,quotationId))" };; //{"SectionName":"default_FO_410"}


    var that2 = new Object();
    that2.ModelName = "Quotation";
    that2.moduleName = "supportingDoc";
    that2.editorType = "dxFileUploader";
    that2.id = @(quotationId);
    that2.guid ="@(quotationGuid)";
    that2.sectionName = "@(dept)";
    that2.titleName = "Upload Supporting Document";
    // that2.uploaderAllow = _role == "@dept";
    that2.uploaderAllow = _role == "@dept";
    that2.data = { SectionName: `${sectionId}_${that2.moduleName}_@(quotationId)`, Department: "@(dept)", FieldName: that2.moduleName, FormId: "@(QTViewIdHelper.Form(dept,quotationId))" }; //{"SectionName":"default_FO_410"}

     var acceptDecisionV2 = {
        buttonId: acceptButtonId,
        statusId: acceptStatusId,
        text: "Accept",
        icon: "check",
        type: "success",
        buttonClass: "dx-button-success",
        disabled: true,
        useDefaultDecisionClick: true,
        acceptStatusField: "actionStatus",
        useTatAcceptStatus: true,
        tatStatusText: "Accepted",
        skipAcceptedMainFields: false,
        statusButtonDisabled: true
    };
    // var itemsDelay = [null, null, declinedButtonId, declinedStatusId];
    var itemsDelay = [acceptDecisionV2];


    function getClientDecisionStatus(actionStatus) {
        if (!actionStatus) return "";
        try {
            var status = typeof actionStatus === "string"
                ? JSON.parse(actionStatus)
                : actionStatus;
            return status?.ClientDecision || "";
        } catch (err) {
            console.warn("Unable to read ClientDecision from actionStatus", err);
            return "";
        }
    }

    function setClientDecisionStatus(decision) {
        var form = $("#@QTViewIdHelper.Form(dept, quotationId)").dxForm("instance");
        if (!form) return;

        var formData = form.option("formData") || {};
        var status = {};
        try {
            status = formData.actionStatus
                ? (typeof formData.actionStatus === "string" ? JSON.parse(formData.actionStatus) : formData.actionStatus)
                : {};
        } catch (err) {
            console.warn("Unable to update ClientDecision in actionStatus", err);
        }

        status = status && typeof status === "object" ? status : {};
        if (decision) {
            status.ClientDecision = decision;
        } else {
            delete status.ClientDecision;
        }
        form.updateData("actionStatus", JSON.stringify(status));
    }


    window.QuotationPage.state.formFO = $("#@QTViewIdHelper.Form(dept, quotationId)").dxForm({
    dataSource: makeBasicDataSource(that, true),
    onContentReady: function (e) {
        var formData = e.component.option("formData") || {};
        var storedDecision = getClientDecisionStatus(formData.actionStatus);
        if ((formData.clientDecision || "") !== storedDecision) {
            e.component.updateData("clientDecision", storedDecision || null);
        }
    },
    items: [

            { itemType: "group", caption: "Attachment", colCount: 1, items: attachmentByCase(that , that2)},
                {itemType: "group",caption: "Request Date",colCount:2,items: [
            {
                                  dataField: "requestedDate",
                                  editorType: "dxDateBox",
                                  editorOptions: { displayFormat: "dd/MM/yyyy" },
                                  label: {  template: labelTpl("RequestedDate - Ngày yêu cầu") }
                                },
            {
                                  dataField: "dueDate",
                                  editorType: "dxDateBox",
                                  editorOptions: { displayFormat: "dd/MM/yyyy" },
                                  label: { template: labelTpl("DueDate - Due date") }
                                }
            ]},

                 {itemType: "group",caption: "Client",colCount:2,items: [
                     { dataField:"clientName", label:{text:"Client Name"}, isRequired:true },
                   { dataField: "policyHolder", label: { template: labelTpl("Policy Holder ID") }, editorOptions: { readOnly: true } },
                    { dataField: "insuredId", label: { template: labelTpl("Insured ID") },visible: false, editorOptions: { readOnly: true } },
                    { dataField: "clientCode", visible: false, label: { template: labelTpl("Client Code") }, editorOptions: { readOnly: true } },
                    { dataField: "clientName", label: { template: labelTpl("Client Name") }, editorOptions: { readOnly: true } },
                    { dataField: "businessAddress", label: { template: labelTpl("Business Address") }, editorOptions: { readOnly: true } },
                        { dataField: "sourceOfBusinessName", label: { template: labelTpl("SourceOfBusinessName - Nguồn business (name)") } },

                     ]},
                      
                 // {
                 //    itemType: "group",
                 //    caption: "Client Confirm",
                 //    colCount: 1,
                 //    items: [
                 //        {
                 //            dataField: "clientDecision",
                 //            editorType: "dxRadioGroup",
                 //             name: "clientConfirmGroup",
                 //            label: { text: "Decision" },
                 //            editorOptions: {
                 //                layout: "horizontal",
                 //                items: ["Accept", "Refuse", "End Quotation"],
                 //                onValueChanged: function (e) {
                 //                    if (!e.event) return;
                 //                    setClientDecisionStatus(e.value);
                 //                }
                 //            }
                 //        }
                 //    ]
                 // },
                 {
                        itemType: "group",
                        caption: "Products",
                        colCount: 2,
                        cssClass: "group-readonly",
                        items: [
                            { dataField: "lineName", label: { template: labelTpl("Line") }, editorOptions: { readOnly: true } },
                            { dataField: "productName", label: { template: labelTpl("Product") }, editorOptions: { readOnly: true } },
                        ]
                    },
                
                 // { dataField:"surveyNeeded", label:{text:"Survey Needed"}, editorType:"dxSwitch" ,editorOptions:{ switchedOnText: "Yes", switchedOffText: "No"} },
                 {itemType: "group",
                caption: "Request Infomation",
                colCount: 3,
                items: [
                { dataField: "requestNo", label: { template: labelTpl("RequestNo - Mã Quotation Request") } },
                {dataField: "policyNo",editorType: "dxTextBox",visible:true},
                    { dataField: "requestRefNo",visible: false, label: { template: labelTpl("RequestRefNo - Refversion của request") } },
                    { dataField: "quotationCode", label: { template: labelTpl("QuotationCode - Mã quotation khi request vào xử lý (Joget)") } },
                     { dataField:"requestTypeId", editorType:"dxSelectBox", label:{text:"Request Type"}, editorOptions: makeSelectBoxEditorOptions(_enums.requestType),displayExpr: "value",
                      valueExpr: "id"
                 },
                    { dataField: "quotationType",visible: false, label: { template: labelTpl("QuotationType - Loại đơn quotation type (ví dụ: New)") } },
                    { dataField: "businessChannelName", label: { template: labelTpl("BusinessChannelName - Kênh kinh doanh (name)") } },
                    { dataField: "businessChannelDisplayName",visible: false, label: { template: labelTpl("BusinessChannelDisplayName - Tên hiển thị kênh (name of biz)") } },
                     { dataField:"reinsuranceId", editorType:"dxSelectBox", label:{text:"Reinsurance"},
                     editorOptions:{
                     items:_enums.reInsuranceType ,
                     displayExpr: "value",
                      valueExpr: "id"}
                 },
                 

                 { dataField:"subject", label:{text:"Subject"}, editorType:"dxTextArea", colSpan:3},
                
                            ]},
                            {
                                itemType: "group",
                                name: "decision@(dept)Group",
                                cssClass: "workflow-decision-group qt-decision-group-@(dept)",
                                elementAttr: {
                                    id: "qt-decision-group-@(dept)-@(quotationId)",
                                    "data-form-group-name": "decision@(dept)Group",
                                    "data-route-dept": "@dept"
                                },
                                caption: "Client Confirm",
                                colCount: 2,
                                items: [
                        workflowDecisionField(thisObject, ...itemsDelay)
                    ]}
               ]
    
    });
    viewFieldAdjust("@QTViewIdHelper.Form(dept, quotationId)");
    delayAcceptStatusV2(null, thisObject, ...itemsDelay);
    setTimeout(() => {
        var picJson = PIC_JSON || "{}";
        var picMap = parsePicMap(picJson);
        var picVal = picMap["@dept"] || "";
        var sectionId = `#qt-sec_@(dept)_@(quotationId)`;
        if (!picVal) {
            $(sectionId).find(".dept-upperbody, .dept-body, .dept-lowerbody, .dept-footer").hide();
        } else {
            $(sectionId).find(".dept-upperbody, .dept-body, .dept-lowerbody, .dept-footer").show();
        }
    }, 100);

    });
</script>

@{
    string dept = "FO";
}


<div class="dept-title">@dept</div>
<div class="dept-form-header">
    <div class="dept-form-header__assign">
        <div id="qt-@dept.ToString().ToLower()AssigneeBox"></div>
    </div>
    <div id="btnToggleResForm"></div>
</div>
<div id="qt-stickPanel_@dept">
@* <div class="sticky-wrap wobble" data-tooltip-toggle>
    <div class="pin">
    </div>
    <div class="sticky-note"></div>
    <div class="sticky-badge">1</div>
    <div class="sticky-mini-text">FROM FO</div>
    <div class="note-tooltip">
        <strong>Suggested use</strong><br>
        Icon này có thể gắn ở header section. Khi section trước có comment hoặc giao việc, chỉ cần bật icon sticky note để tạo điểm nhấn trực quan.
    </div>
</div> *@
</div>
<div class="dept-hint-wrap">
    <div class="dept-hint" id="qt-hintFO"></div>
    <div class="dept-updated" id="qt-updFO" title="Last updated">—</div>
    <div id="qt-expandCollapsedBtn_@dept" class="dept-toggle-icon" aria-hidden="true">▾</div>
</div>
<script>

     window.QuotationPage.resButtonComponent = $("#btnToggleResForm").dxButton({
                    text: "Res Form",
                    icon: "file",
                    type: "normal",
                    stylingMode: "contained",
                    onClick: () => {
                            var resItems = [

                                 {itemType: "group", caption: "Attachment",colCount: 1, items: [{ dataField: "attachment", editorType:"dxFileUploader"
            ,
            editorOptions: {
            name: "files"
        }
        ,template: function (data, itemElement) {
            setTimeout(function () {
                var item = new Object();
                item.editorType = "dxFileUploader";
                 item.moduleName = "qt"; item.sectionName = "RES";
                 createEditor(item, itemElement, $("<div>"), null);
                // loadAttachmentList("FO");
                }, 1000);
            }

        }
        ]},
        // =========================================================
        // I. Request Linking
        // =========================================================
        {
            itemType: "group",
            caption: "I. Request Linking",
            colCount: 2,
            items: [
                { dataField: "resRequestNo", label: { text: "RES Request No" } },
                { dataField: "documentId", label: { text: "Document Id" } },
                { dataField: "attachmentId", label: { text: "Attachment Id" } },
                { dataField: "quotationId", label: { text: "Quotation Id" } },
                { dataField: "quotationCodeView", label: { text: "Quotation Code View" } } // todo
            ]
        },

        // =========================================================
        // II. TMI Reference
        // =========================================================
        {
            itemType: "group",
            caption: "II. TMI Reference",
            colCount: 2,
            items: [
                { dataField: "tmiCode", label: { text: "TMI Code" } }
            ]
        },

        // =========================================================
        // IV. UW / Referral / Comment
        // =========================================================
        {
            itemType: "group",
            caption: "IV. UW / Referral / Comment",
            colCount: 2,
            items: [
                { dataField: "reason", label: { text: "Reason" }, editorType: "dxTextArea", colSpan: 2, editorOptions: { height: 80 } },
                { dataField: "isReferralRequired", label: { text: "Referral Required" }, editorType: "dxSwitch", editorOptions: { switchedOnText: "Yes", switchedOffText: "No" } },
                { dataField: "referralReason", label: { text: "Referral Reason" }, editorType: "dxTextArea", colSpan: 2, editorOptions: { height: 80 } },
                { dataField: "uwAuthorityCondition", label: { text: "UW Authority Condition" } },
                { dataField: "uwAuthorityForm", label: { text: "UW Authority Form" } },
                { dataField: "riskGrade", label: { text: "Risk Grade" } },
                { dataField: "showRiskGrade", label: { text: "Show Risk Grade" }, editorType: "dxSwitch", editorOptions: { switchedOnText: "Yes", switchedOffText: "No" } },
                { dataField: "foProposalComment", label: { text: "fo Proposal Comment" }, editorType: "dxTextArea", colSpan: 2, editorOptions: { height: 100 } },
                { dataField: "uwComment", label: { text: "UW Comment" }, editorType: "dxTextArea", colSpan: 2, editorOptions: { height: 100 } },
                {
                    itemType: "group",
                    caption: "UW Comment Attachment",
                    colCount: 1,
                    colSpan: 2,
                    items: [
                        {
                            dataField: "UwCommentAttachment",
                            label: { text: "UW Comment Attachment" },
                            editorType: "dxFileUploader",
                            editorOptions: {
                                name: "files"
                            },
                            template: function (data, itemElement) {
                                setTimeout(function () {
                                    var item = new Object();
                                    item.editorType = "dxFileUploader";
                                    item.moduleName = "qt"; item.sectionName = "UwCommentAttachment";
                                    createEditor(item, itemElement, $("<div>"), null);
                                }, 300);
                            }
                        }
                    ]
                }
            ]
        },

        // =========================================================
        // V. Sum Insured / Retention / Financial
        // =========================================================
        {
            itemType: "group",
            caption: "V. Sum Insured / Retention / Financial",
            colCount: 2,
            items: [
                { dataField: "totalSumInsured", label: { text: "Total Sum Insured" }, editorType: "dxNumberBox" },
                { dataField: "isTsiCalculated", label: { text: "TSI Calculated" }, editorType: "dxSwitch", editorOptions: { switchedOnText: "Yes", switchedOffText: "No" } },

                { dataField: "tsiPropertyDamage", label: { text: "TSI Property Damage" }, editorType: "dxNumberBox" },
                { dataField: "topRiskAmount", label: { text: "Top Risk Amount" }, editorType: "dxNumberBox" },

                { dataField: "topRiskPropertyDamage", label: { text: "Top Risk Property Damage" }, editorType: "dxNumberBox" },
                { dataField: "isTopRiskCalculated", label: { text: "Top Risk Calculated" }, editorType: "dxSwitch", editorOptions: { switchedOnText: "Yes", switchedOffText: "No" } },

                { dataField: "exposure", label: { text: "Exposure" }, editorType: "dxNumberBox" },
                { dataField: "deductible", label: { text: "Deductible" }, editorType: "dxNumberBox" },

                { dataField: "voluntaryDeductible", label: { text: "Voluntary Deductible" }, editorType: "dxNumberBox" },
                { dataField: "tmivShare", label: { text: "TMIV Share" }, editorType: "dxNumberBox" },

                { dataField: "retention", label: { text: "Retention" }, editorType: "dxNumberBox" },
                { dataField: "netRetention", label: { text: "Net Retention" }, editorType: "dxNumberBox" },

                { dataField: "netRetentionType", label: { text: "Net Retention Type" } },
                { dataField: "netRetentionValue", label: { text: "Net Retention Value" }, editorType: "dxNumberBox" },

                { dataField: "treatySurplus", label: { text: "Treaty Surplus" }, editorType: "dxNumberBox" },
                { dataField: "coInsuranceOutward", label: { text: "Co-Insurance Outward" }, editorType: "dxNumberBox" },

                { dataField: "sumAssuredType", label: { text: "Sum Assured Type" } },
                { dataField: "sumAssuredValue", label: { text: "Sum Assured Value" }, editorType: "dxNumberBox" }
            ]
        },

        // =========================================================
        // VI. Risk Information / Survey
        // =========================================================
        {
            itemType: "group",
            caption: "VI. Risk Information / Survey",
            colCount: 2,
            items: [
                { dataField: "propertyTypeList", label: { text: "Property Type List" }, editorType: "dxTextArea", colSpan: 2, editorOptions: { height: 80 } },
                { dataField: "protection", label: { text: "Protection" }, editorType: "dxTextArea", colSpan: 2, editorOptions: { height: 80 } },
                { dataField: "moreInfo", label: { text: "More Info" }, editorType: "dxTextArea", colSpan: 2, editorOptions: { height: 80 } },
                { dataField: "nonAppetiteRisk", label: { text: "Non-Appetite Risk" }, editorType: "dxTextArea", colSpan: 2, editorOptions: { height: 80 } },

                { dataField: "isNonAppetiteRisk", label: { text: "Is Non-Appetite Risk" }, editorType: "dxSwitch", editorOptions: { switchedOnText: "Yes", switchedOffText: "No" } },
                { dataField: "capacity", label: { text: "Capacity" }, editorType: "dxTextArea", editorOptions: { height: 80 } },

                { dataField: "hasCapacity", label: { text: "Has Capacity" }, editorType: "dxSwitch", editorOptions: { switchedOnText: "Yes", switchedOffText: "No" } },
                { dataField: "construction", label: { text: "Construction" } },

                { dataField: "management", label: { text: "Management" } },
                { dataField: "operationYearOfRisk", label: { text: "Operation Year Of Risk" }, editorType: "dxNumberBox" },

                { dataField: "currentInsurer", label: { text: "Current Insurer" } },
                { dataField: "surveyResult", label: { text: "Survey Result" }, editorType: "dxTextArea", editorOptions: { height: 80 } },

                { dataField: "hasSurveyResult", label: { text: "Has Survey Result" }, editorType: "dxSwitch", editorOptions: { switchedOnText: "Yes", switchedOffText: "No" } },

                {
                    itemType: "group",
                    caption: "Survey Result Attachment",
                    colCount: 1,
                    colSpan: 2,
                    items: [
                        {
                            dataField: "SurveyResultAttachment",
                            label: { text: "Survey Result Attachment" },
                            editorType: "dxFileUploader",
                            editorOptions: {
                                name: "files"
                            },
                            template: function (data, itemElement) {
                                setTimeout(function () {
                                    var item = new Object();
                                    item.editorType = "dxFileUploader";
                                    item.moduleName = "qt"; item.sectionName = "SurveyResultAttachment";
                                    createEditor(item, itemElement, $("<div>"), null);
                                }, 300);
                            }
                        }
                    ]
                }
            ]
        },

        // =========================================================
        // VII. Loss History / RI Arrangement
        // =========================================================
        {
            itemType: "group",
            caption: "VII. Loss History / RI Arrangement",
            colCount: 2,
            items: [
                { dataField: "lossHistoryAcc", label: { text: "Loss History Accumulated" }, editorType: "dxTextArea", colSpan: 2, editorOptions: { height: 80 } },
                { dataField: "lossHistoryAccNoClaim", label: { text: "Loss History No Claim" }, editorType: "dxNumberBox" },
                { dataField: "lossHistoryAccPremium", label: { text: "Loss History Premium" }, editorType: "dxNumberBox" },
                { dataField: "lossHistoryAccLossAmount", label: { text: "Loss History Loss Amount" }, editorType: "dxNumberBox" },
                { dataField: "lossHistoryAccRatio", label: { text: "Loss History Ratio" }, editorType: "dxNumberBox" },
                { dataField: "riArrangement", label: { text: "RI Arrangement" }, editorType: "dxTextArea", colSpan: 2, editorOptions: { height: 80 } },

                {
                    itemType: "group",
                    caption: "RI Arrangement Attachment",
                    colCount: 1,
                    colSpan: 2,
                    items: [
                        {
                            dataField: "RiArrangementAttachment",
                            label: { text: "RI Arrangement Attachment" },
                            editorType: "dxFileUploader",
                            editorOptions: {
                                name: "files"
                            },
                            template: function (data, itemElement) {
                                setTimeout(function () {
                                    var item = new Object();
                                    item.editorType = "dxFileUploader";
                                    item.moduleName = "qt"; item.sectionName = "RiArrangementAttachment";
                                    createEditor(item, itemElement, $("<div>"), null);
                                }, 300);
                            }
                        }
                    ]
                }
            ]
        },

        // =========================================================
        // VIII. Others / BI
        // =========================================================
        {
            itemType: "group",
            caption: "VIII. Others / BI",
            colCount: 2,
            items: [
                { dataField: "isOthers", label: { text: "Is Others" }, editorType: "dxSwitch", editorOptions: { switchedOnText: "Yes", switchedOffText: "No" } },
                { dataField: "isOthersForm", label: { text: "Is Others Form" } },
                { dataField: "showNameBizForm", label: { text: "Show Name Biz Form" }, editorType: "dxSwitch", editorOptions: { switchedOnText: "Yes", switchedOffText: "No" } },
                { dataField: "biQuotation", label: { text: "BI Quotation" } },
                { dataField: "tsiFromBiForm", label: { text: "TSI From BI Form" }, editorType: "dxNumberBox" }
            ]
        }
    ];

                       var popupInstance = makePopup("large", "Res");
                        popupInstance.option("contentTemplate", function (container) {

                       var _formConfig = new MFormOption();
                            _formConfig.originModelName = "Res";
                            _formConfig.formElementName = "Res";
                            _formConfig.colCount = 1;
                            var parentFormData = $("#qt-formFO").dxForm("instance")?.option("formData");
                            // _formConfig.container = $(`<div id = "form_${_formConfig.originModelName}_${parentFormData.resId}" style="padding: 10px; margin-right: 0px" >`);
                            _formConfig.container = $(`<div id = "qt-formRES" style="padding: 10px; margin-right: 0px" >`);
                            var form =  new ResFormQuotationForm(parentFormData.resId, null, _formConfig, _formConfig);
                           
                            
                            // var scrollView = $(`<div>`);
                            // scrollView.dxScrollView({
                            //     width: "100%",
                            //     height: "100%",
                            //     useNative: false
                            // });
                            var scrollView = popupStandardContentByScroll(form.container);
                            scrollView.appendTo(container);
                            form.formInstance.option("items", resItems);
                            form.formInstance.updateData("sectionName", "RES");
                            form.formInstance.updateData("specificFolder", `RES\\${parentFormData.quotationCode}`);

                    });
                    popupInstance.show();

                    }
                    });
</script>
    }

    .contentGrid {
        height: calc(100vh - 56px);
        margin-right: var(--collapsed-form-mr);
        display: grid;
        grid-template-columns: 360px 1fr;
        gap: 12px;
        padding: 12px;
        box-sizing: border-box;
        min-height: 0;
    }

    /* ======= dept node + callout (giữ đúng style bạn đã làm) ======= */
    .dept-node {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        z-index: 1;
    }

    .dept-circle {
        position: relative;
        width: var(--node);
        height: var(--node);
        border-radius: 999px;
        background: #fff;
        border: 2px solid var(--nodeBorder);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 8px;
        font-weight: 900;
        color: #111827;
        box-shadow: 0 6px 18px rgba(0,0,0,.08);
        pointer-events: auto;
        cursor: pointer;
        user-select: none;
        transition: transform .12s ease, box-shadow .12s ease, border-color .12s ease;
        z-index: 2;
    }

    .dept-node:hover .dept-circle {
        transform: scale(1.06);
    }

    .dept-node.status .dept-circle {
        border-color: rgba(232,74,95,.95);
        box-shadow: 0 0 0 4px rgba(232,74,95,.16), 0 10px 22px rgba(0,0,0,.10);
    }

    .dept-node.focus .dept-circle {
        border-color: rgba(37,99,235,.95);
        box-shadow: 0 0 0 4px rgba(37,99,235,.18), 0 10px 22px rgba(0,0,0,.10);
    }

    .dept-node.status.focus .dept-circle {
        border-color: rgba(37,99,235,.95);
    }

        .dept-node.status.focus .dept-circle::after {
            content: "";
            position: absolute;
            inset: 4px;
            border-radius: 999px;
            border: 2px solid rgba(232,74,95,.9);
            pointer-events: none;
        }

    .dept-callout {
        position: absolute;
        right: calc(var(--node) + 12px);
        top: 50%;
        transform: translateY(-50%) translateX(10px);
        min-width: 150px;
        height: 30px;
        padding: 0 10px;
        border-radius: 10px;
        background: #fff;
        border: 1px solid rgba(17,24,39,.14);
        box-shadow: 0 6px 14px rgba(0,0,0,.08);
        display: flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity .12s ease, transform .12s ease, visibility .12s ease;
        z-index: 3;
    }

        .dept-callout::after {
            content: "";
            position: absolute;
            right: -10px;
            top: 50%;
            transform: translateY(-50%);
            width: 0;
            height: 0;
            border-top: 8px solid transparent;
            border-bottom: 8px solid transparent;
            border-left: 10px solid #fff;
        }

        .dept-callout::before {
            content: "";
            position: absolute;
            right: -11px;
            top: 50%;
            transform: translateY(-50%);
            width: 0;
            height: 0;
            border-top: 9px solid transparent;
            border-bottom: 9px solid transparent;
            border-left: 11px solid rgba(17,24,39,.14);
        }

    .dept-node:hover .dept-callout {
        opacity: 1;
        visibility: visible;
        transform: translateY(-50%) translateX(0);
    }

    .dept-callout .co-icon {
        width: 18px;
        height: 18px;
        display: inline-grid;
        place-items: center;
    }

    .dept-callout .co-text {
        font-size: 12px;
        font-weight: 800;
        color: rgba(17,24,39,.85);
    }

    /* ======= NEW: Section header click expand/collapse + updated time ======= */
    .dept-section .dept-header {
        cursor: pointer;
        user-select: none;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid rgba(17,24,39,.08);
    }

    .dept-hint-wrap {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .dept-updated {
        font-size: 12px;
        font-weight: 800;
        color: rgba(17,24,39,.65);
        white-space: nowrap;
    }

    .dept-toggle-icon {
        font-size: 14px;
        font-weight: 900;
        opacity: .7;
        transform: rotate(0deg);
        transition: transform .15s ease;
    }


    .dept-section.collapsed .dept-toggle-icon {
        transform: rotate(-90deg);
    }

    .dept-form-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
        padding: 8px 0;
    }

    .dept-form-header__title {
        font-size: 18px;
        font-weight: 700;
        line-height: 1.2;
    }

    .dept-form-header__assign {
        min-width: 320px;
        max-width: 420px;
        width: 100%;
    }

    .contentGrid {
        height: calc(100vh - 56px);
        margin-right: var(--collapsed-form-mr);
        display: grid;
        grid-template-columns: minmax(260px, 420px) 10px minmax(620px, 1fr);
        gap: 0;
        padding: 12px;
        box-sizing: border-box;
        min-height: 0;
        min-width: 0;
    }

    .pane {
        min-width: 0;
        min-height: 0;
        overflow: hidden;
    }

    .pane-left {
        padding-right: 6px;
    }

    .pane-right {
        padding-left: 6px;
    }

    .pane-splitter {
        position: relative;
        width: 10px;
        cursor: col-resize;
        user-select: none;
        touch-action: none;
        min-height: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .pane-splitter::before {
            content: "";
            position: absolute;
            top: 0;
            bottom: 0;
            left: 50%;
            width: 1px;
            transform: translateX(-50%);
            background: rgba(17,24,39,.10);
        }

        .pane-splitter::after {
            content: "";
            width: 4px;
            height: 64px;
            border-radius: 999px;
            background: rgba(107,114,128,.35);
            box-shadow: 0 0 0 1px rgba(17,24,39,.05);
            transition: background .15s ease, transform .15s ease;
            z-index: 2;
        }

        .pane-splitter:hover::after,
        .pane-splitter.dragging::after {
            background: rgba(37,99,235,.55);
            transform: scaleY(1.08);
        }

    .pane .card {
        height: 100%;
        min-height: 0;
    }

    .quote-pane-scroll {
        height: 100%;
        overflow: auto;
        min-height: 0;
    }

    .contentGrid.left-collapsed {
        grid-template-columns: 56px 10px minmax(620px, 1fr);
    }

        .contentGrid.left-collapsed .pane-left .cardBody,
        .contentGrid.left-collapsed .pane-left .cardHeader > *:not(.collapse-toggle-wrap) {
            display: none !important;
        }

        .contentGrid.left-collapsed .pane-left .cardHeader {
            justify-content: center;
            padding-left: 0;
            padding-right: 0;
        }

    .collapse-toggle-wrap {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    #pi-btnToggleLeftPane {
        min-width: 36px;
    }

    .dept-section {
        opacity: 0;
        transform: translateY(18px);
        transition: opacity .35s ease, transform .35s ease;
    }

    .dept-section.visible {
        opacity: 1;
        transform: translateY(0);
    }

    .dept-section .animate-step {
        opacity: 0;
        transform: translateY(10px);
        transition: opacity .28s ease, transform .28s ease;
    }

    .dept-section .animate-step.visible {
        opacity: 1;
        transform: translateY(0);
    }

    .dept-callout.animate-step {
        opacity: 0;
        visibility: hidden;
        transform: translateY(6px);
        transition: opacity .28s ease, transform .28s ease, visibility .28s ease;
    }

    .dept-callout.animate-step.visible {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

</style>

<script type="text/javascript">
    var PIC_JSON = `{}`;
    var formModuleKeyQt = "pi";
    var pICs = [];
    if ($('[data-toggle="push-menu"]').hasClass("sidebar-collapse")) {
        $('[data-toggle="push-menu"]').click();
        isToggleMenu = true;
    }

    var page = window.PolicyIssuancePage;
    var state = page.state;

    state.nextStep = new Object();
    state.nextStep.flowSteps = [];
    state.nextStep.currentStep = 1;
    state.nextStep.instanceWorkflow = new Object();

    state.currentUserRole = _role;
    state.focusDept = _role == "IT" ? "FO" : _role;

    state.quotes = [];
    state.selectedId = null;
    state.selectedGuid = null;
    state.selectedCodeNo = null;
    state.selectedAttachmentId = null;
    state.stageDept = null;

    state.quotePaging = {
        skip: 0,
        take: 20,
        loading: false,
        done: false,
        firstLoadDone: false
    };
    var firstRender = true;
    setTimeout(() => {
     const QtRoles = piDeptModuleCode;
        $(`#${formModuleKeyQt}-loginRoleLabel`).text(state.currentUserRole);

        var filter = "all";
        var searchText = "";
        let selectedId = null;
        var selectedGuid = null;
        var selectedFromGuid = null;
        let selectedAttachmentId = null;
        var selectedCodeNo = null;
        var commentPanelOpened = false;
        let stageDept = null;
        var stageAccount = "";

        var deptData = { FO: {}, TS: {}, UW: {}, LMKT: {}, PM: {} };

        state.quoteDetails = {};

        function money(n) {
            return new Intl.NumberFormat("vi-VN", {
                style: "currency",
                currency: "VND"
            }).format(n || 0);
        }



        function statusClass(raw) { return normalizeStatus(raw).css; }
        function statusText(raw) { return normalizeStatus(raw).text; }

        function normalizeDeptKey(k) {
            return String(k || "").trim().toUpperCase();
        }

        function parsePicMap(picJson) {
            try {
                const obj = JSON.parse(picJson || "{}");
                const map = {};
                Object.keys(obj).forEach(k => map[normalizeDeptKey(k)] = obj[k]);
                return map;
            } catch {
                return {};
            }
        }

        function renderDeptCallouts(picJson) {
            const picMap = parsePicMap(picJson);
            $(".dept-node").each(function () {
                const dept = normalizeDeptKey($(this).data("key"));
                const $co = $(this).find(".dept-callout");
                if (!$co.length) return;
                const pic = picMap[dept] || "-";
                $co.find(".co-text").text(pic);
                $co.css({ color: "rgba(17,24,39,.85)" });
            });
        }

        function getSelectedModel() {
            if (selectedId && state.quoteDetails[selectedId]) {
                return state.quoteDetails[selectedId];
            }
            const q = state.quotes.find(x => x.id === selectedId) || state.quotes[0];
            return q || null;
        }

        function applyFilter(data) {
            var arr = (data || []).slice();

            if (filter !== "all") {
                arr = arr.filter(x => (x.status || x.policyIssuanceStatus) === filter);
            }

            if (searchText) {
                var t = searchText.toLowerCase();
                arr = arr.filter(x =>
                    (x.policyIssuanceCode || "").toLowerCase().includes(t) ||
                    (x.clientName || "").toLowerCase().includes(t) ||
                    String(x.requestNo || "").includes(t)
                );
            }

            return arr;
        }

        function buildListUrl() {
            const params = new URLSearchParams();
            params.set("skip", state.quotePaging.skip);
            params.set("take", state.quotePaging.take);

            if (searchText) params.set("searchText", searchText);
            if (filter && filter !== "all") params.set("policyIssuanceStatus", filter);

            return `/api/PolicyIssuance/GetAll?${params.toString()}`;
        }

        function loadQuoteDetail(id) {
            if (!id) return Promise.resolve(null);
            if (state.quoteDetails[id]) {
                return Promise.resolve(state.quoteDetails[id]);
            }
            return $.ajax({
                url: `/api/PolicyIssuance/GetAll?key=${id}`,
                method: "GET",
                contentType: "application/json"
            }).then(detail => {
                var item = Array.isArray(detail) ? detail[0] : detail;
                if (item) {
                    state.quoteDetails[id] = item;
                }
                return item;
            });
        }

        function showListLoader(show) {
            let $loader = $("#pi-quoteList").find(".quoteListLoader");
            if (!$loader.length) {
                $loader = $('<div class="quoteListLoader" style="display:none;">Loading...</div>');
                $("#pi-quoteList").append($loader);
            }
            show ? $loader.show() : $loader.hide();
        }

        function showListEnd(show) {
            let $end = $("#pi-quoteList").find(".quoteListEnd");
            if (!$end.length) {
                $end = $('<div class="quoteListEnd" style="display:none;">Hết dữ liệu</div>');
                $("#pi-quoteList").append($end);
            }
            show ? $end.show() : $end.hide();
        }

        function showListEmpty(show) {
            $("#pi-quoteList .quoteListEmpty").remove();
            if (show) {
                $("#pi-quoteList").append('<div class="quoteListEmpty">No policyIssuances found.</div>');
            }
        }

        function appendQuoteCards(data) {
            var $root = $("#pi-quoteList");

            data.forEach(q => {
                var isSel = q.id === selectedId;
                pICs.push({ policyIssuanceCode: q.policyIssuanceCode, pIC: q.pIC ?? "{}" });


                $root.append(`
                    <div class="${formModuleKeyQt}-quoteCard ${isSel ? "selected" : ""}" data-id="${q.id}" data-guid="${q.guid}" data-attachmentid="${q.documentId}" data-codeno="${q.policyIssuanceCode}" data-stagedept="${q.stageDept}" data-stageaccount="${parsePicMap(q.pIC)[q.stageDept] ? parsePicMap(q.pIC)[q.stageDept] : "(Unassigned)"}">
                        <div class="quoteTop">
                            <div>
                                <div class="quoteClient">${q.clientName || ""}</div>
                                <div>${q.productName || ""}</div>
                            </div>
                            <div class="statusTag ${statusClass(q.policyIssuanceStatus)}">${statusText(q.policyIssuanceStatus)}</div>
                        </div>
                        <div class="quoteMeta">
                            <div class="policyIssuanceCode">${q.policyIssuanceCode || ""}</div>
                            <div>${q.lineName || ""}</div>
                            <div>${(typeof formatDate === "function") ? formatDate(q.requestedDate, "dd-mm-yyyy") : (q.requestedDate || "")}</div>
                        </div>
                        <div class="quoteMeta">
                            <div>Total Sum Insured</div>
                            <div class="quoteAmount">${money(q.sumInsuredTotal)}</div>
                        </div>
                        <div class="quoteMeta">
                            <div>Total Premium</div>
                            <div class="quoteAmount">${money(q.premiumTotal)}</div>
                        </div>
                        <div class="quoteMeta">
                            <div>Total Due</div>
                            <div class="quoteAmount">${money(q.totalDue)}</div>
                        </div>
                    </div>
                `);
            });

            showListLoader(false);
            if (state.quotePaging.done) showListEnd(true);
        }

        function syncSelectedState(q) {
            if (!q) return;

            selectedId = q.id ?? null;
            selectedGuid = q.guid ?? null;
            selectedAttachmentId = q.documentId ?? null;
            selectedCodeNo = q.policyIssuanceCode ?? null;
            stageDept = q.stageDept ?? null;



            state.selectedId = selectedId;
            state.selectedGuid = selectedGuid;
            state.selectedAttachmentId = selectedAttachmentId;
            state.selectedCodeNo = selectedCodeNo;
            state.stageDept = stageDept;
            const params = new URLSearchParams();
            params.set("refKey", state.selectedGuid);
            params.set("refField", 'RecordGuid');
            ajaxGet(`/api/SectionCommentNote/GetAll?${params.toString()}`, null)
            .then(res => {
              var pinnedNotes = (res || []).map(x => ({
                            id: x.id,
                            section: x.currentDepartment,//target main
                            fromSection: x.fromDepartment,//target pin
                            toSection: x.toDepartment,
                            type: x.type,
                            unread: !x.isRead,
                            isRead: !x.isRead,
                            linkedPin: x.isPinned,
                            isPinned: x.isPinned,
                            body: x.content,
                            text: x.content,
                            replies: 0,
                            fullText: x.content,
                            urgent: false,
                            time: parseToGMT7(x.createdDate, 0)
                        }));
                        state.comments = pinnedNotes;
                    state.pinNotes = pinnedNotes.filter(f => f.isPinned);
            });


            PIC_JSON = pICs.find(f => f.policyIssuanceCode == state.selectedCodeNo)?.pIC ?? q.pIC ?? "{}";
            renderDeptCallouts(PIC_JSON);
            var map = parsePicMap(PIC_JSON);
            stageAccount = map[stageDept] ? map[stageDept] : "(Unassigned)";

            $(".pi-quoteCard").removeClass("selected");
            $(`.pi-quoteCard[data-id="${selectedId}"]`).addClass("selected");
        }

        function loadSelectedWorkflow() {
            if (!state.selectedCopyGuid) return $.Deferred().resolve().promise();
            console.log(state.selectedCopyGuid);
            return ajaxGet(`/api/PolicyIssuance/GetPolicyIssuanceWorkflow/${state.selectedCopyGuid}`, null)
                .then(instance => {
                    return ajaxGet(`/api/StepsWorkflow/GetNextStep/${instance?.workflowDefinitionId ?? "00000000-0000-0000-0000-000000000000"}/${instance?.currentStep ?? 0}`, null)
                        .then(data => {
                            state.nextStep.instanceWorkflow = instance;
                            state.nextStep.flowSteps = data;
                            state.nextStep.currentStep = instance?.currentStep ?? 0;
                                       var findRoute = state.nextStep.flowSteps.find(f => f.fromNodeId == item && f.stepNo == state.nextStep.instanceWorkflow.currentStep);
                                        $(`#pi-btnSubmitBranch_${item}`).dxButton({
                                            text: findRoute ? findRoute.displayStatus : "", icon: "check", type: "info", onClick:
                                                function (e) {
                                                    var content = tinymce.get(`pi-remarkBox_${item}`).getContent();
                                                    var formItems = $(`#pi-form${item}`).dxForm("instance")?.option("formData") || {};
                                                    formItems.comment = content;
                                                    submitNextStep(`${item}`, state.nextStep, findRoute, formItems);
                                                }
                                        });
                                   }, 100);
                        });
                });
        }

        async function loadQuotePage(reset = false) {
            if (state.quotePaging.loading) return;
            if (!reset && state.quotePaging.done) return;

            if (reset) {
                state.quotePaging.skip = 0;
                state.quotePaging.done = false;
                state.quotePaging.firstLoadDone = false;
                state.quotes = [];
                pICs = [];
                $("#pi-quoteList").empty();
                showListEnd(false);
                showListEmpty(false);
            }

            state.quotePaging.loading = true;
            showListLoader(true);

            try {
                var data = await $.ajax({
                    url: buildListUrl(),
                    method: "GET",
                    contentType: "application/json"
                });

                data = data.map(m => { m.pIC = m.pic; return m; });

                const rows = Array.isArray(data) ? data : [];

                if (reset && rows.length === 0) {
                    showListLoader(false);
                    showListEmpty(true);
                    state.quotePaging.done = true;
                    return;
                }

                state.quotes = state.quotes.concat(rows);
                appendQuoteCards(rows);

                state.quotePaging.skip += rows.length;
                if (rows.length < state.quotePaging.take) {
                    state.quotePaging.done = true;
                    showListEnd(true);
                }

                if (!state.quotePaging.firstLoadDone && state.quotes.length > 0) {
                    state.quotePaging.firstLoadDone = true;
                    syncSelectedState(state.quotes[0]);
                    await loadQuoteDetail(state.quotes[0].id);
                    await loadSelectedWorkflow();
                    renderDetail();
                }
            } catch (err) {
                console.error("loadQuotePage error:", err);
                showListLoader(false);
                DevExpress.ui.notify("Load policyIssuance list failed", "error", 1500);
            } finally {
                state.quotePaging.loading = false;
                showListLoader(false);
            }
        }

        function rerenderCurrentSelectionOnly() {
            $(".pi-quoteCard").removeClass("selected");
            $(`.pi-quoteCard[data-id="${selectedId}"]`).addClass("selected");
        }


        function reloadState(){
              $.each(piDeptModuleCode, function (itemIndex, item) {
                var items = new Object();
                items.moduleName = "pi";
                items.sectionName = item;

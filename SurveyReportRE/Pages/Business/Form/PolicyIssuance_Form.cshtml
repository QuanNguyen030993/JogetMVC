        async function loadQuotePage(reset = false) {
            if (state.quotePaging.loading) return false;
            if (!reset && state.quotePaging.done) return false;

            if (reset) {
                state.quotePaging.skip = 0;
                state.quotePaging.done = false;
                state.quotePaging.firstLoadDone = false;
                state.quotes = [];
                pICs = [];
            }

            state.quotePaging.loading = true;
            try {
                var data = await $.ajax({
                    url: buildListUrl(),
                    method: "GET",
                    contentType: "application/json"
                });
                policyIssuanceRenderGate.setPhase("Policy issuance data received…", 38);

                const rows = Array.isArray(data)
                    ? data.map(item => ({ ...item, pIC: item.pic }))
                    : [];

                if (reset && rows.length === 0) {
                    state.quotePaging.done = true;
                    return false;
                }

                state.quotes = state.quotes.concat(rows);

                state.quotePaging.skip += rows.length;
                if (rows.length < state.quotePaging.take) {
                    state.quotePaging.done = true;
                }

                if (!state.quotePaging.firstLoadDone && state.quotes.length > 0) {
                    state.quotePaging.firstLoadDone = true;
                    policyIssuanceRenderGate.setPhase("Binding policy issuance state…", 52);
                    await syncSelectedState(state.quotes[0]);
                    policyIssuanceRenderGate.setPhase("Initializing department forms…", 68);
                    await renderDetail();
                    policyIssuanceRenderGate.setPhase("Binding PIC assignments…", 86);
                }
                return true;
            } catch (err) {
                console.error("loadQuotePage error:", err);
                DevExpress.ui.notify("Load policyIssuance list failed", "error", 1500);
                return false;
            } finally {
                state.quotePaging.loading = false;
            }
        }


        // Coalesce SignalR/action reloads so every section finishes rendering once.
        var policyIssuanceReloadPromise = null;
        function reloadPolicyIssuanceInstance() {
            if (policyIssuanceReloadPromise) return policyIssuanceReloadPromise;

            var renderToken = policyIssuanceRenderGate.begin("Refreshing policy issuance…");
            policyIssuanceReloadPromise = (async function () {
                while (state.quotePaging.loading) {
                    await new Promise(resolve => setTimeout(resolve, 50));
                }

                // Chi load state, dxForm va PIC khi overlay con dang mo.
                var loaded = await loadQuotePage(true);
                if (!loaded) {
                    policyIssuanceRenderGate.fail(renderToken, "Policy issuance refresh failed");
                    return;
                }

                await new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)));
                $.each(piDeptModuleCode, function (itemIndex, item) {
                    var form = $(`#${window.PolicyIssuanceIdManager.form(item,@ViewData["Id"])}`).dxForm("instance");
                    form?.repaint();
                });
                applyEditLock();
                applyNodeHighlights();
                applySectionFocusHighlight();
                updateHints();
                await policyIssuanceRenderGate.complete(renderToken);
                firstRender = false;
                await policyIssuanceFormStages.enter("personInCharge");
                await renderPolicyIssuancePersonInCharge();
                await loadSelectedWorkflow();
                invalidateSectionCommentCache(state.selectedGuid);
                await policyIssuanceFormStages.enter("comments");
                await loadPolicyIssuanceSectionComments();
            })().catch(function (err) {
                console.error("reloadPolicyIssuanceComponents error:", err);
                policyIssuanceRenderGate.fail(renderToken, "Policy issuance refresh failed");
            })().finally(function () {
                policyIssuanceReloadPromise = null;
            });

            return policyIssuanceReloadPromise;
        }

        window.OverviewViewRegistry[policyIssuanceViewInstanceKey].reload = reloadPolicyIssuanceInstance;
        window.reloadPolicyIssuanceComponents = function(instanceId) {
            var registry = window.OverviewViewRegistry || {};
            if (instanceId !== undefined && instanceId !== null) {
                return registry[`pi:${instanceId}`]?.reload?.();
            }

            var reloads = Object.keys(registry)
                .filter(key => key.startsWith("pi:"))
                .map(key => registry[key])
                .filter(entry => entry && document.getElementById(entry.rootId) && typeof entry.reload === "function")
                .map(entry => entry.reload());
            return Promise.all(reloads);
        };




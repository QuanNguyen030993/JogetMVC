        function initMainPaneSplitter() {
            const grid = document.getElementById("mainContentGrid");
            const splitter = document.getElementById("mainSplitter");
            if (!grid || !splitter) return;

            const MIN_LEFT = 260;
            const MAX_LEFT = 520;
            const COLLAPSED_LEFT = 0;
            const SPLITTER_W = 10;
            let isDragging = false;

            function setLeftWidth(px) {
                const total = grid.clientWidth;
                const maxAllowed = Math.min(MAX_LEFT, total - 620 - SPLITTER_W);
                const left = Math.max(MIN_LEFT, Math.min(px, maxAllowed));
                grid.classList.remove("left-collapsed");
                grid.style.gridTemplateColumns = `${left}px ${SPLITTER_W}px minmax(620px, 1fr)`;
            }

            function collapseLeft() {
                grid.classList.add("left-collapsed");
                grid.style.gridTemplateColumns = `${COLLAPSED_LEFT}px ${SPLITTER_W}px minmax(620px, 1fr)`;
            }

            function expandLeftDefault() {
                setLeftWidth(360);
            }

            splitter.addEventListener("mousedown", function (e) {
                e.preventDefault();
                isDragging = true;
                splitter.classList.add("dragging");
                document.body.style.cursor = "col-resize";
                document.body.style.userSelect = "none";
            });

            window.addEventListener("mousemove", function (e) {
                if (!isDragging) return;
                const rect = grid.getBoundingClientRect();
                const nextLeft = e.clientX - rect.left;
                setLeftWidth(nextLeft);
            });

            window.addEventListener("mouseup", function () {
                if (!isDragging) return;
                isDragging = false;
                splitter.classList.remove("dragging");
                document.body.style.cursor = "";
                document.body.style.userSelect = "";
            });

            $("#pi-btnToggleLeftPane").dxButton({
                icon: "pin",
                hint: "Thu gọn / mở rộng danh sách policyIssuance",
                stylingMode: "text",
                onClick: function () {
                    if (grid.classList.contains("left-collapsed")) {
                        expandLeftDefault();
                    } else {
                        collapseLeft();
                    }
                }
            });

            window.addEventListener("resize", function () {
                if (grid.classList.contains("left-collapsed")) {
                    grid.style.gridTemplateColumns = `${COLLAPSED_LEFT}px ${SPLITTER_W}px minmax(620px, 1fr)`;
                } else {
                    const first = parseInt((grid.style.gridTemplateColumns || "").split(" ")[0], 10);
                    if (!isNaN(first)) setLeftWidth(first);
                }
            });
        }

        function debounce(fn, delay) {
            let t = null;
            return function (...args) {
                clearTimeout(t);
                t = setTimeout(() => fn.apply(this, args), delay);
            };
        }

        // $("#pi-searchBox").dxTextBox({
        //     placeholder: "Search policyIssuances...",
        //     stylingMode: "outlined",
        //     mode: "search",
        //     onValueChanged: debounce((e) => {
        //         searchText = e.value || "";
        //         loadQuotePage(true);
        //     }, 350)
        // });


        function filterLocalQuotes(keyword) {
            const t = String(keyword || "").trim().toLowerCase();
            if (!t) return state.quotes.slice();

            return state.quotes.filter(x =>
                (x.policyIssuanceCode || "").toLowerCase().includes(t) ||
                (x.clientName || "").toLowerCase().includes(t) ||
                (x.productName || "").toLowerCase().includes(t) ||
                (x.lineName || "").toLowerCase().includes(t) ||
                String(x.requestNo || "").toLowerCase().includes(t)
            );
        }

        function renderQuoteList(data) {
            $("#pi-quoteList").empty();

            const rows = Array.isArray(data) ? data : [];
            if (!rows.length) {
                showListEmpty(true);
                return;
            }

            showListEmpty(false);
            appendQuoteCards(rows);

            if (!state.isSearching && state.quotePaging.done) showListEnd(true);
            else showListEnd(false);
        }

        async function searchQuoteFromServer(keyword) {
            const token = ++state.searchRequestToken;
            state.serverSearchMode = true;
            state.isSearching = true;

            showListLoader(true);

            try {
                const params = new URLSearchParams();
                params.set("skip", 0);
                params.set("take", 50);
                if (keyword) params.set("searchText", keyword);

                const data = await $.ajax({
                    url: `/api/PolicyIssuance/GetAll?${params.toString()}`,
                    method: "GET",
                    contentType: "application/json"
                });

                if (token !== state.searchRequestToken) return;

                state.displayQuotes = Array.isArray(data) ? data : [];
                renderQuoteList(state.displayQuotes);
            } catch (err) {
                console.error(err);
            } finally {
                if (token === state.searchRequestToken) showListLoader(false);
            }
        }

        function clearSearchMode() {
            state.isSearching = false;
            state.serverSearchMode = false;
            state.displayQuotes = [];
            state.searchRequestToken++;
            renderQuoteList(state.quotes);
        }

        const triggerServerSearch = debounce(function (keyword) {
            searchQuoteFromServer(keyword);
        }, 700);

        $("#pi-searchBox").dxTextBox({
            placeholder: "Search policyIssuances...",
            stylingMode: "outlined",
            mode: "search",
            onValueChanged: debounce((e) => {
                state.displayQuotes = [];
                state.isSearching = false;
                state.serverSearchMode = false;
                state.searchRequestToken = 0;
                searchText = (e.value || "").trim();

                if (!searchText) {
                    clearSearchMode();
                    return;
                }

                state.isSearching = true;

                const localRows = filterLocalQuotes(searchText);

                if (localRows.length > 0) {
                    state.serverSearchMode = false;
                    state.displayQuotes = localRows;
                    renderQuoteList(localRows);
                    // triggerServerSearch(searchText);
                    state.isSearching = false;
                } else {
                    state.displayQuotes = [];
                    renderQuoteList([]);
                    triggerServerSearch(searchText);
                    state.isSearching = false;
                }
            }, 250)
        });

        $(`#${formModuleKeyQt}-btnClientConfirm`).dxButton({
            text: "Submit To Policy Issuance",
            icon: "check",
            type: "success",
            onClick: function () {
               var policyIssuanceConvert = state.quotes.find(x => x.id == selectedId);
                if (!policyIssuanceConvert) return;

                var policyIssuance = new Object();
                policyIssuance = ObjectPopulateKey(policyIssuanceConvert, true, false);
                policyIssuance.RequestDate = new Date();
                policyIssuance.PIC = {
                    FO: "",
                    TS: "",
                    PM: ""
                };

                policyIssuance.PIC = JSON.stringify(policyIssuance.PIC);
                policyIssuance.StageDept = "FO";
                policyIssuance.PolicyIssuanceStatus = "New";
                policyIssuance.WorkflowStatus = "Pending";

                ajaxPost('api/PolicyIssuance/CreatePolicyIssuance', policyIssuance, {
                    onSuccess: function () {
                        DevExpress.ui.notify("PolicyIssuance submitted!", "info", 1200);
                    },
                    onError: function () { }
                });
            }
        });

        $("#branchOverlay .backdrop").on("click", function () {
            $("#branchOverlay").hide();
            $("#branchOverlay .bnode.choice").removeClass("active");
        });

        HoverAjax.bind();
        bindSectionHeaderToggle();
        bindQuoteCardClick();
        bindInfiniteScroll();
        setupDeptTree();
        initMainPaneSplitter();

        setTimeout(layoutTreeLine, 0);
        window.addEventListener("resize", () => setTimeout(layoutTreeLine, 0));

        loadQuotePage(true).then(() => {
            applyNodeHighlights();
            applySectionFocusHighlight();
            updateHints();
            renderDeptCallouts(PIC_JSON);
            firstRender = false;
        });
    }, _delayPolicyIssuancesLoad);
</script>

<body>
    <div class="title">
        @await Html.PartialAsync("_OverviewPane", new OverviewPanePartialModel
   {
       Prefix = prefix,
       ModuleCode = moduleCode,
       Title = title
   })
    </div>

    <div class="actionBar">
        <div class="actionLeft">
            <span class="pill">Record: <b id="pi-recordNo">Qu-10030</b></span>
            <span class="pill">Login role: <b id="pi-loginRoleLabel"></b></span>
            <span id="pi-focusDeptPill" class="pill">Focus section: </span>
        </div>
        <div class="actionRight">
            <div id="pi-btnClientConfirm"></div>
        </div>
    </div>

    <div id="branchOverlay" class="branchOverlay">
        <div class="backdrop"></div>
        <div class="branchPopup">
            <div class="branchTitle">
                <span>Submit Route</span>
                <span class="branchHint">Choose next dept</span>
            </div>
            <div class="branchCanvas">
                <svg width="100%" height="100%" viewBox="0 0 260 140" style="position:absolute;inset:0;"></svg>
            </div>
        </div>
    </div>
</body>
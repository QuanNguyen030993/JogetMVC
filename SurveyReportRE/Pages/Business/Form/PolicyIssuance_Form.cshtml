        function getSelectedModel() {
            if (state.selectedId && state.quoteDetails[state.selectedId]) {
                return state.quoteDetails[state.selectedId];
            }
            const q = state.quotes.find(x => x.id === state.selectedId) || state.quotes[0];
            return q || null;
        }



        function buildListUrl() {
            const params = new URLSearchParams();
            params.set("skip", state.quotePaging.skip);
            params.set("take", state.quotePaging.take);

            if (searchText) params.set("searchText", searchText);
            if (filter && filter !== "all") params.set("policyIssuanceStatus", filter);
            params.set("key", @Convert.ToInt32(ViewData["Id"]));
            return `/api/PolicyIssuance/GetAll?${params.toString()}`;
        }

      

        function loadPIDetail(id) {
            if (!id) return Promise.resolve(null);
            if (state.piDetails[id]) {
                return Promise.resolve(state.piDetails[id]);
            }
            return $.ajax({
                url: `/api/PolicyIssuance/GetAll?key=${id}`,
                method: "GET",
                contentType: "application/json"
            }).then(detail => {
                var item = Array.isArray(detail) ? detail[0] : detail;
                if (item) {
                    state.piDetails[id] = item;
                }
                return item;
            });
        }





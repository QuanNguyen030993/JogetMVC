</body>
<script type="text/javascript">
    var PIC_JSON = `{}`;
    var formModuleKeyPi = viewIdModulePrefix.policyIssuance;
    var pICs = [];
    var workflowStatus = "";
    // if ($('[data-toggle="push-menu"]').hasClass("sidebar-collapse")) {
    //     $('[data-toggle="push-menu"]').click();
    //     isToggleMenu = true;
    // }
    var prefix = "@prefix";
    var page = window.PolicyIssuancePage;
    var state = page.state;
    var copyFromGuid = "@(ViewData["CopyFromGuid"])";
    state.nextStep = new Object();
    state.nextStep.flowSteps = [];
    state.nextStep.currentStep = 1;
    state.nextStep.instanceWorkflow = new Object();

    state.currentUserRole = _role;
    state.focusDept = _role == "IT" ? "FO" : _role;

    state.quotes = [];
    state.selectedId = null;
    state.selectedGuid = null;
    state.selectedCodeNo = null;
    state.formData = null;
    state.stageAccount = "";
    state.selectedAttachmentId = null;
    state.stageDept = null;
    state.quoteDetails = {};
    state.quotePaging = {
        skip: 0,
        take: 20,
        loading: false,
        done: false,
        firstLoadDone: false
    };
    window.OverviewDataBootstrap.preload({
        moduleCode: viewIdModulePrefix.policyIssuance,
        id: @ViewData["Id"],
        guid: "@ViewData["Guid"]"
    });
    var firstRender = true;
    setTimeout(() => {
        const policyIssuanceViewInstanceId = "@ViewData["Id"]";
        const policyIssuanceViewInstanceKey = `${formModuleKeyPi}:${policyIssuanceViewInstanceId}`;
        const policyIssuanceOverviewRootId = `${formModuleKeyPi}-overviewRoot_${policyIssuanceViewInstanceId}`;
        enableDxFormGroupToggle(`#${policyIssuanceOverviewRootId}`);
     const PiRoles = piDeptModuleCode;
        $(`#${formModuleKeyPi}-loginRoleLabel`).text(state.currentUserRole);

        $(document)
            .off(`overviewMaintenanceRoleChanged.pi-${policyIssuanceViewInstanceId}`)
            .on(`overviewMaintenanceRoleChanged.pi-${policyIssuanceViewInstanceId}`, function (_, detail) {
                if (detail?.moduleCode !== formModuleKeyPi
                    || String(detail.recordId) !== String(policyIssuanceViewInstanceId)) return;

                state.currentUserRole = detail.role;
                _role = detail.role;
                $(`#${formModuleKeyPi}-loginRoleLabel`).text(detail.role);
                applyEditLock();
                updateHints();
            });

        var filter = "all";
        var searchText = "";
        var selectedGuid = null;
        var selectedFromGuid = null;
        var selectedAttachmentId = null;
        var commentPanelOpened = false;
        var stageDept = null;
        var stageAccount = "";

        var deptData = { FO: {}, TS: {}, PM: {} };
        // Remark editors are registered lazily for the record's active stage only.
        var remarkBoxs = {};

        state.piDetails = {};

        async function showPolicyIssuanceRoleReview(policyIssuance) {
            if (typeof window.checkFeatureRoleRule !== "function") {
                console.error("Policy Issuance role review helper is unavailable");
                return null;
            }

            const actualStageDept = String(policyIssuance?.stageDept || "").trim().toUpperCase();
            const actualRole = String(state.currentUserRole || "").trim().toUpperCase();
            const reviewSuperUser = String(_isSuperUser).trim().toLowerCase() === "true";
            const phase1RoleAndStagePassed = actualRole === actualStageDept;
            const $reviewRoot = $(`#${policyIssuanceOverviewRootId}`);
            const inspectButtons = function ($buttons) {
                var total = 0;
                var enabled = 0;
                $buttons.each(function () {
                    total += 1;
                    const instance = $(this).dxButton("instance");
                    const disabled = instance
                        ? instance.option("disabled") === true
                        : ($(this).is(":disabled") || $(this).attr("aria-disabled") === "true" || $(this).hasClass("dx-state-disabled"));
                    if (!disabled) enabled += 1;
                });
                return {
                    passed: enabled > 0,
                    actual: `${enabled}/${total} enabled`,
                    expected: "At least one enabled button"
                };
            };
            const inspectSections = function () {
                const details = piDeptModuleCode.map(function (dept) {
                    const formId = window.PolicyIssuanceIdManager.form(dept, @ViewData["Id"]);
                    const form = $(`#${formId}`).dxForm("instance");
                    const saveButtonId = window.PolicyIssuanceIdManager.btnSave(dept, @ViewData["Id"]);
                    const saveButton = $(`#${saveButtonId}`).dxButton("instance");
                    const actualAllow = !!form && form.option("disabled") !== true && form.option("readOnly") !== true;
                    const expectedAllow = reviewSuperUser || (phase1RoleAndStagePassed && dept === actualStageDept);
                    const actualSaveVisible = saveButton?.option("visible") === true;
                    return {
                        dept,
                        actualAllow,
                        expectedAllow,
                        actualSaveVisible,
                        expectedSaveVisible: expectedAllow,
                        matched: actualAllow === expectedAllow && actualSaveVisible === expectedAllow
                    };
                });
                return {
                    passed: details.every(item => item.matched),
                    actual: details.map(item => `${item.dept}:${item.actualAllow ? "ALLOW" : "LOCK"}/${item.actualSaveVisible ? "SAVE" : "NO SAVE"}`).join(", "),
                    expected: details.map(item => `${item.dept}:${item.expectedAllow ? "ALLOW" : "LOCK"}/${item.expectedSaveVisible ? "SAVE" : "NO SAVE"}`).join(", "),
                    details
                };
            };
            
            const inspectStageRemark = function () {
                const dept = actualStageDept;
                const control = remarkBoxs?.[dept]?.controlRemark;
                const remarkBoxId = window.PolicyIssuanceIdManager.remarkBox(dept, @ViewData["Id"]);
                const visible = $(`#${remarkBoxId}`).closest(".dept-remark-panel").is(":visible");
                const disabled = !control || typeof control.option !== "function"
                    || control.option("disableComment") === true;
                const actualAllow = !!control && visible && !disabled;
                const expectedAllow = !!control && (reviewSuperUser || phase1RoleAndStagePassed);
                const details = [{ dept, visible, disabled, actualAllow, expectedAllow, matched: actualAllow === expectedAllow }];
                return {
                    passed: details[0].matched,
                    actual: `${dept}:${actualAllow ? "ALLOW" : "LOCK"}`,
                    expected: `${dept}:${expectedAllow ? "ALLOW" : "LOCK"}`,
                    details
                };
            };

            const returnHostId = window.PolicyIssuanceIdManager.btnReturnBranch(actualStageDept, @ViewData["Id"]);
            const submitHostId = window.PolicyIssuanceIdManager.btnSubmitBranch(actualStageDept, @ViewData["Id"]);
            const report = await window.checkFeatureRoleRule({
                display: true,
                feature: "Policy Issuance role review",
                moduleCode: viewIdModulePrefix.policyIssuance,
                role: actualRole,
                stageDept: actualStageDept,
                section: actualRole,
                formData: policyIssuance,
                state,
                isDebugMode: typeof _isDebugMode !== "undefined" && _isDebugMode,
                isSuperUser: typeof _isSuperUser !== "undefined" && _isSuperUser,
                superUserBypass: true,
                rules: {
                    roles: [actualStageDept],
                    stageDepts: [actualStageDept],
                    sections: [actualStageDept]
                },
                phase1Checks: [{
                    key: "commentAllow",
                    label: "Comment allow",
                    required: true,
                    actual: actualRole,
                    expected: actualRole,
                    evaluate: function () {
                        return { passed: !!actualRole, actual: actualRole, expected: actualRole };
                    }
                }],
                phase2Checks: [{
                    key: "accept", label: "Accept", required: false,
                    evaluate: function () {
                        return inspectButtons($reviewRoot.find(".dx-button").filter(function () {
                            return /^accept$/i.test($(this).text().trim());
                        }));
                    }
                }, {
                    key: "sectionAllowAll", label: "Section allow · stage department only", required: true,
                    evaluate: inspectSections
                }, {
                    key: "commentAllowInStageDept", label: "Comment allow in stageDept", required: true,
                    evaluate: inspectComments
                }, {
                    key: "remarkAllowAll", label: "Remark allow · stage department only", required: true,
                    evaluate: inspectStageRemark
                }, {
                    key: "returnButton", label: "Return button", required: false,
                    evaluate: function () { return inspectButtons($(`#${returnHostId}`).find("[data-workflow-route-button]")); }
                }, {
                    key: "customButton", label: "Custom button", required: false,
                    evaluate: function () { return inspectButtons($reviewRoot.find("[data-custom-route-button]")); }
                }, {
                    key: "routeButton", label: "Route button", required: false,
                    evaluate: function () { return inspectButtons($(`#${submitHostId}`).find("[data-workflow-route-button]")); }
                }]
            });
            console.log("Policy Issuance role review", report);
            return report;
        }

        const policyIssuanceRenderGate = (function () {
            var sequence = 0;
            var startedAt = 0;
            var $root = $(`#${policyIssuanceOverviewRootId}`);
            var $loadingHost = $root.find(".cardBody.overview-wrap").first();
            if (!$loadingHost.length) $loadingHost = $root;
            var $overlay = $loadingHost.children(".pi-render-overlay");

            if (!$overlay.length) {
                $overlay = $(`
                    <div id="${formModuleKeyPi}-renderOverlay_${policyIssuanceViewInstanceId}" class="pi-render-overlay" role="status" aria-live="polite" aria-busy="true">
                        <div class="pi-loader-panel overview-section-loader app-loading-indicator">
                            <div class="dept-section-action-loader" aria-hidden="true">
                                <span></span><span></span><span></span>
                            </div>
                            <div class="pi-loader-message dept-section-action-message">Please wait…</div>
                            <!-- LEGACY OVERVIEW INDICATOR - rollback when needed:
                            <div class="pi-loader-icon-host" aria-hidden="true">
                                <div class="pi-loader-default-icon"></div>
                            </div>
                            <div class="pi-loader-message">Please wait…</div>
                            <div class="pi-render-progress"><span></span></div>
                            -->
                        </div>
                    </div>
                `).appendTo($loadingHost);
            }

            function setLoadingIcon(source, options) {
                var $host = $overlay.find(".pi-loader-icon-host").empty();
                options = options || {};

                function appendVisual(visual) {
                    if (!visual) return;
                    var $visual = visual.jquery ? visual : $(visual);
                    if ($visual.length && !$visual.parent().is($host)) {
                        $host.append($visual);
                    }
                }

                if (!source) {
                    $host.append('<div class="pi-loader-default-icon"></div>');
                    return;
                }

                if (typeof source === "function") {
                    appendVisual(source($host));
                    return;
                }

                if (typeof source === "string") {
                    $("<img>", {
                        src: source,
                        alt: options.alt || "",
                        class: options.className || ""
                    }).appendTo($host);
                    return;
                }

                appendVisual(source);
            }

            function setPhase(_message, progress) {
                progress = Math.max(0, Math.min(100, Number(progress) || 0));
                $overlay.find(".pi-loader-message").first().text(_message || "Please wait…");
                // LEGACY OVERVIEW PROGRESS:
                // $overlay.find(".pi-render-progress > span").css("width", `${Math.max(progress, 8)}%`);
            }

            function resetProgressiveContent() {
                const $sections = $(`#${window.PolicyIssuanceIdManager.overviewScroll(@ViewData["Id"])} section.dept-section`);
                $sections.removeClass("visible");
                $sections.find(".animate-step").removeClass("visible");
            }

            function begin(message) {
                sequence += 1;
                startedAt = performance.now();
                $overlay.removeClass("is-leaving").attr("aria-busy", "true");
                $root.addClass("pi-render-loading");
                $root.find(".overview-status-pill")
                    .removeClass("is-ready")
                    .attr("aria-busy", "true");
                resetProgressiveContent();
                setPhase(message || "Loading policy issuance data…", 12);
                return sequence;
            }

            async function complete(token) {
                if (token !== sequence) return;
                setPhase("Finalizing controls…", 92);
                await new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)));

                var minimumVisibleTime = 320;
                var remaining = minimumVisibleTime - (performance.now() - startedAt);
                if (remaining > 0) {
                    await new Promise(resolve => setTimeout(resolve, remaining));
                }
                if (token !== sequence) return;

                animateOverviewSections(formModuleKeyPi);
                setPhase("Ready", 100);
                $overlay.addClass("is-leaving").attr("aria-busy", "false");
                await new Promise(resolve => setTimeout(resolve, FormStageDelay.overlayDone));
                if (token !== sequence) return;
                $root.removeClass("pi-render-loading");
                $overlay.removeClass("is-leaving");
            }

            function fail(token, message) {
                if (token !== sequence) return;
                setPhase(message || "Unable to load policy issuance", 100);
                $overlay.attr("aria-busy", "false");
                setTimeout(function () {
                    if (token === sequence) $root.removeClass("pi-render-loading");
                }, 900);
            }

            if (window.PolicyIssuanceLoadingIcon) {
                setLoadingIcon(window.PolicyIssuanceLoadingIcon);
            }

            return { begin, setPhase, complete, fail, setLoadingIcon };
        })();

        // State cua pipeline chi nam trong instance Policy Issuance hien tai.
        const policyIssuanceFormStages = createFormStageCoordinator(function (stageName) {
            $(`#${policyIssuanceOverviewRootId}`).attr("data-render-stage", stageName);
        });
        const policyIssuanceDepartmentOrder = FormStageDelay.departmentOrder.policyIssuance;
        const policyAssignmentLifecycle = { isAssigneeBoxRender: false };

        window.OverviewViewRegistry = window.OverviewViewRegistry || {};
        window.OverviewViewRegistry[policyIssuanceViewInstanceKey] = {
            moduleCode: formModuleKeyPi,
            recordId: policyIssuanceViewInstanceId,
            rootId: policyIssuanceOverviewRootId,
            renderGate: policyIssuanceRenderGate,
            showRoleReview: function () {
                const policyIssuance = state.quotes?.[0];
                if (!policyIssuance || !Object.keys(policyIssuance).length) {
                    DevExpress.ui.notify("Policy Issuance role review data is not ready.", "warning", 1600);
                    return Promise.resolve(null);
                }
                return showPolicyIssuanceRoleReview(policyIssuance);
            }
        };
        window.PolicyIssuanceRenderGates = window.PolicyIssuanceRenderGates || {};
        window.PolicyIssuanceRenderGates[policyIssuanceViewInstanceId] = policyIssuanceRenderGate;
        window.PolicyIssuanceRenderGate = policyIssuanceRenderGate;

        function money(n) {
            return new Intl.NumberFormat("vi-VN", {
                style: "currency",
                currency: "VND"
            }).format(n || 0);
        }



        function statusClass(raw) { return normalizeStatus(raw).css; }
        function statusText(raw) { return normalizeStatus(raw).text; }

      

      

        function getSelectedModel() {
            if (state.selectedId && state.quoteDetails[state.selectedId]) {
                return state.quoteDetails[state.selectedId];
            }
            const q = state.quotes.find(x => x.id === state.selectedId) || state.quotes[0];
            return q || null;
        }



        function buildListUrl() {
            const params = new URLSearchParams();
            params.set("skip", state.quotePaging.skip);
            params.set("take", state.quotePaging.take);

            if (searchText) params.set("searchText", searchText);
            if (filter && filter !== "all") params.set("policyIssuanceStatus", filter);
            params.set("key", @Convert.ToInt32(ViewData["Id"]));
            return `/api/PolicyIssuance/GetAll?${params.toString()}`;
        }

      

        function loadPIDetail(id) {
            if (!id) return Promise.resolve(null);
            if (state.piDetails[id]) {
                return Promise.resolve(state.piDetails[id]);
            }
            return window.OverviewDataBootstrap.getRecord({
                moduleCode: viewIdModulePrefix.policyIssuance,
                id: id
            }).then(item => {
                if (item) {
                    state.piDetails[id] = item;
                }
                return item;
            });
        }




        async function syncSelectedState(q) {
            if (!q) return;




            state.selectedId =  q.id ?? null;
            state.selectedGuid = q.guid ?? null;
            selectedAttachmentId = q.documentId ?? null;
            state.selectedCodeNo = q.quotationCode ?? null;
            stageDept = String(q.stageDept || "").trim().toUpperCase() || null;
            state.stageDept = stageDept;
            state.comments = [];
            state.pinNotes = [];

            PIC_JSON = pICs.find(f => f.quotationCode == state.selectedCodeNo)?.pIC ?? q.pIC ?? "{}";
            var map = parsePicMap(PIC_JSON);
            stageAccount = map[stageDept] ? map[stageDept] : "(Unassigned)";
            q.stageAccount = stageAccount;
            state.stageAccount = stageAccount;
            state.formData = q;

        }

        async function loadPolicyIssuanceSectionComments(refreshDept) {
            try {
                const res = await loadSectionCommentsCached(state.selectedGuid);
                const pinnedNotes = (res || []).map(x => ({
                id: x.id,
                section: x.currentDepartment,
                fromSection: x.fromDepartment,
                toSection: x.toDepartment,
                type: x.type,
                unread: !x.isRead,
                isRead: !x.isRead,
                linkedPin: x.isPinned,
                isPinned: x.isPinned,
                body: x.content,
                text: x.content,
                replies: 0,
                fullText: x.content,
                author: x.author,
                urgent: false,
                time: parseToGMT7(x.createdDate, 0)
                }));
                state.comments = pinnedNotes;
                state.pinNotes = pinnedNotes.filter(f => f.isPinned);
            } catch (error) {
                state.comments = [];
                state.pinNotes = [];
                console.warn("Policy issuance comments could not be loaded.", error);
            }
            if (refreshDept) {
                commentPinModule(formModuleKeyPi, refreshDept, "@ViewData["Guid"]", state.pinNotes, @ViewData["Id"]);
                loadCommentModule(formModuleKeyPi, refreshDept, "@ViewData["Guid"]", state.comments, @ViewData["Id"]);
            } else {
                reloadState();
            }
        }

        async function renderPolicyIssuancePersonInCharge() {
            const q = getSelectedModel();
            if (!q) return;
            renderDeptCallouts(PIC_JSON, document.getElementById(policyIssuanceOverviewRootId));
            let stageName = "";
            try {
                stageName = stageAccount && stageAccount !== "(Unassigned)"
                    ? await getPersonInCharge(stageAccount)
                    : "";
            } catch (error) {
                console.warn("Person in charge could not be resolved.", error);
            }
            revealOverviewPaneStatus(
                `#${window.PolicyIssuanceIdManager.stageDeptPill(q.id)}`,
                statusText(workflowStatus),
                stageName,
                statusClass(workflowStatus),
                window.PolicyIssuanceIdManager.detailStatus(q.id),
                resolveSkipTSFromRequestType(q, "policyIssuanceType") === true
            );
        }
        function selfLoadSelectedWorkflow(forceReload = false) {
            const selectedModel = getSelectedModel();
             const formId =  window.PolicyIssuanceIdManager.form(_role, @ViewData["Id"]);
            return window.WorkflowLoader.load({
                modelName: "@nameof(PolicyIssuance)",
                formId: formId,
                moduleCode: viewIdModulePrefix.policyIssuance,
                id: @ViewData["Id"],
                loadingHost: `#${window.PolicyIssuanceIdManager.actionBarDept(stageDept, @ViewData["Id"])}`,
                guid: state.selectedGuid,
                stageDept: stageDept,
                state: state,
                deptCodes: piDeptModuleCode,
                formStages: policyIssuanceFormStages,
                remarkBoxes: remarkBoxs,
                prefix: "@prefix",
                requestType: selectedModel?.requestType ?? selectedModel?.RequestType ?? "",
                loadScreenConditions: loadAndApplyPolicyIssuanceScreenConditions,
                submitNextStep: submitNextStep,
                returnToStep: returnToStep,
                formModuleKey: formModuleKeyPi,
                reload: true,
                forceWorkflowReload: forceReload === true//,
                // onLoaded: applyPolicyIssuanceRouteButtonRules
            });
          }

        async function loadQuotePage(reset = false, forceReload = false) {
            if (state.quotePaging.loading) return false;
            if (!reset && state.quotePaging.done) return false;

            if (reset) {
                state.quotePaging.skip = 0;
                state.quotePaging.done = false;
                state.quotePaging.firstLoadDone = false;
                state.quotes = [];
                pICs = [];
            }

            state.quotePaging.loading = true;
            try {
                var record = await window.OverviewDataBootstrap.getRecord({
                    moduleCode: viewIdModulePrefix.policyIssuance,
                    id: @ViewData["Id"],
                    forceReload: forceReload
                });
                var data = record ? [record] : [];
                policyIssuanceRenderGate.setPhase("Policy issuance data received…", 38);

                const rows = Array.isArray(data)
                    ? data.map(item => ({ ...item, pIC: item.pic }))
                    : [];

                if (reset && rows.length === 0) {
                    state.quotePaging.done = true;
                    return false;
                }

                state.quotes = state.quotes.concat(rows);

                state.quotePaging.skip += rows.length;
                if (rows.length < state.quotePaging.take) {
                    state.quotePaging.done = true;
                }

                if (!state.quotePaging.firstLoadDone && state.quotes.length > 0) {
                    state.quotePaging.firstLoadDone = true;
                    policyIssuanceRenderGate.setPhase("Binding policy issuance state…", 52);
                    await syncSelectedState(state.quotes[0]);
                    policyIssuanceRenderGate.setPhase("Initializing department forms…", 68);
                    await renderDetail();
                    policyIssuanceRenderGate.setPhase("Binding PIC assignments…", 86);
                }
                return true;
            } catch (err) {
                console.error("loadQuotePage error:", err);
                DevExpress.ui.notify("Load policyIssuance list failed", "error", 1500);
                return false;
            } finally {
                state.quotePaging.loading = false;
            }
        }


        // Coalesce SignalR/action reloads so every section finishes rendering once.
        var policyIssuanceReloadPromise = null;
        function reloadPolicyIssuanceInstance() {
            if (policyIssuanceReloadPromise) return policyIssuanceReloadPromise;

            var renderToken = policyIssuanceRenderGate.begin("Refreshing policy issuance…");
            policyIssuanceReloadPromise = (async function () {
                while (state.quotePaging.loading) {
                    await new Promise(resolve => setTimeout(resolve, 50));
                }

                // Chi load state, dxForm va PIC khi overlay con dang mo.
                var loaded = await loadQuotePage(true, true);
                if (!loaded) {
                    policyIssuanceRenderGate.fail(renderToken, "Policy issuance refresh failed");
                    return;
                }

                await new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)));
                $.each(piDeptModuleCode, function (itemIndex, item) {
                    var form = $(`#${window.PolicyIssuanceIdManager.form(item,@ViewData["Id"])}`).dxForm("instance");
                    form?.repaint();
                });
                applyEditLock();
                applyNodeHighlights();
                applySectionFocusHighlight();
                updateHints();
                await policyIssuanceRenderGate.complete(renderToken);
                firstRender = false;
                await policyIssuanceFormStages.enter("personInCharge");
                await renderPolicyIssuancePersonInCharge();
                await selfLoadSelectedWorkflow(true);
                invalidateSectionCommentCache(state.selectedGuid);
                await policyIssuanceFormStages.enter("comments");
                await loadPolicyIssuanceSectionComments();
            })().catch(function (err) {
                console.error("reloadPolicyIssuanceComponents error:", err);
                policyIssuanceRenderGate.fail(renderToken, "Policy issuance refresh failed");
            }).finally(function () {
                policyIssuanceReloadPromise = null;
            });

            return policyIssuanceReloadPromise;
        }

        window.OverviewViewRegistry[policyIssuanceViewInstanceKey].reload = reloadPolicyIssuanceInstance;
        window.OverviewViewRegistry[policyIssuanceViewInstanceKey].reloadWorkflow = selfLoadSelectedWorkflow;
        var policyIssuanceDepartmentRefreshes = {};
        function refreshPolicyIssuanceDepartment(dept) {
            dept = String(dept || "").trim().toUpperCase();
            if (!window.PolicyIssuanceIdManager.validateDepartment(dept)) {
                return Promise.reject(new Error(`Invalid policy issuance department: ${dept}`));
            }
            if (policyIssuanceDepartmentRefreshes[dept]) return policyIssuanceDepartmentRefreshes[dept];

            policyIssuanceDepartmentRefreshes[dept] = (async function () {
                var q = await window.OverviewDataBootstrap.getRecord({
                    moduleCode: viewIdModulePrefix.policyIssuance,
                    id: @ViewData["Id"],
                    forceReload: true
                });
                if (!q) throw new Error("Policy issuance data was not found.");

                var quoteIndex = state.quotes.findIndex(function (item) {
                    return String(item.id) === String(q.id);
                });
                if (quoteIndex >= 0) state.quotes[quoteIndex] = q;
                else state.quotes.unshift(q);

                workflowStatus = q.workflowStatus ?? q.status;
                stageDept = String(q.stageDept || "").trim().toUpperCase() || null;
                state.stageDept = stageDept;
                PIC_JSON = q.pIC || q.pic || "{}";
                var picMap = parsePicMap(PIC_JSON);
                stageAccount = picMap[stageDept] || "(Unassigned)";
                q.stageAccount = stageAccount;
                state.stageAccount = stageAccount;
                state.formData = q;

                deptData[dept] = { ...q, id: q.id, sectionName: dept, code: q.policyIssuanceCode };
                var formId = window.PolicyIssuanceIdManager.form(dept, @ViewData["Id"]);
                var form = $(`#${formId}`).dxForm("instance");
                if (!form) throw new Error(`${dept} form is not initialized.`);
                form.option("formData", deptData[dept]);

                await renderAssignment(
                    formModuleKeyPi,
                    { [dept]: deptData[dept] },
                    policyAssignmentLifecycle,
                    0
                );
                var decisionEntry = window.WorkflowDecisionRegistry?.[`${formId}:${dept}`];
                if (decisionEntry) {
                    renderDecisionDeferredV2(
                        decisionEntry.formProps,
                        decisionEntry.groupName,
                        decisionEntry.mainFields,
                        ...decisionEntry.params
                    );
                }

                invalidateSectionCommentCache(state.selectedGuid);
                await loadPolicyIssuanceSectionComments(dept);
                var section = document.getElementById(`${formModuleKeyPi}-sec_${dept}_@ViewData["Id"]`);
                await window.refreshOverviewDepartmentWidgets?.(section);
                /* role enable/disable restored code
                 * Legacy: setAttachmentPermissionForSection(section, _isSuperUser || state.currentUserRole === dept).
                 */
                await window.applyFeatureRoleControlRule({
                    feature: `Policy Issuance refreshed attachments · ${dept}`,
                    controlType: "section",
                    dept: dept,
                    stageDept: state.stageDept,
                    role: state.currentUserRole,
                    formData: q,
                    isDebugMode: _isDebugMode,
                    isSuperUser: _isSuperUser,
                    apply: function (decision) {
                        setAttachmentPermissionForSection(
                            `#${formModuleKeyPi}-sec_${dept}_@ViewData["Id"]`,
                            decision.phase1Allowed
                        );
                    }
                });
            })().finally(function () {
                delete policyIssuanceDepartmentRefreshes[dept];
            });

            return policyIssuanceDepartmentRefreshes[dept];
        }

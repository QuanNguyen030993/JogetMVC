            Id = ViewData["Id"]?.ToString(),
            Guid = ViewData["Guid"]?.ToString(),
            CloneId = Convert.ToInt64(ViewData["CloneId"]),
            CopyFromGuid = ViewData["CopyFromGuid"]?.ToString()
        }' />

    </div>
@* 
    <div class="actionBar">
        <div class="">
            <span class="pill">Record: <b id="@PIViewIdHelper.Prefix-recordNo">Qu-10030</b></span>
            <span class="pill">Login role: <b id="@PIViewIdHelper.Prefix-loginRoleLabel"></b></span>
            <span id="@PIViewIdHelper.Prefix-focusDeptPill" class="pill">Focus section: </span>

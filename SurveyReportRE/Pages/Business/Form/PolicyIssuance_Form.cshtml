        async function loadPolicyIssuanceSectionComments() {
            try {
                const res = await loadSectionCommentsCached(state.selectedGuid);
                const pinnedNotes = (res || []).map(x => ({
                id: x.id,
                section: x.currentDepartment,
                fromSection: x.fromDepartment,
                toSection: x.toDepartment,
                type: x.type,
                unread: !x.isRead,
                isRead: !x.isRead,
                linkedPin: x.isPinned,
                isPinned: x.isPinned,
                body: x.content,
                text: x.content,
                replies: 0,
                fullText: x.content,
                author: x.author,
                urgent: false,
                time: parseToGMT7(x.createdDate, 0)
                }));
                state.comments = pinnedNotes;
                state.pinNotes = pinnedNotes.filter(f => f.isPinned);
            } catch (error) {
                state.comments = [];
                state.pinNotes = [];
                console.warn("Policy issuance comments could not be loaded.", error);
            }
            reloadState();
        }


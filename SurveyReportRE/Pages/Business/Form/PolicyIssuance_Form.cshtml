        const HoverAjax = (function () {
            function debounce(fn, wait) {
                let t = null;
                return function (...args) {
                    clearTimeout(t);
                    t = setTimeout(() => fn.apply(this, args), wait);
                };
            }

            function escapeHtml(s) {
                return String(s ?? "")
                    .replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;")
                    .replaceAll('"', "&quot;").replaceAll("'", "&#039;");
            }

            function renderComments(items) {
                if (!Array.isArray(items) || items.length === 0) {
                    return `<div style="color:#6b7280;font-size:12px;padding:6px 4px;">No audit logs</div>`;
                }
                return items.map((c) => `
                        <div class="ct-item">
                            <div class="ct-user">${escapeHtml((c.deptCode ? c.deptCode + " – " : "") + (c.commentBy || ""))}</div>
                            <div class="ct-time">${escapeHtml(c.commentTime || "")}${c.commentOrder != null ? " • #" + escapeHtml(c.commentOrder) : ""}</div>
                            <div class="ct-text">${escapeHtml(c.commentText || "")}</div>
                        </div>
                    `).join("");
            }

            const loadComments = debounce(function (quoteNo, quoteId) {
                document.documentElement.style.setProperty("--rightdock-width", "20%");
                $("#rightCommentSub").text(`Audit log - ${quoteNo}` || "-");
                $("#rightCommentList").html(`<div style="color:#6b7280;font-size:12px;padding:6px 4px;">Loading…</div>`);

                const q = `SELECT * FROM PolicyIssuanceCommentLog WHERE PolicyIssuanceId = ${quoteId}`;
                $.ajax({
                    url: `/api/PolicyIssuanceCommentLog/ExecuteCustomQuery`,
                    method: "POST",
                    async: true,
                    contentType: "application/json",
                    data: JSON.stringify(q),
                    success: function (data) { $("#rightCommentList").html(renderComments(data)); },
                    error: function () {
                        $("#rightCommentList").html(`<div style="color:#ef4444;font-size:12px;font-weight:700;padding:6px 4px;">Failed to load audit logs</div>`);
                    }
                });
            }, 180);

            const loadReferenceFields = debounce(function (quoteNo, quoteId) {
                document.documentElement.style.setProperty("--rightdock-width", "20%");
                $("#rightCommentSub").text(`Common fields - ${quoteNo}`);
                var _formConfig = new MFormOption();
                _formConfig.originModelName = "PolicyIssuance";
                _formConfig.formElementName = "PolicyIssuance";
                _formConfig.colCount = 1;
                _formConfig.container = $(`<div id="form_PolicyIssuance_${quoteId}" style="padding: 10px">`);
                var form = new ReferencePolicyIssuanceForm(quoteId, null, _formConfig, _formConfig);
                form.container.appendTo($("#rightCommentList"));
            }, 180);

            const previewPolicyIssuance = debounce(function (quoteNo, quoteId, attachmentId) {
                document.documentElement.style.setProperty("--rightdock-width", "70%");
                $("#rightCommentSub").text(`Preview policyIssuance - ${quoteNo}`);
                $("<iframe>")
                    .attr("id", `${formModuleKeyQt}-pdfViewer_${quoteId}`)
                    .attr("src", "")
                    .css({ width: "100%", height: "600px", border: "1px solid #ccc" })
                    .appendTo($("#rightCommentList"));

                $.ajax({
                    url: `/api/Utility/GetPdfFile/${attachmentId}`,
                    method: "GET",
                    xhrFields: { responseType: "blob" },
                    success: function (blob) {
                        const fileURL = URL.createObjectURL(blob);
                        $(`#${formModuleKeyQt}-pdfViewer_${quoteId}`).attr("src", fileURL);
                    },
                    error: function (xhr, status, error) {
                        console.error("Error loading PDF:", error);
                    }

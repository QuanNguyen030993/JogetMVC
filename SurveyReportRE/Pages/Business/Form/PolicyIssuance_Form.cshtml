    setTimeout(() => {
        const policyIssuanceViewInstanceId = "@ViewData["Id"]";
        const policyIssuanceViewInstanceKey = `${formModuleKeyPi}:${policyIssuanceViewInstanceId}`;
        const policyIssuanceOverviewRootId = `${formModuleKeyPi}-overviewRoot_${policyIssuanceViewInstanceId}`;
        enableDxFormGroupToggle(`#${policyIssuanceOverviewRootId}`);
     const QtRoles = piDeptModuleCode;
        $(`#${formModuleKeyPi}-loginRoleLabel`).text(state.currentUserRole);

        $(document)
            .off(`overviewMaintenanceRoleChanged.pi-${policyIssuanceViewInstanceId}`)
            .on(`overviewMaintenanceRoleChanged.pi-${policyIssuanceViewInstanceId}`, function (_, detail) {
                if (detail?.moduleCode !== formModuleKeyPi
                    || String(detail.recordId) !== String(policyIssuanceViewInstanceId)) return;

                state.currentUserRole = detail.role;
                _role = detail.role;
                $(`#${formModuleKeyPi}-loginRoleLabel`).text(detail.role);
                applyEditLock();
                updateHints();
            });

        var filter = "all";
        var searchText = "";
        var selectedGuid = null;
        var selectedFromGuid = null;
        var selectedAttachmentId = null;
        var commentPanelOpened = false;
        var stageDept = null;
        var stageAccount = "";

        var deptData = { FO: {}, TS: {}, PM: {} };
        var remarkBoxs = { FO: {}, TS: {}, PM: {} };

        state.piDetails = {};

        const policyIssuanceRenderGate = (function () {
            var sequence = 0;
            var startedAt = 0;
            var $root = $(`#${policyIssuanceOverviewRootId}`);
            var $overlay = $root.children(".pi-render-overlay");

            if (!$overlay.length) {
                $overlay = $(`
                    <div id="${formModuleKeyPi}-renderOverlay_${policyIssuanceViewInstanceId}" class="pi-render-overlay" role="status" aria-live="polite" aria-busy="true">
                        <div class="pi-loader-panel">
                            <div class="pi-loader-icon-host" aria-hidden="true">
                                <div class="pi-loader-default-icon"></div>
                            </div>
                            <div class="pi-loader-message">Please wait…</div>
                            <div class="pi-render-progress"><span></span></div>
                        </div>
                    </div>
                `).appendTo($root);
            }

            function setLoadingIcon(source, options) {
                var $host = $overlay.find(".pi-loader-icon-host").empty();
                options = options || {};

                function appendVisual(visual) {
                    if (!visual) return;
                    var $visual = visual.jquery ? visual : $(visual);
                    if ($visual.length && !$visual.parent().is($host)) {
                        $host.append($visual);
                    }
                }

                if (!source) {
                    $host.append('<div class="pi-loader-default-icon"></div>');
                    return;
                }

                if (typeof source === "function") {
                    appendVisual(source($host));
                    return;
                }

                if (typeof source === "string") {
                    $("<img>", {
                        src: source,
                        alt: options.alt || "",
                        class: options.className || ""
                    }).appendTo($host);
                    return;
                }

                appendVisual(source);
            }

            function setPhase(_message, progress) {
                progress = Math.max(0, Math.min(100, Number(progress) || 0));
                $overlay.find(".pi-render-progress > span").css("width", `${Math.max(progress, 8)}%`);
            }

            function resetProgressiveContent() {
                const $sections = $(`#${window.PolicyIssuanceIdManager.overviewScroll(@ViewData["Id"])} section.dept-section`);
                $sections.removeClass("visible");
                $sections.find(".animate-step").removeClass("visible");
            }

            function begin(message) {
                sequence += 1;
                startedAt = performance.now();
                $overlay.removeClass("is-leaving").attr("aria-busy", "true");
                $root.addClass("pi-render-loading");
                $root.find(".overview-status-pill")
                    .removeClass("is-ready")
                    .attr("aria-busy", "true");
                resetProgressiveContent();
                setPhase(message || "Loading policy issuance data…", 12);
                return sequence;
            }

            async function complete(token) {
                if (token !== sequence) return;
                setPhase("Finalizing controls…", 92);
                await new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)));

                var minimumVisibleTime = 320;
                var remaining = minimumVisibleTime - (performance.now() - startedAt);
                if (remaining > 0) {
                    await new Promise(resolve => setTimeout(resolve, remaining));
                }
                if (token !== sequence) return;

                animateOverviewSections(formModuleKeyPi);
                setPhase("Ready", 100);
                $overlay.addClass("is-leaving").attr("aria-busy", "false");
                await new Promise(resolve => setTimeout(resolve, FormStageDelay.overlayDone));
                if (token !== sequence) return;
                $root.removeClass("pi-render-loading");
                $overlay.removeClass("is-leaving");
            }

            function fail(token, message) {
                if (token !== sequence) return;
                setPhase(message || "Unable to load policy issuance", 100);
                $overlay.attr("aria-busy", "false");
                setTimeout(function () {
                    if (token === sequence) $root.removeClass("pi-render-loading");
                }, 900);
            }

            if (window.PolicyIssuanceLoadingIcon) {
                setLoadingIcon(window.PolicyIssuanceLoadingIcon);
            }

            return { begin, setPhase, complete, fail, setLoadingIcon };
        })();


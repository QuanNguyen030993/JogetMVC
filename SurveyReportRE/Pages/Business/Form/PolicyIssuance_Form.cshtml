        {
            Prefix = prefix,
            ModuleCode = moduleCode,
            Title = title,
            Id = ViewData["Id"]?.ToString(),
            Guid = ViewData["Guid"]?.ToString(),
            CloneId = Convert.ToInt64(ViewData["CloneId"]),
            CopyFromGuid = ViewData["CopyFromGuid"]?.ToString()
        }' />

    </div>

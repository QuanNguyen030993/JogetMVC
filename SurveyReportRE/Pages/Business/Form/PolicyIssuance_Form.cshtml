                       <path d="M8 11V7a4 4 0 0 1 8 0v4"/>
                       <path d="M12 15v2"/>
                     </svg>
                   </span>`;
                    $(`#${formModuleKeyPi}-hint_${k}_@ViewData["Id"]`).html(icon);
                };
                const evaluatedRole = state.currentUserRole;
                const evaluatedStage = stageDept;
                renderHint(false);
                window.applyFeatureRoleControlRule({
                    feature: `Policy Issuance section hint · ${k}`,
                    controlType: "section",
                    dept: k,
                    stageDept: evaluatedStage,
                    role: evaluatedRole,
                    isDebugMode: _isDebugMode,

        async function applyPolicyIssuanceStageRemarkRule(formData) {
            const activeStageDept = String(stageDept || "").trim().toUpperCase();
            if (!activeStageDept || !window.PolicyIssuanceIdManager.validateDepartment(activeStageDept)) return null;

            const remarkBoxId = window.PolicyIssuanceIdManager.remarkBox(activeStageDept, @ViewData["Id"]);
            const $remarkPanel = $(`#${remarkBoxId}`).closest(".dept-remark-panel");
            const remarkControl = remarkBoxs?.[activeStageDept]?.controlRemark;

            $remarkPanel.hide();
            if (!remarkControl || typeof remarkControl.option !== "function") return null;
            remarkControl.option("disableComment", true);

            return window.applyFeatureRoleControlRule({
                feature: `Policy Issuance stage remark · ${activeStageDept}`,
                controlType: "section",
                dept: activeStageDept,
                stageDept: activeStageDept,
                role: state.currentUserRole,
                formData: formData || {},
                state: state,
                isDebugMode: _isDebugMode,
                isSuperUser: _isSuperUser,
                apply: function (decision) {
                    if (String(stageDept || "").trim().toUpperCase() !== activeStageDept) return;
                    remarkControl.option("disableComment", !decision.allowed);
                    $remarkPanel.toggle(decision.allowed);
                }
            });
        }

       


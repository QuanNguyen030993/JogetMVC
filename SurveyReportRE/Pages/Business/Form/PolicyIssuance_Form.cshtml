                if (!$section.length) return;

                setTimeout(() => {
                    $section.addClass("visible");

                    const $assigneeCallout = $(`#${formModuleKeyPi}-treeStack .dept-node[data-key='${dept}'] .dept-callout`);
                    $assigneeCallout.addClass("animate-step");
                    setTimeout(() => {

        function filterLocalQuotes(keyword) {
            const t = String(keyword || "").trim().toLowerCase();
            if (!t) return state.quotes.slice();

            return state.quotes.filter(x =>
                (x.policyIssuanceCode || "").toLowerCase().includes(t) ||
                (x.clientName || "").toLowerCase().includes(t) ||
                (x.productName || "").toLowerCase().includes(t) ||
                (x.lineName || "").toLowerCase().includes(t) ||
                String(x.requestNo || "").toLowerCase().includes(t)
            );
        }

   

        async function searchQuoteFromServer(keyword) {
            const token = ++state.searchRequestToken;
            state.serverSearchMode = true;
            state.isSearching = true;


            try {
                const params = new URLSearchParams();
                params.set("skip", 0);
                params.set("take", 50);
                if (keyword) params.set("searchText", keyword);

                const data = await $.ajax({
                    url: `/api/PolicyIssuance/GetAll?${params.toString()}`,
                    method: "GET",
                    contentType: "application/json"
                });

                if (token !== state.searchRequestToken) return;

                state.displayQuotes = Array.isArray(data) ? data : [];
            } catch (err) {
                console.error(err);
            } finally {
            }
        }

        function clearSearchMode() {
            state.isSearching = false;
            state.serverSearchMode = false;
            state.displayQuotes = [];
            state.searchRequestToken++;
        }

        const triggerServerSearch = debounce(function (keyword) {
            searchQuoteFromServer(keyword);
        }, 700);

        $("#pi-searchBox").dxTextBox({
            placeholder: "Search policyIssuances...",
            stylingMode: "outlined",
            mode: "search",
            onValueChanged: debounce((e) => {
                state.displayQuotes = [];
                state.isSearching = false;
                state.serverSearchMode = false;
                state.searchRequestToken = 0;
                searchText = (e.value || "").trim();

                if (!searchText) {
                    clearSearchMode();
                    return;
                }

                state.isSearching = true;

                const localRows = filterLocalQuotes(searchText);

                if (localRows.length > 0) {
                    state.serverSearchMode = false;
                    state.displayQuotes = localRows;
                    // triggerServerSearch(searchText);
                    state.isSearching = false;
                } else {
                    state.displayQuotes = [];
                    triggerServerSearch(searchText);
                    state.isSearching = false;
                }
            }, 250)
        });

       


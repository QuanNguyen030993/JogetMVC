@using JogetMVC.Model
@using Newtonsoft.Json
@model PolicyIssuance_Individual_FormModel
@{
    var moduleCode = "pi";
    var prefix = moduleCode;
    var title = moduleCode == "pi" ? "PolicyIssuance Overview" : "Policy Issuance Overview";
}
@*
Note:
-Change style to site.css
-Comment out menu topbar + sidebar
-Call ajax to main table
-Replace PolicyIssuance visible data fields, should replace by VS
-Remove app div for scroll
*@

<style>
    .att-preview {
        width: 80%;

                    }, 100);

                    const $fields = $section.find(".dept-header, .dept-upperbody, .dept-body, .dept-lowerbody");
                    setTimeout(() => {
                        $fields.addClass("visible");
                    }, 220);

                    const $attachments = $section.find(".dx-fileuploader, .attachment, .att-preview, .att-list, .att-item");
                    setTimeout(() => {
                        $attachments.addClass("animate-step visible");
                    }, 360);
                }, idx * 180);
            });
            resetOverviewAnimation(prefix);
        }


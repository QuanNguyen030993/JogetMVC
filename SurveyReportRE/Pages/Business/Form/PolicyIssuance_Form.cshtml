Note:
-Change style to site.css
-Comment out menu topbar + sidebar
-Call ajax to main table
-Replace PolicyIssuance visible data fields, should replace by VS
-Remove app div for scroll
*@

<style>
    #pi-overviewRoot_@(ViewData["Id"]) {
        position: relative;
        height: calc(85vh);
    }

    #pi-overviewRoot_@(ViewData["Id"]).pi-render-loading .cardBody,
    #pi-overviewRoot_@(ViewData["Id"]).pi-render-loading .pi-cardHeader {
        pointer-events: none;
        user-select: none;
    }

    .pi-render-overlay {
        position: absolute;
        inset: 0;
        z-index: 120;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        overflow: hidden;
        border-radius: inherit;
        background: color-mix(in srgb, var(--theme-page) 82%, transparent);
        backdrop-filter: blur(3px);
        opacity: 0;
        visibility: hidden;
        transition: opacity .28s ease, visibility .28s ease;
    }

    #pi-overviewRoot_@(ViewData["Id"]).pi-render-loading .pi-render-overlay {
        opacity: 1;
        visibility: visible;
    }

    .pi-render-overlay.is-leaving {
        opacity: 0 !important;
    }

    .pi-loader-panel {
        width: min(320px, calc(100% - 32px));
        padding: 26px 28px 24px;
        text-align: center;
        border: 1px solid var(--theme-border);
        border-radius: 20px;
        background: color-mix(in srgb, var(--theme-surface) 88%, transparent);
        box-shadow: var(--theme-shadow-md);
    }

    .pi-loader-icon-host {
        display: grid;
        width: 64px;
        height: 64px;
        margin: 0 auto 15px;
        place-items: center;
    }

    .pi-loader-icon-host > img,
    .pi-loader-icon-host > svg {
        display: block;
        max-width: 64px;
        max-height: 64px;
        object-fit: contain;
    }

    .pi-loader-default-icon {
        position: relative;
        width: 52px;
        height: 52px;
        border: 4px solid var(--theme-primary-ring);
        border-top-color: var(--theme-primary);
        border-radius: 50%;
        animation: piLoaderSpin .85s linear infinite;
    }

    .pi-loader-default-icon::after {
        content: "";
        position: absolute;
        inset: 7px;
        border: 3px solid color-mix(in srgb, var(--theme-secondary) 16%, transparent);
        border-bottom-color: var(--theme-secondary);
        border-radius: 50%;
        animation: piLoaderSpin .65s linear infinite reverse;
    }

    .pi-loader-message {
        margin-bottom: 15px;
        color: var(--theme-text);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .01em;
    }

    .pi-render-progress {
        height: 3px;
        overflow: hidden;
        border-radius: 999px;
        background: color-mix(in srgb, var(--theme-muted) 22%, transparent);
    }

    .pi-render-progress > span {
        display: block;
        width: 12%;
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, var(--theme-primary), var(--theme-secondary), var(--theme-primary));
        background-size: 200% 100%;
        animation: piProgressFlow 1.1s linear infinite;
        transition: width .3s ease;
    }

    @@keyframes piLoaderSpin {
        to { transform: rotate(360deg); }
    }

    @@keyframes piProgressFlow {
        to { background-position: -200% 0; }
    }

    @@media (prefers-reduced-motion: reduce) {
        .pi-loader-default-icon,
        .pi-loader-default-icon::after,
        .pi-render-progress > span {
            animation-duration: 1.8s;
        }
    }

    .workflow-custom-route-host {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        margin-top: 8px;
    }
</style>



                });

                var toggleHideWorkflow = false;

                $(`#${formModuleKeyQt}-panelHoverInFlow`).dxButton({
                    text: "Workflow",
                    readOnly: true,
                    type: "normal",
                    stylingMode: "contained",
                    onClick: () => {
                        if (!toggleHideWorkflow) {
                            $(`#${formModuleKeyQt}-flowPanel`).empty();
                            $(`#${formModuleKeyQt}-flowHistoryPanel`).show();
                            $(`#${formModuleKeyQt}-flowPanel`).show();

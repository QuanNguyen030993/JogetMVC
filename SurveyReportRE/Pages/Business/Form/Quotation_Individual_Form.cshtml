<script type="text/javascript">
    $(function () {
        var quotes = [
        ];
        // ===== Mock quotation list data =====
         var query = "SELECT * FROM Quotation WITH (NOLOCK)";
         $.ajax({
            url: `/api/Quotation/ExecuteCustomQuery`,
            method: "POST",
            async: false,
            contentType: "application/json",
            data: JSON.stringify(query),
            success: function(data) {
                  quotes = data;

            }
        });
            var commentPanelOpened = false;

         if (_isSuperUser)
       


        // // ===== UI state =====

        var Roles = ["MKT", "TS", "UW", "LMKT", "PM"];
        var currentUserRole = _role;
        $("#loginRoleLabel").text(currentUserRole);
        var filter = "all";
        let searchText = "";
        let selectedId = quotes[0]?.id;

        // stage vs focus
        let stageDept = quotes[0]?.stageDept;   // status ring only (from workflow stage)
        let focusDept = _role == "IT" ? "MKT" : _role;   // click highlight only

        function money(n) { return new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" }).format(n || 0); }
           function normalizeStatus(raw) {
            const s = String(raw ?? "").trim();

            // normalize lower + collapse spaces
            const k = s.toLowerCase().replace(/\s+/g, " ");

            // Map theo table bạn đưa
            // Pending/New
            if (k === "" || k === "new") return { css: "new", text: "New" };
            if (k === "pending") return { css: "pending", text: "Pending" };

            // In Progress group
            if (k === "in progress") return { css: "in-progress", text: "In Progress" };
            if (k === "accept") return { css: "accepted", text: "Accept" };
            if (k === "approved") return { css: "approved", text: "Approved" };
            if (k === "reject") return { css: "rejected", text: "Reject" };
            if (k === "decline" || k === "declined") return { css: "declined", text: "Decline" };
            if (k === "client accept") return { css: "client-accept", text: "Client accept" };
            if (k === "client refuse") return { css: "client-refuse", text: "Client refuse" };

            // Complete group
            if (k === "done") return { css: "done", text: "Done" };
            if (k === "complete") return { css: "complete", text: "Complete" };
            if (k === "dispose") return { css: "dispose", text: "Dispose" };
            if (k === "archive") return { css: "archive", text: "Archive" };

            // Unknown / ?
            if (k === "?" || k === "unknown") return { css: "unknown", text: "?" };

            // Fallback: vẫn hiện text gốc nhưng cho màu unknown
            return { css: "unknown", text: s || "?" };
        }

        /* API compatibility: giữ tên hàm cũ để bạn không phải sửa nhiều nơi */
        function statusClass(raw) { return normalizeStatus(raw).css; }
        function statusText(raw)  { return normalizeStatus(raw).text; }

        // =============================
        // 3) Mapping model => DevExtreme Forms per dept
        // =============================
        function getSelectedModel() {
            const idx = (selectedId || 1) - 1;
            return quotes[idx] || quotes[0];
        }


        function applyFilter(data){
          var arr = data.slice();
          if(filter !== "all") arr = arr.filter(x => x.status === filter);
          if(searchText){
            var t = searchText.toLowerCase();
            arr = arr.filter(x => x.quotationCode.toLowerCase().includes(t) || x.clientName?.toLowerCase().includes(t) || String(x.requestNo).includes(t));
          }
          return arr;
        }

        function renderList(){
          var data = applyFilter(quotes);
          var $root = $("#quoteList").empty();
          if(!data.length){
            $root.append(`<div style="color:#6b7280;padding:10px;">No quotations found.</div>`);
            return;
          }
          data.forEach(q => {
            var isSel = q.id === selectedId;
            $root.append(`
              <div class="quoteCard ${isSel ? "selected" : ""}" data-id="${q.id}" data-stagedept="${q.stageDept}">
                <div class="quoteTop">
                  <div>
                    <div class="quotationCode">${q.quotationCode}</div>
                  <div >${q.productDisplayName}</div>
                  </div>
                    <div class="quoteClient">${q.clientName}</div>
                  <div class="statusTag ${statusClass(q.quotationStatus)}">${statusText(q.quotationStatus)}</div>
                </div>
                <div class="quoteMeta">
                  <div>#${q.requestNo}</div>
                  <div>${q.requestedDate}</div>
                  <div class="quoteAmount">${money(q.amount)}</div>
                </div>
              </div>
            `);
          });

          $(".quoteCard").off("click").on("click", function(){
            selectedId = Number($(this).attr("data-id"));
             stageDept = $(this).attr("data-stagedept");
             $(".dept-node").removeClass("focus");
             $(`.dept-node[data-key='${currentUserRole}']`).addClass("focus");
             // applyEditLock();
            renderList();
            renderDetail();
          });
        }

        // ===== Form data =====
        var deptData = {
          MKT: { clientName:"", broker:"", requestType:"Renewal", notes:"" },
          TS:  { riskInfo:"", locationCount: 1, surveyNeeded: true },
          UW:  { decision:"", premium: null, terms:"", exclusions:"" },
          LMKT:{ approve: null, comment:"" },
          PM:  { policyNo:"", inception:null, expiry:null, invoiceTo:"" }

    //     recreateForm("#formPM", deptData.PM, getPMItems(), true);

    //     applyEditLock();
    //     updateHints();
    // }

        function renderDeptForms() {
            //Data render to partial
            debugger
            $("#formMKT").dxForm({ formData: deptData.MKT, readOnly: true, colCount: 1 });
            $("#formTS").dxForm({ formData: deptData.TS, readOnly: true, colCount: 1 });
            $("#formUW").dxForm({ formData: deptData.UW, readOnly: true, colCount: 1 });
            $("#formLMKT").dxForm({ formData: deptData.LMKT, readOnly: true, colCount: 1 });
            $("#formPM").dxForm({ formData: deptData.PM, readOnly: true, colCount: 1 });
            loadAttachmentList("MKT");
            loadAttachmentList("TS");
            loadAttachmentList("UW");
            loadAttachmentList("LMKT");
            loadAttachmentList("PM");
            applyEditLock();
            updateHints();
        }

        function applyEditLock() {
            // demo rule: chỉ edit khi login đúng dept
            const roMKT = !(currentUserRole === "MKT");
            const roTS = !(currentUserRole === "TS");
            const roUW = !(currentUserRole === "UW");
            const roLMKT = !(currentUserRole === "LMKT");
            const roPM = !(currentUserRole === "PM");

            $("#formMKT").dxForm("instance")?.option("readOnly", roMKT);
            $("#formTS").dxForm("instance")?.option("readOnly", roTS);
            $("#formUW").dxForm("instance")?.option("readOnly", roUW);
            $("#formLMKT").dxForm("instance")?.option("readOnly", roLMKT);
            $("#formPM").dxForm("instance")?.option("readOnly", roPM);

            $("#roleSelect").dxSelectBox({
          items: Roles, value: currentUserRole, stylingMode:"outlined",
          onValueChanged: (e) => {
            currentUserRole = e.value;
            $("#loginRoleLabel").text(currentUserRole);
            applyEditLock();
            updateHints();
            DevExpress.ui.notify("Role switched: " + currentUserRole, "info", 1200);
          }
        });
        }

        function updateHints() {
            $("#focusDeptPill").text(`Focus: ${focusDept}`);

            Roles.forEach(k => {
                const canEdit = (currentUserRole === k);
                const icon = canEdit
                    ? `<span class="lock editable" title="Editable">
                         <svg xmlns="http://www.w3.org/2000/svg" width="27" height="24" viewBox="0 0 27 24" aria-hidden="true">
                           <path d="M16 10V8a4 4 0 0 1 8 0v4" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                           <path fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"
                                 d="M6 10h12a4 4 0 0 1 4 4v6a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4v-6a4 4 0 0 1 4-4Zm6 4.2
                                    a2 2 0 1 0 0 4a2 2 0 0 0 0-4Zm-.9 3.7
                                    c0-.3.2-.5.5-.6a.9.9 0 1 0 .8 0c.3.1.5.3.5.6V20
                                    a.9.9 0 0 1-1.8 0v-2.1Z"/>
                         </svg> EDIT
                       </span>`
                    : `<span class="lock readonly" title="Read only">
                         <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
                           <path d="M8 10V8a4 4 0 0 1 8 0v2" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                           <path fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"
                                 d="M6 10h12a4 4 0 0 1 4 4v6a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4v-6a4 4 0 0 1 4-4Zm6 4.2
                                    a2 2 0 1 0 0 4a2 2 0 0 0 0-4Zm-.9 3.7
                                    c0-.3.2-.5.5-.6a.9.9 0 1 0 .8 0c.3.1.5.3.5.6V20
                                    a.9.9 0 0 1-1.8 0v-2.1Z"/>
                         </svg> LOCK
                       </span>`;

                $(`#hint${k}`).html(icon);
            });
        }

        // =========================
        // 3) Updated time per section
        // =========================
        function updateSectionUpdatedTime(q) {
            // Nếu bạn có field thật, map vào đây.
            const map = {
                MKT: q?.mktUpdatedAt || q?.modifiedDate || q?.updatedAt,
                TS: q?.tsUpdatedAt,
                UW: q?.uwUpdatedAt,
                LMKT: q?.lmktUpdatedAt,
                PM: q?.pmUpdatedAt
            };
            Object.keys(map).forEach(dept => {
                $(`#upd${dept}`).text("Updated: " + fmtTimeLocal(map[dept]));
            });
        }

        // =========================
        // 4) Tree highlight + scroll
        // =========================
        function applyNodeHighlights() {
            $(".dept-node").removeClass("status focus");
            $(`.dept-node[data-key='${stageDept}']`).addClass("status");
            $(`.dept-node[data-key='${focusDept}']`).addClass("focus");
        }

        function applySectionFocusHighlight() {
            $(".dept-section").removeClass("focused");
            $(`#sec${focusDept}`).addClass("focused");
        }

        function scrollToDept(dept) {
            const container = document.getElementById("overviewScroll");
            const el = document.getElementById("sec" + dept);
            if (!container || !el) return;
            container.scrollTo({ top: el.offsetTop - 8, behavior: "smooth" });
        }

        function setupDeptTree() {
            $(".dept-node").off("click.tree").on("click.tree", function () {
                const key = $(this).data("key");
                focusDept = key;

                applyNodeHighlights();
                applySectionFocusHighlight();
                applyEditLock();
                updateHints();
                scrollToDept(focusDept);

                // optional: auto expand focused dept
                setSectionCollapsed(focusDept, false);
            });
        }

        function layoutTreeLine() {
            const $stack = $("#treeStack");
            const $nodes = $stack.find(".dept-node");
            const $line = $("#treeVLine");
            if (!$nodes.length) return;

            const stackRect = $stack[0].getBoundingClientRect();
            const first = $nodes[0].getBoundingClientRect();
            const last = $nodes[$nodes.length - 1].getBoundingClientRect();

            const topInside = (first.top - stackRect.top) + (first.height / 2);
            const bottomInside = (last.top - stackRect.top) + (last.height / 2);

            $line.css({ top: `${topInside}px`, height: `${bottomInside - topInside}px` });
        }

        // =========================
        // 5) Expand / Collapse sections by clicking header
        // =========================
        function setSectionCollapsed(dept, collapsed) {
            const $sec = $(`#sec${dept}`);
            if (!$sec.length) return;
            const body = $sec.find(".dept-body")[0];

            if (collapsed) {
                $sec.addClass("collapsed");
                if (body) {
                    body.style.maxHeight = body.scrollHeight + "px";
                    setTimeout(() => { body.style.maxHeight = "0px"; }, 220);
                }
            } else {
                $sec.removeClass("collapsed");
                if (body) {
                    body.style.maxHeight = body.scrollHeight + "px";
                    setTimeout(() => { body.style.maxHeight = "2000px"; }, 220);
                }
            }
        }

        function toggleSection(dept) {
            const $sec = $(`#sec${dept}`);
            setSectionCollapsed(dept, !$sec.hasClass("collapsed"));
        }

        function bindSectionHeaderToggle() {
            ["MKT", "TS", "UW", "LMKT", "PM"].forEach(dept => {
                const $sec = $(`#sec${dept}`);
                if (!$sec.length) return;

                $sec.find(".dept-header").off("click.sec").on("click.sec", function (e) {
                    if ($(e.target).closest("a,button,.dx-button").length) return;
                    toggleSection(dept);
                });
            });
        }

        // =========================
        // 6) Comments panel module (giữ theo style bạn)
        // =========================
        const HoverAjax = (function () {
            function debounce(fn, wait) {
                let t = null;
                return function (...args) {
                    clearTimeout(t);
                    t = setTimeout(() => fn.apply(this, args), wait);
                };
            }

            function escapeHtml(s) {
                return String(s ?? "")
                    .replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;")
                    .replaceAll('"', "&quot;").replaceAll("'", "&#039;");
            }

            function renderComments(items) {
                if (!Array.isArray(items) || items.length === 0) {
                    return `<div style="color:#6b7280;font-size:12px;padding:6px 4px;">No audit logs</div>`;
                }
                return items.map((c) => `
                    <div class="ct-item">
                        <div class="ct-user">${escapeHtml((c.deptCode ? c.deptCode + " – " : "") + (c.commentBy || ""))}</div>
                        <div class="ct-time">${escapeHtml(c.commentTime || "")}${c.commentOrder != null ? " • #" + escapeHtml(c.commentOrder) : ""}</div>
                        <div class="ct-text">${escapeHtml(c.commentText || "")}</div>
                    </div>
                `).join("");
            }

            const loadComments = debounce(function (quoteNo, quoteId) {
                $("#rightCommentSub").text(quoteNo || "-");
                $("#rightCommentList").html(`<div style="color:#6b7280;font-size:12px;padding:6px 4px;">Loading…</div>`);

                const q = `SELECT * FROM QuotationCommentLog WHERE QuotationId = ${quoteId}`;
                $.ajax({
                    url: `/api/QuotationCommentLog/ExecuteCustomQuery`,
                    method: "POST",
                    async: true,
                    contentType: "application/json",
                    data: JSON.stringify(q),
                    success: function (data) { $("#rightCommentList").html(renderComments(data)); },
                    error: function () {
                        $("#rightCommentList").html(`<div style="color:#ef4444;font-size:12px;font-weight:700;padding:6px 4px;">Failed to load audit logs</div>`);
                    }
                });
            }, 180);

      function openRightCommentPanel() {
        commentPanelOpened = true;
        document.body.classList.add("hasRightPanel");
        $("#rightCommentDock").show();
        document.documentElement.style.setProperty("--collapsed-form-mr", "-2%");
      }

      function closeRightCommentPanel() {
        commentPanelOpened = false;
        document.body.classList.remove("hasRightPanel");
        $("#rightCommentDock").hide();
        document.documentElement.style.setProperty("--collapsed-form-mr", "-26%");
      }

      // ✅ bind giữ nguyên – chỉ còn việc gắn event như cũ
            function bind() {
                $("#btnToggleComment").dxButton({
                    text: "Audit logs",
                    icon: "comment",
                    type: "normal",
                    stylingMode: "contained",
                    onClick: () => {
            if (!commentPanelOpened) {
              openRightCommentPanel();
                            loadComments(selectedCodeNo, selectedId);
                        } else {
              closeRightCommentPanel();
                        }
                    }
                });

        $("#btnCloseRightComment").off("click").on("click", function () {
          closeRightCommentPanel();
                });
            }

      // ✅ expose để gọi trực tiếp mà không cần bind
      return { bind, loadComments, openRightCommentPanel, closeRightCommentPanel };
        })();

        // =========================
        // 7) Render list/detail
        // =========================
        function renderDetail() {
            debugger
            var q = quotes.find(x => x.id === selectedId) || quotes[0];
            if (!q) return;

            $("#recordNo").text(q.quotationCode);

            const st = q.quotationStatus ?? q.status;
            $("#detailStatus")
                .text(statusText(st))
                .attr("class", `statusTag ${statusClass(st)}`);

            // stage/focus pills
            $("#stageDeptPill").text(`Quotation progress flow: ${stageDept}`);
            $("#focusDeptPill").text(`Focus: ${focusDept}`);

            deptData.MKT = { ...q, sectionName: "MKT", code: q.quotationCode };
            deptData.TS = { ...q, sectionName: "TS", code: q.quotationCode };
            deptData.UW = { ...q, sectionName: "UW", code: q.quotationCode };
            deptData.LMKT = { ...q, sectionName: "LMKT", code: q.quotationCode };
            deptData.PM = { ...q, sectionName: "PM", code: q.quotationCode };

            renderDeptForms();

            applyNodeHighlights();
            applySectionFocusHighlight();
            updateHints();
            updateSectionUpdatedTime(q);

            scrollToDept(focusDept);
        }

        function renderList() {
            var data = applyFilter(quotes);
            var $root = $("#quoteList").empty();

            if (!data.length) {
                $root.append(`<div style="color:#6b7280;padding:10px;">No quotations found.</div>`);
                return;
            }

            data.forEach(q => {
                var isSel = q.id === selectedId;
                $root.append(`
                    <div class="quoteCard ${isSel ? "selected" : ""}" data-id="${q.id}" data-codeno="${q.quotationCode}" data-stagedept="${q.stageDept}">
                        <div class="quoteTop">
                            <div>
                                <div class="quoteClient">${q.clientName || ""}</div>
                                <div>${q.productName || ""}</div>
                            </div>
                            <div class="statusTag ${statusClass(q.quotationStatus)}">${statusText(q.quotationStatus)}</div>
                        </div>
                        <div class="quoteMeta">
                            <div class="quotationCode">${q.quotationCode || ""}</div>
                            <div>${q.lineName || ""}</div>
                            <div>${(typeof formatDate === "function") ? formatDate(q.requestedDate, "dd-mm-yyyy") : (q.requestedDate || "")}</div>
                        </div>
                        <div class="quoteMeta">
                            <div>Total Sum Insured</div>
                            <div class="quoteAmount">${money(q.sumInsuredTotal)}</div>
                        </div>
                        <div class="quoteMeta">
                            <div>Total Premium</div>
                            <div class="quoteAmount">${money(q.premiumTotal)}</div>
                        </div>
                        <div class="quoteMeta">
                            <div>Total Due</div>
                            <div class="quoteAmount">${money(q.totalDue)}</div>
                        </div>
                    </div>
                `);
            });

            $(".quoteCard").off("click").on("click", function () {
                selectedId = Number($(this).attr("data-id"));
                selectedCodeNo = $(this).attr("data-codeno");
                stageDept = $(this).attr("data-stagedept");

                // focus ring về đúng role hiện tại
                focusDept = currentUserRole;
                renderList();
                renderDetail();
                if (commentPanelOpened) HoverAjax.loadComments(selectedCodeNo, selectedId);
            });
        }

        // =========================
        // 8) Route overlay (fix bug getNextChoices + addPath append)
        // =========================
        const ROUTE_GRAPH = {
            MKT: [
                { to: "TS", rule: "MKT_to_TS" },
                { to: "UW", rule: "MKT_to_UW" },
                { to: "LMKT", rule: "MKT_to_LMKT" },
                { to: "PM", rule: "MKT_to_PM" },
            ],
            TS: [
                { to: "UW", rule: "TS_to_UW" },
                { to: "MKT", rule: "TS_to_MKT" },
            ],
            UW: [
                { to: "LMKT", rule: "UW_to_LMKT" },
                { to: "MKT", rule: "UW_to_MKT" },
            ],
            LMKT: [
                { to: "PM", rule: "LMKT_to_PM" },
                { to: "MKT", rule: "LMKT_to_MKT" },
            ],
            PM: []
        };

        function buildFormState() {
            return {
                requiredDone: { MKT: false, TS: false, UW: true, LMKT: false, PM: false },
                flags: {
                    needTechnicalSurvey: false,
                    needUnderwriting: false,
                    needLeaderMarketing: true,
                    needPolicyManager: true,
                    hasBlockingErrors: true
                }
            };
        }

        const RULES = {
            MKT_to_TS: (s) => s.flags.needTechnicalSurvey && s.requiredDone.MKT && !s.flags.hasBlockingErrors,
            MKT_to_UW: (s) => s.flags.needUnderwriting && s.requiredDone.MKT && !s.flags.hasBlockingErrors,
            MKT_to_LMKT: (s) => s.flags.needLeaderMarketing && s.requiredDone.MKT,
            MKT_to_PM: (s) => s.flags.needPolicyManager && s.requiredDone.MKT,

            TS_to_UW: (s) => s.requiredDone.TS && s.flags.needUnderwriting,
            TS_to_MKT: (s) => !s.requiredDone.TS,

            UW_to_LMKT: (s) => s.requiredDone.UW && s.flags.needLeaderMarketing,
            UW_to_MKT: (s) => !s.requiredDone.UW,

            LMKT_to_PM: (s) => s.requiredDone.LMKT,
            LMKT_to_MKT: (s) => !s.requiredDone.LMKT,
        };

        function getNextChoices(currentDept, formState) {
            const edges = ROUTE_GRAPH[currentDept] ?? [];
            return edges
                .filter(e => (RULES[e.rule]?.(formState) ?? true))
                .map(e => e.to);
        }

        function renderBranchOverlay(currentDept) {
            const formState = buildFormState();
            const choices = getNextChoices(currentDept, formState);

            if (!choices.length) {
                DevExpress.ui.notify("No valid route - please complete required fields", "warning", 1600);
                return;
            }

            const $canvas = $("#branchOverlay .branchCanvas");
            const $svg = $canvas.find("svg").first();

            // clear
            $svg.find("path").remove();
            $canvas.find(".bnode").remove();

            const nodeSize = 52;
            const xRootNode = 14;
            const xChoiceNode = 182;

            const xRootLine = 40;
            const xJ = 110;
            const xRightLine = 200;

            const canvasH = Math.max(140, choices.length * 70);
            $canvas.css("height", canvasH + "px");
            $svg.attr("viewBox", `0 0 260 ${canvasH}`);

            const yJ = canvasH / 2;
            const rootTop = Math.round(yJ - nodeSize / 2);

            $canvas.append(
                `<div class="bnode root current"
                      style="left:${xRootNode}px; top:${rootTop}px;"
                      title="Current role: ${currentDept}">
                    ${currentDept}
                 </div>`
            );

            const topPad = 14;
            const bottomPad = 14;
            const yMin = topPad + nodeSize / 2;
            const yMax = canvasH - bottomPad - nodeSize / 2;

            let ys;
            if (choices.length === 1) ys = [yJ];
            else if (choices.length === 2) ys = [yJ - 30, yJ + 30];
            else ys = choices.map((_, i) => yMin + i * ((yMax - yMin) / (choices.length - 1)));

            const addPath = (d) => $svg.append(`<path d="${d}" stroke="rgba(0,0,0,.22)" stroke-width="2" fill="none" />`);

            if (choices.length === 1) {
                addPath(`M${xRootLine} ${yJ} L${xRightLine} ${yJ}`);
            } else {
                addPath(`M${xRootLine} ${yJ} L${xJ} ${yJ}`);
                addPath(`M${xJ} ${ys[0]} L${xJ} ${ys[ys.length - 1]}`);
                ys.forEach(y => addPath(`M${xJ} ${y} L${xRightLine} ${y}`));
            }

            choices.forEach((dept, i) => {
                const yChoice = ys[i];
                const top = Math.round(yChoice - nodeSize / 2);
                const id = `route_${dept}`;

                $canvas.append(
                    `<div id="${id}" class="bnode choice" style="left:${xChoiceNode}px; top:${top}px;" title="Route to ${dept}">${dept}</div>`
                );

                $(`#${id}`).off("click").on("click", () => routeTo(dept));
            });
        }

        function openBranchOverlay() {
            const currentDept = stageDept || focusDept || "MKT";
            renderBranchOverlay(currentDept);
            $("#branchOverlay").show();
        }

        function closeBranchOverlay() {
            $("#branchOverlay").hide();
            $("#branchOverlay .bnode.choice").removeClass("active");
        }

        function routeTo(dept) {
            $("#branchOverlay .bnode.choice").removeClass("active");
            $(`#route_${dept}`).addClass("active");

            focusDept = dept;
            applyNodeHighlights();
            applySectionFocusHighlight();
            applyEditLock();
            updateHints();
            scrollToDept(focusDept);

            // popup remark (giữ code bạn, chỉ không đụng tới vì bạn đang dùng nhiều helper)
            DevExpress.ui.notify(`Mock submit routed to ${dept}`, "success", 1200);

            setTimeout(closeBranchOverlay, 350);
        }

        // =========================
        // 9) PIC callouts
        // =========================
        const PIC_JSON = `{"MKT":"thao.bp","TS":"hien.ttt","UW":"thanh.nt","LKMT":"thao.np"}`;

        function normalizeDeptKey(k) {
            const x = String(k || "").trim().toUpperCase();
            return x === "LKMT" ? "LMKT" : x;
        }

        function parsePicMap(picJson) {
            try {
                const obj = JSON.parse(picJson || "{}");
                const map = {};
                Object.keys(obj).forEach(k => map[normalizeDeptKey(k)] = obj[k]);
                return map;
            } catch { return {}; }
        }

        function renderDeptCallouts(picJson) {
            const picMap = parsePicMap(picJson);
            $(".dept-node").each(function () {
                const dept = normalizeDeptKey($(this).data("key"));
                const $co = $(this).find(".dept-callout");
                if (!$co.length) return;

                const pic = picMap[dept] || "-";
                $co.find(".co-text").text(pic);
                $co.css({ color: "rgba(17,24,39,.85)" });
            });
        }

        // =========================
        // 10) Controls init
        // =========================
        $("#searchBox").dxTextBox({
            placeholder: "Search quotations...",
            stylingMode: "outlined",
            mode: "search",
            onValueChanged: (e) => { searchText = e.value || ""; renderList(); }
        });

        $("#btnEdit").dxButton({ text: "Edit", icon: "edit", type: "normal", onClick: () => DevExpress.ui.notify("Mock: Edit selected", "info", 1200) });
        $("#btnMore").dxDropDownButton({ text: "More", icon: "overflow", items: ["Export", "Print", "Email"], onItemClick: (e) => DevExpress.ui.notify("Mock: " + e.itemData, "info", 1200) });

        $("#btnSaveDraft").dxButton({ text: "Save Draft", icon: "save", type: "normal", onClick: () => DevExpress.ui.notify("Mock: saved draft", "success", 1200) });
        $("#btnSubmitBranch").dxButton({ text: "Submit", icon: "check", type: "success", onClick: openBranchOverlay });

        $("#branchOverlay .backdrop").on("click", closeBranchOverlay);

        // =========================
        // 11) Init render
        // =========================
        HoverAjax.bind();
        bindSectionHeaderToggle();

        renderList();
        renderDetail();
        setupDeptTree();

        applyNodeHighlights();
        applySectionFocusHighlight();
        updateHints();

        renderDeptCallouts(PIC_JSON);

        setTimeout(layoutTreeLine, 0);
        window.addEventListener("resize", () => setTimeout(layoutTreeLine, 0));
    });
</script>

<body>
    <div class="title">
        @* header removed *@
    </div>

    <div class="contentGrid">

        <!-- List -->
        <section class="card" style="height:100%;overflow: scroll;">
            <div class="cardHeader">
                <div class="h" id="listTitle">All Quotations</div>
                <div id="searchBox" style="width: 210px;"></div>
            </div>
            <div class="cardBody">
                <div id="quoteList"></div>
            </div>
        </section>

        <!-- Detail -->
        <section class="card">
            <div class="cardHeader">
                <div style="display:flex;align-items:center;gap:10px;">
                    <div class="h">Overview</div>
                    <span id="detailStatus" class="statusTag">-</span>
                </div>
                <div id="btnToggleComment"></div>
            </div>

            <div class="cardBody overview-wrap" style="padding:0">

                <div id="flowHistoryPanel" class="flow-history-panel">
                    <div class="fh-title">
                        <span>Flow History</span>
                        <span id="flowSummary" class="fh-sub">-</span>
                    </div>
                    <div id="flowHistoryBody" class="fh-flow">
                        <div style="color:#6b7280;font-size:12px;padding:6px 4px;">Hover tree to load…</div>
                    </div>
                </div>

                <div id="commentPanel" class="comment-tooltip" style="display:none;">
                    <div class="ct-title">
                        <span>Audit Log</span>
                        <span id="commentPanelSub" class="ct-sub">-</span>
                        <span class="ct-actions">
                            <a href="javascript:void(0)" id="btnCloseCommentPanel" class="ct-close">✕</a>
                        </span>
                    </div>
                    <div id="commentPanelList" class="ct-list">
                        <div style="color:#6b7280;font-size:12px;padding:6px 4px;">Click “Comments” to load…</div>
                    </div>
                </div>

                <!-- Navigator Tree -->
                <div id="deptTree" class="dept-tree">
                    <div class="treeStack" id="treeStack">
                        <div class="vline" id="treeVLine"></div>

                        <div class="dept-node" data-key="MKT" data-target="#secMKT">
                            <div class="dept-callout" data-pic-for="MKT"><span class="co-icon"></span><span class="co-text">-</span></div>
                            <div class="dept-circle">MKT</div>
                        </div>

                        <div class="dept-node" data-key="TS" data-target="#secTS">
                            <div class="dept-callout" data-pic-for="TS"><span class="co-icon"></span><span class="co-text">-</span></div>
                            <div class="dept-circle">TS</div>
                        </div>

                        <div class="dept-node" data-key="UW" data-target="#secUW">
                            <div class="dept-callout" data-pic-for="UW"><span class="co-icon"></span><span class="co-text">-</span></div>
                            <div class="dept-circle">UW</div>
                        </div>

                        <div class="dept-node" data-key="LMKT" data-target="#secLMKT">
                            <div class="dept-callout" data-pic-for="LMKT"><span class="co-icon"></span><span class="co-text">-</span></div>
                            <div class="dept-circle">LMKT</div>
                        </div>

                        <div class="dept-node" data-key="PM" data-target="#secPM">
                            <div class="dept-callout" data-pic-for="PM"><span class="co-icon"></span><span class="co-text">-</span></div>
                            <div class="dept-circle">PM</div>
                        </div>

                    </div>
                </div>

                <div id="overviewScroll" class="overview-scroll">

                    <!-- MKT -->
                    <section id="secMKT" class="dept-section">
                        <div class="dept-header">
                            <div class="dept-title">MKT</div>
                            <div class="dept-hint-wrap">
                                <div class="dept-hint" id="hintMKT"></div>
                                <div class="dept-updated" id="updMKT" title="Last updated">—</div>
                                <div class="dept-toggle-icon" aria-hidden="true">▾</div>
                            </div>
                        </div>
                        <div class="dept-body">
                            @await Html.PartialAsync("Business/Form/QuotationDetail/_Quotation_MKT_Form")
                        </div>
                    </section>

                    <!-- TS -->
                    <section id="secTS" class="dept-section">
                        <div class="dept-header">
                            <div class="dept-title">TS</div>
                            <div class="dept-hint-wrap">
                                <div class="dept-hint" id="hintTS"></div>
                                <div class="dept-updated" id="updTS" title="Last updated">—</div>
                                <div class="dept-toggle-icon" aria-hidden="true">▾</div>
                            </div>
                        </div>
                        <div class="dept-body">
                            @await Html.PartialAsync("Business/Form/QuotationDetail/_Quotation_TS_Form")
                        </div>
                    </section>

                    <!-- UW -->
                    <section id="secUW" class="dept-section">
                        <div class="dept-header">
                            <div class="dept-title">UW</div>
                            <div class="dept-hint-wrap">
                                <div class="dept-hint" id="hintUW"></div>
                                <div class="dept-updated" id="updUW" title="Last updated">—</div>
                                <div class="dept-toggle-icon" aria-hidden="true">▾</div>
                            </div>
                        </div>
                        <div class="dept-body">
                            @await Html.PartialAsync("Business/Form/QuotationDetail/_Quotation_UW_Form")
                        </div>
                    </section>

                    <!-- LMKT -->
                    <section id="secLMKT" class="dept-section">
                        <div class="dept-header">
                            <div class="dept-title">Leader MKT</div>
                            <div class="dept-hint-wrap">
                                <div class="dept-hint" id="hintLMKT"></div>
                                <div class="dept-updated" id="updLMKT" title="Last updated">—</div>
                                <div class="dept-toggle-icon" aria-hidden="true">▾</div>
                            </div>
                        </div>
                        <div class="dept-body">
                            @await Html.PartialAsync("Business/Form/QuotationDetail/_Quotation_LMKT_Form")
                        </div>
                    </section>

                    <!-- PM -->
                    <section id="secPM" class="dept-section">
                        <div class="dept-header">
                            <div class="dept-title">PM</div>
                            <div class="dept-hint-wrap">
                                <div class="dept-hint" id="hintPM"></div>
                                <div class="dept-updated" id="updPM" title="Last updated">—</div>
                                <div class="dept-toggle-icon" aria-hidden="true">▾</div>
                            </div>
                        </div>
                        <div class="dept-body">
                            @await Html.PartialAsync("Business/Form/QuotationDetail/_Quotation_PM_Form")
                        </div>
                    </section>

                </div>
            </div>

        </section>
    </div>

    <!-- Bottom action bar -->
    <div class="actionBar">
        <div class="actionLeft">
            <span class="pill">Record: <b id="recordNo">Qu-10030</b></span>
            <span class="pill">Login role: <b id="loginRoleLabel"></b></span>
            <span id="stageDeptPill" class="pill">Quotation status: </span>
            <span id="focusDeptPill" class="pill">Focus section: </span>
        </div>
        <div class="actionRight">
            <div id="btnSaveDraft"></div>
            <div id="btnSubmitBranch"></div>
        </div>
    </div>

    <!-- Branch overlay -->
    <div id="branchOverlay" class="branchOverlay">
        <div class="backdrop"></div>
        <div class="branchPopup">
            <div class="branchTitle">
                <span>Submit Route</span>
                <span class="branchHint">Choose next dept</span>
            </div>
            <div class="branchCanvas">
                <svg width="100%" height="100%" viewBox="0 0 260 140" style="position:absolute;inset:0;"></svg>
            </div>
        </div>
    </div>

</body>
        // =============================
        // 4) Hover AJAX module (Comments + Flow History)
        // - Replace endpoints below to call your server
        // =============================
        const MockupApi = {
            // Example:
            // commentsUrl: (quotationCode) => `/api/quotation/${encodeURIComponent(quotationCode)}/comments`,
            // flowUrl: (quotationCode) => `/api/quotation/${encodeURIComponent(quotationCode)}/flow`,
            commentsUrl: (quotationCode) => `/api/mock/comments?quotationCode=${encodeURIComponent(quotationCode)}`,
            flowUrl: (quotationCode) => `/api/mock/flow?quotationCode=${encodeURIComponent(quotationCode)}`
        };

        const HoverAjax = (function () {
            const cache = new Map(); // key -> { at, data }
            const xhrs = new Map();  // key -> jqXHR
            const CACHE_MS = 30000;

            function debounce(fn, wait) {
                let t = null;
                return function (...args) {
                    clearTimeout(t);
                    t = setTimeout(() => fn.apply(this, args), wait);
                };
            }

            function ajaxJson(url, key) {
                const now = Date.now();
                const c = cache.get(key);
                if (c && (now - c.at) < CACHE_MS) return $.Deferred().resolve(c.data).promise();

                const prev = xhrs.get(key);
                if (prev && prev.readyState !== 4) prev.abort();

                const dfd = $.Deferred();
                const xhr = $.ajax({
                    url, method: "GET", dataType: "json",
                    success: (data) => { cache.set(key, { at: Date.now(), data }); dfd.resolve(data); },
                    error: (xhr, status) => { if (status === "abort") return; dfd.reject(status); }
                });
                xhrs.set(key, xhr);
                return dfd.promise();
            }

            function escapeHtml(s) {
                return String(s ?? "")
                    .replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;")
                    .replaceAll('"', "&quot;").replaceAll("'", "&#039;");
            }

            function positionTooltip($tip, rect) {
                const margin = 10;
                const vw = window.innerWidth, vh = window.innerHeight;
                const tipW = $tip.outerWidth(), tipH = $tip.outerHeight();

                // prefer right side of card
                let left = rect.right + margin;
                let top = rect.top;

                if (left + tipW > vw - 8) left = rect.left - tipW - margin;
                if (left < 8) left = Math.max(8, vw - tipW - 8);
                if (top + tipH > vh - 8) top = Math.max(8, vh - tipH - 8);

                $tip.css({ left: `${left}px`, top: `${top}px` });
            }

            function renderComments(items) {
                if (!Array.isArray(items) || items.length === 0) {
                    return `<div style="color:#6b7280;font-size:12px;padding:6px 4px;">No comments</div>`;
                }
                return items.map((c) => `
            <div class="ct-item">
              <div class="ct-user">${escapeHtml((c.deptCode ? c.deptCode + " – " : "") + (c.deptCode || ""))}</div>
              <div class="ct-time">${escapeHtml(c.commentTime || "")}${c.commentOrder != null ? " • #" + escapeHtml(c.commentOrder) : ""}</div>
              <div class="ct-text">${escapeHtml(c.commentText || "")}</div>
            </div>
          `).join("");
            }

            function renderFlow(items) {
                if (!Array.isArray(items) || items.length === 0) {
                    return { summary: "-", html: `<div style="color:#6b7280;font-size:12px;padding:6px 4px;">No history</div>` };

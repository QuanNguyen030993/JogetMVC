              { dataField:"amount", caption:"Amount", dataType:"number", format: { type:"currency", precision:2 } }
            ],
            summary: { totalItems:[{ column:"amount", summaryType:"sum", valueFormat:{type:"currency",precision:2}, displayFormat:"Total: {0}" }] }
          });
        }

          deptData.MKT.notes = q.terms;

          renderDeptForms();
          renderItemsGrid(q);

          // apply highlight rings without using scroll
          applyNodeHighlights();
          applySectionFocusHighlight();

          // scroll to focus dept once when selecting a quotation (optional)
          scrollToDept(focusDept);
        }


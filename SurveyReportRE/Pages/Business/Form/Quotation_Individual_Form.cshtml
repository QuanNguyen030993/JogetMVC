    /* =========================
       NODE container (không ép circle nữa)
       ========================= */
    .dept-node {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        /* khoảng cách callout-circle chỉ để đẹp, callout là absolute nên gap không ảnh hưởng */
        gap: 10px;
        z-index: 1;
    }

    /* =========================
       CIRCLE = giữ nguyên style cũ của dept-node
       ========================= */
    .dept-circle {
        position: relative; /* để vẽ inner ring khi both */
        width: var(--node);
        height: var(--node);
        border-radius: 999px;
        background: #fff;
        border: 2px solid var(--nodeBorder);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 8px;
        font-weight: 900;
        color: #111827;
        box-shadow: 0 6px 18px rgba(0,0,0,.08);
        pointer-events: auto;
        cursor: pointer;
        user-select: none;
        transition: transform .12s ease, box-shadow .12s ease, border-color .12s ease;
        z-index: 2; /* nằm trên vline */
    }

    /* hover scale */
    .dept-node:hover .dept-circle {
        transform: scale(1.06);
    }

    /* =========================
       RINGS (status / focus / both)
       ========================= */
    .dept-node.status .dept-circle {
        border-color: rgba(232,74,95,.95);
        box-shadow: 0 0 0 4px rgba(232,74,95,.16), 0 10px 22px rgba(0,0,0,.10);
    }

    .dept-node.focus .dept-circle {
        border-color: rgba(37,99,235,.95);
        box-shadow: 0 0 0 4px rgba(37,99,235,.18), 0 10px 22px rgba(0,0,0,.10);
    }

    .dept-node.status.focus .dept-circle {
        border-color: rgba(37,99,235,.95);
    }

        .dept-node.status.focus .dept-circle::after {
            content: "";
            position: absolute;
            inset: 4px;
            border-radius: 999px;
            border: 2px solid rgba(232,74,95,.9);
            pointer-events: none;
        }

    /* =========================
       CALLOUT (speech bubble) - hover only
       - absolute để KHÔNG phá layout và KHÔNG mất click/text
       ========================= */
    .dept-callout {
        position: absolute;
        /* nằm bên trái circle */
        right: calc(var(--node) + 12px);
        top: 50%;
        transform: translateY(-50%) translateX(10px);
        min-width: 150px;
        height: 30px;
        padding: 0 10px;
        border-radius: 10px;
        background: #fff;
        border: 1px solid rgba(17,24,39,.14);
        box-shadow: 0 6px 14px rgba(0,0,0,.08);
        display: flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
        /* hidden default */
        opacity: 0;
        visibility: hidden;
        /* QUAN TRỌNG: để không chặn click vào circle */
        pointer-events: none;
        transition: opacity .12s ease, transform .12s ease, visibility .12s ease;
        z-index: 3;
    }

        /* arrow */
        .dept-callout::after {
            content: "";
            position: absolute;
            right: -10px;
            top: 50%;
            transform: translateY(-50%);
            width: 0;
            height: 0;
            border-top: 8px solid transparent;
            border-bottom: 8px solid transparent;
            border-left: 10px solid #fff;
        }

        .dept-callout::before {
            content: "";
            position: absolute;
            right: -11px;
            top: 50%;
            transform: translateY(-50%);
            width: 0;
            height: 0;
            border-top: 9px solid transparent;
            border-bottom: 9px solid transparent;
            border-left: 11px solid rgba(17,24,39,.14);
        }

    /* hover node => show callout */
    .dept-node:hover .dept-callout {
        opacity: 1;
        visibility: visible;
        transform: translateY(-50%) translateX(0);
    }

    /* icon + text */
    .dept-callout .co-icon {
        width: 18px;
        height: 18px;
        display: inline-grid;
        place-items: center;
    }

    .dept-callout .co-text {
        font-size: 12px;
        font-weight: 800;
        color: rgba(17,24,39,.85);
    }



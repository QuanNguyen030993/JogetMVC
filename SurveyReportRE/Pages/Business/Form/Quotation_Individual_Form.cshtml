@page "{pageNum:int?}"
@using JogetMVC.Model
@using Newtonsoft.Json
@model Quotation_Individual_FormModel
@{
    var moduleCode = "qt";
    var prefix = moduleCode;
    var title = moduleCode == "qt" ? "Quotation Overview" : "Policy Issuance Overview";
}
@*
Note:
-Change style to site.css
-Comment out menu topbar + sidebar
-Call ajax to main table
-Replace Quotation visible data fields, should replace by VS
-Remove app div for scroll
*@

<style>
    .att-preview {
        width: 80%;
        display: flex;
        flex-direction: column;
        margin-bottom: 10px;
        gap: 10px;
        overflow-x: hidden;
        overflow-y: auto;
        padding: 6px 4px;
        scroll-behavior: smooth;
        max-height: 320px;
    }

        .att-preview::-webkit-scrollbar {
            width: 6px;
        }

        .att-preview::-webkit-scrollbar-thumb {
            background: var(--c-bbbbbb);
            border-radius: 4px;
        }

    .att-item {
        width: 100%;
        max-width: 720px;
        min-height: 52px;
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 10px;
        border: 1px solid var(--c-dddddd);
        border-radius: 8px;
        background: var(--c-ffffff);
        box-sizing: border-box;
    }

    .att-ico {
        flex: 0 0 32px;
        width: 32px;
        text-align: center;
        font-size: 18px;
    }

    .att-meta {
        flex: 1 1 auto;
        min-width: 0;

          var stackRect = $stack[0].getBoundingClientRect();

          var first = $nodes[0].getBoundingClientRect();
          var last  = $nodes[$nodes.length-1].getBoundingClientRect();

          var topInside = (first.top - stackRect.top) + (first.height / 2);
          var bottomInside = (last.top - stackRect.top) + (last.height / 2);

          // line starts at center of first and ends at center of last

@page
@model QuotationSubmittedRequestModel
@{
}
<script>
    $(function () {
        const gridParams = {
            isAllowRowMenu: false,
            gridEditorOptions: {
                editing: { allowUpdating: false, allowAdding: false, allowDeleting: false }
            }
        };
        const gridOption = new QuotationGridOption("@QuotationSubmittedRequestModel.ModelName", "User", gridParams);
        gridOption.overrideGetUrl = "/api/Quotation/SubmittedList";
        new MGrid(null, $("#dataGrid_@QuotationSubmittedRequestModel.PageName"), gridOption, null);
    });
</script>
<div id="dataGrid_@QuotationSubmittedRequestModel.PageName"></div>

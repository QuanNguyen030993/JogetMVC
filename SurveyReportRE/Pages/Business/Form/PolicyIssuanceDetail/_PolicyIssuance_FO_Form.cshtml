@using JogetMVC.Model
@{
    string dept = "FO";
    long policyIssuanceId = Convert.ToInt64(ViewData["Id"]);
    string policyIssuanceGuid = ViewData["Guid"].ToString();
    long cloneId = Convert.ToInt64(ViewData["CloneId"]);
    string cloneQuotationGuid = ViewData["CopyFromGuid"].ToString();
}

<style>
    .dx-tabpanel .dx-tabpanel-tabs .dx-tab {
        width: auto;
        padding-left: 18px;
        padding-right: 18px;
    }
   

</style>
<div id="@PIViewIdHelper.Form(dept, policyIssuanceId)">
</div>
<script type="text/javascript">
    $(function() {
    var thatObject = new Object();
    thatObject.ModelName = "PolicyIssuance";

    var dataSourceGrid = [
        { field: "confirmedQuotationFlag", label: "Confirmed Quotation (must for FCI, CCI)", checked: false, type: "checkbox" },
        { field: "emailMktClient", label: "Email MKT-Client", checked: false, type: "checkbox" },
        { field: "riClosings", label: "RI Closings", checked: false, type: "checkbox" },
        { field: "factoryOperationYears", label: "Operation year of Factories (*)", checked: false, type: "text" },
        { field: "newReplacementValue", label: "New replacement value / reinstatement value (*)", checked: false, type: "checkbox" },
        { field: "holdCoverType", label: "Hold Cover / Cover Note", checked: false, type: "checkbox" },
        { field: "resultAttachment", label: "RES (*)", checked: false, type: "checkbox" },
        { field: "declarationText", label: "Declaration", checked: false, type: "checkbox" },
        { field: "machineryList", label: "List of machineries including the depreciated values for each of item (*)", checked: false, type: "checkbox" },
        { field: "isBodApproved", label: "BoDs/UW's approved", checked: false, type: "checkbox" },
        { field: "uRFAttachment", label: "URF", checked: false, type: "checkbox" },
        { field: "emailInformRi", label: "Email inform RI for Endorsement", checked: false, type: "checkbox" },
        { field: "riScheme", label: "RI Scheme (New/RN)", checked: false, type: "checkbox" },
        { field: "proposalForm", label: "Proposal form (must for CCI)", checked: false, type: "checkbox" },
        { field: "propertyType", label: "Type of Property list (must for FCI)", checked: false, type: "radio" },
        { field: "sumInsuredBreakdown", label: "Breakdown SI for each location (must for FCI)", checked: false, type: "checkbox" },
        { field: "premiumBreakdown", label: "Premium Breakdown", checked: false, type: "checkbox" },
        { field: "reason", label: "In case of C or D, please state reason of not having List of Insured Properties and/or the ability (When) to collect this List", checked: false, type: "textarea" },
        { field: "chassisEngineNumber", label: "Chassis - Engine No. (*)", checked: false, type: "checkbox" },
        { field: "finalPremium", label: "Final Premium in Motor system = Premium in received final Quotation (*)", checked: false, type: "checkbox" },
        { field: "isKycChecked", label: "KYC Checked", checked: false, type: "checkbox" },
        { field: "others", label: "Others (Specify)", checked: false, type: "checkbox" },
        { field: "isGlobalCover", label: "Global", checked: false, type: "checkbox" },
        { field: "ichigenka", label: "Ichigenka", checked: false, type: "checkbox" }
    ];

    var sectionId = "@ViewData["Cd"]";
    var sectionIdQt = "qt-body_@(dept)_";
    var that = new Object();
    that.ModelName = "PolicyIssuance";
    that.moduleName = "default";
    that.editorType = "dxFileUploader"
    that.id = @(cloneId);
    that.guid = "@(cloneQuotationGuid)";
    that.sectionName = "@(dept)";
    that.titleName = "Upload Quotation";
    that.uploaderAllow = false;//_role == "@dept";
    that.isRenderUploader = false;
    that.data = { SectionName: window.IdManager.attachmentSectionKey(sectionIdQt, that.moduleName, @(cloneId)), Department: "@(dept)", FieldName: that.moduleName, FormId: "@(QTViewIdHelper.Form(dept, cloneId))" }; //{"SectionName":"default_FO_410"}
    that.showFillListSelect = true;
    that.sectionId = sectionId;
    that.policyIssuanceId = @(policyIssuanceId);
    that.sectionIdQt = sectionIdQt;
    that.cloneId = @(cloneId);

    var that2 = new Object();
    that2.ModelName = "PolicyIssuance";
    that2.moduleName = "supportingDoc";
    that2.editorType = "dxFileUploader"
    that2.id = @(cloneId);
    that2.guid = "@(cloneQuotationGuid)";
    that2.sectionName = "@(dept)";
    that2.titleName = "Upload Supporting Document";
    that2.uploaderAllow = _role == "@dept";
    that2.data = { SectionName: window.IdManager.attachmentSectionKey(sectionIdQt, that2.moduleName, @(cloneId)), Department: "@(dept)", FieldName: that2.moduleName, FormId: "@(QTViewIdHelper.Form(dept, cloneId))" }; //{"SectionName":"default_FO_410"}

    var that3 = new Object();
    that3.ModelName = "PolicyIssuance";
    that3.moduleName = "defaultDoc";
    that3.editorType = "dxFileUploader"
    that3.id = @(policyIssuanceId);
    that3.guid = "@(policyIssuanceGuid)";
    that3.cloneId = @cloneId;
    that3.cloneGuid = "@(cloneQuotationGuid)";
    that3.sectionName = "@(dept)";
    that3.titleName = "Upload Document";
    that3.uploaderAllow = _role == "@dept";
    that3.data = { SectionName: window.IdManager.attachmentSectionKey(sectionId, that3.moduleName, @(policyIssuanceId)), Department: "@(dept)", FieldName: that3.moduleName, FormId: "@(PIViewIdHelper.Form(dept, policyIssuanceId))" }; //{"SectionName":"default_FO_410"}

    $("#@PIViewIdHelper.Form(dept, policyIssuanceId)").dxForm({
        dataSource: makeBasicDataSource(thatObject, true),
    items: [
            {
                itemType: "group",
                name: "fillListGroup",
                cssClass: "workflow-ui-lock-target-fillListGroup",
                elementAttr: { "data-form-group-name": "fillListGroup" },
                caption: "Fill List",
                visible: false,
                colCount: 1,
                items: [{
                    itemType: "simple",
                    template: function () {
                        return $("<div id='pi_fillList_FO_@policyIssuanceId'>").dxDataGrid({
                            dataSource: dataSourceGrid,
                            keyExpr: "field",
                            paging: { enabled: false },
                            pager: { visible: false },
                            editing: { mode: "cell", allowUpdating: true },
                            columnAutoWidth: true,
                            wordWrapEnabled: true,
                            showBorders: true,
                            columns: [
                                {
                                    dataField: "label",
                                    caption: "Content",
                                    allowEditing: false,
                                    width: 350
                                },
                                {
                                    dataField: "checked",
                                    caption: "Check",
                                    width: 100,
                                    dataType: "boolean"
                                },
                                {
                                    caption: "Attachment",
                                    cellTemplate: function (container, options) {
                                        const data = options.data;
                                        if (!data.checked) {
                                            container.text("");
                                            return;
                                        }

                                        let editor;
                                        switch (data.type) {
                                            case "number":
                                                editor = $("<div>").dxNumberBox({ value: data.value });
                                                break;
                                            case "text":
                                                editor = $("<div>").dxTextBox({ value: data.value });
                                                break;
                                            case "textarea":
                                                editor = $("<div>").dxTextArea({ value: data.value, height: 80 });
                                                break;
                                            case "select":
                                                editor = $("<div>").dxSelectBox({ items: ["New", "Renewal", "Hold Cover", "Cover Note"] });
                                                break;
                                            case "radio":
                                                editor = $("<div>").dxRadioGroup({
                                                    displayExpr: "text",
                                                    valueExpr: "id",
                                                    layout: "horizontal",
                                                    items: ["A", "B", "C", "D"]
                                                });
                                                break;
                                            case "checkbox":
                                                var fillListUploader = new Object();
                                                fillListUploader.ModelName = "PolicyIssuance";
                                                fillListUploader.moduleName = `pi_${data.field}`;
                                                fillListUploader.editorType = "dxFileUploader";
                                                fillListUploader.id = @(policyIssuanceId);
                                                fillListUploader.guid = "@(policyIssuanceGuid)";
                                                fillListUploader.sectionName = "@dept";
                                                fillListUploader.titleName = "Add file";
                                                fillListUploader.baseOnAttributes = "FieldName";
                                                fillListUploader.compactAttachment = true;
                                                fillListUploader.data = {
                                                    SectionName: window.IdManager.attachmentSectionKey(sectionId, data.field, @(policyIssuanceId)),
                                                    Department: "@dept",
                                                    FieldName: `${data.field}_@(policyIssuanceId)`
                                                };
                                                editor = $("<div>");
                                                createEditor(fillListUploader, editor, $("<div>"), fillListUploader);
                                                break;
                                            default:
                                                editor = "";
                                        }

                                        container.append(editor);
                                    }
                                }
                            ]
                        });
                    }
                }]
            },
                {itemType: "group",caption: "Request Date",colCount:2,items: [
            {
                                  dataField: "requestedDate",
                                  editorType: "dxDateBox",
                                  editorOptions: { displayFormat: "dd/MM/yyyy" },
                                  label: {  template: labelTpl("RequestedDate - Ngày yêu cầu") }
                                },
            {
                                  dataField: "dueDate",
                                  editorType: "dxDateBox",
                                  editorOptions: { displayFormat: "dd/MM/yyyy" },
                                  label: { template: labelTpl("DueDate - Due date") }
                                }
            ]},

                 {itemType: "group",caption: "Client",colCount:2,items: [
                     { dataField:"clientName", label:{text:"Client Name"}, isRequired:true },
                   { dataField: "policyHolder", label: { template: labelTpl("Policy Holder ID") }, editorOptions: { readOnly: true } },
                    { dataField: "insuredId", label: { template: labelTpl("Insured ID") },visible: false, editorOptions: { readOnly: true } },
                    { dataField: "clientCode", visible: false, label: { template: labelTpl("Client Code") }, editorOptions: { readOnly: true } },
                    { dataField: "clientName", label: { template: labelTpl("Client Name") }, editorOptions: { readOnly: true } },
                    { dataField: "businessAddress", label: { template: labelTpl("Business Address") }, editorOptions: { readOnly: true } },
                        { dataField: "sourceOfBusinessName", label: { template: labelTpl("SourceOfBusinessName - Nguồn business (name)") } },

                     ]},{
                        itemType: "group",
                        caption: "Products",
                        colCount: 2,
                        cssClass: "group-readonly",
                        items: [
                            { dataField: "lineName", label: { template: labelTpl("Line") }, editorOptions: { readOnly: true } },
                            { dataField: "productName", label: { template: labelTpl("Product") }, editorOptions: { readOnly: true } },
                        ]
                    },

                 // { dataField:"surveyNeeded", label:{text:"Survey Needed"}, editorType:"dxSwitch" ,editorOptions:{ switchedOnText: "Yes", switchedOffText: "No"} },
                 {itemType: "group",
                caption: "Request Infomation",
                colCount: 3,
                items: [
                { dataField: "requestNo", label: { template: labelTpl("RequestNo - Mã Quotation Request") } },
                {dataField: "policyNo",editorType: "dxTextBox",visible:true},
                    { dataField: "requestRefNo",visible: false, label: { template: labelTpl("RequestRefNo - Refversion của request") } },
                    { dataField: "quotationCode", label: { template: labelTpl("QuotationCode - Mã quotation khi request vào xử lý (Joget)") } },
                     { dataField:"requestTypeId", editorType:"dxSelectBox", label:{text:"Request Type"}, editorOptions: makeSelectBoxEditorOptions(_enums.requestType),displayExpr: "value",
                     valueExpr: "id"
                 },
                    makeSkipTSSwitchFormItem("policyIssuanceType"),
                    { dataField: "quotationType",visible: false, label: { template: labelTpl("QuotationType - Loại đơn quotation type (ví dụ: New)") } },
                    { dataField: "businessChannelName", label: { template: labelTpl("BusinessChannelName - Kênh kinh doanh (name)") } },
                    { dataField: "businessChannelDisplayName",visible: false, label: { template: labelTpl("BusinessChannelDisplayName - Tên hiển thị kênh (name of biz)") } },
                     { dataField:"reinsuranceId", editorType:"dxSelectBox", label:{text:"Reinsurance"},
                     editorOptions:{
                     items:_enums.reInsuranceType ,
                     displayExpr: "value",
                      valueExpr: "id"}
                 },


                 { dataField:"subject", label:{text:"Subject"}, editorType:"dxTextArea", colSpan:3},

                            ]},{
                itemType: "group",
                caption: "Attachment",
                colCount: 1,
                items: [
                    {
                        dataField: "quotation",
                        colSpan: 1,
                        label: { text: "Uploaded Quotation" },
                        template: function (data, itemElement) {
                            createEditor(that, itemElement, $("<div>"), that);

                        }
                    },
                    {
                        dataField: "supportingDocument",
                        colSpan: 2,
                        template: function (data, itemElement) {
                            createEditor(that2, itemElement, $(`<div>`), that2);
                        }
                    },
                    {
                        dataField: "document",
                        colSpan: 2,
                        template: function (data, itemElement) {
                            createEditor(that3, itemElement, $(`<div>`), that3);
                        }
                    }
                ]
            }

               ]
    
    });
    viewFieldAdjust("@PIViewIdHelper.Form(dept, policyIssuanceId)");

    loadPolicyIssuanceSkipTS(
        @policyIssuanceId,
        "@PIViewIdHelper.Form(dept, policyIssuanceId)"
    ).then(function (skipTsEnabled) {
        if (!skipTsEnabled) return;

        var foForm = $("#@PIViewIdHelper.Form(dept, policyIssuanceId)").dxForm("instance");
        foForm?.itemOption("fillListGroup", "visible", true);

        const fetchQuotationDocs = $.ajax({
            url: "/api/Document/GetByKey?recordGuid=@cloneQuotationGuid",
            method: "GET"
        });
        const fetchPolicyDocs = $.ajax({
            url: "/api/Document/GetByKey?recordGuid=@policyIssuanceGuid",
            method: "GET"
        });

        $.when(fetchQuotationDocs, fetchPolicyDocs).done(function (quotationResult, policyResult) {
            const docs = [...(quotationResult[0] || []), ...(policyResult[0] || [])];
            var formData = foForm?.option("formData") || {};
            var piAttributes = {};
            try {
                piAttributes = JSON.parse(formData.attributes || formData.Attributes || "{}");
            } catch (error) {}

            dataSourceGrid.forEach(function (item) {
                const matchedDoc = docs.find(function (doc) {
                    var attrs = {};
                    try {
                        attrs = JSON.parse(doc.attributes || doc.Attributes || "{}");
                    } catch (error) {}

                    const fieldName = (attrs.FieldName || "").replace(/_\d+$/, "");
                    return fieldName === item.field || attrs.TSSectionName === item.field;
                });

                item.checked = !!matchedDoc || piAttributes[item.field] === true;
            });

            var grid = $("#pi_fillList_FO_@policyIssuanceId").dxDataGrid("instance");
            grid?.option("dataSource", dataSourceGrid);
        });
    });

    setTimeout(() => {
        var picJson = PIC_JSON || "{}";
        var picMap = parsePicMap(picJson);
        var picVal = picMap["@dept"] || "";
        var sectionId = `#pi-sec_@(dept)_@(policyIssuanceId)`;
        if (!picVal) {
            $(sectionId).find(".dept-upperbody, .dept-body, .dept-lowerbody, .dept-footer").hide();
        } else {
            $(sectionId).find(".dept-upperbody, .dept-body, .dept-lowerbody, .dept-footer").show();
        }
    }, 100);

    })
</script>

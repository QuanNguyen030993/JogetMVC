@using JogetMVC.Model
@{
    string dept = "FO";
    long quotationId = Convert.ToInt64(ViewData["Id"]); string quotationGuid = ViewData["Guid"].ToString();
}
<!-- COMPOSER -->
<div id="@PIViewIdHelper.PinZone(dept, quotationId)" class="composer">
    <div class="pinned-zone">
        <div class="pinned-zone-header">
            <div class="pinned-zone-title">Pinned notes</div>
            <div class="pinned-toolbar">
                <div id="@PIViewIdHelper.BtnExpandAllPins(dept, quotationId)"></div>
                <div id="@PIViewIdHelper.BtnCollapseAllPins(dept, quotationId)"></div>
                <div id="@PIViewIdHelper.BtnUrgentPins(dept, quotationId)"></div>
            </div>
        </div>
        <div class="pin-list" id="@PIViewIdHelper.PinList(dept, quotationId)"></div>
    </div>

</div>


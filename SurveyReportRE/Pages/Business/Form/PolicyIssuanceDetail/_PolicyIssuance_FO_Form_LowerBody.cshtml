@{
    string dept = "FO";

}
    <!-- COMPOSER -->
    <div class="composer">
        <div class="dept-title">Comments</div>

        <div id="pi-commentPanelControl_@dept"></div>
        <div class="composer-actions">
            <div id="pi-btnChatSend_@dept"> </div>
        </div>
        <div class="filter-bar">
            <div class="filter-left">
                <div id="pi-filterTypeSelect_@dept"></div>
                <div id="pi-filterUnreadCheckbox_@dept"></div>
                <div id="pi-btnFilterAll_@dept"></div>
                <div id="pi-btnFilterRequest_@dept"></div>
                <div id="pi-btnFilterBlocker_@dept"></div>
                <div id="pi-btnFilterDiscussion_@dept"></div>
                <div id="pi-btnFilterInternal_@dept"></div>
            </div>
            <div class="filter-note">
            </div>
            <div class="comment-wrap" id="pi-commentWrap_@dept"></div>
        </div>
    </div>

<script>
    setTimeout(() => {
        renderFormComment(`pi-commentPanelControl_@dept`,`@dept`,`pi`);
        // commentModule ('pi' , '@dept', null);
    },1);
</script>


@using JogetMVC.Model
@{
    string dept = "PM";
    long quotationId = Convert.ToInt64(ViewData["Id"]); string quotationGuid = ViewData["Guid"].ToString();
}

<style>
    .dx-tabpanel .dx-tabpanel-tabs .dx-tab {
        width: auto;
        padding-left: 18px;
        padding-right: 18px;
    }
</style>
<div style="margin-top:10px;font-weight:800;font-size:12px;">PA Process</div>
<div id="gridPA_@quotationId"></div>

<div id="@PIViewIdHelper.Form(dept, quotationId)">
</div>
<script type="text/javascript">
        var that = new Object();
    that.ModelName = "PolicyIssuance";
    $(`#@PIViewIdHelper.Form(dept, quotationId)`).dxForm({
        dataSource: makeBasicDataSource(that, true),
         items: [
             { itemType: "group" , dataField: "decision",items :[
        {
            dataField: "decision",
            label: { text: "Decision" },
            editorType: "dxRadioGroup",
            editorOptions: {
                items: [
                    { id: "AC_@PIViewIdHelper.Decision(dept, quotationId)" , text: "Accept", value: true },
                    // { id: "AS_@PIViewIdHelper.Decision(dept, quotationId)" , text: "Assign", value: false },
                    { id: "RJ_@PIViewIdHelper.Decision(dept, quotationId)" , text: "Reject", value: false }
                ],
                 displayExpr: "text",
                 valueExpr: "id",
                 layout: "horizontal",
                 itemTemplate: function(itemData, _, itemElement) {
                 setTimeout(() => {
                  var formItems = $(`#@PIViewIdHelper.Form(dept, quotationId)`).dxForm("instance")?.option("formData") || {};
                  var tatObject = tryParseJSON(formItems.turnAroundTimeAttributes, "TAT Load Button Problem");
                  if (tatObject) if (tatObject[`@dept`]?.AcceptDate)
                  {
                    $(`#AC_@PIViewIdHelper.Decision(dept, quotationId)`).addClass("btn-info");
                    $(`#${itemData.id}`).dxButton("instance").option("disabled", true);
                    if (itemData.id === "RJ_@PIViewIdHelper.Decision(dept, quotationId)" ) $(`#RJ_@PIViewIdHelper.Decision(dept, quotationId)`).dxButton("instance").option("disabled", false);
                  }
                 },_delayRenderDecisionButton);

                 $(`<div id='${itemData.id}'>`).dxButton({
                 text: itemData.text,
                 width: "100%",
                 height: "100%",
                 onClick: function (e){
                    if (_ == 0)
                 {
                      var formItems = $(`#@QTViewIdHelper.Form(dept, quotationId)`).dxForm("instance")?.option("formData") || {};
                       var tatObject = tryParseJSON(formItems.turnAroundTimeAttributes, "TAT Button Problem");
                      tatObject[`@dept`].AcceptDate = formatDateToString(new Date()).gmt7;
                      formItems.turnAroundTimeAttributes = JSON.stringify(tatObject);
                      var passingObject = new Object();
                      passingObject.statusName = "@dept Process"; // base on Dept
                      passingObject.Comment = `PolicyIssuance ${formItems.quotationCode} accepted by ${_displayName}!`;  // base on Dept
                      passingObject.formItems = formItems;
                      passingObject.dept = `@dept`;
                      passingObject.url = '/api/PolicyIssuance/UpdateData';
                      passingObject.urlLog = `/api/PolicyIssuance/LogAction`;
                      passingObject.schemeName = `PolicyIssuance`;
                      acceptDecision(passingObject);
                 }
                 if (_ == 1)
                 {
                      var formItems = $(`#@QTViewIdHelper.Form(dept, quotationId)`).dxForm("instance")?.option("formData") || {};
                      var tatObject = tryParseJSON(formItems.turnAroundTimeAttributes, "TAT Button Problem");
                      tatObject[`@dept`].AcceptDate = "";
                      formItems.turnAroundTimeAttributes = JSON.stringify(tatObject);
                      var passingObject = new Object();
                      passingObject.statusName = "@dept Pending"; // base on Dept
                      passingObject.Comment = `PolicyIssuance ${formItems.quotationCode} rejected by ${_displayName}!`;  // base on Dept
                      passingObject.formItems = formItems;
                      passingObject.dept = `@dept`;
                      passingObject.url = '/api/PolicyIssuance/UpdateData';
                      passingObject.urlLog = `/api/PolicyIssuance/LogAction`;
                      passingObject.schemeName = `PolicyIssuance`;
                      rejectDecision(passingObject);
                 }
                 }
                 }).appendTo(itemElement);
              itemElement
            },
            isRequired: true
            }
        }
             ]},

                         {itemType: "group", caption: "Attachment",colCount: 1, items: attachmentDefault("pi","@(dept)",@(quotationId), "@(quotationGuid)") },
                         {itemType: "group",caption: "Checklist",colCount:1,items: [
    {dataField: "policyNoCL",editorType: "dxCheckBox",visible:true},
    {dataField: "theInsured",editorType: "dxCheckBox",visible:true},
    {dataField: "occupation",editorType: "dxCheckBox",visible:true},
    {dataField: "occupationFCICode",editorType: "dxCheckBox",visible:true},
    {dataField: "riskGrading",editorType: "dxCheckBox",visible:true},
    {dataField: "pOI",editorType: "dxCheckBox",visible:true},
    {dataField: "tSI",editorType: "dxCheckBox",visible:true},
    {dataField: "premium",editorType: "dxCheckBox",visible:true},
    {dataField: "deductible",editorType: "dxCheckBox",visible:true},
    {dataField: "tnCs",editorType: "dxCheckBox",visible:true},
    {dataField: "occupationCode",editorType: "dxCheckBox",visible:true},
    {dataField: "premiumRate",editorType: "dxCheckBox",visible:true}
    ]},
    ]

       });
       var additionOptions = new Object();
        additionOptions.refKey = 1;

        var gridOptions = new PolicyIssuanceSubDetailsGridOption("PolicyIssuanceSubDetails", "User",additionOptions);
        var grid = new MGrid(null, $("#gridPA_@quotationId"), gridOptions, null);
        grid.component.option("height", 100);
        grid.component.option("width", "100%");
          
          //       $("#gridPA").dxDataGrid("instance").option("editing", {
          //   mode:"cell", allowUpdating: !roTS, allowAdding: !roTS, allowDeleting: !roTS
          // });
           viewFieldAdjust("@PIViewIdHelper.Form(dept, quotationId)");
</script>

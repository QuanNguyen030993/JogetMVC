@using JogetMVC.Model
@{
    string dept = "PM";
    long policyIssuanceId = Convert.ToInt64(ViewData["Id"]);
    string quotationGuid = ViewData["Guid"].ToString();
    long cloneId = Convert.ToInt64(ViewData["CloneId"]);
    string cloneQuotationGuid = ViewData["CopyFromGuid"].ToString();
}

<style>
    .dx-tabpanel .dx-tabpanel-tabs .dx-tab {
        width: auto;
        padding-left: 18px;
        padding-right: 18px;
    }

    .pm-checklist-html {
        white-space: normal;
        overflow-wrap: anywhere;
    }

    .pm-checklist-html p {
        margin: 0 0 6px;
    }

    .pm-checklist-html p:last-child {
        margin-bottom: 0;
    }

    .pm-checklist-html ul,
    .pm-checklist-html ol {
        margin: 0;
        padding-left: 22px;
    }
</style>
<div id="gridPA_@policyIssuanceId"></div>

<div id="@PIViewIdHelper.Form(dept, policyIssuanceId)">
</div>
<script type="text/javascript">
    $(function() {

    var thisObject = new Object();
    thisObject.ModelName = "PolicyIssuance";
    thisObject.formId = `@PIViewIdHelper.Form(dept, policyIssuanceId)`;
        thisObject.dept = "@dept";
        thisObject.prefix = "pi";


    var thisObjectDetails = new Object();
    thisObjectDetails.ModelName = "PolicyIssuanceChecklist";
    thisObjectDetails.refField = "PolicyIssuanceId";
    thisObjectDetails.refKey = @policyIssuanceId;
    var policyIssuanceChecklistDataSource = makeBasicDataSource(thisObjectDetails, false);
    var sectionId = "@(ViewData["Cd"])";


    //    var that = new Object();
    // that.ModelName = "PolicyIssuance";
    // that.moduleName = "default";
    // that.editorType = "dxFileUploader"
    // that.id = @(cloneId);
    // that.guid ="@(cloneQuotationGuid)";
    // that.sectionName = "@(dept)";
    // that.titleName = "Upload Quotation";
    // that.uploaderAllow = false;
     var sectionId = "@ViewData["Cd"]";
    var sectionIdQt = "qt-body_@(dept)_";

    var that2 = new Object();
    that2.ModelName = "PolicyIssuance";
    that2.moduleName = "supportingDoc";
    that2.editorType = "dxFileUploader"
    that2.id = @(cloneId);
    that2.guid = "@(cloneQuotationGuid)";
    that2.sectionName = "@(dept)";
    that2.titleName = "Upload Supporting Document";
    that2.uploaderAllow = _role == "@dept";
    that2.data = { SectionName: `${sectionIdQt}_${that2.moduleName}_@(cloneId)`, Department: "@(dept)", FieldName: that2.moduleName, FormId: "@(QTViewIdHelper.Form(dept, cloneId))" }; //{"SectionName":"default_FO_410"}

    var that3 = new Object();
    that3.ModelName = "PolicyIssuance";
    that3.moduleName = "defaultDoc";
    that3.editorType = "dxFileUploader"
    that3.id = @(policyIssuanceId);
    that3.guid = "@(quotationGuid)";
    that3.cloneId = @cloneId;
    that3.cloneGuid = "@(cloneQuotationGuid)";
    that3.sectionName = "@(dept)";
    that3.titleName = "Upload Document";
    that3.uploaderAllow = _role == "@dept";
    that3.data = { SectionName: `${sectionId}_${that3.moduleName}_@(policyIssuanceId)`, Department: "@(dept)", FieldName: that3.moduleName, FormId: "@(PIViewIdHelper.Form(dept, policyIssuanceId))" }; //{"SectionName":"default_FO_410"}
    var acceptButtonId = `AC_@QTViewIdHelper.Decision(dept, policyIssuanceId)`;
    var acceptStatusId = `Status_@PIViewIdHelper.Decision(dept, policyIssuanceId)`;
    var itemsDelay = [acceptButtonId, acceptStatusId];



    var mainFields =       [ {itemType: "group", caption: "Attachment",colCount: 1, items: attachmentDefaultPi(null,that2,that3)  },
                         {itemType: "group",caption: "Checklist",colCount:1,items: [
                    {
                        itemType: "simple",
                        template: function () {
                            return $("<div id='pi_checkList_@policyIssuanceId'>").dxDataGrid({
                                dataSource: policyIssuanceChecklistDataSource,

                                paging: {
                                    enabled: false
                                },
                                pager: {
                                    visible: false
                                },

                                editing: {
                                    mode: "cell",
                                    allowUpdating: true
                                },

                                columnAutoWidth: true,
                                wordWrapEnabled: true,

                                showBorders: true,
                                columns: [
                                    {
                                        dataField: "sequenceNo",
                                        caption: "No.",
                                        dataType: "number",
                                        width: 80,
                                        allowEditing: false
                                    },
                                    {
                                        dataField: "pmCheck",
                                        caption: "PM Check",
                                        dataType: "boolean",
                                        width: 110,
                                        setCellValue: function (newData, value) {
                                            newData.pmCheck = !!value;
                                            newData.result = value ? "checked" : "review";
                                        }
                                    },
                                    {
                                        dataField: "checkpoint",
                                        caption: "Checkpoint",
                                        minWidth: 180,
                                        allowEditing: false
                                    },
                                    {
                                        dataField: "needToCheck",
                                        caption: "Need To Check",
                                        minWidth: 280,
                                        allowEditing: false,
                                        cellTemplate: function (container, options) {
                                            $("<div>")
                                                .addClass("pm-checklist-html")
                                                .html(options.value || "")
                                                .appendTo(container);
                                        }
                                    },
                                    {
                                        dataField: "result",
                                        caption: "Result",
                                        dataType: "string",
                                        width: 100,
                                        allowEditing: false,
                                        calculateCellValue: function (rowData) {
                                            return rowData.pmCheck ? "checked" : "review";
                                        }
                                    }
                                ]
                            });
                        }
                    }
                    ]}
                    ,{ itemType: "group" , caption: "PA Process",items :[
                    {
                        editorType: "simple"
                        , template: function (data, itemElement) {
                            var additionOptions = new Object();
                            additionOptions.refKey = 1;
                            var gridOptions = new PolicyIssuanceSubDetailsGridOption("PolicyIssuanceSubDetails", "User", additionOptions);
                            new MGrid(null, itemElement, gridOptions, null);
                                // grid.component.option("width", "100%");
                                // grid.appendTo(itemElement);

                                // $("#gridPA_@policyIssuanceId").dxDataGrid("instance").option("editing", {
                                // mode:"cell", allowUpdating: !roTS, allowAdding: !roTS, allowDeleting: !roTS
                                // });

                        }

                    }
               ]}];
    // var acceptButtonId = `AC_@PIViewIdHelper.Decision(dept, policyIssuanceId)`;
    //         var acceptStatusId = `Status_@PIViewIdHelper.Decision(dept, policyIssuanceId)`;
    //     var declinedButtonId = `DC_@PIViewIdHelper.Decision(dept, policyIssuanceId)`;
    //         var declinedStatusId = `DC_Status_@PIViewIdHelper.Decision(dept, policyIssuanceId)`;
    //                     var items = [ `#${acceptButtonId}`, `#${declinedButtonId}`];
    //                                 var itemsDelay = [ acceptButtonId , acceptStatusId, declinedButtonId, declinedStatusId,'', ''];

    $.ajax({
        url: `/api/PolicyIssuance/GetSingle/@policyIssuanceId`,
        method: "GET"
    }).done(function (formData) {
        $(`#@PIViewIdHelper.Form(dept, policyIssuanceId)`).dxForm({
            formData: formData || {},
            items: [
                {
                    itemType: "group",
                    name: "decision@(dept)Group",
                    cssClass: "workflow-decision-group pi-decision-group-@(dept)",
                    elementAttr: {
                        id: "pi-decision-group-@(dept)-@(policyIssuanceId)",
                        "data-form-group-name": "decision@(dept)Group",
                        "data-route-dept": "@dept"
                    },
                    caption: "@dept Review",
                    colCount: 2,
                    items: [
                        decisionField(
                            `@PIViewIdHelper.Form(dept, policyIssuanceId)`,
                            "@dept",
                            `AC_@PIViewIdHelper.Decision(dept, policyIssuanceId)`,
                            `Status_@PIViewIdHelper.Decision(dept, policyIssuanceId)`,
                            null,
                            null)
                    ]
                }
            ]
        });

        viewFieldAdjust("@PIViewIdHelper.Form(dept, policyIssuanceId)");

        // Decision/submit handlers depend on formData, so initialize them only
        // after the Policy Issuance record has been loaded and bound to dxForm.
        delayAcceptStatusV2(mainFields, thisObject, ...itemsDelay);

        setTimeout(() => {
            var picJson = formData?.pic || PIC_JSON || "{}";
            var picMap = parsePicMap(picJson);
            var picVal = picMap["@dept"] || "";
            var sectionId = `#pi-sec_@(dept)_@(policyIssuanceId)`;
            if (!picVal) {
                $(sectionId).find(".dept-upperbody, .dept-body, .dept-lowerbody, .dept-footer").hide();
            } else {
                $(sectionId).find(".dept-upperbody, .dept-body, .dept-lowerbody, .dept-footer").show();
            }
        }, 100);
    }).fail(function (xhr) {
        appErrorHandling(
            `Cannot load Policy Issuance @policyIssuanceId before rendering PM decision buttons.`,
            xhr);
    });

    })
</script>

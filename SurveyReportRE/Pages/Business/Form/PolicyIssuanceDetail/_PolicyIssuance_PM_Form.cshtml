@using JogetMVC.Model
@{
    string dept = "PM";
    long policyIssuanceId = Convert.ToInt64(ViewData["Id"]);
    string quotationGuid = ViewData["Guid"].ToString();
    long cloneId = Convert.ToInt64(ViewData["CloneId"]);
    string cloneQuotationGuid = ViewData["CopyFromGuid"].ToString();
}

<style>
    .dx-tabpanel .dx-tabpanel-tabs .dx-tab {
        width: auto;
        padding-left: 18px;
        padding-right: 18px;
    }

    .pm-checklist-html {
        white-space: normal;
        overflow-wrap: anywhere;
    }

    .pm-checklist-html p {
        margin: 0 0 6px;
    }

    .pm-checklist-html p:last-child {
        margin-bottom: 0;
    }

    .pm-checklist-html ul,
    .pm-checklist-html ol {
        margin: 0;
        padding-left: 22px;
    }

    .pi-pm-pa-process-group .pi-pm-pa-process-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        width: 100%;
        padding: 8px 10px;
        border: 1px solid var(--theme-border, #dbe3ef);
        border-radius: 8px;
        background: var(--theme-surface, #fff);
        box-sizing: border-box;
    }

    .pi-pm-pa-process-copy {
        min-width: 0;
    }

    .pi-pm-pa-process-copy strong,
    .pi-pm-pa-process-copy span {
        display: block;
    }

    .pi-pm-pa-process-copy span {
        margin-top: 2px;
        color: var(--theme-muted, #64748b);
        font-size: 11px;
    }
</style>
<div id="@PIViewIdHelper.Form(dept, policyIssuanceId)">
</div>
<script type="text/javascript">
    $(async function() {
    const initialFormData = await window.OverviewDataBootstrap.getFormData({
        moduleCode: viewIdModulePrefix.policyIssuance,
        id: @policyIssuanceId,
        department: "@dept"
    }).catch(function (error) {
        console.warn("Policy Issuance PM initial data is unavailable; form binding will continue from the overview.", error);
        return null;
    });

    var thisObject = new Object();
    thisObject.ModelName = "PolicyIssuance";
    thisObject.formId = `@PIViewIdHelper.Form(dept, policyIssuanceId)`;
        thisObject.dept = "@dept";
        thisObject.prefix = viewIdModulePrefix.policyIssuance;
        thisObject.id = @policyIssuanceId;
        thisObject.record = initialFormData;


    var thisObjectDetails = new Object();
    thisObjectDetails.ModelName = "PolicyIssuanceChecklist";
    thisObjectDetails.refField = "PolicyIssuanceId";
    thisObjectDetails.refKey = @policyIssuanceId;
    var policyIssuanceChecklistDataSource = makeBasicDataSource(thisObjectDetails, false);
    var sectionId = "@(ViewData["Cd"])";


    //    var that = new Object();
    // that.ModelName = "PolicyIssuance";
    // that.moduleName = "default";
    // that.editorType = "dxFileUploader"
    // that.id = @(cloneId);
    // that.guid ="@(cloneQuotationGuid)";
    // that.sectionName = "@(dept)";
    // that.titleName = "Upload Quotation";
    // that.uploaderAllow = false;
     var sectionId = "@ViewData["Cd"]";
    var sectionIdQt = `${viewIdModulePrefix.quotation}-body_@(dept)_`;

    // var that2 = new Object();
    // that2.ModelName = "PolicyIssuance";
    // that2.moduleName = "supportingDoc";
    // that2.editorType = "dxFileUploader"
    // that2.id = @(cloneId);
    // that2.guid = "@(cloneQuotationGuid)";
    // that2.sectionName = "@(dept)";
    // that2.titleName = "Upload Supporting Document";
    // role enable/disable restored code: that2.uploaderAllow = _role == "@dept";
    // that2.data = { SectionName: window.IdManager.attachmentSectionKey(sectionIdQt, that2.moduleName, @(cloneId)), Department: "@(dept)", FieldName: that2.moduleName, FormId: "@(QTViewIdHelper.Form(dept, cloneId))" }; //{"SectionName":"default_FO_410"}

    var that3 = new Object();
    that3.ModelName = "PolicyIssuance";
    that3.moduleName = "defaultDoc";
    that3.editorType = "dxFileUploader"
    that3.id = @(policyIssuanceId);
    that3.guid = "@(quotationGuid)";
    that3.cloneId = @cloneId;
    that3.cloneGuid = "@(cloneQuotationGuid)";
    that3.sectionName = "@(dept)";
    that3.titleName = "Upload Document";
    /* role enable/disable restored code: that3.uploaderAllow = _role == "@dept"; */
    that3.uploaderAllow = false;
    that3.data = { SectionName: window.IdManager.attachmentSectionKey(sectionId, that3.moduleName, @(policyIssuanceId)), Department: "@(dept)", FieldName: that3.moduleName, FormId: "@(PIViewIdHelper.Form(dept, policyIssuanceId))" }; //{"SectionName":"default_FO_410"}
    // Keep the delayed lookup on the exact same PI id rendered by decisionField.
    // Using QTViewIdHelper here made getDelayAcceptButtonId resolve a non-existing id.
    var acceptButtonId = `AC_@PIViewIdHelper.Decision(dept, policyIssuanceId)`;
    var panelStatusId = `Status_@PIViewIdHelper.Decision(dept, policyIssuanceId)`;
    var itemsDelay = [acceptButtonId, panelStatusId];



    var mainFields =       [ {itemType: "group", caption: "Attachment",colCount: 1, items: attachmentDefaultPi(null,null,that3)  },
                         {itemType: "group",caption: "Checklist",colCount:1,items: [
                    {
                        itemType: "simple",
                        template: function () {
                            return $("<div id='@(PIViewIdHelper.Prefix)_checkList_@policyIssuanceId'>").dxDataGrid({
                                dataSource: policyIssuanceChecklistDataSource,

                                paging: {
                                    enabled: false
                                },
                                pager: {
                                    visible: false
                                },

                                editing: {
                                    mode: "cell",
                                    allowUpdating: true
                                },

                                columnAutoWidth: true,
                                wordWrapEnabled: true,

                                showBorders: true,
                                columns: [
                                    {
                                        dataField: "sequenceNo",
                                        caption: "No.",
                                        dataType: "number",
                                        width: 80,
                                        allowEditing: false
                                    },
                                    {
                                        dataField: "pmCheck",
                                        caption: "PM Check",
                                        dataType: "boolean",
                                        width: 110,
                                        setCellValue: function (newData, value) {
                                            newData.pmCheck = !!value;
                                            newData.result = value ? "checked" : "review";
                                        }
                                    },
                                    {
                                        dataField: "checkpoint",
                                        caption: "Checkpoint",
                                        minWidth: 180,
                                        allowEditing: false
                                    },
                                    {
                                        dataField: "needToCheck",
                                        caption: "Need To Check",
                                        minWidth: 280,
                                        allowEditing: false,
                                        cellTemplate: function (container, options) {
                                            $("<div>")
                                                .addClass("pm-checklist-html")
                                                .html(options.value || "")
                                                .appendTo(container);
                                        }
                                    },
                                    {
                                        dataField: "result",
                                        caption: "Result",
                                        dataType: "string",
                                        width: 100,
                                        allowEditing: false,
                                        calculateCellValue: function (rowData) {
                                            return rowData.pmCheck ? "checked" : "review";
                                        }
                                    }
                                ]
                            });
                        }
                    }
                    ]}
                    ,{
                    itemType: "group",
                    name: "paProcessGroup",
                    cssClass: "pi-pm-pa-process-group",
                    caption: "PA Process",
                    colCount: 1,
                    items: [
                    {
                        itemType: "simple",
                        label: { visible: false },
                        template: function () {
                            var $buttonHost = $("<div class='pa-process-launcher'>").dxButton({
                                text: "Open PA Process",
                                icon: "list",
                                stylingMode: "outlined",
                                onClick: function () {
                                    openPaProcessPopup({
                                        key: "policy-issuance-@policyIssuanceId",
                                        title: "PA Process · Policy Issuance @policyIssuanceId",
                                        createContent: function (gridHost) {
                                            var additionOptions = new Object();
                                            additionOptions.refField = "PolicyIssuanceId";
                                            additionOptions.refKey = @policyIssuanceId;
                                            additionOptions.height = "100%";
                                            additionOptions.overrideGetUrl = "/api/PolicyIssuanceSubDetails/GetPaProcess/PolicyIssuance/@policyIssuanceId";
                                            additionOptions.gridEditorOptions = {
                                                editing: {
                                                    mode: "row",
                                                    allowUpdating: true,
                                                    allowAdding: true,
                                                    allowDeleting: true,
                                                    selectTextOnEditStart: true,
                                                    startEditAction: "click"
                                                }
                                            };
                                            var gridOptions = new PolicyIssuanceSubDetailsGridOption(
                                                "PolicyIssuanceSubDetails",
                                                "User",
                                                additionOptions
                                            );
                                            new MGrid(null, gridHost, gridOptions, null);
                                        }
                                    });
                                }
                            });

                            return $("<div class='pi-pm-pa-process-row'></div>").append(
                                $("<div class='pi-pm-pa-process-copy'></div>").append(
                                    $("<strong></strong>").text("PA Process"),
                                    $("<span></span>").text("Review and maintain PA process details for this policy issuance.")
                                ),
                                $buttonHost
                            );
                        }
                    }
               ]}];
    // var acceptButtonId = `AC_@PIViewIdHelper.Decision(dept, policyIssuanceId)`;
    //         var panelStatusId = `Status_@PIViewIdHelper.Decision(dept, policyIssuanceId)`;
    //     var declinedButtonId = `DC_@PIViewIdHelper.Decision(dept, policyIssuanceId)`;
    //         var declinedStatusId = `DC_Status_@PIViewIdHelper.Decision(dept, policyIssuanceId)`;
    //                     var items = [ `#${acceptButtonId}`, `#${declinedButtonId}`];
    //                                 var itemsDelay = [ acceptButtonId , panelStatusId, declinedButtonId, declinedStatusId,'', ''];

        $(`#@PIViewIdHelper.Form(dept, policyIssuanceId)`).dxForm({
            formData: initialFormData || {},
            items: [
                {
                    itemType: "group",
                    name: "decision@(dept)Group",
                    cssClass: "workflow-decision-group pi-decision-group-@(dept)",
                    elementAttr: {
                        id: "@(PIViewIdHelper.Prefix)-decision-group-@(dept)-@(policyIssuanceId)",
                        "data-form-group-name": "decision@(dept)Group",
                        "data-route-dept": "@dept"
                    },
                    caption: "@dept Review",
                    colCount: 2,
                    items: [
                        decisionField(
                            `@PIViewIdHelper.Form(dept, policyIssuanceId)`,
                            "@dept",
                            `AC_@PIViewIdHelper.Decision(dept, policyIssuanceId)`,
                            `Status_@PIViewIdHelper.Decision(dept, policyIssuanceId)`,
                            null,
                            null)
                    ]
                }
            ]
        });

        viewFieldAdjust("@PIViewIdHelper.Form(dept, policyIssuanceId)" , ["PA Process"]);

        // Decision/submit handlers depend on formData, so initialize them only
        // after the Policy Issuance record has been loaded and bound to dxForm.
        // role enable/disable restored code: delayAcceptStatusV2(mainFields, thisObject, ...itemsDelay);
        delayAcceptStatusV2Promise(mainFields, thisObject, ...itemsDelay)
            .catch(function (error) {
                console.error("Policy Issuance PM decision hydration failed.", error);
            });

    })
</script>

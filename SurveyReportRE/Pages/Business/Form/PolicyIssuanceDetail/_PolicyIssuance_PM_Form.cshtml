@using JogetMVC.Model
@{
    string dept = "PM";
    long policyIssuanceId = Convert.ToInt64(ViewData["Id"]);
    string quotationGuid = ViewData["Guid"].ToString();
    long cloneId = Convert.ToInt64(ViewData["CloneId"]);
    string cloneQuotationGuid = ViewData["CopyFromGuid"].ToString();
}

<style>
    .dx-tabpanel .dx-tabpanel-tabs .dx-tab {
        width: auto;
        padding-left: 18px;
        padding-right: 18px;
    }
</style>
<div id="gridPA_@policyIssuanceId"></div>

<div id="@PIViewIdHelper.Form(dept, policyIssuanceId)">
</div>
<script type="text/javascript">
    $(function() {

    var thisObject = new Object();
    thisObject.ModelName = "PolicyIssuance";
    var thisObjectDetails = new Object();
    thisObjectDetails.ModelName = "PolicyIssuanceCheckList";
    thisObjectDetails.refField = "PolicyIssuanceId";
    thisObjectDetails.refKey = @policyIssuanceId;
    var detailsDataSourceCL = makeBasicDataSource(thisObjectDetails, false);
    var sectionId = "@(ViewData["Cd"])";

    var dataSourceGridCL = [
        { field: "policyNoCL", label: "policyNoCL", checked: false, type: "checkbox" },
    { field: "theInsured", label: "theInsured", checked: false, type: "checkbox" },
    { field: "occupation", label: "occupation", checked: false, type: "checkbox" },
    { field: "occupationFCICode", label: "occupationFCICode", checked: false, type: "checkbox" },
    { field: "riskGrading", label: "riskGrading", checked: false, type: "checkbox" },
    { field: "pOI", label: "pOI", checked: false, type: "checkbox" },
    { field: "tSI", label: "tSI", checked: false, type: "checkbox" },
    { field: "premium", label: "premium", checked: false, type: "checkbox" },
    { field: "deductible", label: "deductible", checked: false, type: "checkbox" },
    { field: "tnCs", label: "tnCs", checked: false, type: "checkbox" },
    { field: "occupationCode", label: "occupationCode", checked: false, type: "checkbox" },
    { field: "premiumRate", label: "premiumRate", checked: false, type: "checkbox" }

    ];


    //    var that = new Object();
    // that.ModelName = "PolicyIssuance";
    // that.moduleName = "default";
    // that.editorType = "dxFileUploader"
    // that.id = @(cloneId);
    // that.guid ="@(cloneQuotationGuid)";
    // that.sectionName = "@(dept)";
    // that.titleName = "Upload Quotation";
    // that.uploaderAllow = false;
     var sectionId = "@ViewData["Cd"]";
    var sectionIdQt = "qt-body_@(dept)_";

    var that2 = new Object();
    that2.ModelName = "PolicyIssuance";
    that2.moduleName = "supportingDoc";
    that2.editorType = "dxFileUploader"
    that2.id = @(cloneId);
    that2.guid = "@(cloneQuotationGuid)";
    that2.sectionName = "@(dept)";
    that2.titleName = "Upload Supporting Document";
    that2.uploaderAllow = _role == "@dept";
    that2.data = { SectionName: `${sectionIdQt}_${that2.moduleName}_@(cloneId)`, Department: "@(dept)", FieldName: that2.moduleName, FormId: "@(QTViewIdHelper.Form(dept, cloneId))" }; //{"SectionName":"default_FO_410"}

    var that3 = new Object();
    that3.ModelName = "PolicyIssuance";
    that3.moduleName = "defaultDoc";
    that3.editorType = "dxFileUploader"
    that3.id = @(policyIssuanceId);
    that3.guid = "@(quotationGuid)";
    that3.cloneId = @cloneId;
    that3.cloneGuid = "@(cloneQuotationGuid)";
    that3.sectionName = "@(dept)";
    that3.titleName = "Upload Document";
    that3.uploaderAllow = _role == "@dept";
    that3.data = { SectionName: `${sectionId}_${that3.moduleName}_@(policyIssuanceId)`, Department: "@(dept)", FieldName: that3.moduleName, FormId: "@(PIViewIdHelper.Form(dept, policyIssuanceId))" }; //{"SectionName":"default_FO_410"}
    $(`#@PIViewIdHelper.Form(dept, policyIssuanceId)`).dxForm({
        dataSource: makeBasicDataSource(that2, true),
         items: [
               
             { itemType: "group" , caption: "Decision", colCount: 2, items :[
        {
            dataField: "decision",
            label: { text: "Decision" },
            itemType: "simple",
            template: function (data, itemElement) {
                var acceptButtonId = `AC_@PIViewIdHelper.Decision(dept, policyIssuanceId)`;
                var acceptStatusId = `AC_Status_@PIViewIdHelper.Decision(dept, policyIssuanceId)`;
                var rejectButtonId = `RJ_@PIViewIdHelper.Decision(dept, policyIssuanceId)`;

                var formItems = data.component.option("formData") || {};
                var tatObject = tryParseJSON(formItems.turnAroundTimeAttributes, "TAT Load Button Problem");
                var hasAccepted = tatObject && tatObject[`@dept`]?.AcceptDate;

                // Render Accept Button
                var $acceptButton = $(`<div id='${acceptButtonId}' style='display: inline-block;'>`).dxButton({
                    text: "Accept",
                    icon: "check",
                    type: "success",
                    disabled: !!hasAccepted,
                    onClick: function (e) {
                        var currentFormItems = data.component.option("formData") || {};
                        var currentTatObject = tryParseJSON(currentFormItems.turnAroundTimeAttributes, "TAT Button Problem");
                        currentTatObject[`@dept`].AcceptDate = formatDateToString(new Date()).gmt7;
                        currentFormItems.turnAroundTimeAttributes = JSON.stringify(currentTatObject);
                        var passingObject = new Object();
                        passingObject.statusName = "@dept Process"; // base on Dept
                        passingObject.Comment = `PolicyIssuance ${currentFormItems.quotationCode} accepted by ${_displayName}!`;  // base on Dept
                        passingObject.formItems = currentFormItems;
                        passingObject.dept = `@dept`;
                        passingObject.url = '/api/PolicyIssuance/UpdateData';
                        passingObject.urlLog = `/api/PolicyIssuance/LogAction`;
                        passingObject.schemeName = `PolicyIssuance`;
                        acceptDecision(passingObject);
                    }
                }).appendTo(itemElement);
                $acceptButton.find(".dx-button").css({
                    backgroundColor: hasAccepted ? window.DecisionColors.accepted : window.DecisionColors.accept,
                    color: window.DecisionColors.textOnColor
                });

                // Render Reject Button
                var $rejectButton = $(`<div id='${rejectButtonId}' style='display: inline-block; margin-left: 10px;'>`).dxButton({
                    text: "Reject",
                    icon: "close",
                    type: "danger",
                    disabled: !hasAccepted,
                    onClick: function (e) {
                        var currentFormItems = data.component.option("formData") || {};
                        var currentTatObject = tryParseJSON(currentFormItems.turnAroundTimeAttributes, "TAT Button Problem");
                        currentTatObject[`@dept`].AcceptDate = "";
                        currentFormItems.turnAroundTimeAttributes = JSON.stringify(currentTatObject);
                        var passingObject = new Object();
                        passingObject.statusName = "@dept Pending"; // base on Dept
                        passingObject.Comment = `PolicyIssuance ${currentFormItems.quotationCode} rejected by ${_displayName}!`;  // base on Dept
                        passingObject.formItems = currentFormItems;
                        passingObject.dept = `@dept`;
                        passingObject.url = '/api/PolicyIssuance/UpdateData';
                        passingObject.urlLog = `/api/PolicyIssuance/LogAction`;
                        passingObject.schemeName = `PolicyIssuance`;
                        rejectDecision(passingObject);
                    }
                }).appendTo(itemElement);
                $rejectButton.find(".dx-button").css({
                    backgroundColor: window.DecisionColors.reject,
                    color: window.DecisionColors.textOnColor
                });
                updateDelayAcceptStatus(acceptStatusId, acceptButtonId, hasAccepted);
            }
        }
             ]},

                         {itemType: "group", caption: "Attachment",colCount: 1, items: attachmentDefaultPi(null,that2,that3)  },
                         {itemType: "group",caption: "Checklist",colCount:1,items: [
                    // {dataField: "policyNoCL",editorType: "dxCheckBox",visible:true},
                    // {dataField: "theInsured",editorType: "dxCheckBox",visible:true},
                    // {dataField: "occupation",editorType: "dxCheckBox",visible:true},
                    // {dataField: "occupationFCICode",editorType: "dxCheckBox",visible:true},
                    // {dataField: "riskGrading",editorType: "dxCheckBox",visible:true},
                    // {dataField: "pOI",editorType: "dxCheckBox",visible:true},
                    // {dataField: "tSI",editorType: "dxCheckBox",visible:true},
                    // {dataField: "premium",editorType: "dxCheckBox",visible:true},
                    // {dataField: "deductible",editorType: "dxCheckBox",visible:true},
                    // {dataField: "tnCs",editorType: "dxCheckBox",visible:true},
                    // {dataField: "occupationCode",editorType: "dxCheckBox",visible:true},
                    // {dataField: "premiumRate",editorType: "dxCheckBox",visible:true}
                             
                    {
                        itemType: "simple",
                        template: function () {
                            return $("<div id='pi_checkList_@policyIssuanceId'>").dxDataGrid({
                                dataSource: dataSourceGridCL,
                                keyExpr: "field",

                                paging: {
                                    enabled: false
                                },
                                pager: {
                                    visible: false
                                },

                                editing: {
                                    mode: "cell",
                                    allowUpdating: true
                                },

                                columnAutoWidth: true,
                                wordWrapEnabled: true,

                                showBorders: true,
                                columns: [
                                    {
                                        dataField: "label",
                                        caption: "Content",
                                        allowEditing: false,
                                        width: 350
                                    },
                                    {
                                        dataField: "checked",
                                        caption: "Check",
                                        width: 100,
                                        dataType: "boolean"
                                    },
                                    {
                                        caption: "Value",
                                        cellTemplate: function (container, options) {
                                            const data = options.data;

                                            if (!data.checked) {
                                                container.text("");
                                                return;
                                            }

                                            let editor;

                                            switch (data.type) {
                                                case "number":
                                                    editor = $("<div>").dxNumberBox({ value: data.value });
                                                    break;
                                                case "text":
                                                    editor = $("<div>").dxTextBox({ value: data.value });
                                                    break;
                                                case "textarea":
                                                    editor = $("<div>").dxTextArea({ value: data.value, height: 80 });
                                                    break;
                                                case "select":
                                                    editor = $("<div>").dxSelectBox({ items: ["New", "Renewal", "Hold Cover", "Cover Note"] });
                                                    break;
                                                case "radio":
                                                    editor = $("<div>").dxRadioGroup({
                                                        displayExpr: "text",
                                                        valueExpr: "id",
                                                        layout: "horizontal", items: ["A", "B", "C", "D"]
                                                    });
                                                    break;
                                                case "checkbox":
                                                    var that = new Object();
                                                    that.ModelName = "PolicyIssuance";
                                                    that.moduleName = `pi_${data.field}`; //"pi field"
                                                    that.editorType = "dxFileUploader";
                                                    that.id = @(policyIssuanceId);
                                                    that.guid = "@(quotationGuid)";
                                                    that.sectionName = "@(dept)";
                                                    that.titleName = "Upload Document";
                                                    that.data = {};
                                                    editor = $("<div>");
                                                    createEditor(that, editor, $(`<div>`), that);
                                                    break;
                                                default:
                                                    editor = "";
                                            }

                                            container.append(editor);
                                        }
                                    }
                                ]
                            });
                        }
                    }
                    ]}
                    ,{ itemType: "group" , caption: "PA Process",items :[
                    {
                        dataField: "paProcess", editorType: "simple"
                        , template: function (data, itemElement) {
                            var additionOptions = new Object();
                            additionOptions.refKey = 1;
                            var gridOptions = new PolicyIssuanceSubDetailsGridOption("PolicyIssuanceSubDetails", "User", additionOptions);
                            new MGrid(null, itemElement, gridOptions, null);
                                // grid.component.option("width", "100%");
                                // grid.appendTo(itemElement);

                                // $("#gridPA_@policyIssuanceId").dxDataGrid("instance").option("editing", {
                                // mode:"cell", allowUpdating: !roTS, allowAdding: !roTS, allowDeleting: !roTS
                                // });

                        }

                    }
               ]}
                    ]

       });
       
           viewFieldAdjust("@PIViewIdHelper.Form(dept, policyIssuanceId)");

    detailsDataSourceCL.load().done(function (data) {
        if (!data || data.length === 0) return;

        const dbRow = data[0];

        dataSourceGridCL.forEach(item => {
            // bind checkbox
            item.checked = dbRow[item.field] ?? false;
            item.ownId = dbRow.id;
            // bind value (cho text/textarea/radio/select)
            item.value = dbRow[item.field];
        });

        // refresh grid
        $("#pi_checkList_@policyIssuanceId").dxDataGrid("instance").option("dataSource", dataSourceGridCL);
        $("#pi_checkList_@policyIssuanceId").dxDataGrid("instance").option("id", data.id);
    });

    setTimeout(() => {
        var picJson = PIC_JSON || "{}";
        var picMap = parsePicMap(picJson);
        var picVal = picMap["@dept"] || "";
        var sectionId = `#pi-sec_@(dept)_@(policyIssuanceId)`;
        if (!picVal) {
            $(sectionId).find(".dept-upperbody, .dept-body, .dept-lowerbody, .dept-footer").hide();
        } else {
            $(sectionId).find(".dept-upperbody, .dept-body, .dept-lowerbody, .dept-footer").show();
        }
    }, 100);

    })
</script>

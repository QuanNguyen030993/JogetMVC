@{
    string dept = "PM";

}


<div class="actionBarDept" id="actionBarDept_@dept">
    <div class="actionLeft">
        <span class="dept-title">Remarks</span> <div id="pi-remarkBox_@dept"></div>
    </div>
    <div class="actionRight">
        <div id="pi-btnSave_@dept"></div>
        <div id="pi-btnSubmitBranch_@dept"></div>
    </div>
</div>

<script>
     setTimeout( () => {
     var dept = "@dept";
             var pageLayout = window.PolicyIssuancePage;
       var stateLayout = pageLayout.state;
      var findRoute = stateLayout.nextStep.flowSteps.find(f => f.fromNodeId == dept  ); $("#pi-btnSubmitBranch_@dept").dxButton({ text: findRoute ? findRoute.displayStatus : "", icon: "check", type: "info", onClick: function (e) { var formItems = $(`#qt-form${dept}`).dxForm("instance")?.option("formData") || {}; submitNextStep("@dept", stateLayout.nextStep, findRoute, formItems); } });
     $("#pi-btnSave_@dept").dxButton({ text: "Save", icon: "save", type: "default", onClick:
         function (e) {
               var formItems = $(`#pi-form${dept}`).dxForm("instance")?.option("formData") || {};
               var globalLoadPanel = $("#loadingPopup").dxLoadPanel({
                   shadingColor: "rgba(0,0,0,0.4)",
                   visible: false,
                   showIndicator: true,
                   showPane: false,
                   shading: true,
                   closeOnOutsideClick: false,
                    position: { of: `#pi-form${dept}`}
                   // onShown: function () {
                   //     setTimeout(function () {
                   //         appLoadPanel.hide();
                   //     }, 3000);
                   // }
               });
              globalLoadPanel.dxLoadPanel("instance").show();

             ajaxPut('/api/PolicyIssuance/UpdateData',
             {
                 key: formItems.id,
                 values: JSON.stringify(
                     formItems
                 )
             },
             {
                 onSuccess: function (response) {
                 },
                 onError: function (err) { }
             }
         );
         }
     });
     }, _delayRenderSubmitButton);
</script>
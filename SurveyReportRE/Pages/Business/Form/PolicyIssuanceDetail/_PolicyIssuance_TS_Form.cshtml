@using JogetMVC.Model
@{
    string prefix = PIViewIdHelper.Prefix;
    string dept = "TS";
    long policyIssuanceId = Convert.ToInt64(ViewData["Id"]); 
    string quotationGuid = ViewData["Guid"].ToString();
    long cloneId = Convert.ToInt64(ViewData["CloneId"]); // Quotation
    string cloneQuotationGuid = ViewData["CopyFromGuid"].ToString();
}
<style>
    .dx-tabpanel .dx-tabpanel-tabs .dx-tab {
        width: auto;
        padding-left: 18px;
        padding-right: 18px;
    }

    .pi-ts-signback-group .pi-ts-signback-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        width: 100%;
        padding: 8px 10px;
        border: 1px solid var(--theme-border, #dbe3ef);
        border-radius: 8px;
        background: var(--theme-surface, #fff);
        box-sizing: border-box;
    }

    .pi-ts-signback-group .pi-ts-signback-copy {
        min-width: 0;
    }

    .pi-ts-signback-group .pi-ts-signback-copy strong,
    .pi-ts-signback-group .pi-ts-signback-copy span {
        display: block;
    }

    .pi-ts-signback-group .pi-ts-signback-copy span {
        margin-top: 2px;
        color: var(--theme-muted, #64748b);
        font-size: 11px;
    }
</style>
<script type="text/javascript">
    $(function() {
    var thisObject = new Object();
    thisObject.ModelName =  "PolicyIssuance";       
    thisObject.formId = `@PIViewIdHelper.Form(dept, policyIssuanceId)`;
    thisObject.dept = `@dept`;
    thisObject.prefix = `@prefix`;
    thisObject.schemeName = "PolicyIssuance";
    thisObject.decisionColSpan = 2;
    var thisObjectDetails = new Object();
    thisObjectDetails.ModelName =  "PolicyIssuanceDetails";
    thisObjectDetails.refField =  "PolicyIssuanceId";
    thisObjectDetails.refKey =  @policyIssuanceId;
    var detailsDataSource = makeBasicDataSource(thisObjectDetails, false);
    var sectionId = "@(ViewData["Cd"])";
   

    var dataSourceGrid = [
    { field: "confirmedQuotationFlag", label: "Confirmed Quotation (must for FCI, CCI)", checked: false, type: "checkbox" },
      { field: "emailMktClient", label: "Email MKT-Client", checked: false, type: "checkbox" },
      { field: "riClosings", label: "RI Closings", checked: false, type: "checkbox" },
      { field: "factoryOperationYears", label: "Operation year of Factories (*)", checked: false, type: "text" },
      { field: "newReplacementValue", label: "New replacement value / reinstatement value (*)", checked: false, type: "checkbox" },
      { field: "holdCoverType", label: "Hold Cover / Cover Note", checked: false, type: "checkbox" },
      { field: "resultAttachment", label: "RES (*)", checked: false, type: "checkbox" },
      { field: "declarationText", label: "Declaration", checked: false, type: "checkbox" },
      { field: "machineryList", label: "List of machineries including the depreciated values for each of item (*)", checked: false, type: "checkbox" },
      { field: "isBodApproved", label: "BoDs/UW's approved", checked: false, type: "checkbox" },
      { field: "uRFAttachment", label: "URF", checked: false, type: "checkbox" },
      { field: "emailInformRi", label: "Email inform RI for Endorsement", checked: false, type: "checkbox" },
      { field: "riScheme", label: "RI Scheme (New/RN)", checked: false, type: "checkbox" },
      { field: "proposalForm", label: "Proposal form (must for CCI)", checked: false, type: "checkbox" },
      { field: "propertyType", label: "Type of Property list (must for FCI)", checked: false, type: "radio" },
      { field: "sumInsuredBreakdown", label: "Breakdown SI for each location (must for FCI)", checked: false, type: "checkbox" },
      { field: "premiumBreakdown", label: "Premium Breakdown", checked: false, type: "checkbox" },
      { field: "reason", label: "In case of C or D, please state reason of not having List of Insured Properties and/or the ability (When) to collect this List", checked: false, type: "textarea" },
      { field: "chassisEngineNumber", label: "Chassis - Engine No. (*)", checked: false, type: "checkbox" },
      { field: "finalPremium", label: "Final Premium in Motor system = Premium in received final Quotation (*)", checked: false, type: "checkbox" },
      { field: "isKycChecked", label: "KYC Checked", checked: false, type: "checkbox" },
      { field: "others", label: "Others (Specify)", checked: false, type: "checkbox" },
      { field: "isGlobalCover", label: "Global", checked: false, type: "checkbox" },
      { field: "ichigenka", label: "Ichigenka", checked: false, type: "checkbox" }

    ];


    var sectionId = "@ViewData["Cd"]";
    var sectionIdQt = `${viewIdModulePrefix.quotation}-body_@(dept)_`;
    var that = null;
    // that.ModelName = "PolicyIssuance";
    // that.moduleName = "default";
    // that.editorType = "dxFileUploader"
    // that.id = @(cloneId);
    // that.guid = "@(cloneQuotationGuid)";
    // that.sectionName = "@(dept)";
    // that.titleName = "Upload Quotation";
    // that.isRenderUploader = false;
    // that.uploaderAllow = _role == "@dept";
    // that.data = { SectionName: `${sectionIdQt}_${that.moduleName}_@(cloneId)`, Department: "@(dept)", FieldName: that.moduleName, FormId: "@(QTViewIdHelper.Form(dept, cloneId))" }; //{"SectionName":"default_FO_410"}

    // var that2 = new Object();
    // that2.ModelName = "PolicyIssuance";
    // that2.moduleName = "supportingDoc";
    // that2.editorType = "dxFileUploader"
    // that2.id = @(cloneId);
    // that2.guid = "@(cloneQuotationGuid)";
    // that2.sectionName = "@(dept)";
    // that2.titleName = "Upload Supporting Document";
    // that2.uploaderAllow = _role == "@dept";
    // that2.data = { SectionName: window.IdManager.attachmentSectionKey(sectionIdQt, that2.moduleName, @(cloneId)), Department: "@(dept)", FieldName: that2.moduleName, FormId: "@(QTViewIdHelper.Form(dept, cloneId))" }; //{"SectionName":"default_FO_410"}

    var that3 = new Object();
    that3.ModelName = "PolicyIssuance";
    that3.moduleName = "defaultDoc";
    that3.editorType = "dxFileUploader"
    that3.id = @(policyIssuanceId);
    that3.guid ="@(quotationGuid)";
    that3.cloneId = @cloneId;
    that3.cloneGuid ="@(cloneQuotationGuid)";
    that3.sectionName = "@(dept)";
    that3.titleName = "Upload Document";
    that3.uploaderAllow = _role == "@dept";
    that3.data = { SectionName: window.IdManager.attachmentSectionKey(sectionId, that3.moduleName, @(policyIssuanceId)), Department: "@(dept)", FieldName: that3.moduleName, FormId: "@(PIViewIdHelper.Form(dept, policyIssuanceId))" }; //{"SectionName":"default_FO_410"}


    var  mainFields = [{
        itemType: "group",
        name: "fillListGroup",
        cssClass: "workflow-ui-lock-target-fillListGroup",
        elementAttr: { "data-form-group-name": "fillListGroup" },
        caption: "Fill List",
        visible: false,
        colCount: 1,
        items: [
     {
           itemType: "simple",
           template: function () {
             return $("<div id='@(PIViewIdHelper.Prefix)_fillList_@policyIssuanceId'>").dxDataGrid({
               dataSource: dataSourceGrid,
               keyExpr: "field",
                 paging: {
                            enabled: false
                          },
                          pager: {
                            visible: false
                          },
                          editing: {
                            mode: "cell",
                            allowUpdating: true
                          },

              columnAutoWidth: true,
              wordWrapEnabled: true,

               showBorders: true,
               columns: [
                 {
                   dataField: "label",
                   caption: "Content",
                   allowEditing: false,
                   width: 350
                 },
                 {
                   dataField: "checked",
                   caption: "Check",
                   width: 100,
                   dataType: "boolean"
                 },
                 {
                   caption: "Attachment",
                   cellTemplate: function (container, options) {
                     const data = options.data;

                     if (!data.checked) {
                       container.text("");
                       return;
                     }

                     let editor;

                     switch (data.type) {
                       case "number":
                         editor = $("<div>").dxNumberBox({ value: data.value });
                         break;
                       case "text":
                         editor = $("<div>").dxTextBox({ value: data.value });
                         break;
                       case "textarea":
                         editor = $("<div>").dxTextArea({ value: data.value, height: 80 });
                         break;
                       case "select":
                         editor = $("<div>").dxSelectBox({ items: ["New", "Renewal", "Hold Cover", "Cover Note"] });
                         break;
                       case "radio":
                         editor = $("<div>").dxRadioGroup({ displayExpr: "text",
                          valueExpr: "id",
                          layout: "horizontal",items: ["A", "B", "C", "D"]
                         });
                         break;
                       case "checkbox":
                         var that = new Object();
                         that.ModelName = "PolicyIssuance";
                         that.moduleName = `${viewIdModulePrefix.policyIssuance}_${data.field}`;
                         that.editorType = "dxFileUploader";
                         that.id = @(policyIssuanceId);
                         that.guid ="@(quotationGuid)";
                         that.sectionName = "@(dept)";
                         that.titleName = "Add file";
                         that.baseOnAttributes = "FieldName";
                         that.compactAttachment = true;
                         var sectionId = "@(ViewData["Cd"])";
                         that.data = { SectionName: window.IdManager.attachmentSectionKey(sectionId, data.field, @(policyIssuanceId)), Department: "@(dept)", FieldName: `${data.field}_@(policyIssuanceId)` }; //{"SectionName":"default_FO_410"}
                         editor = $("<div>");
                         createEditor(that, editor, $(`<div>`), that);
                         break;
                        default:
                         editor = "";
                     }

                     container.append(editor);
                   }
                 }
               ]
             });
           }
         }
     ]},
         { itemType: "group", caption: "Attachment", colCount: 1, items: attachmentDefaultPi(null,null,that3) }, //hiding for the backup requiment 2026-06-21
            { itemType: "group",caption: "Source Of Business",colCount:2,items: [
            { dataField: "policyPackage", label: { text: "Package Of Policy" } ,editorType: "dxSelectBox",visible:true, editorOptions: makeSelectBoxEditorOptions(_enums.PolicyPackage),displayExpr: "value"},
            { dataField: "languageOfPolicy", label: { text: "Language Of Policy" },editorType: "dxSelectBox",visible:true, editorOptions: makeSelectBoxEditorOptions(_enums.LanguageOfPolicy),displayExpr: "value"}
        ]},
        {
            itemType: "group",
            name: "signBackGroup",
            cssClass: "pi-ts-signback-group",
            elementAttr: { id: "@(PIViewIdHelper.Prefix)-signBackGroup_@(policyIssuanceId)" },
            caption: "Sign back",
            colCount: 1,
            items: [{
                itemType: "simple",
                label: { visible: false },
                template: function () {
                    const $buttonHost = $("<div id='piReminderButton_@(policyIssuanceId)' class='ts-reminder-button-host'></div>");
                    const $row = $("<div class='pi-ts-signback-row'></div>").append(
                        $("<div class='pi-ts-signback-copy'></div>").append(
                            $("<strong></strong>").text("Signed-back reminder"),
                            $("<span></span>").text("Schedule follow-up dates after the policy is sent for signing.")
                        ),
                        $buttonHost
                    );

                    setTimeout(function () {
                        if (typeof window["initializeTsReminderButton_@(policyIssuanceId)"] === "function") {
                            window["initializeTsReminderButton_@(policyIssuanceId)"]();
                        }
                    }, 0);

                    return $row;
                }
            }]
        }
     ]
     ;
   
    var acceptButtonId = `AC_@PIViewIdHelper.Decision(dept, policyIssuanceId)`;
    var panelStatusId = `Status_@PIViewIdHelper.Decision(dept, policyIssuanceId)`;
    // Keep the Policy Issuance TS decision on the same V2 lifecycle as
    // Quotation TS so the deferred renderer wires AcceptTask correctly.
    var acceptDecisionV2 = {
        buttonId: acceptButtonId,
        statusId: panelStatusId,
        text: "Accept",
        icon: "check",
        type: "success",
        buttonClass: "dx-button-success",
        disabled: true,
        useDefaultDecisionClick: true,
        acceptStatusField: "actionStatus",
        useTatAcceptStatus: true,
        tatStatusText: "Accepted",
        skipAcceptedMainFields: false,
        statusButtonDisabled: true
    };
    var itemsDelay = [acceptDecisionV2];

    $("#@PIViewIdHelper.Form(dept, policyIssuanceId)").dxForm({
        dataSource: makeBasicDataSource(thisObject, true),
       
         items: [
              {
                  itemType: "group",
                  name: "decision@(dept)Group",
                  cssClass: "workflow-decision-group pi-decision-group-@(dept)",
                  elementAttr: {
                      id: "@(PIViewIdHelper.Prefix)-decision-group-@(dept)-@(policyIssuanceId)",
                      "data-form-group-name": "decision@(dept)Group",
                      "data-route-dept": "@dept"
                  },
                  caption: "@dept Decision",
                  colCount: 2,
                  items: [
            workflowDecisionField(thisObject, ...itemsDelay)
        ]}

    // 🔷 1. Proposal & UW Input
   

         ]
       });
     viewFieldAdjust("@PIViewIdHelper.Form(dept, policyIssuanceId)");
          // Fetch attachments to check if there are files uploaded for each checklist item type
          const cloneQuotationGuid = "@(cloneQuotationGuid)";
          const quotationGuid = "@(quotationGuid)";
          const fetch1 = $.ajax({ url: `/api/Document/GetByKey?recordGuid=${cloneQuotationGuid}`, method: "GET" });
          const fetch2 = $.ajax({ url: `/api/Document/GetByKey?recordGuid=${quotationGuid}`, method: "GET" });
          $.when(fetch1, fetch2, detailsDataSource.load()).done(function (r1, r2, rDetails) {
              const docs = [...(r1[0] || []), ...(r2[0] || [])];
              const detailData = rDetails[0] || [];
              // if (!detailData || detailData.length === 0) return;
              // const dbRow = detailData[0];

              // Map files uploaded for each checklist item type
              const fileTypesWithFiles = {};
              docs.forEach(function (doc) {
                  var attrs = {};
                  try {
                      attrs = JSON.parse(doc.attributes || doc.Attributes || "{}");
                  } catch (e) {}
                  // if (attrs.FieldName && attrs.FieldName !== "default") {
                  //     fileTypesWithFiles[attrs.FieldName] = true;
                  // }
                    if (attrs.FieldName && attrs.FieldName !== "default") {
                           // fileTypesWithFiles[attrs.FieldName] = true;
                           const fieldName = attrs.FieldName.split("_")[0];
                           fileTypesWithFiles[fieldName] = true;
                       }

                       if (attrs.TSSectionName) {
                           fileTypesWithFiles[attrs.TSSectionName] = true;
                       }

              });

              // Get PolicyIssuance Attributes mapping
              var formInstance = $("#@PIViewIdHelper.Form(dept, policyIssuanceId)").dxForm("instance");
              var parentFormData = formInstance ? formInstance.option("formData") : {};
              var piAttributes = {};
              try {
                  piAttributes = JSON.parse(parentFormData.attributes || parentFormData.Attributes || "{}");
              } catch (e) {}
              // dataSourceGrid.forEach(item => {
              //     debugger
              //     // bind checkbox: checked if database says true, OR if saved in PolicyIssuance Attributes, OR if a file of this type is uploaded
              //     item.checked = (dbRow[item.field] ?? false) || (piAttributes[item.field] === true) || (fileTypesWithFiles[item.field] === true);
              //     item.ownId = dbRow.id;
              //     // bind value (cho text/textarea/radio/select)
              //     item.value = dbRow[item.field];
              // });
              dataSourceGrid.forEach(item => {
                const matchedDoc = docs.find(doc => {
                    let attrs = {};

                    try {
                        attrs = JSON.parse(doc.attributes || doc.Attributes || "{}");
                    } catch (e) {}

                    const fieldName = (attrs.FieldName || "").replace(/_\d+$/, "");

                    return fieldName === item.field
                        || attrs.TSSectionName === item.field;
                });

                item.checked =
                    !!matchedDoc ||
                    piAttributes[item.field] === true;

                // item.ownId = dbRow.id;
                // item.value = dbRow[item.field];
              });

              // refresh grid
              var gridInstance = $("#pi_fillList_@policyIssuanceId").dxDataGrid("instance");
              if (gridInstance) {
                  gridInstance.option("dataSource", dataSourceGrid);
                  gridInstance.option("id", detailData.id);
              }
          });


    // delayAcceptStatusV2(mainFields,thisObject, ...itemsDelay);
     delayAcceptStatusV2Promise(
        mainFields,
        thisObject,
        ...itemsDelay
    )
        .then(async function (decisionContext) {

            var skipTsEnabled = await loadPolicyIssuanceSkipTS(
                @policyIssuanceId,
                "@PIViewIdHelper.Form(dept, policyIssuanceId)"
            );
            var tsForm = $("#@PIViewIdHelper.Form(dept, policyIssuanceId)").dxForm("instance");
            tsForm?.itemOption("fillListGroup", "visible", !skipTsEnabled);

            /*
             * decisionContext hiện có:
             *
             * decisionContext.status
             * decisionContext.buttons
             * decisionContext.primaryButton
             * decisionContext.actionHost
             *
             * decisionContext.enable()
             * decisionContext.disable()
             * decisionContext.setDisabled(...)
             */
            var picJson =
                PIC_JSON || "{}";

            var picMap =
                parsePicMap(picJson);

            var picVal =
                picMap["@dept"] || "";

            var $section =
                $(`#pi-sec_@(dept)_@(policyIssuanceId)`);


            if (!picVal) {

                $section
                    .find(
                        ".dept-upperbody, " +
                        ".dept-body, " +
                        ".dept-lowerbody, " +
                        ".dept-footer"
                    )
                    .hide();

            }
            else {

                $section
                    .find(
                        ".dept-upperbody, " +
                        ".dept-body, " +
                        ".dept-lowerbody, " +
                        ".dept-footer"
                    )
                    .show();
            }


            /*
             * =========================================================
             * DECISION
             * =========================================================
             */


            /*
             * Nếu muốn enable tất cả decision button
             */
            decisionContext.enable();


            /*
             * Nếu chỉ muốn primary button:
             *
             * decisionContext.primaryButton?.enable();
             *
             * decisionContext.primaryButton?.disable();
             */


            /*
             * Status object
             */



            /*
             * =========================================================
             * CUSTOM ROUTE
             * =========================================================
             */

            var workflowResult =
                await loadSelectedWorkflow({

                    moduleCode: viewIdModulePrefix.policyIssuance,

                    id: @(policyIssuanceId),

                    guid: "@quotationGuid",

                    reload: false,
                    data: decisionContext
                });



            var customRouteObjects =
                workflowResult?.customRouteObjects || [];




            /*
             * Chỉ lấy route của LMKT
             */
            var lmktRoutes =
                customRouteObjects.filter(
                    function (item) {
                        return item.dept === "@dept";
                    }
                );


            /*
             * Enable toàn bộ custom route LMKT
             */
            lmktRoutes.forEach(
                function (item) {
                    item.enable();
                }
            );


            /*
             * Nếu cần disable:
             *
             * lmktRoutes.forEach(function (item) {
             *     item.disable();
             * });
             */


            /*
             * Ví dụ tìm route cụ thể
             */
          
            // $(approveRoute).dxButton("instance").option("disabled", false);
            // if (approveRoute) {

            //     console.log(
            //         "Approve route:",
            //         approveRoute
            //     );

            //      approveRoute.enable();

            //     // approveRoute.disable();

            //     // approveRoute.button.instance
            //     //     ?.option("disabled", false);
            // }

        })
        .catch(function (error) {

            console.error(
                "@dept decision initialization failed:",
                error
            );

        });
    // setTimeout(() => {
    //     var picJson = PIC_JSON || "{}";
    //     var picMap = parsePicMap(picJson);
    //     var picVal = picMap["@dept"] || "";
    //     var sectionId = `#pi-sec_@(dept)_@(policyIssuanceId)`;
    //     if (!picVal) {
    //         $(sectionId).find(".dept-upperbody, .dept-body, .dept-lowerbody, .dept-footer").hide();
    //     } else {
    //         $(sectionId).find(".dept-upperbody, .dept-body, .dept-lowerbody, .dept-footer").show();
    //     }
    // }, 100);

    })

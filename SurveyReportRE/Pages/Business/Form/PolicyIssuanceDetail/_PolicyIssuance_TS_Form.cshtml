@using JogetMVC.Model
@{
    string dept = "TS";
    long quotationId = Convert.ToInt64(ViewData["Id"]);
}
<style>
    .dx-tabpanel .dx-tabpanel-tabs .dx-tab {
        width: auto;
        padding-left: 18px;
        padding-right: 18px;
    }
</style>
<script type="text/javascript">
        var that = new Object();
    that.ModelName = "PolicyIssuance";
    $("#@PIViewIdHelper.Form(dept, quotationId)").dxForm({
        dataSource: makeBasicDataSource(that, true),
         items: [
{itemType: "group", caption: "Attachment",colCount: 1, items: [{ dataField: "attachment", editorType:"dxFileUploader"
            ,
            editorOptions: {
            name: "files"
        }
        ,template: function (data, itemElement) {
            setTimeout(function () {
                var item = new Object();
                item.id = @quotationId;
                item.editorType = "dxFileUploader";
              item.moduleName = "pi"; item.sectionName = "TS";
                createEditor(item, itemElement, $("<div>"), null);
                // loadAttachmentList("TS");
                }, 1000);
            }

        }
]}
             ,



         ]
       });
    
</script>


<div id="@PIViewIdHelper.Form(dept, quotationId)">
</div>
<div style="margin-top:10px;font-weight:800;font-size:12px;">Locations</div>
<div id="gridTSLocations" style="margin-top:8px;"></div>
@using JogetMVC.Model
@{
    string dept = "TS";
    long policyIssuanceId = Convert.ToInt64(ViewData["Id"]); string quotationGuid = ViewData["Guid"].ToString();
}

<div class="actionBarDept" id="@PIViewIdHelper.ActionBarDept(dept,policyIssuanceId)">
    <div class="">
        <span class="dept-title">Remarks</span> <div id="@PIViewIdHelper.RemarkBox(dept,policyIssuanceId)" class="htmleditor"></div>
    </div>
    <div class="actionRight"  aria-action-right="@dept">
        @* Save button temporarily disabled for Policy Issuance flow. *@
        @* <div id="@PIViewIdHelper.BtnSave(dept,policyIssuanceId)"></div> *@
        <div id="@PIViewIdHelper.BtnReturnBranch(dept,policyIssuanceId)" class="return-btn-style"></div>
        <div id="@PIViewIdHelper.BtnSubmitBranch(dept,policyIssuanceId)" class="submit-btn-style"></div>
    </div>
</div>

<script>
     var dept = "@dept";
     var signedBackPolicyIssuanceSource_@(policyIssuanceId) = {
         ModelName: "SignedBackPolicyIssuance",
         refField: "PolicyIssuanceId",
         refKey: @policyIssuanceId
     };

     function renderTsReminderGrid_@(policyIssuanceId)() {
         return $("<div id='piReminderGrid_@policyIssuanceId'>").dxDataGrid({
             dataSource: makeBasicDataSource(
                 signedBackPolicyIssuanceSource_@(policyIssuanceId),
                 false
             ),
             keyExpr: "id",
             height: "100%",
             showBorders: true,
             rowAlternationEnabled: true,
             columnAutoWidth: true,
             wordWrapEnabled: true,
             noDataText: "No reminders have been added",
             paging: { enabled: false },
             editing: {
                 mode: "batch",
                 allowAdding: true,
                 allowUpdating: true,
                 allowDeleting: true,
                 useIcons: true,
                 selectTextOnEditStart: true,
                 startEditAction: "click",
                 newRowPosition: "last"
             },
             onInitNewRow: function (e) {
                 var rows = e.component.getVisibleRows()
                     .filter(function (row) { return row.rowType === "data"; })
                     .map(function (row) { return row.data; });
                 var maxCount = rows.reduce(function (max, row) {
                     return Math.max(max, Number(row.reminderCount) || 0);
                 }, 0);
                 e.data.policyIssuanceId = @policyIssuanceId;
                 e.data.reminderCount = maxCount + 1;
                 e.data.reminderDate = new Date();
                 e.data.note = "";
             },
             toolbar: {
                 items: [{
                     name: "addRowButton",
                     showText: "always",
                     options: { text: "Add reminder", icon: "add" }
                 }]
             },
             columns: [{
                 dataField: "reminderCount",
                 caption: "No.",
                 dataType: "number",
                 width: 100,
                 editorOptions: { min: 1, step: 1, showSpinButtons: true },
                 validationRules: [
                     { type: "required" },
                     { type: "range", min: 1 },
                     {
                         type: "custom",
                         message: "No. must be an integer",
                         validationCallback: function (args) {
                             return Number.isInteger(Number(args.value));
                         }
                     }
                 ]
             }, {
                 dataField: "reminderDate",
                 caption: "Reminder date",
                 dataType: "date",
                 format: "dd/MM/yyyy",
                 width: 170,
                 editorOptions: { displayFormat: "dd/MM/yyyy", useMaskBehavior: true },
                 validationRules: [{ type: "required" }]
             }, {
                 dataField: "note",
                 caption: "Note",
                 minWidth: 320,
                 editorType: "dxTextBox",
                 editorOptions: { maxLength: 4000 },
                 validationRules: [
                     { type: "required", trim: true },
                     { type: "stringLength", max: 4000 }
                 ]
             }, {
                 type: "buttons",
                 width: 60,
                 buttons: ["delete"]
             }]
         });
     }

    $("#piReminderButton_@policyIssuanceId").dxButton({
        icon: "clock",
        hint: "Reminder schedule",
        stylingMode: "outlined",
        type: "normal",
        elementAttr: {
            "aria-label": "Open reminder schedule"
        },
        onClick: function () {
            var popupInstance = makePopupWithScroll(
                renderTsReminderGrid_@(policyIssuanceId)(),
                "medium",
                "Reminder schedule"
            );

            popupInstance.option("toolbarItems[0].options", {
                stylingMode: "contained",
                type: "default",
                text: "Apply",
                onClick: function () {
                    var grid = $("#piReminderGrid_@policyIssuanceId").dxDataGrid("instance");
                    grid.saveEditData().then(function () {
                        if (grid.hasEditData()) return;
                        popupInstance.hide();
                        DevExpress.ui.notify("Reminder schedule saved.", "success", 1800);
                    });
                }
            });
            popupInstance.show();
        }
    });
       //       var pageLayout = window.PolicyIssuancePage;
       // var stateLayout = pageLayout.state;
    $("#@PIViewIdHelper.BtnSave(dept, policyIssuanceId)").dxButton({ text: "Save", icon: "save", type: "default", onClick:
         function (e) {
                var formId = `@PIViewIdHelper.Form(dept, policyIssuanceId)`
               var formItems = $(`#${formId}`).dxForm("instance")?.option("formData") || {};
               var globalLoadPanel = $("#loadingPopup").dxLoadPanel({
                   shadingColor: window.AppColors.c_rgba_0_0_0_0_4,
                   visible: false,
                   showIndicator: true,
                   showPane: false,
                   shading: true,
                   closeOnOutsideClick: false,
                    position: { of: `#@PIViewIdHelper.Form(dept, policyIssuanceId)`}
                   // onShown: function () {
                   //     setTimeout(function () {
                   //         appLoadPanel.hide();
                   //     }, 3000);
                   // }
               });
              globalLoadPanel.dxLoadPanel("instance").show();

             ajaxPut('/api/PolicyIssuance/UpdateData',
             {
                 key: formItems.id,
                 values: JSON.stringify(
                     formItems
                 )
             },
             {
                 onSuccess: function (response) {
                 },
                 onError: function (err) { }
             });

             savePolicyIssuance();

         }
     });

         function savePolicyIssuance() {
        const grid =  $("#pi_fillList_@policyIssuanceId").dxDataGrid("instance");

        const data = grid.option("dataSource");


            const visibleRows = grid.getVisibleRows().map(r => r.data);

            ajaxPut('/api/PolicyIssuanceDetails/UpdateData',
            {
                key: visibleRows[0].ownId,
                values: JSON.stringify(mapGridToObject(visibleRows))
            },
            {
                onSuccess: function (response) {
                    DevExpress.ui.notify("Saved successfully", "success", 2000);
                },
                onError: function (err) {
                    DevExpress.ui.notify("Save failed", "error", 2000);
                }
            });

        }
            function mapGridToObject(rows) {
        const result = {};

        rows.forEach(item => {
            let val;

            // ✅ checkbox → dùng checked
            if (item.type === "checkbox") {
                val = item.checked === true;
            }
            // ✅ field có value
            else {
                val = item.checked ? item.value : null;

                // xử lý case "" (empty string)
                if (val === "") val = null;
            }

            result[item.field] = val;
        });

        return result;
    }
</script>

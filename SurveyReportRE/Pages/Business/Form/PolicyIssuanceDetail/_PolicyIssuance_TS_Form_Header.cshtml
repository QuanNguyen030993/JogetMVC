@using JogetMVC.Model
@{
    string dept = "TS";
    long policyIssuanceId = Convert.ToInt64(ViewData["Id"]);
}

<style>
    #piReminderButton_@(policyIssuanceId) {
        display: inline-flex;
        align-items: center;
        flex: 0 0 auto;
    }

    #piReminderButton_@(policyIssuanceId).dx-button {
        min-width: 34px;
        width: 34px;
        height: 34px;
        border-radius: 6px;
    }

    #piReminderButton_@(policyIssuanceId).dx-button .dx-button-content {
        padding: 7px;
    }

    #piTsHeaderActions_@(policyIssuanceId) {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        flex: 0 0 auto;
        min-height: 34px;
    }
</style>

<div class="dept-title">@dept</div>
<div class="dept-form-header">
    <div class="dept-form-header__assign">
        <div id="@PIViewIdHelper.AssigneeBox(dept, policyIssuanceId)"></div>
    </div>
</div>
    <div id="piTsHeaderActions_@(policyIssuanceId)" class="dept-form-header__actions">
        <div id="piReminderButton_@(policyIssuanceId)" class="ts-reminder-button-host"></div>
        @* Additional TS header buttons can be mounted here. *@
    </div>
<div id="pi-stickPanel_@dept">
</div>
<div class="dept-hint-wrap">
    <div class="dept-hint" id="@PIViewIdHelper.Hint(dept, policyIssuanceId)"></div>
    <div class="dept-updated" id="@PIViewIdHelper.Upd(dept, policyIssuanceId)" title="Last updated">—</div>
    <div id="@PIViewIdHelper.ExpandCollapsedBtn(dept, policyIssuanceId)" class="dept-toggle-icon" aria-hidden="true">▾</div>
</div>

<script>
</script>

@using JogetMVC.Model
 @{
    string dept = "FO";  
    long quotationId = Convert.ToInt64(ViewData["Id"]); 
    string quotationGuid = ViewData["Guid"].ToString();
    string cloneQuotationGuid = ViewData["CopyFromGuid"]?.ToString() ?? "";
}


<div class="actionBarDept" id="@PIViewIdHelper.ActionBarDept(dept,quotationId)">
     <div class="">
        <span class="dept-title">Remarks</span> <div id="@PIViewIdHelper.RemarkBox(dept,quotationId)" class="htmleditor"></div>
    </div>
    <div class="actionRight">
        @* Save button temporarily disabled for Policy Issuance flow. *@
        @* <div id="@PIViewIdHelper.BtnSave(dept,quotationId)"></div> *@
        <div id="@PIViewIdHelper.BtnReturnBranch(dept,quotationId)"></div>
        <div id="@PIViewIdHelper.BtnSubmitBranch(dept,quotationId)"></div>
    </div> 
</div>

<script>
    // var formItems = $("#pi-formFO").dxForm("instance")?.option("formData") || {};
    var dept = "@dept";
        //  var pageLayout = window.PolicyIssuancePage;
        // var stateLayout = pageLayout.state;
         $("#@PIViewIdHelper.BtnSave(dept, quotationId)").dxButton({ text: "Save", icon: "save", type: "default", onClick:
        function (e) {
               var formItems = $(`#@PIViewIdHelper.Form(dept, quotationId)`).dxForm("instance")?.option("formData") || {};
              
              var globalLoadPanel = $("#loadingPopup").dxLoadPanel({
                  shadingColor: window.AppColors.c_rgba_0_0_0_0_4,
                  visible: false,
                  showIndicator: true,
                  showPane: false,
                  shading: true,
                  closeOnOutsideClick: false,
                    position: { of: `#@PIViewIdHelper.Form(dept, quotationId)`}
              });
             globalLoadPanel.dxLoadPanel("instance").show();

             // Fetch attachments to save their classified types to PolicyIssuance Attributes field
             var cloneQuotationGuid = "@cloneQuotationGuid";
             var policyIssuanceGuid = "@quotationGuid";

             var fetch1 = $.ajax({ url: `/api/Document/GetByKey?recordGuid=${cloneQuotationGuid}`, method: "GET" });
             var fetch2 = $.ajax({ url: `/api/Document/GetByKey?recordGuid=${policyIssuanceGuid}`, method: "GET" });

             $.when(fetch1, fetch2).done(function (r1, r2) {
                 var docs = [...(r1[0] || []), ...(r2[0] || [])];
                 var selectedTypes = {};
                 docs.forEach(function (doc) {
                     var attrs = {};
                     try {
                         attrs = JSON.parse(doc.attributes || doc.Attributes || "{}");
                     } catch (e) {}
                     if (attrs.FieldName && attrs.FieldName !== "default") {
                         selectedTypes[attrs.FieldName] = true;
                     }
                 });

                 formItems.attributes = JSON.stringify(selectedTypes);
                 formItems.Attributes = JSON.stringify(selectedTypes);

                 ajaxPut('/api/PolicyIssuance/UpdateData',
                     {
                         key: formItems.id,
                         values: JSON.stringify(formItems)
                     },
                     {
                         onSuccess: function (response) {
                             globalLoadPanel.dxLoadPanel("instance").hide();
                         },
                         onError: function (err) {
                             globalLoadPanel.dxLoadPanel("instance").hide();
                         }
                     }
                 );
             }).fail(function () {
                 ajaxPut('/api/PolicyIssuance/UpdateData',
                     {
                         key: formItems.id,
                         values: JSON.stringify(formItems)
                     },
                     {
                         onSuccess: function (response) {
                             globalLoadPanel.dxLoadPanel("instance").hide();
                         },
                         onError: function (err) {
                             globalLoadPanel.dxLoadPanel("instance").hide();
                         }
                     }
                 );
             });
        }
    });
</script> 

@using JogetMVC.Model
 @{
    string dept = "FO";  
    long quotationId = Convert.ToInt64(ViewData["Id"]); string quotationGuid = ViewData["Guid"].ToString();
}


<div class="actionBarDept" id="@PIViewIdHelper.ActionBarDept(dept,quotationId)>
    <div class="actionLeft">
        <span class="dept-title">Remarks</span> <div id="@PIViewIdHelper.RemarkBox(dept,quotationId)" class="htmleditor"></div>
    </div>
    <div class="actionRight">
        <div id="@PIViewIdHelper.BtnSave(dept,quotationId)"></div>
        <div id="@PIViewIdHelper.BtnReturnBranch(dept,quotationId)"></div>
        <div id="@PIViewIdHelper.BtnSubmitBranch(dept,quotationId)"></div>
    </div>
</div>

<script>
    setTimeout( () => {
    // var formItems = $("#pi-formFO").dxForm("instance")?.option("formData") || {};
    var dept = "@dept";
         var pageLayout = window.PolicyIssuancePage;
        var stateLayout = pageLayout.state;
         $("#@PIViewIdHelper.BtnSave(dept, quotationId)").dxButton({ text: "Save", icon: "save", type: "default", onClick:
        function (e) {
               var formItems = $(`#@PIViewIdHelper.Form(dept, quotationId)`).dxForm("instance")?.option("formData") || {};
              
              var globalLoadPanel = $("#loadingPopup").dxLoadPanel({
                  shadingColor: "rgba(0,0,0,0.4)",
                  visible: false,
                  showIndicator: true,
                  showPane: false,
                  shading: true,
                  closeOnOutsideClick: false,
                    position: { of: `#@PIViewIdHelper.Form(dept, quotationId)`}
                  // onShown: function () {
                  //     setTimeout(function () {
                  //         appLoadPanel.hide();
                  //     }, 3000);
                  // }
              });
             globalLoadPanel.dxLoadPanel("instance").show();

            ajaxPut('/api/PolicyIssuance/UpdateData',
            {
                key: formItems.id,
                values: JSON.stringify(
                    formItems
                )
            },
            {
                onSuccess: function (response) { 
                },
                onError: function (err) { }
            }
        );
        }
    });
    }, _delayRenderSubmitButton);
</script> 


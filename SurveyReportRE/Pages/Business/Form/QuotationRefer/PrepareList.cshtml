@page
@model PrepareListModel
@{

}
<script>
    $(function () {
        var mGridOption = new Object();
        mGridOption.isAllowRowMenu = true;
        mGridOption.selection = { mode: "multiple", showCheckBoxesMode: "always" };
        
        var mGrid = new MGrid(null, $(`#dataGrid_@PrepareListModel.ModelName`), new PrepareListGridOption('@PrepareListModel.ModelName', "User", mGridOption), null);
    });
</script>
<div id="dataGrid_@PrepareListModel.ModelName"></div>

                  //     onValueChanged: function(e) {
                  //       const form = that.dxForm("instance");

                  //       if (e.value === true) {
                  //         initPicIfEmpty(form);
                  //         showSurveyAccordion(true);

                  //         // refresh preview trong accordion (nếu đã render)
                  //         const picStr = form.option("formData.PIC");
                  //         $("#surveyPicPreview").dxTextArea?.("instance")?.option("value", picStr);

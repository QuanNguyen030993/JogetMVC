            // });
                noDataText: "No manual assignee entry. Switch to Manual assign and click New.",
                paging: { pageSize: 10 },
                pager: { showInfo: true },
                columns: [
                    {
                        dataField: "to",
                        caption: "Assignee",
                        lookup: { dataSource: _enums.assignee, valueExpr: "accountName", displayExpr: "fullName" }
                    },
                    {
                        dataField: "notes",
                        caption: "Notes",
                        cellTemplate(container) {
                            $("<div/>").text("Hidden notes, open entry to view").appendTo(container);
                        }
                    },
                    {
                        type: "buttons",
                        width: 120,
                        buttons: [
                            { hint: "Edit", icon: "edit", onClick(e) { openPopupForEdit(e.row.data); } },
                            {
                                hint: "Devare", icon: "trash",
                                onClick(e) {
                                    assigneeStore.remove(e.row.data._key);
                                    $("#assigneeList").dxDataGrid("instance").refresh();
                                }
                            }
                        ]
                    }
                ]
            });

            var popupFormItems = [
                {
                    dataField: "to",
                    editorType: "dxSelectBox",
                    isRequired: true,
                    editorOptions: { dataSource: _enums.assignee, displayExpr: "fullName", valueExpr: "accountName", searchEnabled: true }
                },
                { dataField: "notes", colSpan: 2, editorType: "dxTextArea", editorOptions: { minHeight: 90 } }
            ];

            var currentEntry = entryTemplate();

            $("#btnNewAssignee").dxButton({
                text: "New",
                icon: "plus",
                type: "default",
                onClick() {
                    openPopupForNew();
                }
            });

            $("#btnClearAssignee").dxButton({
                text: "Clear",
                icon: "trash",
                type: "normal",
                onClick() {
                    vm.assignees.splice(0, vm.assignees.length);
                    $("#assigneeList").dxDataGrid("instance").refresh();
                }
            });

            var popupMode = "new";
            var editingKey = null;

            $("#assigneePopup").dxPopup({
                width: 920,
                height: "auto",
                showTitle: true,
                title: "New Assignee Entry",
                visible: false,
                dragEnabled: true,
                closeOnOutsideClick: true,
                contentTemplate: function (content) {
                    content.empty();


                      $.ajax({
                            url: "api/Employee/GetAssignableByGroup",
                            type: "GET",
                            dataType: "json",
                            data: {
                                group:  vm.assignedTeamOrRole || "TS",
                                excludeCurrent: true,
                                keyword: ""
                            }
                        }).then(function (res) {
                            $("<div id='assignBox'>").appendTo(content).dxForm({
                                formData: {
                                    to: currentEntry.to,
                                    notes: currentEntry.notes,
                                    deptTarget: vm.assignedTeamOrRole
                                },
                                colCount: 2,
                                labelMode: "floating",
                                items: [
                                    {
                                        dataField: "to",
                                        colSpan: 2,
                                        editorType: "dxSelectBox",
                                        validationRules: [{ type: "required" }],
                                        editorOptions: {
                                            dataSource: res.data,
                                            displayExpr: "fullName",
                                            valueExpr: "accountName",
                                            searchEnabled: true
                                        }
                                    },
                                    {
                                        dataField: "notes",
                                        colSpan: 2,
                                        editorType: "dxTextArea",
                                        label: { text: "Notes" },
                                        editorOptions: {
                                            minHeight: 90
                                        }
                                    }
                                ]
                            });
                        });

                },
                toolbarItems: [
                    {
                        widget: "dxButton",
                        toolbar: "bottom",
                        location: "after",
                        options: {
                            text: "Save",
                            type: "default",
                            onClick: function () {
                                var form = $("#assignBox").dxForm("instance");
                                var result = form.validate();
                                if (!result.isValid) {
                                    DevExpress.ui.notify("Please fill required fields.", "error", 1500);
                                    return;
                                }

                                var data = form.option("formData");
                                data._key = data.to;

                                if (popupMode === "new") {
                                    vm.assignees.push({ ...data });
                                } else {
                                    var idx = vm.assignees.findIndex(x => x._key === editingKey);
                                    if (idx >= 0) vm.assignees[idx] = { ...data };
                                }

                                $("#assigneeList").dxDataGrid("instance").refresh();
                                $("#assigneePopup").dxPopup("instance").hide();
                            }
                        }
                    },
                    {
                        widget: "dxButton",
                        toolbar: "bottom",
                        location: "after",
                        options: {
                            text: "Cancel",
                            onClick: function () {
                                $("#assigneePopup").dxPopup("instance").hide();
                            }
                        }
                    }
                ]
            });

            function openPopupForNew() {
                if (!isManual()) {
                    DevExpress.ui.notify("Switch Assignment Mode to 'Manual assign' to add entries.", "warning", 1800);
                    return;
                }

                popupMode = "new";
                currentEntry = entryTemplate();

                      $.ajax({
                            url: "api/Employee/GetAssignableByGroup",
                            type: "GET",
                            dataType: "json",
                            data: {
                                group:  vm.assignedTeamOrRole || "TS",
                                excludeCurrent: true,
                                keyword: ""
                            }
                        }).then(function (res) {
                              _enums.assignee.push(...res.data);
                          
                        });
                          var popup = $("#assigneePopup").dxPopup("instance");
                            popup.option("title", "New Assignee Entry");
                            popup.show();
               
            }

            function openPopupForEdit(row) {
                if (!isManual()) {
                    DevExpress.ui.notify("This list is for Manual assign mode.", "warning", 1600);
                    return;
                }

                popupMode = "edit";
                editingKey = row._key;
                currentEntry = { ...row };

                var popup = $("#assigneePopup").dxPopup("instance");
                popup.option("title", "Edit Assignee Entry");
                popup.show();
            }

            function refreshAssignmentUI() {
                var grid = $("#assigneeList").dxDataGrid("instance");
                var btnNew = $("#btnNewAssignee").dxButton("instance");
                var btnClear = $("#btnClearAssignee").dxButton("instance");

                var enabled = isManual();
                btnNew.option("disabled", !enabled);
                btnClear.option("disabled", !enabled);
                grid.option("disabled", !enabled);
            }

            refreshAssignmentUI();

            // window.getQuotationRequestPayload = function () {
            //     var formIns = $("#quotationRequestForm").dxForm("instance");
            //     var formData = formIns.option("formData") || {};

            //     formData.attachments = buildAttachmentPayload();
            //     formData.assignees = vm.assignees;

            //     return formData;
            // };

            // window.validateQuotationRequestForm = function () {
            //     var formIns = $("#quotationRequestForm").dxForm("instance");
            //     var r1 = formIns.validate();
            //     var r2 = validateAttachments();
            //     return !!(r1.isValid && r2);
            // };

    </script>
</body>

            const $switchHost = $("<div>").appendTo($row);
            const $spacer = $("<div>").addClass("survey-field-spacer").appendTo($row); // optional
            // const $hint = $("<div>").addClass("survey-field-hint").text("Toggle to assign Survey PIC").appendTo($row);

            const $accWrap = $("<div>").addClass("survey-acc-wrap").appendTo($wrap);

            // --- Switch ---
            $switchHost.dxSwitch({
              value: !!fd.surveyNeeded,
              onValueChanged: function(e) {
                // sync back to formData
                form.option("formData.surveyNeeded", e.value);

                // show/hide accordion block
                $accWrap.toggle(!!e.value);

                // open/close
                const acc = $accWrap.find(".survey-acc").dxAccordion("instance");
                if (acc) acc.option("selectedIndex", e.value ? 0 : -1);
              }
            });

            // --- Accordion container ---
            const $acc = $("<div>").addClass("survey-acc").appendTo($accWrap);

            function updatePic(dept, account) {
              const current = ensurePicKeys(safeParseJson(form.option("formData.PIC")));
              current[dept] = account || null;
              form.option("formData.PIC", JSON.stringify(current));

              // nếu bạn có field PIC hiển thị nơi khác, có thể refresh editor đó
              const picEditor = form.getEditor?.("PIC");
              if (picEditor) picEditor.option("value", form.option("formData.PIC"));
            }

            // init accordion
            $acc.dxAccordion({
              multiple: false,
              collapsible: true,
              selectedIndex: fd.surveyNeeded ? 0 : -1,
              animationDuration: 180,
              dataSource: [{ key: "survey", title: "SURVEY PIC" }],

                //     $preview.dxTextArea("instance").option("value", form.option("formData.PIC"));
                //   }
                // });



                $(el).append($body);
              }
            });

            // initial show/hide accordion based on switch
            $accWrap.toggle(!!fd.surveyNeeded);

            itemElement.append($wrap);
          }
        }

                ]

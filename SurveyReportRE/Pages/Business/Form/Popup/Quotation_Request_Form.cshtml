    <script>
            var guid= crypto.randomUUID();
            var clientQuery = `OnSystem`;

            var DEPTS = ["RE"];
            var REMEMS = ["quan.nh", "huan.lt", "minh.lh"];

            var ATTACHMENT_TYPES = [
                { id: "supporting_document", text: "Supporting Document" },
                { id: "quotation_file", text: "Quotation File" },
                { id: "mail_file", text: "Mail File" }
            ];

            var item = new Object();

             item.editorType ="dxDropDownBox";
             item.dataField = "workflowDefinitionId"
            var objGridType = new Object();
            objGridType.gridType = "User";
            objGridType.ModelName = "WorkflowDefinition";
            objGridType.filterRefField = "isActive";
            objGridType.filterRefId = true;

            var configDataWFDEF = makeFieldFeatures(item, objGridType, "grid");

            function safeParseJson(s) {
                if (!s) return {};
                if (typeof s === "object") return s;
                try { return JSON.parse(s); } catch { return {}; }
            }

            function ensurePicKeys(obj) {
                var o = { ...obj };
                DEPTS.forEach(k => { if (!(k in o)) o[k] = null; });
                return o;
            }

            function updatePicMap(form, dept, account) {
                var fd = form.option("formData") || {};
                var current = ensurePicKeys(safeParseJson(fd.PIC));
                current[dept] = account || null;
                form.option("formData.PIC", JSON.stringify(current));
            }

            function initPicIfEmpty(form) {
                var fd = form.option("formData") || {};
                var pic = safeParseJson(fd.PIC);
                var hasAny = pic && Object.keys(pic).length > 0;

                if (!hasAny) {
                    form.option("formData.PIC", JSON.stringify({
                        FO: _loginUser,
                        RE: "an.re",
                        TS: null,
                        UW: null,
                        LMKT: null,
                        PM: null
                    }));
                } else {
                    form.option("formData.PIC", JSON.stringify(ensurePicKeys(pic)));
                }
            }

            function showSurveyAccordion(show) {
                $("#surveyAccordionWrap").toggle(!!show);
                if (show) {
                    $("#surveyAccordion").dxAccordion("instance")?.option("selectedIndex", 0);
                }
            }

            function attachmentTemplate() {
                return {
                    _key: generateGUID(),
                    file: null,
                    fileName: "",
                    fileSize: 0,
                fileType: "",
                    attachmentType: null,
                    note: "",
                    uploadedPath: "",
                    uploadedName: ""
                };
            }

            function formatFileSize(bytes) {
                if (!bytes || bytes <= 0) return "";
                var units = ["B", "KB", "MB", "GB"];
                var i = 0;
                var val = bytes;
                while (val >= 1024 && i < units.length - 1) {
                    val /= 1024;
                    i++;
                }
                return `${val.toFixed(val >= 10 || i === 0 ? 0 : 2)} ${units[i]}`;
            }

            function entryTemplate() {
                return {
                    _key: generateGUID(),
                    to: null,
                    notes: "",
                    deptTarget: vm.assignedTeamOrRole || "TS"
                };
            }

            function buildAttachmentPayload() {
                return vm.attachments?.map(x => ({
                    _key: x._key,
                    attachmentType: x.attachmentType,
                    fileName: x.fileName,
                    fileSize: x.fileSize,
                fileType: x.fileType,
                    uploadedPath: x.uploadedPath || "",
                    uploadedName: x.uploadedName || "",
                    note: x.note || ""
                }));
            }

            function syncAttachmentToForm() {
                if (that && that.formInstance) {
                    that.formInstance.updateData("attachments", JSON.stringify(buildAttachmentPayload()));
                }
            }

            function validateAttachments() {
                var invalid = vm.attachments.some(x => !x.fileName || !x.attachmentType);
                if (invalid) {
                    DevExpress.ui.notify("Attachment row must have file and document type.", "warning", 2000);
                    return false;
                }
                return true;
            }

            DevExpress.localization.locale("en");

            var vm = {
                subject: "",
                reqPerson: _loginUser,
                reqDate: new Date(2026, 0, 21), // 21-01-2026

            assignmentMode: "manual",     // auto | later | manual
                assignedTeamOrRole: "TS",

            assignees: []               // only for manual mode
            };

            function isManual() {
                return vm.assignmentMode === "manual";
            }

            function buildSummary() {
                var modeLabel =

@page "{pageNum:int?}"
@using Newtonsoft.Json
@model Quotation_Request_FormModel
@{
    string prefix = "qt";
    string dept = "FO";
    ViewBag.Title = "Quotation";
    ViewData["Id"] = 0;
}

<style>

   

    .sectionTitle {
        font-size: 14px;
        font-weight: 650;
        margin: 18px 0 10px;
        opacity: .9;
    }

    .dx-form-group-caption {
        font-weight: 650 !important;
    }

    .toolbarRow {
        margin-top: 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .survey-field-wrap {
        width: 100%;
    }

    .survey-field-row {
        display: flex;
        align-items: center;
        gap: 10px;
        min-height: 36px;
    }

    .survey-field-spacer {
        flex: 1;
    }

    .survey-acc-wrap {
        margin-top: 12px;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        overflow: hidden;
    }

    .acc-title {
        font-weight: 600;
        padding: 2px 0;
    }

    .acc-body {
        padding: 8px 2px 2px;
    }

    #attachmentGrid .dx-fileuploader-wrapper {
        padding: 0;
    }

    .att-file-meta {
        font-size: 12px;
        color: #6b7280;
        margin-top: 6px;
        word-break: break-word;
        line-height: 1.35;
    }
</style>

<body>
    <div id="form_Quotation_Request_Form"></div>
    <div id="requestPage">
        <div id="quotationRequestForm"></div>
@* 
        <div class="sectionTitle">Attachment</div>
        <div id="attachmentGrid"></div> *@

        <div class="toolbarRow">
            <div class="sectionTitle" style="margin:0;">Quotation PIC</div>
            <div style="display:flex; gap:8px;">
                <div id="btnNewAssignee"></div>
                <div id="btnClearAssignee"></div>
            </div>
        </div>

        <div id="assigneeList" style="margin-top:10px;"></div>

        <div id="assigneePopup"></div>

                    // const DEPTS = ["MKT","RE","TS","UW","LMKT","PM"];
                    const DEPTS = ["RE"];
                    const REMEMS = ["quan.nh","huan.lt","minh.lh"];

        function safeParseJson(s) {
          if (!s) return {};
          if (typeof s === "object") return s;
          try { return JSON.parse(s); } catch { return {}; }
        }

        function ensurePicKeys(obj) {
          const o = { ...obj };
          DEPTS.forEach(k => { if (!(k in o)) o[k] = null; });
          return o;
        }

        function updatePicMap(form, dept, account) {
          const fd = form.option("formData") || {};
          const current = ensurePicKeys(safeParseJson(fd.PIC));
          current[dept] = account || null;

          // Lưu về formData.PIC dưới dạng string JSON (an toàn khi post API)
          form.option("formData.PIC", JSON.stringify(current));
        }
        function initPicIfEmpty(form) {
          const fd = form.option("formData") || {};
          const pic = safeParseJson(fd.PIC);
          const hasAny = pic && Object.keys(pic).length > 0;

          if (!hasAny) {
            // khởi đầu: chỉ MKT + RE có account, còn lại null
            form.option("formData.PIC", JSON.stringify({
              MKT: _loginUser,
              RE: "an.re",
              TS: null,
              UW: null,
              LMKT: null,
              PM: null
            }));
          } else {
            // đảm bảo đủ key
            form.option("formData.PIC", JSON.stringify(ensurePicKeys(pic)));
          }
        }


                fd.reTitle = `Request survey to ${fd.clientName} by ${_loginUser}`;
                 $("<div>").text("Department").css("marginTop", 10).css("fontWeight", "bold").appendTo($body);
                const $dept = $("<div>").css("marginTop", 10).appendTo($body);
                 $("<div>").text("Member").css("marginTop", 10).css("fontWeight", "bold").appendTo($body);
                const $accText = $("<div>").css("marginTop", 10).appendTo($body);
                 $("<div>").text("Message to RE").css("marginTop", 10).css("fontWeight", "bold").appendTo($body);
                const $MsgText = $("<div>").css("marginTop", 10).appendTo($body);
                const $btn = $("<div>").css("marginTop", 10).appendTo($body);


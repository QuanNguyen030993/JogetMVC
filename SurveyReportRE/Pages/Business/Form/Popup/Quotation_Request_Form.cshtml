@page "{pageNum:int?}"
@using Newtonsoft.Json 
 @model Quotation_Request_FormModel 
 @{
   
    ViewBag.Title = "Quotation";
    ViewData["Id"] = 0;
}

<style>

    #qrPage {
        max-width: 1180px;
        margin: 18px auto;
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,.08);
        padding: 16px;
    }

    .sectionTitle {
        font-size: 14px;
        font-weight: 650;
        margin: 18px 0 10px;
        opacity: .9;
    }

    .dx-form-group-caption {
        font-weight: 650 !important;
    }

    .toolbarRow {
        margin-top: 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }
</style>

<body>
   
        <div id="form_Quotation_Request_Form"></div>
    <div id="qrPage">
        @* <div id="qrSummary" style="margin-bottom:12px;"></div> *@
        <div id="quotationRequestForm"></div>

        <div class="toolbarRow">
            <div class="sectionTitle" style="margin:0;">Assignee (Routing)</div>
            <div style="display:flex; gap:8px;">
                <div id="btnNewAssignee"></div>
                <div id="btnClearAssignee"></div>
            </div>
        </div>

        <div id="assigneeList" style="margin-top:10px;"></div>

        @* <div style="margin-top:16px; display:flex; gap:10px;">
            <div id="btnDraft"></div>
            <div id="btnComplete"></div>
        </div> *@

        <div id="assigneePopup"></div>
    </div>


    <script>
        (function () {
          DevExpress.localization.locale("en");
           var options = {
            assignmentMode: [
              // { id: "auto", text: "Auto route (recommended)" },
              { id: "later", text: "Assign later" },
              { id: "manual", text: "Manual assign" }
            ],
            teamOrRole: [
              { id: "TS", text: "Marketing TS" },
              { id: "UW", text: "Underwriting" }
            ],
            assignee: [
              // { accountName: "admin", fullName: "Admin admin" },
              // { accountName: "hien.ttt", fullName: "To Thi Thu Hien" },
              // { accountName: "accpentest", fullName: "accpentest test" }
            ],
            reqType: ["Endorsement", "Revise Quotation", "Renew Quotation", "New Quotation"],
            lineName: ["Fire & Property, BI", "Liability", "Cargo", "Engineering", "Motor"],
            businessChannel: ["Inward", "Direct (DIR)", "Agent (AGY)", "Broker (BRK)"]
          };
       
          // ===== mock options =====
         

          // ===== ViewModel =====
          const vm = {
            subject: "",
            reqPerson: _loginUser,
            reqDate: new Date(2026, 0, 21), // 21-01-2026

            assignmentMode: "manual",     // auto | later | manual
            assignedTeamOrRole: "TS",

            assignees: []               // only for manual mode
          };

          function isManual() { return vm.assignmentMode === "manual"; }

          // ===== Summary =====
          function buildSummary() {
            const modeLabel =
              vm.assignmentMode === "auto" ? "AUTO ROUTE" :
              vm.assignmentMode === "later" ? "ASSIGN LATER" :
              "MANUAL ASSIGN";
          }

          // ===== Main Form =====
          var that = $("#quotationRequestForm").dxForm({
            formData: vm,
            colCount: 2,
            labelMode: "floating",
            showColonAfterLabel: false,
            items: [
              {
                itemType: "group", colSpan: 2, caption: "Quotation Request",
                items: [
                    // Create or clone will be move to header web status
                  // {
                  //   dataField: "typeOfQR",
                  //   editorType: "dxRadioGroup",
                  //   colSpan: 2,
                  //   editorOptions: { items: ["New", "Clone Quotation Request"], layout: "horizontal" },
                  //   validationRules: [{ type: "required" }]
                  // },
                  { dataField: "PIC", editorType: "dxTextBox", editorOptions: { readOnly: true, value: _loginUser } },
                  { dataField: "createDate", editorType: "dxDateBox", editorOptions: { readOnly: true, displayFormat: "dd-MM-yyyy", value: new Date() } },
                  { dataField: "reqType", editorType: "dxSelectBox", isRequired: true, editorOptions: { items: options.reqType } },
                  { dataField: "clientName", editorType: "dxTextBox", visible: false, editorOptions: { readOnly: true } },
                  { dataField: "clientId", editorType: "dxDropDownBox", isRequired: true , label: { text: "Client"} ,
                    editorOptions:  {
                    displayExpr: "englishName",
                    editorType: "dxDropDownBox",
                    width: "100%",
                    dropDownOptions: {
                        width: _defaultDropDownWidth,
                        height: _defaultDropDownHeight,
                    },
                    showClearButton: true,
                    dataSource: new DevExpress.data.CustomStore({//Solve error first selection only
                        key: "id",
                        load: function (loadOptions) {
                            return $.ajax({
                                url: `/api/Client/ExecuteCustomQuery`,
                                method: "POST",
                                contentType: "application/json",
                                data: JSON.stringify(`SELECT
                                    c.Id,
                                    c.ClientCode,
                                    JSON_VALUE(c.ClientName, '$.Eng')  AS EnglishName,
                                    JSON_VALUE(c.ClientName, '$.Viet') AS VietnameseName
                                FROM Client c
                                WHERE c.Deleted = 0;`)
                            });
                        }, byKey: function (key) {
                            //return $.ajax({
                            //    url: `/api/Client/ExecuteCustomQuery`,
                            //    method: "POST",
                            //    contentType: "application/json",
                            //    data: JSON.stringify(checkCustomQueryByModel.customQuery)
                            //});
                            if (key)
                                return $.ajax({
                                    url: `/api/Client/DropDownLookupCustomQuery?key=${encodeURIComponent(key)}`,
                                    method: "POST",
                                    contentType: "application/json",
                                    data: JSON.stringify(`SELECT
                                        c.Id,
                                        c.ClientCode,
                                        JSON_VALUE(c.ClientName, '$.Eng')  AS EnglishName,
                                        JSON_VALUE(c.ClientName, '$.Viet') AS VietnameseName
                                    FROM Client c
                                    WHERE c.Deleted = 0;`)
                                }).then(function (result) {
                                    return Array.isArray(result) ? result[0] : result;
                                });
                            else
                                return new Array();
                        },
                    }),
                    contentTemplate:function (e) {
                        that.formInstance = that.dxForm("instance");
                        var item = this;
                        item.editorOptions = new Object();
                        item.editorOptions.dataSource = e.component.option("dataSource");
                        const dataGrid = makeTheClientLocationGrid(item, e, that, $("<div>"), function(selectedItems){
                             var hasSelection = selectedItems.selectedRowKeys.length > 0;
                            if (!hasSelection) return;
                            const selectedRow = selectedItems.selectedRowsData[0];
                            e.component.option("value", selectedItems.selectedRowKeys[0]);
                            debugger
                            that.formInstance.updateData("clientName" , selectedRow.englishName);
                            e.component.close();
                        });
                        return dataGrid.container;
                  
                    }}},
                  // { dataField: "clientName", editorType: "dxTextBox", isRequired: true , label: {text: "Client Name"} },
                  {
                    dataField: "subject",
                    colSpan: 2,
                    editorType: "dxTextArea",
                    editorOptions: { minHeight: 90 },
                    validationRules: [{ type: "required" }]
                  },
                  { dataField: "lineName", editorType: "dxSelectBox", editorOptions: { items: options.lineName, searchEnabled: true } },
                  { dataField: "productName", editorType: "dxTextBox", visible:false, editorOptions: { readOnly: true } },
                      { dataField: "productId", editorType: "dxSelectBox", editorOptions: {
                            label: {text: "Product Name"},
                            labelMode: "floating",
                            searchEnabled: true,
                            valueExpr: "id",
                            displayExpr: "productName",
                            dataSource: [],
                            onInitialized(e) {
                                ajaxGet("/api/Product/GetAll", null)
                                    .then(list => {
                                        e.component.option("dataSource", list);
                                    });
                            },
                            onValueChanged(e) {
                                that.formInstance = that.dxForm("instance");
                                that.formInstance.updateData("productName",e.component.option("text"));
                                onChanged(e.value);
                            }
                        } },
                  { dataField: "dueDate", editorType: "dxDateBox", editorOptions: { displayFormat: "dd-MM-yyyy" } },
                  { dataField: "businessChannel", editorType: "dxSelectBox", editorOptions: { items: options.businessChannel } },
                ]
              },
              {
                itemType: "group", colSpan: 2, caption: "Assignment",
                items: [
                  {
                    dataField: "assignmentMode",
                    colSpan: 2,
                    editorType: "dxSelectBox",
                    editorOptions: {
                      dataSource: options.assignmentMode,
                      displayExpr: "text",
                      valueExpr: "id",
                      onValueChanged(e) {
                        vm.assignmentMode = e.value;
                        refreshAssignmentUI();
                        buildSummary();
                      }
                    }
                  },
                  {
                    dataField: "assignedTeamOrRole",
                    label: { text: "Assigned Team/Role" },
                    editorType: "dxSelectBox",
                    colSpan: 2,
                    editorOptions: {
                      dataSource: options.teamOrRole,
                      displayExpr: "text",
                      valueExpr: "id",
                      onValueChanged(e){
                        vm.assignedTeamOrRole = e.value;
                        buildSummary();
                      }
                    }
                  },
                  {
                    dataField: "surveyNeeded",
                    label: { text: "Need Survey" },
                    editorType: "dxSwitch",
                    colSpan: 1
                  }
                ]
              }
            ],
            onInitialized() { buildSummary(); }
          });

          // ===== Assignee list (manual entries) =====
            const assigneeStore = new DevExpress.data.ArrayStore({ key: "_key", data: vm.assignees });
       
          $("#assigneeList").dxDataGrid({
            dataSource: assigneeStore,
            keyExpr: "_key",
            showBorders: true,
            columnAutoWidth: true,
            hoverStateEnabled: true,
            noDataText: "No manual assignee entry. Switch to Manual assign and click New.",
            paging: { pageSize: 10 },
            pager: { showInfo: true },
            columns: [
              {
                dataField: "to",
                caption: "Assignee",
                lookup: { dataSource: options.assignee, valueExpr: "accountName", displayExpr: "fullName" }
              },
              {
                dataField: "notes",
                caption: "Notes",
                cellTemplate(container) {
                  $("<div/>").text("Hidden notes, open entry to view").appendTo(container);
                }
              },
              {
                type: "buttons",
                width: 120,
                buttons: [
                  { hint: "Edit", icon: "edit", onClick(e) { openPopupForEdit(e.row.data); } },
                  {
                    hint: "Delete", icon: "trash",
                    onClick(e) {
                      assigneeStore.remove(e.row.data._key);
                      $("#assigneeList").dxDataGrid("instance").refresh();
                    }
                  }
                ]
              }
            ]
          });
           var popupFormItems = [
            {
              dataField: "to",
              editorType: "dxSelectBox",
              isRequired: true,
              editorOptions: { dataSource: options.assignee, displayExpr: "fullName", valueExpr: "accountName", searchEnabled: true }
            },
            { dataField: "notes", colSpan: 2, editorType: "dxTextArea", editorOptions: { minHeight: 90 } }
          ];
          // ===== Buttons =====
           var currentEntry = entryTemplate();
          $("#btnNewAssignee").dxButton({
            text: "New",
            icon: "plus",
            type: "default",
            onClick() { 
                    openPopupForNew();
               
                
               
            }
          });

          $("#btnClearAssignee").dxButton({
            text: "Clear",
            icon: "trash",
            type: "normal",
            onClick() {
              vm.assignees.splice(0, vm.assignees.length);
              $("#assigneeList").dxDataGrid("instance").refresh();
            }
          });

          // ===== Popup for entry =====
          let popupMode = "new"; // new | edit
          let editingKey = null;





         

        

          $("#assigneePopup").dxPopup({
            width: 920,
            height: "auto",
            showTitle: true,
            title: "New Assignee Entry",
            visible: false,
            dragEnabled: true,
            closeOnOutsideClick: true,
            contentTemplate: function (content) {
              // $("<div id='assigneeEntryForm' />").appendTo(content).dxForm({
              //   formData: currentEntry,
              //   colCount: 1,
              //   labelMode: "floating",
              //   items: popupFormItems
              // });
                  const selector = createAssigneeSelector({
                        container: content,
                        dept: vm.assignedTeamOrRole,
                        onChanged(value) {
                            currentEntry.to = value;
                        }
                    });

                    $("<div/>").dxTextArea({
                        label: "Notes",
                        labelMode: "floating",
                        minHeight: 90,
                        onValueChanged(e) {
                            currentEntry.notes = e.value;
                        }
                    }).appendTo(content);
            },
            toolbarItems: [
              {
                widget: "dxButton", toolbar: "bottom", location: "after",
                options: {
                  text: "Save",
                  type: "default",
                  onClick: function () {
                    const form = $("#assigneeEntryForm").dxForm("instance");
                    const result = form.validate();
                    if (!result.isValid) {
                      DevExpress.ui.notify("Please fill required fields.", "error", 1500);
                      return;
                    }

                    const data = form.option("formData");

                    if (popupMode === "new") {
                      vm.assignees.push({ ...data });
                    } else {
                      const idx = vm.assignees.findIndex(x => x._key === editingKey);
                      if (idx >= 0) vm.assignees[idx] = { ...data };
                    }

                    $("#assigneeList").dxDataGrid("instance").refresh();
                    $("#assigneePopup").dxPopup("instance").hide();
                  }
                }
              },
              {
                widget: "dxButton", toolbar: "bottom", location: "after",
                options: { text: "Cancel", onClick: function () { $("#assigneePopup").dxPopup("instance").hide(); } }
              }
            ]
          });

          function openPopupForNew() {
            if (!isManual()) {
              DevExpress.ui.notify("Switch Assignment Mode to 'Manual assign' to add entries.", "warning", 1800);
                   return;
              }
              popupMode = "new";
              currentEntry = entryTemplate();
                 ajaxGet("/api/Employee/AssigneeList", "TS")
                    .then(list => {
                        options.assignee.push(...list);
                         const popup = $("#assigneePopup").dxPopup("instance");
                         popup.option("title", "New Assignee Entry");
                         popup.show();
                         setTimeout(() => $("#assigneeEntryForm").dxForm("instance").option("formData", currentEntry), 2000);
                        console.log("then:", list);
                        console.log("then:", options.assignee);
                    })
                    .fail(err => { // jQuery way (an toàn)
                        console.log("fail:", err);
                    })
                    .always(() => console.log("always"));
           
          }

          function openPopupForEdit(row) {
            if (!isManual()) {
              DevExpress.ui.notify("This list is for Manual assign mode.", "warning", 1600);
              return;
            }
            popupMode = "edit";
            editingKey = row._key;
            currentEntry = { ...row };
            const popup = $("#assigneePopup").dxPopup("instance");
            popup.option("title", "Edit Assignee Entry");
            popup.show();
            setTimeout(() => $("#assigneeEntryForm").dxForm("instance").option("formData", currentEntry), 1000);
          }

          function refreshAssignmentUI() {
            const grid = $("#assigneeList").dxDataGrid("instance");
            const btnNew = $("#btnNewAssignee").dxButton("instance");
            const btnClear = $("#btnClearAssignee").dxButton("instance");

            const enabled = isManual();
            btnNew.option("disabled", !enabled);
            btnClear.option("disabled", !enabled);
            grid.option("disabled", !enabled);
          }
          refreshAssignmentUI();
 

        })();
    </script>
</body>
    <script>
        (function () {
            const clientQuery = `SELECT
                                        c.Id,
                                        c.ClientCode,
                                        JSON_VALUE(c.ClientName, '$.Eng')  AS EnglishName,
                                        JSON_VALUE(c.ClientName, '$.Viet') AS VietnameseName,
                                        c.BranchId AS BranchId
                                    FROM Client c

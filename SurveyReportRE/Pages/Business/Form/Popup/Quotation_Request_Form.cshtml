@page "{pageNum:int?}"
@using Newtonsoft.Json
@model Quotation_Request_FormModel
@{
   
    ViewBag.Title = "Quotation";
    ViewData["Id"] = 0;
}

<style>

    #qrPage {
        max-width: 1180px;
        margin: 18px auto;
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,.08);
        padding: 16px;
    }

    .sectionTitle {
        font-size: 14px;
        font-weight: 650;
        margin: 18px 0 10px;
        opacity: .9;
    }

    .dx-form-group-caption {
        font-weight: 650 !important;
    }

    .toolbarRow {
        margin-top: 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .survey-field-wrap {
        width: 100%;
    }

    .survey-field-row {
        display: flex;
        align-items: center;
        gap: 10px;
        min-height: 36px;
    }

    .survey-field-spacer {
        flex: 1;
    }

    .survey-acc-wrap {
        margin-top: 12px;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        overflow: hidden;
    }

    .acc-title {
        font-weight: 600;
        padding: 2px 0;
    }

    .acc-body {
        padding: 8px 2px 2px;
    }

    #attachmentGrid .dx-fileuploader-wrapper {
        padding: 0;
    }

    .att-file-meta {
        font-size: 12px;
        color: #6b7280;
        margin-top: 6px;
        word-break: break-word;
        line-height: 1.35;
    }
</style>

<body>
    <div id="form_Quotation_Request_Form"></div>
    <div id="qrPage">
        <div id="quotationRequestForm"></div>

        <div class="sectionTitle">Attachment</div>
        <div id="attachmentGrid"></div>

        <div class="toolbarRow">
            <div class="sectionTitle" style="margin:0;">Quotation PIC</div>
            <div style="display:flex; gap:8px;">
                <div id="btnNewAssignee"></div>
                <div id="btnClearAssignee"></div>
            </div>
        </div>

        <div id="assigneeList" style="margin-top:10px;"></div>

        <div id="assigneePopup"></div>
    </div>

    <script>
        (function () {
            const clientQuery = `SELECT
                                    c.Id,
                                    c.ClientCode,
                                    JSON_VALUE(c.ClientName, '$.Eng')  AS EnglishName,
                                    JSON_VALUE(c.ClientName, '$.Viet') AS VietnameseName,
                                    c.BranchId AS BranchId
                                FROM Client c
                                WHERE c.Deleted = 0;`;

            const DEPTS = ["RE"];
            const REMEMS = ["quan.nh", "huan.lt", "minh.lh"];

            const ATTACHMENT_TYPES = [
                { id: "supporting_document", text: "Supporting Document" },
                { id: "quotation_file", text: "Quotation File" },
                { id: "mail_file", text: "Mail File" }
            ];

            var item = new Object();

             item.editorType ="dxDropDownBox";
             item.dataField = "workflowDefinitionId"
            var objGridType = new Object();
            objGridType.gridType = "User";
            objGridType.ModelName = "WorkflowDefinition";
            objGridType.filterRefField = "isActive";
            objGridType.filterRefId = true;

            var configDataWFDEF = makeFieldFeatures(item, objGridType, "grid");

            function safeParseJson(s) {
                if (!s) return {};
                if (typeof s === "object") return s;
                try { return JSON.parse(s); } catch { return {}; }
            }

            function ensurePicKeys(obj) {
                const o = { ...obj };
                DEPTS.forEach(k => { if (!(k in o)) o[k] = null; });
                return o;
            }

            function updatePicMap(form, dept, account) {
                const fd = form.option("formData") || {};
                const current = ensurePicKeys(safeParseJson(fd.PIC));
                current[dept] = account || null;
                form.option("formData.PIC", JSON.stringify(current));
            }

            function initPicIfEmpty(form) {
                const fd = form.option("formData") || {};
                const pic = safeParseJson(fd.PIC);
                const hasAny = pic && Object.keys(pic).length > 0;

                if (!hasAny) {
                    form.option("formData.PIC", JSON.stringify({
                        FO: _loginUser,
                        RE: "an.re",
                        TS: null,
                        UW: null,
                        LMKT: null,
                        PM: null
                    }));
                } else {
                    form.option("formData.PIC", JSON.stringify(ensurePicKeys(pic)));
                }
            }

            function showSurveyAccordion(show) {
                $("#surveyAccordionWrap").toggle(!!show);
                if (show) {
                    $("#surveyAccordion").dxAccordion("instance")?.option("selectedIndex", 0);
                }
            }

            function attachmentTemplate() {
                return {
                    _key: generateGUID(),
                    file: null,
                    fileName: "",
                    fileSize: 0,
                    fileType: "",
                    attachmentType: null,
                    note: "",
                    uploadedPath: "",
                    uploadedName: ""
                };
            }

            function formatFileSize(bytes) {
                if (!bytes || bytes <= 0) return "";
                const units = ["B", "KB", "MB", "GB"];
                let i = 0;
                let val = bytes;
                while (val >= 1024 && i < units.length - 1) {
                    val /= 1024;
                    i++;
                }
                return `${val.toFixed(val >= 10 || i === 0 ? 0 : 2)} ${units[i]}`;
            }

            function entryTemplate() {
                return {
                    _key: generateGUID(),
                    to: null,
                    notes: "",
                    deptTarget: vm.assignedTeamOrRole || "TS"
                };
            }

            function buildAttachmentPayload() {
                return vm.attachments.map(x => ({
                    _key: x._key,
                    attachmentType: x.attachmentType,
                    fileName: x.fileName,
                    fileSize: x.fileSize,
                    fileType: x.fileType,
                    uploadedPath: x.uploadedPath || "",
                    uploadedName: x.uploadedName || "",
                    note: x.note || ""
                }));
            }

            function syncAttachmentToForm() {
                if (that && that.formInstance) {
                    that.formInstance.updateData("attachments", JSON.stringify(buildAttachmentPayload()));
                }
            }

            function validateAttachments() {
                const invalid = vm.attachments.some(x => !x.fileName || !x.attachmentType);
                if (invalid) {
                    DevExpress.ui.notify("Attachment row must have file and document type.", "warning", 2000);
                    return false;
                }
                return true;
            }

            DevExpress.localization.locale("en");

            const vm = {
                subject: "",
                reqPerson: _loginUser,
            reqDate: new Date(2026, 0, 21), // 21-01-2026

            assignmentMode: "manual",     // auto | later | manual
                assignedTeamOrRole: "TS",

            assignees: []               // only for manual mode
            };

            function isManual() {
                return vm.assignmentMode === "manual";
            }

            function buildSummary() {
                const modeLabel =
                    vm.assignmentMode === "auto" ? "AUTO ROUTE" :
                    vm.assignmentMode === "later" ? "ASSIGN LATER" :
                    "MANUAL ASSIGN";
            }

            var that = $("#quotationRequestForm").dxForm({
                formData: vm,
                colCount: 2,
                labelMode: "floating",
                showColonAfterLabel: false,
                items: [
                    {
                        itemType: "group",
                        colSpan: 2,
                        caption: "Quotation Request",
                        items: [
                            { dataField: "PIC", editorType: "dxTextBox", editorOptions: { readOnly: true, value: _loginUser } },
                            { dataField: "createDate", editorType: "dxDateBox", editorOptions: { readOnly: true, displayFormat: "dd-MM-yyyy", value: new Date() } },
                            {
                                dataField: "subject",
                                colSpan: 2,
                                editorType: "dxTextArea",
                                editorOptions: { minHeight: 90 },
                                validationRules: [{ type: "required" }]
                            },
                            { dataField: "clientName", editorType: "dxTextBox", visible: false, editorOptions: { readOnly: true } },

                            {
                                dataField: "clientId",
                                editorType: "dxDropDownBox",
                                isRequired: true,
                                label: { text: "Client" },
                                editorOptions: {
                                    displayExpr: "englishName",
                                    keyExpr: "id",
                                    editorType: "dxDropDownBox",
                                    width: "100%",
                                    dropDownOptions: {
                                        width: _defaultDropDownWidth,
                                        height: _defaultDropDownHeight,
                                    },
                                    showClearButton: true,
                                    dataSource: new DevExpress.data.CustomStore({
                                        key: "id",
                                        load: function (loadOptions) {
                                            return $.ajax({
                                                url: `/api/Client/ExecuteCustomQuery`,
                                                method: "POST",
                                                contentType: "application/json",
                                                data: JSON.stringify(clientQuery)
                                            });
                                        },
                                        byKey: function (key) {
                                            if (key)
                                                return $.ajax({
                                                    url: `/api/Client/DropDownLookupCustomQuery?key=${encodeURIComponent(key)}`,
                                                    method: "POST",
                                                    contentType: "application/json",
                                                    data: JSON.stringify(clientQuery)
                                                }).then(function (result) {
                                                    return Array.isArray(result) ? result[0] : result;
                                                });
                                            else
                                                return new Array();
                                        },
                                    }),
                                    contentTemplate: function (e) {
                                        that.formInstance = that.dxForm("instance");
                                        var item = this;
                                        item.editorOptions = new Object();
                                        item.editorOptions.dataSource = e.component.option("dataSource");

                                        const dataGrid = makeTheClientLocationGrid(item, e, that, $("<div>"), function (selectedItems) {
                                            var hasSelection = selectedItems.selectedRowKeys.length > 0;
                                            if (!hasSelection) return;
                                            const selectedRow = selectedItems.selectedRowsData[0];
                                            e.component.option("value", selectedItems.selectedRowKeys[0]);
                                            that.formInstance.updateData("clientName", selectedRow.englishName);
                                            e.component.close();
                                        });

                                        return dataGrid.container;
                                    }
                                }
                            },

                            { dataField: "requestTypeId", label: { text: "Request Type" }, editorType: "dxSelectBox", isRequired: true, editorOptions: makeSelectBoxEditorOptions(_enums.reqType) },
                            { dataField: "policyNo", label: { text: "Policy No" }, editorType: "dxTextBox" },
                            { dataField: "lineName", editorType: "dxSelectBox", editorOptions: { items: _enums.lineName, searchEnabled: true } },
                            { dataField: "productName", editorType: "dxTextBox", visible: false, editorOptions: { readOnly: true } },
                            {
                                dataField: "productId",
                                editorType: "dxSelectBox",
                                editorOptions: {
                                    label: { text: "Product Name" },
                                    labelMode: "floating",
                                    searchEnabled: true,
                                    valueExpr: "id",
                                    displayExpr: "productName",
                                    dataSource: [],
                                    onInitialized(e) {
                                        ajaxGet("/api/Product/GetAll", null)
                                            .then(list => {
                                                e.component.option("dataSource", list);
                                            });
                                    },
                                    onValueChanged(e) {
                                        that.formInstance = that.dxForm("instance");
                                        that.formInstance.updateData("productName", e.component.option("text"));
                                    }
                                }
                            },
                            { dataField: "businessOccupation", label: { text: "Business Occupation" }, editorType: "dxTextBox" },
                            { dataField: "dueDate", editorType: "dxDateBox", editorOptions: { displayFormat: "dd-MM-yyyy" } },
                            { dataField: "businessChannel", editorType: "dxSelectBox", editorOptions: { items: _enums.businessChannel } },
                            { dataField: "reinsuranceId", label: { text: "Reinsurance" }, editorType: "dxSelectBox", editorOptions: { valueExpr: "id", displayExpr: "value", items: _enums.reinsurance } },

                            {
                                itemType: "simple",
                                colSpan: 2,
                                label: { text: "Is Survey ?" },
                                template: function (data, itemElement) {
                                    const form = data.component;
                                    const fd = form.option("formData") || {};

                                    const $wrap = $("<div>").addClass("survey-field-wrap");
                                    const $row = $("<div>").addClass("survey-field-row").appendTo($wrap);

                                    const $switchHost = $("<div>").appendTo($row);
                                    $("<div>").addClass("survey-field-spacer").appendTo($row);

                                    const $accWrap = $("<div>").addClass("survey-acc-wrap").appendTo($wrap);

                                    $switchHost.dxSwitch({
                                        value: !!fd.surveyNeeded,
                                        onValueChanged: function (e) {
                                            form.option("formData.surveyNeeded", e.value);
                                            $accWrap.toggle(!!e.value);

                                            const acc = $accWrap.find(".survey-acc").dxAccordion("instance");
                                            if (acc) acc.option("selectedIndex", e.value ? 0 : -1);
                                        }
                                    });

                                    const $acc = $("<div>").addClass("survey-acc").appendTo($accWrap);

                                    function updatePic(dept, account) {
                                        const current = ensurePicKeys(safeParseJson(form.option("formData.PIC")));
                                        current[dept] = account || null;
                                        form.option("formData.PIC", JSON.stringify(current));

                                        const picEditor = form.getEditor?.("PIC");
                                        if (picEditor) picEditor.option("value", form.option("formData.PIC"));
                                    }

                                    $acc.dxAccordion({
                                        multiple: false,
                                        collapsible: true,
                                        selectedIndex: fd.surveyNeeded ? 0 : -1,
                                        animationDuration: 180,
                                        dataSource: [{ key: "survey", title: "SURVEY PIC" }],
                                        itemTitleTemplate: (it) => $("<div>").addClass("acc-title").text(it.title),
                                        itemTemplate: (it, idx, el) => {
                                            const $body = $("<div>").addClass("acc-body");
                                            $("<div>").text("Title").css("marginTop", 10).css("fontWeight", "bold").appendTo($body);
                                            const $preview = $("<div>").css("marginTop", 10).appendTo($body);

                                            fd.reTitle = `Request survey to ${fd.clientName} by ${_loginUser}`;

                                            $("<div>").text("Department").css("marginTop", 10).css("fontWeight", "bold").appendTo($body);
                                            const $dept = $("<div>").css("marginTop", 10).appendTo($body);

                                            $("<div>").text("Member").css("marginTop", 10).css("fontWeight", "bold").appendTo($body);
                                            const $accText = $("<div>").css("marginTop", 10).appendTo($body);

                                            $("<div>").text("Message to RE").css("marginTop", 10).css("fontWeight", "bold").appendTo($body);
                                            const $MsgText = $("<div>").css("marginTop", 10).appendTo($body);

                                            $dept.dxSelectBox({
                                                items: DEPTS,
                                                value: "RE",
                                                label: "Department",
                                                labelMode: "static"
                                            });

                                            $accText.dxSelectBox({
                                                items: REMEMS,
                                                label: "Member",
                                                labelMode: "static",
                  onValueChanged: function(e){
                                                    fd.rePIC = e.value;
                                                }
                                            });

                                            $MsgText.dxTextArea({
                                                value: "",
                                                label: "RE Message",
                                                labelMode: "static",
                                                placeholder: "Message to RE team",
                   onValueChanged: function(e){
                                                    fd.reMsg = e.value;
                                                }
                                            });

                                            $preview.dxTextBox({
                                                value: `Request survey to ${fd.clientName} by ${_loginUser}`,
                                                readOnly: true,
                                                height: 50,
                                                label: "RE Title",
                                                labelMode: "static"
                                            });

                                            $(el).append($body);
                                        }
                                    });

                                    $accWrap.toggle(!!fd.surveyNeeded);
                                    itemElement.append($wrap);
                                }
                            },

                            {
                                dataField: "workflowDefinitionId",
                                label: { text: "Workflow" },
                                editorType: "dxDropDownBox",
                                editorOptions: {
                                    displayExpr: "workflowName",
                                    keyExpr: "id",
                                    editorType: "dxDropDownBox",
                                    width: "100%",
                                    dropDownOptions: {
                                        width: _defaultDropDownWidth,
                                        height: _defaultDropDownHeight,
                                    },
                                    showClearButton: true,
                     dataSource:configDataWFDEF.dataSource,
                    
                    contentTemplate:function (e) {
                                        that.formInstance = that.dxForm("instance");
                                        var item = this;
                                        item.editorOptions = new Object();
                                        item.editorOptions.dataSource = e.component.option("dataSource");
                        const dataGrid = makeTheWorkflowGrid(item, e, that, $("<div>"), function(selectedItems){
                                            var hasSelection = selectedItems.selectedRowKeys.length > 0;
                                            if (!hasSelection) return;
                                            const selectedRow = selectedItems.selectedRowsData[0];
                                            e.component.option("value", selectedItems.selectedRowKeys[0].id);

                                            ajaxGet(`/api/WorkflowDefinition/GetStepsList/${selectedRow.guid}`)
                                                .then(data => {
                                                    var roleInStep = data.find(f => f.stepNo == 1);
                                                    var selectBoxIns = that.formInstance.getEditor("assignedTeamOrRole");
                                                    selectBoxIns.option("value", roleInStep.toNodeId);
                                                    vm.assignedTeamOrRole = roleInStep.toNodeId;
                                                });

                                            e.component.close();
                                        });

                                        return dataGrid.container;
                                    }
                                }
                            },

                            {
                                dataField: "attachments",
                                visible: false,
                                editorType: "dxTextArea"
                            }
                        ]
                    },

                    {
                        itemType: "group",
                        colSpan: 2,
                        caption: "Assignment",
                        items: [
                            {
                                dataField: "assignmentMode",
                                colSpan: 2,
                                editorType: "dxSelectBox",
                                editorOptions: {
                                    dataSource: _enums.assignmentMode,
                                    displayExpr: "text",
                                    valueExpr: "id",
                                    onValueChanged(e) {
                                        vm.assignmentMode = e.value;
                                        refreshAssignmentUI();
                                        buildSummary();
                                    }
                                }
                            },
                            {
                                dataField: "assignedTeamOrRole",
                                label: { text: "Assigned Team/Role" },
                                editorType: "dxSelectBox",
                                colSpan: 2,
                                editorOptions: {
                                    dataSource: _enums.teamOrRole,
                                    displayExpr: "text",
                                    valueExpr: "id",
                                    onValueChanged(e) {
                                        vm.assignedTeamOrRole = e.value;
                                        buildSummary();
                                    }
                                }
                            }
                        ]
                    }
                ],
                onInitialized(e) {
                    buildSummary();
                    //that.formInstance = e.component;
                    initPicIfEmpty(e.component);
                    syncAttachmentToForm();
                }
            });

            // var attachmentStore = new DevExpress.data.ArrayStore({
            //     key: "_key",
            //     data: vm.attachments
            // });

            $("#attachmentGrid").dxDataGrid({
                dataSource: [],
                width:"100%",
                keyExpr: "_key",
                showBorders: true,
                columnAutoWidth: true,
                hoverStateEnabled: true,
                repaintChangesOnly: true,
                noDataText: "No attachment. Click 'Add row' to insert.",
                paging: false,
                editing: {
                    mode: "cell",
                    allowAdding: true,
                    allowUpdating: false,
                    allowDeleting: false,
                    useIcons: true
                },
                columns: [
                    {
                        caption: "Upload File",
                        width: 500,
                        allowSorting: false,
                        allowFiltering: false,
                        cellTemplate: function (container, options) {
                                const row = options.data;
                                const rowIndex = options.rowIndex;
                                const newGuid = generateGUID();
                                const $wrap = $("<div>").css({
                                    display: "flex",
                                    flexDirection: "column",
                                    gap: "6px"
                                });
                                const uploadId = "uploadFile_" + rowIndex;
                                const $uploader = $("<div>").attr("id", uploadId).appendTo($wrap);
                                const $meta = $("<div>").addClass("att-file-meta").appendTo($wrap);
                                var item = {};
                                item.editorType = "dxFileUploader";
                                item.moduleName = "qt";
                                item.sectionName = "Quotation";
                                const opts = resolveUploadOptions("uploadFile", item);
                                $uploader.dxFileUploader({
                                    multiple: false,
                                    accept: options.accept || "*/*",
                                    selectButtonText: "Upload File",
                                    dropZone: "#" + uploadId,
                                    labelText: "",
                                    uploadMode: "instantly",
                                    uploadUrl: "/api/Document/AsyncUploadFile",
                                    name: "files",
                                    showFileList: true,
                                    uploadHeaders: {
                                        Folder: opts.folder,
                                        Guid: newGuid
                                    },
                                    onUploadStarted: function (e) {
                                        $uploader.css("position", "relative");
                                        $("#" + uploadId + " .previewLoader").remove();
                                        $("<div>")
                                            .addClass("previewLoader")
                                            .appendTo("#" + uploadId)
                                            .dxLoadPanel({
                                                message: "File loading...",
                                                visible: true,
                                                shading: true,
                                                shadingColor: "rgba(255,255,255,0.7)",
                                                showPane: true,
                                                closeOnOutsideClick: false,
                                                position: { of: "#" + uploadId }
                                            });
                                    },
                                    onUploaded: function (e) {
                                        $("#" + uploadId + " .previewLoader").remove();
                                        let responseObject = {};
                                        try {
                                            responseObject = JSON.parse(e.request.response || "{}");
                                        } catch (ex) {
                                            console.error("Response parse error", ex);
                                        }
                                        row.fileGuid = newGuid;
                                        row.fileName = e.file.name;
                                        row.fileSize = e.file.size;
                                        row.fileType = e.file.type;
                                        row.uploadResponse = responseObject;
                                        $meta.text(`${row.fileName} (${formatFileSize(row.fileSize)})`);
                                    },
                                    onUploadError: function (e) {
                                        $("#" + uploadId + " .previewLoader").remove();
                                        $meta.text("Upload failed");
                                        console.error(e);
                                    }
                                });
                                if (row.fileName) {
                                    $meta.text(`${row.fileName} (${formatFileSize(row.fileSize || 0)})`);
                                }
                                $(container).append($wrap);
                        }
                    },
                    {
                        dataField: "attachmentType",
                        caption: "Document Type",
                        width: 240,
                        lookup: {
                            dataSource: ATTACHMENT_TYPES,
                            valueExpr: "id",
                            displayExpr: "text"
                        },
                        validationRules: [
                            { type: "required", message: "Document Type is required" }
                        ]
                    }
                ],
                toolbar: {
                    items: [
                        {
                            location: "before",
                            widget: "dxButton",
                            options: {
                                icon: "add",
                                text: "Add row",
                                type: "default",
                                onClick: function () {
                                    $("#attachmentGrid").dxDataGrid("instance").addRow();
                                }
                            }
                        }
                    ]
                }
            });

            const assigneeStore = new DevExpress.data.ArrayStore({ key: "_key", data: vm.assignees });

            $("#assigneeList").dxDataGrid({
                dataSource: assigneeStore,
                keyExpr: "_key",
                showBorders: true,
                columnAutoWidth: true,
                hoverStateEnabled: true,
                noDataText: "No manual assignee entry. Switch to Manual assign and click New.",
                paging: { pageSize: 10 },
                pager: { showInfo: true },
                columns: [
                    {
                        dataField: "to",
                        caption: "Assignee",
                        lookup: { dataSource: _enums.assignee, valueExpr: "accountName", displayExpr: "fullName" }
                    },
                    {
                        dataField: "notes",
                        caption: "Notes",
                        cellTemplate(container) {
                            $("<div/>").text("Hidden notes, open entry to view").appendTo(container);
                        }
                    },
                    {
                        type: "buttons",
                        width: 120,
                        buttons: [
                            { hint: "Edit", icon: "edit", onClick(e) { openPopupForEdit(e.row.data); } },
                            {
                                hint: "Delete", icon: "trash",
                                onClick(e) {
                                    assigneeStore.remove(e.row.data._key);
                                    $("#assigneeList").dxDataGrid("instance").refresh();
                                }
                            }
                        ]
                    }
                ]
            });

            var popupFormItems = [
                {
                    dataField: "to",
                    editorType: "dxSelectBox",
                    isRequired: true,
                    editorOptions: { dataSource: _enums.assignee, displayExpr: "fullName", valueExpr: "accountName", searchEnabled: true }
                },
                { dataField: "notes", colSpan: 2, editorType: "dxTextArea", editorOptions: { minHeight: 90 } }
            ];

            var currentEntry = entryTemplate();

            $("#btnNewAssignee").dxButton({
                text: "New",
                icon: "plus",
                type: "default",
                onClick() {
                    openPopupForNew();
                }
            });

            $("#btnClearAssignee").dxButton({
                text: "Clear",
                icon: "trash",
                type: "normal",
                onClick() {
                    vm.assignees.splice(0, vm.assignees.length);
                    $("#assigneeList").dxDataGrid("instance").refresh();
                }
            });

            let popupMode = "new";
            let editingKey = null;

            $("#assigneePopup").dxPopup({
                width: 920,
                height: "auto",
                showTitle: true,
                title: "New Assignee Entry",
                visible: false,
                dragEnabled: true,
                closeOnOutsideClick: true,
                contentTemplate: function (content) {
                    content.empty();

                    ajaxGet("/api/Employee/AssigneeList", vm.assignedTeamOrRole)
                        .then(list => {
                            $("<div id='assignBox'>").appendTo(content).dxForm({
                                formData: {
                                    to: currentEntry.to,
                                    notes: currentEntry.notes,
                                    deptTarget: vm.assignedTeamOrRole
                                },
                                colCount: 2,
                                labelMode: "floating",
                                items: [
                                    {
                                        dataField: "to",
                                        colSpan: 2,
                                        editorType: "dxSelectBox",
                                        validationRules: [{ type: "required" }],
                                        editorOptions: {
                                            dataSource: list,
                                            displayExpr: "fullName",
                                            valueExpr: "accountName",
                                            searchEnabled: true
                                        }
                                    },
                                    {
                                        dataField: "notes",
                                        colSpan: 2,
                                        editorType: "dxTextArea",
                                        label: { text: "Notes" },
                                        editorOptions: {
                                            minHeight: 90
                                        }
                                    }
                                ]
                            });
                        });
                },
                toolbarItems: [
                    {
                        widget: "dxButton",
                        toolbar: "bottom",
                        location: "after",
                        options: {
                            text: "Save",
                            type: "default",
                            onClick: function () {
                                const form = $("#assignBox").dxForm("instance");
                                const result = form.validate();
                                if (!result.isValid) {
                                    DevExpress.ui.notify("Please fill required fields.", "error", 1500);
                                    return;
                                }

                                const data = form.option("formData");
                                data._key = data.to;

                                if (popupMode === "new") {
                                    vm.assignees.push({ ...data });
                                } else {
                                    const idx = vm.assignees.findIndex(x => x._key === editingKey);
                                    if (idx >= 0) vm.assignees[idx] = { ...data };
                                }

                                $("#assigneeList").dxDataGrid("instance").refresh();
                                $("#assigneePopup").dxPopup("instance").hide();
                            }
                        }
                    },
                    {
                        widget: "dxButton",
                        toolbar: "bottom",
                        location: "after",
                        options: {
                            text: "Cancel",
                            onClick: function () {
                                $("#assigneePopup").dxPopup("instance").hide();
                            }
                        }
                    }
                ]
            });

            function openPopupForNew() {
                if (!isManual()) {
                    DevExpress.ui.notify("Switch Assignment Mode to 'Manual assign' to add entries.", "warning", 1800);
                    return;
                }

                popupMode = "new";
                currentEntry = entryTemplate();

                ajaxGet("/api/Employee/AssigneeList", vm.assignedTeamOrRole || "TS")
                    .then(list => {
                        _enums.assignee.push(...list);
                        const popup = $("#assigneePopup").dxPopup("instance");
                        popup.option("title", "New Assignee Entry");
                        popup.show();
                    })
                    .fail(err => {
                        console.log("fail:", err);
                    })
                    .always(() => console.log("always"));
            }

            function openPopupForEdit(row) {
                if (!isManual()) {
                    DevExpress.ui.notify("This list is for Manual assign mode.", "warning", 1600);
                    return;
                }

                popupMode = "edit";
                editingKey = row._key;
                currentEntry = { ...row };

                const popup = $("#assigneePopup").dxPopup("instance");
                popup.option("title", "Edit Assignee Entry");
                popup.show();
            }

            function refreshAssignmentUI() {
                const grid = $("#assigneeList").dxDataGrid("instance");
                const btnNew = $("#btnNewAssignee").dxButton("instance");
                const btnClear = $("#btnClearAssignee").dxButton("instance");

                const enabled = isManual();
                btnNew.option("disabled", !enabled);
                btnClear.option("disabled", !enabled);
                grid.option("disabled", !enabled);
            }

            refreshAssignmentUI();

            // window.getQuotationRequestPayload = function () {

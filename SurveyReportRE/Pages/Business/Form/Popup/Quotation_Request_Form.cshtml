<style>

    #qrPage {
        max-width: 1180px;
        margin: 18px auto;
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,.08);
        padding: 16px;
    }

    .sectionTitle {
        font-size: 14px;
        font-weight: 650;
        margin: 18px 0 10px;
        opacity: .9;
    }

    .dx-form-group-caption {
        font-weight: 650 !important;
    }

    .toolbarRow {
        margin-top: 18px;
        display: flex;
        align-items: center;

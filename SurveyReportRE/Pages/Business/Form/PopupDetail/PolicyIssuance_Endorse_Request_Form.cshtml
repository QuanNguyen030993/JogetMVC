@page "{pageNum:int?}"
@model PolicyIssuance_Endorse_Request_FormModel
@{
    ViewBag.Title = "Policy Issuance Endorse Request";
}

<div id="policyIssuanceEndorseRequestForm"></div>

<script>
    (function () {
        var requestTypes = (typeof _enums !== "undefined" && _enums.requestType) ? _enums.requestType : [];
        var endorseType = requestTypes.find(function (item) {
            return String(item.value || "").toLowerCase() === "endorsement";
        });

        var formData = {
            requestType: "Endorsement",
            requestTypeId: endorseType ? endorseType.id : null,
            requestDate: new Date(),
            dueDate: null,
            policyNo: "",
            policyHolderId: "",
            clientId: null,
            clientName: "",
            subject: "",
            notes: "",
            skipTS: null,
            foPIC: _loginUser
        };

        $("#policyIssuanceEndorseRequestForm").dxForm({
            formData: formData,
            colCount: 2,
            labelMode: "floating",
            showColonAfterLabel: false,
            items: [{
                itemType: "group",
                caption: "Request Information",
                colCount: 2,
                colSpan: 2,
                items: [{
                    dataField: "requestType",
                    label: { text: "Request Type" },
                    editorOptions: { readOnly: true }
                }, {
                    dataField: "foPIC",
                    label: { text: "FO PIC" },
                    editorOptions: { readOnly: true }
                }, {
                    dataField: "requestDate",
                    editorType: "dxDateBox",
                    label: { text: "Request Date" },
                    validationRules: [{ type: "required" }],
                    editorOptions: { displayFormat: "dd-MM-yyyy" }
                }, {
                    dataField: "dueDate",
                    editorType: "dxDateBox",
                    label: { text: "Due Date" },
                    editorOptions: { displayFormat: "dd-MM-yyyy" }
                }, {
                    dataField: "policyNo",
                    label: { text: "Original Policy No" },
                    validationRules: [{ type: "required" }]
                }, {
                    dataField: "policyHolderId",
                    label: { text: "Policy Holder ID" }
                }]
            }, {
                itemType: "group",
                caption: "Client",
                colCount: 2,
                colSpan: 2,
                items: [{
                    dataField: "clientId",
                    editorType: "dxSelectBox",
                    label: { text: "Client" },
                    validationRules: [{ type: "required" }],
                    editorOptions: {
                        valueExpr: "id",
                        displayExpr: "englishName",
                        searchEnabled: true,
                        showClearButton: true,
                        dataSource: new DevExpress.data.CustomStore({
                            key: "id",
                            load: function () {
                                return $.ajax({
                                    url: "/api/Client/ExecuteCustomQuery",
                                    method: "POST",
                                    contentType: "application/json",
                                    data: JSON.stringify("OnSystem")
                                });
                            },
                            byKey: function (key) {
                                if (!key) return null;
                                return $.ajax({
                                    url: `/api/Client/DropDownLookupCustomQuery?key=${encodeURIComponent(key)}`,
                                    method: "POST",
                                    contentType: "application/json",
                                    data: JSON.stringify("OnSystem")
                                }).then(function (result) {
                                    return Array.isArray(result) ? result[0] : result;
                                });
                            }
                        }),
                        onValueChanged: function (e) {
                            var form = $("#policyIssuanceEndorseRequestForm").dxForm("instance");
                            var selected = e.component.option("selectedItem");
                            form.updateData("clientName", selected ? selected.englishName : "");
                        }
                    }
                }, {
                    dataField: "clientName",
                    label: { text: "Client Name" },
                    editorOptions: { readOnly: true }
                }]
            }, {
                itemType: "group",
                caption: "Routing",
                colCount: 2,
                colSpan: 2,
                items: [{
                    dataField: "skipTS",
                    editorType: "dxRadioGroup",
                    label: { text: "Skip TS?" },
                    editorOptions: {
                        items: [{ text: "No - send to TS", value: false }, { text: "Yes - skip TS", value: true }],
                        displayExpr: "text",
                        valueExpr: "value",
                        layout: "horizontal"
                    },
                    validationRules: [{
                        type: "custom",
                        message: "Please select whether this request skips TS.",
                        validationCallback: function (e) {
                            return e.value === true || e.value === false;
                        }
                    }]
                }, {
                    itemType: "empty"
                }, {
                    dataField: "subject",
                    editorType: "dxTextArea",
                    colSpan: 2,
                    label: { text: "Subject" },
                    validationRules: [{ type: "required" }],
                    editorOptions: { height: 80 }
                }, {
                    dataField: "notes",
                    editorType: "dxTextArea",
                    colSpan: 2,
                    label: { text: "Notes" },
                    editorOptions: { height: 90 }
                }]
            }]
        });
    })();
</script>

    function togglePolicyField(e) {
        const form = $("#quotationRequestForm").dxForm("instance");
        var getRequestType = _enums.requestType.find(f => f.id == e.value);
        // Ví dụ: chỉ hiển thị khi value = 'POLICY'
        shouldShow = getRequestType.value === "Endorsement";
        form.itemOption("headerInformation.policyNo", "visible", shouldShow);
        form.repaint();

                if (!s) return {};
                if (typeof s === "object") return s;
                try { return JSON.parse(s); } catch { return {}; }
            }

            function ensurePicKeys(obj) {
                var o = { ...obj };
                DEPTS.forEach(k => { if (!(k in o)) o[k] = null; });

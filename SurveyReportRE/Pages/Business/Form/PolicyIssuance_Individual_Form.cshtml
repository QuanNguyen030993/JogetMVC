                           <path fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"
                                 d="M6 10h12a4 4 0 0 1 4 4v6a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4v-6a4 4 0 0 1 4-4Zm6 4.2
                                    a2 2 0 1 0 0 4a2 2 0 0 0 0-4Zm-.9 3.7
                                    c0-.3.2-.5.5-.6a.9.9 0 1 0 .8 0c.3.1.5.3.5.6V20
                                    a.9.9 0 0 1-1.8 0v-2.1Z"/>
                         </svg> EDIT

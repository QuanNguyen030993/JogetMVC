              function applyEditLock() {
            // demo rule: chỉ edit khi login đúng dept
            const roMKT = !(state.currentUserRole === "FO");
            const roTS = !(state.currentUserRole === "TS");
            // const roUW = !(state.currentUserRole === "UW");

        // =========================
        // 3) Updated time per section
        // =========================
     

           function updateSectionUpdatedTime(q) {
        let tat = {};

        try {
            tat = JSON.parse(q?.turnAroundTimeAttributes || "{}");
        } catch (e) {
            tat = {};
        }

        const map = {
            FO: tat?.FO?.CompleteDate || null,
            TS: tat?.TS?.CompleteDate || null,
            UW: tat?.UW?.CompleteDate || null,
            LMKT: tat?.LMKT?.CompleteDate || null,
            PM: tat?.PM?.CompleteDate || null
        };

        Object.keys(map).forEach(dept => {
            $(`#${formModuleKeyPi}-upd${dept}`).text("Updated: " + fmtTimeLocal(map[dept]));
        });
    }

        // =========================
        // 4) Tree highlight + scroll
        // =========================
        function applyNodeHighlights() {
            $(".dept-node").removeClass("status focus");
            $(`.dept-node[data-key='${stageDept}']`).addClass("status");
            $(`.dept-node[data-key='${state.focusDept}']`).addClass("focus");
        }

        function applySectionFocusHighlight() {
            $(".dept-section").removeClass("focused");
            $(`#${formModuleKeyPi}-sec${state.focusDept}`).addClass("focused");
        }



        function setupDeptTree() {
           $(`.${formModuleKeyPi}-dept-tree.dept-node`).off("click.tree").on("click.tree", function (event) {
                if ($(event.target).closest(".dept-subnode").length) return;
                const key = $(this).data("key");
                state.focusDept = key;

                applyNodeHighlights();
                applySectionFocusHighlight();
                applyEditLock();
                updateHints();
                scrollToDept(formModuleKeyPi,state.focusDept);

                // optional: auto expand focused dept
                setSectionCollapsed(state.focusDept, false);
            });
            bindDeptTreeScrollSpy(formModuleKeyPi, null);
        }

      
        function layoutTreeLine() {
            const $stack = $(`#${formModuleKeyPi}-treeStack`);
            const $nodes = $stack.find(".dept-node");
            const $line = $(`#${formModuleKeyPi}-treeVLine`);
            if (!$nodes.length) return;

            const stackRect = $stack[0].getBoundingClientRect();
            const first = $nodes[0].getBoundingClientRect();
            const last = $nodes[$nodes.length - 1].getBoundingClientRect();

            const topInside = (first.top - stackRect.top) + (first.height / 2);
            const bottomInside = (last.top - stackRect.top) + (last.height / 2);

            $line.css({ top: `${topInside}px`, height: `${bottomInside - topInside}px` });
        }


        // =========================

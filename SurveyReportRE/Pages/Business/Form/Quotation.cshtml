@page
@model QuotationModel
@{

}
<script>
    $(function () {
        var mGridOption = new Object();
        var _loginAccount = window._loginAccount || _loginUser;
        mGridOption.isAllowRowMenu = true;
        mGridOption.isShowingRenewButton = true;
        mGridOption.refOperator = "contains";
        mGridOption.refKey = _loginUser;
        mGridOption.refField = "pic";
        if (!_isSuperUser)
        {
        if (_roleAppName == "Leader")
            mGridOption.refField = "leaderPIC";
        if (_roleAppName == "HOD")
            mGridOption.refField = "hodpic";    

        // Current-stage access: both department role and assigned account must match.
        mGridOption.refKey5 = _role;
        mGridOption.refField5 = "stageDept";
        mGridOption.refOperator5 = "=";
        mGridOption.refKey6 = _loginAccount;
        mGridOption.refField6 = "stageAccount";
        mGridOption.refOperator6 = "=";
        }
        mGridOption.refKey2 = "Quotation confirmed";
        mGridOption.refField2 = "workflowStatus";
        mGridOption.refOperator2 = "<>";
        mGridOption.refKey3 = "Quotation refused";
        mGridOption.refField3 = "workflowStatus";
        mGridOption.refOperator3 = "<>";
        mGridOption.refKey4 = "Cancelled";
        mGridOption.refField4 = "workflowStatus";
        mGridOption.refOperator4 = "<>";
        // mGridOption.refField2 = "isView";
        // mGridOption.refKey2 = true;
        //Pending filterName refactor
        var mGrid = new MGrid(null, $(`#dataGrid_@QuotationModel.ModelName`), new QuotationGridOption('@QuotationModel.ModelName', "User", mGridOption), null);
         
    });
</script>
<div id="dataGrid_@QuotationModel.ModelName"></div>

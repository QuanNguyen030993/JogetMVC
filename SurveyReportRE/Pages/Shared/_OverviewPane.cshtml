@using JogetMVC.Model
@model OverviewPanePartialModel

@{
    string Id(string name) => $"{Model.Prefix}-{name}_{Model.Id}";
    string Css(string name) => $"{Model.Prefix}-{name}";
    var moduleCode = (Model.ModuleCode ?? "").Trim().ToLower();
    var maintenanceInstanceId = string.IsNullOrWhiteSpace(Model.Id) ? "individual" : Model.Id;
    var quotationId = Convert.ToInt64(ViewData["Id"]);
}

<div id="@Id("overviewRoot")" class="pane pane-right">
    <section class="card">
        <div class="@Css("cardHeader")">
            <div class="overview-header-main">
                <div class="h">@Model.Title</div>
                @* <span id="@ViewIdHelper.DetailStatus(moduleCode,quotationId)" class="statusTag">-</span> *@
                <span id="@ViewIdHelper.StageDeptPill(moduleCode,quotationId)"
                      class="overview-status-pill"
                      aria-live="polite"
                      aria-busy="true"></span>
            </div>
            <div class="overview-header-flow">
                <div id="@ViewIdHelper.PanelHoverInFlow(moduleCode,quotationId)"></div>
            </div>
            <div class="overview-header-actions">
                <div id="@Id("btnRefreshOverview")"></div>
                <div id="@ViewIdHelper.BtnCollapseAllTab(moduleCode,quotationId)"></div>
                <div id="@ViewIdHelper.BtnToggleReferenceFields(moduleCode,quotationId)"></div>
                <div id="@ViewIdHelper.BtnAttachmentLog(moduleCode,quotationId)"></div>
                <div id="@ViewIdHelper.BtnToggleComment(moduleCode,quotationId)"></div>
                <div id="@ViewIdHelper.BtnPreview(moduleCode,quotationId)"></div>
                <!-- Admin Maintenance Floating -->
                <div id="@Id("adminFloat")" class="admin-float">

                    <div id="@Id("adminFloatBtn")"
                            class="admin-tool-btn"
                            title="Maintenance">
                        <i class="fa fa-wrench" aria-hidden="true"></i>
                    </div>

                </div>
            </div>
        </div>

        <div class="cardBody overview-wrap" style="padding:0">

            <div id="@ViewIdHelper.FlowPanel(moduleCode,quotationId)" class="flow-panel">
             </div>
            <div id="@ViewIdHelper.FlowHistoryPanel(moduleCode,quotationId)" class="flow-history-panel">
                <div class="fh-title">
                    <span>Flow History</span>
                    <span id="@ViewIdHelper.FlowSummary(moduleCode,quotationId)" class="fh-sub">-</span>
                </div>
                <div id="@ViewIdHelper.FlowHistoryBody(moduleCode,quotationId)" class="fh-flow">
                    <div style="color:var(--c-6b7280);font-size:12px;padding:6px 4px;">Hover tree to load…</div>
                </div>
            </div>

            <div id="@Id("commentPanel")" class="comment-tooltip" style="display:none;">
                <div class="ct-title">
                    <span>Audit Log</span>
                    <span id="@Id("commentPanelSub")" class="ct-sub">-</span>
                    <span class="ct-actions">
                        <a href="javascript:void(0)" id="@Id("btnCloseCommentPanel")" class="ct-close">✕</a>
                    </span>
                </div>
                <div id="@Id("commentPanelList")" class="ct-list">
                    <div style="color:var(--c-6b7280);font-size:12px;padding:6px 4px;">Click “Comments” to load…</div>
                </div>
            </div>

            <!-- 1. DeptTree -->
            <partial name="_DeptTree" model='new DeptTreePartialModel
            {
                Prefix = Model.Prefix,
                ModuleCode = Model.ModuleCode,
                Id = Model.Id,
                Guid = Model.Guid
            }' />

            <!-- 2. OverviewScroll -->
            <partial name="_OverviewScroll" model='new OverviewScrollPartialModel
            {
                Prefix = Model.Prefix,
                ModuleCode = Model.ModuleCode,
                Id = Model.Id,
                Guid = Model.Guid,
                CloneId = Model.CloneId,
                CopyFromGuid = Model.CopyFromGuid
            }' />
        </div>
    </section>

    <aside id="@Id("roleSwitcherFloat")"
           class="maintenance-role-float"
           aria-label="Switch maintenance role">
        <div class="maintenance-role-float-label">
            <i class="fa fa-user-shield" aria-hidden="true"></i>
            <span>Switch role</span>
        </div>
        <div id="@(Model.Prefix)-roleSelect_@maintenanceInstanceId"
             class="maintenance-role-select"></div>
    </aside>
</div>
<script>
    $(function () {
        $("#@Id("btnRefreshOverview")").dxButton({
            icon: "refresh",
            hint: "Refresh",
            stylingMode: "text",
            onClick: function (e) {
                window.reloadOverviewViewComponents("@moduleCode", @quotationId, e.element, true);
            }
        });

        const btn =
            $("#@Id("adminFloatBtn")");


        const panelId =
            "@Id("adminInfoPanel")";

        // The panel lives under body, outside the overview root. Remove a panel
        // left by an earlier render of the same record before creating a new one.
        $(document.getElementById(panelId)).remove();

        // tạo panel bằng JS
        const panel = $(`
            <div id="${panelId}" class="admin-info-panel">

                <div class="admin-title">
                    <span>Maintenance Info</span>
                    <span class="admin-close">✕</span>
                </div>


                <div class="admin-row">
                    <label>ID</label>
                    <span>${'@Model.Id'}</span>
                </div>


                <div class="admin-row">
                    <label>GUID</label>
                    <span>${'@Model.Guid'}</span>
                </div>

                <div class="admin-row">
                    <label>Person in Charge (PIC)</label>
                    <div class="maintenance-value-list" data-maintenance-pic>
                        <span class="maintenance-empty">-</span>
                    </div>
                </div>

                <div class="admin-row">
                    <label>Leader PIC</label>
                    <div class="maintenance-value-list" data-maintenance-leader-pic>
                        <span class="maintenance-empty">-</span>
                    </div>
                </div>

                <div class="admin-row">
                    <label>HOD PIC</label>
                    <div class="maintenance-value-list" data-maintenance-hod-pic>
                        <span class="maintenance-empty">-</span>
                    </div>
                </div>


                <div class="admin-row">
                    <label>Turnaround Time</label>
                    <div class="maintenance-value-list" data-maintenance-tat>
                        <span class="maintenance-empty">-</span>
                    </div>
                </div>

            </div>
        `);


        $("body").append(panel);
        const canSwitchMaintenanceRole =
            String(window._isDebugMode).toLowerCase() === "true"
            || String(window._isSuperUser).toLowerCase() === "true";
        const $maintenanceRoleFloat = $("#@Id("roleSwitcherFloat")");
        $maintenanceRoleFloat.toggleClass("is-visible", canSwitchMaintenanceRole);

        const $maintenanceRoleSelect = $maintenanceRoleFloat.find(".maintenance-role-select");
        let syncingMaintenanceRole = false;

        function getMaintenanceRoleState() {
            const page = "@moduleCode" === "pi"
                ? window.PolicyIssuancePage
                : window.QuotationPage;
            return page?.state;
        }

        function getMaintenanceRoles(targetModuleCode = "@moduleCode") {
            const roles = String(targetModuleCode || "").trim().toLowerCase() === "pi"
                ? window.piDeptModuleCode
                : window.qtDeptModuleCode;
            return Array.isArray(roles)
                ? roles.map(role => String(role).trim()).filter(Boolean)
                : [];
        }

        function getMaintenanceCurrentRole() {
            const labelRole = $(`#@Model.Prefix-loginRoleLabel`).text().trim();
            return labelRole
                || getMaintenanceRoleState()?.currentUserRole
                || String(window._role || "").trim();
        }

        function ensureMaintenanceRoleSelect() {
            if (!canSwitchMaintenanceRole || !$maintenanceRoleSelect.length) return;

            const roles = getMaintenanceRoles();
            const currentRole = getMaintenanceCurrentRole();
            const selectedRole = roles.find(role =>
                role.localeCompare(currentRole, undefined, { sensitivity: "base" }) === 0
            ) || null;
            const options = {
                dataSource: roles.slice(),
                value: selectedRole,
                placeholder: "Select role...",
                stylingMode: "outlined",
                width: "100%",
                searchEnabled: true,
                dropDownOptions: {
                    zIndex: 32010,
                    wrapperAttr: {
                        class: "maintenance-role-dropdown"
                    }
                },
                onValueChanged: function (e) {
                    if (syncingMaintenanceRole || !e.value) return;

                    $(document).trigger("overviewMaintenanceRoleChanged", [{
                        moduleCode: "@moduleCode",
                        recordId: "@maintenanceInstanceId",
                        role: e.value
                    }]);
                    DevExpress.ui.notify("Role switched: " + e.value, "info", 1200);
                }
            };

            const instance = $maintenanceRoleSelect.hasClass("dx-selectbox")
                ? $maintenanceRoleSelect.dxSelectBox("instance")
                : null;
            if (!instance) {
                $maintenanceRoleSelect.dxSelectBox(options);
                return;
            }

            syncingMaintenanceRole = true;
            instance.option(options);
            syncingMaintenanceRole = false;
        }

        ensureMaintenanceRoleSelect();

        function parseMaintenanceMap(value) {
            if (!value) return {};
            if (typeof value === "object") return value;
            try {
                const parsed = JSON.parse(value);
                return parsed && typeof parsed === "object" ? parsed : {};
            } catch (error) {
                console.warn("Maintenance info JSON could not be parsed.", error);
                return {};
            }
        }

        function maintenanceLabel(value) {
            return String(value || "")
                .replace(/([a-z])([A-Z])/g, "$1 $2")
                .replace(/[_-]+/g, " ")
                .replace(/\b\w/g, character => character.toUpperCase());
        }

        function maintenanceText(value) {
            if (value == null || value === "") return "-";
            if (Array.isArray(value)) return value.filter(Boolean).join(", ") || "-";
            if (typeof value !== "object") return String(value);

            const details = Object.entries(value)
                .filter(([, detail]) => detail != null && detail !== "")
                .map(([name, detail]) => `${maintenanceLabel(name)}: ${maintenanceText(detail)}`);
            return details.join(" · ") || "-";
        }

        function renderMaintenanceMap($container, rawValue) {
            const valueMap = parseMaintenanceMap(rawValue);
            const entries = Object.entries(valueMap)
                .filter(([, value]) => value != null && value !== "");

            $container.empty();
            if (!entries.length) {
                $("<span>", { class: "maintenance-empty", text: "-" }).appendTo($container);
                return;
            }

            entries.forEach(([name, value]) => {
                const $entry = $("<div>", { class: "maintenance-value-item" }).appendTo($container);
                $("<strong>").text(maintenanceLabel(name)).appendTo($entry);
                $("<span>").text(maintenanceText(value)).appendTo($entry);
            });
        }

        function renderMaintenancePic($container, rawValue, departments) {
            const valueMap = parseMaintenanceMap(rawValue);
            const hasValue = Object.values(valueMap)
                .some(value => value != null && value !== "");

            $container.empty();
            if (!hasValue) {
                $("<span>", { class: "maintenance-empty", text: "-" }).appendTo($container);
                return;
            }

            $container.append(renderPicInline(valueMap, departments));
        }

        function renderMaintenanceFields($targetPanel, formData, targetModuleCode = "@moduleCode") {
            formData = formData || {};
            const departments = getMaintenanceRoles(targetModuleCode);
            renderMaintenancePic(
                $targetPanel.find("[data-maintenance-pic]"),
                formData.pIC ?? formData.pic ?? formData.PIC,
                departments
            );
            renderMaintenancePic(
                $targetPanel.find("[data-maintenance-leader-pic]"),
                formData.leaderPIC ?? formData.leaderPic ?? formData.LeaderPIC,
                departments
            );
            renderMaintenancePic(
                $targetPanel.find("[data-maintenance-hod-pic]"),
                formData.hodpic ?? formData.hodPIC ?? formData.hODPIC ?? formData.HODPIC,
                departments
            );
            renderMaintenanceMap(
                $targetPanel.find("[data-maintenance-tat]"),
                formData.turnAroundTimeAttributes
                    ?? formData.turnaroundTimeAttributes
                    ?? formData.TurnAroundTimeAttributes
            );
        }

        function renderMaintenanceInfo(formData) {
            renderMaintenanceFields(panel, formData);
        }

        function reloadMaintenanceInfo() {
            const controller = "@moduleCode" === "pi" ? "PolicyIssuance" : "Quotation";
            panel.find(".maintenance-value-list")
                .empty()
                .append($("<span>", { class: "maintenance-empty", text: "Loading..." }));

            return $.ajax({
                url: `/api/${controller}/GetAll`,
                method: "GET",
                data: {
                    key: "@Model.Id",
                    _: Date.now()
                },
                cache: false
            }).then(function (response) {
                const formData = Array.isArray(response) ? response[0] : response;
                renderMaintenanceInfo(formData || {});
                return formData;
            }).catch(function (error) {
                renderMaintenanceInfo({});
                console.warn("Maintenance info could not be reloaded.", error);
                return null;
            });
        }

        window.updateOverviewMaintenanceInfo = function (targetModuleCode, recordId, formData) {
            const targetPanelId = `${String(targetModuleCode || "").trim().toLowerCase()}-adminInfoPanel_${recordId}`;
            const $targetPanel = $(document.getElementById(targetPanelId));
            if (!$targetPanel.length) return;

            renderMaintenanceFields($targetPanel, formData, targetModuleCode);
        };



        btn.on("click", function (e) {

            e.stopPropagation();

            const willShow = !panel.hasClass("show");
            panel.toggleClass("show", willShow);
            if (willShow) {
                ensureMaintenanceRoleSelect();
                reloadMaintenanceInfo();
            }

        });



        panel.find(".admin-close")
            .on("click", function () {

                panel.removeClass("show");

            });



        $(document).on("click", function () {

            panel.removeClass("show");

        });



        panel.on("click", function (e) {

            e.stopPropagation();

        });


    });
</script>

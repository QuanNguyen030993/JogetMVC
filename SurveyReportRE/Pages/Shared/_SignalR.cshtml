</style>
<div id="itServerLogAlertStack" role="region" aria-label="Server error alerts" aria-live="polite"></div>
<div id="itServerLogDetailPopup"></div>

<script>

    let signalRMessageCount = 0;
    const serverLogAlertIds = new Set();
    let serverLogDetailPopup = null;

function ensureServerLogDetailPopup() {
    if (serverLogDetailPopup) return serverLogDetailPopup;

    serverLogDetailPopup = $("#itServerLogDetailPopup").dxPopup({
        width: "min(900px, 92vw)",
        height: "min(720px, 86vh)",
        title: "Server exception detail",
        showCloseButton: true,
        dragEnabled: true,
        hideOnOutsideClick: false,
        contentTemplate: function (contentElement) {
            $("<div>", {
                id: "itServerLogDetailContent",
                class: "it-server-log-detail"
            }).appendTo(contentElement);
        }
    }).dxPopup("instance");
    return serverLogDetailPopup;
}

function renderServerLogDetail(detail) {
    const $content = $("#itServerLogDetailContent").empty();
    const read = (camelName, pascalName) => detail?.[camelName] ?? detail?.[pascalName] ?? "";
    const occurredAt = read("occurredAt", "OccurredAt");
    const meta = [
        ["Level", read("level", "Level")],
        ["Source", read("source", "Source")],
        ["Trace ID", read("traceId", "TraceId")],
        ["Occurred", occurredAt ? new Date(occurredAt).toLocaleString() : ""]
    ];
    const $meta = $("<dl>", { class: "it-server-log-detail__meta" });
    meta.forEach(function (item) {
        $meta.append($("<dt>").text(item[0]));
        $meta.append($("<dd>").text(item[1] || "—"));
    });
    $content.append($meta);
    $content.append($("<strong>").text("Message"));
    $content.append($("<pre>", { class: "it-server-log-detail__block" }).text(read("message", "Message")));

    const exception = read("exception", "Exception");
    if (exception) {
        $content.append($("<strong>").text("Exception / Stack trace"));
        $content.append($("<pre>", { class: "it-server-log-detail__block" }).text(exception));
    } else {
        $content.append($("<strong>").text("Exception / Stack trace"));
        $content.append($("<pre>", { class: "it-server-log-detail__block" })
            .text("No Exception object was attached to this Error log. Use Log.Error(exception, message) to include the stack trace."));
    }

    const properties = read("properties", "Properties");
    if (properties) {
        $content.append($("<strong>").text("Log properties"));
        $content.append($("<pre>", { class: "it-server-log-detail__block" }).text(properties));
    }
}

function openServerLogDetail(alertId, inlineDetail) {
    if (!alertId) return;
    const popup = ensureServerLogDetailPopup();
    popup.show();
    if (inlineDetail) {
        // dxPopup renders its content template during show(); defer one tick so
        // the detail container always exists on the first click.
        setTimeout(() => renderServerLogDetail(inlineDetail), 0);
        return;
    }
    $("#itServerLogDetailContent").text("Loading exception detail...");

    $.ajax({
        url: "/api/ServerLogAlert/Detail",
        method: "GET",
        data: { id: alertId }
    }).done(renderServerLogDetail).fail(function (xhr) {
        const message = xhr.responseJSON?.message
            || (xhr.status === 403 ? "You do not have permission to view this exception." : "Unable to load exception detail.");
        $("#itServerLogDetailContent").text(message);
    });
}

function showServerLogAlert(alert) {
    const canViewTechnicalAlerts = _isSuperUser === true
        || String(_role || "").trim().toUpperCase() === "IT";
    if (!canViewTechnicalAlerts || !alert) return;

    const alertId = String(alert.id || alert.Id || "");
    if (alertId && serverLogAlertIds.has(alertId)) return;
    if (alertId) {
        serverLogAlertIds.add(alertId);
        setTimeout(() => serverLogAlertIds.delete(alertId), 60000);
    }

    const level = String(alert.level || alert.Level || "Error");
    const message = String(alert.message || alert.Message || "A server error was logged.");
    const source = String(alert.source || alert.Source || "Server").split(".").pop();
    const traceId = String(alert.traceId || alert.TraceId || "");
    const occurredAt = alert.occurredAt || alert.OccurredAt;
    const inlineDetail = alert.detail || alert.Detail || null;
    const timeText = occurredAt
        ? new Date(occurredAt).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit", second: "2-digit" })
        : "";

    const $item = $("<section>", { class: "it-server-log-alert" });
    const $heading = $("<div>", { class: "it-server-log-alert__heading" });
    $heading.append($("<span>").text(`${level} · ${source || "Server"}`));
    $heading.append($("<button>", {
        class: "it-server-log-alert__close",
        type: "button",
        title: "Dismiss",
        "aria-label": "Dismiss server error alert"
    }).text("×"));
    $item.append($heading);
    $item.append($("<div>", { class: "it-server-log-alert__message" }).text(message));

    const metaParts = [timeText];
    if (traceId) metaParts.push(`Trace: ${traceId}`);
    metaParts.push("Click to view exception");
    $item.append($("<div>", { class: "it-server-log-alert__meta" }).text(metaParts.filter(Boolean).join(" · ")));

    const $stack = $("#itServerLogAlertStack");
    $stack.append($item);
    // Keep this as a single unobtrusive floating notice; the full history is
    // still available in the Serilog view/table.
    while ($stack.children().length > 1) $stack.children().first().remove();
    requestAnimationFrame(() => $item.addClass("is-visible"));

    const removeAlert = function () {
        $item.removeClass("is-visible");
        setTimeout(() => $item.remove(), 220);
    };
    $item.find(".it-server-log-alert__close").on("click", removeAlert);
    $item.on("click", function (event) {
        if ($(event.target).closest(".it-server-log-alert__close").length) return;
        openServerLogDetail(alertId, inlineDetail);
    });
    setTimeout(removeAlert, 9000);
}

function setSignalRStatus(status) {

    const panel = $("#signalRMonitor");

    panel.removeClass(
        "signalr-connected signalr-reconnecting signalr-disconnected"
    );

    switch (status) {

        case "connected":
            panel.addClass("signalr-connected");
            panel.find(".signalr-text").text("Online");
            break;

        case "reconnecting":
            panel.addClass("signalr-reconnecting");
            panel.find(".signalr-text").text("Reconnecting");
            break;

        default:
            panel.addClass("signalr-disconnected");
            panel.find(".signalr-text").text("Offline");
            break;
    }
}


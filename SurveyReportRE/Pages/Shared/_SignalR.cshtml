<style>
    #itServerLogAlertStack {
        position: fixed;
        right: 18px;
        bottom: 18px;
        z-index: 2147483000;
        display: flex;
        width: min(360px, calc(100vw - 32px));
        flex-direction: column;
        gap: 10px;
        pointer-events: none;
    }

    .it-server-log-alert {
        padding: 12px 14px;
        overflow: hidden;
        color: #f8fafc;
        border: 1px solid rgba(248, 113, 113, .42);
        border-left: 4px solid #ef4444;
        border-radius: 10px;
        background: rgba(30, 41, 59, .97);
        box-shadow: 0 16px 38px rgba(15, 23, 42, .28);
        opacity: 0;
        transform: translateY(12px);
        transition: opacity .2s ease, transform .2s ease;
        pointer-events: auto;
        cursor: pointer;
    }

    .it-server-log-alert.is-visible {
        opacity: 1;
        transform: translateY(0);
    }

    .it-server-log-alert__heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 5px;
        font-size: 12px;
        font-weight: 750;
    }

    .it-server-log-alert__close {
        padding: 0;
        color: #cbd5e1;
        border: 0;
        background: transparent;
        font-size: 18px;
        line-height: 1;
    }

    .it-server-log-alert__message {
        display: -webkit-box;
        overflow: hidden;
        color: #f1f5f9;
        font-size: 12px;
        line-height: 1.45;
        overflow-wrap: anywhere;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 3;
    }

    .it-server-log-alert__meta {
        margin-top: 7px;
        color: #94a3b8;
        font-size: 10px;
        overflow-wrap: anywhere;
    }

    .it-server-log-detail {
        height: 100%;
        padding: 4px 8px 16px;
        overflow: auto;
        box-sizing: border-box;
    }

    .it-server-log-detail__meta {
        display: grid;
        grid-template-columns: max-content minmax(0, 1fr);
        gap: 6px 12px;
        margin-bottom: 14px;
        font-size: 12px;
    }

    .it-server-log-detail__meta dt {
        color: #64748b;
        font-weight: 700;
    }

    .it-server-log-detail__meta dd {
        margin: 0;
        overflow-wrap: anywhere;
    }

    .it-server-log-detail__block {
        margin: 12px 0 0;
        padding: 12px;
        overflow: auto;
        color: #e2e8f0;
        border-radius: 8px;
        background: #0f172a;
        font: 11px/1.55 Consolas, "Courier New", monospace;
        white-space: pre-wrap;
        overflow-wrap: anywhere;

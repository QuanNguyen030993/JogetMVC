                                });
                            };
                        } else if (!item || typeof item !== "object" || item.useDefaultDecisionClick !== false) {
                            defaultButtonOptions.onClick = buildDefaultDecisionClick(objSnapshot);
                        }
                        if (item && typeof item === "object") {
                            if (item.text) defaultButtonOptions.text = item.text;
                            if (item.icon) defaultButtonOptions.icon = item.icon;
                            if (item.type) defaultButtonOptions.type = item.type;
                        }
                        instance.value.option(defaultButtonOptions);
                        applyTransitionButtonClass(`#${buttonId}`, item, item?.buttonClass);
                        if (item?.buttonColor || item?.backgroundColor) {
                            $(`#${buttonId}`).find(".dx-button").css(
                                "background-color",
                                item.buttonColor || item.backgroundColor
                            );
                        }
                }
            }

        //Pending decision features
         function setDecisionButtonsDisabled(items, disabled) {
             $.each(items, function(itemIndex, item) {
                 if (!item) return;
                 try {
                     var element = document.getElementById(item);
                     if (!element || !element.classList.contains("dx-button")) return;
                     DevExpress.ui.dxButton.getInstance(element)?.option("disabled", !!disabled);
                 } catch (error) {
                     console.warn("Unable to update decision button state.", item, error);
                 }
             });
         }

         function disableAllDecisionButton(items) {
             setDecisionButtonsDisabled(items, true);
         }

          function enableAllDecisionButton(items) {
             setDecisionButtonsDisabled(items, false);
         }

    function getDecisionRenderedObjects(formProps, decisionItems, legacyStatusId, buttonRule) {
        decisionItems = normalizeDecisionFieldButtons(decisionItems || []);
        buttonRule = buttonRule || {};

        function isRuleLocked() {
            return buttonRule.disabled === true;
        }

        var statusId = getDecisionFieldStatusId(
            formProps,
            decisionItems,
            legacyStatusId
        );

        var actionHostId = getDecisionFieldActionHostId(formProps);

        var $status = statusId
            ? $(`#${statusId}`)
            : $();

        var $actionHost = actionHostId
            ? $(`#${actionHostId}`)
            : $();

        var buttons = decisionItems
            .map(function (item) {
                var buttonId = getDelayAcceptButtonId(item);

                if (!buttonId) {
                    return null;
                }

                var $button = $(`#${buttonId}`);

                var instance = $button.length
                    ? $button.dxButton("instance")
                    : null;

                return {
                    id: buttonId,

                    config: item,

                    element: $button[0] || null,

                    $element: $button,

                    instance: instance,

                    enable: function () {
                        instance?.option("disabled", isRuleLocked());
                        return this;
                    },

                    disable: function () {
                        instance?.option("disabled", true);
                        return this;
                    },

                    setDisabled: function (disabled) {
                        instance?.option("disabled", isRuleLocked() || !!disabled);
                        return this;
                    },

                    setVisible: function (visible) {
                        instance?.option("visible", !!visible);
                        return this;
                    },

                    option: function (name, value) {
                        if (!instance) {
                            return undefined;
                        }

                        if (arguments.length === 1) {
                            return instance.option(name);
                        }

                        instance.option(name, value);

                        return this;
                    }
                };
            })
            .filter(Boolean);

        var primaryButton = buttons[0] || null;

        return {
            formProps: formProps,

            status: {
                id: statusId,

                element: $status[0] || null,

                $element: $status,

                setText: function (text) {
                    $status.text(text ?? "");
                    return this;
                },

                show: function () {
                    $status.show();
                    return this;
                },

                hide: function () {
                    $status.hide();
                    return this;
                }
            },

            actionHost: {
                id: actionHostId,
                element: $actionHost[0] || null,
                $element: $actionHost
            },

            buttons: buttons,

            primaryButton: primaryButton,

            enable: function () {
                buttons.forEach(function (button) {
                    button.enable();
                });

                return this;
            },

            disable: function () {
                buttons.forEach(function (button) {
                    button.disable();
                });

                return this;
            },

            setDisabled: function (disabled) {
                buttons.forEach(function (button) {
                    button.setDisabled(disabled);
                });

                return this;
            },

            getButton: function (buttonId) {
                return buttons.find(function (button) {
                    return button.id === buttonId;
                }) || null;
            }
        };
    }

</script>

                                       formId: formDataClone.formId,
                                       dept: formDataClone.dept,
                                       formItems: latestFormItems,
                                       tatObject: latestTatObject,
                                       config: item
                                   });
                                   return;
                               }
                               applyDelayDecisionButton(formDataClone, item);

                               if (item && typeof item === "object" && typeof item.loadRouteButtons === "function") {
                                   item.loadRouteButtons({
                                       formId: formDataClone.formId,
                                       dept: formDataClone.dept,
                                       formItems: latestFormItems,
                                       tatObject: latestTatObject,
                                       config: item
                                   });
                               }
                           });
                          var finalDecisionStatus = getDecisionCommonStatus(
                                    latestFormItems,
                                    formDataClone.dept,
                                    latestTatObject
                            );

                          setDecisionCommonStatus(
                                commonStatusId,
                                "onLoading",
                                finalDecisionStatus.title || finalDecisionStatus.text
                            );

                      if (latestTatObject?.[formDataClone.dept]?.AcceptDate)
                      {
                          if (formDataClone.dept != "FO") //exception for FO
                             disableAllDecisionButton(buttonItems.map(item => getDelayAcceptButtonId(item)), latestFormItems);
                              var acceptButtonId = getDelayAcceptButtonId(params[0]);
                              var skipAcceptedMainFields = params[0] && typeof params[0] === "object" && params[0].skipAcceptedMainFields;
                              if (acceptButtonId)
                                 {
                                  if (!skipAcceptedMainFields) {
                                      if (mainField) {
                                            form.option("items", [
                                                ...form.option("items"),
                                                ...mainField
                                            ]);
                                        }
                                        else {
                                            form.option("items", [
                                                ...form.option("items"),
                                                ]);
                                        }
                                  }
                              }

                               updateDelayAcceptStatus(
                                   commonStatusId,
                                   latestTatObject[formDataClone.dept]?.AcceptDate
                               );
                      } // if TAT Accept and Button Accept
                      else {
                              if (params.length > 0)
                              {
                                   updateDelayAcceptStatus(
                                       commonStatusId,
                                       latestTatObject[formDataClone.dept]?.AcceptDate
                                   );
                              }
                          }
                         if (formDataClone.dept == "FO"){

                             if (formItems.stageDept == "Client") { //  another logic

                                      var storedStatus = getDelayAcceptStoredStatus(formItems, formItems.stageDept, formItems);
                                      if (storedStatus != "Accepted")
                                         {
                                              updateDelayAcceptStatus(
                                              commonStatusId,
                                              latestTatObject[formDataClone.dept]?.CompleteDate, storedStatus
                                          );
                                          console.log(buttonItems);
                                          disableAllDecisionButton(buttonItems.map(item => getDelayAcceptButtonId(item)), latestFormItems);
                                          return;
                                      }

                              }
                              else {
                                  updateDelayAcceptStatus(
                                  commonStatusId,
                                  null);
                                  return;
                              }

                          }


                          if (latestFormItems.actionStatus) // trend to priority this field
                          {
                                  updateDelayAcceptStatus(
                                  commonStatusId,
                                  latestTatObject[formDataClone.dept]?.AcceptDate,
                                  customStatus[formDataClone.dept]
                                  );
                                  disableAllDecisionButton(buttonItems.map(item => getDelayAcceptButtonId(item)), latestFormItems);
                          }
                          setDecisionButtonsDisabled(
                              buttonItems.map(item => getDelayAcceptButtonId(item)),
                              shouldDisableWorkflowButton({
                                  dept: formDataClone.dept,
                                  stageDept: latestFormItems.stageDept,
                                  formItems: latestFormItems,
                                  tatObject: latestTatObject,
                                  type: "late-decision",
                                  items: buttonItems.map(item => getDelayAcceptButtonId(item))
                              })
                          );

    }, _delayUnlockForm);



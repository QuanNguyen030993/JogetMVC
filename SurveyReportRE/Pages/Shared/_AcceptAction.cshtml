<script>
    // ITAcceptDemo: temporary UI-only switch for IT testing.
    window.ITAcceptDemo = window.ITAcceptDemo || Object.freeze({
        enabled: true,
        role: "IT",
        requireDebugOrSuperUser: true
    });

    function isITAcceptDemoEnabled(formProps) {
        var config = window.ITAcceptDemo;
        if (!config?.enabled) return false;
        var role = String(
            formProps?.role ?? (typeof _role !== "undefined" ? _role : window._role) ?? ""
        ).trim().toUpperCase();
        var isDebug = String(
            typeof _isDebugMode !== "undefined" ? _isDebugMode : window._isDebugMode
        ).toLowerCase() === "true";
        var isSuperUser = String(
            typeof _isSuperUser !== "undefined" ? _isSuperUser : window._isSuperUser
        ).toLowerCase() === "true";
        return role === config.role
            && (!config.requireDebugOrSuperUser || isDebug || isSuperUser);
    }

    function isAcceptDecisionItem(item, index) {
        if (!item || typeof item === "string") return index === 0;
        return item.controlType === "accept"
            || item.useDefaultDecisionClick === true
            || String(item.text || "").trim().toLowerCase() === "accept";
    }

    async function applyDecisionAcceptRuleOnce(formProps, record, items) {
        var acceptItems = normalizeDecisionFieldButtons(items || []).filter(isAcceptDecisionItem);
        var acceptButtonIds = acceptItems
            .map(function (item) { return getDelayAcceptButtonId(item); })
            .filter(Boolean);
        var decision = await window.applyFeatureRoleControlRule({
            feature: `Accept · ${formProps?.dept || "unknown"}`,
            controlType: "accept",
            dept: formProps?.dept || "",
            stageDept: record?.stageDept || record?.StageDept || "",
            formData: record || {},
            role: typeof _role !== "undefined" ? _role : window._role,
            state: formProps?.state || {},
            isDebugMode: typeof _isDebugMode !== "undefined" ? _isDebugMode : window._isDebugMode,
            isSuperUser: typeof _isSuperUser !== "undefined" ? _isSuperUser : window._isSuperUser
        });

        var demoOverride = isITAcceptDemoEnabled(formProps);
        var disabled = demoOverride ? false : decision.allowed !== true;

        // This is the only decision-button disabled writer in this file.
        setDecisionButtonsDisabled(acceptButtonIds, disabled);
        acceptButtonIds.forEach(function (buttonId) {
            var $button = $(`#${buttonId}`);
            if (demoOverride) {
                $button.attr("data-it-accept-demo", "true");
                $button.dxButton("instance")?.option("visible", true);
            } else {
                $button.removeAttr("data-it-accept-demo");
            }
        });

        return {
            decision: decision,
            disabled: disabled,
            ITAcceptDemo: demoOverride,
            buttonIds: acceptButtonIds
        };
    }


            function buildRouteDecisionClick(formId, dept, item) {
                return function (e) {
                    var route = item.route || item.findRoute;
                    var formItems = $(`#${formId}`).dxForm("instance")?.option("formData") || {};
                    var content = "";

                    if (typeof item.getComment === "function") {
                        content = item.getComment();
                    } else {
                        content = window.remarkBoxs?.[dept]?.controlRemark?.value?.() || "";
                    }

                    if (item.requireRemark && !content) {
                        appNotifyWarning(item.remarkMessage || "Please put your reason to remarks!", false);
                        return;
                    }

                    formItems.comment = content || "";

                    if (typeof item.onClick === "function") {
                        item.onClick({
                            event: e,
                            formItems: formItems,
                            route: route,
                            dept: dept,
                            formId: formId,
                            config: item
                        });
                        return;
                    }

                    var moduleName = item.moduleName || item.formModuleKey || item.moduleKey || viewIdModulePrefix.quotation;
                    var nextStep = item.nextStep || item.state?.nextStep || window.QuotationPage?.state?.nextStep;
                    var handlerName = item.handlerName || item.action || (route?.isReturn ? "returnToStep" : "submitNextStep");

                    if (!route || !nextStep) {
                        buildDefaultDecisionClick(formProps)(e);
                        return;
                    }

                    if (handlerName === "returnToStep") {
                        returnToStep(moduleName, nextStep, route, formItems);
                        return;
                    }

                    submitNextStep(moduleName, nextStep, route, formItems);
                };
            }


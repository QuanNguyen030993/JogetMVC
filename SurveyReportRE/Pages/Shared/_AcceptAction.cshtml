        function shouldDisableWorkflowButton(options) {
            options = options || {};
            var formItems = options.formItems || {};
            var buttonDept = normalizeDeptKey(options.dept);
            var currentStageDept = normalizeDeptKey(
                options.stageDept
                || formItems.stageDept
                || formItems.StageDept
                || window.QuotationPage?.state?.stageDept
                || window.PolicyIssuancePage?.state?.stageDept
            );
            var currentRole = normalizeDeptKey(
                typeof options.role !== "undefined"
                    ? options.role
                    : (typeof _role !== "undefined" ? _role : "")
            );
            var tatObject = options.tatObject;

            if (!tatObject || typeof tatObject !== "object") {
                tatObject = tryParseJSON(
                    formItems.turnAroundTimeAttributes,
                    "Workflow Button TAT Problem"
                ) || {};
            }

            // Default is disabled. A button is actionable only for the current
            // stage and the role currently being used in the form.
            var ownsCurrentStage = !!buttonDept && buttonDept === currentStageDept;
            var roleMatchesStage = !!currentStageDept && currentRole === currentStageDept;
            if (!ownsCurrentStage || !roleMatchesStage) return true;
            //decision / route / custom
           if (options.type == "late-decision" || options.type == "early-decision")
            {
                 console.log(options.type, options.items);
                 var isFoDecision = currentRole === "FO";
                 var hasAcceptDate = isFoDecision ? true : !!tatObject?.[buttonDept]?.AcceptDate;
                 if (isFoDecision)
                     return !hasAcceptDate ;
                 else
                     return hasAcceptDate; //|| hasActionStatus;
            }
            if (options.type == "route")
            {
                console.log("route", options.items);
                 var isFoRoute = currentRole === "FO";
                 var hasAcceptDate = isFoRoute ? true : !!tatObject?.[buttonDept]?.AcceptDate;
                 // var hasActionStatus = hasWorkflowButtonStatus(formItems, buttonDept);
                 if (isFoRoute)
                     return !hasAcceptDate ;
                 else
                     return !hasAcceptDate; //|| hasActionStatus;
            }
            if (options.type == "custom")
            {
                 console.log("custom");
                 var isFoCustom = currentRole === "FO";
                 var hasAcceptDate = isFoCustom ? true : !!tatObject?.[buttonDept]?.AcceptDate;
                 if (isFoCustom)
                     return !hasAcceptDate ;
                 else
                     return hasAcceptDate; //|| hasActionStatus;
             }
         }

         function getDelayAcceptStoredStatus(formItems, dept, item) {
                if (!item || typeof item !== "object") return null;
                if (item.acceptStatus) return item.acceptStatus;

                var statusField = item.acceptStatusField || item.actionStatusField || "actionStatus";
                var statusObject = tryParseJSON(formItems?.[statusField], "Delay AcceptStatus Problem") || {};
                var buttonStatus = statusObject[`${dept}Button`];

                if (buttonStatus) return buttonStatus;
                return statusObject[dept] || null;
            }

            function renderDelayAcceptStoredStatusButton(formId, dept, item, formItems, tatObject) {
                var buttonId = getDelayAcceptButtonId(item);
                if (!buttonId || !item || typeof item !== "object") return false;
                if (item.trackDecisionStatus === false) return false;

                var storedStatus = getDelayAcceptStoredStatus(formItems, dept, item);
                var statusText = "";
                var statusIcon = item.icon || "check";
                var statusClass = item.buttonClass || "dx-button-info";

                if (storedStatus && typeof storedStatus === "object") {
                    statusText = storedStatus.text || storedStatus.displayStatus || storedStatus.actionName || storedStatus.actionCode || "";
                    statusIcon = storedStatus.icon || statusIcon;
                    statusClass = storedStatus.buttonClass || statusClass;
                } else if (typeof storedStatus === "string") {
                    statusText = storedStatus;
                }

                if (!statusText && item.useTatAcceptStatus && tatObject?.[dept]?.AcceptDate) {
                    statusText = item.tatStatusText || "Submitted";
                }

                if (!statusText) return false;

                var $host = $(`#${buttonId}`);
                if (!$host.length) return false;

                // Status la chip/button nho o hang tren; button thao tac goc duoc giu
                // o hang duoi de layout khong nhay khi actionStatus/TAT tra ve.
                var statusElementId = getDelayAcceptStatusId(item) || item.statusButtonId || `${buttonId}_status`;
                // setDecisionCommonStatus(
                //     statusElementId,
                //     buttonId,
                //     item.statusTitle || statusText
                // );

                return true;
            }

            // function buildDefaultDecisionClick(formId, dept) {
            //     return function (e) {
            //         var formItems = $(`#${formId}`).dxForm("instance")?.option("formData") || {};
            //         var passingObject = {
            //             statusName: `${dept} Process`,
            //             Comment: `Quotation ${formItems.quotationCode} accepted by ${_displayName}!`,
            //             formItems: formItems,
            //             dept: dept,
            //             url: "/api/Quotation/UpdateData",
            //             urlLog: "/api/Quotation/LogAction",
            //             schemeName: "Quotation"
            //         };

            //         acceptDecision(passingObject);
            //     };
            // }
            function buildDefaultDecisionClick(formProps) {
                return function (e) {

                         var objSnapshot = cloneReusableOptions(formProps);
                         objSnapshot.triggerEvent = e;

                            acceptDecision(objSnapshot, objSnapshot.dept);
                };
            }
            
            function getDelayAcceptButtonId(item) {
                if (!item) return "";
                if (typeof item === "string") return item;
                return item.buttonId || item.id || item.elementId || "";
            }

            function getDelayAcceptStatusId(item) {
                if (!item || typeof item === "string") return "";
                return item.statusId || item.statusElement || item.statusElementId || "";
            }

            function updateDelayAcceptStatus(statusId, acceptDate, defaultStatus = null) {
                setTimeout(() => {
                    if (!statusId || !acceptDate)
                    {
                        // console.log("Cannot load status from " + statusId, statusId);
                        // console.log("Cannot load acceptDate from " + statusId, acceptDate);
                    }
                    var statusLabel = defaultStatus;
                    if (acceptDate)
                    statusLabel = "Accepted";
                    if (acceptDate && defaultStatus)
                    statusLabel = defaultStatus;
                    // if (statusLabel && typeof statusLabel === "object") {
                    //     statusLabel = statusLabel.text
                    //         || statusLabel.displayStatus
                    //         || statusLabel.actionName
                    //         || statusLabel.actionCode
                    //         || statusLabel.statusName;
                    // }

                    setDecisionCommonStatus(
                        statusId,
                        "onLoaded",
                        statusLabel == null ? "No status" : (statusLabel != "Accepted" ? statusLabel : `Accepted at: ${fmtTimeLocal(acceptDate)}`)
                    );
                }, _delayLoadFormDetailStatus);
            }
            function workflowDecisionField(formProps, ...params) {
            var buttonItems = normalizeDecisionFieldButtons(params);
            var primaryItem = buttonItems[0] || {};
            var primaryButtonId = getDelayAcceptButtonId(primaryItem);
            var commonStatusId = getDecisionFieldStatusId(formProps, buttonItems);
            var actionHostId = getDecisionFieldActionHostId(formProps);
            return {
                dataField: formProps?.decisionDataField || primaryItem.dataField || "decision",
                name: getDecisionFieldName(formProps, buttonItems),
                label: {
                    text: formProps?.labelText || primaryItem.labelText || "Decision",
                    visible: formProps?.labelVisible !== false && primaryItem.labelVisible !== false
                },
                // Always render the skeleton; role state is applied once after load.
                visible: true,
                itemType: "simple",
                colSpan: primaryItem.colSpan || formProps?.decisionColSpan || 1,
                cssClass: "workflow-decision-field decision-field-v2",
                template: function (data, itemElement) {
                    // Keep both rows as direct children of dx-field-item-content so
                    // ensureDecisionCommonStatus reuses them instead of creating a
                    // second action row and moving the primary button away.
                    var $content = $(itemElement)
                        .addClass("workflow-decision-field-content decision-field-v2-content");
                    var $statusRow = $(`<div id="${commonStatusId}" class="decision-status-row accept-status-indicator decision-common-status decision-status-button statusTag unknown">`, {
                        "aria-live": "polite",
                        "data-decision-status-host": "true"
                    }).appendTo($content);

                    appendDecisionStatusLoader($statusRow);
                    // $("<span>", {
                    //     id: commonStatusId,
                    //     class: "accept-status-indicator decision-common-status decision-status-button",
                    //     role: "status",
                    //     "aria-live": "polite"
                    // }).appendTo($statusRow);

                    var $actionRow = $("<div>", {
                        id: actionHostId,
                        class: "decision-action-row",
                        "data-decision-action-host": "true",
                        "data-route-dept": formProps?.dept || ""
                    }).appendTo($content);

                    buttonItems.forEach(function (item, index) {
                        var config = typeof item === "string" ? { buttonId: item } : item;
                        var buttonId = getDelayAcceptButtonId(config);
                        if (!buttonId) return;

                        var options = {
                            elementAttr: { id: buttonId },
                            disabled: true,
                            text: config.text || (index === 0 ? "Accept" : ""),
                            icon: config.icon || (index === 0 ? "check" : undefined),
                            type: config.type || (index === 0 ? "success" : "default"),
                            stylingMode: config.stylingMode || "contained"
                        };
                        if (typeof config.onClick === "function" && config.useDefaultDecisionClick !== true) {
                            options.onClick = function (event) {
                                return config.onClick(event, {
                                    formProps: formProps,
                                    config: config,
                                    formId: formProps?.formId,
                                    dept: formProps?.dept
                                });
                            };
                        }

                        var $button = $("<div>", { id: buttonId })
                            .dxButton(options)
                            .appendTo($actionRow);
                        if (config.buttonClass) $button.addClass(config.buttonClass);
                    });
                    //??
                    // setDecisionCommonStatus(
                    //     commonStatusId,
                    //     primaryButtonId,
                    //     formProps?.initialDecisionStatus || primaryItem.initialDecisionStatus || "No status"
                    // );
                }
            };
        }

        // Compatibility alias. Use workflowDecisionField for new and refactored forms. //comment out 2026-08-07
        // function decisionFieldV2(formProps, ...params) {
        //     return workflowDecisionField(formProps, ...params);
        // }

        // Compatibility wrapper for existing department forms. New forms should pass
        // config objects to workflowDecisionField(formProps, ...buttonConfigs).
        function decisionField(formId, dept, acceptButtonId, acceptStatusElement, rejectButtonId, rejectStatusElement) {
            var items = [];
            if (acceptButtonId) {
                items.push({
                    buttonId: acceptButtonId,
                    statusId: acceptStatusElement || rejectStatusElement,
                    text: "Accept",
                    icon: "check",
                    type: "success",
                    disabled: true,
                    useDefaultDecisionClick: true
                });
            }
            if (rejectButtonId) {
                items.push({
                    buttonId: rejectButtonId,
                    statusId: rejectStatusElement,
                    text: "Reject",
                    icon: "close",
                    type: "danger",
                    disabled: true
                });
            }
            return workflowDecisionField({ formId: formId, dept: dept }, ...items);
        }
</script>

                function waitForDecisionRouteStage(formId) {
                    var $form = $(`#${formId}`);
                    var $stageRoot = $form.closest("[data-render-stage]");
                    var hasReachedRouteStage = function (stage) {
                        return stage === "routeState" || stage === "comments";
                    };
                    if (!$stageRoot.length || hasReachedRouteStage($stageRoot.attr("data-render-stage"))) {
                        return Promise.resolve();
                    }

                    return new Promise(function (resolve) {
                        var root = $stageRoot[0];
                        var completed = false;
                        var finish = function () {
                            if (completed) return;
                            completed = true;
                            observer.disconnect();
                            window.clearTimeout(fallbackTimer);
                            resolve();
                        };
                        var observer = new MutationObserver(function () {
                            if (!hasReachedRouteStage($stageRoot.attr("data-render-stage"))) return;
                            finish();
                        });
                        observer.observe(root, { attributes: true, attributeFilter: ["data-render-stage"] });
                        var fallbackTimer = window.setTimeout(finish, 8000);
                    });
                }


<script>
    // ITAcceptDemo: temporary UI-only switch for IT testing.
    window.ITAcceptDemo = window.ITAcceptDemo || Object.freeze({
        enabled: true,
        role: "IT",
        requireDebugOrSuperUser: true
    });

    function isITAcceptDemoEnabled(formProps) {
        var config = window.ITAcceptDemo;
        if (!config?.enabled) return false;
        var role = String(
            formProps?.role ?? (typeof _role !== "undefined" ? _role : window._role) ?? ""
        ).trim().toUpperCase();
        var isDebug = String(
            typeof _isDebugMode !== "undefined" ? _isDebugMode : window._isDebugMode
        ).toLowerCase() === "true";
        var isSuperUser = String(
            typeof _isSuperUser !== "undefined" ? _isSuperUser : window._isSuperUser
        ).toLowerCase() === "true";
        return role === config.role
            && (!config.requireDebugOrSuperUser || isDebug || isSuperUser);
    }

    function isAcceptDecisionItem(item, index) {
        if (!item || typeof item === "string") return index === 0;
        return item.controlType === "accept"
            || item.useDefaultDecisionClick === true
            || String(item.text || "").trim().toLowerCase() === "accept";
    }

    async function applyDecisionAcceptRuleOnce(formProps, record, items) {
        var acceptItems = normalizeDecisionFieldButtons(items || []).filter(isAcceptDecisionItem);
        var acceptButtonIds = acceptItems
            .map(function (item) { return getDelayAcceptButtonId(item); })
            .filter(Boolean);
        var decision = await window.applyFeatureRoleControlRule({
            feature: `Accept · ${formProps?.dept || "unknown"}`,
            controlType: "accept",
            dept: formProps?.dept || "",
            stageDept: record?.stageDept || record?.StageDept || "",
            formData: record || {},
            role: typeof _role !== "undefined" ? _role : window._role,
            state: formProps?.state || {},
            isDebugMode: typeof _isDebugMode !== "undefined" ? _isDebugMode : window._isDebugMode,
            isSuperUser: typeof _isSuperUser !== "undefined" ? _isSuperUser : window._isSuperUser
        });

        var demoOverride = isITAcceptDemoEnabled(formProps);
        var disabled = demoOverride ? false : decision.allowed !== true;

        // This is the only decision-button disabled writer in this file.
        setDecisionButtonsDisabled(acceptButtonIds, disabled);
        acceptButtonIds.forEach(function (buttonId) {
            var $button = $(`#${buttonId}`);
            if (demoOverride) {
                $button.attr("data-it-accept-demo", "true");
                $button.dxButton("instance")?.option("visible", true);
            } else {
                $button.removeAttr("data-it-accept-demo");
            }
        });

        return {
            decision: decision,
            disabled: disabled,
            ITAcceptDemo: demoOverride,
            buttonIds: acceptButtonIds
        };
    }

    /**
         * Renders a stable workflow decision field. Status is the primary element;
         * the action host always exists so flow routes can inject buttons even when
         * this field has no local Accept button.
         */
        
    /* role enable/disable restored code: legacy decision renderer kept for rollback.
    */
        async function renderDecisionDeferredV2(formProps, groupName, mainField, ...params) {
                 var form = formProps.formInstance;
                 formProps.formInstance = {};
                 const formDataClone = structuredClone(formProps); // Form view cshtml invoke by 1 function as loop
                    var normalizedDecisionItems = normalizeDecisionFieldButtons(params);
                    var commonStatusId = getDecisionFieldStatusId(
                        formProps,
                        normalizedDecisionItems,
                        params[1] || params[3]
                    );

                     // setTimeout(() => {
                        // var form = $(`#${formDataClone.formId}`).dxForm("instance");
                        if (!form) {
                            setDecisionCommonStatus(commonStatusId, "onLoaded", "Form unavailable");
                            return;
                        }

                        // var formItems = form.option("formData") || {};
                        // if (formItems)
                        // {

                        // }
                        // else {
                        //     console.log("Form " + " no data");
                        // }
                        var formItems = formProps.record;

                        var rawPic = formItems.pic ?? formItems.pIC ?? formItems.PIC;
                        if (rawPic == null && typeof PIC_JSON !== "undefined") {
                            rawPic = PIC_JSON;
                        }
                        var picObject = rawPic && typeof rawPic === "object"
                            ? rawPic
                            : (tryParseJSON(rawPic || "{}", "PIC Load Problem") || {});
                        var pic = picObject[formDataClone.dept];
                        if (!pic) {
                            setDecisionCommonStatus(commonStatusId, "onLoaded", "Not assigned");
                            setDecisionButtonsDisabled(
                                normalizedDecisionItems.map(item => getDelayAcceptButtonId(item)),
                                true
                            );
                            return;

                        }

                        try {
                            form.itemOption(groupName, "visible", pic ? true : false);
                        } catch (e) {
                        }


                       // var latestFormItems = form.option("formData") || {};
                       var latestFormItems = formItems || {};
                       var latestTatObject = tryParseJSON(latestFormItems.turnAroundTimeAttributes, "TAT Load Button Problem") || {};
                        var customStatus = tryParseJSON(latestFormItems.actionStatus || "", "Custom parsing problem") || {};
                       // Legacy callers (UW/LMKT) pass buttonId/statusId pairs.
                       // Status element ids must not be initialized or disabled as buttons.
                           var usesLegacyStringPairs = params.length > 0 && params.every(item => typeof item === "string");
                           var buttonItems = usesLegacyStringPairs
                               ? params.filter((item, index) => index % 2 === 0 && item)
                               : params.filter(item => getDelayAcceptButtonId(item));
                           var renderedStoredStatus = false;
                           buttonItems.forEach(item => {
                               if (renderDelayAcceptStoredStatusButton(formDataClone.formId, formDataClone.dept, item, latestFormItems, latestTatObject)) {
                                   renderedStoredStatus = true;
                                   return;
                               }

                               if (item && typeof item === "object" && typeof item.loadRouteButtons === "function" && !isRouteDecisionButton(item) && !item.useDefaultDecisionClick && !item.createButton) {
                                   item.loadRouteButtons({
                                       formId: formDataClone.formId,
                                       dept: formDataClone.dept,
                                       formItems: latestFormItems,
                                       tatObject: latestTatObject,
                                       config: item
                                   });
                                   return;
                               }
                               applyDelayDecisionButton(formDataClone, item);

                               if (item && typeof item === "object" && typeof item.loadRouteButtons === "function") {
                                   item.loadRouteButtons({
                                       formId: formDataClone.formId,
                                       dept: formDataClone.dept,
                                       formItems: latestFormItems,
                                       tatObject: latestTatObject,
                                       config: item
                                   });
                               }
                           });
                          var finalDecisionStatus = getDecisionCommonStatus(
                                    latestFormItems,
                                    formDataClone.dept,
                                    latestTatObject
                            );

                          setDecisionCommonStatus(
                                commonStatusId,
                                "onLoading",
                                finalDecisionStatus.title || finalDecisionStatus.text
                            );

                      if (latestTatObject?.[formDataClone.dept]?.AcceptDate)
                      {
                          if (formDataClone.dept != "FO") //exception for FO
                             disableAllDecisionButton(buttonItems.map(item => getDelayAcceptButtonId(item)), latestFormItems);
                              var acceptButtonId = getDelayAcceptButtonId(params[0]);
                              var skipAcceptedMainFields = params[0] && typeof params[0] === "object" && params[0].skipAcceptedMainFields;
                              if (acceptButtonId)
                                 {
                                  if (!skipAcceptedMainFields) {
                                      if (mainField) {
                                            form.option("items", [
                                                ...form.option("items"),
                                                ...mainField
                                            ]);
                                        }
                                        else {
                                            form.option("items", [
                                                ...form.option("items"),
                                                ]);
                                        }
                                  }
                              }

                               updateDelayAcceptStatus(
                                   commonStatusId,
                                   latestTatObject[formDataClone.dept]?.AcceptDate
                               );
                      } // if TAT Accept and Button Accept
                      else {
                              if (params.length > 0)
                              {
                                   updateDelayAcceptStatus(
                                       commonStatusId,
                                       latestTatObject[formDataClone.dept]?.AcceptDate
                                   );
                              }
                          }
                         if (formDataClone.dept == "FO"){

                             if (formItems.stageDept == "Client") { //  another logic

                                      var storedStatus = getDelayAcceptStoredStatus(formItems, formItems.stageDept, formItems);
                                      if (storedStatus != "Accepted")
                                         {
                                              updateDelayAcceptStatus(
                                              commonStatusId,
                                              latestTatObject[formDataClone.dept]?.CompleteDate, storedStatus
                                          );
                                          console.log(buttonItems);
                                          disableAllDecisionButton(buttonItems.map(item => getDelayAcceptButtonId(item)), latestFormItems);
                                          return;
                                      }

                              }
                              else {
                                  updateDelayAcceptStatus(
                                  commonStatusId,
                                  null);
                                  return;
                              }

                          }


                          if (latestFormItems.actionStatus) // trend to priority this field
                          {
                                  updateDelayAcceptStatus(
                                  commonStatusId,
                                  latestTatObject[formDataClone.dept]?.AcceptDate,
                                  customStatus[formDataClone.dept]
                                  );
                                  disableAllDecisionButton(buttonItems.map(item => getDelayAcceptButtonId(item)), latestFormItems);
                          }
                          setDecisionButtonsDisabled(
                              buttonItems.map(item => getDelayAcceptButtonId(item)),
                              shouldDisableWorkflowButton({
                                  dept: formDataClone.dept,
                                  stageDept: latestFormItems.stageDept,
                                  formItems: latestFormItems,
                                  tatObject: latestTatObject,
                                  type: "late-decision",
                                  items: buttonItems.map(item => getDelayAcceptButtonId(item))
                              })
                          );

     // }, _delayUnlockForm);
    }

    async function delayAcceptStatusV2Promise(
        mainFields,
        formProps,
        ...params
    ) {
        debugger
        formProps = formProps || {};
        var normalizedDecisionItems = normalizeDecisionFieldButtons(params);
        var usesLegacyStringPairs = params.length > 0
            && params.every(function (item) { return typeof item === "string"; });
        // Legacy callers pass buttonId/statusId pairs. Status elements must never
        // enter dxButton initialization or disabled-state handling.
        var decisionItems = usesLegacyStringPairs
            ? params.filter(function (item, index) { return index % 2 === 0 && item; })
            : normalizedDecisionItems;
        var moduleCode = String(formProps.schemeName || formProps.ModelName || "")
            .replace(/\s+/g, "")
            .toLowerCase() === "policyissuance"
                ? viewIdModulePrefix.policyIssuance
                : viewIdModulePrefix.quotation;
        var form = formProps.formId ? $(`#${formProps.formId}`).dxForm("instance") : null;
        var formRecord = form?.option("formData") || {};
        var record = Object.assign({}, formProps.record || {}, formRecord);
        var hasWorkflowRecord = !!(
            record.stageDept
            || record.StageDept
        ) && !!(
            record.stageAccount
            || record.StageAccount
            || record.pic
            || record.pIC
            || record.PIC
        );
        if (!hasWorkflowRecord) {
            var overviewRecord = await window.OverviewDataBootstrap.getRecord({
                moduleCode: moduleCode,
                id: formProps.id,
                forceReload: false
            });
            record = Object.assign({}, overviewRecord || {}, record);
            // Empty partial fields must not overwrite workflow metadata supplied
            // by the overview record.
            record.stageDept = record.stageDept || record.StageDept
                || overviewRecord?.stageDept || overviewRecord?.StageDept || "";
            record.stageAccount = record.stageAccount || record.StageAccount
                || overviewRecord?.stageAccount || overviewRecord?.StageAccount || "";
            record.pIC = record.pIC || record.pic || record.PIC
                || overviewRecord?.pIC || overviewRecord?.pic || overviewRecord?.PIC || "";
            record.turnAroundTimeAttributes = record.turnAroundTimeAttributes
                || record.TurnAroundTimeAttributes
                || overviewRecord?.turnAroundTimeAttributes
                || overviewRecord?.TurnAroundTimeAttributes
                || "{}";
            record.actionStatus = record.actionStatus || record.ActionStatus
                || overviewRecord?.actionStatus || overviewRecord?.ActionStatus || "{}";
        }
        formProps.record = record || {};

        var decisionFieldName = getDecisionFieldName(formProps, decisionItems);
        var registryDept = formProps.subDeptComponent || formProps.dept;
        var decisionGroupName = `decision${registryDept}Group.${decisionFieldName}`;
        var decisionRegistryKey = `${formProps.formId}:${String(registryDept || "").trim().toUpperCase()}`;

        window.WorkflowDecisionRegistry = window.WorkflowDecisionRegistry || {};
        window.WorkflowDecisionRegistry[decisionRegistryKey] = {
            formProps: formProps,
            groupName: decisionGroupName,
            mainFields: mainFields,
            params: params
        };

        var initialStatusId = getDecisionFieldStatusId(
            formProps,
            decisionItems,
            params[1] || params[3]
        );

        await waitForDecisionRouteStage(formProps.formId);
        await new Promise(function (resolve) {
            window.setTimeout(
                resolve,
                Math.max(0, Number(FormStageDelay?.routeComponent) || 0)
            );
        });

        // renderDecisionDeferredV2 owns the single role evaluation/final write.
        var renderResult = await renderDecisionDeferredV2(
            formProps,
            decisionGroupName,
            mainFields,
            ...params
        );
        if (!renderResult) {
            // The retained legacy renderer schedules its work with setTimeout and
            // intentionally has no return value. Wait for that pass, then let the
            // centralized role rule own the final Accept disabled state.
            await new Promise(function (resolve) {
                window.setTimeout(resolve, Math.max(0, Number(_delayUnlockForm) || 0) + 1);
            });
            form = formProps.formId ? $(`#${formProps.formId}`).dxForm("instance") : null;
            var latestRecord = Object.assign(
                {},
                formProps.record || {},
                form?.option("formData") || {}
            );
            var rawTat = latestRecord.turnAroundTimeAttributes
                ?? latestRecord.TurnAroundTimeAttributes
                ?? "{}";
            var latestTatObject = rawTat && typeof rawTat === "object"
                ? rawTat
                : (tryParseJSON(rawTat, "TAT Load Button Problem") || {});
            var roleState = await applyDecisionAcceptRuleOnce(
                formProps,
                latestRecord,
                decisionItems
            );
            renderResult = {
                record: latestRecord,
                tatObject: latestTatObject,
                decision: roleState.decision,
                disabled: roleState.disabled,
                ITAcceptDemo: roleState.ITAcceptDemo,
                buttonItems: decisionItems
            };
        }
        var rendered = getDecisionRenderedObjects(
            formProps,
            decisionItems,
            initialStatusId,
            { disabled: renderResult.disabled }
        );

        return {
            formProps: formProps,
            formItems: renderResult.record,
            tatObject: renderResult.tatObject,
            acceptDecision: renderResult.decision,
            formId: formProps.formId,
            dept: registryDept,
            groupName: decisionGroupName,
            registryKey: decisionRegistryKey,
            params: params,
            status: rendered.status,
            actionHost: rendered.actionHost,
            buttons: rendered.buttons,
            primaryButton: rendered.primaryButton,
            enable: rendered.enable,
            disable: rendered.disable,
            setDisabled: rendered.setDisabled,
            getButton: rendered.getButton,
            ruleDisabled: renderResult.disabled,
            ITAcceptDemo: renderResult.ITAcceptDemo
        };
    }


        function appendDecisionStatusLoader($host) {
            return $(`
                <span class="decision-common-status-loader dept-section-action-loader" aria-hidden="true">
                    <span></span><span></span><span></span>
                </span>`).appendTo($host);
        }

        function setDecisionCommonStatus(statusId, typeRender, state) {

            // var $status = ensureDecisionCommonStatus(statusId, buttonId);
            try
            {
                var $status = $(`#${statusId}`);
            }
            catch{
                if (typeRender === "onLoaded")
                return "No status";
            }
            // var $button = buttonId ? $(`#${buttonId}`) : $();
            if (!$status.length) return;


            if (typeRender === "onLoading") {
                  $status
                .removeClass("status-success accepted approved rejected declined unknown is-loading")
                .removeAttr("title")
                .css({ color: "", backgroundColor: "", border: "" })
                .empty();


                $status
                    .addClass("is-loading")
                    .css({
                        color: "var(--form-status-pending-text)",
                        backgroundColor: "var(--form-status-pending-bg)",
                        border: "1px solid var(--form-status-border)"
                    });
                appendDecisionStatusLoader($status);
                return;
            }
            else {
                $status.empty();
            }
            var statusText = String(state || "No status").trim() || "No status";
            var normalizedStatus = statusText.toLowerCase();
            var isAccepted = normalizedStatus.includes("accept") || normalizedStatus.includes("approv");
            var isRejected = normalizedStatus.includes("reject") || normalizedStatus.includes("declin") || normalizedStatus.includes("refus");

            if (isAccepted) {
                $status.addClass("statusTag status-success accepted");
            } else if (isRejected) {
                $status.addClass("statusTag rejected");
            } else {
                $status.addClass("statusTag unknown");
            }

            $status
                .css({ width: "fit-content" })
                .text(state || "No status");
        }

        function getDecisionCommonStatus(formItems, dept, tatObject) {
            var rawActionStatus = formItems?.actionStatus;
            var actionStatus = rawActionStatus && typeof rawActionStatus === "object"
                ? rawActionStatus
                : (tryParseJSON(rawActionStatus, "Decision Status Load Problem") || {});
            var storedStatus = actionStatus[`${dept}Button`] || actionStatus[dept];
            var statusText = "";

            if (storedStatus && typeof storedStatus === "object") {
                statusText = storedStatus.text
                    || storedStatus.displayStatus
                    || storedStatus.actionName
                    || storedStatus.actionCode
                    || storedStatus.statusName
                    || "";
            } else if (typeof storedStatus === "string") {
                statusText = storedStatus;
            }

            if (statusText) return { text: statusText, title: "" };
            var acceptDate = tatObject?.[dept]?.AcceptDate;
            if (acceptDate) {
                return {
                    text: "Accepted",
                    title: `Accepted at: ${fmtTimeLocal(acceptDate)}`
                };
            }

            return { text: "No status", title: "" };
        }
    function refreshAcceptedDepartmentWorkflowControls(schemeName, recordId, dept, form, tatObject) {
                var normalizedScheme = String(schemeName || "").replace(/\s+/g, "").toLowerCase();
                var isPolicyIssuance = normalizedScheme === "policyissuance"
                    || normalizedScheme === viewIdModulePrefix.policyIssuance;
                var moduleCode = isPolicyIssuance
                    ? viewIdModulePrefix.policyIssuance
                    : viewIdModulePrefix.quotation;
                var manager = isPolicyIssuance
                    ? window.PolicyIssuanceIdManager
                    : window.QuotationIdManager;
                var normalizedDept = normalizeDeptKey(dept);
                var registryEntry = window.OverviewViewRegistry?.[`${moduleCode}:${recordId}`];
                var reloadRoutes = typeof registryEntry?.reloadWorkflow === "function"
                    ? registryEntry.reloadWorkflow(true)
                    : Promise.resolve();

                return Promise.resolve(reloadRoutes).then(function () {
                    var latestFormItems = form?.option("formData") || {};
                    var latestStageDept = normalizeDeptKey(
                        latestFormItems.stageDept
                        || latestFormItems.StageDept
                        || normalizedDept
                    );
                    var hasAcceptDate = !!tatObject?.[normalizedDept]?.AcceptDate;
                    var returnHostId = manager?.btnReturnBranch?.(normalizedDept, recordId);
                    var submitHostId = manager?.btnSubmitBranch?.(normalizedDept, recordId);
                    var $routeButtons = $()
                        .add(returnHostId ? $(`#${returnHostId}`).find("[data-workflow-route-button]") : $())
                        .add(submitHostId ? $(`#${submitHostId}`).find("[data-workflow-route-button]") : $());

                    return window.applyFeatureRoleControlRule({
                        feature: `${isPolicyIssuance ? "Policy Issuance" : "Quotation"} route/return · ${normalizedDept}`,
                        controlType: "button",
                        dept: normalizedDept,
                        stageDept: latestStageDept,
                        role: typeof _role !== "undefined" ? _role : "",
                        formData: latestFormItems,
                        isDebugMode: typeof _isDebugMode !== "undefined" && _isDebugMode,
                        isSuperUser: typeof _isSuperUser !== "undefined" && _isSuperUser,
                        allowWhen: function () {
                            return hasAcceptDate;
                        },
                        apply: function (decision) {
                            $routeButtons.each(function () {
                                $(this).dxButton("instance")?.option({
                                    visible: decision.allowed,
                                    disabled: !decision.allowed
                                });
                            });

                        }
                    });
                });
            }

    function applyAcceptedDepartmentDecision(schemeName, recordId, dept, responseData) {
                var normalizedScheme = String(schemeName || "").replace(/\s+/g, "").toLowerCase();
                var isPolicyIssuance = normalizedScheme === "policyissuance" || normalizedScheme === viewIdModulePrefix.policyIssuance;
                var manager = isPolicyIssuance
                    ? window.PolicyIssuanceIdManager
                    : window.QuotationIdManager;
                var formId = manager?.form?.(dept, recordId);
                var form = formId ? $(`#${formId}`).dxForm("instance") : null;
                var acceptedAt = responseData?.acceptedAt || new Date().toISOString();
                var section = resolveDepartmentSection(schemeName, recordId, dept);

                if (section) {
                    $(section)
                        .find(".dept-upperbody, .dept-body, .dept-lowerbody, .dept-footer")
                        .show();
                    setDeptSectionCollapsed($(section), false);
                }

                if (!form) return Promise.resolve(false);

                var formItems = form.option("formData") || {};
                var tatObject = tryParseJSON(
                    formItems.turnAroundTimeAttributes,
                    "Accepted decision TAT update"
                ) || {};
                tatObject[dept] = tatObject[dept] || {};
                tatObject[dept].AcceptDate = acceptedAt;
                tatObject[dept].CompleteDate = acceptedAt;
                form.updateData("turnAroundTimeAttributes", JSON.stringify(tatObject));
                if (responseData?.workflowStatus) {
                    form.updateData("workflowStatus", responseData.workflowStatus);
                }

                var registryKey = `${formId}:${String(dept || "").trim().toUpperCase()}`;
                var decisionEntry = window.WorkflowDecisionRegistry[registryKey];
                if (decisionEntry) {
                    renderDecisionDeferredV2(
                        decisionEntry.formProps,
                        decisionEntry.groupName,
                        decisionEntry.mainFields,
                        ...decisionEntry.params
                    );
                } else if (section) {
                    $(section).find("[id^='AC_']").each(function () {
                        $(this).addClass("btn-success");
                    });
                }

                return new Promise(function (resolve, reject) {
                    window.setTimeout(function () {
                        var overviewRoot = section?.closest(
                            `[id^='${viewIdModulePrefix.quotation}-overviewRoot_'], ` +
                            `[id^='${viewIdModulePrefix.policyIssuance}-overviewRoot_']`);
                        // if (overviewRoot) mountOverviewDecisionDocks(overviewRoot);
                        // renderDecisionDeferredV2 has already rebuilt the decision
                        // field from the updated TAT. Repainting here recreates the
                        // template and resets the freshly rendered Accepted status.
                        refreshAcceptedDepartmentWorkflowControls(
                            schemeName,
                            recordId,
                            dept,
                            form,
                            tatObject
                        ).then(function () {
                            resolve(true);
                        }).catch(reject);
                    }, Math.max(0, Number(FormStageDelay?.unlockForm) || 0) + 120);
                });
           }

                    : $(instance?.element?.() || []);
                if (!$button.length) return null;

                var wasDisabled = instance?.option("disabled") === true;
                var $content = $button.find(".dx-button-content").first();
                $button.addClass("workflow-button-loading").attr("aria-busy", "true");
                instance?.option("disabled", true);

                if (!$content.children(".workflow-button-loader").length) {
                    $(`
                        <span class="workflow-button-loader dept-section-action-loader" aria-hidden="true">
                            <span></span><span></span><span></span>
                        </span>`).prependTo($content);
                }

                return {
                    finish: function (restoreEnabled) {
                        $button.removeClass("workflow-button-loading").attr("aria-busy", "false");
                        $button.find(".workflow-button-loader").remove();
                        if (restoreEnabled === true && !wasDisabled) {

@using JogetMVC.Model
@model OverviewScrollPartialModel

@{
    string Id(string name) => $"{Model.Prefix}-{name}_{Model.Id}";
    string Cd(string name) => $"{Model.Prefix}-{name}";
    var moduleCode = (Model.ModuleCode ?? "").Trim().ToLower();
    string[] qtDeptModuleCode = new string[] { "FO", "TS", "UW", "LMKT", "PM" };
    string[] piDeptModuleCode = new string[] { "FO", "TS", "PM" };
}

<div id="@ViewIdHelper.OverViewScroll(Model.Prefix,Model.Id)" class="overview-scroll">

    @if (moduleCode == "qt")
    {
        @foreach (string item in qtDeptModuleCode)
        {
            <section id="@Id($"sec_{item}")" class="dept-section">
                <div id="@Id($"sec_{item}-header")" class="dept-header">
                    @await Html.PartialAsync($"Business/Form/QuotationDetail/_Quotation_{item}_Form_Header", null, new ViewDataDictionary(ViewData) { ["Id"] = ($"{Model.Id}"), ["Cd"] = Cd($"sec_{item}-header") })
                </div>
                <div id="@Id($"sec_{item}-upperbody")" class="dept-upperbody">
                    @await Html.PartialAsync($"Business/Form/QuotationDetail/_Quotation_{item}_Form_UpperBody", null, new ViewDataDictionary(ViewData) { ["Id"] = ($"{Model.Id}"), ["Cd"] = Cd($"sec_{item}-upperbody") })
                </div>
                <div id="@Id($"sec_{item}-body")" class="dept-body">
                    @await Html.PartialAsync($"Business/Form/QuotationDetail/_Quotation_{item}_Form", null, new ViewDataDictionary(ViewData) { ["Id"] = ($"{Model.Id}"), ["Cd"] = Cd($"sec_{item}-body") })
                </div>
                <div id="@Id($"sec_{item}-lowerbody")" class="dept-lowerbody">
                    @await Html.PartialAsync($"Business/Form/QuotationDetail/_Quotation_{item}_Form_LowerBody", null, new ViewDataDictionary(ViewData) { ["Id"] = ($"{Model.Id}"), ["Cd"] = Cd($"sec_{item}-lowerbody") })
                </div>
                <div id="@Id($"sec_{item}-footer")" class="dept-footer">
                    @await Html.PartialAsync($"Business/Form/QuotationDetail/_Quotation_{item}_Form_Footer", null, new ViewDataDictionary(ViewData) { ["Id"] = ($"{Model.Id}"), ["Cd"] = Cd($"sec_{item}-footer") })
                </div>
            </section>
        }
        
    }
    else if (moduleCode == "pi")
    {
        @foreach (string item in piDeptModuleCode)
        {
            <section id="@Id($"sec_{item}")" class="dept-section">
                <div id="@Id($"sec_{item}-header")" class="dept-header">
                    @await Html.PartialAsync($"Business/Form/PolicyIssuanceDetail/_PolicyIssuance_{item}_Form_Header", null, new ViewDataDictionary(ViewData) { ["Id"] = ($"{Model.Id}"), ["Cd"] = Cd($"sec_{item}-header") })
                </div>
                <div id="@Id($"sec_{item}-upperbody")" class="dept-upperbody">
                    @await Html.PartialAsync($"Business/Form/PolicyIssuanceDetail/_PolicyIssuance_{item}_Form_UpperBody", null, new ViewDataDictionary(ViewData) { ["Id"] = ($"{Model.Id}"), ["Cd"] = Cd($"sec_{item}-upperbody") })
                </div>
                <div id="@Id($"sec_{item}-body")" class="dept-body">
                    @await Html.PartialAsync($"Business/Form/PolicyIssuanceDetail/_PolicyIssuance_{item}_Form", null, new ViewDataDictionary(ViewData) { ["Id"] = ($"{Model.Id}"), ["Cd"] = Cd($"sec_{item}-body") })
                </div>
                <div id="@Id($"sec_{item}-lowerbody")" class="dept-lowerbody">
                    @await Html.PartialAsync($"Business/Form/PolicyIssuanceDetail/_PolicyIssuance_{item}_Form_LowerBody", null, new ViewDataDictionary(ViewData) { ["Id"] = ($"{Model.Id}"), ["Cd"] = Cd($"sec_{item}-lowerbody") })
                </div>
                <div id="@Id($"sec_{item}-footer")" class="dept-footer">
                    @await Html.PartialAsync($"Business/Form/PolicyIssuanceDetail/_PolicyIssuance_{item}_Form_Footer", null, new ViewDataDictionary(ViewData) { ["Id"] = ($"{Model.Id}"), ["Cd"] = Cd($"sec_{item}-footer") })
                </div>
            </section>
        }
    }

</div>
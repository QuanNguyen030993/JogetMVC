@model OverviewScrollPartialModel

@{
    string Id(string name) => $"{Model.Prefix}-{name}";
    var moduleCode = (Model.ModuleCode ?? "").Trim().ToLower();
    string[] qtDeptModuleCode = new string[] { "FO", "TS", "UW", "LMKT", "PM" };
    string[] piDeptModuleCode = new string[] { "FO", "TS", "PM" };
}

<div id="@Id("overviewScroll")" class="overview-scroll">

    @if (moduleCode == "qt")
    {
        @foreach (string item in qtDeptModuleCode)
        {
            <section id="@Id($"sec{item}")" class="dept-section">
                <div class="dept-header">
                @await Html.PartialAsync($"Business/Form/QuotationDetail/_Quotation_{item}_Form_Header")
            </div>
            <div class="dept-body">
                    @await Html.PartialAsync($"Business/Form/QuotationDetail/_Quotation_{item}_Form")
            </div>
            <div class="dept-footer">
                    @await Html.PartialAsync($"Business/Form/QuotationDetail/_Quotation_{item}_Form_Footer")
            </div>
        </section>
        }

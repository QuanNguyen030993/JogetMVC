@using JogetMVC.Model
@model DeptTreePartialModel

@{
    var moduleCode = (Model.ModuleCode ?? "").Trim().ToLower();
    var quotationId = Convert.ToInt64(ViewData["Id"]);
    var deptCodes = moduleCode == "qt"
        ? new[] { "FO", "TS", "UW", "LMKT", "PM" }
        : new[] { "FO", "TS", "PM" };
    var deptTreeId = moduleCode == "qt"
        ? QTViewIdHelper.DeptTree(quotationId)
        : PIViewIdHelper.DeptTree(quotationId);
    var treeStackId = moduleCode == "qt"
        ? QTViewIdHelper.TreeStack(quotationId)
        : PIViewIdHelper.TreeStack(quotationId);
    var overviewScrollId = ViewIdHelper.OverViewScroll(Model.Prefix, Model.Id);
    var sectionParts = new[]
    {
        new { Key = "upperbody", Label = "Decision" },
        new { Key = "body", Label = "Detail" },
        new { Key = "lowerbody", Label = "Comment" },
        new { Key = "footer", Label = "Route" }
    };
}

<div id="@deptTreeId" class="dept-tree">
    <div id="@(deptTreeId)_idleClock"
         class="dept-idle-clock"
         aria-hidden="true"
        title="Time without activity">
        <span class="dept-idle-clock-label">Idle</span>
        <span class="dept-idle-clock-value">02:00</span>
    </div>
    <div class="treeStack" id="@treeStackId">
        <div class="vline" id="@(moduleCode == "qt" ? QTViewIdHelper.TreeVLine(quotationId) :  PIViewIdHelper.TreeVLine(quotationId))"></div>
        <div class="dept-scroll-beacon" aria-hidden="true"></div>

        @for (var deptIndex = 0; deptIndex < deptCodes.Length; deptIndex++)
        {
            var deptCode = deptCodes[deptIndex];
            var hasAxisDetails = deptIndex < deptCodes.Length - 1;
            <div class="@($"{Model.Prefix}")-dept-tree dept-node"
                 data-key="@deptCode"
                 data-target="#@($"{Model.Prefix}-sec_{deptCode}_{Model.Id}")">

                <div class="dept-callout" data-pic-for="@deptCode">
                    <span class="co-icon"></span>
                    <span class="co-text">-</span>
                </div>

                @if (hasAxisDetails)
                {
                    <div class="dept-subnodes" aria-label="@deptCode section parts">
                        <button type="button"
                                class="dept-axis-trigger"
                                aria-expanded="false"
                                aria-label="@($"Open {deptCode} section shortcuts")"></button>
                        @for (var partIndex = 0; partIndex < sectionParts.Length; partIndex++)
                        {
                            var part = sectionParts[partIndex];
                            <button type="button"
                                    class="dept-subnode"
                                    style="--sub-index:@partIndex"
                                    data-section-part="@part.Key"
                                    data-feature-slot="@($"{deptCode}:{part.Key}")"
                                    data-tooltip="@part.Label"
                                    aria-label="@($"Scroll to {deptCode} {part.Label}")"></button>
                        }
                    </div>
                }

                <div class="dept-circle"
                     role="button"
                     tabindex="0"
                     aria-label="Open @deptCode section">@deptCode</div>
            </div>
        }
    </div>
</div>

<script>
    (function initializeDeptTreeEnhancements() {
        var attempts = 0;
        var treeStackId = "@treeStackId";
        var overviewScrollId = "@overviewScrollId";
        var idleClockId = "@(deptTreeId)_idleClock";

        if (!window.DeptTreeIdleClock) {
            window.DeptTreeIdleClock = (function () {
                const idleThresholdMs = 5000;
                const countdownDurationMs = 120000;
                const clocks = new Set();
                let lastActivityAt = Date.now();
                let isIdle = false;

                function formatDuration(durationMs) {
                    const totalSeconds = Math.max(0, Math.ceil(durationMs / 1000));
                    const hours = Math.floor(totalSeconds / 3600);
                    const minutes = Math.floor((totalSeconds % 3600) / 60);
                    const seconds = totalSeconds % 60;
                    const twoDigits = value => String(value).padStart(2, "0");

                    return hours > 0
                        ? `${twoDigits(hours)}:${twoDigits(minutes)}`
                        : `${twoDigits(minutes)}:${twoDigits(seconds)}`;
                }

                function renderClocks(idleDurationMs, shouldShow) {
                    clocks.forEach(function (clock) {
                        if (!clock.isConnected) {
                            clocks.delete(clock);
                            return;
                        }

                        const value = clock.querySelector(".dept-idle-clock-value");
                        if (value) value.textContent = formatDuration(idleDurationMs);
                        clock.classList.toggle("is-visible", shouldShow);
                        clock.setAttribute("aria-hidden", shouldShow ? "false" : "true");
                    });
                }

                function update() {
                    const idleDurationMs = Date.now() - lastActivityAt;
                    isIdle = idleDurationMs >= idleThresholdMs;
                    const countdownElapsedMs = Math.max(0, idleDurationMs - idleThresholdMs);
                    const remainingMs = Math.max(0, countdownDurationMs - countdownElapsedMs);
                    renderClocks(remainingMs, isIdle);
                }

                function markActivity() {
                    lastActivityAt = Date.now();
                    if (!isIdle) return;

                    isIdle = false;
                    renderClocks(countdownDurationMs, false);
                }

                [
                    "pointerdown",
                    "pointermove",
                    "keydown",
                    "wheel",
                    "touchstart"
                ].forEach(function (eventName) {
                    document.addEventListener(eventName, markActivity, {
                        passive: true,
                        capture: true
                    });
                });

                window.setInterval(update, 1000);

                return {
                    register: function (clock) {
                        if (!clock) return;
                        clocks.add(clock);
                        update();
                    },
                    reset: markActivity
                };
            })();
        }

        window.DeptTreeIdleClock.register(document.getElementById(idleClockId));

        function bindWhenReady() {
            var treeStack = document.getElementById(treeStackId);
            var overviewScroll = document.getElementById(overviewScrollId);

            if (treeStack && overviewScroll && typeof bindDeptTreeScrollSpy === "function") {
                if (treeStack.deptTreeScrollSpy?.destroy) {
                    treeStack.deptTreeScrollSpy.destroy();
                }
                treeStack.deptTreeScrollSpy = bindDeptTreeScrollSpy(
                    "@moduleCode",
                    @Model.Id,
                    {
                        treeStack: treeStack,
                        container: overviewScroll
                    }
                );
                if (treeStack.deptTreeScrollSpy) return;
            }

            attempts += 1;
            if (attempts < 40) window.setTimeout(bindWhenReady, 50);
        }

        window.setTimeout(bindWhenReady, 0);
    })();
</script>

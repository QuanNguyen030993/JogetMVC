@model DeptTreePartialModel

@{
    string Id(string name) => $"{Model.Prefix}-{name}";
    var moduleCode = (Model.ModuleCode ?? "").Trim().ToLower();

    var deptCodes = moduleCode == "qt"
        ? new[] { "MKT", "TS", "UW", "LMKT", "PM" }
        : new[] { "MKT", "TS", "PM" };
}

<div id="@Id("deptTree")" class="dept-tree">
    <div class="treeStack" id="@Id("treeStack")">
        <div class="vline" id="@Id("treeVLine")"></div>

        @foreach (var deptCode in deptCodes)
        {
            <div class="@($"{Model.Prefix}")-dept-tree dept-node"
                 data-key="@deptCode"
                 data-target="#@($"{Model.Prefix}-sec-{deptCode}")">

                <div class="dept-callout" data-pic-for="@deptCode">
                    <span class="co-icon"></span>
                    <span class="co-text">-</span>
                </div>

                <div class="dept-circle">@deptCode</div>
            </div>
        }
    </div>
</div>
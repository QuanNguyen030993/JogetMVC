<script>
    // REVIEW ONLY: centralized feature-rule diagnostic. Nothing in the application
    // calls this helper; invoke window.checkFeatureRoleRule(...) manually when needed.
    async function checkFeatureRoleRule(options) {
        options = options || {};
        const configuredRules = options.rules || options.rule || {};

        function firstDefined() {
            for (const value of arguments) {
                if (value !== undefined && value !== null) return value;
            }
            return undefined;
        }

        function readRule(camelName, pascalName) {
            return firstDefined(
                configuredRules[camelName],
                configuredRules[pascalName],
                options[camelName],
                options[pascalName]
            );
        }

        function normalize(value) {
            return String(value ?? "").trim().toUpperCase();
        }

        function asBoolean(value) {
            if (typeof value === "string") {
                return !["", "0", "false", "no", "off", "null", "undefined"]
                    .includes(value.trim().toLowerCase());
            }
            return !!value;
        }

        function asList(value) {
            if (value == null || value === "" || value === false) return [];
            const values = Array.isArray(value)
                ? value
                : String(value).split(/[;,|]/);
            return values.map(normalize).filter(Boolean);
        }

        function getGlobal(name) {
            return firstDefined(window[name],
                typeof globalThis !== "undefined" ? globalThis[name] : undefined);
        }

        function findPageState() {
            if (options.state) return options.state;

            const requestedModule = normalize(firstDefined(
                options.moduleCode,
                options.module,
                options.scheme,
                ""
            )).replace(/[^A-Z]/g, "");
            const path = normalize(window.location?.pathname || "").replace(/[^A-Z]/g, "");
            const isPolicyIssuance = requestedModule === "PI"
                || requestedModule === "POLICYISSUANCE"
                || path.includes("POLICYISSUANCEFORM");
            const isQuotation = requestedModule === "QT"
                || requestedModule === "QUOTATION"
                || path.includes("QUOTATIONFORM");

            if (isPolicyIssuance) return window.PolicyIssuancePage?.state || {};
            if (isQuotation) return window.QuotationPage?.state || {};

            const piState = window.PolicyIssuancePage?.state;
            const qtState = window.QuotationPage?.state;
            if (piState?.stageDept && !qtState?.stageDept) return piState;
            if (qtState?.stageDept && !piState?.stageDept) return qtState;
            return piState?.selectedId ? piState : (qtState || piState || {});
        }

        function routeValue(route, names) {
            for (const name of names) {
                const value = route?.[name];
                if (value !== undefined && value !== null && value !== "") return value;
            }
            return "";
        }

        function matchesAllowed(actualValues, allowedValues) {
            if (!allowedValues.length) return true;
            const normalizedActual = actualValues.map(normalize).filter(Boolean);
            return allowedValues.some(function (allowed) {
                return allowed === "*" || normalizedActual.includes(allowed);
            });
        }

        function safeJson(value) {
            if (!value || typeof value !== "string") return value;
            try {
                return JSON.parse(value);
            } catch (error) {
                return null;
            }
        }

        function resolveField(source, path) {
            return String(path || "").split(".").filter(Boolean).reduce(function (value, key) {
                return value == null ? undefined : value[key];
            }, source);
        }

        function compareCondition(left, operator, right) {
            const op = String(operator || "=").trim().toLowerCase().replace(/_/g, "");
            if (op === "=" || op === "==") return left === right;
            if (op === "!=" || op === "<>") return left !== right;
            if (op === ">") return left > right;
            if (op === ">=") return left >= right;
            if (op === "<") return left < right;
            if (op === "<=") return left <= right;
            if (op === "contains") return Array.isArray(left)
                ? left.includes(right)
                : String(left ?? "").toLowerCase().includes(String(right ?? "").toLowerCase());
            if (op === "in") return Array.isArray(right) && right.includes(left);
            if (op === "notin") return Array.isArray(right) && !right.includes(left);
            if (op === "isnull" || op === "isempty") return left == null || left === "";
            if (op === "isnotnull" || op === "isnotempty") return left != null && left !== "";
            return false;
        }

        async function evaluateCustomCondition(condition, context) {
            condition = safeJson(condition);
            if (condition == null || condition === "") return true;
            if (typeof condition === "boolean") return condition;
            if (typeof condition === "function") {
                return asBoolean(await condition(context));
            }

            const type = String(condition.type ?? condition.Type ?? "").toLowerCase();
            if (type === "group" || Array.isArray(condition.children ?? condition.Children)) {
                const children = condition.children ?? condition.Children ?? [];
                const values = await Promise.all(children.map(function (child) {
                    return evaluateCustomCondition(child, context);
                }));
                const operator = String(condition.operator ?? condition.Operator ?? "AND").toUpperCase();
                if (operator === "OR") return values.some(Boolean);
                if (operator === "XOR") return values.filter(Boolean).length === 1;
                if (operator === "NOT") return !values.some(Boolean);
                return values.every(Boolean);
            }

            const source = String(condition.source ?? condition.Source ?? "").toLowerCase();
            if (source === "custom") {
                const handlerName = condition.handler ?? condition.Handler;
                const handler = typeof handlerName === "function"
                    ? handlerName
                    : (handlerName ? window[handlerName] : null);
                if (typeof handler !== "function") return false;
                return asBoolean(await handler(condition.args ?? condition.Args ?? {}, context));
            }

            if (typeof window.evaluateConditionRule === "function") {
                return asBoolean(await window.evaluateConditionRule(condition, context.formData));
            }
            return compareCondition(
                resolveField(context.formData, condition.field ?? condition.Field),
                condition.operator ?? condition.Operator,
                condition.value ?? condition.Value
            );
        }

        const state = findPageState();
        const route = firstDefined(options.route, state.currentRoute, state.selectedRoute, null);
        const role = firstDefined(options.role, state.currentUserRole, getGlobal("_roleAppName"), "");
        const authenticatedSection = firstDefined(options.section, getGlobal("_role"), getGlobal("_userDepartment"), "");
        const stageDeptValue = firstDefined(
            options.stageDept,
            options.formData?.stageDept,
            options.formData?.StageDept,
            options.data?.formItems?.stageDept,
            options.data?.formItems?.StageDept,
            options.data?.stageDept,
            options.data?.StageDept,
            state.stageDept,
            routeValue(route, ["fromNodeId", "FromNodeId"]),
            ""
        );
        const isDebugMode = asBoolean(firstDefined(options.isDebugMode, getGlobal("_isDebugMode"), false));
        const isSuperUser = asBoolean(firstDefined(options.isSuperUser, getGlobal("_isSuperUser"), false));
        // Strict AND is the default: one failed configured rule means denied.
        // A caller must explicitly opt in when it really wants super-user bypass.
        const superUserBypass = firstDefined(options.superUserBypass, configuredRules.superUserBypass, false) === true;
        const allowedRoles = asList(readRule("roles", "Roles") ?? readRule("roleAllow", "RoleAllow"));
        const allowedStageDepts = asList(readRule("stageDepts", "StageDepts") ?? readRule("stageDeptAllow", "StageDeptAllow"));
        const allowedSections = asList(readRule("sections", "Sections") ?? readRule("sectionAllow", "SectionAllow"));
        const onlyAllowFromRoute = readRule("onlyAllowFromRoute", "OnlyAllowFromRoute");
        let customRouteCondition = readRule("customRouteCondition", "CustomRouteCondition");

        const routeCandidates = [
            routeValue(route, ["routeId", "RouteId", "id", "Id"]),
            routeValue(route, ["fromNodeId", "FromNodeId", "fromDeptCode", "FromDeptCode"]),
            routeValue(route, ["toNodeId", "ToNodeId", "toDeptCode", "ToDeptCode"]),
            routeValue(route, ["actionCode", "ActionCode", "actionName", "ActionName"])
        ];

        async function checkOnlyAllowFromRoute() {
            if (onlyAllowFromRoute == null || onlyAllowFromRoute === false || onlyAllowFromRoute === "") return true;
            if (typeof onlyAllowFromRoute === "function") {
                return asBoolean(await onlyAllowFromRoute({ route, state, options }));
            }
            if (onlyAllowFromRoute === true || normalize(onlyAllowFromRoute) === "TRUE") {
                if (!route) return false;
                const routeFrom = routeValue(route, ["fromNodeId", "FromNodeId", "fromDeptCode", "FromDeptCode"]);
                return !stageDeptValue || !routeFrom || normalize(routeFrom) === normalize(stageDeptValue);
            }
            return !!route && matchesAllowed(routeCandidates, asList(onlyAllowFromRoute));
        }

        if (customRouteCondition === true) {
            customRouteCondition = firstDefined(
                route?.conditionJson,
                route?.ConditionJson,
                route?.data,
                route?.Data,
                null
            );
        }
        const formData = firstDefined(options.formData, options.data, state.formData, {});
        const evaluationContext = {
            feature: options.feature || options.featureName || "Feature",
            role,
            authenticatedSection,
            stageDept: stageDeptValue,
            route,
            state,
            formData,
            isDebugMode,
            isSuperUser,
            options
        };

        const now = function () {
            return typeof performance !== "undefined" && typeof performance.now === "function"
                ? performance.now()
                : Date.now();
        };
        const evaluationStartedAt = now();
        let completionSequence = 0;

        async function runTimedCheck(key, evaluator) {
            const startedAt = now();
            try {
                const value = await evaluator();
                const finishedAt = now();
                return {
                    key: key,
                    passed: asBoolean(value),
                    error: "",
                    startedAtMs: Number((startedAt - evaluationStartedAt).toFixed(2)),
                    completedAtMs: Number((finishedAt - evaluationStartedAt).toFixed(2)),
                    durationMs: Number((finishedAt - startedAt).toFixed(2)),
                    completedOrder: ++completionSequence
                };
            } catch (error) {
                const finishedAt = now();
                return {
                    key: key,
                    passed: false,
                    error: String(error?.message || error || "Rule evaluation failed"),
                    startedAtMs: Number((startedAt - evaluationStartedAt).toFixed(2)),
                    completedAtMs: Number((finishedAt - evaluationStartedAt).toFixed(2)),
                    durationMs: Number((finishedAt - startedAt).toFixed(2)),
                    completedOrder: ++completionSequence
                };
            }
        }

        const timedChecks = await Promise.all([
            runTimedCheck("role", function () {
                return matchesAllowed([role], allowedRoles);
            }),
            runTimedCheck("stageDept", function () {
                return matchesAllowed([stageDeptValue], allowedStageDepts);
            }),
            runTimedCheck("section", function () {
                return matchesAllowed([authenticatedSection], allowedSections);
            }),
            runTimedCheck("route", checkOnlyAllowFromRoute),
            runTimedCheck("customRoute", function () {
                return evaluateCustomCondition(customRouteCondition, evaluationContext);
            })
        ]);
        const timedByKey = Object.fromEntries(timedChecks.map(function (item) {
            return [item.key, item];
        }));

        const checks = [
            { key: "role", label: "Role", configured: !!allowedRoles.length, actual: role, expected: allowedRoles },
            { key: "stageDept", label: "Stage dept", configured: !!allowedStageDepts.length, actual: stageDeptValue, expected: allowedStageDepts },
            { key: "section", label: "Section allow", configured: !!allowedSections.length, actual: authenticatedSection, expected: allowedSections },
            { key: "route", label: "Only allow from route", configured: onlyAllowFromRoute != null && onlyAllowFromRoute !== false && onlyAllowFromRoute !== "", actual: routeCandidates.filter(Boolean), expected: onlyAllowFromRoute },
            { key: "customRoute", label: "Custom route condition", configured: customRouteCondition != null && customRouteCondition !== "", actual: customRouteCondition == null ? "" : "evaluated", expected: customRouteCondition }
        ].map(function (item) {
            return Object.assign(item, timedByKey[item.key]);
        });
        const configuredChecks = checks.filter(function (item) { return item.configured; });
        const rulesPassed = configuredChecks.length > 0
            && configuredChecks.every(function (item) { return item.passed; });
        const bypassedBySuperUser = isSuperUser && superUserBypass && !rulesPassed;
        const report = {
            feature: evaluationContext.feature,
            allowed: rulesPassed || (isSuperUser && superUserBypass),
            rulesPassed,
            bypassedBySuperUser,
            isDebugMode,
            isSuperUser,
            role: normalize(role),
            stageDept: normalize(stageDeptValue),
            section: normalize(authenticatedSection),
            route,
            checks,
            timeline: checks.slice().sort(function (left, right) {
                return left.completedOrder - right.completedOrder;
            }),
            totalDurationMs: Number((now() - evaluationStartedAt).toFixed(2)),
            evaluatedAt: new Date().toISOString()
        };

        if (options.display !== false) showFeatureRoleRuleReport(report);
        return report;
    }

    function showFeatureRoleRuleReport(report) {
        const encode = function (value) {
            return $("<div>").text(value == null ? "-" : String(value)).html();
        };
        const displayValue = function (value, emptyText) {
            if (Array.isArray(value)) return value.length ? value.join(", ") : emptyText;
            if (value && typeof value === "object") {
                try { return JSON.stringify(value); } catch (error) { return "[object]"; }
            }
            return value === true ? "Required" : (value || emptyText);
        };
        const badge = function (label, active, neutral) {
            const color = neutral ? "#6c757d" : (active ? "#198754" : "#dc3545");
            return `<span style="display:inline-block;margin:2px 6px 2px 0;padding:4px 9px;border-radius:12px;background:${color};color:#fff;font-size:12px">${encode(label)}</span>`;
        };
        const rows = report.checks.map(function (item) {
            const status = !item.configured ? "NOT SET" : (item.passed ? "PASS" : "FAIL");
            return `<tr>
                <td style="padding:8px;border-bottom:1px solid #e5e7eb">${encode(item.label)}</td>
                <td style="padding:8px;border-bottom:1px solid #e5e7eb">${badge(status, item.passed, !item.configured)}</td>
                <td style="padding:8px;border-bottom:1px solid #e5e7eb;word-break:break-word">${encode(item.error || displayValue(item.actual, "Not available"))}</td>
                <td style="padding:8px;border-bottom:1px solid #e5e7eb;word-break:break-word">${encode(displayValue(item.expected, "Any"))}</td>
            </tr>`;
        }).join("");
        const maxDuration = Math.max(1, ...report.timeline.map(function (item) {
            return item.durationMs || 0;
        }));
        const timelineRows = report.timeline.map(function (item) {
            const width = Math.max(3, Math.round(((item.durationMs || 0) / maxDuration) * 100));
            const color = !item.configured ? "#6c757d" : (item.passed ? "#198754" : "#dc3545");
            return `<div style="position:relative;padding:0 0 14px 30px">
                <span style="position:absolute;left:-10px;top:0;display:grid;place-items:center;width:22px;height:22px;border-radius:50%;background:${color};color:#fff;font-size:11px;font-weight:700">${item.completedOrder}</span>
                <div style="display:flex;justify-content:space-between;gap:12px;margin-bottom:5px">
                    <strong>${encode(item.label)}</strong>
                    <span style="color:#6b7280;font-size:12px">ready +${item.completedAtMs} ms · ran ${item.durationMs} ms</span>
                </div>
                <div style="height:5px;border-radius:999px;background:#e5e7eb;overflow:hidden">
                    <span style="display:block;width:${width}%;height:100%;background:${color}"></span>
                </div>
            </div>`;
        }).join("");
        const $content = $(`<div style="font-family:inherit;padding:4px">
            <div style="margin-bottom:12px">
                ${badge(report.allowed ? "ALLOWED" : "DENIED", report.allowed)}
                ${badge(`Debug: ${report.isDebugMode ? "ON" : "OFF"}`, report.isDebugMode, !report.isDebugMode)}
                ${badge(`Super user: ${report.isSuperUser ? "YES" : "NO"}`, report.isSuperUser, !report.isSuperUser)}
                ${report.bypassedBySuperUser ? badge("SUPER USER BYPASS", true) : ""}
            </div>
            <table style="width:100%;border-collapse:collapse;font-size:13px">
                <thead><tr style="text-align:left;background:#f3f4f6"><th style="padding:8px">Rule</th><th style="padding:8px">Result</th><th style="padding:8px">Actual</th><th style="padding:8px">Expected</th></tr></thead>
                <tbody>${rows}</tbody>
            </table>
            <div style="margin-top:18px;padding-top:12px;border-top:1px solid #e5e7eb">
                <div style="display:flex;justify-content:space-between;margin-bottom:12px">
                    <strong>Rule completion timeline</strong>
                    <span style="color:#6b7280;font-size:12px">Total ${report.totalDurationMs} ms</span>
                </div>
                <div style="margin-left:10px;border-left:2px solid #d1d5db">${timelineRows}</div>
            </div>
        </div>`);

        const $host = $("<div class='feature-role-rule-review-popup'>").appendTo(document.body);
        const popup = $host.dxPopup({
            title: `Feature rule review: ${report.feature}`,
            width: "min(900px, 92vw)",
            height: "auto",
            maxHeight: "85vh",
            showTitle: true,
            dragEnabled: true,
            closeOnOutsideClick: true,
            contentTemplate: function (container) { $content.appendTo(container); },
            toolbarItems: [{
                widget: "dxButton",
                toolbar: "bottom",
                location: "after",
                options: { text: "Close", onClick: function () { popup.hide(); } }
            }],
            onHidden: function () {
                popup.dispose();
                $host.remove();
            }
        }).dxPopup("instance");
        popup.show();
        return popup;
    }

    window.checkFeatureRoleRule = checkFeatureRoleRule;
</script>

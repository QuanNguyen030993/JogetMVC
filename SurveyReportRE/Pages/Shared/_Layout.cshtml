<!DOCTYPE html>
<html lang="en">
    @if (!string.IsNullOrEmpty(@ViewData["Title"]?.ToString()))
    {
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>@ViewData["Title"] - Quotation Management</title>
@*     <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /> *@
    
    @* <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script> *@
    @* <script src="~/js/site.js" asp-append-version="true"></script> *@
</head>
    }
<body>
   
    @* <div class="container"> *@
    @if (!string.IsNullOrEmpty(@ViewData["Title"]?.ToString()))
    {
        <aside class="main-sidebar">
            <section class="sidebar" style="height: auto;">
                @* <div class="sidebar-form"> *@
                @* <div class="input-group"> *@
                @* <input type="text" id="my-search" name="q" class="form-control" placeholder="Search..."> *@
                @* <span class="input-group-btn">
            <a href="#" id="remove-search-btn" class="btn btn-flat">
            <i class="fa fa-remove"></i>
            </a>
            </span> *@
                @* </div> *@
                @* </div> *@
                <ul class="sidebar-menu tree" data-widget="tree" id="my-tree">
                </ul>

            </section>
        </aside>
        <main role="main" class="container pb-3">
            @RenderBody()
        </main>

        <aside id="rightCommentDock" class="rightDock main-sidebar-right">
            <div class="dockCard">
                <div class="dockHeader">
                    <div>
                        <span class="dockTitle">Comment Log</span>
                        <span id="rightCommentSub" class="dockSub">-</span>
                    </div>
                    <a href="javascript:void(0)" id="btnCloseRightComment" class="dockClose">✕</a>
                </div>

                <div id="rightCommentList" class="dockBody">
                    <div style="color:#6b7280;font-size:12px;padding:6px 4px;">Click “Comments” to load…</div>
                </div>
            </div>
        </aside>
    }
    else {
        @RenderBody()
    }
    @* </div> *@
    @* @if (!string.IsNullOrEmpty(@ViewData["Title"]?.ToString())) *@
    @* @await RenderSectionAsync("Scripts", required: false) *@
    
</body>
</html>
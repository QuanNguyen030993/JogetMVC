
<script>
      var _enums = {
      assignmentMode: [
        // { id: "auto", text: "Auto route (recommended)" },
        { id: "later", text: "Assign later" },
        { id: "manual", text: "Manual assign" }
      ],
      teamOrRole: [
        { id: "TS", text: "Marketing TS" },
        { id: "UW", text: "Underwriting" }
      ],
      assignee: [
        // { accountName: "admin", fullName: "Admin admin" },
        // { accountName: "hien.ttt", fullName: "To Thi Thu Hien" },
        // { accountName: "accpentest", fullName: "accpentest test" }
      ],
      requestType: [],
      ClientType:[],
      BusinessChannel: [],
      reInsuranceType: [],
      BranchOffice: [],
      OverallStatus: [],
      NotificationType: [],
      reInsuranceType: [],
      TMICode: [],
      Currency: [],
      InsPeriod: [],
      LanguageOfPolicy: [],
      Segment: [],
      ExperienceLevel: [],
      WorkflowType: ["Quotation", "PolicyIssuance", "Both", "Start", "End"],
      TransitionType: ["Forward","Backward","Custom"],
      PolicyPackage: ["Yes","No"],
      TSCheckList:[ { id: "default", text: "Default / Quotation" },
                                    { id: "confirmedQuotationFlag", text: "Confirmed Quotation (must for FCI, CCI)" },
                                    { id: "emailMktClient", text: "Email MKT-Client" },
                                    { id: "riClosings", text: "RI Closings" },
                                    { id: "factoryOperationYears", text: "Operation year of Factories (*)" },
                                    { id: "newReplacementValue", text: "New replacement value / reinstatement value (*)" },
                                    { id: "holdCoverType", text: "Hold Cover / Cover Note" },
                                    { id: "resultAttachment", text: "RES (*)" },
                                    { id: "declarationText", text: "Declaration" },
                                    { id: "machineryList", text: "List of machineries including the depreciated values for each of item (*)" },
                                    { id: "isBodApproved", text: "BoDs/UW's approved" },
                                    { id: "uRFAttachment", text: "URF" },
                                    { id: "emailInformRi", text: "Email inform RI for Endorsement" },
                                    { id: "riScheme", text: "RI Scheme (New/RN)" },
                                    { id: "proposalForm", text: "Proposal form (must for CCI)" },
                                    { id: "propertyType", text: "Type of Property list (must for FCI)" },
                                    { id: "sumInsuredBreakdown", text: "Breakdown SI for each location (must for FCI)" },
                                    { id: "premiumBreakdown", text: "Premium Breakdown" },
                                    { id: "chassisEngineNumber", text: "Chassis - Engine No. (*)" },
                                    { id: "finalPremium", text: "Final Premium in Motor system = Premium in received final Quotation (*)" },
                                    { id: "isKycChecked", text: "KYC Checked" },
                                    { id: "others", text: "Others (Specify)" },
                                    { id: "isGlobalCover", text: "Global" },
                                    { id: "ichigenka", text: "Ichigenka" }]
    };

    const enumLazyLoadNames = Object.keys(_enums)
        .filter(name => Array.isArray(_enums[name]) && _enums[name].length === 0);

    window.enumLazyLoadPromise = enumLazyLoadNames.length
        ? (function () {
            window.setSignalRDiagnosticStatus?.(
                "FetchEnum",
                "loading",
                `Lazy loading ${enumLazyLoadNames.length} enum groups`);

            return $.ajax({
                url: "/api/EnumData/FetchEnumBatch",
                method: "POST",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: JSON.stringify(enumLazyLoadNames)
            }).done(function (batch) {
                enumLazyLoadNames.forEach(function (name) {
                    _enums[name] = Array.isArray(batch?.[name]) ? batch[name] : [];
                });

                if (enumLazyLoadNames.includes("NotificationType")) {
                    if (typeof refreshNotificationTypeFilterData === "function") {
                        refreshNotificationTypeFilterData();
                    }
                    if (typeof refreshNotifUI === "function") {
                        refreshNotifUI();
                    }
                }

                window.setSignalRDiagnosticStatus?.(
                    "FetchEnum",
                    "complete",
                    `Loaded ${enumLazyLoadNames.length} enum groups in one batch`);
            }).fail(function (xhr) {
                window.setSignalRDiagnosticStatus?.(
                    "FetchEnum",
                    "error",
                    `Lazy load failed (${xhr.status || "network"})`);
            });
        })()
        : $.Deferred().resolve(_enums).promise();
</script>

<script>
    function loadSelectedWorkflow(params) {

         
        //start render workflowc lazy load, all view department with decision load first , second time in QT or PI  _Form
        params = params || {};
        const moduleCode = String(params.moduleCode || "")
            .trim()
            .toLowerCase();

        if (moduleCode !== viewIdModulePrefix.quotation && moduleCode !== viewIdModulePrefix.policyIssuance) {
            return $.Deferred()
                .reject(new Error(
                    `moduleCode must be '${viewIdModulePrefix.quotation}' or '${viewIdModulePrefix.policyIssuance}'`
                ))
                .promise();
        }
        const loadingClass = "actionRight";
        // const loadingHost = params.loadingHost;
        const loadingHost = $(`[aria-action-right='${params.stageDept}']`);
        showLoading(loadingClass, loadingHost);

        const id = params.id;
        const guid = params.guid;
        const stageDept = params.stageDept;
         window.checkFeatureRoleRule({
                // feature: "Approve Button",
                roles: _role,
                stageDepts: params.data?.formItems?.stageDept,
                sections: [_role]
            }).then(x => console.log(x));
        const state = params.state || {};
        const deptCodes = params.deptCodes || (
            moduleCode === viewIdModulePrefix.policyIssuance ? piDeptModuleCode : qtDeptModuleCode
        );
        const formStages = params.formStages;
        const remarkBoxes = params.remarkBoxes || {};
        const prefix = params.prefix || "";
        const reload = params.reload === true;

        const loadScreenConditions =
            params.loadScreenConditions ||
            function () {
                return $.Deferred().resolve().promise();
            };

        const submitNextStepFn =
            params.submitNextStep || function () {};

        const returnToStepFn =
            params.returnToStep || function () {};

        const moduleConfigs = {
            [viewIdModulePrefix.quotation]: {
                key: viewIdModulePrefix.quotation,

                workflowUrl: function (selectedGuid) {
                    return `/api/Quotation/GetQuotationWorkflow/${selectedGuid}`;
                },

                nextStepUrl: function (workflowDefinitionId, currentStep) {
                    return `/api/StepsWorkflow/GetNextStep/${workflowDefinitionId}/${currentStep}`;
                },

                updateUrl: "/api/Quotation/UpdateData",

                formKey:
                    params.formModuleKey ||
                    (
                        typeof formModuleKeyQt !== "undefined"
                            ? formModuleKeyQt
                            : viewIdModulePrefix.quotation
                    ),

                getFormId: function (dept, recordId) {
                    if (
                        window.QuotationIdManager &&
                        typeof window.QuotationIdManager.form === "function"
                    ) {
                        return window.QuotationIdManager.form(dept, recordId);
                    }

                    return null;
                },

                getReturnButtonId: function (dept, recordId) {
                    if (
                        window.QuotationIdManager &&
                        typeof window.QuotationIdManager.btnReturnBranch === "function"
                    ) {
                        return window.QuotationIdManager.btnReturnBranch(
                            dept,
                            recordId
                        );
                    }

                    return null;
                },

                getSubmitButtonId: function (dept, recordId) {
                    if (
                        window.QuotationIdManager &&
                        typeof window.QuotationIdManager.btnSubmitBranch === "function"
                    ) {
                        return window.QuotationIdManager.btnSubmitBranch(
                            dept,
                            recordId
                        );
                    }

                    return null;
                }
            },

            [viewIdModulePrefix.policyIssuance]: {
                key: viewIdModulePrefix.policyIssuance,

                // Change these API routes here if the real PI endpoints differ.
                workflowUrl: function (selectedGuid) {
                    return `/api/PolicyIssuance/GetPolicyIssuanceWorkflow/${selectedGuid}`;
                },

                nextStepUrl: function (workflowDefinitionId, currentStep) {
                    return `/api/StepsWorkflow/GetNextStep/${workflowDefinitionId}/${currentStep}`;
                },

                updateUrl: "/api/PolicyIssuance/UpdateData",

                formKey:
                    params.formModuleKey ||
                    (
                        typeof formModuleKeyPi !== "undefined"
                            ? formModuleKeyPi
                            : viewIdModulePrefix.policyIssuance
                    ),

                getFormId: function (dept, recordId) {
                    if (
                        window.PolicyIssuanceIdManager &&
                        typeof window.PolicyIssuanceIdManager.form === "function"
                    ) {
                        return window.PolicyIssuanceIdManager.form(
                            dept,
                            recordId
                        );
                    }

                    return null;
                },

                getReturnButtonId: function (dept, recordId) {
                    if (
                        window.PolicyIssuanceIdManager &&
                        typeof window.PolicyIssuanceIdManager.btnReturnBranch === "function"
                    ) {
                        return window.PolicyIssuanceIdManager.btnReturnBranch(
                            dept,
                            recordId
                        );
                    }

                    return null;
                },

                getSubmitButtonId: function (dept, recordId) {
                    if (
                        window.PolicyIssuanceIdManager &&
                        typeof window.PolicyIssuanceIdManager.btnSubmitBranch === "function"
                    ) {
                        return window.PolicyIssuanceIdManager.btnSubmitBranch(
                            dept,
                            recordId
                        );
                    }

                    return null;
                }
            }
        };

        const moduleConfig = $.extend(
            true,
            {},
            moduleConfigs[moduleCode],
            params.moduleConfig || {}
        );

        function normalizeDept(value) {
            return String(value || "")
                .trim()
                .toUpperCase();
        }

        function normalizeGroupKey(value) {
            return normalizeDept(value)
                .replace(/[^A-Z0-9]/g, "");
        }

        function safeKey(value) {
            return String(value ?? "")
                .replace(/[^a-zA-Z0-9_-]/g, "_");
        }

        function getFormItems(dept) {
            const formId = moduleConfig.getFormId(dept, id);

            if (!formId) {
                return {};
            }

            const formInstance =
                $(`#${formId}`).dxForm("instance");

            return formInstance?.option("formData") || {};
        }

        function parseWorkflowRouteData(route) {
            var routeData = route?.data ?? route?.Data;
            if (routeData && typeof routeData === "object") return routeData;
            if (typeof routeData !== "string" || !routeData.trim()) return {};

            try {
                return JSON.parse(routeData) || {};
            } catch (error) {
                return {};
            }
        }

        function collectWorkflowRuntimeData() {
            var sources = [params.formData, params.data, getFormItems(stageDept)];
            deptCodes.forEach(function (dept) {
                sources.push(getFormItems(dept));
            });

            return sources.filter(function (source) {
                return source && typeof source === "object";
            });
        }

        function isWorkflowConditionEnabled(propertyKey, runtimeSources) {
            var normalizedKey = String(propertyKey || "").trim().toLowerCase();
            if (!normalizedKey) return false;

            if (normalizedKey === "skipts") {
                return runtimeSources.some(function (source) {
                    return resolvePolicyIssuanceSkipTS(source) === true;
                });
            }

            return runtimeSources.some(function (source) {
                var matchingKey = Object.keys(source).find(function (key) {
                    return String(key).trim().toLowerCase() === normalizedKey;
                });
                if (!matchingKey) return false;

                var value = source[matchingKey];
                if (typeof value === "string") {
                    var normalizedValue = value.trim().toLowerCase();
                    return normalizedValue !== "" &&
                        !["false", "0", "null", "undefined", "no", "off"].includes(normalizedValue);
                }
                return Boolean(value);
            });
        }

        function selectRuntimeRoutes(routes) {
            var candidates = Array.isArray(routes) ? routes : [];
            var runtimeSources = collectWorkflowRuntimeData();
            var hasJumpConfiguration = false;
            var activeJumpRoutes = candidates.filter(function (route) {
                var routeData = parseWorkflowRouteData(route);
                var nodeJump = routeData?.nodeJump ?? routeData?.NodeJump ?? {};
                var jumpDefinitions =
                    routeData?.jumpDefinitions ?? routeData?.JumpDefinitions ??
                    nodeJump?.definitions ?? nodeJump?.Definitions ??
                    route?.jumpDefinitions ?? route?.JumpDefinitions ?? [];

                var transitionMap = nodeJump.transitionMap ?? nodeJump.TransitionMap ?? {};
                var conditionNames = nodeJump.conditionNames ?? nodeJump.ConditionNames ?? [];
                var transitionId = String(
                    nodeJump.transitionId ?? nodeJump.TransitionId ??
                    routeData?.transitionId ?? routeData?.TransitionId ??
                    route?.transitionId ?? route?.TransitionId ?? route?.routeId ?? route?.id ?? ""
                );
                var configuredConditions = [];

                if (Array.isArray(conditionNames)) {
                    configuredConditions = configuredConditions.concat(conditionNames);
                }
                if (transitionMap && typeof transitionMap === "object") {
                    Object.keys(transitionMap).forEach(function (conditionName) {
                        if (String(transitionMap[conditionName] ?? "") === transitionId) {
                            configuredConditions.push(conditionName);
                        }
                    });
                }
                if (Array.isArray(jumpDefinitions)) {
                    jumpDefinitions.forEach(function (definition) {
                        var definitionTransitionId = String(
                            definition?.transitionId ?? definition?.TransitionId ?? definition?.jumpTransitionId ?? ""
                        );
                        if (definitionTransitionId !== transitionId) return;

                        configuredConditions.push(
                            definition?.propertyKey ?? definition?.PropertyKey ??
                            definition?.conditionName ?? definition?.ConditionName ?? definition?.name ?? ""
                        );
                    });
                }

                if (Object.keys(transitionMap || {}).length || jumpDefinitions.length || configuredConditions.length) {
                    hasJumpConfiguration = true;
                }

                var isJumpRoute = String(route?.flowType ?? route?.FlowType ?? "")
                    .trim()
                    .toLowerCase() === "jump";

                return isJumpRoute && configuredConditions.some(function (conditionName) {
                    return isWorkflowConditionEnabled(conditionName, runtimeSources);
                });
            });

            if (activeJumpRoutes.length) return activeJumpRoutes;
            if (!hasJumpConfiguration) return candidates;

            return candidates.filter(function (route) {
                return String(route?.flowType ?? route?.FlowType ?? "")
                    .trim()
                    .toLowerCase() !== "jump";
            });
        }

        function collectWorkflowUiLockRules(value, result, seen, depth) {
            result = result || [];
            seen = seen || new WeakSet();
            depth = depth || 0;
            if (value == null || depth > 7) return result;

            if (typeof value === "string") {
                const text = value.trim();
                if (!text || (text[0] !== "{" && text[0] !== "[")) return result;
                try {
                    return collectWorkflowUiLockRules(JSON.parse(text), result, seen, depth + 1);
                } catch (error) {
                    return result;
                }
            }

            if (typeof value !== "object") return result;
            if (seen.has(value)) return result;
            seen.add(value);

            if (Array.isArray(value)) {
                value.forEach(function (item) {
                    collectWorkflowUiLockRules(item, result, seen, depth + 1);
                });
                return result;
            }

            if (String(value.type ?? value.Type ?? "").trim().toLowerCase() === "uilock") {
                result.push(value);
            }

            Object.keys(value).forEach(function (key) {
                collectWorkflowUiLockRules(value[key], result, seen, depth + 1);
            });
            return result;
        }

        function findWorkflowFormItem(items, targetName, parentPath) {
            const normalizedTarget = String(targetName || "").trim().toLowerCase();
            if (!normalizedTarget) return null;

            for (const item of (Array.isArray(items) ? items : [])) {
                if (!item) continue;
                const itemKey = item.name || item.dataField || item.caption || "";
                const itemPath = parentPath && itemKey
                    ? `${parentPath}.${itemKey}`
                    : (itemKey || parentPath || "");

                if (String(item.name || "").trim().toLowerCase() === normalizedTarget) {
                    return { item: item, path: itemPath || targetName };
                }

                const nested = findWorkflowFormItem(item.items, targetName, itemPath);
                if (nested) return nested;
            }
            return null;
        }

        function collectWorkflowFormGroups(items, parentPath, result) {
            result = result || [];
            (Array.isArray(items) ? items : []).forEach(function (item) {
                if (!item) return;
                const itemKey = item.name || item.dataField || item.caption || "";
                const itemPath = parentPath && itemKey
                    ? `${parentPath}.${itemKey}`
                    : (itemKey || parentPath || "");
                const itemType = String(item.itemType || "").trim().toLowerCase();

                if (itemType === "group" && item.name) {
                    result.push({
                        name: String(item.name),
                        path: itemPath || String(item.name)
                    });
                }
                collectWorkflowFormGroups(item.items, itemPath, result);
            });
            return result;
        }

        function restoreWorkflowUiLockedGroups() {
            $(
                `.workflow-ui-lock-group[data-workflow-ui-locked='true']` +
                `[data-workflow-ui-lock-record='${id}']` +
                `[data-workflow-ui-lock-module='${moduleCode}']`
            ).each(function () {
                const $group = $(this);
                $group.find("[data-workflow-ui-lock-widget]").each(function () {
                    const state = $(this).data("workflowUiLockOriginal");
                    if (!state?.instance) return;
                    try {
                        if (state.disabled !== undefined) state.instance.option("disabled", state.disabled);
                        if (state.readOnly !== undefined) state.instance.option("readOnly", state.readOnly);
                        if (state.editing !== undefined) state.instance.option("editing", state.editing);
                    } catch (error) {
                        console.warn("Unable to restore workflow UI lock widget.", error);
                    }
                    $(this)
                        .removeAttr("data-workflow-ui-lock-widget")
                        .removeData("workflowUiLockOriginal");
                });

                $group.find("input, textarea, select").filter(function () {
                    return !$(this).closest(".dx-widget").length;
                }).each(function () {
                    const state = $(this).data("workflowUiLockNativeOriginal");
                    if (!state) return;
                    this.disabled = state.disabled;
                    this.readOnly = state.readOnly;
                    $(this).removeData("workflowUiLockNativeOriginal");
                });

                $group.find("[data-workflow-ui-lock-tmiv='true']").each(function () {
                    const $uploader = $(this);
                    const originalDisabled = $uploader.data("workflowUiLockTmivDisabled");
                    try {
                        $uploader.fileuploader("option", "disabled", !!originalDisabled);
                    } catch (error) {}
                    $uploader
                        .removeAttr("data-workflow-ui-lock-tmiv")
                        .removeData("workflowUiLockTmivDisabled");
                });

                $group.find("[data-workflow-ui-lock-tmiv-control]").each(function () {
                    const $control = $(this);
                    const pluginName = $control.attr("data-workflow-ui-lock-tmiv-control");
                    const originalDisabled = $control.data("workflowUiLockTmivControlDisabled");
                    try {
                        if (pluginName === "datebox") {
                            $control.datebox({ disabled: !!originalDisabled });
                        } else if (pluginName) {
                            $control[pluginName]("option", "disabled", !!originalDisabled);
                        }
                    } catch (error) {}
                    $control
                        .removeAttr("data-workflow-ui-lock-tmiv-control")
                        .removeData("workflowUiLockTmivControlDisabled");
                });

                $group
                    .removeClass("workflow-ui-lock-group")
                    .removeAttr(
                        "data-workflow-ui-locked data-workflow-ui-lock-mode " +
                        "data-workflow-ui-lock-record data-workflow-ui-lock-module aria-disabled"
                    );
            });
        }

        function lockWorkflowWidget($element, pluginName, mode) {
            let instance;
            try {
                instance = $element[pluginName]("instance");
            } catch (error) {
                return;
            }
            if (!instance || $element.attr("data-workflow-ui-lock-widget")) return;

            const readOnlyPlugins = new Set([
                "dxTextBox", "dxTextArea", "dxSelectBox", "dxDateBox",
                "dxNumberBox", "dxTagBox", "dxDropDownBox", "dxAutocomplete"
            ]);
            const isGrid = pluginName === "dxDataGrid" || pluginName === "dxTreeList";
            const original = {
                instance: instance,
                disabled: instance.option("disabled")
            };

            try {
                if (isGrid) {
                    original.editing = $.extend(true, {}, instance.option("editing") || {});
                    instance.option("editing", $.extend(true, {}, original.editing, {
                        allowAdding: false,
                        allowDeleting: false,
                        allowUpdating: false
                    }));
                    if (String(mode || "").toLowerCase() !== "readonly") {
                        instance.option("disabled", true);
                    }
                } else if (
                    String(mode || "").toLowerCase() === "readonly" &&
                    readOnlyPlugins.has(pluginName)
                ) {
                    original.readOnly = instance.option("readOnly");
                    instance.option("readOnly", true);
                } else {
                    instance.option("disabled", true);
                }

                $element
                    .attr("data-workflow-ui-lock-widget", pluginName)
                    .data("workflowUiLockOriginal", original);
            } catch (error) {
                console.warn("Unable to apply workflow UI lock widget.", pluginName, error);
            }
        }

        function lockWorkflowFormGroup(formInstance, target, rule) {
            const targetName = target?.name ?? target?.Name;
            const targetItemType = target?.itemType ?? target?.ItemType ?? "group";
            if (!formInstance || !targetName) return false;
            if (String(targetItemType).toLowerCase() !== "group") return false;

            const match = findWorkflowFormItem(formInstance.option("items") || [], targetName, "");
            if (!match) return false;

            const markerClass = `workflow-ui-lock-target-${safeKey(targetName)}`;
            const currentClass = String(match.item.cssClass || "");
            if (!currentClass.split(/\s+/).includes(markerClass)) {
                try {
                    formInstance.itemOption(
                        match.path,
                        "cssClass",
                        `${currentClass} ${markerClass}`.trim()
                    );
                } catch (error) {
                    console.warn("Unable to mark workflow UI lock group.", target, error);
                }
            }

            const $form = formInstance.$element ? formInstance.$element() : $();
            const $group = $form.find(`.${markerClass}`).first();
            if (!$group.length) return false;

            const mode = String(rule.mode ?? rule.Mode ?? "ReadOnly");
            $group
                .addClass("workflow-ui-lock-group")
                .attr({
                    "data-workflow-ui-locked": "true",
                    "data-workflow-ui-lock-mode": mode,
                    "data-workflow-ui-lock-record": id,
                    "data-workflow-ui-lock-module": moduleCode,
                    "aria-disabled": "true"
                });

            const widgetPlugins = [
                [".dx-textbox", "dxTextBox"],
                [".dx-textarea", "dxTextArea"],
                [".dx-selectbox", "dxSelectBox"],
                [".dx-datebox", "dxDateBox"],
                [".dx-numberbox", "dxNumberBox"],
                [".dx-tagbox", "dxTagBox"],
                [".dx-dropdownbox", "dxDropDownBox"],
                [".dx-autocomplete", "dxAutocomplete"],
                [".dx-checkbox", "dxCheckBox"],
                [".dx-radiogroup", "dxRadioGroup"],
                [".dx-switch", "dxSwitch"],
                [".dx-fileuploader", "dxFileUploader"],
                [".dx-datagrid", "dxDataGrid"],
                [".dx-treelist", "dxTreeList"],
                [".dx-button", "dxButton"]
            ];
            widgetPlugins.forEach(function (entry) {
                $group.find(entry[0]).each(function () {
                    lockWorkflowWidget($(this), entry[1], mode);
                });
            });

            $group.find(".tmivcom-dx-fileuploader").each(function () {
                const $uploader = $(this);
                if (!$uploader.attr("data-workflow-ui-lock-tmiv")) {
                    let originalDisabled = false;
                    try {
                        originalDisabled = !!$uploader.fileuploader("option", "disabled");
                    } catch (error) {}
                    $uploader
                        .attr("data-workflow-ui-lock-tmiv", "true")
                        .data("workflowUiLockTmivDisabled", originalDisabled);
                }
                try {
                    $uploader.fileuploader("option", "disabled", true);
                } catch (error) {}
            });

            $group.find(".tmiv-render-form-datebox").each(function () {
                const $dateBox = $(this);
                if (!$dateBox.attr("data-workflow-ui-lock-tmiv-control")) {
                    const originalDisabled = $dateBox
                        .find(".tmivcom-datebox")
                        .hasClass("is-disabled");
                    $dateBox
                        .attr("data-workflow-ui-lock-tmiv-control", "datebox")
                        .data("workflowUiLockTmivControlDisabled", originalDisabled);
                }
                try {
                    $dateBox.datebox({ disabled: true });
                } catch (error) {}
            });

            $group.find("input, textarea, select").filter(function () {
                return !$(this).closest(".dx-widget").length;
            }).each(function () {
                const $native = $(this);
                if (!$native.data("workflowUiLockNativeOriginal")) {
                    $native.data("workflowUiLockNativeOriginal", {
                        disabled: this.disabled,
                        readOnly: this.readOnly
                    });
                }
                if (
                    String(mode).toLowerCase() === "readonly" &&
                    (this.tagName === "TEXTAREA" || String(this.type || "").toLowerCase() === "text")
                ) {
                    this.readOnly = true;
                } else {
                    this.disabled = true;
                }
            });
            return true;
        }

        function enableOnlyWorkflowFormGroup(formInstance, target, rule) {
            const targetName = target?.name ?? target?.Name;
            if (!formInstance || !targetName) return false;

            const items = formInstance.option("items") || [];
            const targetMatch = findWorkflowFormItem(items, targetName, "");
            if (!targetMatch) return false;

            const targetPath = String(targetMatch.path || targetName).toLowerCase();
            const disabledRule = $.extend({}, rule, { mode: "Disabled" });
            collectWorkflowFormGroups(items, "", []).forEach(function (group) {
                const groupPath = String(group.path || group.name).toLowerCase();
                const isTargetBranch = groupPath === targetPath
                    || groupPath.startsWith(`${targetPath}.`)
                    || targetPath.startsWith(`${groupPath}.`);
                if (isTargetBranch) return;
                lockWorkflowFormGroup(
                    formInstance,
                    { itemType: "group", name: group.name },
                    disabledRule
                );
            });
            return true;
        }

        function getWorkflowRuleGroupTargets(rule) {
            const result = [];
            const seen = new Set();
            const configuredTargets = rule.targets ?? rule.Targets;
            const groupNames = rule.groupNames ?? rule.GroupNames;

            function appendTarget(target) {
                if (typeof target === "string") {
                    target = { itemType: "group", name: target };
                }
                const name = String(target?.name ?? target?.Name ?? "").trim();
                const itemType = String(target?.itemType ?? target?.ItemType ?? "group").trim().toLowerCase();
                if (!name || itemType !== "group") return;
                const key = name.toLowerCase();
                if (seen.has(key)) return;
                seen.add(key);
                result.push({ itemType: "group", name: name });
            }

            (Array.isArray(configuredTargets) ? configuredTargets : []).forEach(appendTarget);
            (Array.isArray(groupNames)
                ? groupNames
                : String(groupNames || "").split(",")
            ).forEach(appendTarget);

            if (!result.length) {
                appendTarget(rule.sectionId ?? rule.SectionId);
            }
            return result;
        }

        function disableAllWorkflowFormGroups(formInstance, rule) {
            const disabledRule = $.extend({}, rule, { mode: "Disabled" });
            collectWorkflowFormGroups(formInstance.option("items") || [], "", []).forEach(function (group) {
                lockWorkflowFormGroup(
                    formInstance,
                    { itemType: "group", name: group.name },
                    disabledRule
                );
            });
        }

        function enableOnlyWorkflowFormGroups(formInstance, targets, rule) {
            const items = formInstance.option("items") || [];
            const targetPaths = (Array.isArray(targets) ? targets : [])
                .map(function (target) {
                    const match = findWorkflowFormItem(items, target?.name, "");
                    return match ? String(match.path || target.name).toLowerCase() : "";
                })
                .filter(Boolean);
            if (!targetPaths.length) {
                disableAllWorkflowFormGroups(formInstance, rule);
                return false;
            }

            const disabledRule = $.extend({}, rule, { mode: "Disabled" });
            collectWorkflowFormGroups(items, "", []).forEach(function (group) {
                const groupPath = String(group.path || group.name).toLowerCase();
                const belongsToEnabledBranch = targetPaths.some(function (targetPath) {
                    return groupPath === targetPath
                        || groupPath.startsWith(`${targetPath}.`)
                        || targetPath.startsWith(`${groupPath}.`);
                });
                if (belongsToEnabledBranch) return;
                lockWorkflowFormGroup(
                    formInstance,
                    { itemType: "group", name: group.name },
                    disabledRule
                );
            });
            return true;
        }

        function applyWorkflowUiLockRules(workflowPayload) {
            restoreWorkflowUiLockedGroups();
            const rules = collectWorkflowUiLockRules(workflowPayload);
            rules.forEach(function (rule) {
                const condition = String(rule.condition ?? rule.Condition ?? "").trim().toLowerCase();
                if (condition === "false") return;

                const configuredDepartment = String(rule.department ?? rule.Department ?? "").trim();
                const trigger = String(rule.trigger ?? rule.Trigger ?? "").trim().toLowerCase();
                const normalizedStageDept = normalizeDept(stageDept);
                const normalizedRuleDept = normalizeDept(configuredDepartment);
                if (trigger === "enableonlygroup"
                    && (!normalizedStageDept || (normalizedRuleDept && normalizedRuleDept !== normalizedStageDept))) {
                    return;
                }
                const department = trigger === "enableonlygroup"
                    ? normalizedStageDept
                    : normalizeDept(configuredDepartment || stageDept);
                if (!department) return;
                const formId = moduleConfig.getFormId(department, id);
                const formInstance = formId ? $(`#${formId}`).dxForm("instance") : null;
                if (!formInstance) return;

                const targetList = getWorkflowRuleGroupTargets(rule);
                if (trigger === "samedepartmentreturn") {
                    const accountRole = normalizeDept(
                        typeof _role !== "undefined" ? _role : window._role
                    );
                    if (accountRole && accountRole === department) {
                        enableOnlyWorkflowFormGroups(formInstance, targetList, rule);
                    } else {
                        disableAllWorkflowFormGroups(formInstance, rule);
                    }
                } else if (trigger === "enableonlygroup") {
                    if (targetList[0]) enableOnlyWorkflowFormGroup(formInstance, targetList[0], rule);
                } else {
                    targetList.forEach(function (target) {
                        lockWorkflowFormGroup(formInstance, target, rule);
                    });
                }
            });
            return rules;
        }

        function getRemark(dept) {
            const value =
                remarkBoxes?.[dept]
                    ?.controlRemark
                    ?.value?.();

            if (value == null) {
                return "";
            }

            if (typeof value === "string") {
                return value;
            }

            return value.text || "";
        }

        function getRouteGroupKeys(routeData) {
            const route =
                typeof routeData === "object" && routeData
                    ? routeData
                    : {
                        fromNodeId: routeData
                    };

            return [
                route.fromNodeId,
                route.fromDeptCode,
                route.departmentCode,
                route.deptCode,
                route.roleCode,
                route.nodeName
            ]
                .map(normalizeGroupKey)
                .filter(function (value, index, values) {
                    return (
                        value.length >= 2 &&
                        values.indexOf(value) === index
                    );
                });
        }

        function getRouteDept(route, fallbackDept) {
            return normalizeDept(
                route?.fromDeptCode ||
                route?.departmentCode ||
                route?.deptCode ||
                route?.fromNodeId ||
                fallbackDept
            );
        }

        function normalizeRouteConditionValue(value) {
            return String(value ?? "")
                .trim()
                .replace(/\s+/g, " ")
                .toLowerCase();
        }

        function getCustomRouteLabels(route) {
            const routeData = safeJsonParse(route?.data) || {};
            return [
                route?.text,
                route?.name,
                route?.textName,
                route?.displayStatus,
                route?.actionName,
                route?.actionCode,
                routeData?.text,
                routeData?.name,
                routeData?.textName,
                routeData?.displayStatus,
                routeData?.actionName,
                routeData?.actionCode
            ]
                .map(normalizeRouteConditionValue)
                .filter(Boolean);
        }

        function getWorkflowRequestType() {
            const selectedRecords = [];
            const sharedStates = [
                state,
                window.QuotationPage?.state,
                window.PolicyIssuancePage?.state
            ].filter(Boolean);

            sharedStates.forEach(function (workflowState) {
                [workflowState.quotes, workflowState.policyIssuances, workflowState.items].forEach(function (records) {
                    if (!Array.isArray(records)) return;
                    const selected = records.find(function (item) {
                        return String(item?.id ?? item?.Id ?? "") === String(workflowState.selectedId ?? state.selectedId ?? id);
                    }) || records[0];
                    if (selected) selectedRecords.push(selected);
                });
            });

            if (state.selectedId && state.quoteDetails?.[state.selectedId]) {
                selectedRecords.unshift(state.quoteDetails[state.selectedId]);
            }
            if (state.selectedId && state.piDetails?.[state.selectedId]) {
                selectedRecords.unshift(state.piDetails[state.selectedId]);
            }

            const candidates = [
                params.requestType,
                params.data?.requestType,
                params.data?.RequestType,
                params.data?.formItems?.requestType,
                params.data?.formItems?.RequestType,
                state.requestType,
                state.RequestType,
                window.QuotationPage?.state?.requestType,
                window.PolicyIssuancePage?.state?.requestType
            ];

            selectedRecords.forEach(function (record) {
                candidates.push(record?.requestType, record?.RequestType);
            });

            for (const candidate of candidates) {
                if (candidate == null || candidate === "") continue;
                if (typeof candidate === "object") {
                    const nested = candidate.value ?? candidate.Value ?? candidate.text ?? candidate.Text ?? candidate.name ?? candidate.Name;
                    if (nested != null && nested !== "") return normalizeRouteConditionValue(nested);
                    continue;
                }
                return normalizeRouteConditionValue(candidate);
            }
            return "";
        }

        function shouldShowCustomRoute(route) {
            const isNoNeedToRefer = getCustomRouteLabels(route).includes("no need to refer");
            if (!isNoNeedToRefer) return true;
            return getWorkflowRequestType() === "endorsement";
        }

        function cleanupDynamicButtons() {
            $(`[data-workflow-record-id="${id}"]`).each(function () {
                try {
                    const instance = $(this).dxButton("instance");

                    if (instance) {
                        instance.dispose();
                    }
                } catch (e) {}

                $(this).remove();
            });

            $(
                `[data-route-custom-host="true"]` +
                `[data-record-id="${id}"]`
            ).remove();
        }

        function resolveNormalButtonHost(buttonHostId, context) {
            let $host = $(`#${buttonHostId}`);

            if ($host.length) {
                return $host;
            }

            $host = $(`<div id="${buttonHostId}"></div>`);

            if (typeof params.resolveButtonHost === "function") {
                const target = params.resolveButtonHost(context);

                if (target?.length) {
                    $host.appendTo(target);
                }
            }

            return $host;
        }

        function buildNormalRouteButton(options) {
            const route = options.route;
            const isReturn = options.type === "return";
            const isReturnNeedAccepted = options.route.isReturnNeedAccepted || false;
            const buttonHostId =
                isReturn
                    ? moduleConfig.getReturnButtonId(stageDept, id)
                    : moduleConfig.getSubmitButtonId(stageDept, id);

            if (!buttonHostId) {
                return;
            }

            const rawRouteKey =
                route?.routeId ||
                route?.id ||
                route?.actionCode ||
                options.routeIndex;

            const buttonId =
                `${buttonHostId}_${safeKey(rawRouteKey)}`;

            const $oldButton = $(`#${buttonId}`);

            if ($oldButton.length) {
                try {
                    $oldButton.dxButton("instance")?.dispose();
                } catch (e) {}

                $oldButton.remove();
            }

            const $host = resolveNormalButtonHost(
                buttonHostId,
                {
                    type: isReturn ? "return" : "submit",
                    dept: stageDept,
                    route: route,
                    id: id,
                    moduleCode: moduleCode
                }
            );

            if (!$host.length) {
                return;
            }

            const $button = $(
                `<div
                    id="${buttonId}"
                    data-workflow-record-id="${id}"
                    data-workflow-route-button="true">
                </div>`
            ).appendTo($host);

            const buttonFormItems = getFormItems(stageDept);
            var buttonDisabled = shouldDisableWorkflowButton({
                dept: stageDept,
                stageDept: buttonFormItems.stageDept || stageDept,
                formItems: buttonFormItems,
                type: "route",
                items: $button
                });

                    if (isReturn && isReturnNeedAccepted) {
                        if (!(options.data.tatObject[buttonFormItems.stageDept]?.AcceptDate) && options.data.tatObject[buttonFormItems.stageDept]?.AcceptDate == ""){
                            buttonDisabled = false;
                        }
                }

            $button.dxButton({
                disabled: buttonDisabled,
                className: "submit-btn-visible",
                text:
                    route?.displayStatus ||
                    route?.actionName ||
                    route?.actionCode ||
                    (isReturn ? "Return" : "Submit"),

                icon:
                    typeof getTransitionButtonIcon === "function"
                        ? getTransitionButtonIcon(
                            route,
                            isReturn
                                ? "undo"
                                : "fa-solid fa-person-running"
                        )
                        : undefined,

                type:
                    isReturn
                        ? "danger"
                        : "info",

                onClick: function () {
                    const formItems =
                        getFormItems(stageDept);

                    const content =
                        getRemark(stageDept);

                    if (isReturn && !content) {
                        appNotifyWarning(
                            "Please put your reason to remarks!",
                            false
                        );

                        return;
                    }

                    formItems.comment =
                        content || "";

                    if (isReturn) {
                        return returnToStepFn(
                            moduleConfig.formKey,
                            state.nextStep,
                            route,
                            formItems,
                            params
                        );
                    }
                    if (!content) {
                        return appNotifyWarning(
                            "You may leave your remark empty, system will remark default message?",
                            true,
                            "Ok",
                            "Cancel"
                        ).then(function (result) {
                            if (!result.isConfirmed) return;

                            formItems.comment = `${_loginUser} ${route.displayStatus}`;
                            return submitNextStepFn(
                                moduleConfig.formKey,
                                state.nextStep,
                                route,
                                formItems,
                                params
                            );
                        });
                    }

                    return submitNextStepFn(
                        moduleConfig.formKey,
                        state.nextStep,
                        route,
                        formItems,
                        params
                    );
                        }

            });

            if (
                typeof applyTransitionButtonClass === "function"
            ) {
                applyTransitionButtonClass(
                    `#${buttonId}`,
                    route
                );
            }
        }

            async function buildCustomRoutes(customRoutes) {
                for (
                    const [deptIndex, deptItem]
                    of deptCodes.entries()
                ) {

                    const normalizedDept =
                        normalizeDept(deptItem);

                    const customRoutesInDept =
                        customRoutes.filter(function (route) {
                            if (!shouldShowCustomRoute(route)) {
                                return false;
                            }

                            const routeKeys =
                                getRouteGroupKeys(route);

                            const deptKey =
                                normalizeGroupKey(deptItem);

                            const isDeptMatch =
                                routeKeys.some(function (routeKey) {
                                    return (
                                        routeKey === deptKey ||
                                        routeKey.indexOf(deptKey) >= 0 ||
                                        deptKey.indexOf(routeKey) >= 0
                                    );
                                });

                            const routeData =
                                String(route?.data || "");

                            var groupMatch =
                                !routeData ||
                                routeData.includes(
                                    `decision${deptItem}Group`
                                );

                                if (deptItem == "FO")
                                {
                                     groupMatch =
                                    !routeData ||
                                    routeData.includes(
                                        `decisionClientGroup`
                                    );
                                }


                            return isDeptMatch && groupMatch;
                        });

                    if (!customRoutesInDept.length) {
                        continue;
                    }

                    for (
                        const [routeIndex, route]
                        of customRoutesInDept.entries()
                    ) {
                        if (formStages?.pace) {
                            await formStages.pace(routeIndex);
                        }
                        const routeDept =
                            getRouteDept(
                                route,
                                normalizedDept
                            );

                        let $routeHost =
                            typeof params.resolveCustomRouteHost === "function"
                                ? params.resolveCustomRouteHost({
                                    moduleCode: moduleCode,
                                    dept: routeDept,
                                    deptItem: deptItem,
                                    route: route,
                                    id: id,
                                    prefix: prefix
                                })
                                : $();

                        if (
                            !$routeHost?.length &&
                            moduleCode === viewIdModulePrefix.quotation
                        ) {
                            $routeHost =
                                $(
                                    `#decision-actions-qt-form_${deptItem}_${id}-${deptItem}`
                                )
                                    .first();
                        }

                        if (
                            !$routeHost?.length &&
                            moduleCode === viewIdModulePrefix.policyIssuance
                        ) {
                            $routeHost =
                                $(
                                    `#decision-actions-pi-form_${deptItem}_${id}-${deptItem}`
                                )
                                    .first();
                        }

                        if (!$routeHost.length) {
                            console.warn(
                                "Custom route host not found",
                                {
                                    moduleCode: moduleCode,
                                    deptItem: deptItem,
                                    routeDept: routeDept,
                                    route: route
                                }
                            );

                            continue;
                        }

                        const rawRouteKey =
                            route?.routeId ||
                            route?.id ||
                            route?.actionCode ||
                            routeIndex;

                        const customButtonId =
                            `${moduleCode}-custom-route-` +
                            `${id}-` +
                            `${routeDept}-` +
                            `${safeKey(rawRouteKey)}-` +
                            `${routeIndex}`;

                        const $old =
                            $(`#${customButtonId}`);

                        if ($old.length) {
                            try {
                                $old.dxButton("instance")?.dispose();
                            } catch (e) {}

                            $old.remove();
                        }

                        const $customButton =
                            $(
                                `<div
                                    id="${customButtonId}"
                                    data-workflow-record-id="${id}"
                                    data-custom-route-button="true">
                                </div>`
                            )
                                .appendTo($routeHost);


                        const formItems =
                            getFormItems(routeDept);

                        const latestTatObject =
                            typeof tryParseJSON === "function"
                                ? (
                                    tryParseJSON(
                                        formItems.turnAroundTimeAttributes,
                                        "TAT Load Button Problem"
                                    ) || {}
                                )
                                : {};

                        var disabled = shouldDisableWorkflowButton({
                            dept: routeDept,
                            stageDept: formItems.stageDept || stageDept,
                            formItems: formItems,
                            tatObject: latestTatObject,
                            type: "custom",
                            items: $customButton
                        });


                        $customButton.dxButton({
                            disabled: disabled,

                            text:
                                route?.displayStatus ||
                                route?.actionName ||
                                route?.actionCode ||
                                "Custom action",

                            icon:
                                typeof getTransitionButtonIcon === "function"
                                    ? getTransitionButtonIcon(
                                        route,
                                        route?.isReturn
                                            ? "undo"
                                            : ""
                                    )
                                    : undefined,

                            type:
                                route?.isReturn
                                    ? "danger"
                                    : "info",

                            onClick: function () {
                                const routeFormItems =
                                    getFormItems(routeDept);

                                const content =
                                    getRemark(routeDept);

                                if (
                                    route?.isReturn &&
                                    !content
                                ) {
                                    appNotifyWarning(
                                        "Please put your reason to remarks!",
                                        false
                                    );

                                    return;
                                }

                                routeFormItems.comment =
                                    content || "";

                                if (route?.isReturn) {
                                    return returnToStepFn(
                                        moduleConfig.formKey,
                                        state.nextStep,
                                        route,
                                        routeFormItems,
                                        params
                                    );
                                }

                                return submitNextStepFn(
                                    moduleConfig.formKey,
                                    state.nextStep,
                                    route,
                                    routeFormItems,
                                    params
                                );
                            }
                        });

                        if (
                            typeof applyTransitionButtonClass === "function"
                        ) {
                            applyTransitionButtonClass(
                                `#${customButtonId}`,
                                route
                            );
                        }
                    }
                }
            }

            if (reload) {
                cleanupDynamicButtons();
            }

            if (!guid) {
                restoreWorkflowUiLockedGroups();
                state.selectedGuid = null;
                hideLoading(loadingClass, loadingHost);

                return $.Deferred()
                    .resolve()
                    .promise();
            }

            state.selectedGuid = guid;
            //End of lazy load workflow render
        return ajaxGet(
            moduleConfig.workflowUrl(guid),

        )
            .then(function (instance) {
                state.workflowInstance =
                    instance;

                return $.when(
                    loadScreenConditions(
                        instance?.currentStep,
                        params.selectedId ?? id,
                        instance,
                        params
                    )
                )
                    .then(function () {
                        const workflowDefinitionId =
                            instance?.workflowDefinitionId ||
                            "00000000-0000-0000-0000-000000000000";

                        const currentStep =
                            instance?.currentStep ?? 0;

                        return ajaxGet(
                            moduleConfig.nextStepUrl(
                                workflowDefinitionId,
                                currentStep
                            ),
                            null
                        );
                    })
                    .then(function (data) {
                        data =
                            Array.isArray(data)
                                ? data
                                : [];

                        const workflowUiLockPayload = { instance: instance, routes: data };
                        applyWorkflowUiLockRules(workflowUiLockPayload);
                        // Some dxForm groups are injected shortly after the workflow request.
                        [100, 350].forEach(function (delay) {
                            setTimeout(function () {
                                applyWorkflowUiLockRules(workflowUiLockPayload);
                            }, delay);
                        });

                        state.nextStep =
                            state.nextStep || {};

                        state.nextStep.instanceWorkflow =
                            instance;

                        state.nextStep.flowSteps =
                            data;

                        state.nextStep.currentStep =
                            instance?.currentStep ?? 0;

                        const customRoutes =
                            data.filter(function (route) {
                                return String(
                                    route?.flowType || ""
                                )
                                    .trim()
                                    .toLowerCase() === "custom";
                            });

                        const normalRoutes =
                            selectRuntimeRoutes(data.filter(function (route) {
                                return (
                                    !route?.isReturn &&
                                    String(
                                        route?.flowType || ""
                                    )
                                        .trim()
                                        .toLowerCase() !== "custom" &&
                                    normalizeDept(
                                        route?.fromNodeId
                                    ) ===
                                        normalizeDept(stageDept) &&
                                    String(route?.fNodeId ?? "") ===
                                        String(state.nextStep.currentStep ?? "")
                                );
                            }));

                        const returnRoutes =
                            data.filter(function (route) {
                                return (
                                    route?.isReturn &&
                                    String(
                                        route?.flowType || ""
                                    )
                                        .trim()
                                        .toLowerCase() !== "custom" &&
                                    normalizeDept(
                                        route?.fromNodeId
                                    ) ===
                                        normalizeDept(stageDept) &&
                                    String(route?.fNodeId ?? "") ===
                                        String(state.nextStep.currentStep ?? "")
                                );
                            });

                        return $.when(
                            formStages?.enter
                                ? formStages.enter("routeState")
                                : null
                        )
                            .then(async function () {
                                for (
                                    const [routeIndex, route]
                                    of returnRoutes.entries()
                                ) {
                                    if (formStages?.pace) {
                                        await formStages.pace(
                                            routeIndex
                                        );
                                    }
                                    buildNormalRouteButton({
                                        route: route,
                                        type: "return",
                                        routeIndex: routeIndex,
                                        ...params
                                    });
                                }

                                for (
                                    const [routeIndex, route]
                                    of normalRoutes.entries()
                                ) {
                                    if (formStages?.pace) {
                                        await formStages.pace(
                                            returnRoutes.length +
                                            routeIndex
                                        );
                                    }

                                    buildNormalRouteButton({
                                        route: route,
                                        type: "submit",
                                        routeIndex: routeIndex,
                                        ...params
                                    });
                                }
                                await buildCustomRoutes(
                                    customRoutes
                                );

                                if (
                                    typeof params.onLoaded === "function"
                                ) {
                                    await params.onLoaded({
                                        instance: instance,
                                        routes: data,
                                        normalRoutes: normalRoutes,
                                        returnRoutes: returnRoutes,
                                        customRoutes: customRoutes,
                                        state: state,
                                        params: params
                                    });

                                }

                                return {
                                    instance: instance,
                                    routes: data,
                                    normalRoutes: normalRoutes,
                                    returnRoutes: returnRoutes,
                                    customRoutes: customRoutes,
                                    state: state
                                };
                            });
                    });
            })
            .always(function () {
                hideLoading(loadingClass, loadingHost);
            });
    }
</script>
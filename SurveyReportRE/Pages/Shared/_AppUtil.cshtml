           function disposeDecisionDockGroup(group) {
                var $group = $(group);
                $group.find(".dx-button").each(function () {
                    try { $(this).dxButton("instance")?.dispose(); } catch (_) { }
                });
                group.workflowDecisionPositionAnchor?.remove();
                $group.remove();
           }

           function getDecisionGroupInstanceKey(root, section, dock, group) {
                var overviewKey = root?.id || "workflow-overview";
                var sectionKey = section?.id || "department-section";
                var deptKey = group?.dataset?.routeDept
                    || dock?.dataset?.dept
                    || "department";
                var groupKey = group?.dataset?.decisionGroupKey
                    || group?.dataset?.formGroupName
                    || group?.id
                    || "decision-group";

                return [overviewKey, sectionKey, deptKey, groupKey]
                    .map(function (value) { return String(value).trim().toLowerCase(); })
                    .join("::");
           }

           function rememberDecisionGroupPosition(root, section, dock, group) {
                if (!group || !group.parentNode || dock?.contains(group)) return;

                var instanceKey = getDecisionGroupInstanceKey(root, section, dock, group);
                root.workflowDecisionGroupPositions = root.workflowDecisionGroupPositions || new Map();

                var currentPosition = root.workflowDecisionGroupPositions.get(instanceKey);
                if (currentPosition?.anchor?.isConnected && currentPosition.group === group) {
                    group.workflowDecisionPositionAnchor = currentPosition.anchor;
                    group.dataset.decisionInstanceKey = instanceKey;
                    return;
                }
                currentPosition?.anchor?.remove();

                var anchor = document.createComment("workflow-decision-group-position");
                group.parentNode.insertBefore(anchor, group);
                group.workflowDecisionPositionAnchor = anchor;
                group.dataset.decisionInstanceKey = instanceKey;
                root.workflowDecisionGroupPositions.set(instanceKey, { anchor: anchor, group: group });
           }

           function restoreDecisionGroupPosition(group) {
                var anchor = group?.workflowDecisionPositionAnchor;
                if (!anchor?.parentNode) return false;

                anchor.parentNode.insertBefore(group, anchor.nextSibling);
                group.classList.remove("workflow-decision-group--docked");
                return true;
           }

           function mountOverviewDecisionDocks(rootOrSelector) {
                var root = typeof rootOrSelector === "string"
                    ? document.querySelector(rootOrSelector)
                    : rootOrSelector;
                if (!root) return false;

                var dockGroups = function () {
                    root.querySelectorAll("section.dept-section").forEach(function (section) {
                        var dock = section.querySelector("[data-decision-dock]");
                        if (!dock) return;

                        var allGroups = Array.from(section.querySelectorAll(".workflow-decision-group"));
                        allGroups.forEach(function (group) {
                            if (group.dataset.decisionPlacement === "form") {
                                //rememberDecisionGroupPosition(root, section, dock, group);
                                // restoreDecisionGroupPosition(group);
                            }
                        });

                        var groups = allGroups.filter(function (group) {
                            return group.dataset.decisionPlacement !== "form"
                                && !dock.contains(group);
                        });
                        groups.forEach(function (group) {
                            var instanceKey = getDecisionGroupInstanceKey(root, section, dock, group);
                            group.dataset.decisionInstanceKey = instanceKey;

                            var current = Array.from(dock.querySelectorAll(".workflow-decision-group"))
                                .find(function (dockedGroup) {
                                    return dockedGroup.dataset.decisionInstanceKey === instanceKey;
                                });
                            if (current && current !== group) disposeDecisionDockGroup(current);
                            group.classList.add("workflow-decision-group--docked");
                            dock.appendChild(group);
                        });
                        dock.classList.toggle(
                            "has-decision",
                            !!dock.querySelector(".workflow-decision-group")
                        );
                    });
                };

                dockGroups();
                if (!root.overviewDecisionDockObserver) {
                    var pendingFrame = 0;
                    root.overviewDecisionDockObserver = new MutationObserver(function () {
                        if (pendingFrame) return;
                        pendingFrame = window.requestAnimationFrame(function () {
                            pendingFrame = 0;
                            dockGroups();
                        });
                    });
                    root.overviewDecisionDockObserver.observe(root, {
                        childList: true,
                        subtree: true
                    });
                }
                return true;
           }
           window.mountOverviewDecisionDocks = mountOverviewDecisionDocks;

           function resolveDepartmentSection(schemeName, recordId, dept) {
                var normalizedScheme = String(schemeName || "").replace(/\s+/g, "").toLowerCase();
                var moduleCode = normalizedScheme === "policyissuance" || normalizedScheme === "pi"
                    ? "pi"
                    : "qt";
                return document.getElementById(
                    `${moduleCode}-sec_${String(dept || "").trim().toUpperCase()}_${recordId}`
                );
           }

           function beginDepartmentSectionLoading(schemeName, recordId, dept, message) {
                var section = resolveDepartmentSection(schemeName, recordId, dept);
                if (!section) return null;

                setDeptSectionCollapsed($(section), false);
                var overlay = section.querySelector(".dept-section-action-overlay");
                if (!overlay) {
                    overlay = document.createElement("div");
                    overlay.className = "dept-section-action-overlay";
                    overlay.innerHTML = `
                        <div class="dept-section-action-loader" aria-hidden="true">
                            <span></span><span></span><span></span>
                        </div>
                        <span class="dept-section-action-message"></span>`;
                    section.appendChild(overlay);
                }

                overlay.classList.remove("is-success", "is-error");
                overlay.querySelector(".dept-section-action-message").textContent =
                    message || `Updating ${dept} decision...`;
                section.classList.add("dept-section-action-loading");
                section.setAttribute("aria-busy", "true");
                return { section: section, overlay: overlay };
           }

           function finishDepartmentSectionLoading(context, message, isError) {
                if (!context?.section || !context?.overlay) return;
                var section = context.section;
                var overlay = context.overlay;
                var messageElement = overlay.querySelector(".dept-section-action-message");
                if (messageElement && message) messageElement.textContent = message;
                overlay.classList.toggle("is-error", !!isError);
                overlay.classList.toggle("is-success", !isError);

                window.setTimeout(function () {
                    section.classList.remove("dept-section-action-loading");
                    section.removeAttribute("aria-busy");
                    if (!isError) {
                        section.classList.add("dept-section-decision-unlocked");
                        window.setTimeout(function () {
                            section.classList.remove("dept-section-decision-unlocked");
                        }, 900);
                    }
                }, isError ? 900 : 260);
           }

           function applyAcceptedDepartmentDecision(schemeName, recordId, dept, responseData) {
                var normalizedScheme = String(schemeName || "").replace(/\s+/g, "").toLowerCase();
                var isPolicyIssuance = normalizedScheme === "policyissuance" || normalizedScheme === "pi";
                var manager = isPolicyIssuance
                    ? window.PolicyIssuanceIdManager
                    : window.QuotationIdManager;
                var formId = manager?.form?.(dept, recordId);
                var form = formId ? $(`#${formId}`).dxForm("instance") : null;
                var acceptedAt = responseData?.acceptedAt || new Date().toISOString();
                var section = resolveDepartmentSection(schemeName, recordId, dept);

                if (section) {
                    $(section)
                        .find(".dept-upperbody, .dept-body, .dept-lowerbody, .dept-footer")
                        .show();
                    setDeptSectionCollapsed($(section), false);
                }

                if (!form) return Promise.resolve(false);

                var formItems = form.option("formData") || {};
                var tatObject = tryParseJSON(
                    formItems.turnAroundTimeAttributes,
                    "Accepted decision TAT update"
                ) || {};
                tatObject[dept] = tatObject[dept] || {};
                tatObject[dept].AcceptDate = acceptedAt;
                tatObject[dept].CompleteDate = acceptedAt;
                form.updateData("turnAroundTimeAttributes", JSON.stringify(tatObject));
                if (responseData?.workflowStatus) {
                    form.updateData("workflowStatus", responseData.workflowStatus);
                }

                var registryKey = `${formId}:${String(dept || "").trim().toUpperCase()}`;
                var decisionEntry = window.WorkflowDecisionRegistry[registryKey];
                if (decisionEntry) {
                    renderDecisionDeferredV2(
                        decisionEntry.formProps,
                        decisionEntry.groupName,
                        decisionEntry.mainFields,
                        ...decisionEntry.params
                    );
                } else if (section) {
                    $(section).find("[id^='AC_']").each(function () {
                        $(this).addClass("btn-success");
                        $(this).dxButton("instance")?.option("disabled", true);
                    });
                }

                return new Promise(function (resolve) {
                    window.setTimeout(function () {
                        var overviewRoot = section?.closest("[id^='qt-overviewRoot_'], [id^='pi-overviewRoot_']");
                        if (overviewRoot) mountOverviewDecisionDocks(overviewRoot);
                        // renderDecisionDeferredV2 has already rebuilt the decision
                        // field from the updated TAT. Repainting here recreates the
                        // template and resets the freshly rendered Accepted status.
                        resolve(true);
                    }, Math.max(0, Number(FormStageDelay?.unlockForm) || 0) + 120);
                });
           }
           window.applyAcceptedDepartmentDecision = applyAcceptedDepartmentDecision;

           function beginWorkflowElementLoading(element, message, scope) {
                if (!element) return null;
                var overlay = element.querySelector(":scope > .workflow-element-loading-overlay");
                if (!overlay) {
                    overlay = document.createElement("div");
                    overlay.className = "workflow-element-loading-overlay";
                    overlay.innerHTML = `
                        <div class="dept-section-action-loader" aria-hidden="true">
                            <span></span><span></span><span></span>
                        </div>
                        <span class="workflow-element-loading-message"></span>`;
                    element.appendChild(overlay);
                }
                overlay.dataset.loadingScope = scope || "element";
                overlay.classList.remove("is-success", "is-error");
                overlay.querySelector(".workflow-element-loading-message").textContent = message || "Saving...";
                element.classList.add("workflow-element-loading");
                element.setAttribute("aria-busy", "true");
                return { element: element, overlay: overlay };
           }

           function finishWorkflowElementLoading(context, message, isError) {
                if (!context?.element || !context?.overlay) return;
                var messageElement = context.overlay.querySelector(".workflow-element-loading-message");
                if (messageElement && message) messageElement.textContent = message;
                context.overlay.classList.toggle("is-error", !!isError);
                context.overlay.classList.toggle("is-success", !isError);
                window.setTimeout(function () {
                    context.element.classList.remove("workflow-element-loading");
                    context.element.removeAttribute("aria-busy");
                }, isError ? 800 : 220);
           }

           function beginDepartmentAssignmentLoading(moduleCode, recordId, dept) {
                var section = document.getElementById(`${moduleCode}-sec_${dept}_${recordId}`);
                var assigneeHost = section?.querySelector(".dept-form-header__assign");
                var manager = moduleCode === "pi"
                    ? window.PolicyIssuanceIdManager
                    : window.QuotationIdManager;
                var treeStack = manager?.treeStack
                    ? document.getElementById(manager.treeStack(recordId))
                    : null;
                var tree = treeStack?.closest(".dept-tree");
                return {

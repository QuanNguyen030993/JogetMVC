            function formatDateToString(dateInput) {
        const date = new Date(dateInput);

        // ISO chuẩn (UTC)
        const iso = date.toISOString();

        // Convert sang GMT+7
        const offsetMs = 7 * 60 * 60 * 1000;
        const dateGMT7 = new Date(date.getTime());

        // Format yyyy-MM-dd HH:mm:ss
        const pad = (n) => n.toString().padStart(2, '0');

        const gmt7 = `${dateGMT7.getFullYear()}-${pad(dateGMT7.getMonth() + 1)}-${pad(dateGMT7.getDate())}T`
            + `${pad(dateGMT7.getHours())}:${pad(dateGMT7.getMinutes())}:${pad(dateGMT7.getSeconds())}.000Z`;

        return {
            iso,        // chuẩn Z
            gmt7        // giờ VN
        };
    }


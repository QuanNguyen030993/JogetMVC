        /**
         * getIconByExt: Returns an emoji representation of a file extension.
         * Used for rendering beautiful visual file indicators in attachments/lists.
         */
        function getIconByExt(ext) {
            ext = (ext || "").toLowerCase();
            if (ext === "not found on server") return "!";
            if (ext === "pdf") return "📕";
            if (ext === "xls" || ext === "xlsx" || ext === "xlsm"|| ext === "csv") return "📗";
            if (ext === "doc" || ext === "docx") return "📘";
            if (ext === "ppt" || ext === "pptx") return "📙";
            if (ext === "msg" || ext === "eml") return "✉️";
            if (ext === "xml" || ext === "json") return "🧾";
            if (ext === "zip" || ext === "rar" || ext === "7z") return "🗜️";
            if (["png", "jpg", "jpeg", "gif", "bmp", "webp"].includes(ext)) return "🖼️";
            return "📎";
        }

        /**
         * getExt: Extracts the extension from a file name.
         * Used to determine file type for icons and logic handling.
         */
        function getExt(fileName) {
            const s = (fileName || "");
            const i = s.lastIndexOf(".");
            return i >= 0 ? s.substring(i + 1) : "";
        }

        /**
         * formatBytes: Converts a byte size number into a human-readable file size string.
         * Supports B, KB, MB, GB formats with one decimal place.
         */
        function formatBytes(bytes) {
            const n = Number(bytes || 0);
            if (n < 1024) return n + " B";
            const kb = n / 1024;
            if (kb < 1024) return kb.toFixed(1) + " KB";
            const mb = kb / 1024;
            if (mb < 1024) return mb.toFixed(1) + " MB";
            const gb = mb / 1024;
            return gb.toFixed(1) + " GB";
        }

        /**
         * getJson: Simple AJAX GET wrapper returning a jQuery promise.
         * Used for RESTful API calls fetching JSON data.
         */
        function getJson(url, data) {
            return $.ajax({
                url: url,
                type: "GET",
                data: data || {},
                dataType: "json"
            });
        }

        /**
         * getDefaultPicByDept: Safely parses the PIC JSON data and retrieves
         * the assignee's account name for a specific department.
         * Checks both case-variations (pIC / pic) and uses try-catch to prevent crashes.
         */
        function getDefaultPicByDept(deptKey, dataForm) {
            if (!deptKey) return null;
            if (!dataForm) return null;
            const picStr = dataForm.pIC || dataForm.pic || "";
            if (!picStr) return null;
            let PIC_MAP = {};
            try {
                PIC_MAP = JSON.parse(picStr);
            } catch (e) {
                return null;
            }
            return PIC_MAP[deptKey] || null;
        }

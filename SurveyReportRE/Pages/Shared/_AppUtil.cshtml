                var pic = picObject[dept];
                if (!pic) {

                    return;

                }

                try {
                    form.itemOption(groupName, "visible", pic ? true : false);
                } catch (e) {
                }
                setTimeout(() => {
                           var latestFormItems = form.option("formData") || {};
                           var latestTatObject = tryParseJSON(latestFormItems.turnAroundTimeAttributes, "TAT Load Button Problem");
                           // Legacy callers (UW/LMKT) pass buttonId/statusId pairs.
                           // Status element ids must not be initialized or disabled as buttons.
                           var usesLegacyStringPairs = params.length > 0 && params.every(item => typeof item === "string");
                           var buttonItems = usesLegacyStringPairs
                               ? params.filter((item, index) => index % 2 === 0 && item)
                               : params.filter(item => getDelayAcceptButtonId(item));
                           var renderedStoredStatus = false;
                           buttonItems.forEach(item => {
                               if (renderDelayAcceptStoredStatusButton(formId, dept, item, latestFormItems, latestTatObject)) {
                                   renderedStoredStatus = true;
                                   return;
                               }

                               if (item && typeof item === "object" && typeof item.loadRouteButtons === "function" && !isRouteDecisionButton(item) && !item.useDefaultDecisionClick && !item.createButton) {
                                   item.loadRouteButtons({
                                       formId: formId,
                                       dept: dept,
                                       formItems: latestFormItems,
                                       tatObject: latestTatObject,
                                       config: item
                                   });
                                   return;
                               }

                               applyDelayDecisionButton(formId, dept, item);

                               if (item && typeof item === "object" && typeof item.loadRouteButtons === "function") {
                                   item.loadRouteButtons({
                                       formId: formId,
                                       dept: dept,
                                       formItems: latestFormItems,
                                       tatObject: latestTatObject,
                                       config: item
                                   });
                               }
                           });
                          if (!renderedStoredStatus && latestTatObject)
                          if (latestTatObject[dept]?.AcceptDate )
                             {
                                         var acceptButtonId = getDelayAcceptButtonId(params[0]);
                                         var acceptStatusId = getDelayAcceptStatusId(params[0]) || params[1];
                                         var skipAcceptedMainFields = params[0] && typeof params[0] === "object" && params[0].skipAcceptedMainFields;
                                         if (acceptButtonId)
                                            {
                                             if (!skipAcceptedMainFields) {
                                                 form.option("items", [
                                                     ...form.option("items"),
                                                     ...mainField
                                                 ]);
                                             }

                                                if (dept == "LMKT") {
                                                    var storedStatus = getDelayAcceptStoredStatus(formItems, dept, formItems);
                                                    if (storedStatus) {
                                                        $(`#${params[0]}`).dxButton("instance").option("visible", true);
                                                        $(`#${params[2]}`).dxButton("instance").option("visible", true);
                                                        if (storedStatus.text == "Approved")
                                                            $(`#${params[0]}`).css("background-color", window.DecisionColors.accepted);
                                                        if (storedStatus.text == "Declined")
                                                            $(`#${params[2]}`).css("background-color", window.DecisionColors.accepted);
                                                        if (storedStatus)
                                                            disableAllDecisionButton(buttonItems.map(item => getDelayAcceptButtonId(item)));
                                                    }
                                                    else {
                                                        $(`#${params[0]}`).dxButton("instance").option("visible", false);
                                                        $(`#${params[2]}`).dxButton("instance").option("visible", false);
                                                    }
                                                }
                                                else{

                            $(`#${acceptButtonId}`).css("background-color", window.DecisionColors.accepted);
                                                updateDelayAcceptStatus(
                                                    acceptStatusId,
                                                    acceptButtonId,
                                                    latestTatObject[dept]?.AcceptDate
                                                );
                                                    disableAllDecisionButton(buttonItems.map(item => getDelayAcceptButtonId(item)));
                                                }
                                      

                                            }
                                     //  if (rejectButtonId)
                                     // {
                         //    $(`#${rejectButtonId}`).css("background-color", window.DecisionColors.accepted);
                                     //    $(`#${rejectButtonIdStatus}`).text(`Accepted at: ${tatObject[dept]?.AcceptDate}`);
                                     //        $(`#${rejectButtonId}`).dxButton("instance").option("disabled", true);
                                     // }
                            }
                           
                            
                                   }, 100);


        }


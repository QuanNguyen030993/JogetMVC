           function reloadCurrentTabView(triggerElement) {
                var $wrapper = $(triggerElement).closest("[id$='_content_wrapper']");
                if (!$wrapper.length) return false;

                var wrapperId = $wrapper.attr("id") || "";
                var code = wrapperId.replace(/_content_wrapper$/, "");
                var sourceUrl = $wrapper.attr("data-source-url");
                var caption = $wrapper.attr("data-source-caption")
                    || $(`#${code}_li_tab a`).text()
                    || code;

                if (!sourceUrl || !code) {
                    console.warn("Cannot fully reload tab because its source URL is missing.", code);
                    return false;
                }

                callElementView(sourceUrl, code, caption, $wrapper.data("source-data"));
                return true;
           }
           window.reloadCurrentTabView = reloadCurrentTabView;

           function reloadOverviewViewComponents(moduleCode, recordId, triggerElement, forceReload) {
                var normalizedModule = String(moduleCode || "").replace(/\s+/g, "").toLowerCase();
                var isPolicyIssuance = normalizedModule === "pi" || normalizedModule === "policyissuance";
                var resolvedModuleCode = isPolicyIssuance ? "pi" : "qt";
                var viewInstanceKey = `${resolvedModuleCode}:${recordId}`;
                var now = Date.now();
                var previousReloadAt = window.WorkflowViewReloadState[viewInstanceKey] || 0;

                // SignalR and workflow callbacks can report the same update. Keep all
                // reload entry points on this shared guard so the view renders once.
                if (!forceReload && now - previousReloadAt < 1500) {
                    return Promise.resolve(true);
                }
                window.WorkflowViewReloadState[viewInstanceKey] = now;

                var viewInstance = window.OverviewViewRegistry?.[viewInstanceKey];
                var refreshSource = triggerElement;

                if (refreshSource?.jquery) refreshSource = refreshSource[0];
                if (!refreshSource && viewInstance?.rootId) {
                    refreshSource = document.getElementById(viewInstance.rootId);
                }

                if (refreshSource && reloadCurrentTabView(refreshSource)) {
                    return Promise.resolve(true);
                }

                if (typeof viewInstance?.reload === "function") {
                    return Promise.resolve(viewInstance.reload());
                }

                var reloadComponents = isPolicyIssuance
                    ? window.reloadPolicyIssuanceComponents
                    : window.reloadQuotationComponents;

                if (typeof reloadComponents === "function") {
                    return Promise.resolve(reloadComponents(recordId));
                }

                console.warn(`Reload handler is not available for ${viewInstanceKey}.`);
                return Promise.resolve(false);
           }
           window.reloadOverviewViewComponents = reloadOverviewViewComponents;

           function reloadWorkflowViewComponents(schemeName, recordId, triggerElement, forceReload) {
                var normalizedScheme = String(schemeName || "").replace(/\s+/g, "").toLowerCase();
                var isPolicyIssuance = normalizedScheme === "policyissuance";
                var moduleCode = isPolicyIssuance ? "pi" : "qt";
                return reloadOverviewViewComponents(moduleCode, recordId, triggerElement, forceReload);
           }
           window.reloadWorkflowViewComponents = reloadWorkflowViewComponents;

           function acceptDecision(object, dept) {
                object = object || {};
                dept = dept || object.dept;

                var scheme = object.schemeName || (object.prefix === "pi" ? "PolicyIssuance" : "Quotation");
                var formItems = object.formItems
                    || $(`#${object.formId}`).dxForm("instance")?.option("formData")
                    || {};
                var loadingContext = beginDepartmentSectionLoading(
                    scheme,
                    formItems.id,
                    dept,
                    `Accepting ${dept} decision...`
                );

                // Accept does not move the workflow. The API owns the status/TAT update,
                // action log and the NotificationType = Accept notification.
                var acceptRequest = $.ajax({
                    url: `/api/${scheme}/AcceptTask`,
                    type: "POST",
                    contentType: "application/json; charset=utf-8",
                    data: JSON.stringify({
                        id: formItems.id,
                        dept: dept,
                        comment: object.Comment || null
                    })
                });

                acceptRequest.done(function (responseData) {
                    applyAcceptedDepartmentDecision(
                        scheme,
                        formItems.id,
                        dept,
                        responseData
                    )
                        .then(function () {
                            finishDepartmentSectionLoading(
                                loadingContext,
                                `${dept} form unlocked`,
                                false
                            );
                        })
                        .catch(function (err) {
                            finishDepartmentSectionLoading(
                                loadingContext,
                                `${dept} refresh failed`,
                                true
                            );
                            console.error("Accept decision section update failed", err);
                        });
                });

                acceptRequest.fail(function (xhr) {
                    finishDepartmentSectionLoading(
                        loadingContext,
                        "Accept decision failed",
                        true
                    );
                    appErrorHandling("Accept decision failed", xhr);
                });

                return acceptRequest;
           }


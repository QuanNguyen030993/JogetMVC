        function getPersonInCharge(accountIds) {
            var deferred = $.Deferred();

            $.ajax({
                url: `/api/Employee/PersonInChargeLookup/${encodeURIComponent(accountIds)}`,
                type: "GET",
                success: function (res) {
                    if (res.success) {
                        deferred.resolve(res.fullNames); // ✅ trả về chuỗi đã ghép
                    } else {
                        deferred.resolve(""); // fallback
                    }
                },

                    if (hideIfMuliple) {
                        const items = e.selectedItems || [];
                        const hiddenItems = items.slice(1);
                        e.text = `+${hiddenItems.length} more`;
                        e.multiTagElement.attr("title",
                            hiddenItems.map(x => x.fullName).join("\n")
                        );
                    }
                },
                searchExpr: [
                    "fullName",
                    "accountName",
                    "displayName"
                ],
                placeholder: "Select assignee...",
                showClearButton: true,
                showSelectionControls: true,
                applyValueMode: "useButtons",
                buttons: [
                    "clear",
                    "dropDown",
                    {
                        name: "assignToMe",
                        location: "after",
                        options: {
                            type: "default",
                            text: "Assign to me",
                            visible: canEdit,
                            disabled: !canEdit,
                            elementAttr: {
                                class: "workflow-primary-button assign-to-me-button"
                            },
                            onClick: function () {
                                if (!canEdit) return;
                                $.ajax({
                                    url: "api/Employee/GetMyAssigneeProfile",
                                    type: "GET",
                                    dataType: "json"
                                }).done(async function (res) {
                                    if (!res || !res.success || !res.data?.accountName) {
                                        DevExpress.ui.notify("Your assignee profile is not available.", "warning", 2500);
                                        return;
                                    }

                                    const me = res.data;
                                    const editor = $el.dxTagBox("instance");
                                    if (!editor) return;

                                    // Get the store currently bound to the editor. This is important
                                    // when the assignee box has been refreshed with a new data source.
                                    const currentStore = editor.getDataSource()?.store?.() || resolvedStore;
                                    try {
                                        const existingMe = await Promise.resolve(currentStore.byKey(me.accountName))
                                            .catch(() => null);
                                        if (!existingMe) {
                                            await Promise.resolve(currentStore.insert(me));
                                        }
                                    } catch (error) {
                                        console.warn("Current user could not be added to the assignee list.", error);
                                    }

                                    const current = Array.isArray(editor.option("value"))
                                        ? editor.option("value").slice()
                                        : [];
                                    if (!current.includes(me.accountName)) current.push(me.accountName);

                                    const selectedItems = Array.isArray(editor.option("selectedItems"))
                                        ? editor.option("selectedItems").slice()
                                        : [];
                                    const selectedByAccount = new Map(
                                        selectedItems
                                            .filter(item => item?.accountName)
                                            .map(item => [item.accountName, item])
                                    );
                                    selectedByAccount.set(me.accountName, me);
                                    const mergedSelectedItems = current
                                        .map(accountName => selectedByAccount.get(accountName)
                                            || employees.find(item => item?.accountName === accountName)
                                            || { accountName: accountName, fullName: accountName });

                                    editor.option("value", current);
                                    syncAssignmentStatus(current);
                                    editor.getDataSource()?.reload?.();

                                    if (typeof settings.onChanged === "function") {
                                        settings.onChanged(mergedSelectedItems, editor, true);
                                    }
                                    if (typeof settings.onClosed === "function") {
                                        settings.onClosed(mergedSelectedItems, editor, true);
                                    }
                                    if (typeof settings.onValueChanged === "function") {
                                        settings.onValueChanged(mergedSelectedItems, editor, true);
                                    }
                                }).fail(function (xhr) {
                                    console.error("GetMyAssigneeProfile failed.", xhr);
                                    DevExpress.ui.notify("Unable to assign the task to you.", "error", 2500);
                                });
                            }
                        }
                    }
                ],
                onClosed: function (e) {
                    if (!canEdit) return;
                    const items = e.component.option("selectedItems") || [];
                    syncAssignmentStatus(e.component.option("value"));
                    if (typeof settings.onClosed === "function") {
                        settings.onClosed(items, e.component, false);
                    }
                    if (typeof settings.onValueChanged === "function") {
                        settings.onValueChanged(items, e.component, false);
                    }
                }
            });


            $(tagBox).on("click", function (e) {
                e.stopPropagation();
            });
            await new Promise(resolve => requestAnimationFrame(resolve));

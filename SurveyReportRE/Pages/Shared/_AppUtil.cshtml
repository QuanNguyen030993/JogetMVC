                    let filter = null;
                    if (instance.refKey != null && instance.refField != null) {
                        filter = [instance.refField, "=", instance.refKey];
                    }

                    if (instance.refField2 != null) {
                        if (filter) {
                            if (instance.refKey2 == null)
                                filter = [
                                    filter, "and", [instance.refField2, "=", null]
                                ];
                            else
                                filter = [
                                    filter, "and", [instance.refField2, "=", instance.refKey2]
                                ];
                        }
                    }

                    if (checkCustomQueryByModel != null || checkCustomQueryByModel != undefined) {
                        if (checkCustomQueryByModel.customQuery == "OnSystem") {
                            return new DevExpress.data.DataSource({
                                key: "id",

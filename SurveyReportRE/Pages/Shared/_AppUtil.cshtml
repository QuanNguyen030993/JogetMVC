            const canEdit = settings.allowEdit === true || canEditDepartmentAssignee(settings);

            const store = new DevExpress.data.CustomStore({
                key: "accountName", // align with valueExpr: "accountName"
                loadMode: "raw",

                load: function (loadOptions) {
                    loadOptions = loadOptions || {};
                    const keyword = loadOptions.searchValue || "";
                    return getAssignableEmployeesByGroup(settings.groupName, keyword);
                },

                byKey: function (key) {
                    if (!key) return null;

                    const cacheKey = `employee|${String(key).toLowerCase()}`;
                    return getCachedEmployeeRequest(cacheKey, function () {
                        return $.ajax({
                            url: `api/Employee/EmployeeLookup/${encodeURIComponent(key)}`,
                            type: "GET",
                            dataType: "json"
                        });
                    }, 1800000).then(function (res) {
                        return res && res.success ? res.data : null;
                    });
                }
            });

            const defaultValue =
                getDefaultPicByDept(settings.groupName, settings.dataForm)
                || settings.value;

            const selectedValues = defaultValue
                ? defaultValue.split(",").map(x => x.trim()).filter(Boolean)
                : [];

            const $el = $(selector);
            if ($el.length === 0) return;

            const $assignWrapper = $el.closest(".dept-form-header__assign");
            const departmentName = String(settings.groupName || "").trim().toUpperCase();
            let $assignmentStatus = $();

            if ($assignWrapper.length) {
                const statusId = `${$el.attr("id")}-detail-status`;
                $assignmentStatus = $(document.getElementById(statusId));
                if (!$assignmentStatus.length) {
                    $assignmentStatus = $("<div>", {
                        id: statusId,
                        class: "assignee-detail-status",
                        role: "status",
                        "aria-live": "polite"
                    }).insertAfter($assignWrapper);
                }
                $assignmentStatus.text(`Assign member to view details for the ${departmentName} section.`);
            }

            const syncAssignmentStatus = function (values) {
                if (!$assignmentStatus.length) return;
                const needsAssignee = !Array.isArray(values) || values.length === 0;
                $assignmentStatus
                    .toggleClass("is-visible", needsAssignee)
                    .attr("aria-hidden", needsAssignee ? "false" : "true");
            };
            syncAssignmentStatus(selectedValues);

            // Nap datasource truoc khi gan value. Voi CustomStore, chi option("value")
            // co the khien TagBox render key truoc khi byKey tra ve va hien sai PIC.
            let employees = [];
            try {
                employees = await Promise.resolve(store.load());
                employees = Array.isArray(employees) ? employees.slice() : [];

                const loadedKeys = new Set(employees.map(item => item?.accountName).filter(Boolean));
                const missingKeys = selectedValues.filter(key => !loadedKeys.has(key));
                const missingEmployees = await Promise.all(missingKeys.map(key =>
                    Promise.resolve(store.byKey(key)).catch(() => null)
                ));
                missingEmployees.filter(Boolean).forEach(item => employees.push(item));
            } catch (error) {
                console.warn(`Assignment list for ${settings.groupName} could not be preloaded.`, error);
            }

            const resolvedStore = new DevExpress.data.ArrayStore({
                key: "accountName",
                data: employees
            });

            // Reuse existing dxTagBox instance to avoid recreating it
            let existingInstance = DevExpress.ui.dxTagBox.getInstance($el[0]);
            if (existingInstance && settings.forceRecreate === true) {
                existingInstance.dispose();
                $el.empty();
                existingInstance = null;
            }
            if (existingInstance) {
                existingInstance.option({
                    dataSource: resolvedStore,
                    value: selectedValues,
                    readOnly: !canEdit,
                    hint: canEdit
                        ? ""
                        : "Only the Leader PIC in the same section can assign."

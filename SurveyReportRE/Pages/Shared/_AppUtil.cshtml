                            $sheetSelect.dxSelectBox({
                                dataSource: workbook.SheetNames,
                                value: workbook.SheetNames[0],
                                placeholder: "Select sheet",
                                onValueChanged: function (e) {
                                    renderSheet(e.value);
                                }

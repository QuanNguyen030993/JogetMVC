                        items.forEach(pin => {
                            const urgentBadge = pin.urgent ? `<span class="mini-badge badge-soft-yellow">Urgent</span>` : "";
                            const unreadBadge = pin.unread ? `<span class="mini-badge badge-soft-red">Unread</span>` : "";
                                    wrap.append(`
                              <div class="pin-card" data-pin-id="${pin.id}">

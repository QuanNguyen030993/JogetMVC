        function getDelayAcceptButtonId(item) {
            if (!item) return "";
            if (typeof item === "string") return item;
            return item.buttonId || item.id || item.elementId || "";
        }

        function getDelayAcceptStatusId(item) {
            if (!item || typeof item === "string") return "";
            return item.statusId || item.statusElement || item.statusElementId || "";
        }

        function updateDelayAcceptStatus(statusId, buttonId, acceptDate) {
            if (!statusId || !acceptDate) return;

            var $status = $(`#${statusId}`);
            var $button = buttonId ? $(`#${buttonId}`) : $();
            if (!$status.length) {
                $status = $(`<div id="${statusId}" class="accept-status-indicator"></div>`);
                if ($button.length) {
                    $status.prependTo($button.parent());
                }
            }

            if (!$status.length) return;
            if ($button.length && !$status.is($button.parent().children().first())) {
                $status.detach().prependTo($button.parent());
            }
            $status
                .addClass("statusTag status-success")
                .css({
                    display: "flex",
                    width: "100%",
                    margin: "0 0 10px 0",
                    alignItems: "center",
                    boxSizing: "border-box"
                })
                .text(`Accepted at: ${fmtTimeLocal(acceptDate)}`);
        }

        function isRouteDecisionButton(item) {
            return item && typeof item === "object" && (item.isRouteButton || item.route || item.findRoute);
        }

        function getDelayAcceptButtonHost(item) {
            if (!item || typeof item !== "object") return null;
            var hostId = item.containerId || item.hostId || item.appendTo || "";
            if (!hostId) return null;
            return String(hostId).charAt(0) === "#" || String(hostId).charAt(0) === "." ? $(hostId) : $(`#${hostId}`);
        }

        function ensureDelayDecisionButtonElement(buttonId, item) {
            var $button = $(`#${buttonId}`);
            if ($button.length) return $button;

            var $host = getDelayAcceptButtonHost(item);
            if (!$host || !$host.length) return $button;

            return $(`<div id="${buttonId}"></div>`).appendTo($host);
        }

        function getDelayDecisionButtonDisabled(item, route, fallbackDisabled) {
            if (item && typeof item === "object" && typeof item.disabled !== "undefined") {
                return item.disabled;
            }

            if (route && typeof route.disabled !== "undefined") {
                return route.disabled;
            }

            return fallbackDisabled || false;
        }

        function ensureDelayDecisionButtonInstance(buttonId, item) {
            var $button = ensureDelayDecisionButtonElement(buttonId, item);
            if (!$button.length) return null;

            var instance = $button.dxButton("instance");
            if (instance) return instance;

            var route = item?.route || item?.findRoute;
            var options = {
                disabled: getDelayDecisionButtonDisabled(item, route),
                text: item?.text || route?.displayStatus || route?.actionName || route?.actionCode || "",
                icon: item?.icon || (route ? getTransitionButtonIcon(route, "check") : "check"),
                type: item?.type || (route?.isReturn ? "danger" : "info")
            };

            $button.dxButton(options);

            var buttonClass = item?.buttonClass || getTransitionButtonClass(route, "");
            if (buttonClass) {
                applyTransitionButtonClass(`#${buttonId}`, route || { buttonClass: buttonClass }, buttonClass);
            }
            if (item?.buttonColor || item?.backgroundColor) {
                $button.find(".dx-button").css("background-color", item.buttonColor || item.backgroundColor);
            }

            return $button.dxButton("instance");
        }

        function getDelayAcceptStoredStatus(formItems, dept, item) {
            if (!item || typeof item !== "object") return null;
            if (item.acceptStatus) return item.acceptStatus;

            var statusField = item.acceptStatusField || item.actionStatusField || "actionStatus";
            var statusObject = tryParseJSON(formItems?.[statusField], "Delay AcceptStatus Problem") || {};
            var buttonStatus = statusObject[`${dept}Button`];

            if (buttonStatus) return buttonStatus;
            return statusObject[dept] || null;
        }

        function renderDelayAcceptStoredStatusButton(formId, dept, item, formItems, tatObject) {
            var buttonId = getDelayAcceptButtonId(item);
            if (!buttonId || !item || typeof item !== "object") return false;

            var storedStatus = getDelayAcceptStoredStatus(formItems, dept, item);
            var statusText = "";
            var statusIcon = item.icon || "check";
            var statusClass = item.buttonClass || "dx-button-info";

            if (storedStatus && typeof storedStatus === "object") {
                statusText = storedStatus.text || storedStatus.displayStatus || storedStatus.actionName || storedStatus.actionCode || "";
                statusIcon = storedStatus.icon || statusIcon;
                statusClass = storedStatus.buttonClass || statusClass;
            } else if (typeof storedStatus === "string") {
                statusText = storedStatus;
            }

            if (!statusText && item.useTatAcceptStatus && tatObject?.[dept]?.AcceptDate) {
                statusText = item.tatStatusText || "Submitted";
            }

            if (!statusText) return false;

            var $host = $(`#${buttonId}`);
            if (!$host.length) return false;

            var statusButtonId = item.statusButtonId || `${buttonId}_status`;
            if (item.clearRouteButtonsOnStatus !== false) {
                $host.children().not(`#${statusButtonId}`).remove();
            }
            var $statusButton = $(`#${statusButtonId}`);
            if (!$statusButton.length) {
                $statusButton = $(`<div id="${statusButtonId}"></div>`).appendTo($host);
            }

            $statusButton.dxButton({
                disabled: item.statusButtonDisabled !== false,
                text: statusText,
                icon: statusIcon,
                type: item.type || "info"
            });
            applyTransitionButtonClass(`#${statusButtonId}`, { buttonClass: statusClass });
            $statusButton.find(".dx-button").css("background-color", item.acceptedColor || window.DecisionColors.accepted);

            return true;
        }

        function buildDefaultDecisionClick(formId, dept) {
            return function (e) {
                var formItems = $(`#${formId}`).dxForm("instance")?.option("formData") || {};
                var passingObject = {
                    statusName: `${dept} Process`,
                    Comment: `Quotation ${formItems.quotationCode} accepted by ${_displayName}!`,
                    formItems: formItems,
                    dept: dept,
                    url: "/api/Quotation/UpdateData",
                    urlLog: "/api/Quotation/LogAction",
                    schemeName: "Quotation"
                };

                acceptDecision(passingObject);
            };
        }

        function buildRouteDecisionClick(formId, dept, item) {
            return function (e) {
                var route = item.route || item.findRoute;
                var formItems = $(`#${formId}`).dxForm("instance")?.option("formData") || {};
                var content = "";

                if (typeof item.getComment === "function") {
                    content = item.getComment();
                } else {
                    content = window.remarkBoxs?.[dept]?.controlRemark?.value?.() || "";
                }

                if (item.requireRemark && !content) {
                    appNotifyWarning(item.remarkMessage || "Please put your reason to remarks!", false);
                    return;
                }

                formItems.comment = content || "";

                if (typeof item.onClick === "function") {
                    item.onClick({
                        event: e,
                        formItems: formItems,
                        route: route,
                        dept: dept,
                        formId: formId,
                        config: item
                    });
                    return;
                }

                var moduleName = item.moduleName || item.formModuleKey || item.moduleKey || "qt";
                var nextStep = item.nextStep || item.state?.nextStep || window.QuotationPage?.state?.nextStep;
                var handlerName = item.handlerName || item.action || (route?.isReturn ? "returnToStep" : "submitNextStep");

                if (!route || !nextStep) {
                    buildDefaultDecisionClick(formId, dept)(e);
                    return;
                }

                if (handlerName === "returnToStep") {
                    returnToStep(moduleName, nextStep, route, formItems);
                    return;
                }

                submitNextStep(moduleName, nextStep, route, formItems);
            };
        }

        function applyDelayDecisionButton(formId, dept, item) {
            var buttonId = getDelayAcceptButtonId(item);
            if (!buttonId) return;

            var instance = ensureDelayDecisionButtonInstance(buttonId, item);
            if (!instance) return;

            if (isRouteDecisionButton(item)) {
                var route = item.route || item.findRoute;
                var buttonOptions = {
                    onClick: buildRouteDecisionClick(formId, dept, item)
                };

                if (route) {
                    buttonOptions.text = item.text || route.displayStatus || route.actionName || route.actionCode || instance.option("text");
                    buttonOptions.icon = item.icon || getTransitionButtonIcon(route, instance.option("icon") || "check");
                    buttonOptions.type = item.type || instance.option("type");
                    buttonOptions.disabled = getDelayDecisionButtonDisabled(item, route, instance.option("disabled"));
                }

                instance.option(buttonOptions);
                applyTransitionButtonClass(`#${buttonId}`, route || item, item.buttonClass);
                if (item.buttonColor || item.backgroundColor) {
                    $(`#${buttonId}`).find(".dx-button").css("background-color", item.buttonColor || item.backgroundColor);
                }
                return;
            }

            if (item && typeof item === "object" && item.useDefaultDecisionClick) {
                instance.option("onClick", buildDefaultDecisionClick(formId, dept));
            }
        }

        function renderDecisionDeferredV2(formId, dept, groupName, mainField, ...params) {

            // setTimeout(function () {

                var form = $(`#${formId}`).dxForm("instance");
                if (!form) return;

                var formItems = form.option("formData") || {};

                var picObject = tryParseJSON(formItems.pic, "PIC Load Problem") || {};

                const sectionCommentRequestCache = new Map();

                function normalizeSectionCommentGuid(guid) {
                    return String(guid || "").trim().toLowerCase();
                }

                function invalidateSectionCommentCache(guid) {
                    sectionCommentRequestCache.delete(normalizeSectionCommentGuid(guid));
                }

                function loadSectionCommentsCached(guid) {
                    const key = normalizeSectionCommentGuid(guid);
                    if (!key) return Promise.resolve([]);
                    if (sectionCommentRequestCache.has(key)) {
                        return sectionCommentRequestCache.get(key);
                    }

                    const params = new URLSearchParams({
                        refKey: guid,
                        refField: "RecordGuid"
                    });
                    const request = Promise.resolve(
                        ajaxGet(`/api/SectionCommentNote/GetAll?${params.toString()}`, null, null)
                    ).then(function (result) {
                        return Array.isArray(result) ? result : [];
                    }).catch(function (error) {
                        sectionCommentRequestCache.delete(key);
                        throw error;
                    });

                    sectionCommentRequestCache.set(key, request);
                    return request;
                }

                function waitForCommentStage(idForm) {
                    const $stageRoot = $(`#${idForm}`).closest("[data-render-stage]");
                    if (!$stageRoot.length || $stageRoot.attr("data-render-stage") === "comments") {
                        return Promise.resolve();
                    }

                    return new Promise(function (resolve) {
                        const observer = new MutationObserver(function () {
                            if ($stageRoot.attr("data-render-stage") !== "comments") return;
                            observer.disconnect();
                            resolve();
                        });
                        observer.observe($stageRoot[0], {
                            attributes: true,
                            attributeFilter: ["data-render-stage"]
                        });
                    });
                }


    function renderDepartmentAssigneeBox(selector, options) {
        const settings = $.extend(true, {
            groupName: "",
            dataForm: {},
            currentUserId: null,
            value: null, // string: acc1,acc2
            onChanged: null
        }, options || {});


        const store = new DevExpress.data.CustomStore({
            key: "id",
            loadMode: "raw",

            load: function (loadOptions) {
                return $.ajax({
                    url: "api/Employee/GetAssignableByGroup",
                    type: "GET",
                    dataType: "json",
                    data: {
                        group: settings.groupName,
                        excludeCurrent: true,
                        keyword: loadOptions.searchValue || ""
                    }
                }).then(function (res) {
                    return res && res.success ? res.data : [];
                });
            },

            byKey: function (key) {
                if (!key) return null;

                return $.ajax({
                    url: `api/Employee/EmployeeLookup/${key}`,
                    type: "GET",
                    dataType: "json"
                }).then(function (res) {
                    return res && res.success ? res.data : null;
                });
            }
        });


        const defaultValue =
            getDefaultPicByDept(settings.groupName, settings.dataForm)
            || settings.value;


        const selectedValues = defaultValue
            ? defaultValue.split(",").map(x => x.trim()).filter(Boolean)
            : [];


        const tagBox = $(selector).dxTagBox({

            dataSource: store,

            valueExpr: "accountName",
             
            displayExpr: "fullName",
            height: 38,
            value: selectedValues,
            // value: getDefaultPicByDept(settings.groupName, settings.dataForm) || settings.value,

            searchEnabled: true,
            maxDisplayedTags: 1,
            showMultiTagOnly: true,

            onMultiTagPreparing: function (e) {

                const items = e.selectedItems || [];

                const hiddenItems = items.slice(1);

                e.text = `+${hiddenItems.length} more`;


                e.multiTagElement
                    .attr("title",
                        hiddenItems
                            .map(x => x.fullName)
                            .join("\n")
                    );
            },
            searchExpr: [
                "fullName",
                "accountName",
                "displayName"
            ],

            placeholder: "Select assignee...",

            showClearButton: true,

            showSelectionControls: true,

            applyValueMode: "useButtons",


            buttons: [
                "clear",
                "dropDown",
                {
                    name: "assignToMe",
                    location: "after",

                    options: {
                        type: "default",
                        text: "Assign to me",

                        onClick: function () {

                            $.ajax({
                                url: "api/Employee/GetMyAssigneeProfile",
                                type: "GET",
                                dataType: "json"

                            }).done(function (res) {

                                if (!res || !res.success || !res.data)
                                    return;


                                const me = res.data;

                                const editor = $(selector)
                                    .dxTagBox("instance");


                                let current = editor.option("value") || [];


                                if (!current.includes(me.accountName)) {
                                    current.push(me.accountName);
                                }


                                editor.option("value", current);


                                if (typeof settings.onChanged === "function") {

                                    settings.onChanged(
                                        [me],
                                        editor,
                                        true
                                    );
                                }

                            });
                        }
                    }
                }
            ],


            onValueChanged: function (e) {

                const items = e.component.option("selectedItems") || [];


                if (typeof settings.onChanged === "function") {

                    settings.onChanged(
                        items,
                        e.component,
                        false
                    );
                }
            }
        });


        $(tagBox).on("click", function (e) {
            e.stopPropagation();
        });
    }

        function reloadWorkflow(selectedGuid, selectedId, stageDept, moduleKey) {
                $(`#${moduleKey}-flowPanel_${selectedId}`).empty();
                ajaxGet(`/api/Quotation/GetQuotationWorkflowDefinition/${selectedGuid}`, null)
                .then(instance => {
                        if (instance)
                        {
                            var staticFlow = null;
                    var passingParams = { UITabId: `form_DrawCanvas_Form_${instance.id}`, pageNum: instance.id };
                        appendElementViewInside(`/Business/Workflow/DrawCanvas_Form/${instance.id}`, passingParams, $(`#${moduleKey}-flowPanel_${selectedId}`), `${moduleKey}-form_DrawCanvas_Form_${instance.id}`, "appendTo");
                    // const q = `SELECT DeptCode AS 'dept',ActionTime AS 'time',ActionNote AS 'note' FROM QuotationWorkflowHistory WHERE QuotationId = ${selectedId}`;
                    const q = `OnSystem`;
                    $.ajax({
                                url: `/api/QuotationWorkflowHistory/ExecuteCustomQuery?refField=QuotationId&refKey=${selectedId}`,
                        method: "POST",
                        async: false,
                        contentType: "application/json",
                        data: JSON.stringify(q),
                        success: function (data) {
                            staticFlow = data;
                        },
                        error: function () {
                        }
                    });

                    // var key = `flow:${selectedCodeNo}`;
                    function renderFlow(items) {
                        if (!Array.isArray(items) || items.length === 0) {
                            return { summary: "-", html: `<div style="color:#6b7280;font-size:12px;padding:6px 4px;">No history</div>` };
                        }
                        // const summary = items.map(x => x.dept).join(" → ");
                        const summary = "";
                        const arrow = `
                                    <div class="fh-arrow" aria-hidden="true">
                                      <svg viewBox="0 0 24 24" fill="none" width="12" height="18">
                                        <path d="M12 4v12" stroke="black" stroke-width="2" stroke-linecap="round"/>
                                        <path d="M7 13l5 5 5-5" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                      </svg>
                                    </div>
                                  `;
                        const html = items.map((x, idx) => {
                            const isCur = (x.dept === stageDept); // stageDept already exists in your mock
                            return `
                                          <div>
                                            <div class="fh-row">
                                              <div class="fh-node ${isCur ? "cur" : ""}">${escapeHtml(x.dept)}</div>
                                              <div class="fh-meta">
                                                <div class="fh-note">${escapeHtml(x.note || "")}</div>
                                                <div class="fh-time">${escapeHtml(x.time || "")}</div>
                                              </div>
                                            </div>
                                          </div>
                                          ${idx < items.length - 1 ? arrow : ""}
                                        `;
                        }).join("");
                        return { summary, html };
                    }
                    var getData = renderFlow(staticFlow);
                        $(`#${moduleKey}-flowSummary_${selectedId}`).text(getData.summary);
                        $(`#${moduleKey}-flowHistoryBody_${selectedId}`).html(getData.html);
                    }
                    else {
                        alert("Workflow does not exist in this request!");
                    }
                });


        }



        function refreshAuditLogOverflowHints() {
            requestAnimationFrame(function () {
                $(".ct-item[data-audit-log-key]").each(function () {
                    var $card = $(this);
                    var content = $card.find(".ct-text")[0];
                    if (!content) return;

                    var isOverflowing = content.scrollHeight > content.clientHeight + 2
                        || content.scrollWidth > content.clientWidth + 2;
                    $card.toggleClass("ct-overflowing", isOverflowing);
                    $card.find(".ct-view-more").toggle(isOverflowing);
                    $card.find("img").off("load.auditOverflow").on("load.auditOverflow", refreshAuditLogOverflowHints);
                });
            });
        }


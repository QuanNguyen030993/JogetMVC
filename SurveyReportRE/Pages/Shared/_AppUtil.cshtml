                                  <div class="pin-full-actions">
                                    <div class="btn-collapse-pin-${pin.id}"></div>
                                    <div class="btn-reply-pin-${pin.id}"></div>
                                    <div class="btn-done-pin-${pin.id}"></div>
                                    <div class="btn-unpin-pin-${pin.id}"></div>
                                  </div>
                                </div>
                          </div>
                        `);
                        });

                         const groupByFromSection = items.reduce((acc, cur) => {
                           const key = cur.fromSection || "Unknown";
                           if (!acc[key]) {
                               acc[key] = {
                                   section: key,
                                   count: 0,
                                   unread: 0,
                                   urgent: 0
                               };
                           }
                           acc[key].count++;
                           if (cur.unread) acc[key].unread++;
                           if (cur.urgent) acc[key].urgent++;
                           return acc;

         function startBrowserLoading(duration = 3000){
               const fill = document.getElementById("progressFill");
               const wrapper = document.getElementById("browserLoading");
               let progress = 0;
               fill.style.width = "0%";
               wrapper.style.display = "block";
               wrapper.classList.remove("fade-out");
               const interval = setInterval(()=>{
                   progress += 1;
                   fill.style.width = progress + "%";
                   if(progress >= 100){
                       clearInterval(interval);
                       setTimeout(()=>{
                           wrapper.classList.add("fade-out");
                           setTimeout(()=>{
                               wrapper.style.display = "none";
                           },350);
                       },150);
                           disposeMiniLoadingPanel();
                   }
               }, duration / 100);
           }

                function renderBrowserLoading(result){
                   const fill = document.getElementById("progressFill");
                   const wrapper = document.getElementById("browserLoading");
                   let progress = result.payload.progressvalue;
                       fill.style.width = progress + "%";
                   wrapper.style.display = "block";
                   wrapper.classList.remove("fade-out");
                        if(progress >= 100){
                                wrapper.classList.add("fade-out");
                                                           setTimeout(()=>{
                                       wrapper.style.display = "none";

                sendData = transitionResult.sendData;
                // Persist fields changed by transitionScript as part of the workflow request.
                if (formItems && Object.prototype.hasOwnProperty.call(formItems, "actionStatus")) {
                    sendData.ActionStatus = formItems.actionStatus;
                }

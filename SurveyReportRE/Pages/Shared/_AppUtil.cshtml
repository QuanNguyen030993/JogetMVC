        function getAuditLogField(item, ...fieldNames) {
            for (var index = 0; index < fieldNames.length; index++) {
                var fieldName = fieldNames[index];
                if (item?.[fieldName] !== null && item?.[fieldName] !== undefined) {
                    return item[fieldName];
                }
            }
            return "";
        }

        function normalizeAuditLogItems(result) {
            if (Array.isArray(result)) return result;
            if (Array.isArray(result?.data)) return result.data;
            if (Array.isArray(result?.items)) return result.items;
            return [];
        }

        function getAuditLogDepartmentClass(department) {
            var dept = String(department || "").trim().toUpperCase();
            if (dept.startsWith("FO")) return "ct-fo";
            if (dept.startsWith("TS")) return "ct-ts";
            if (dept.startsWith("UW")) return "ct-uw";
            if (dept.startsWith("LMKT")) return "ct-lmkt";
            if (dept.startsWith("PM")) return "ct-pm";
            return "";
        }

        function renderAuditLogs(result) {
            var items = normalizeAuditLogItems(result);
            window.AuditLogViewState.contents = {};

            if (!items.length) {
                return `<div style="color:var(--c-6b7280);font-size:12px;padding:6px 4px;">No audit logs</div>`;
            }

            var html = items.map(function (item) {
                var dept = getAuditLogField(item, "deptCode", "DeptCode", "fromDepartment", "FromDepartment");
                var author = getAuditLogField(item, "commentBy", "CommentBy", "createdBy", "CreatedBy");
                var rawDate = getAuditLogField(item, "commentTime", "CommentTime", "createdDate", "CreatedDate", "createdAtUtc", "CreatedAtUtc");
                var content = getAuditLogField(item, "commentText", "CommentText", "comment", "Comment", "message", "Message");
                var displayDate = rawDate ? fmtTimeLocal(rawDate) : "";
                var auditKey = `audit_${Date.now()}_${++window.AuditLogViewState.sequence}`;
                var auditTitle = (dept ? `${dept} - ` : "") + (author || "Audit Log");

                window.AuditLogViewState.contents[auditKey] = {
                    title: auditTitle,
                    author: author,
                    date: displayDate,
                    html: content || ""
                };

                return `
                    <div class="ct-item ${getAuditLogDepartmentClass(dept)}" data-audit-log-key="${auditKey}" role="button" tabindex="0">
                        <div class="ct-user">${escapeHtml((dept ? `${dept} – ` : "") + author)}</div>
                        <div class="ct-time">${escapeHtml(displayDate)}</div>
                        <div class="ct-text">${content || ""}</div>
                        <div class="ct-view-more">Click to view more</div>
                    </div>`;
            }).join("");

            setTimeout(refreshAuditLogOverflowHints, 0);
            setTimeout(refreshAuditLogOverflowHints, 350);
            return html;
        }


                async function getModelConfig(model, isFilter = true) {
            const configSTState = window.Config;

            if (!(configSTState.loadedSTConfig.some(f => f.modelName == model))) {
                try {
                    const response = await $.ajax({
                        url: `/api/Utility/GetSTConfig/${model}`,
                        type: 'GET'
                    });

                    configSTState.loadedSTConfig.push({
                        modelName: model,
                        data: response
                    });

                    // xử lý response
                    if (Array.isArray(response)) {
                        return isFilter
                            ? response.find(f => f.name === model) || null
                            : response;
                    }
                    else if (typeof response === "object" && response !== null) {
                        return response;
                    }

                    return null;

                } catch (error) {
                    console.error(error);
                    return null;
                }
            } else {
                return configSTState.loadedSTConfig.find(f => f.modelName == model).data;
            }
        }
            async function RenderGridElement(_gridConfig, gridInstance) {
                for (var item of _gridConfig) {
                    item.lookup = null;
                    item.mLookup = null;

                    if (item.gridVisibleIndex != null) {

                        item.visibleIndex = item.gridVisibleIndex;

                        if (item.gridVisibleIndex < 0) {
                            item.visible = false;
                        }

                    } else {

                        item.visibleIndex = item.order;
                    }

                    if (item.validationRules != null && item.validationRules != "") {

                        if (typeof item.validationRules === "string") {
                            item.validationRules = JSON.parse(item.validationRules);
                        }
                    }

                    if (isNullOrEmpty(item.width)) {
                        item.width = _defaultGridFieldWidth;
                    }

                    if (isNullOrEmpty(item.height)) {
                        item.height = _defaultGridFieldHeight;
                    }

                    if (item.dataType == "datetime" || item.dataType == "date") {

                        item.editorOptions = item.editorOptions || {};
                        item.editorOptions.pickerType = "calendar";
                    }

                    if (item.dataType == "enum") {

                        byteObjectConvert(item, gridInstance);

                        item = selectBoxRemakeOption(item, gridInstance);
                    }

                    else if (item.dataType == "customenum") {

                        byteObjectConvert(item, gridInstance);

                        item = selectBoxCustomFromTableRemakeOption(
                            item,
                            gridInstance
                        );
                    }

                    else if (item.dataType == "table") {
                        var gridConfig = await makeFieldFeatures(
                            item,
                            gridInstance,
                            "grid"
                        );

                        var mDropDownDS = new MDropDownDataSource();

                        var customOptions = {
                            skip: _defaultSkipDropDown,
                            take: _defaultTakeDropDown,
                            orderBy: false
                        };

                        var DS = mDropDownDS.getDropDownDS(
                            'id',
                            `api/${gridConfig.model}/DropDownLookUp`,
                            customOptions
                        );

                        if (gridConfig.config.displayExp) {

                            item.lookup = {
                                dataSource: DS,
                                displayExpr: gridConfig.config.displayExp,
                                valueExpr: 'id'
                            };

                            item.editorType = "dxDropDownBox";

                            item.editorOptions = {
                                editorType: "dxDropDownBox",
                                width: "100%",
                                dropDownOptions: {
                                    width: _defaultDropDownWidth,
                                    height: _defaultDropDownHeight,
                                },
                                showClearButton: true,
                                dataSource: DS,
                                columns: gridConfig.config.getScheme,

                                contentTemplate: function (e) {

                                    const $dataGrid = $("<div>").dxDataGrid({

                                        selectionMode: 'all',

                                        filterRow: {
                                            visible: true
                                        },

                                        dataSource: e.component.option("dataSource"),

                                        displayExpr: gridConfig.config.displayExpr,

                                        columns: e.component.option("columns"),

                                        selection: {
                                            mode: "single"
                                        },

                                        scrolling: {
                                            mode: 'virtual',
                                            preloadEnabled: false,
                                            showScrollbar: 'always'
                                        },

                                        width: "100%",
                                        height: "100%",

                                        allowItemDeleting: false,

                                        showSelectionControls: true,

                                        sorting: {
                                            mode: 'multiple',
                                        },

                                        onSelectionChanged: function (selectedItems) {

                                            var keys = selectedItems.selectedRowKeys;

                                            if (keys.length) {

                                                e.component.selectedItem =
                                                    selectedItems.selectedRowsData;

                                                e.component.option(
                                                    "displayValue",
                                                    selectedItems.selectedRowsData[0][gridConfig.config.displayExp]
                                                );

                                                e.component.option(
                                                    "value",
                                                    keys[0]
                                                );
                                            }
                                        },

                                        columnAutoWidth: true
                                    });

                                    var dtGrid = $dataGrid.dxDataGrid("instance");

                                    e.component.on("valueChanged", function (args) {

                                        dtGrid.selectRows(args.value, false);

                                        if (args.value != null) {
                                            e.component.close();
                                        }
                                    });

                                    return $dataGrid;
                                }
                            };

                        } else {

                            appErrorHandling(
                                "RenderGridElement Exception: No display Expr defined!"
                            );
                        }
                    }
                }
            }

            var appErrorHandling = function (message, err) {
                try {
                    if (!err?.__clientErrorLogged && typeof sendClientErrorLog === "function") {
                        sendClientErrorLog(message, err, {
                            status: err?.status || err?.xhr?.status,
                            responseText: err?.responseText,
                            stack: err?.stack,
                            errorType: "handled_error"
                        });
                    }
                } catch {
                    // Logging must never interrupt the original error handling flow.
                }
                if (err != null) {
                    if (err == "Unauthorized") {
                        window.location = "/Account/Login";
                    } else {
                        switch (err.status) {
                            case 401:
                                window.location = "/Account/Login";
                                break;
                            case 400: case 404: case 500:
                                //Nhat bat custom exception
                                if (message != err.responseText) {
                                    message = message == null ? err.responseText : message + err.responseText;
                                } else {
                                    message = err.responseText;
                                }

                                break;
                            default:
                                {
                                    if (err.responseText)
                                        message = `${message} ${err.responseText}. ${err.stack}`;
                                    else
                                        message = `${message} ${err}`;
                                    break;
                                }
                        }
                    }

                    try {
                        if (err?.stack) {
                            const regex = /:(\d+):(\d+)\)?$/m;
                            // Tìm dòng "at" thực tế đầu tiên chứa file (bỏ qua <anonymous>)
                            const lines = err?.stack.split("\n");
                            const targetLine = lines.find(line => line.includes("https://"));

                            const match = targetLine.match(/:(\d+):(\d+)/);

                            if (match) {
                                const fullPath = targetLine;
                                const fileName = fullPath.match(/\/([^\/]+):(\d+):(\d+)/);
                                const errorLineIndex = lines.filter(line => line.includes(fileName[1])).findIndex(line => line.includes(fileName[1]));
                                const errorLine = lines.filter(line => line.includes(fileName[1]));
                                if (errorLineIndex !== -1 && lines[errorLineIndex + 1]) {
                                    const nextLine = errorLine[errorLineIndex + 1] ?? errorLine[errorLineIndex];

                                    // Regex lấy tên hàm trước dấu ngoặc đơn
                                    const functionMatch = nextLine.match(/at\s+(.*?)\s+\(/);
                                    const functionName = functionMatch ? functionMatch[1] : "unknown";

                                    const lineNumber = match[1];
                                    const columnNumber = match[2];
                                    const errorInfo = {
                                        message: err.message,
                                        fileName: fileName[1],
                                        lineNumber: lineNumber,
                                        columnNumber: columnNumber,
                                        stack: err?.stack,
                                        errorType: 'appErrorHandling',
                                        functionName: functionMatch[1]
                                    };
                                    //sendClientErrorLog(message, err, errorInfo);
                                }
                            }
                        }
                    }
                    catch {

                    }
                    console.trace(); //For dev
                }

                try {
                    let parsedObject = JSON.parse(message);
                    if (parsedObject.typeMsg != undefined) {
                        if (parsedObject.typeMsg[0] == "popup") {
                            appNotifyWarning(parsedObject.message[0]);
                        }
                    }
                    else
                        appNotifyError(message);

                }
                catch { appNotifyError(message); }
            }

                function selectBoxCustomFromTableRemakeOption(item, gridInstance) {
                if (item.formItem) {
                    var cfg = item.formItem; // parse từ JSON config

                    var store = new DevExpress.data.CustomStore({
                        key: cfg.valueExpr,
                        loadMode: "raw",
                        load: function (loadOptions) {
                            return $.ajax({
                                url: cfg.apiUrl,
                                type: "GET",
                                dataType: "json",
                                data: {
                                    group: cfg.group,
                                    excludeCurrent: cfg.excludeCurrent,
                                    keyword: loadOptions.searchValue || ""
                                }
                            }).then(function (res) {
                                return res && res.success ? res.data : [];
                            });
                        },
                        byKey: function (key) {
                            if (!key) return null;
                            return $.ajax({
                                url: `${cfg.apiByKeyUrl}/${key}`,
                                type: "GET",
                                dataType: "json"
                            }).then(function (res) {
                                return res && res.success ? res.data : null;
                            });
                        }
                    });

                    item.lookup = {
                        dataSource: store,
                        displayExpr: cfg.displayExpr,
                        valueExpr: cfg.valueExpr,
                        searchEnabled: true,
                        showClearButton: true
                    };

                    item.editorType = "dxSelectBox";
                    item.editorOptions = makeCustomSelectBoxEditorOptions(store, cfg);
                }
                return item;
            }


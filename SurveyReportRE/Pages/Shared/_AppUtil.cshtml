                                            itemArr = data.map(item => {
                                                return {
                                                    id: item.id,
                                                    key: `${item.key}`
                                                }
                                            });
                                            dataSource._items = itemArr;
                                            dataSource._store._array = itemArr;
                                            dataSource.reload();
                                            gridInstance.component.refresh();
                                        }));


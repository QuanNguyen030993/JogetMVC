            const attachmentRecordSnapshots = new Map();

            function getAttachmentRecordSnapshot(controllerName, recordGuid, forceRefresh) {
                const key = `${String(controllerName || "Document").toLowerCase()}|${recordGuid}`;
                const current = attachmentRecordSnapshots.get(key);

                if (!forceRefresh && current) return current.promise;
                // Coalesce multiple onUploaded callbacks from the same upload batch.
                if (forceRefresh && current?.refreshing) return current.promise;

                const entry = { promise: null, refreshing: !!forceRefresh };
                const url = `/api/${controllerName}/GetByKey?recordGuid=${encodeURIComponent(recordGuid)}`;
                entry.promise = Promise.resolve($.ajax({
                    url: url,
                    method: "GET",
                    dataType: "json"
                })).then(function (data) {
                    entry.refreshing = false;
                    return Array.isArray(data) ? data : [];
                }).catch(function (error) {
                    if (attachmentRecordSnapshots.get(key) === entry) {
                        attachmentRecordSnapshots.delete(key);
                    }
                    throw error;
                });

                attachmentRecordSnapshots.set(key, entry);
                return entry.promise;
            }

            function attachmentBelongsToFolder(documentItem, folder) {
                if (!folder) return true;

                let attributes = documentItem?.attributes ?? documentItem?.Attributes ?? "";
                if (typeof attributes !== "string") {
                    try {
                        attributes = JSON.stringify(attributes);
                    } catch (_) {
                        attributes = "";
                    }
                }

                // Keep the same matching semantics as DocumentController's
                // Attributes.Contains(folder), while doing it on the shared snapshot.
                return attributes.toLocaleLowerCase().includes(String(folder).toLocaleLowerCase());
            }


            function parseToGMT7(dateInput, minusTimeZone = 0 ) {
                 //const offsetMinutes = date.getTimezoneOffset();
           const d = new Date(dateInput); // JS auto parse ISO / UTC
           if (isNaN(d)) return null;
           // +7 tiếng (milliseconds)
           return new Date(d.getTime() + minusTimeZone * 60 * 60 * 1000);
        }

            function fmtTimeLocal(input) { //SQL date -> dd/mm/yyyy HH:mm, only this date parse, formatTime by default
            if (!input) return "—";
            var d = parseToGMT7(input);

            if (input instanceof Date) {
                d = input;
            } else if (typeof input === "string") {
                // normalize: nếu không có timezone → thêm Z để tránh parse lệch
                const hasTZ = /[zZ]|[+-]\d{2}:\d{2}$/.test(input);

                d = parseToGMT7(hasTZ ? input : input + "Z",-7);//  new Date(hasTZ ? input : input + "Z");
            } else {
                return "—";
            }

            if (isNaN(d.getTime())) return "—";

            const pad = (n) => String(n).padStart(2, "0");
            return `${pad(d.getDate())}/${pad(d.getMonth() + 1)}/${d.getFullYear()} ${pad(d.getHours())}:${pad(d.getMinutes())}`;
        }


        function normalizeStatus(raw) {
            const s = String(raw ?? "").trim();
            const k = s.toLowerCase().replace(/\s+/g, " ");

            if (k === "" || k === "new") return { css: "new", text: raw };
            if (k === "pending") return { css: "pending", text: raw };
            if (k.includes("pending")) return { css: "pending", text: raw };
            if (k === "in progress") return { css: "in-progress", text: raw };
            if (k === "accept") return { css: "accepted", text: raw };
            if (k.includes("accept")) return { css: "accepted", text: raw };
            if (k === "approved") return { css: "approved", text: raw };
            if (k === "reject") return { css: "rejected", text: raw };
            if (k === "decline" || k === "declined") return { css: "declined", text: raw };
            if (k === "quotation confirmed") return { css: "accepted", text: raw };
            if (k === "quotation refused") return { css: "rejected", text: raw };
            if (k === "done") return { css: "done", text: raw };
            if (k === "complete") return { css: "complete", text: raw };
            if (k.includes("complete")) return { css: "complete", text: raw };
            if (k === "dispose") return { css: "dispose", text: raw };
            if (k === "archive") return { css: "archive", text: raw };
            if (k === "?" || k === "unknown") return { css: "unknown", text: "?" };
            return { css: "unknown", text: s || "?" };
        }
        function parsePicObject(picJson) {
            try {
                return typeof picJson === "string"
                    ? JSON.parse(picJson || "{}")
                    : (picJson || {});
            } catch {
                return {};
            }
        }

        function buildPicCategorySearchText(picJson) {
            const obj = parsePicObject(picJson);
            const deptOrder = ["FO", "TS", "UW", "LMKT", "PM"];
            const parts = [];

            deptOrder.forEach(dept => {
                const user = String(obj[dept] || "").trim();
                if (!user) {
                    parts.push(dept);
                    return;
                }

                parts.push(dept);
                parts.push(`${dept}:${user}`);
                parts.push(`${dept}: ${user}`);
                parts.push(`${dept} ${user}`);
            });

            return parts.join(" ");
        }

    function formatPicValue(val, dept) {
        if (!val) return "-";

        // FO là object
        if (dept === "FO" && typeof val === "object") {
            return Object.entries(val)
                .filter(([k, v]) => v)
                .map(([k, v]) => `${k}:${v}`)
                .join(" | ");
        }

        return String(val);
    }


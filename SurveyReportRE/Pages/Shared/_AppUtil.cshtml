            function getTransitionButtonIcon(route, fallbackIcon) {
                if (route?.icon) return route.icon;

                var routeData = safeJsonParse(route?.data);
                return routeData?.icon || fallbackIcon;
            }

            function getTransitionButtonClass(route, fallbackClass) {
                if (route?.buttonClass) return route.buttonClass;

                var routeData = safeJsonParse(route?.data);
                return routeData?.buttonClass || fallbackClass || "";
            }

            function getTransitionButtonPlacement(route, fallbackPlacement) {
                var routeData = safeJsonParse(route?.data) || {};
                var placement = route?.buttonPlacement || routeData.buttonPlacement || fallbackPlacement || "footer";
                placement = String(placement).trim().toLowerCase();

                return ["decision", "custom"].includes(placement) ? placement : "footer";
            }

            function getTransitionButtonGroupName(route, fallbackGroupName) {
                var routeData = safeJsonParse(route?.data) || {};
                return String(
                    route?.buttonGroupName
                    || routeData.buttonGroupName
                    || fallbackGroupName
                    || ""
                ).trim();
            }

            function applyTransitionButtonClass(selector, route, fallbackClass) {
                var buttonClass = getTransitionButtonClass(route, fallbackClass);
                var knownClasses = "dx-button-default dx-button-success dx-button-danger dx-button-warning dx-button-info dx-button-normal";
                var $button = $(selector);

                if (!buttonClass) {
                    return "";
                }

                $button.removeClass(knownClasses);
                $button.addClass(buttonClass);

                return buttonClass;
            }

            function evaluateTransitionScript(moduleName, nextStep, findRoute, formItems, sendData) {
                var routeData = safeJsonParse(findRoute?.data) || {};
                var script = routeData.transitionScript || findRoute?.transitionScript;
                for (var unwrapIndex = 0; unwrapIndex < 3 && typeof script === "string"; unwrapIndex++) {
                    if (!script.trim().startsWith("{")) break;
                    var wrappedScript = safeJsonParse(script);
                    if (!wrappedScript || typeof wrappedScript.transitionScript !== "string") break;
                    script = wrappedScript.transitionScript;
                }
                if (!script || !String(script).trim()) {
                    return { formItems: formItems, sendData: sendData };
                }
                try {
                    var runner = new Function(
                        "formItems", "sendData", "findRoute", "nextStep", "moduleName",
                        '"use strict";\n' + script
                    );
                    var result = runner(formItems, sendData, findRoute, nextStep, moduleName);

                    if (result && result.formItems) formItems = result.formItems;
                    else if (result && !result.sendData) formItems = result;
                    if (result && result.sendData) sendData = result.sendData;

                    return { formItems: formItems, sendData: sendData };
                } catch (error) {
                    console.error("Transition JavaScript failed", error, findRoute);
                    DevExpress.ui.notify("Transition JavaScript error: " + error.message, "error", 5000);
                    throw error;
                }
            }


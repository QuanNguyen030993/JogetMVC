       function renderComments(items) {
        if (!Array.isArray(items) || items.length === 0) {
            return `<div style="color:#6b7280;font-size:12px;padding:6px 4px;">No audit logs</div>`;
        }

        var html = items.map((c) => {
            const dept = (c.deptCode || "").toUpperCase();

            let typeClass = "";

            if (dept.startsWith("FO")) {
                typeClass = "ct-fo";
            } else if (dept.startsWith("TS")) {
                typeClass = "ct-ts";
            } else if (dept.startsWith("UW")) {
                typeClass = "ct-uw";
            } else if (dept.startsWith("LMKT")) {
                typeClass = "ct-lmkt";
            } else if (dept.startsWith("PM")) {
                typeClass = "ct-pm";
            }

            var auditKey = `audit_${Date.now()}_${++window.AuditLogViewState.sequence}`;
            var auditTitle = (c.deptCode ? c.deptCode + " - " : "") + (c.commentBy || "Audit Log");
            window.AuditLogViewState.contents[auditKey] = {
                title: auditTitle,
                author: c.commentBy || "",
                date: fmtTimeLocal(c.commentTime || ""),
                html: c.commentText || ""
            };

            return `
                <div class="ct-item ${typeClass}" data-audit-log-key="${auditKey}" onclick="openAuditLogDetail(this)" role="button" tabindex="0" onkeydown="if(event.key === 'Enter' || event.key === ' '){ event.preventDefault(); openAuditLogDetail(this); }">
                    <div class="ct-user">
                        ${escapeHtml((c.deptCode ? c.deptCode + " – " : "") + (c.commentBy || ""))}
                    </div>
                    <div class="ct-time">
                        ${fmtTimeLocal(c.commentTime || "")}
                    </div>
                    <div class="ct-text">
                        ${c.commentText || ""}
                    </div>
                    <div class="ct-view-more">Click to view more</div>
                </div>
            `;
        }).join("");

        setTimeout(refreshAuditLogOverflowHints, 0);
        setTimeout(refreshAuditLogOverflowHints, 350);
        return html;
    }

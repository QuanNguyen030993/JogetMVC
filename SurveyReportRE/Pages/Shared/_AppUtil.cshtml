                        const $co = $(this).find(".dept-callout");
                        if (!$co.length) return;
                        const pic = picMap[dept] || "";
                        $co.attr("data-pic-account", pic);
                        if (!pic) {
                            $co.find(".co-text").text("-");
                            $co.css({ color: "" });
                            return;

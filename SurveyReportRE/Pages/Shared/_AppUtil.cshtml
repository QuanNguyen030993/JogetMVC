                    .then(form => {
                        var scrollView = popupStandardContentByScroll(form.option("container"));
                            scrollView.appendTo(container);
                    })
                    .catch(error => {
                        try {
                            sendClientErrorLog("Lỗi khi tải dữ liệu:", error);

        async function fetchConfigurationData(model, typeScheme = null, that = null) {

            const configState = window.Config;

            let sysTableConfig = [];
            let getScheme = [];
            let displayExp = "name";
            let keyExpr = "id";

            // await tại đây
            const itemConfig = await getModelConfig(model);

            sysTableConfig = itemConfig;

            // =========================
            // URL scheme
            // =========================

            let url = `/api/${model}/GetScheme`;

            if (typeScheme != null && typeScheme != undefined) {

                url = typeScheme == "User"
                    ? `/api/${model}/GetScheme`
                    : `/api/${model}/GetSystemScheme`;
            }

            // =========================
            // CACHE
            // =========================

            if (!(configState.loadedConfig.some(f => f.modelName == model))) {

                try {

                    getScheme = await $.ajax({
                        url: url,
                        type: 'GET'
                    });

                    configState.loadedConfig.push({
                        modelName: model,
                        data: getScheme
                    });

                } catch (err) {

                    console.warn(`AppUtilsFetchSchemeException: Scheme is not defined or controller ${model} not exist!`);
                }
            }
            else {

                getScheme = configState.loadedConfig
                    .find(f => f.modelName == model).data;
            }

            // =========================
            // CONFIG
            // =========================

            if (itemConfig) {

                if (itemConfig.displayExpr)
                    displayExp = itemConfig.displayExpr;

                if (itemConfig.keyExpr)
                    keyExpr = itemConfig.keyExpr;

                if (!sysTableConfig.customQuery)
                    sysTableConfig.customQuery = "";
            }
            await RenderGridElement(getScheme, that);
            return {
                sysTableConfig,
                getScheme,
                displayExp,
                keyExpr
            };
        }

        function uploadFileAjax(file, data, options) {
            const specificFolder = "";
            const latestOptions = getCurrentFormOptions(options) || {};
            latestOptions.moduleName = options?.moduleName;
            if (options?.code)
                    latestOptions.code = options?.code;
                if (options?.specificFolder) {
                    latestOptions.code = `${options?.code}\\${options?.specificFolder}`;
                        specificFolder = `_${options?.specificFolder}`;
            }


            const url = options.url;
            const guid = file.guid || "";
            const folder = buildFolder(latestOptions, options.controlId) || "";
            const sectionName = `${options.controlId}${specificFolder}`;
                const dept = options.sectionName || "";

            const formData = new FormData();
            formData.append("file", file);
            console.log(options.data);
            return $.ajax({
                url: url,
                method: "POST",
                data: formData,
                processData: false,
                contentType: false,
                beforeSend: function (xhr) {

                    if (guid) {
                        xhr.setRequestHeader("RecordGuid", guid);
                    }

                    if (folder) {
                        xhr.setRequestHeader("Folder", folder);
                    }

                    if (window.appToken) {
                        xhr.setRequestHeader("Authorization", "Bearer " + window.appToken);
                    }
                    if (sectionName) {
                        xhr.setRequestHeader("SectionName", sectionName);
                    }
                   if (sectionName) {
                      xhr.setRequestHeader("Department", dept);
                     }
                     if (options.data){
                        xhr.setRequestHeader("Data", JSON.stringify(data));
                     }


                }
            });

        }

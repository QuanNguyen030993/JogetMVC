        async function copyAttachmentToClipboard(attachment, downloadUrl, fileName) {
            if (!downloadUrl) {
                DevExpress.ui.notify("No download url", "warning", 2000);
                return;
            }

            const absoluteUrl = new URL(downloadUrl, window.location.origin).href;
            try {
                if (window.isSecureContext && navigator.clipboard?.write && window.ClipboardItem) {
                    const response = await fetch(absoluteUrl, { credentials: "include" });
                    if (!response.ok) throw new Error("Unable to download attachment");

                    const blob = await response.blob();
                    const mimeType = blob.type || attachment.contentType || attachment.ContentType || "application/octet-stream";
                    const isSupported = typeof ClipboardItem.supports !== "function" || ClipboardItem.supports(mimeType);
                    if (isSupported) {
                        await navigator.clipboard.write([
                            new ClipboardItem({ [mimeType]: blob })
                        ]);
                        DevExpress.ui.notify(`Copied ${fileName}. Paste it into the email editor.`, "success", 2200);
                        return;
                    }
                } else {
                    console.warn(`Remark box not found: ${remarkBoxId}`);
                }

                await navigator.clipboard.writeText(absoluteUrl);
                DevExpress.ui.notify("Browser cannot copy this file type. Download link copied instead.", "warning", 3000);
            } catch (error) {
                try {
                    await navigator.clipboard.writeText(absoluteUrl);
                    DevExpress.ui.notify("File copy is not supported. Download link copied instead.", "warning", 3000);
                } catch {
                    DevExpress.ui.notify(error.message || "Copy attachment failed", "error", 2500);
                }
            }
        }

        function previewAttachment(id, extension, fileName) {
            const ext = String(extension || "").toLowerCase().replace(/^\./, "");
            const imageExtensions = ["jpg", "jpeg", "png", "gif", "bmp", "webp", "svg"];
            const officeExtensions = ["doc", "docx", "xls", "xlsx", "ppt", "pptx", "odt", "ods", "odp"];
            const textExtensions = ["txt", "log", "md", "csv", "json", "xml", "yaml", "yml", "ini", "config", "sql", "js", "css", "html", "htm"];

            if (imageExtensions.includes(ext)) {
                openImagePreviewPopup(id);
                return;
            }
            if (officeExtensions.includes(ext)) {
                openOfficePopup(id);
                return;
            }
            if (ext === "pdf") {
                openPDFPopup(id);
                return;
            }
            if (textExtensions.includes(ext)) {
                openTextPreviewPopup(id, fileName);
                return;
            }

            DevExpress.ui.notify("Preview is not supported for this file type", "info", 2000);
        }


                        //}).done(res => {
                        //}).fail(xhr => {
                        //    console.log(xhr.status, xhr.responseText);
                        //});


                        DevExpress.ui.notify("Quotation created!", "success", 1200);
                        popupInstance.hide();
                    },
                },
            }]

        }).dxPopup("instance");
        popupInstance.show();
    }

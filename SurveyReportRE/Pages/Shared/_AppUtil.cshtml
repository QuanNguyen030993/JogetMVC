                    if (!$stageRoot.length || $stageRoot.attr("data-render-stage") === "routeState") {
                        return Promise.resolve();
                    }

                    return new Promise(function (resolve) {
                        var root = $stageRoot[0];
                        var observer = new MutationObserver(function () {
                            if ($stageRoot.attr("data-render-stage") !== "routeState") return;
                            observer.disconnect();
                            resolve();
                        });
                        observer.observe(root, { attributes: true, attributeFilter: ["data-render-stage"] });
                    });
                }


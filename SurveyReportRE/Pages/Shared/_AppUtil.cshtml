        function resolveNormalButtonHost(buttonHostId, context) {
            let $host = $(`#${buttonHostId}`);

            if ($host.length) {
                return $host;
            }

            $host = $(`<div id="${buttonHostId}"></div>`);

            if (typeof params.resolveButtonHost === "function") {
                const target = params.resolveButtonHost(context);

                if (target?.length) {
                    $host.appendTo(target);
                }
            }

            return $host;
        }

        function buildNormalRouteButton(options) {
            const route = options.route;
            const isReturn = options.type === "return";

            const buttonHostId =
                isReturn
                    ? moduleConfig.getReturnButtonId(stageDept, id)
                    : moduleConfig.getSubmitButtonId(stageDept, id);

            if (!buttonHostId) {
                return;
            }

            const rawRouteKey =
                route?.routeId ||
                route?.id ||
                route?.actionCode ||
                options.routeIndex;

            const buttonId =
                `${buttonHostId}_${safeKey(rawRouteKey)}`;

            const $oldButton = $(`#${buttonId}`);

            if ($oldButton.length) {
                try {
                    $oldButton.dxButton("instance")?.dispose();
                } catch (e) {}

                $oldButton.remove();
            }

            const $host = resolveNormalButtonHost(
                buttonHostId,
                {
                    type: isReturn ? "return" : "submit",
                    dept: stageDept,
                    route: route,
                    id: id,
                    moduleCode: moduleCode
                }
            );

            if (!$host.length) {
                return;
            }

            const $button = $(
                `<div
                    id="${buttonId}"
                    data-workflow-record-id="${id}"
                    data-workflow-route-button="true">
                </div>`
            ).appendTo($host);

            $button.dxButton({
                disabled: false,
                className: "submit-btn-visible",
                text:
                    route?.displayStatus ||
                    route?.actionName ||
                    route?.actionCode ||
                    (isReturn ? "Return" : "Submit"),

                icon:
                    typeof getTransitionButtonIcon === "function"
                        ? getTransitionButtonIcon(
                            route,
                            isReturn
                                ? "undo"
                                : "fa-solid fa-person-running"
                        )
                        : undefined,

                type:
                    isReturn
                        ? "danger"
                        : "info",

                onClick: function () {
                    const formItems =
                        getFormItems(stageDept);

                    const content =
                        getRemark(stageDept);

                    if (isReturn && !content) {
                        appNotifyWarning(
                            "Please put your reason to remarks!",
                            false
                        );

                        return;
                    }

                    formItems.comment =
                        content || "";

                    if (isReturn) {
                        return returnToStepFn(
                            moduleConfig.formKey,
                            state.nextStep,
                            route,
                            formItems,
                            params
                        );
                    }
                        if (!route.isReturn && !content) {
                            appNotifyWarning("You may leave your remark empty, system will remark default message?",  true,
                            "Ok",
                            "Cancel").then(function (result) {
                            if (result.isConfirmed) {
                                formItems.comment = `${_loginUser} ${route.displayStatus}`;
                                return submitNextStepFn(
                                moduleConfig.formKey,
                                    state.nextStep,
                                    route,
                                    formItems,
                                    params
                                );
                                }
                                });
                            }
                            else {
                                return;
                            }
                        }
                        
            });

            if (
                typeof applyTransitionButtonClass === "function"
            ) {
                applyTransitionButtonClass(
                    `#${buttonId}`,
                    route
                );
            }
        }

        async function buildCustomRoutes(customRoutes) {
            for (
                const [deptIndex, deptItem]
                of deptCodes.entries()
            ) {
                
                const normalizedDept =
                    normalizeDept(deptItem);

                const customRoutesInDept =
                    customRoutes.filter(function (route) {
                        const routeKeys =
                            getRouteGroupKeys(route);

                        const deptKey =
                            normalizeGroupKey(deptItem);

                        const isDeptMatch =
                            routeKeys.some(function (routeKey) {
                                return (
                                    routeKey === deptKey ||
                                    routeKey.indexOf(deptKey) >= 0 ||
                                    deptKey.indexOf(routeKey) >= 0
                                );
                            });

                        const routeData =
                            String(route?.data || "");

                        var groupMatch =
                            !routeData ||
                            routeData.includes(
                                `decision${deptItem}Group`
                            );

                            if (deptItem == "FO")
                            {
                                 groupMatch =
                                !routeData ||
                                routeData.includes(
                                    `decisionClientGroup`
                                );
                                debugger
                            }
                           

                        return isDeptMatch && groupMatch;
                    });

                if (!customRoutesInDept.length) {
                    continue;
                }

                for (
                    const [routeIndex, route]
                    of customRoutesInDept.entries()
                ) {
                    if (formStages?.pace) {
                        await formStages.pace(routeIndex);
                    }
                    debugger
                    const routeDept =
                        getRouteDept(
                            route,
                            normalizedDept
                        );

                    let $routeHost =
                        typeof params.resolveCustomRouteHost === "function"
                            ? params.resolveCustomRouteHost({
                                moduleCode: moduleCode,
                                dept: routeDept,
                                deptItem: deptItem,
                                route: route,
                                id: id,
                                prefix: prefix
                            })
                            : $();

                    if (
                        !$routeHost?.length &&
                        moduleCode === "qt"
                    ) {
                        $routeHost =
                            $(
                                `#decision-actions-qt-form_${deptItem}_${id}-${deptItem}`
                            )
                                .first();
                    }

                    if (
                        !$routeHost?.length &&
                        moduleCode === "pi"
                    ) {
                        $routeHost =
                            $(
                                `#decision-actions-pi-form_${deptItem}_${id}-${deptItem}`
                            )
                                .first();
                    }

                    if (!$routeHost.length) {
                        console.warn(
                            "Custom route host not found",
                            {
                                moduleCode: moduleCode,
                                deptItem: deptItem,
                                routeDept: routeDept,
                                route: route
                            }
                        );

                        continue;
                    }

                    const rawRouteKey =
                        route?.routeId ||
                        route?.id ||
                        route?.actionCode ||
                        routeIndex;

                    const customButtonId =
                        `${moduleCode}-custom-route-` +
                        `${id}-` +
                        `${routeDept}-` +
                        `${safeKey(rawRouteKey)}-` +
                        `${routeIndex}`;

                    const $old =
                        $(`#${customButtonId}`);

                    if ($old.length) {
                        try {
                            $old.dxButton("instance")?.dispose();
                        } catch (e) {}

                        $old.remove();
                    }

                    const $customButton =
                        $(
                            `<div
                                id="${customButtonId}"
                                data-workflow-record-id="${id}"
                                data-custom-route-button="true">
                            </div>`
                        )
                            .appendTo($routeHost);

                    const formItems =
                        getFormItems(routeDept);

                    const latestTatObject =
                        typeof tryParseJSON === "function"
                            ? (
                                tryParseJSON(
                                    formItems.turnAroundTimeAttributes,
                                    "TAT Load Button Problem"
                                ) || {}
                            )
                            : {};

                    const disabled =
                        !!latestTatObject?.[
                            routeDept
                        ]?.AcceptDate;

                    $customButton.dxButton({
                        disabled: disabled,

                        text:
                            route?.displayStatus ||
                            route?.actionName ||
                            route?.actionCode ||
                            "Custom action",

                        icon:
                            typeof getTransitionButtonIcon === "function"
                                ? getTransitionButtonIcon(
                                    route,
                                    route?.isReturn
                                        ? "undo"
                                        : ""
                                )
                                : undefined,

                        type:
                            route?.isReturn
                                ? "danger"
                                : "info",

                        onClick: function () {
                            const routeFormItems =
                                getFormItems(routeDept);

                            const content =
                                getRemark(routeDept);

                            if (
                                route?.isReturn &&
                                !content
                            ) {
                                appNotifyWarning(
                                    "Please put your reason to remarks!",
                                    false
                                );

                                return;
                            }

                            routeFormItems.comment =
                                content || "";

                            if (route?.isReturn) {
                                return returnToStepFn(
                                    moduleConfig.formKey,
                                    state.nextStep,
                                    route,
                                    routeFormItems,
                                    params
                                );
                            }

                            return submitNextStepFn(
                                moduleConfig.formKey,
                                state.nextStep,
                                route,
                                routeFormItems,
                                params
                            );
                        }
                    });

                    if (
                        typeof applyTransitionButtonClass === "function"
                    ) {
                        applyTransitionButtonClass(
                            `#${customButtonId}`,
                            route
                        );
                    }
                }
            }
        }

        if (reload) {
            cleanupDynamicButtons();
        }

        if (!guid) {
            state.selectedGuid = null;

            return $.Deferred()
                .resolve()
                .promise();
        }

        state.selectedGuid = guid;

        return ajaxGet(
            moduleConfig.workflowUrl(guid),
            null
        )
            .then(function (instance) {
                state.workflowInstance =
                    instance;

                return $.when(
                    loadScreenConditions(
                        instance?.currentStep,
                        params.selectedId ?? id,
                        instance,
                        params
                    )
                )
                    .then(function () {
                        const workflowDefinitionId =
                            instance?.workflowDefinitionId ||
                            "00000000-0000-0000-0000-000000000000";

                        const currentStep =
                            instance?.currentStep ?? 0;

                        return ajaxGet(
                            moduleConfig.nextStepUrl(
                                workflowDefinitionId,
                                currentStep
                            ),
                            null
                        );
                    })
                    .then(function (data) {
                        data =
                            Array.isArray(data)
                                ? data
                                : [];

                        state.nextStep =
                            state.nextStep || {};

                        state.nextStep.instanceWorkflow =
                            instance;

                        state.nextStep.flowSteps =
                            data;

                        state.nextStep.currentStep =
                            instance?.currentStep ?? 0;

                        const customRoutes =
                            data.filter(function (route) {
                                return String(
                                    route?.flowType || ""
                                )
                                    .trim()
                                    .toLowerCase() === "custom";
                            });

                        const normalRoutes =
                            data.filter(function (route) {
                                return (
                                    !route?.isReturn &&
                                    String(
                                        route?.flowType || ""
                                    )
                                        .trim()
                                        .toLowerCase() !== "custom" &&
                                    normalizeDept(
                                        route?.fromNodeId
                                    ) ===
                                        normalizeDept(stageDept) &&
                                    route?.fNodeId ===
                                        state.nextStep.currentStep
                                );
                            });

                        const returnRoutes =
                            data.filter(function (route) {
                                return (
                                    route?.isReturn &&
                                    String(
                                        route?.flowType || ""
                                    )
                                        .trim()
                                        .toLowerCase() !== "custom" &&
                                    normalizeDept(
                                        route?.fromNodeId
                                    ) ===
                                        normalizeDept(stageDept) &&
                                    route?.fNodeId ===
                                        state.nextStep.currentStep
                                );
                            });

                        return $.when(
                            formStages?.enter
                                ? formStages.enter("routeState")
                                : null
                        )
                            .then(async function () {
                                for (
                                    const [routeIndex, route]
                                    of returnRoutes.entries()
                                ) {
                                    if (formStages?.pace) {
                                        await formStages.pace(
                                            routeIndex
                                        );
                                    }

                                    buildNormalRouteButton({
                                        route: route,
                                        type: "return",
                                        routeIndex: routeIndex
                                    });
                                }

                                for (
                                    const [routeIndex, route]
                                    of normalRoutes.entries()
                                ) {
                                    if (formStages?.pace) {
                                        await formStages.pace(
                                            returnRoutes.length +
                                            routeIndex
                                        );
                                    }

                                    buildNormalRouteButton({
                                        route: route,
                                        type: "submit",
                                        routeIndex: routeIndex
                                    });
                                }
                                hideLoading("actionRight");

                                await buildCustomRoutes(
                                    customRoutes
                                );

                                if (
                                    typeof params.onLoaded === "function"
                                ) {
                                    await params.onLoaded({
                                        instance: instance,
                                        routes: data,
                                        normalRoutes: normalRoutes,
                                        returnRoutes: returnRoutes,
                                        customRoutes: customRoutes,
                                        state: state,
                                        params: params
                                    });
                                }

                                return {
                                    instance: instance,
                                    routes: data,
                                    normalRoutes: normalRoutes,
                                    returnRoutes: returnRoutes,
                                    customRoutes: customRoutes,
                                    state: state
                                };
                            });
                    });
            });
    }
    function getLoadingIndicator(actionRightId) {
        const selector = $(`.${actionRightId}_loading`)[0];
       return selector;
    }
    function showLoading(actionRightId) {
        const selector = $(`<div class="${actionRightId}_loading">`);
        selector.appendTo($(`.${actionRightId}`)[0]);
        selector.dxLoadIndicator({ width: 14, height: 14, visible: false });
       if (selector) {
           selector.dxLoadIndicator("instance").option("visible", true);
       }
    }
    function hideLoading(actionRightId) {
       const indicator = getLoadingIndicator(actionRightId);
        if (indicator) {
           $(indicator).dxLoadIndicator("instance").option("visible", false);
       }
    }
    function getDecisionRenderedObjects(formProps, decisionItems, legacyStatusId) {
        decisionItems = normalizeDecisionFieldButtons(decisionItems || []);

        var statusId = getDecisionFieldStatusId(
            formProps,
            decisionItems,
            legacyStatusId
        );

        var actionHostId = getDecisionFieldActionHostId(formProps);

        var $status = statusId
            ? $(`#${statusId}`)
            : $();

        var $actionHost = actionHostId
            ? $(`#${actionHostId}`)
            : $();

        var buttons = decisionItems
            .map(function (item) {
                var buttonId = getDelayAcceptButtonId(item);

                if (!buttonId) {
                    return null;
                }

                var $button = $(`#${buttonId}`);

                var instance = $button.length
                    ? $button.dxButton("instance")
                    : null;

                return {
                    id: buttonId,

                    config: item,

                    element: $button[0] || null,

                    $element: $button,

                    instance: instance,

                    enable: function () {
                        instance?.option("disabled", false);
                        return this;
                    },

                    disable: function () {
                        instance?.option("disabled", true);
                        return this;
                    },

                    setDisabled: function (disabled) {
                        instance?.option("disabled", !!disabled);
                        return this;
                    },

                    setVisible: function (visible) {
                        instance?.option("visible", !!visible);
                        return this;
                    },

                    option: function (name, value) {
                        if (!instance) {
                            return undefined;
                        }

                        if (arguments.length === 1) {
                            return instance.option(name);
                        }

                        instance.option(name, value);

                        return this;
                    }
                };
            })
            .filter(Boolean);

        var primaryButton = buttons[0] || null;

        return {
            formProps: formProps,

            status: {
                id: statusId,

                element: $status[0] || null,

                $element: $status,

                setText: function (text) {
                    $status.text(text ?? "");
                    return this;
                },

                show: function () {
                    $status.show();
                    return this;
                },

                hide: function () {
                    $status.hide();
                    return this;
                }
            },

            actionHost: {
                id: actionHostId,
                element: $actionHost[0] || null,
                $element: $actionHost
            },

            buttons: buttons,

            primaryButton: primaryButton,

            enable: function () {
                buttons.forEach(function (button) {
                    button.enable();
                });

                return this;
            },

            disable: function () {
                buttons.forEach(function (button) {
                    button.disable();
                });

                return this;
            },

            setDisabled: function (disabled) {
                buttons.forEach(function (button) {
                    button.setDisabled(disabled);
                });

                return this;
            },

            getButton: function (buttonId) {
                return buttons.find(function (button) {
                    return button.id === buttonId;
                }) || null;
            }
        };
    }
    window.WorkflowLoader =
        window.WorkflowLoader || {};

    window.WorkflowLoader.load =
        loadSelectedWorkflow;

</script>

                                    if (key)
                                        return $.ajax({
                                            url: `/api/${instance.ModelName}/DropDownLookupCustomQuery?key=${encodeURIComponent(key)}`,
                                            method: "POST",
                                            contentType: "application/json",
                                            data: JSON.stringify(checkCustomQueryByModel.customQuery)
                                        }).then(function (result) {
                                            return Array.isArray(result) ? result[0] : result;
                                        });
                                    else
                                        return new Array();
                                }
                                , update: function (key, values) {
                                    const formData = new FormData();

                                    // DevExtreme thường truyền key riêng và values riêng
                                    // gộp lại thành object hoàn chỉnh để API dễ xử lý
                                    const payload = Object.assign({}, values);

                                    if (typeof key === "object" && key !== null) {
                                        if (payload.id == null && key.id != null) {

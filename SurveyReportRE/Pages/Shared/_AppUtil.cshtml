            function revealOverviewPaneStatus(target, statusTextValue, ownerText, statusCssClass, detailStatusId) {
                const $target = target?.jquery ? target : $(target);
                if (!$target.length) return;

                const revealToken = `${Date.now()}_${Math.random().toString(36).slice(2)}`;
                const safeStatusClass = String(statusCssClass || "unknown").replace(/[^a-z0-9_-]/gi, "");
                const statusText = String(statusTextValue || "Unknown").trim();
                const owner = String(ownerText || "").trim();
                const $content = $("<span>").addClass("overview-status-content");

                const $state = $("<span>")
                    .addClass(`overview-status-state statusTagInForm ${safeStatusClass}`)
                    .text(statusText)
                    .appendTo($content);
                if (detailStatusId) $state.attr("id", detailStatusId);

                if (owner) {
                    $("<span>")
                        .addClass("overview-status-separator")
                        .attr("aria-hidden", "true")
                        .text("—")
                        .appendTo($content);
                    $("<span>")
                        .addClass("overview-status-owner")
                        .text(owner)
                        .appendTo($content);
                }

                $target
                    .data("overviewStatusRevealToken", revealToken)
                    .removeClass("is-ready")
                    .attr({
                        "aria-busy": "true",
                        title: owner ? `${statusText} — ${owner}` : statusText
                    })
                    .empty()
                    .append($content);

                requestAnimationFrame(function () {
                    requestAnimationFrame(function () {
                        if ($target.data("overviewStatusRevealToken") !== revealToken) return;
                        $target.addClass("is-ready").attr("aria-busy", "false");
                    });
                });

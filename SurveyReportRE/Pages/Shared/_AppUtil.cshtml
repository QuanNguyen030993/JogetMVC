           templateItem = _.cloneDeep(itemsArray.find(x => x.editorOptions !== undefined && x.editorType === "dxHtmlEditor"));

       if (formInstanceProps.outlineForm.isOutlineDynamic) {
           if (formInstanceProps.formOptions.Params) {

            const _gridDefaultTake = 50;
            const _gridMaxTake = 200;

            function normalizeGridLoadParams(ajaxOptions) {
                ajaxOptions.data = ajaxOptions.data || {};

                const parsedSkip = Number.parseInt(ajaxOptions.data.skip, 10);
                const parsedTake = Number.parseInt(ajaxOptions.data.take, 10);

                ajaxOptions.data.skip = Number.isFinite(parsedSkip) ? Math.max(parsedSkip, 0) : 0;
                ajaxOptions.data.take = Number.isFinite(parsedTake)
                    ? Math.min(Math.max(parsedTake, 1), _gridMaxTake)
                    : _gridDefaultTake;
            }


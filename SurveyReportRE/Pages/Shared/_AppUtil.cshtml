function styleModeChange(item){
        if (!Object.prototype.hasOwnProperty.call(item, "editorOptions")) {
            // có key editorOptions -> modify
            item.editorOptions = {
                stylingMode: "filled"
            };
        } else {
            // không có key -> tạo mới
            item.editorOptions.stylingMode = "filled";
        }
}

    function itemsStyle(item) {
        if (item.itemType == "group")
            itemsStyle(item.items);
        else {
            $.each(item, function (itemChIn, itemCh) {
                if (itemCh.itemType == "group")
                    itemsStyle(itemCh.items);
                    else
                    styleModeChange(itemCh);
            });
        }
    }
        function safeJsonParse(input, maxDepth = 2) {
      let result = input;

      for (let i = 0; i < maxDepth; i++) {
        if (typeof result !== "string") break;

        const trimmed = result.trim();
        if (!trimmed) return null;

        try {
          result = JSON.parse(trimmed);
        } catch (e) {
          console.warn("JSON parse error:", e);
          return null;
        }
      }

      return result;
    }

        function parseWorkflowNodeScreenConditions(node) {
            let data = node?.data ?? node?.Data ?? node ?? {};
            if (typeof data === "string") {
                try { data = JSON.parse(data); } catch { return []; }
            }

            const rules = data?.screenConditions || data?.rawNode?.screenConditions;
            if (Array.isArray(rules) && rules.length) return rules;

            const conditionMap = data?.condition || data?.rawNode?.condition;
            if (conditionMap && typeof conditionMap === "object") {
                return Object.entries(conditionMap).map(([sectionId, mode]) => ({ sectionId, mode }));
            }
            return [];
        }

        function applyQuotationScreenConditions(quotationId, screenConditions) {
            const $sections = $("[data-quotation-screen-section]").filter(function () {
                return String($(this).attr("data-quotation-id")) === String(quotationId);
            });

            // Screen-controlled sections are hidden unless the reached node explicitly shows them.
            $sections.hide();
            (Array.isArray(screenConditions) ? screenConditions : []).forEach(rule => {
                const sectionId = String(rule?.sectionId || "").trim();
                if (!sectionId) return;

                const $target = $sections.filter(function () {
                    return $(this).attr("data-quotation-screen-section") === sectionId;
                });
                String(rule?.mode || "Hide").toLowerCase() === "show"
                    ? $target.show()
                    : $target.hide();
            });
        }

        function loadAndApplyQuotationScreenConditions(currentNodeCode, quotationId) {
            applyQuotationScreenConditions(quotationId, []);
            if (!currentNodeCode || !quotationId) return $.Deferred().resolve([]).promise();

            const params = new URLSearchParams();
            params.set("refKey", currentNodeCode);
            params.set("refField", "Code");
            return ajaxGet(`/api/WorkflowInstanceNode/GetAll?${params.toString()}`, null)
                .then(result => {
                    const node = Array.isArray(result) ? result[0] : result;
                    const conditions = parseWorkflowNodeScreenConditions(node);
                    applyQuotationScreenConditions(quotationId, conditions);
                    // Some nested partial controls complete rendering after the workflow request.
                    setTimeout(() => applyQuotationScreenConditions(quotationId, conditions), 100);
                    return conditions;
                })
                .fail(() => applyQuotationScreenConditions(quotationId, []));
        }


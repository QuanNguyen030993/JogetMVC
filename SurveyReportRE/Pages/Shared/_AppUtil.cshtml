        function createHtmlEditor(container, $element, item, editorOptions) {
            editorOptions = editorOptions || {};

            var controlId = editorOptions.instanceProps
                ? editorOptions.instanceProps.refKey
                : (editorOptions.id || item.id || "new");
            var readOnly = item.isFieldReadOnly === true
                || editorOptions.isReadOnly === true
                || editorOptions.readOnly === true;
            var $editorElement = $element?.length ? $element : $("<div>");
            var editorControl;
            var syncingFromForm = false;
            var formInstance = editorOptions.formInstance || item.instanceProps?.formInstance;

            $editorElement
                .attr("id", `htmlEditor_${item.dataField}_${controlId}`)
                .addClass("tmiv-form-html-editor")
                .css("width", editorOptions.width || item.width || _defaultHtmlEditorWidth);

            var defaultOnChange = function (html) {
                if (readOnly || syncingFromForm) return;

                if (formInstance) {
                    // formInstance.updateData(item.dataField, html); // bug return to start 
                }
                editorOptions.value = html;
            };

            var onChange = defaultOnChange;
            if (item.customEditorOptions && typeof editorOptions.onValueChanged === "function") {
                onChange = function (html) {
                    editorOptions.onValueChanged({
                        value: html,
                        component: editorControl
                    });
                };
            } else if (typeof editorOptions.onChange === "function") {
                onChange = editorOptions.onChange;
            }

            var editorOnChange = onChange;
            onChange = function (html) {
                if (syncingFromForm) return;
                editorOnChange(html);
            };

            editorControl = $editorElement.htmleditor({
                value: editorOptions.value ?? "",
                height: editorOptions.formHeight || item.formHeight || 150,
                readOnly: readOnly,
                disabled: readOnly,
                onChange: onChange,
                onBlur: function (e) {
                    formInstance.updateData(item.dataField, e.value);
                }
            });

            if (formInstance && item.dataField) {
                formInstance.tmivHtmlEditors = formInstance.tmivHtmlEditors || {};
                formInstance.tmivHtmlEditors[item.dataField] = {
                    setValue: function (value) {
                        var nextValue = value ?? "";
                        if (editorControl.value() === nextValue) return;

                        syncingFromForm = true;
                        try {
                            editorControl.option("value", nextValue);
                            editorOptions.value = nextValue;
                        } finally {
                            syncingFromForm = false;
                        }
                    }
                };

                if (!formInstance.tmivHtmlEditorSyncRegistered) {
                    formInstance.tmivHtmlEditorSyncRegistered = true;

                    formInstance.on("fieldDataChanged", function (e) {
                        formInstance.tmivHtmlEditors?.[e.dataField]?.setValue(e.value);
                    });

                    formInstance.on("optionChanged", function (e) {
                        if (e.name !== "formData") return;

                        var formData = e.value || {};
                        Object.keys(formInstance.tmivHtmlEditors || {}).forEach(function (dataField) {
                            formInstance.tmivHtmlEditors[dataField].setValue(formData[dataField]);
                        });
                    });
                }

                var currentFormData = formInstance.option("formData") || {};
                if (Object.prototype.hasOwnProperty.call(currentFormData, item.dataField)) {
                    formInstance.tmivHtmlEditors[item.dataField].setValue(currentFormData[item.dataField]);
                }
            }

            if (!$editorElement.parent().length || !$editorElement.parent().is(container)) {
                $editorElement.appendTo(container);
            }

            function applyReadOnlyState() {
                var $content = $editorElement.find(".tmiv-html-content");
                if (!$content.length) return false;

                $content.attr("contenteditable", readOnly ? "false" : "true");
                $editorElement.find(".tmiv-html-toolbar").toggle(!readOnly);
                $editorElement.toggleClass("tmiv-html-editor-readonly", readOnly);
                return true;
            }

            if (!applyReadOnlyState() && window.MutationObserver) {
                var observer = new MutationObserver(function () {
                    if (applyReadOnlyState()) observer.disconnect();
                });
                observer.observe($editorElement[0], { childList: true, subtree: true });
            }

            return { element: $editorElement, instance: editorControl };
        }


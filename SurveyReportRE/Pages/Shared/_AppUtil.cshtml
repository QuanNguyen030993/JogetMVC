        function parseToGMT7(dateInput, minusTimeZone = 0 ) {
             //const offsetMinutes = date.getTimezoneOffset();
       const d = new Date(dateInput); // JS auto parse ISO / UTC
       if (isNaN(d)) return null;
       // +7 tiếng (milliseconds)
       return new Date(d.getTime() + minusTimeZone * 60 * 60 * 1000);
    }

        function fmtTimeLocal(input) {
        if (!input) return "—";
        var d = parseToGMT7(input);

        if (input instanceof Date) {
            d = input;
        } else if (typeof input === "string") {
            // normalize: nếu không có timezone → thêm Z để tránh parse lệch
            const hasTZ = /[zZ]|[+-]\d{2}:\d{2}$/.test(input);

            d = parseToGMT7(hasTZ ? input : input + "Z",-7);//  new Date(hasTZ ? input : input + "Z");
        } else {
            return "—";
        }

        if (isNaN(d.getTime())) return "—";

        const pad = (n) => String(n).padStart(2, "0");
        return `${pad(d.getDate())}/${pad(d.getMonth() + 1)}/${d.getFullYear()} ${pad(d.getHours())}:${pad(d.getMinutes())}`;
    }
    function normalizeStatus(raw) {
        const s = String(raw ?? "").trim();
        const k = s.toLowerCase().replace(/\s+/g, " ");

        if (k === "" || k === "new") return { css: "new", text: "New" };
        if (k === "pending") return { css: "pending", text: "Pending" };
        if (k === "in progress") return { css: "in-progress", text: "In Progress" };
        if (k === "accept") return { css: "accepted", text: "Accept" };
        if (k === "approved") return { css: "approved", text: "Approved" };
        if (k === "reject") return { css: "rejected", text: "Reject" };
        if (k === "decline" || k === "declined") return { css: "declined", text: "Decline" };
        if (k === "clientaccept") return { css: "client-accept", text: "Client accept" };
        if (k === "clientrefuse") return { css: "client-refuse", text: "Client refuse" };
        if (k === "done") return { css: "done", text: "Done" };
        if (k === "complete") return { css: "complete", text: "Complete" };
        if (k === "dispose") return { css: "dispose", text: "Dispose" };
        if (k === "archive") return { css: "archive", text: "Archive" };
        if (k === "?" || k === "unknown") return { css: "unknown", text: "?" };
        return { css: "unknown", text: s || "?" };
    }
    function parsePicObject(picJson) {
        try {
            return typeof picJson === "string"
                ? JSON.parse(picJson || "{}")
                : (picJson || {});
        } catch {
            return {};
        }
    }

    function buildPicCategorySearchText(picJson) {
        const obj = parsePicObject(picJson);
        const deptOrder = ["FO", "TS", "UW", "LMKT", "PM"];
        const parts = [];

        deptOrder.forEach(dept => {
            const user = String(obj[dept] || "").trim();
            if (!user) {
                parts.push(dept);
                return;
            }

            parts.push(dept);
            parts.push(`${dept}:${user}`);
            parts.push(`${dept}: ${user}`);
            parts.push(`${dept} ${user}`);
        });

        return parts.join(" ");
    }

    function renderPicInline(picJson) {
        const obj = parsePicObject(picJson);
        const deptOrder = ["FO", "TS", "UW", "LMKT", "PM"];

        return `
            <div class="pic-inline-wrap">
                ${deptOrder.map(dept => `
                    <div class="pic-inline pic-inline--${dept.toLowerCase()}">
                        <span class="pic-inline-head">${dept}</span>
                        <span class="pic-inline-val" title="${escapeHtml(obj[dept] || "-")}">
                            ${escapeHtml(obj[dept] || "-")}
                        </span>
                    </div>
                `).join("")}
            </div>
        `;
    }

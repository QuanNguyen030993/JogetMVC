                                    return $.ajax({
                                        url: `/api/${instance.ModelName}/ExecuteCustomQuery`,
                                        method: "POST",
                                        contentType: "application/json",
                                        data: JSON.stringify(checkCustomQueryByModel.customQuery)
                                    });

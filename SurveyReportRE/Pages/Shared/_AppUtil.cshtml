                                        if (payload.id == null) {
                                            payload.id = key;
                                        }
                                    }
                                    formData.append("key", key);
                                    formData.append("values", JSON.stringify(payload));

                                    return $.ajax({
                                        url: `/api/${instance.ModelName}/UpdateData`,
                                        method: "PUT",
                                        data: formData,
                                        processData: false,
                                        contentType: false
                                    });

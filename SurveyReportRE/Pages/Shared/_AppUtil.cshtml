        $(`#${moduleKey}-btnChatSend_${dept}`).dxButton({
            text: "Send",
            onClick: function (e) {
                alert("Send chat");
            }
        });


        $(`#${moduleKey}-commentTextArea_${dept}`).dxTextArea({
            width: "100%",
            placeholder: "Write a comment... If this is an important cross-section reminder, choose Pinned Note to stick it on top of the target section."
        });


        function getCurrentComments() {
            var res = comments.filter(x => x.section === currentSection);
            if (filterType !== "All") res = res.filter(x => x.type === filterType);
            if (unreadOnly) res = res.filter(x => x.unread);
            return res;
        }

        function renderComments() {
            const wrap = $(`#${moduleKey}-commentWrap_${dept}`);
            wrap.empty();

            const items = getCurrentComments();
            if (!items.length) {
                wrap.append(`<div class="empty-state">Không có comment phù hợp với bộ lọc hiện tại.</div>`);
                return;
            }

            items.forEach(item => {
                const cls = (item.type || "").toLowerCase();
                const unreadBadge = item.unread
                    ? `<span class="mini-badge badge-soft-red">Unread</span>`
                    : `<span class="mini-badge badge-soft-gray">Read</span>`;
                const linkedPin = item.linkedPin
                    ? `<span class="mini-badge badge-soft-yellow">Pinned related</span>`
                    : "";

                wrap.append(`
              <div class="comment-card ${cls}">
                <div class="comment-head">
                  <div class="comment-head-left">
                    <div class="comment-meta">
                      <div class="comment-author-row">
                        <span class="comment-author">${item.fromSection} - ${escapeHtml(item.author)} Added a comment - ${item.time} </span>
                        <span class="mini-badge ${badgeClassByType(item.type)}">${item.type}</span>
                        ${linkedPin}
                      </div>
                    </div>
                  </div>
                  <div>${unreadBadge}</div>
                </div>

                <div class="comment-body clamp" id="${moduleKey}-comment-body-${item.id}">${escapeHtml(item.body)}</div>

                <div class="comment-actions">
                  <div class="btn-read-${item.id}"></div>
                  <div class="btn-reply-${item.id}"></div>
                  <div class="btn-pin-${item.id}"></div>
                  <div class="btn-resolve-${item.id}"></div>
                  <span class="mini-badge badge-soft-gray">${item.replies} replies</span>
                </div>
              </div>
            `);
            });

            items.forEach(item => {
                $(`.btn-read-${item.id}`).dxButton({
                    text: "Read more",
                    stylingMode: "text",
                    onClick: function (e) {
                        const el = $(`#comment-body-${item.id}`);
                        el.toggleClass("clamp");
                        e.component.option("text", el.hasClass("clamp") ? "Read more" : "Collapse");
                    }
                });
                $(`.btn-reply-${item.id}`).dxButton({
                    text: "Reply",
                    stylingMode: "text",
                    onClick: function () { popupInstance.show(); }
                });
                $(`.btn-pin-${item.id}`).dxButton({
                    text: "Pin to top",
                    stylingMode: "text"
                });
                $(`.btn-resolve-${item.id}`).dxButton({
                    text: item.type === "Blocker" ? "Mark resolved" : "Mark done",
                    stylingMode: "text",
                    type: "success"
                });
            });
        }


        function badgeClassByType(type) {
            switch ((type || "").toLowerCase()) {
                case "request": return "badge-soft-blue";
                case "blocker": return "badge-soft-red";
                case "discussion": return "badge-soft-gray";
                case "internal": return "badge-soft-green";
                default: return "badge-soft-yellow";
            }
        }


        function buildFilters() {
            $(`#${moduleKey}-filterTypeSelect_${dept}`).dxSelectBox({
                width: 180,
                dataSource: ["All", "Request", "Blocker", "Discussion", "Internal"],
                value: "All",
                onValueChanged: function (e) {
                    filterType = e.value;
                    renderComments();
                }
            });

            $(`#${moduleKey}-filterUnreadCheckbox_${dept}`).dxCheckBox({
                text: "Unread only",
                value: false,
                onValueChanged: function (e) {
                    unreadOnly = e.value;
                    renderComments();
                }
            });

            $(`#${moduleKey}-btnFilterAll_${dept}`).dxButton({
                text: "All",
                type: "default",
                stylingMode: "outlined",
                onClick: function () {
                    filterType = "All";
                    $(`#${moduleKey}-filterTypeSelect_${dept}`).dxSelectBox("instance").option("value", "All");
                    renderComments();
                }
            });

            $(`#${moduleKey}-btnFilterRequest_${dept}`).dxButton({
                text: "Request",
                stylingMode: "outlined",
                onClick: function () {
                    filterType = "Request";
                    $(`#${moduleKey}-filterTypeSelect_${dept}`).dxSelectBox("instance").option("value", "Request");
                    renderComments();
                }
            });

            $(`#${moduleKey}-btnFilterBlocker_${dept}`).dxButton({
                text: "Blocker",
                stylingMode: "outlined",
                onClick: function () {
                    filterType = "Blocker";
                    $(`#${moduleKey}-filterTypeSelect_${dept}`).dxSelectBox("instance").option("value", "Blocker");
                    renderComments();
                }
            });

            $(`#${moduleKey}-btnFilterDiscussion_${dept}`).dxButton({
                text: "Discussion",
                stylingMode: "outlined",
                onClick: function () {
                    filterType = "Discussion";
                    $(`#${moduleKey}-filterTypeSelect_${dept}`).dxSelectBox("instance").option("value", "Discussion");
                    renderComments();
                }
            });

            $(`#${moduleKey}-btnFilterInternal_${dept}`).dxButton({
                text: "Internal",
                stylingMode: "outlined",
                onClick: function () {
                    filterType = "Internal";
                    $(`#${moduleKey}-filterTypeSelect_${dept}`).dxSelectBox("instance").option("value", "Internal");
                    renderComments();
                }
            });
        }

        function buildPopup() {
            popupInstance = $("#detailPopup").dxPopup({
                title: "Add Comment / Pinned Note",
                width: Math.min(window.innerWidth - 24, 860),
                height: Math.min(window.innerHeight - 24, 620),
                showCloseButton: true,
                resizeEnabled: true,
                visible: false,
                contentTemplate: function (contentElement) {
                    const formWrap = $("<div>").css({ padding: "10px" });
                    contentElement.append(formWrap);

                    const formData = {
                        fromSection: "FO",
                        toSection: currentSection,
                        type: "Request",
                        isPinned: true,
                        isUrgent: false,
                        message: ""
                    };

                    formWrap.dxForm({
                        formData: formData,
                        labelLocation: "top",
                        colCount: 2,
                        items: [
                            {
                                dataField: "fromSection",
                                label: { text: "From Section" },
                                editorType: "dxSelectBox",
                                editorOptions: { dataSource: sections.map(x => x.code) }
                            },
                            {
                                dataField: "toSection",
                                label: { text: "To Section" },
                                editorType: "dxSelectBox",
                                editorOptions: { dataSource: sections.map(x => x.code) }
                            },
                            {
                                dataField: "type",
                                label: { text: "Type" },
                                editorType: "dxSelectBox",
                                editorOptions: { dataSource: ["Discussion", "Request", "Blocker", "Internal"] }
                            },
                            {
                                itemType: "group",
                                colCount: 2,
                                colSpan: 2,
                                items: [
                                    {
                                        dataField: "isPinned",
                                        label: { visible: false },
                                        editorType: "dxCheckBox",
                                        editorOptions: { text: "Pin note to target section" }
                                    },
                                    {
                                        dataField: "isUrgent",
                                        label: { visible: false },
                                        editorType: "dxCheckBox",
                                        editorOptions: { text: "Mark as urgent" }
                                    }
                                ]
                            },
                            {
                                dataField: "message",
                                colSpan: 2,
                                label: { text: "Comment / Note" },
                                editorType: "dxTextArea",
                                editorOptions: {
                                    height: 240,
                                    placeholder: "Write a long comment here. The list view will clamp long text and allow expand/collapse."
                                }
                            },
                            {
                                itemType: "button",
                                horizontalAlignment: "right",
                                buttonOptions: {
                                    text: "Submit",
                                    type: "default",
                                    onClick: function () {
                                        DevExpress.ui.notify("Mockup only: submitted", "success", 1200);
                                        popupInstance.hide();
                                    }
                                }
                            }
                        ]
                    });
                }
            }).dxPopup("instance");
        }

        buildPopup();
        buildFilters();
        renderComments();
    }

</script>


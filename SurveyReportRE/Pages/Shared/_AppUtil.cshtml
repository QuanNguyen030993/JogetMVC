                    break;
                case "dxTagBox":
                    editorOptions.searchEnabled = true;
                    $element.dxTagBox(editorOptions).appendTo($container);
                    break;
                default:
                    console.warn("Unsupported editor type:", devExtremeItem.editorType);
            }
        }

           function viewFieldAdjust(formId, defaultCollapsedGroups) {
            var $formElement = $("#" + formId);
            var form = $formElement.dxForm("instance");
            if (!form) return;

            var collapsedGroups = Array.isArray(defaultCollapsedGroups)
                ? defaultCollapsedGroups
                    .map(groupCaption => String(groupCaption || "").replace(/\s+/g, " ").trim().toLocaleLowerCase())
                    .filter(Boolean)
                : [];

            // Keep the requested defaults on the dxForm element. The group-toggle
            // observer reads this value again whenever DevExtreme rebuilds the form.
            var formElement = $formElement.get(0);
            formElement.dxFormDefaultCollapsedGroups = new Set(collapsedGroups);

            var items = form.option("items");

            function processItems(itemsArr) {
                if (!Array.isArray(itemsArr)) return;

                itemsArr.forEach(item => {
                    // Nếu là group => duyệt tiếp
                    if (item.itemType === "group" || item.items) {
                        processItems(item.items);
                        return;
                    }
                    if (item.dataField && (item.editorType != "dxDateBox")){
                            item.dateSerializationFormat= "yyyy-MM-dd";
                        }
                    // Nếu là field (có dataField)
                    if (item.dataField && (item.editorType != "dxFileUploader")) {
                        if (!item.label) {
                            item.label = {};
                        }
                        if (item.dataField != "decision")

                        item.label.location = "top";


                    }
                });
            }

            processItems(items);
            itemsStyle(items);
            // set lại items sau khi chỉnh sửa
            form.option("items", items);

            // Also cover a form whose DOM was not rebuilt by option("items").
            window.requestAnimationFrame(function () {
                if (typeof applyDxFormDefaultCollapsedGroups === "function") {
                    applyDxFormDefaultCollapsedGroups(formElement);
                }
            });
        }

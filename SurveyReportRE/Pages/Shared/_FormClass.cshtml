<script>
    var SLAForm = class SLAForm extends MForm {

        constructor(id, childGridConfig, formConfig, mFormOption) {
            super(id, childGridConfig, formConfig, mFormOption);
        }


        getSuccess(data) {
            var that = this;
            if (!data) return;
            that.orgFormData = data;


            let attributes = {};

            try {
                attributes = JSON.parse(data.attributes || "{}");
            }
            catch (e) {
                attributes = {
                    fields: []
                };
            }


            that.slaConfig = attributes;


            let items = generateSLAItems(
                attributes.fields
            );


            that.attributes = items;


            that.formInstance.option(
                "items[0].items",
                items
            );


            // set default value
            let formData = {};


            $.each(attributes.fields, function (i, f) {

                formData[f.name] =
                    f.value ?? null;

            });


            // giá trị hiện tại DB
            formData["slaValue"] =
                data.value;


            that.formInstance.option(
                "formData",
                formData
            );

        }
        renderForm(formElement) {
            var that = this;
           
            // formElement.append($wrapper);
            formElement.addClass("fade-slide-up");

            // var $scrollElement = $(`<div id='${that.ModelName}ScrollView'/>`).appendTo(formElement);
            this.formInstance =
                formElement.dxForm({
                    dataSource: makeBasicDataSource(that, true),
                    formData: {},

                    colCount: 1,

                    items: [],

                    height: "inherit",

                    elementAttr: {
                        class: "dExForm"
                    }
                    ,


                    onFieldDataChanged(e) {

                        that.changedData =
                            e.component.option("formData");

                    }

                })
                    .dxForm("instance");

            if (this.formInstance)
                this.formInstance.option("config", this);
           

            this.loadSLA();

        }

        loadSLA() {

            var that = this;

            var params = new URLSearchParams();

            params.set("refKey", that.refKey);
            params.set("refField", that.refField);
            params.set("refOperator", "=");


            ajaxGet(
                `api/SLA/GetAll/?${params.toString()}`
            )
                .done(res => {


                    that.slaRows = res;


                    let items = [];
                    let formData = {};
                    items.push({
                            itemType: "button",
                            horizontalAlignment: "right",
                            verticalAlignment: "top",
                            buttonOptions: {
                                text: "Save",
                                icon: "save",
                                type: "success",
                                stylingMode: "contained",
                                onClick() {
                                      that.doSaveData(false);
                                         DevExpress.ui.notify("Saved successfully", "success", 2000);
                                }
                            }
                        });


                    $.each(
                        that.slaRows,
                        function (i, row) {


                            let attr =
                                JSON.parse(row.attributes);



                            $.each(
                                attr.fields,
                                function (j, f) {
                                    // f.value = f.value !== undefined
                                    //     ?
                                    //     f.value
                                    //     :
                                    //     row.value || 0

                                    let fieldName =
                                        row.code + "_" + f.name;



                                    items.push({

                                        dataField: fieldName,


                                        label: {
                                            text: f.label
                                        },


                                        editorType:
                                            f.control == "number"
                                                ?
                                                "dxNumberBox"
                                                :
                                                "dxTextBox",


                                        editorOptions: {
                                            min: f.min,
                                            max: f.max,
                                            showSpinButtons: true
                                        },


                                        slaRowId: row.id,

                                        slaCode: row.code,

                                        slaField: f.name

                                    });

                                    // f.value = f.value !== undefined
                                    //     ?
                                    //     f.value
                                    //     :
                                    //     row.value || 0

                                    // // ưu tiên value trong json
                                    // // fallback Value column

                                    formData[fieldName] =
                                        f.value !== undefined
                                            ?
                                            f.value
                                            :
                                            row.value || 0;



                                });


                        });

  

                   


                    that.formInstance.option(
                        "formData",
                        formData
                    );

                    that.formInstance.option(
                        "items",
                        items
                    );
                      
                });
        }


        doSaveData(isClose) {
            try {

                let that = this;


                let formData =
                    that.formInstance.option("formData");
                let ds =
                    that.formInstance.option("dataSource");

                $.each(
                    that.slaRows,
                    function (i, row) {



                        let attributes =
                            tryParseJSON(row.attributes, "");

                        let calculation = attributes.calculation;

                        $.each(
                            attributes.fields,
                            function (j, f) {



                                let key =
                                    row.code + "_" + f.name;



                                f.value =
                                    formData[key];



                            });



                        let value =
                            that.calculateSLA(
                                attributes,
                                formData
                            );



                        let data = {

                            attributes:
                                JSON.stringify({ fields: [attributes.fields[0]], calculation: calculation }),


                            value: value || 0,


                            decimalValue:
                                Number(value)

                        };
                        if (row.id == 0)
                             ds.insert(
                                data
                            );
                        else 
                        ds.update(
                            row.id,
                            data
                        );

                    });


               


             

            }
            catch (err) {

                appErrorHandling(
                    "SLA save error",
                    err
                );

            }

        }
       
       


        calculateSLA(config, formData) {

            
            if (!config.calculation)
                return formData.slaValue;



            let c =
                config.calculation;



            switch (c.type) {


                case "manual":
                    let field =
                        config.fields[0].name;
                    return config.fields[0].value || 0;

                    // return formData[field] || 0;



                case "dateDiff":


                    let from =
                        new Date(
                            formData[c.fieldFrom]
                        );


                    let to =
                        new Date(
                            formData[c.fieldTo]
                        );


                    if (!from || !to)
                        return 0;



                    let diff =
                        to - from;



                    return Math.floor(
                        diff / (1000 * 60 * 60 * 24)
                    );



                default:

                    return 0;
            }

        }



        groupingLayout(
            _formConfig,
            itemsArray,
            formInstance
        ) {
            return [
                {
                    itemType: "group",
                    caption: "SLA Configuration",
                    colCount: 2,
                    items: itemsArray
                }
            ];

        }


    }
    function generateSLAItems(fields) {

        return $.map(
            fields,
            function (f) {


                let item = {

                    dataField: f.name,

                    label: {
                        text: f.label
                    }

                };


                switch (f.control) {


                    case "number":

                        item.editorType =
                            "dxNumberBox";

                        item.editorOptions = {

                            min: f.min,
                            max: f.max,
                            showSpinButtons: true
                        };

                        break;



                    case "date":

                        item.editorType =
                            "dxDateBox";

                        break;



                    default:

                        item.editorType =
                            "dxTextBox";

                }



                if (f.required) {

                    item.validationRules = [
                        {
                            type: "required",
                            message:
                                f.label +
                                " bắt buộc nhập"
                        }
                    ];

                }


                return item;

            }
        );

    }

@page "{pageNum:int?}"
@using Newtonsoft.Json
@model PullQuotation_FormModel
@{
   
    ViewBag.Title = "PullQuotation";
}
<style>
    .dx-tabpanel .dx-tabpanel-tabs .dx-tab {
        width: auto;
        padding-left: 18px;
        padding-right: 18px;
    }
</style>
<script type="text/javascript">
    $(function () {
        const popup = $("#detailPopup")
                        .dxPopup({
                            width: "40%",
                            height: "70%",
                            title: "Input Quotation No",
                            showTitle: true,
                            dragEnabled: true,
                            closeOnOutsideClick: true,
                            contentTemplate: function (contentElement) {
                                var name = "JSESSIONID";
                                var value = "";
                                const regex = new RegExp(`${name}`)
                                
                                 const match = document.cookie.match(regex);
                                 if (match) {
                                     const parts = document.cookie.split(`${name}=`);
                                     if (parts.length === 2) value =  parts.pop().split(';').shift();
                                 }


                                var form = $("<div>").dxForm({
                                    items: [
                                        { dataField: "quotationNo", label: { text: "PullQuotation No" }, editorOptions: { placeholder: "Quotation No" } },
                                        { dataField: "jsessionID", dataType: "string", label: { text: "Joget JSESSIONID" }, editorOptions: { placeholder: "JSESSION ID" } }
                                    ]
                                }).appendTo(contentElement);
                                form.dxForm("instance").updateData("jsessionID", value);

                                $("<div>").dxButton({
                                    text: "OK",
                                    type: "success",
                                    onClick: function () {
                                        var data = contentElement.find(".dx-form").dxForm("instance").option("formData");

                                         if (data.jsessionID != value) {
                                         document.cookie = name + "=" + (data.jsessionID || "");
                                        }

                                        if (data.jsessionID && data.quotationNo)
                                        {
                                            $.ajax({
                                            url: `/api/Quotation/PullDataBySession/${data.quotationNo}/${data.jsessionID}`,
                                            success: function (response) {
                                                appNotifySuccess("Process done!", false);
                                                popup.hide();
                                            },
                                            error: function (err) {
                                                appErrorHandling("Process update!", err);
                                            }
                                            });
                                        }
                                        else {
                                            var typeField = data.jsessionID ? "JSessionId" : "Quotation No";
                                            DevExpress.ui.notify({
                                                message: `Please input ${typeField}`,
                                                type: "warning",
                                                displayTime: 2000,
                                                width: 300, // 👈 điều chỉnh độ rộng
                                                height: 60, // 👈 chiều cao nếu muốn
                                                position: {
                                                    my: "center top",   // vị trí của toast
                                                    at: "center top",   // neo ở đâu trên cửa sổ
                                                    of: window,         // container
                                                    offset: "0 20"      // dịch xuống 20px cho đẹp
                                                }
                                            });
                                            popup.hide();
                                        }
                                        // Ẩn Popup
                                        
                                    }
                                                                    })
                                    .appendTo(contentElement);
                                return contentElement;
                            },onHiding: function (e) {
                                //removeTab("PullQuotation");
                            }
                        }).dxPopup("instance");
                    popup.show();
    })


</script>
<div class="container">
    <div id="detailPopup"></div>
    <div id="form_@(PullQuotation_FormModel.ModelName)_@Convert.ToInt32(ViewData["Id"])" class="dExForm"></div>


    <div class="modal fade product-dialog" tabPullQuotation="-1" role="dialog" aria-labelledby="gridSystemModalLabel">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title" id="gridSystemModalLabel">Select Your Products</h4>
                </div>
                <div class="modal-body">
                    <!-- "Loading" spinner displayed while we get the product list. -->
                    <div class="text-center"><i class="fa fa-fw fa-spin fa-spinner"></i> Loading...</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary select-button">Select</button>
                </div>
            </div><!-- /.modal-content -->
        </div><!-- /.modal-dialog -->
    </div><!-- /.modal -->
</div>
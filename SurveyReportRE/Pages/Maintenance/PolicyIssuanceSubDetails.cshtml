@page
@model ERPCore.Pages.PolicyIssuanceSubDetailsModel
@{
    ViewBag.Title = "Policy Issuance Sub Details";
}

<div class="dExForm maintenance-grid-page">
    <div class="maintenance-grid-heading">
        <div>
            <h2>Policy Issuance Sub Details</h2>
            <p>Maintain policy numbers and related client information.</p>
        </div>
    </div>
    <div id="dataGrid_@ERPCore.Pages.PolicyIssuanceSubDetailsModel.ModelName"></div>
</div>

<script>
    $(function () {
        new MGrid(
            null,
            $("#dataGrid_@ERPCore.Pages.PolicyIssuanceSubDetailsModel.ModelName"),
            new PolicyIssuanceSubDetailsGridOption(
                "@ERPCore.Pages.PolicyIssuanceSubDetailsModel.ModelName",
                "User"
            ),
            null
        );
    });
</script>

<style>
    .maintenance-grid-page {
        display: flex;
        flex-direction: column;
        width: 100%;
        height: 100%;
        min-height: 0;
        padding: 12px;
        overflow: hidden;
        box-sizing: border-box;
    }

    .maintenance-grid-page > .mgrid-host {
        flex: 1 1 auto;
        min-height: 0;
    }

    .maintenance-grid-heading {
        flex: 0 0 auto;
        margin-bottom: 10px;
        padding: 12px 14px;
        border: 1px solid var(--c-e2e8f0);
        border-radius: 11px;
        background: var(--c-f8fafc);
    }

    .maintenance-grid-heading h2 {
        margin: 0 0 4px;
        color: var(--c-172235);
        font-size: 20px;
        font-weight: 750;
    }

    .maintenance-grid-heading p {
        margin: 0;
        color: var(--c-64748b);
        font-size: 13px;
    }
</style>

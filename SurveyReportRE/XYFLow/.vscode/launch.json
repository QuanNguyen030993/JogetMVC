{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch XYFLow Dev Server",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/XYFLow",
      "preLaunchTask": "Start dev server",
      "timeout": 20000,
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}

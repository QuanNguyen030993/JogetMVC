{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Install dependencies",
			"type": "shell",
			"command": "npm install",
			"problemMatcher": []
		},
		{
			"label": "Build app",
			"type": "shell",
			"command": "npm run build",
			"problemMatcher": []
		},
		{
			"label": "Start dev server",
			"type": "shell",
			"command": "npm run dev -- --host 0.0.0.0",
			"isBackground": true,
			"problemMatcher": [
				{"owner": "vite", "pattern": {
					"regexp": ".*",
					"file": 1,
					"location": 2,
					"message": 3
				}}
			],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		}
	]
}
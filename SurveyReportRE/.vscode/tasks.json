{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start XYFLow Dev Server",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"],
      "options": {
        "cwd": "${workspaceFolder}/XYFLow"
      },
      "isBackground": true,
      "problemMatcher": [
        {
          "owner": "vite",
          "pattern": {
            "regexp": ".*",
            "file": 1,
            "location": 2,
            "message": 3
          }
        }
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
